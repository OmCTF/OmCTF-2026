Процедура ПриНачалеРаботыСистемы()
    Если ПараметрЗапуска = "VodokanalFirstOperatorCreate" Тогда
        Попытка
            Сообщить(НастройкаШлюзаИдентичности.СоздатьПервогоАдминистратора());
        Исключение
            Сообщить("первичная_оператор_не_удалось");
        КонецПопытки;
        ЗавершитьРаботуСистемы(Ложь); Возврат;
    КонецЕсли;
    Если ПараметрЗапуска = "VodokanalIsolatedPortalReaderCreate"
        Или ПараметрЗапуска = "VodokanalIsolatedPortalReaderVerify"
        Или ПараметрЗапуска = "VodokanalIsolatedPublicReaderVerify"
        Или ПараметрЗапуска = "VodokanalIsolatedHydrologyReaderVerify" Тогда
        Попытка
            Если ПараметрЗапуска = "VodokanalIsolatedPortalReaderCreate" Тогда
                Сообщить(НастройкаПубличногоПортала.СоздатьИзолированногоЧитателяИзФайлаОператора());
            ИначеЕсли ПараметрЗапуска = "VodokanalIsolatedPortalReaderVerify" Тогда
                Сообщить(НастройкаПубличногоПортала.ПроверитьИзолированногоЧитателяИзФайлаОператора());
            ИначеЕсли ПараметрЗапуска = "VodokanalIsolatedPublicReaderVerify" Тогда
                Сообщить(НастройкаОператоров1С.ПроверитьИзолированногоПубличногоЧитателяИзФайлаОператора());
            Иначе
                Сообщить(НастройкаОператоров1С.ГидрочитательПроверитьИзолированнуюБазуИзФайлаОператора());
            КонецЕсли;
        Исключение
            Сообщить("изолировано_читатель_настройка_не_удалось");
        КонецПопытки;
        ЗавершитьРаботуСистемы(Ложь); Возврат;
    КонецЕсли;
    Если ПараметрЗапуска = "VodokanalMaintenanceEnable" Или ПараметрЗапуска = "VodokanalMaintenanceDisable"
        Или ПараметрЗапуска = "VodokanalMaintenanceOnce" Или ПараметрЗапуска = "VodokanalMaintenanceStatus"
        Или ПараметрЗапуска = "VodokanalQuotaMigration" Тогда
        Попытка
            Сообщить(ОператорЭксплуатации.ВыполнитьКомандуЗапуска(ПараметрЗапуска));
        Исключение
            Сообщить("операции_не_удалось");
        КонецПопытки;
        ЗавершитьРаботуСистемы(Ложь); Возврат;
    КонецЕсли;
    Если ПараметрЗапуска = "VodokanalIdentityGatewayProvision" Тогда
        Попытка
            ФайлРезультата = Новый Файл("/run/vodokanal-identity-gateway/result.json");
            Если ФайлРезультата.Существует() Тогда ВызватьИсключение "идентификация_результат_существует"; КонецЕсли;
            Результат = НастройкаШлюзаИдентичности.НастроитьИзФайлаОператора();
            Байты = ПолучитьДвоичныеДанныеИзСтроки(Результат, КодировкаТекста.UTF8, Ложь);
            Поток = Новый ФайловыйПоток("/run/vodokanal-identity-gateway/result.json", РежимОткрытияФайла.СоздатьНовый, ДоступКФайлу.Запись);
            Попытка Байты.Записать(Поток); Поток.Закрыть();
            Исключение Поток.Закрыть(); ВызватьИсключение; КонецПопытки;
            Сообщить("identity_gateway_provision_completed");
        Исключение
            Сообщить("идентификация_шлюз_настройка_не_удалось");
        КонецПопытки;
        ЗавершитьРаботуСистемы(Ложь); Возврат;
    КонецЕсли;
    Если ПараметрЗапуска = "VodokanalPortalReaderCreate" Тогда
        Попытка
            Сообщить(НастройкаПубличногоПортала.СоздатьИзФайлаОператора());
        Исключение
            Сообщить("кабинет_читатель_настройка_не_удалось");
        КонецПопытки;
        ЗавершитьРаботуСистемы(Ложь); Возврат;
    КонецЕсли;
    Если ПараметрЗапуска = "VodokanalIsolatedDispatchGatewayProvision" Тогда
        Попытка
            Сообщить(НастройкаГостевогоШлюза.НастроитьИзолированныйШлюзИзФайлаОператора());
        Исключение
            Сообщить("диспетчерская_шлюз_настройка_не_удалось");
        КонецПопытки;
        ЗавершитьРаботуСистемы(Ложь); Возврат;
    КонецЕсли;
    Если ПараметрЗапуска = "VodokanalDispatchGatewayProvision" Тогда
        Попытка
            Сообщить(НастройкаГостевогоШлюза.НастроитьИзФайлаОператора());
        Исключение
            Сообщить("диспетчерская_шлюз_настройка_не_удалось");
        КонецПопытки;
        ЗавершитьРаботуСистемы(Ложь); Возврат;
    КонецЕсли;
    Если ПараметрЗапуска = "VodokanalHydrologyReaderCreate" Или ПараметрЗапуска = "VodokanalHydrologyReaderVerify" Тогда
        Попытка
            Если ПараметрЗапуска = "VodokanalHydrologyReaderCreate" Тогда
                Результат = НастройкаОператоров1С.ГидрочитательСоздатьИзФайлаОператора();
            Иначе
                Результат = НастройкаОператоров1С.ГидрочитательПроверитьИзФайлаОператора();
            КонецЕсли;
            Сообщить(Результат);
        Исключение
            Сообщить("гидрология_читатель_настройка_не_удалось");
        КонецПопытки;
        ЗавершитьРаботуСистемы(Ложь);
        Возврат;
    КонецЕсли;
    Если ПараметрЗапуска <> "VodokanalProvision"
        И ПараметрЗапуска <> "VodokanalPublicReaderCreate"
        И ПараметрЗапуска <> "VodokanalPublicReaderVerify" Тогда Возврат; КонецЕсли;
    Попытка
        Если ПараметрЗапуска = "VodokanalProvision" Тогда
            Результат = НастройкаОператоров1С.СоздатьУчетныеЗаписиИзФайлаОператора();
        ИначеЕсли ПараметрЗапуска = "VodokanalPublicReaderCreate" Тогда
            Результат = НастройкаОператоров1С.СоздатьПубличногоЧитателяИзФайлаОператора();
        Иначе
            Результат = НастройкаОператоров1С.ПроверитьПубличногоЧитателяИзФайлаОператора();
        КонецЕсли;
        Сообщить(Результат);
    Исключение
        Если ПараметрЗапуска = "VodokanalProvision" Тогда
            Сообщить("платформа_настройка_не_удалось");
        Иначе
            Сообщить("публичный_читатель_настройка_не_удалось");
        КонецЕсли;
    КонецПопытки;
    ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры
