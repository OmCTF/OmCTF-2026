Перем ADM08НовыйКорень;

Процедура ПередЗаписью(Отказ)
    ADM08НовыйКорень = ЭтоНовый();
    Если ADM08НовыйКорень И (ОбменДанными.Загрузка Или Не ТранзакцияАктивна()) Тогда
        ВызватьИсключение "кабинет_объект_квота_транзакция_требуется";
    КонецЕсли;
    Если Не ADM08НовыйКорень Тогда
        Старый = Ссылка.ПолучитьОбъект();
        Если Старый = Неопределено Или Старый.РабочееПространство <> РабочееПространство Тогда
            ВызватьИсключение "кабинет_объект_квота_граница_конфликт";
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
    Если Не Отказ И ADM08НовыйКорень = Истина Тогда
        ОграниченияОбъектовОбластей.ИнициализироватьНовуюОбласть(Ссылка);
    КонецЕсли;
КонецПроцедуры
