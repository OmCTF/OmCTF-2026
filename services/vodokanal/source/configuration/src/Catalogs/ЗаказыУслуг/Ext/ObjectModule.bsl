Процедура ПередЗаписью(Отказ)
    Если Не Отказ Тогда
        ОграниченияОбъектовОбластей.ПроверитьНовуюЗапись(ЭтотОбъект);
    КонецЕсли;
    Если ОбменДанными.Загрузка Или Не ЭтоНовый() Или ПометкаУдаления Или Не ТранзакцияАктивна() Тогда
        ВызватьИсключение "кабинет_наряд_состояние_конфликт";
    КонецЕсли;
    Если Не ЗначениеЗаполнено(РабочееПространство) Или Не ЗначениеЗаполнено(Область)
        Или Не ЗначениеЗаполнено(КемСоздано) Или ДатаСоздания = Дата(1,1,1)
        Или ДатаОбновления <> ДатаСоздания Или Состояние <> "Registered" Или Ревизия <> 1
        Или ПустаяСтрока(Наименование) Или СтрДлина(Наименование) > 150
        Или ПустаяСтрока(ОбъектРабот) Или СтрДлина(ОбъектРабот) > 250
        Или ПустаяСтрока(СодержаниеЗаказа) Или СтрДлина(СодержаниеЗаказа) > 2000 Тогда
        ВызватьИсключение "кабинет_наряд_привязка_конфликт";
    КонецЕсли;
    Текущий = ПолитикаДоступа.ПроверитьУчетнуюЗапись();
    Если КемСоздано <> Текущий.Ссылка Или Область.РабочееПространство <> РабочееПространство
        Или РабочееПространство.ПометкаУдаления Или РабочееПространство.Состояние <> "Active"
        Или Область.ПометкаУдаления Или Область.Состояние <> "Active" Тогда
        ВызватьИсключение "кабинет_наряд_привязка_конфликт";
    КонецЕсли;
    ПолитикаДоступа.ПроверитьДоступКОбласти(Текущий.Ссылка,
        Строка(РабочееПространство.УникальныйИдентификатор()),
        Строка(Область.УникальныйИдентификатор()), "Dispatcher");
КонецПроцедуры

Процедура ПередУдалением(Отказ)
    ВызватьИсключение "кабинет_наряд_состояние_конфликт";
КонецПроцедуры
