Процедура ПередЗаписью(Отказ)
    Если Не Отказ Тогда
        ОграниченияОбъектовОбластей.ПроверитьНовуюЗапись(ЭтотОбъект);
    КонецЕсли;
    Если ОбменДанными.Загрузка Или ПометкаУдаления Или Не ТранзакцияАктивна() Тогда
        ВызватьИсключение "кабинет_счетчик_нельзя_изменять";
    КонецЕсли;
    Текущий = ПолитикаДоступа.ПроверитьУчетнуюЗапись();
    Лицевой = ДоступКЛицевымСчетам.ПроверитьЛицевойСчет(Текущий.Ссылка, Строка(ЛицевойСчет.УникальныйИдентификатор()), ?(ЭтоНовый(), "SubmitReading", "Read"));
    Если РабочееПространство <> Лицевой.РабочееПространство Или Область <> Лицевой.Область
        Или УстановкаПрибора.ЛицевойСчет <> ЛицевойСчет Или ЦелевоеПоказание.УстановкаПрибора <> УстановкаПрибора
        Или ЦелевоеПоказание.ЛицевойСчет <> ЛицевойСчет Тогда ВызватьИсключение "кабинет_счетчик_привязка_конфликт"; КонецЕсли;
    Если ЭтоНовый() Тогда
        ПроверкаПринятия = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Показание ИЗ РегистрСведений.ДействующиеКорректировкиПоказаний ГДЕ Показание = &Показание");
        ПроверкаПринятия.УстановитьПараметр("Показание", ЦелевоеПоказание);
        ПринятоПослеПроверки = Не ПроверкаПринятия.Выполнить().Пустой();
        Если Состояние <> "Pending" Или Ревизия <> 1 Или КемСоздано <> Текущий.Ссылка
            Или (ЦелевоеПоказание.Состояние <> "Accepted" И Не ПринятоПослеПроверки) Или ПустаяСтрока(Причина)
            Или ПредлагаемоеЗначение < 0 Или ПредлагаемаяДатаИзмерения < УстановкаПрибора.ДатаДопуска
            Или ПредлагаемаяДатаИзмерения > ТекущаяУниверсальнаяДата() + 300 Тогда
            ВызватьИсключение "кабинет_счетчик_нельзя_изменять";
        КонецЕсли;
        Возврат;
    КонецЕсли;
    Старый = Ссылка.ПолучитьОбъект();
    Если Старый = Неопределено Тогда ВызватьИсключение "кабинет_счетчик_привязка_конфликт"; КонецЕсли;
    Если Старый.ПометкаУдаления Или Старый.Состояние <> "Pending"
        Или РабочееПространство <> Старый.РабочееПространство Или Область <> Старый.Область
        Или ЛицевойСчет <> Старый.ЛицевойСчет Или УстановкаПрибора <> Старый.УстановкаПрибора
        Или ЦелевоеПоказание <> Старый.ЦелевоеПоказание Или ПредлагаемоеЗначение <> Старый.ПредлагаемоеЗначение
        Или ПредлагаемаяДатаИзмерения <> Старый.ПредлагаемаяДатаИзмерения Или Причина <> Старый.Причина
        Или КемСоздано <> Старый.КемСоздано Или ДатаСоздания <> Старый.ДатаСоздания
        Или Наименование <> Старый.Наименование Или Код <> Старый.Код
        Или Ревизия <> Старый.Ревизия + 1 Или ДатаОбновления < Старый.ДатаОбновления
        Или (Состояние <> "Approved" И Состояние <> "Rejected") Тогда ВызватьИсключение "кабинет_счетчик_нельзя_изменять"; КонецЕсли;
    ПолитикаДоступа.ПроверитьДоступКОбласти(Текущий.Ссылка, Строка(РабочееПространство.УникальныйИдентификатор()), Строка(Область.УникальныйИдентификатор()), "BillingSpecialist");
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2 Ссылка, Решение, Значение, ДатаИзмерения, КемСоздано
        |ИЗ Справочник.РешенияПроверкиПоказаний ГДЕ Заявка = &Заявка И Показание = &Показание
        |И УстановкаПрибора = &Установка И РабочееПространство = &РабочееПространство И Область = &Область И НЕ ПометкаУдаления");
    Запрос.УстановитьПараметр("Заявка", Ссылка); Запрос.УстановитьПараметр("Показание", ЦелевоеПоказание);
    Запрос.УстановитьПараметр("Установка", УстановкаПрибора); Запрос.УстановитьПараметр("РабочееПространство", РабочееПространство);
    Запрос.УстановитьПараметр("Область", Область);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Тогда ВызватьИсключение "кабинет_счетчик_проверка_запрос_требуется"; КонецЕсли;
    Если Выборка.КемСоздано <> Текущий.Ссылка Или Выборка.Значение <> ПредлагаемоеЗначение
        Или Выборка.ДатаИзмерения <> ПредлагаемаяДатаИзмерения
        Или Выборка.Решение <> ?(Состояние = "Approved", "Approve", "Reject") Тогда
        ВызватьИсключение "кабинет_счетчик_проверка_состояние_конфликт";
    КонецЕсли;
    Если Выборка.Следующий() Тогда ВызватьИсключение "кабинет_счетчик_проверка_состояние_конфликт"; КонецЕсли;
КонецПроцедуры

Процедура ПередУдалением(Отказ)
    ВызватьИсключение "кабинет_счетчик_нельзя_изменять";
КонецПроцедуры
