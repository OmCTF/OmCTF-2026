Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
    Если ОбменДанными.Загрузка Тогда
        Отказ = Истина;
        Возврат;
    КонецЕсли;
    Если Не ЭтоНовый() Тогда
        ВызватьИсключение "показания_можно_только_добавлять_используйте_исправление";
    КонецЕсли;
    Если Не ЗначениеЗаполнено(ПриборУчета) Тогда
        ВызватьИсключение "требуется_прибор_учета";
    КонецЕсли;
    Если Значение < 0 Тогда
        ВызватьИсключение "показание_не_может_быть_отрицательным";
    КонецЕсли;
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
    Если ОбменДанными.Загрузка Тогда
        Отказ = Истина;
        Возврат;
    КонецЕсли;
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("Справочник.ПриборыУчета");
    Элемент.УстановитьЗначение("Ссылка", ПриборУчета);
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();

    Запрос = Новый Запрос(
        "ВЫБРАТЬ МАКСИМУМ(Показание.Значение) КАК ПоследнийЗначение
        |ИЗ Документ.ПоказаниеПрибора КАК Показание
        |ГДЕ Показание.ПриборУчета = &ПриборУчета И Показание.Ссылка <> &СобственныйОбъект
        |И НЕ Показание.ПометкаУдаления");
    Запрос.УстановитьПараметр("ПриборУчета", ПриборУчета);
    Запрос.УстановитьПараметр("СобственныйОбъект", Ссылка);
    ВыборкаДанных = Запрос.Выполнить().Выбрать();
    ВыборкаДанных.Следующий();
    Если ТипЗнч(ВыборкаДанных.ПоследнийЗначение) = Тип("Число") Тогда
        Если Значение < ВыборкаДанных.ПоследнийЗначение Тогда
            ВызватьИсключение "показание_не_может_уменьшаться";
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры
