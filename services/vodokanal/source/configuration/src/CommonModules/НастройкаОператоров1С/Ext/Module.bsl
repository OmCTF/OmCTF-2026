Функция СоздатьУчетныеЗаписиИзФайлаОператора() Экспорт
    ПроверитьНативногоАдминистратора();
    Если ТранзакцияАктивна() Тогда
        ВызватьИсключение "платформа_настройка_транзакция_активно";
    КонецЕсли;

    ВходныеДанные = ПрочитатьДанныеОператора();
    УчетныеЗаписи = ПроверитьВходныеДанные(ВходныеДанные);
    ПроверитьДоступностьПакетаУчетныхЗаписей(УчетныеЗаписи);

    ПлатформенныйУчетныеЗаписи = Новый Массив;
    Для Каждого УчетныеДанные Из УчетныеЗаписи Цикл
        ПлатформенныйУчетныеЗаписи.Добавить(СоздатьНативнуюУчетнуюЗапись(УчетныеДанные));
    КонецЦикла;

    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьКлючиИдентификации(ПлатформенныйУчетныеЗаписи);
        Для Каждого Объект Из ПлатформенныйУчетныеЗаписи Цикл
            ПроверитьДоступностьИмениВхода(Объект.loginNormalized);
            Привязка = РегистрыСведений.ПривязкиПользователей1С.СоздатьМенеджерЗаписи();
            Привязка.ИдентификаторПользователя1С = Объект.nativeUserId;
            Привязка.Прочитать();
            Если Привязка.Выбран() Тогда
                ВызватьИсключение "платформа_настройка_идентификация_конфликт";
            КонецЕсли;
        КонецЦикла;

        Для Каждого Объект Из ПлатформенныйУчетныеЗаписи Цикл
            УчетнаяЗапись = Справочники.УчетныеЗаписи.СоздатьЭлемент();
            УчетнаяЗапись.SetNewObjectRef(Справочники.УчетныеЗаписи.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
            УчетнаяЗапись.Наименование = Объект.displayName;
            УчетнаяЗапись.ИдентификаторПользователя1С = Объект.nativeUserId;
            УчетнаяЗапись.НормализованныйЛогин = Объект.loginNormalized;
            УчетнаяЗапись.Состояние = "Active";
            УчетнаяЗапись.ПоколениеАвторизации = 1;
            УчетнаяЗапись.ДатаСоздания = ТекущаяУниверсальнаяДата();
            УчетнаяЗапись.Записать();

            ПлатформенныйПривязка = РегистрыСведений.ПривязкиПользователей1С.СоздатьМенеджерЗаписи();
            ПлатформенныйПривязка.ИдентификаторПользователя1С = Объект.nativeUserId;
            ПлатформенныйПривязка.УчетнаяЗапись = УчетнаяЗапись.Ссылка;
            ПлатформенныйПривязка.Записать();

            ПривязкиЛогинов = РегистрыСведений.ПривязкиЛогинов.СоздатьМенеджерЗаписи();
            ПривязкиЛогинов.НормализованныйЛогин = Объект.loginNormalized;
            ПривязкиЛогинов.УчетнаяЗапись = УчетнаяЗапись.Ссылка;
            ПривязкиЛогинов.Записать();
        КонецЦикла;
        ЗафиксироватьТранзакцию();
    Исключение
        Если ТранзакцияАктивна() Тогда
            ОтменитьТранзакцию();
        КонецЕсли;
        ВызватьИсключение "платформа_настройка_приложение_запись_не_удалось_восстановление_требуется";
    КонецПопытки;

    Возврат "native_provision_completed";
КонецФункции

Процедура ПроверитьНативногоАдминистратора()
    Если Не РольДоступна("Администратор") Тогда
        ВызватьИсключение "платформа_настройка_администратор_требуется";
    КонецЕсли;
    Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
    Если Пользователь = Неопределено Тогда
        ВызватьИсключение "платформа_настройка_администратор_требуется";
    КонецЕсли;
    Если ПустаяСтрока(Пользователь.Имя) Тогда
        ВызватьИсключение "платформа_настройка_администратор_требуется";
    КонецЕсли;
КонецПроцедуры

Функция ПрочитатьДанныеОператора()
    Чтение = Новый ЧтениеJSON;
    Попытка
        Чтение.ОткрытьФайл("/run/vodokanal-provision.json");
        ВходныеДанные = ПрочитатьJSON(Чтение);
        Чтение.Закрыть();
    Исключение
        Чтение.Закрыть();
        ВызватьИсключение "платформа_настройка_ввод_нечитаемо";
    КонецПопытки;
    Возврат ВходныеДанные;
КонецФункции

Функция ПроверитьВходныеДанные(ВходныеДанные)
    Если ТипЗнч(ВходныеДанные) <> Тип("Структура") Тогда
        ВызватьИсключение "платформа_настройка_некорректно_схема";
    КонецЕсли;
    Если ВходныеДанные.Количество() <> 2 Тогда
        ВызватьИсключение "платформа_настройка_некорректно_схема";
    КонецЕсли;
    Схема = Неопределено;
    УчетныеЗаписи = Неопределено;
    Если Не ВходныеДанные.Свойство("schema", Схема) Или Не ВходныеДанные.Свойство("accounts", УчетныеЗаписи) Тогда
        ВызватьИсключение "платформа_настройка_некорректно_схема";
    КонецЕсли;
    Если ТипЗнч(Схема) <> Тип("Число") Тогда
        ВызватьИсключение "платформа_настройка_некорректно_схема";
    КонецЕсли;
    Если Схема <> 1 Или ТипЗнч(УчетныеЗаписи) <> Тип("Массив") Тогда
        ВызватьИсключение "платформа_настройка_некорректно_схема";
    КонецЕсли;
    Если УчетныеЗаписи.Количество() < 1 Или УчетныеЗаписи.Количество() > 50 Тогда
        ВызватьИсключение "платформа_настройка_некорректно_пакет_размер";
    КонецЕсли;

    Активность = Новый Соответствие;
    Для Каждого УчетныеДанные Из УчетныеЗаписи Цикл
        ПроверитьУчетныеДанные(УчетныеДанные);
        Нормализованный = НРег(УчетныеДанные.name);
        Если Активность.Получить(Нормализованный) <> Неопределено Тогда
            ВызватьИсключение "платформа_настройка_дубликат_вход";
        КонецЕсли;
        Активность.Вставить(Нормализованный, Истина);
    КонецЦикла;
    Возврат УчетныеЗаписи;
КонецФункции

Процедура ПроверитьУчетныеДанные(УчетныеДанные)
    Если ТипЗнч(УчетныеДанные) <> Тип("Структура") Тогда
        ВызватьИсключение "платформа_настройка_некорректно_учетная_запись";
    КонецЕсли;
    Если УчетныеДанные.Количество() <> 3 Тогда
        ВызватьИсключение "платформа_настройка_некорректно_учетная_запись";
    КонецЕсли;
    Войти = Неопределено;
    Пароль = Неопределено;
    ПредставлениеИмя = Неопределено;
    Если Не УчетныеДанные.Свойство("name", Войти) Или Не УчетныеДанные.Свойство("password", Пароль)
        Или Не УчетныеДанные.Свойство("displayName", ПредставлениеИмя) Тогда
        ВызватьИсключение "платформа_настройка_некорректно_учетная_запись";
    КонецЕсли;
    Если ТипЗнч(Войти) <> Тип("Строка") Тогда
        ВызватьИсключение "платформа_настройка_некорректно_вход";
    КонецЕсли;
    Если СтрДлина(Войти) < 3 Или СтрДлина(Войти) > 64 Тогда
        ВызватьИсключение "платформа_настройка_некорректно_вход";
    КонецЕсли;
    Разрешенные = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-";
    Для Позиция = 1 По СтрДлина(Войти) Цикл
        Если СтрНайти(Разрешенные, Сред(Войти, Позиция, 1)) = 0 Тогда
            ВызватьИсключение "платформа_настройка_некорректно_вход";
        КонецЕсли;
    КонецЦикла;
    Если ТипЗнч(Пароль) <> Тип("Строка") Тогда
        ВызватьИсключение "платформа_настройка_некорректно_пароль";
    КонецЕсли;
    Если СтрДлина(Пароль) < 24 Или СтрДлина(Пароль) > 128 Тогда
        ВызватьИсключение "платформа_настройка_некорректно_пароль";
    КонецЕсли;
    Если ТипЗнч(ПредставлениеИмя) <> Тип("Строка") Тогда
        ВызватьИсключение "платформа_настройка_некорректно_отображение_имя";
    КонецЕсли;
    Если ПустаяСтрока(ПредставлениеИмя) Или СтрДлина(ПредставлениеИмя) > 150 Тогда
        ВызватьИсключение "платформа_настройка_некорректно_отображение_имя";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьДоступностьПакетаУчетныхЗаписей(УчетныеЗаписи)
    ПлатформенныйИмена = Новый Соответствие;
    Для Каждого Пользователь Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
        ПлатформенныйИмена.Вставить(НРег(Пользователь.Имя), Истина);
    КонецЦикла;
    Для Каждого УчетныеДанные Из УчетныеЗаписи Цикл
        Нормализованный = НРег(УчетныеДанные.name);
        Если ПлатформенныйИмена.Получить(Нормализованный) <> Неопределено Тогда
            ВызватьИсключение "платформа_настройка_существующий_платформа_пользователь_восстановление_требуется";
        КонецЕсли;
        ПроверитьДоступностьИмениВхода(Нормализованный);
    КонецЦикла;
КонецПроцедуры

Процедура ПроверитьДоступностьИмениВхода(Нормализованный)
    Привязка = РегистрыСведений.ПривязкиЛогинов.СоздатьМенеджерЗаписи();
    Привязка.НормализованныйЛогин = Нормализованный;
    Привязка.Прочитать();
    Если Привязка.Выбран() Тогда
        ВызватьИсключение "платформа_настройка_вход_конфликт";
    КонецЕсли;
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.УчетныеЗаписи
        |ГДЕ НормализованныйЛогин = &НормализованныйЛогин");
    Запрос.УстановитьПараметр("НормализованныйЛогин", Нормализованный);
    Если Не Запрос.Выполнить().Пустой() Тогда
        ВызватьИсключение "платформа_настройка_вход_конфликт";
    КонецЕсли;
КонецПроцедуры

Функция СоздатьНативнуюУчетнуюЗапись(УчетныеДанные)
    Пользователь = ПользователиИнформационнойБазы.СоздатьПользователя();
    Пользователь.Имя = УчетныеДанные.name;
    Пользователь.ПолноеИмя = СокрЛП(УчетныеДанные.displayName);
    Пользователь.АутентификацияСтандартная = Истина;
    Пользователь.АутентификацияОС = Ложь;
    Пользователь.ПоказыватьВСпискеВыбора = Ложь;
    Пользователь.Пароль = УчетныеДанные.password;
    Пользователь.Язык = Метаданные.Языки.Русский;
    Пользователь.Роли.Добавить(Метаданные.Роли.APIКабинета);
    Попытка
        Пользователь.Записать();
    Исключение
        ВызватьИсключение "платформа_настройка_платформа_запись_не_удалось_восстановление_требуется";
    КонецПопытки;
    Возврат Новый Структура("nativeUserId,loginNormalized,displayName",
        Строка(Пользователь.УникальныйИдентификатор), НРег(УчетныеДанные.name), СокрЛП(УчетныеДанные.displayName));
КонецФункции

Процедура ЗаблокироватьКлючиИдентификации(УчетныеЗаписи)
    Ключи = Новый ТаблицаЗначений;
    Ключи.Колонки.Добавить("ПространствоИмен");
    Ключи.Колонки.Добавить("КлючИмя");
    Ключи.Колонки.Добавить("КлючЗначение");
    Для Каждого Объект Из УчетныеЗаписи Цикл
        СтрокаВыборки = Ключи.Добавить();
        СтрокаВыборки.ПространствоИмен = "РегистрСведений.ПривязкиЛогинов";
        СтрокаВыборки.КлючИмя = "LoginNormalized";
        СтрокаВыборки.КлючЗначение = Объект.loginNormalized;
        СтрокаВыборки = Ключи.Добавить();
        СтрокаВыборки.ПространствоИмен = "РегистрСведений.ПривязкиПользователей1С";
        СтрокаВыборки.КлючИмя = "NativeUserId";
        СтрокаВыборки.КлючЗначение = Объект.nativeUserId;
    КонецЦикла;
    Ключи.Сортировать("ПространствоИмен, КлючЗначение");
    Блокировка = Новый БлокировкаДанных;
    Для Каждого СтрокаВыборки Из Ключи Цикл
        Объект = Блокировка.Добавить(СтрокаВыборки.ПространствоИмен);
        Объект.УстановитьЗначение(СтрокаВыборки.КлючИмя, СтрокаВыборки.КлючЗначение);
        Объект.Режим = РежимБлокировкиДанных.Исключительный;
    КонецЦикла;
    Блокировка.Заблокировать();
КонецПроцедуры


Функция СоздатьПубличногоЧитателяИзФайлаОператора() Экспорт
    ПубличныйЧитательВыполнить("create");
    Возврат "public_reader_create_completed";
КонецФункции

Функция ПроверитьПубличногоЧитателяИзФайлаОператора() Экспорт
    ПубличныйЧитательВыполнить("verify");
    Возврат "public_reader_verify_completed";
КонецФункции

Функция ПроверитьИзолированногоПубличногоЧитателяИзФайлаОператора() Экспорт
    ПубличныйЧитательПроверитьАдминистратора();
    Вход = ПубличныйЧитательПрочитатьВвод();
    ОжидаемаяБаза = ПубличныйЧитательЦельВосстановления(Вход);
    ПубличныйЧитательПроверитьСоединение(СтрокаСоединенияИнформационнойБазы(), ОжидаемаяБаза);
    ПубличныйЧитательПроверитьОтсутствиеРезультата();
    Результат = ПубличныйЧитательПроверитьCore(Вход, ОжидаемаяБаза);
    ПубличныйЧитательЗаписатьРезультат(Результат);
    Возврат "public_reader_verify_completed";
КонецФункции

Функция ГидрочитательПроверитьИзолированнуюБазуИзФайлаОператора() Экспорт
    ПубличныйЧитательПроверитьАдминистратора();
    Вход = ГидрочитательПрочитатьВвод();
    ОжидаемаяБаза = ПубличныйЧитательЦельВосстановления(Вход);
    ПубличныйЧитательПроверитьСоединение(СтрокаСоединенияИнформационнойБазы(), ОжидаемаяБаза);
    ГидрочитательПроверитьОтсутствиеРезультата();
    Результат = ГидрочитательПроверитьCore(Вход, ОжидаемаяБаза);
    ГидрочитательЗаписатьРезультат(Результат);
    Возврат "hydrology_reader_verify_completed";
КонецФункции

Функция ПубличныйЧитательЦельВосстановления(Вход)
    Если ТипЗнч(Вход) <> Тип("Структура") Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    Если Не Вход.Свойство("target") Или Не Вход.Свойство("currentVersion") Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    Если ТипЗнч(Вход.currentVersion) <> Тип("Строка") Или Вход.currentVersion <> "1.0" Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    Если ТипЗнч(Вход.target) <> Тип("Структура") Или Вход.target.Количество() <> 2 Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    Если Не Вход.target.Свойство("server") Или Не Вход.target.Свойство("ref") Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    Если ТипЗнч(Вход.target.server) <> Тип("Строка") Или ТипЗнч(Вход.target.ref) <> Тип("Строка") Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    Если Вход.target.server <> "onec:1541" Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    ИмяБазы = Вход.target.ref;
    Если Лев(ИмяБазы, 11) <> "vk_restore_" Или СтрДлина(ИмяБазы) < 12 Или СтрДлина(ИмяБазы) > 43 Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    Для Н = 12 По СтрДлина(ИмяБазы) Цикл
        Если СтрНайти("abcdefghijklmnopqrstuvwxyz0123456789_", Сред(ИмяБазы, Н, 1)) = 0 Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    КонецЦикла;
    Возврат ИмяБазы;
КонецФункции

Процедура ПубличныйЧитательВыполнить(Режим)
    ПубличныйЧитательПроверитьАдминистратора();
    ПубличныйЧитательПроверитьСоединение(СтрокаСоединенияИнформационнойБазы());
    Попытка
        ПубличныйЧитательПроверитьОтсутствиеРезультата();
        Вход = ПубличныйЧитательПрочитатьВвод();
        Если Режим = "create" Тогда
            Результат = ПубличныйЧитательСоздатьCore(Вход);
        ИначеЕсли Режим = "verify" Тогда
            Результат = ПубличныйЧитательПроверитьCore(Вход);
        Иначе
            ПубличныйЧитательОтказать();
        КонецЕсли;
        ПубличныйЧитательЗаписатьРезультат(Результат);
    Исключение
        Попытка
            Ошибка = Новый Структура("schema,purpose,status,code", 1,
                "public_lab_native_principal", "failed", "публичный_читатель_операция_не_удалось");
            ПубличныйЧитательЗаписатьРезультат(Ошибка);
        Исключение
        КонецПопытки;
        ПубличныйЧитательОтказать();
    КонецПопытки;
КонецПроцедуры

Процедура ПубличныйЧитательПроверитьАдминистратора()
    Если ПривилегированныйРежим() Или ТранзакцияАктивна() Тогда
        ПубличныйЧитательОтказать();
    КонецЕсли;
    Если Не РольДоступна("Администратор") Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    Текущий = ПользователиИнформационнойБазы.ТекущийПользователь();
    Если Текущий = Неопределено Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    Если ПустаяСтрока(Текущий.Имя) Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    Свежий = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Текущий.УникальныйИдентификатор);
    Если Свежий = Неопределено Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    Если ПустаяСтрока(Свежий.Имя) Или Свежий.Имя <> Текущий.Имя Тогда
        ПубличныйЧитательОтказать();
    КонецЕсли;
    Администратор = Ложь;
    Для Каждого Роль Из Свежий.Роли Цикл
        Если Роль = Метаданные.Роли.Администратор Тогда Администратор = Истина; КонецЕсли;
    КонецЦикла;
    Если Не Администратор Тогда ПубличныйЧитательОтказать(); КонецЕсли;
КонецПроцедуры

Процедура ПубличныйЧитательПроверитьСоединение(Соединение, ОжидаемаяБаза = "vodokanal")
    Если ТипЗнч(Соединение) <> Тип("Строка") Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    Если СтрДлина(Соединение) > 4096 Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    Части = Новый Соответствие;
    Для Каждого Часть Из СтрРазделить(Соединение, ";", Ложь) Цикл
        Часть = СокрЛП(Часть);
        Если Часть = "" Тогда Продолжить; КонецЕсли;
        Разделитель = СтрНайти(Часть, "=");
        Если Разделитель < 2 Тогда ПубличныйЧитательОтказать(); КонецЕсли;
        Ключ = НРег(СокрЛП(Лев(Часть, Разделитель - 1)));
        Если Ключ <> "srvr" И Ключ <> "ref" Тогда ПубличныйЧитательОтказать(); КонецЕсли;
        Если Части.Получить(Ключ) <> Неопределено Тогда ПубличныйЧитательОтказать(); КонецЕсли;
        Значение = СокрЛП(Сред(Часть, Разделитель + 1));
        Если Лев(Значение, 1) = """" Тогда
            Если СтрДлина(Значение) < 2 Или Прав(Значение, 1) <> """" Тогда
                ПубличныйЧитательОтказать();
            КонецЕсли;
            Значение = Сред(Значение, 2, СтрДлина(Значение) - 2);
        КонецЕсли;
        Если СтрНайти(Значение, """") > 0 Тогда ПубличныйЧитательОтказать(); КонецЕсли;
        Части.Вставить(Ключ, Значение);
    КонецЦикла;
    Если Части.Количество() <> 2 Или Части.Получить("srvr") <> "onec:1541"
        Или Части.Получить("ref") <> ОжидаемаяБаза Тогда
        ПубличныйЧитательОтказать();
    КонецЕсли;
КонецПроцедуры

Функция ПубличныйЧитательПрочитатьВвод()
    ФайлВвода = Новый Файл("/run/vodokanal-public-reader/input.json");
    Если Не ФайлВвода.Существует() Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    Если ФайлВвода.Размер() < 2 Или ФайлВвода.Размер() > 16384 Тогда
        ПубличныйЧитательОтказать();
    КонецЕсли;
    Чтение = Новый ЧтениеJSON;
    Попытка
        Чтение.ОткрытьФайл("/run/vodokanal-public-reader/input.json");
        Вход = ПрочитатьJSON(Чтение);
        Чтение.Закрыть();
    Исключение
        Попытка Чтение.Закрыть(); Исключение КонецПопытки;
        ПубличныйЧитательОтказать();
    КонецПопытки;
    Возврат Вход;
КонецФункции

Процедура ПубличныйЧитательПроверитьВвод(Вход, Режим, ОжидаемаяБаза = "vodokanal")
    Если ТипЗнч(Вход) <> Тип("Структура") Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    Ключи = ?(Режим = "create", "schema,purpose,mode,operationId,target,password",
        "schema,purpose,mode,operationId,target,nativeUserId");
    КоличествоКлючей = 6;
    Если Вход.Свойство("currentVersion") Тогда
        Ключи = Ключи + ",currentVersion"; КоличествоКлючей = 7;
    КонецЕсли;
    Если Вход.Количество() <> КоличествоКлючей Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    Для Каждого Ключ Из СтрРазделить(Ключи, ",") Цикл
        Если Не Вход.Свойство(Ключ) Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    КонецЦикла;
    Если ТипЗнч(Вход.schema) <> Тип("Число") Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    Если ТипЗнч(Вход.purpose) <> Тип("Строка") Или ТипЗнч(Вход.mode) <> Тип("Строка") Тогда
        ПубличныйЧитательОтказать();
    КонецЕсли;
    Если Вход.schema <> 1 Или Вход.purpose <> "public_lab_native_principal"
        Или Вход.mode <> Режим Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    Идентификатор = ПубличныйЧитательUUID(Вход.operationId);
    Если ТипЗнч(Вход.target) <> Тип("Структура") Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    Если Вход.target.Количество() <> 2 Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    Если Не Вход.target.Свойство("server") Или Не Вход.target.Свойство("ref") Тогда
        ПубличныйЧитательОтказать();
    КонецЕсли;
    Если ТипЗнч(Вход.target.server) <> Тип("Строка") Или ТипЗнч(Вход.target.ref) <> Тип("Строка") Тогда
        ПубличныйЧитательОтказать();
    КонецЕсли;
    Если Вход.target.server <> "onec:1541" Или Вход.target.ref <> ОжидаемаяБаза Тогда
        ПубличныйЧитательОтказать();
    КонецЕсли;
    Если Режим = "create" Тогда
        Версия = ПубличныйЧитательВерсияПроверки(Вход);
        Если Версия <> "0.4.0-lab.6" И Версия <> "0.6.0-p0" И Версия <> "1.0" Тогда ПубличныйЧитательОтказать(); КонецЕсли;
        ПубличныйЧитательПроверитьПароль(Вход.password);
    ИначеЕсли Режим = "verify" Тогда
        Идентификатор = ПубличныйЧитательUUID(Вход.nativeUserId);
        Версия = ПубличныйЧитательВерсияПроверки(Вход);
    Иначе
        ПубличныйЧитательОтказать();
    КонецЕсли;
КонецПроцедуры

Функция ПубличныйЧитательUUID(Значение)
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    Если СтрДлина(Значение) <> 36 Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    Попытка
        Идентификатор = Новый УникальныйИдентификатор(Значение);
    Исключение
        ПубличныйЧитательОтказать();
    КонецПопытки;
    Если Строка(Идентификатор) <> Значение Или Значение = "00000000-0000-0000-0000-000000000000" Тогда
        ПубличныйЧитательОтказать();
    КонецЕсли;
    Возврат Идентификатор;
КонецФункции

Процедура ПубличныйЧитательПроверитьПароль(Значение)
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    Если СтрДлина(Значение) <> 64 Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    Верх = Ложь; Низ = Ложь; Цифра = Ложь;
    Для Позиция = 1 По СтрДлина(Значение) Цикл
        Знак = Сред(Значение, Позиция, 1);
        Если СтрНайти("ABCDEFGHIJKLMNOPQRSTUVWXYZ", Знак) > 0 Тогда
            Верх = Истина;
        ИначеЕсли СтрНайти("abcdefghijklmnopqrstuvwxyz", Знак) > 0 Тогда
            Низ = Истина;
        ИначеЕсли СтрНайти("0123456789", Знак) > 0 Тогда
            Цифра = Истина;
        ИначеЕсли Знак <> "_" И Знак <> "-" Тогда
            ПубличныйЧитательОтказать();
        КонецЕсли;
    КонецЦикла;
    Если Не Верх Или Не Низ Или Не Цифра Тогда ПубличныйЧитательОтказать(); КонецЕсли;
КонецПроцедуры

Функция ПубличныйЧитательВерсияПроверки(Вход)
    Версия = "0.4.0-lab.6";
    Если Вход.Свойство("currentVersion") Тогда Версия = Вход.currentVersion; КонецЕсли;
    Если ТипЗнч(Версия) <> Тип("Строка") Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    Если Версия <> "0.4.0-lab.6" И Версия <> "0.4.0-lab.8" И Версия <> "0.4.0-lab.9" И Версия <> "0.5.0-p0.1"
        И Версия <> "0.6.0-p0" И Версия <> "1.0" Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    Возврат Версия;
КонецФункции

Функция ПубличныйЧитательПроверитьМетаданные(ОжидаемаяВерсия = "0.4.0-lab.6")
    Если ТипЗнч(ОжидаемаяВерсия) <> Тип("Строка") Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    Если ОжидаемаяВерсия <> "0.4.0-lab.6" И ОжидаемаяВерсия <> "0.4.0-lab.8" И ОжидаемаяВерсия <> "0.4.0-lab.9" И ОжидаемаяВерсия <> "0.5.0-p0.1"
        И ОжидаемаяВерсия <> "0.6.0-p0" И ОжидаемаяВерсия <> "1.0" Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    Если Метаданные.Версия <> ОжидаемаяВерсия Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    Роль = Метаданные.Роли.Найти("ПубличноеЧтениеЛаборатории");
    Если Роль = Неопределено Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    Если Роль.Имя <> "ПубличноеЧтениеЛаборатории"
        Или Роль.РасширениеКонфигурации() <> Неопределено
        Или Роль.ЕстьИзмененияРасширениямиКонфигурации() Тогда
        ПубличныйЧитательОтказать();
    КонецЕсли;
    Возврат Роль;
КонецФункции

Функция ПубличныйЧитательСоздатьCore(Вход)
    ПубличныйЧитательПроверитьАдминистратора();
    ПубличныйЧитательПроверитьВвод(Вход, "create");
    Роль = ПубличныйЧитательПроверитьМетаданные(ПубличныйЧитательВерсияПроверки(Вход));
    Для Каждого Существующий Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
        Если НРег(Существующий.Имя) = "vodokanal_public_reader" Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    КонецЦикла;
    ПубличныйЧитательПроверитьПрикладныеПривязки("");
    Пользователь = ПользователиИнформационнойБазы.СоздатьПользователя();
    Для Каждого СуществующаяРоль Из Пользователь.Роли Цикл ПубличныйЧитательОтказать(); КонецЦикла;
    Пользователь.Имя = "vodokanal_public_reader";
    Пользователь.ПолноеИмя = "Публичное чтение лаборатории";
    Пользователь.АутентификацияСтандартная = Истина;
    Пользователь.АутентификацияОС = Ложь;
    Пользователь.ПоказыватьВСпискеВыбора = Ложь;
    Пользователь.Роли.Добавить(Роль);
    Пользователь.Пароль = Вход.password;
    ПубличныйЧитательПроверитьСвойства(Пользователь, Роль);
    Попытка
        Пользователь.Записать();
    Исключение
        ПубличныйЧитательОтказать();
    КонецПопытки;
    Вход.password = "";
    Идентификатор = Строка(Пользователь.УникальныйИдентификатор);
    Свежий = ПубличныйЧитательПрочитатьПроверенного(Идентификатор, Роль);
    Возврат ПубличныйЧитательРезультат(Вход, "created", Свежий);
КонецФункции

Функция ПубличныйЧитательПроверитьCore(Вход, ОжидаемаяБаза = "vodokanal")
    ПубличныйЧитательПроверитьАдминистратора();
    ПубличныйЧитательПроверитьВвод(Вход, "verify", ОжидаемаяБаза);
    Роль = ПубличныйЧитательПроверитьМетаданные(ПубличныйЧитательВерсияПроверки(Вход));
    Свежий = ПубличныйЧитательПрочитатьПроверенного(Вход.nativeUserId, Роль);
    Возврат ПубличныйЧитательРезультат(Вход, "verified", Свежий);
КонецФункции

Функция ПубличныйЧитательПрочитатьПроверенного(Идентификатор, Роль)
    УникальныйИдентификаторПользователя = ПубличныйЧитательUUID(Идентификатор);
    Пользователь = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(УникальныйИдентификаторПользователя);
    Если Пользователь = Неопределено Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    ПоИмени = ПользователиИнформационнойБазы.НайтиПоИмени("vodokanal_public_reader");
    Если ПоИмени = Неопределено Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    Если ПоИмени.УникальныйИдентификатор <> УникальныйИдентификаторПользователя Или Пользователь.УникальныйИдентификатор <> УникальныйИдентификаторПользователя Тогда
        ПубличныйЧитательОтказать();
    КонецЕсли;
    ЧислоСовпадений = 0;
    Для Каждого Другой Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
        Если НРег(Другой.Имя) = "vodokanal_public_reader" Тогда
            ЧислоСовпадений = ЧислоСовпадений + 1;
            Если Другой.УникальныйИдентификатор <> УникальныйИдентификаторПользователя Тогда ПубличныйЧитательОтказать(); КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Если ЧислоСовпадений <> 1 Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    ПубличныйЧитательПроверитьСвойства(Пользователь, Роль);
    ПубличныйЧитательПроверитьПрикладныеПривязки(Идентификатор);
    Возврат Пользователь;
КонецФункции

Процедура ПубличныйЧитательПроверитьСвойства(Пользователь, ОжидаемаяРоль)
    Если Пользователь.Имя <> "vodokanal_public_reader"
        Или Не Пользователь.АутентификацияСтандартная Или Пользователь.АутентификацияОС
        Или Пользователь.ПоказыватьВСпискеВыбора Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    КоличествоРолей = 0;
    Для Каждого Роль Из Пользователь.Роли Цикл
        КоличествоРолей = КоличествоРолей + 1;
        Если Роль <> ОжидаемаяРоль Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    КонецЦикла;
    Если КоличествоРолей <> 1 Тогда ПубличныйЧитательОтказать(); КонецЕсли;
КонецПроцедуры

Процедура ПубличныйЧитательПроверитьПрикладныеПривязки(Идентификатор)
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.УчетныеЗаписи
        |ГДЕ НормализованныйЛогин = &Логин");
    Запрос.УстановитьПараметр("Логин", "vodokanal_public_reader");
    Если Не Запрос.Выполнить().Пустой() Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    ПривязкаЛогина = РегистрыСведений.ПривязкиЛогинов.СоздатьМенеджерЗаписи();
    ПривязкаЛогина.НормализованныйЛогин = "vodokanal_public_reader";
    ПривязкаЛогина.Прочитать();
    Если ПривязкаЛогина.Выбран() Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    Если Идентификатор = "" Тогда Возврат; КонецЕсли;
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.УчетныеЗаписи
        |ГДЕ ИдентификаторПользователя1С = &Идентификатор");
    Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
    Если Не Запрос.Выполнить().Пустой() Тогда ПубличныйЧитательОтказать(); КонецЕсли;
    Привязка = РегистрыСведений.ПривязкиПользователей1С.СоздатьМенеджерЗаписи();
    Привязка.ИдентификаторПользователя1С = Идентификатор;
    Привязка.Прочитать();
    Если Привязка.Выбран() Тогда ПубличныйЧитательОтказать(); КонецЕсли;
КонецПроцедуры

Функция ПубличныйЧитательРезультат(Вход, Статус, Пользователь)
    Результат = Новый Структура;
    Результат.Вставить("schema", 1);
    Результат.Вставить("purpose", "public_lab_native_principal");
    Результат.Вставить("mode", Вход.mode);
    Результат.Вставить("operationId", Вход.operationId);
    Результат.Вставить("status", Статус);
    Результат.Вставить("server", "onec:1541");
    Результат.Вставить("ref", Вход.target.ref);
    Результат.Вставить("nativeUserId", Строка(Пользователь.УникальныйИдентификатор));
    Результат.Вставить("name", Пользователь.Имя);
    Результат.Вставить("roleName", "ПубличноеЧтениеЛаборатории");
    Результат.Вставить("roleUuid", "1f7f42b8-556e-6406-580f-81251f474d7f");
    Результат.Вставить("standardAuth", Пользователь.АутентификацияСтандартная);
    Результат.Вставить("osAuth", Пользователь.АутентификацияОС);
    Результат.Вставить("showInList", Пользователь.ПоказыватьВСпискеВыбора);
    Результат.Вставить("configurationVersion", Метаданные.Версия);
    Результат.Вставить("checkedAtUtc", XMLСтрока(ТекущаяУниверсальнаяДата()) + "Z");
    Возврат Результат;
КонецФункции

Процедура ПубличныйЧитательПроверитьОтсутствиеРезультата()
    ФайлРезультата = Новый Файл("/run/vodokanal-public-reader/result.json");
    Если ФайлРезультата.Существует() Тогда ПубличныйЧитательОтказать(); КонецЕсли;
КонецПроцедуры

Процедура ПубличныйЧитательЗаписатьРезультат(Результат)
    ПубличныйЧитательПроверитьОтсутствиеРезультата();
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Результат);
    Данные = ПолучитьДвоичныеДанныеИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8, Ложь);
    Поток = Новый ФайловыйПоток("/run/vodokanal-public-reader/result.json",
        РежимОткрытияФайла.СоздатьНовый, ДоступКФайлу.Запись);
    Попытка
        Данные.Записать(Поток);
        Поток.Закрыть();
    Исключение
        Попытка Поток.Закрыть(); Исключение КонецПопытки;
        ПубличныйЧитательОтказать();
    КонецПопытки;
КонецПроцедуры

Процедура ПубличныйЧитательОтказать()
    ВызватьИсключение "публичный_читатель_операция_не_удалось";
КонецПроцедуры

Функция ГидрочитательСоздатьИзФайлаОператора() Экспорт
    ГидрочитательВыполнить("create");
    Возврат "hydrology_reader_create_completed";
КонецФункции

Функция ГидрочитательПроверитьИзФайлаОператора() Экспорт
    ГидрочитательВыполнить("verify");
    Возврат "hydrology_reader_verify_completed";
КонецФункции

Процедура ГидрочитательВыполнить(Режим)
    ПубличныйЧитательПроверитьАдминистратора();
    ПубличныйЧитательПроверитьСоединение(СтрокаСоединенияИнформационнойБазы());
    Попытка
        ГидрочитательПроверитьОтсутствиеРезультата();
        Вход = ГидрочитательПрочитатьВвод();
        Если Режим = "create" Тогда
            Результат = ГидрочитательСоздатьCore(Вход);
        ИначеЕсли Режим = "verify" Тогда
            Результат = ГидрочитательПроверитьCore(Вход);
        Иначе ГидрочитательОтказать();
        КонецЕсли;
        ГидрочитательЗаписатьРезультат(Результат);
    Исключение
        Попытка
            ГидрочитательЗаписатьРезультат(Новый Структура("schema,purpose,status,code", 1,
                "public_hydrology_native_principal", "failed", "гидрология_читатель_операция_не_удалось"));
        Исключение
        КонецПопытки;
        ГидрочитательОтказать();
    КонецПопытки;
КонецПроцедуры

Функция ГидрочитательПрочитатьВвод()
    Путь = "/run/vodokanal-hydrology-reader/input.json";
    ФайлВвода = Новый Файл(Путь);
    Если Не ФайлВвода.Существует() Тогда ГидрочитательОтказать(); КонецЕсли;
    Если ФайлВвода.Размер() < 2 Или ФайлВвода.Размер() > 16384 Тогда ГидрочитательОтказать(); КонецЕсли;
    Чтение = Новый ЧтениеJSON;
    Попытка
        Чтение.ОткрытьФайл(Путь); Вход = ПрочитатьJSON(Чтение); Чтение.Закрыть();
    Исключение
        Попытка Чтение.Закрыть(); Исключение КонецПопытки;
        ГидрочитательОтказать();
    КонецПопытки;
    Возврат Вход;
КонецФункции

Процедура ГидрочитательПроверитьВвод(Вход, Режим, ОжидаемаяБаза = "vodokanal")
    Если ТипЗнч(Вход) <> Тип("Структура") Тогда ГидрочитательОтказать(); КонецЕсли;
    Если Режим <> "create" И Режим <> "verify" Тогда ГидрочитательОтказать(); КонецЕсли;
    Ключи = "schema,purpose,mode,operationId,target,currentVersion," + ?(Режим = "create", "password", "nativeUserId");
    Если Вход.Количество() <> 7 Тогда ГидрочитательОтказать(); КонецЕсли;
    Для Каждого Ключ Из СтрРазделить(Ключи, ",") Цикл
        Если Не Вход.Свойство(Ключ) Тогда ГидрочитательОтказать(); КонецЕсли;
    КонецЦикла;
    Если ТипЗнч(Вход.schema) <> Тип("Число") Или ТипЗнч(Вход.purpose) <> Тип("Строка")
        Или ТипЗнч(Вход.mode) <> Тип("Строка") Или ТипЗнч(Вход.currentVersion) <> Тип("Строка") Тогда ГидрочитательОтказать(); КонецЕсли;
    Если Вход.schema <> 1 Или Вход.purpose <> "public_hydrology_native_principal"
        Или Вход.mode <> Режим Тогда ГидрочитательОтказать(); КонецЕсли;
    Если Вход.currentVersion <> "0.5.0-p0.1" И Вход.currentVersion <> "0.6.0-p0" И Вход.currentVersion <> "1.0" Тогда ГидрочитательОтказать(); КонецЕсли;
    Идентификатор = ПубличныйЧитательUUID(Вход.operationId);
    Если ТипЗнч(Вход.target) <> Тип("Структура") Тогда ГидрочитательОтказать(); КонецЕсли;
    Если Вход.target.Количество() <> 2 Тогда ГидрочитательОтказать(); КонецЕсли;
    Если Не Вход.target.Свойство("server") Или Не Вход.target.Свойство("ref") Тогда ГидрочитательОтказать(); КонецЕсли;
    Если ТипЗнч(Вход.target.server) <> Тип("Строка") Или ТипЗнч(Вход.target.ref) <> Тип("Строка") Тогда ГидрочитательОтказать(); КонецЕсли;
    Если Вход.target.server <> "onec:1541" Или Вход.target.ref <> ОжидаемаяБаза Тогда ГидрочитательОтказать(); КонецЕсли;
    Если Режим = "create" Тогда
        ПубличныйЧитательПроверитьПароль(Вход.password);
    Иначе
        Идентификатор = ПубличныйЧитательUUID(Вход.nativeUserId);
    КонецЕсли;
КонецПроцедуры

Функция ГидрочитательПроверитьМетаданные(ОжидаемаяВерсия = "0.5.0-p0.1")
    Если ТипЗнч(ОжидаемаяВерсия) <> Тип("Строка") Тогда ГидрочитательОтказать(); КонецЕсли;
    Если ОжидаемаяВерсия <> "0.5.0-p0.1" И ОжидаемаяВерсия <> "0.6.0-p0" И ОжидаемаяВерсия <> "1.0" Тогда ГидрочитательОтказать(); КонецЕсли;
    Если Метаданные.Версия <> ОжидаемаяВерсия Тогда ГидрочитательОтказать(); КонецЕсли;
    Роль = Метаданные.Роли.Найти("ПубличноеЧтениеГидрологии");
    Если Роль = Неопределено Тогда ГидрочитательОтказать(); КонецЕсли;
    Если Роль.Имя <> "ПубличноеЧтениеГидрологии" Или Роль.РасширениеКонфигурации() <> Неопределено
        Или Роль.ЕстьИзмененияРасширениямиКонфигурации() Тогда ГидрочитательОтказать(); КонецЕсли;
    Возврат Роль;
КонецФункции

Функция ГидрочитательСоздатьCore(Вход)
    ПубличныйЧитательПроверитьАдминистратора();
    ГидрочитательПроверитьВвод(Вход, "create");
    Роль = ГидрочитательПроверитьМетаданные(Вход.currentVersion);
    Для Каждого Существующий Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
        Если НРег(Существующий.Имя) = "vodokanal_hydrology_reader" Тогда ГидрочитательОтказать(); КонецЕсли;
    КонецЦикла;
    ГидрочитательПроверитьПрикладныеПривязки("");
    Пользователь = ПользователиИнформационнойБазы.СоздатьПользователя();
    Для Каждого СуществующаяРоль Из Пользователь.Роли Цикл ГидрочитательОтказать(); КонецЦикла;
    Пользователь.Имя = "vodokanal_hydrology_reader";
    Пользователь.ПолноеИмя = "Публичное чтение учебной гидрологии";
    Пользователь.АутентификацияСтандартная = Истина;
    Пользователь.АутентификацияОС = Ложь;
    Пользователь.ПоказыватьВСпискеВыбора = Ложь;
    Пользователь.Роли.Добавить(Роль);
    Пользователь.Пароль = Вход.password;
    ГидрочитательПроверитьСвойства(Пользователь, Роль);
    Попытка
        Пользователь.Записать();
    Исключение ГидрочитательОтказать();
    КонецПопытки;
    Вход.password = "";
    Свежий = ГидрочитательПрочитатьПроверенного(Строка(Пользователь.УникальныйИдентификатор), Роль);
    Возврат ГидрочитательРезультат(Вход, "created", Свежий);
КонецФункции

Функция ГидрочитательПроверитьCore(Вход, ОжидаемаяБаза = "vodokanal")
    ПубличныйЧитательПроверитьАдминистратора();
    ГидрочитательПроверитьВвод(Вход, "verify", ОжидаемаяБаза);
    Роль = ГидрочитательПроверитьМетаданные(Вход.currentVersion);
    Свежий = ГидрочитательПрочитатьПроверенного(Вход.nativeUserId, Роль);
    Возврат ГидрочитательРезультат(Вход, "verified", Свежий);
КонецФункции

Функция ГидрочитательПрочитатьПроверенного(Идентификатор, Роль)
    НативныйИд = ПубличныйЧитательUUID(Идентификатор);
    Пользователь = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(НативныйИд);
    Если Пользователь = Неопределено Тогда ГидрочитательОтказать(); КонецЕсли;
    ПоИмени = ПользователиИнформационнойБазы.НайтиПоИмени("vodokanal_hydrology_reader");
    Если ПоИмени = Неопределено Тогда ГидрочитательОтказать(); КонецЕсли;
    Если ПоИмени.УникальныйИдентификатор <> НативныйИд Или Пользователь.УникальныйИдентификатор <> НативныйИд Тогда ГидрочитательОтказать(); КонецЕсли;
    Количество = 0;
    Для Каждого Другой Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
        Если НРег(Другой.Имя) = "vodokanal_hydrology_reader" Тогда
            Количество = Количество + 1;
            Если Другой.УникальныйИдентификатор <> НативныйИд Тогда ГидрочитательОтказать(); КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Если Количество <> 1 Тогда ГидрочитательОтказать(); КонецЕсли;
    ГидрочитательПроверитьСвойства(Пользователь, Роль);
    ГидрочитательПроверитьПрикладныеПривязки(Идентификатор);
    Возврат Пользователь;
КонецФункции

Процедура ГидрочитательПроверитьСвойства(Пользователь, ОжидаемаяРоль)
    Если Пользователь.Имя <> "vodokanal_hydrology_reader" Или Не Пользователь.АутентификацияСтандартная
        Или Пользователь.АутентификацияОС Или Пользователь.ПоказыватьВСпискеВыбора Тогда ГидрочитательОтказать(); КонецЕсли;
    Количество = 0;
    Для Каждого Роль Из Пользователь.Роли Цикл
        Количество = Количество + 1;
        Если Роль <> ОжидаемаяРоль Тогда ГидрочитательОтказать(); КонецЕсли;
    КонецЦикла;
    Если Количество <> 1 Тогда ГидрочитательОтказать(); КонецЕсли;
КонецПроцедуры

Процедура ГидрочитательПроверитьПрикладныеПривязки(Идентификатор)
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.УчетныеЗаписи ГДЕ НормализованныйЛогин = &Логин");
    Запрос.УстановитьПараметр("Логин", "vodokanal_hydrology_reader");
    Если Не Запрос.Выполнить().Пустой() Тогда ГидрочитательОтказать(); КонецЕсли;
    ПривязкаЛогина = РегистрыСведений.ПривязкиЛогинов.СоздатьМенеджерЗаписи();
    ПривязкаЛогина.НормализованныйЛогин = "vodokanal_hydrology_reader"; ПривязкаЛогина.Прочитать();
    Если ПривязкаЛогина.Выбран() Тогда ГидрочитательОтказать(); КонецЕсли;
    Если Идентификатор = "" Тогда Возврат; КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.УчетныеЗаписи ГДЕ ИдентификаторПользователя1С = &Ид");
    Запрос.УстановитьПараметр("Ид", Идентификатор);
    Если Не Запрос.Выполнить().Пустой() Тогда ГидрочитательОтказать(); КонецЕсли;
    Привязка = РегистрыСведений.ПривязкиПользователей1С.СоздатьМенеджерЗаписи();
    Привязка.ИдентификаторПользователя1С = Идентификатор; Привязка.Прочитать();
    Если Привязка.Выбран() Тогда ГидрочитательОтказать(); КонецЕсли;
КонецПроцедуры

Функция ГидрочитательРезультат(Вход, Статус, Пользователь)
    Результат = Новый Структура("schema,purpose,mode,operationId,status,server,ref", 1,
        "public_hydrology_native_principal", Вход.mode, Вход.operationId, Статус, "onec:1541", Вход.target.ref);
    Результат.Вставить("nativeUserId", Строка(Пользователь.УникальныйИдентификатор));
    Результат.Вставить("name", Пользователь.Имя);
    Результат.Вставить("roleName", "ПубличноеЧтениеГидрологии");
    Результат.Вставить("roleUuid", "d9bb82f0-0782-02b2-dc94-7262b37574b4");
    Результат.Вставить("standardAuth", Пользователь.АутентификацияСтандартная);
    Результат.Вставить("osAuth", Пользователь.АутентификацияОС);
    Результат.Вставить("showInList", Пользователь.ПоказыватьВСпискеВыбора);
    Результат.Вставить("configurationVersion", Метаданные.Версия);
    Результат.Вставить("checkedAtUtc", XMLСтрока(ТекущаяУниверсальнаяДата()) + "Z");
    Возврат Результат;
КонецФункции

Процедура ГидрочитательПроверитьОтсутствиеРезультата()
    ФайлРезультата = Новый Файл("/run/vodokanal-hydrology-reader/result.json");
    Если ФайлРезультата.Существует() Тогда ГидрочитательОтказать(); КонецЕсли;
КонецПроцедуры

Процедура ГидрочитательЗаписатьРезультат(Результат)
    ГидрочитательПроверитьОтсутствиеРезультата();
    Запись = Новый ЗаписьJSON; Запись.УстановитьСтроку(); ЗаписатьJSON(Запись, Результат);
    Данные = ПолучитьДвоичныеДанныеИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8, Ложь);
    Поток = Новый ФайловыйПоток("/run/vodokanal-hydrology-reader/result.json", РежимОткрытияФайла.СоздатьНовый, ДоступКФайлу.Запись);
    Попытка
        Данные.Записать(Поток); Поток.Закрыть();
    Исключение
        Попытка Поток.Закрыть(); Исключение КонецПопытки;
        ГидрочитательОтказать();
    КонецПопытки;
КонецПроцедуры

Процедура ГидрочитательОтказать()
    ВызватьИсключение "гидрология_читатель_операция_не_удалось";
КонецПроцедуры
