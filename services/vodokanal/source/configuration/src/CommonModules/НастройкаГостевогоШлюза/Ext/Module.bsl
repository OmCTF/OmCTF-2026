Функция НастроитьИзФайлаОператора() Экспорт
    Возврат НастроитьИзФайла(Ложь);
КонецФункции

Функция НастроитьИзолированныйШлюзИзФайлаОператора() Экспорт
    Возврат НастроитьИзФайла(Истина);
КонецФункции

Функция НастроитьИзФайла(ИзолированнаяБаза)
    ПроверитьАдминистратора();
    Если Не ИзолированнаяБаза Тогда ПроверитьСоединение(); КонецЕсли;
    Вход = Неопределено;
    Попытка
        Выход = Новый Файл("/run/vodokanal-dispatch-gateway/result.json");
        ФайлВвода = Новый Файл("/run/vodokanal-dispatch-gateway/input.json");
        Если Выход.Существует() Или Не ФайлВвода.Существует() Тогда Отказать(); КонецЕсли;
        Если ФайлВвода.Размер() < 2 Или ФайлВвода.Размер() > 16384 Тогда Отказать(); КонецЕсли;
        Чтение = Новый ЧтениеJSON; Чтение.ОткрытьФайл(ФайлВвода.ПолноеИмя); Вход = ПрочитатьJSON(Чтение); Чтение.Закрыть();
        ПроверитьВвод(Вход, ИзолированнаяБаза);
        Роль = Метаданные.Роли.Найти("ШлюзГостевыхОбращений");
        Если Роль = Неопределено Тогда Отказать(); КонецЕсли;
        Если Роль.РасширениеКонфигурации() <> Неопределено Или Роль.ЕстьИзмененияРасширениямиКонфигурации() Тогда Отказать(); КонецЕсли;
        НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
        Попытка
            Блокировка = Новый БлокировкаДанных; Элемент = Блокировка.Добавить("РегистрСведений.СекретГостевогоШлюза");
            Элемент.Режим = РежимБлокировкиДанных.Исключительный; Элемент.УстановитьЗначение("Назначение", "dispatch-v1"); Блокировка.Заблокировать();
            Настройка = РегистрыСведений.СекретГостевогоШлюза.СоздатьМенеджерЗаписи(); Настройка.Назначение = "dispatch-v1"; Настройка.Прочитать();
            Если Вход.mode = "create" Тогда
                Если Настройка.Выбран() Тогда Отказать(); КонецЕсли;
                Для Каждого Существующий Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
                    Если НРег(Существующий.Имя) = "vodokanal_intake_gateway" Тогда Отказать(); КонецЕсли;
                КонецЦикла;
                ПроверитьОтсутствиеПривязок("");
                Пользователь = ПользователиИнформационнойБазы.СоздатьПользователя();
                Для Каждого Назначенная Из Пользователь.Роли Цикл Отказать(); КонецЦикла;
                Пользователь.Имя = "vodokanal_intake_gateway"; Пользователь.ПолноеИмя = "Изолированный шлюз гостевых обращений";
                Пользователь.АутентификацияСтандартная = Истина; Пользователь.АутентификацияОС = Ложь; Пользователь.ПоказыватьВСпискеВыбора = Ложь;
                Пользователь.Роли.Добавить(Роль); Пользователь.Язык = Метаданные.Языки.Русский; Пользователь.Пароль = Вход.password;
                Пользователь.Записать(); Вход.password = "";
                НативныйИд = Строка(Пользователь.УникальныйИдентификатор);
                Настройка.Назначение = "dispatch-v1"; Настройка.КлючИсточника = Вход.sourceKey; Вход.sourceKey = "";
                Настройка.НативныйПользователь = НативныйИд; Настройка.ПубличныйАдрес = Вход.publicOrigin;
                Настройка.ЧтенийВМинуту = Вход.readsPerMinute; Настройка.ПопытокЗаписиВМинуту = Вход.writesPerMinute;
                Настройка.ДатаСоздания = ТекущаяУниверсальнаяДата(); Настройка.ВерсияКонфигурации = Метаданные.Версия;
                Настройка.Записать();
            Иначе
                НативныйИд = Вход.expectedNativeId;
                Если Не Настройка.Выбран() Или Настройка.НативныйПользователь <> НативныйИд Тогда Отказать(); КонецЕсли;
                ПроверитьКлюч(Настройка.КлючИсточника);
                Если Настройка.ПубличныйАдрес <> Вход.publicOrigin Или Настройка.ЧтенийВМинуту <> Вход.readsPerMinute
                    Или Настройка.ПопытокЗаписиВМинуту <> Вход.writesPerMinute Тогда Отказать(); КонецЕсли;
            КонецЕсли;
            Свежий = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(НативныйИд));
            ПроверитьШлюз(Свежий, Роль); ПроверитьОтсутствиеПривязок(НативныйИд);
            ЗафиксироватьТранзакцию();
        Исключение
            Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли; Отказать();
        КонецПопытки;
        Результат = Новый Структура("schema,purpose,mode,operationId,status,name,nativeUserId,roleName,configurationVersion,checkedAtUtc,server,ref",
            1, "dispatch_gateway_native_principal", Вход.mode, Вход.operationId, ?(Вход.mode = "create", "created", "verified"),
            "vodokanal_intake_gateway", НативныйИд, "ШлюзГостевыхОбращений", Метаданные.Версия,
            XMLСтрока(ТекущаяУниверсальнаяДата()) + "Z", Вход.target.server, Вход.target.ref);
        Результат.Вставить("standardAuth", Истина); Результат.Вставить("osAuth", Ложь); Результат.Вставить("showInList", Ложь);
        Результат.Вставить("publicOrigin", Вход.publicOrigin); Результат.Вставить("readsPerMinute", Вход.readsPerMinute);
        Результат.Вставить("writesPerMinute", Вход.writesPerMinute); Результат.Вставить("protectedSettingsBound", Истина);
        Запись = Новый ЗаписьJSON; Запись.УстановитьСтроку(); ЗаписатьJSON(Запись, Результат);
        Байты = ПолучитьДвоичныеДанныеИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8, Ложь);
        Поток = Новый ФайловыйПоток("/run/vodokanal-dispatch-gateway/result.json", РежимОткрытияФайла.СоздатьНовый, ДоступКФайлу.Запись);
        Попытка Байты.Записать(Поток); Поток.Закрыть(); Исключение Попытка Поток.Закрыть(); Исключение КонецПопытки; Отказать(); КонецПопытки;
        Возврат "dispatch_gateway_provision_completed";
    Исключение
        Если ТипЗнч(Вход) = Тип("Структура") Тогда
            Если Вход.Свойство("password") Тогда Вход.password = ""; КонецЕсли;
            Если Вход.Свойство("sourceKey") Тогда Вход.sourceKey = ""; КонецЕсли;
        КонецЕсли;
        Отказать();
    КонецПопытки;
КонецФункции

Процедура ПроверитьАдминистратора()
    Если ПривилегированныйРежим() Или ТранзакцияАктивна() Или Не РольДоступна("Администратор") Тогда Отказать(); КонецЕсли;
    Текущий = ПользователиИнформационнойБазы.ТекущийПользователь(); Если Текущий = Неопределено Тогда Отказать(); КонецЕсли;
    Свежий = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Текущий.УникальныйИдентификатор);
    Если Свежий = Неопределено Тогда Отказать(); КонецЕсли;
    Если ПустаяСтрока(Свежий.Имя) Или Свежий.Имя <> Текущий.Имя Тогда Отказать(); КонецЕсли;
    Администратор = Ложь;
    Для Каждого Роль Из Свежий.Роли Цикл Если Роль = Метаданные.Роли.Администратор Тогда Администратор = Истина; КонецЕсли; КонецЦикла;
    Если Не Администратор Тогда Отказать(); КонецЕсли;
КонецПроцедуры

Процедура ПроверитьШлюз(Пользователь, Роль)
    Если Пользователь = Неопределено Тогда Отказать(); КонецЕсли;
    Если Пользователь.Имя <> "vodokanal_intake_gateway" Или Не Пользователь.АутентификацияСтандартная
        Или Пользователь.АутентификацияОС Или Пользователь.ПоказыватьВСпискеВыбора Тогда Отказать(); КонецЕсли;
    ПоИмени = ПользователиИнформационнойБазы.НайтиПоИмени("vodokanal_intake_gateway");
    Если ПоИмени = Неопределено Тогда Отказать(); КонецЕсли;
    Если ПоИмени.УникальныйИдентификатор <> Пользователь.УникальныйИдентификатор Тогда Отказать(); КонецЕсли;
    Количество = 0;
    Для Каждого Назначенная Из Пользователь.Роли Цикл Количество = Количество + 1; Если Назначенная <> Роль Тогда Отказать(); КонецЕсли; КонецЦикла;
    Если Количество <> 1 Тогда Отказать(); КонецЕсли;
КонецПроцедуры

Процедура ПроверитьВвод(Вход, ИзолированнаяБаза = Ложь)
    Если ТипЗнч(Вход) <> Тип("Структура") Или Вход.Количество() <> 12 Тогда Отказать(); КонецЕсли;
    Для Каждого Ключ Из СтрРазделить("schema,purpose,mode,operationId,currentVersion,target,password,sourceKey,expectedNativeId,publicOrigin,readsPerMinute,writesPerMinute", ",") Цикл
        Если Не Вход.Свойство(Ключ) Тогда Отказать(); КонецЕсли;
    КонецЦикла;
    Если ТипЗнч(Вход.schema) <> Тип("Число") Или Вход.schema <> 1 Или Вход.purpose <> "dispatch_gateway_native_principal" Тогда Отказать(); КонецЕсли;
    Если Вход.mode <> "create" И Вход.mode <> "verify" Тогда Отказать(); КонецЕсли;
    Если ТипЗнч(Вход.currentVersion) <> Тип("Строка") Или СтрДлина(Вход.currentVersion) < 1 Или СтрДлина(Вход.currentVersion) > 64 Тогда Отказать(); КонецЕсли;
    Если Метаданные.Версия <> Вход.currentVersion Тогда Отказать(); КонецЕсли;
    ПроверитьИд(Вход.operationId);
    Если ТипЗнч(Вход.target) <> Тип("Структура") Или Вход.target.Количество() <> 2 Тогда Отказать(); КонецЕсли;
    Если Не Вход.target.Свойство("server") Или Не Вход.target.Свойство("ref") Тогда Отказать(); КонецЕсли;
    Если ТипЗнч(Вход.target.server) <> Тип("Строка") Или ТипЗнч(Вход.target.ref) <> Тип("Строка") Тогда Отказать(); КонецЕсли;
    Если Вход.target.server <> "onec:1541" Тогда Отказать(); КонецЕсли;
    Если ИзолированнаяБаза Тогда
        Если Вход.currentVersion <> "1.0" Или Вход.publicOrigin <> "http://127.0.0.1:8081" Тогда Отказать(); КонецЕсли;
        ПроверитьИмяВосстановленнойБазы(Вход.target.ref);
        ПроверитьСоединение(Вход.target.ref);
    ИначеЕсли Вход.target.ref <> "vodokanal" Тогда Отказать(); КонецЕсли;
    ПроверитьАдрес(Вход.publicOrigin);
    Если ТипЗнч(Вход.readsPerMinute) <> Тип("Число") Или ТипЗнч(Вход.writesPerMinute) <> Тип("Число") Тогда Отказать(); КонецЕсли;
    Если Вход.readsPerMinute <> Цел(Вход.readsPerMinute) Или Вход.readsPerMinute < 1 Или Вход.readsPerMinute > 1000 Тогда Отказать(); КонецЕсли;
    Если Вход.writesPerMinute <> Цел(Вход.writesPerMinute) Или Вход.writesPerMinute < 1 Или Вход.writesPerMinute > 100 Тогда Отказать(); КонецЕсли;
    Если Вход.mode = "create" Тогда
        Если Вход.expectedNativeId <> "" Тогда Отказать(); КонецЕсли;
        ПроверитьПароль(Вход.password); ПроверитьКлюч(Вход.sourceKey);
    Иначе
        Если Вход.password <> "" Или Вход.sourceKey <> "" Тогда Отказать(); КонецЕсли;
        ПроверитьИд(Вход.expectedNativeId);
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьИд(Значение)
    Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) <> 36 Тогда Отказать(); КонецЕсли;
    Ид = Новый УникальныйИдентификатор(Значение); Если НРег(Строка(Ид)) <> Значение Тогда Отказать(); КонецЕсли;
КонецПроцедуры

Процедура ПроверитьАдрес(Значение)
    Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) > 200 Тогда Отказать(); КонецЕсли;
    Если Лев(Значение, 7) = "http://" Тогда Хост = Сред(Значение, 8);
    ИначеЕсли Лев(Значение, 8) = "https://" Тогда Хост = Сред(Значение, 9); Иначе Отказать(); КонецЕсли;
    Если Хост = "" Или НРег(Хост) <> Хост Тогда Отказать(); КонецЕсли;
    Для Н = 1 По СтрДлина(Хост) Цикл
        Если СтрНайти("abcdefghijklmnopqrstuvwxyz0123456789.-:[]", Сред(Хост, Н, 1)) = 0 Тогда Отказать(); КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура ПроверитьПароль(Значение)
    Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) <> 64 Тогда Отказать(); КонецЕсли;
    Верх = Ложь; Низ = Ложь; Цифра = Ложь;
    Для Н = 1 По 64 Цикл
        Сим = Сред(Значение, Н, 1);
        Если СтрНайти("ABCDEFGHIJKLMNOPQRSTUVWXYZ", Сим) > 0 Тогда Верх = Истина;
        ИначеЕсли СтрНайти("abcdefghijklmnopqrstuvwxyz", Сим) > 0 Тогда Низ = Истина;
        ИначеЕсли СтрНайти("0123456789", Сим) > 0 Тогда Цифра = Истина;
        ИначеЕсли Сим <> "_" И Сим <> "-" Тогда Отказать(); КонецЕсли;
    КонецЦикла;
    Если Не Верх Или Не Низ Или Не Цифра Тогда Отказать(); КонецЕсли;
КонецПроцедуры

Процедура ПроверитьКлюч(Значение)
    Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) <> 64 Тогда Отказать(); КонецЕсли;
    Для Н = 1 По 64 Цикл Если СтрНайти("0123456789abcdef", Сред(Значение, Н, 1)) = 0 Тогда Отказать(); КонецЕсли; КонецЦикла;
КонецПроцедуры

Процедура ПроверитьИмяВосстановленнойБазы(ИмяБазы)
    Если ТипЗнч(ИмяБазы) <> Тип("Строка") Тогда Отказать(); КонецЕсли;
    Если Лев(ИмяБазы, 14) <> "vk_restore_p0_" Или СтрДлина(ИмяБазы) < 15 Или СтрДлина(ИмяБазы) > 43 Тогда Отказать(); КонецЕсли;
    Для Н = 15 По СтрДлина(ИмяБазы) Цикл
        Если СтрНайти("abcdefghijklmnopqrstuvwxyz0123456789_", Сред(ИмяБазы, Н, 1)) = 0 Тогда Отказать(); КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура ПроверитьСоединение(ОжидаемаяБаза = "vodokanal")
    Части = Новый Соответствие; СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
    Если СтрДлина(СтрокаСоединения) > 4096 Тогда Отказать(); КонецЕсли;
    Для Каждого Часть Из СтрРазделить(СтрокаСоединения, ";", Ложь) Цикл
        Часть = СокрЛП(Часть); Если Часть = "" Тогда Продолжить; КонецЕсли;
        Разделитель = СтрНайти(Часть, "="); Если Разделитель < 2 Тогда Отказать(); КонецЕсли;
        Ключ = НРег(СокрЛП(Лев(Часть, Разделитель - 1)));
        Если (Ключ <> "srvr" И Ключ <> "ref") Или Части.Получить(Ключ) <> Неопределено Тогда Отказать(); КонецЕсли;
        Значение = СокрЛП(Сред(Часть, Разделитель + 1));
        Если Лев(Значение, 1) = """" Тогда
            Если СтрДлина(Значение) < 2 Или Прав(Значение, 1) <> """" Тогда Отказать(); КонецЕсли;
            Значение = Сред(Значение, 2, СтрДлина(Значение) - 2);
        КонецЕсли;
        Если СтрНайти(Значение, """") > 0 Тогда Отказать(); КонецЕсли; Части.Вставить(Ключ, Значение);
    КонецЦикла;
    Если Части.Количество() <> 2 Или Части.Получить("srvr") <> "onec:1541" Или Части.Получить("ref") <> ОжидаемаяБаза Тогда Отказать(); КонецЕсли;
КонецПроцедуры

Процедура ПроверитьОтсутствиеПривязок(Ид)
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.УчетныеЗаписи ГДЕ НормализованныйЛогин = &Логин");
    Запрос.УстановитьПараметр("Логин", "vodokanal_intake_gateway"); Если Не Запрос.Выполнить().Пустой() Тогда Отказать(); КонецЕсли;
    Логин = РегистрыСведений.ПривязкиЛогинов.СоздатьМенеджерЗаписи(); Логин.НормализованныйЛогин = "vodokanal_intake_gateway"; Логин.Прочитать();
    Если Логин.Выбран() Тогда Отказать(); КонецЕсли;
    Если Ид = "" Тогда Возврат; КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.УчетныеЗаписи ГДЕ ИдентификаторПользователя1С = &Ид");
    Запрос.УстановитьПараметр("Ид", Ид); Если Не Запрос.Выполнить().Пустой() Тогда Отказать(); КонецЕсли;
    Привязка = РегистрыСведений.ПривязкиПользователей1С.СоздатьМенеджерЗаписи(); Привязка.ИдентификаторПользователя1С = Ид; Привязка.Прочитать();
    Если Привязка.Выбран() Тогда Отказать(); КонецЕсли;
КонецПроцедуры

Процедура Отказать()
    ВызватьИсключение "диспетчерская_шлюз_настройка_не_удалось";
КонецПроцедуры
