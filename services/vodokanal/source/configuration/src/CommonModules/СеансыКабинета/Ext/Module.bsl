КонецФункции

Функция ОтозватьВсеСеансы(СсылкаУчетнойЗаписи) Экспорт
    ПроверитьНезависимуюТранзакцию();
    ПроверитьСсылкуНаУчетнуюЗапись(СсылкаУчетнойЗаписи);
    ОтозванныйКоличество = 0;

    НачатьТранзакцию();
    Попытка
        ЗаблокироватьУчетнуюЗапись(СсылкаУчетнойЗаписи);
        ТекущаяУчетнаяЗаписьУчастника(СсылкаУчетнойЗаписи);
        Запрос = Новый Запрос(
            "ВЫБРАТЬ Сеансы.ИдентификаторЭкземпляра КАК ИдентификаторЭкземпляра
            |ИЗ РегистрСведений.СеансыКабинета КАК Сеансы
            |ГДЕ Сеансы.УчетнаяЗаписьДействующегоЛица = &УчетнаяЗапись И НЕ Сеансы.Отозван
            |УПОРЯДОЧИТЬ ПО Сеансы.ИдентификаторЭкземпляра");
        Запрос.УстановитьПараметр("УчетнаяЗапись", СсылкаУчетнойЗаписи);
        ВыборкаДанных = Запрос.Выполнить().Выбрать();
        Пока ВыборкаДанных.Следующий() Цикл
            ЗаблокироватьЭкземпляр(ВыборкаДанных.ИдентификаторЭкземпляра);
            ЗаписьДанных = ПрочитатьСеанс(ВыборкаДанных.ИдентификаторЭкземпляра);
            Если ЗаписьДанных.Выбран() Тогда
                Если ЗаписьДанных.УчетнаяЗаписьДействующегоЛица = СсылкаУчетнойЗаписи И Не ЗаписьДанных.Отозван Тогда
                    ЗаписьДанных.Отозван = Истина;
                    ЗаписьДанных.Записать();
                    ОтозванныйКоличество = ОтозванныйКоличество + 1;
                КонецЕсли;
            КонецЕсли;
        КонецЦикла;
        ЗафиксироватьТранзакцию();
    Исключение
        Если ТранзакцияАктивна() Тогда
            ОтменитьТранзакцию();
        КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
    Возврат ОтозванныйКоличество;
КонецФункции

Функция ПроверитьЗаписьСеанса(ЗаписьДанных, СсылкаУчетнойЗаписи, ЗапрошенныйПоколение, ТекущийПоколение, ТекущееВремя)
    Если ЗаписьДанных.УчетнаяЗаписьДействующегоЛица <> СсылкаУчетнойЗаписи Тогда
        Возврат "кабинет_сеанс_участник_несовпадение";
    КонецЕсли;
    Если ЗаписьДанных.Отозван Тогда
        Возврат "кабинет_сеанс_отозвано";
    КонецЕсли;
    Если ЗаписьДанных.ПоколениеАвторизации <> ЗапрошенныйПоколение Или ЗаписьДанных.ПоколениеАвторизации <> ТекущийПоколение Тогда
        ЗаписьДанных.Отозван = Истина;
        ЗаписьДанных.Записать();
        Возврат "кабинет_сеанс_отозвано";
    КонецЕсли;
    Если ТекущееВремя >= ЗаписьДанных.СрокИстеченияБездействия Или ТекущееВремя >= ЗаписьДанных.АбсолютныйСрокИстечения Тогда
        ЗаписьДанных.Отозван = Истина;
        ЗаписьДанных.Записать();
        Возврат "кабинет_сеанс_истекло";
    КонецЕсли;
    Возврат "";
КонецФункции

Функция ИдентификаторТекущегоЭкземпляра()
    ИдентификаторЭкземпляра = ПараметрыСеанса.ЭкземплярСеансаКабинета;
    Если ТипЗнч(ИдентификаторЭкземпляра) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_сеанс_отсутствует";
    КонецЕсли;
    Если СтрДлина(ИдентификаторЭкземпляра) <> 36 Тогда
        ВызватьИсключение "кабинет_сеанс_отсутствует";
    КонецЕсли;
    Возврат ИдентификаторЭкземпляра;
КонецФункции

Процедура ПроверитьСсылкуНаУчетнуюЗапись(СсылкаУчетнойЗаписи)
    Если ТипЗнч(СсылкаУчетнойЗаписи) <> Тип("СправочникСсылка.УчетныеЗаписи") Тогда
        ВызватьИсключение "кабинет_сеанс_участник_несовпадение";
    КонецЕсли;
    Если Не ЗначениеЗаполнено(СсылкаУчетнойЗаписи) Тогда
        ВызватьИсключение "кабинет_сеанс_участник_несовпадение";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьПоколениеСеанса(ПоколениеАвторизации)
    Если ТипЗнч(ПоколениеАвторизации) <> Тип("Число") Тогда
        ВызватьИсключение "кабинет_сеанс_отозвано";
    КонецЕсли;
    Если ПоколениеАвторизации < 0 Тогда
        ВызватьИсключение "кабинет_сеанс_отозвано";
    КонецЕсли;
КонецПроцедуры

Функция ТекущаяУчетнаяЗаписьУчастника(СсылкаУчетнойЗаписи)
    Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
    Если Пользователь = Неопределено Тогда
        ВызватьИсключение "кабинет_сеанс_участник_несовпадение";
    КонецЕсли;
    Если ПустаяСтрока(Пользователь.Имя) Тогда
        ВызватьИсключение "кабинет_сеанс_участник_несовпадение";
    КонецЕсли;
    УчетнаяЗапись = СсылкаУчетнойЗаписи.ПолучитьОбъект();
    Если УчетнаяЗапись = Неопределено Тогда
        ВызватьИсключение "кабинет_сеанс_участник_несовпадение";
    КонецЕсли;
    Если УчетнаяЗапись.ПометкаУдаления Или УчетнаяЗапись.Состояние <> "Active" Тогда
        ВызватьИсключение "кабинет_учетная_запись_отключено";
    КонецЕсли;
    Если НРег(УчетнаяЗапись.ИдентификаторПользователя1С) <> НРег(Строка(Пользователь.УникальныйИдентификатор)) Тогда
        ВызватьИсключение "кабинет_сеанс_участник_несовпадение";
    КонецЕсли;
    Возврат УчетнаяЗапись;
КонецФункции

Функция ПрочитатьСеанс(ИдентификаторЭкземпляра)
    ЗаписьДанных = РегистрыСведений.СеансыКабинета.СоздатьМенеджерЗаписи();
    ЗаписьДанных.ИдентификаторЭкземпляра = ИдентификаторЭкземпляра;
    ЗаписьДанных.Прочитать();
    Возврат ЗаписьДанных;
КонецФункции

Процедура ЗаблокироватьУчетнуюЗапись(СсылкаУчетнойЗаписи)
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("Справочник.УчетныеЗаписи");
    Элемент.УстановитьЗначение("Ссылка", СсылкаУчетнойЗаписи);
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
КонецПроцедуры

Процедура ЗаблокироватьЭкземпляр(ИдентификаторЭкземпляра)
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("РегистрСведений.СеансыКабинета");
    Элемент.УстановитьЗначение("ИдентификаторЭкземпляра", ИдентификаторЭкземпляра);
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
КонецПроцедуры

Процедура ПроверитьНезависимуюТранзакцию()
    Если ТранзакцияАктивна() Тогда
        ВызватьИсключение "кабинет_сеанс_транзакция_активно";
    КонецЕсли;
КонецПроцедуры

Функция НормализоватьИдентификаторЦелевогоЭкземпляра(ИдентификаторЭкземпляра)
    Если ТипЗнч(ИдентификаторЭкземпляра) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_сеанс_не_найдено";
    КонецЕсли;
    Если СтрДлина(ИдентификаторЭкземпляра) <> 36 Тогда
        ВызватьИсключение "кабинет_сеанс_не_найдено";
    КонецЕсли;
    Попытка
        Возврат Строка(Новый УникальныйИдентификатор(ИдентификаторЭкземпляра));
    Исключение
        ВызватьИсключение "кабинет_сеанс_не_найдено";
    КонецПопытки;
КонецФункции

Функция КоличествоАктивныхСеансов(СсылкаУчетнойЗаписи, ТекущийПоколение, ТекущееВремя)
    Запрос = Новый Запрос(
        "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Объем
        |ИЗ РегистрСведений.СеансыКабинета КАК Сеансы
        |ГДЕ Сеансы.УчетнаяЗаписьДействующегоЛица = &УчетнаяЗапись И Сеансы.ПоколениеАвторизации = &Поколение
        |И НЕ Сеансы.Отозван И Сеансы.СрокИстеченияБездействия > &ТекущееВремя
        |И Сеансы.АбсолютныйСрокИстечения > &ТекущееВремя");
    Запрос.УстановитьПараметр("УчетнаяЗапись", СсылкаУчетнойЗаписи);
    Запрос.УстановитьПараметр("Поколение", ТекущийПоколение);
    Запрос.УстановитьПараметр("ТекущееВремя", ТекущееВремя);
    ВыборкаДанных = Запрос.Выполнить().Выбрать();
    ВыборкаДанных.Следующий();
    Возврат ВыборкаДанных.Объем;
КонецФункции

Функция ЛимитСеансовУчетнойЗаписи()
    Возврат 20;
КонецФункции

Функция СведенияОСеансе(ЗаписьДанных)
    Возврат Новый Структура(
        "instanceId,createdAt,lastSeenAt,idleExpiresAt,absoluteExpiresAt,idleTimeoutSeconds,absoluteTimeoutSeconds",
        ЗаписьДанных.ИдентификаторЭкземпляра, ЗаписьДанных.ДатаСоздания, ЗаписьДанных.ДатаПоследнейАктивности, ЗаписьДанных.СрокИстеченияБездействия,
        ЗаписьДанных.АбсолютныйСрокИстечения, СрокБездействияВСекундах(), АбсолютныйСрокСеансаВСекундах());
КонецФункции

Функция СрокБездействияВСекундах()
    Возврат 120;
КонецФункции

Функция АбсолютныйСрокСеансаВСекундах()
    Возврат 900;
КонецФункции
