
Функция ОткрытьСеанс(СсылкаУчетнойЗаписи, ПоколениеАвторизации) Экспорт
    ПроверитьНезависимуюТранзакцию();
    ПроверитьСсылкуНаУчетнуюЗапись(СсылкаУчетнойЗаписи);
    ПроверитьПоколениеСеанса(ПоколениеАвторизации);
    ИдентификаторЭкземпляра = ИдентификаторТекущегоЭкземпляра();
    Сбой = "";
    Результат = Неопределено;

    НачатьТранзакцию();
    Попытка
        ЗаблокироватьУчетнуюЗапись(СсылкаУчетнойЗаписи);
        УчетнаяЗапись = ТекущаяУчетнаяЗаписьУчастника(СсылкаУчетнойЗаписи);
        ЗаблокироватьЭкземпляр(ИдентификаторЭкземпляра);
        ЗаписьДанных = ПрочитатьСеанс(ИдентификаторЭкземпляра);
        ТекущееВремя = ТекущаяУниверсальнаяДата();
        Если ЗаписьДанных.Выбран() Тогда
            Сбой = ПроверитьЗаписьСеанса(ЗаписьДанных, СсылкаУчетнойЗаписи, ПоколениеАвторизации, УчетнаяЗапись.ПоколениеАвторизации, ТекущееВремя);
            Если Сбой = "" Тогда
                Результат = СведенияОСеансе(ЗаписьДанных);
            КонецЕсли;
        ИначеЕсли УчетнаяЗапись.ПоколениеАвторизации <> ПоколениеАвторизации Тогда
            Сбой = "кабинет_сеанс_отозвано";
        ИначеЕсли КоличествоАктивныхСеансов(СсылкаУчетнойЗаписи, УчетнаяЗапись.ПоколениеАвторизации, ТекущееВремя) >= ЛимитСеансовУчетнойЗаписи() Тогда
            Сбой = "кабинет_сеанс_квота_превышено";
        Иначе
            ЗаписьДанных.ИдентификаторЭкземпляра = ИдентификаторЭкземпляра;
            ЗаписьДанных.УчетнаяЗаписьДействующегоЛица = СсылкаУчетнойЗаписи;
            ЗаписьДанных.ПоколениеАвторизации = ПоколениеАвторизации;
            ЗаписьДанных.ДатаСоздания = ТекущееВремя;
            ЗаписьДанных.ДатаПоследнейАктивности = ТекущееВремя;
            ЗаписьДанных.СрокИстеченияБездействия = ТекущееВремя + СрокБездействияВСекундах();
            ЗаписьДанных.АбсолютныйСрокИстечения = ТекущееВремя + АбсолютныйСрокСеансаВСекундах();
            ЗаписьДанных.Отозван = Ложь;
            ЗаписьДанных.Записать();
            Результат = СведенияОСеансе(ЗаписьДанных);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        Если ТранзакцияАктивна() Тогда
            ОтменитьТранзакцию();
        КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;

    Если Сбой <> "" Тогда
        ВызватьИсключение Сбой;
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ПолучитьСобственныеСеансы(СсылкаУчетнойЗаписи, Лимит = Неопределено, Курсор = "") Экспорт
    ПроверитьНезависимуюТранзакцию();
    ПроверитьСсылкуНаУчетнуюЗапись(СсылкаУчетнойЗаписи);
    ТекущийИдентификатор = ИдентификаторТекущегоЭкземпляра();
    Результат = Новый Массив;

    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьУчетнуюЗапись(СсылкаУчетнойЗаписи);
        УчетнаяЗапись = ТекущаяУчетнаяЗаписьУчастника(СсылкаУчетнойЗаписи);
        ТекущееВремя = ТекущаяУниверсальнаяДата();
        Запрос = Новый Запрос(
            "ВЫБРАТЬ ПЕРВЫЕ 50 Сеансы.ИдентификаторЭкземпляра КАК ИдентификаторЭкземпляра,
            |Сеансы.ДатаСоздания КАК ДатаСоздания, Сеансы.ДатаПоследнейАктивности КАК ДатаПоследнейАктивности,
            |Сеансы.СрокИстеченияБездействия КАК СрокИстеченияБездействия,
            |Сеансы.АбсолютныйСрокИстечения КАК АбсолютныйСрокИстечения,
            |Сеансы.Отозван КАК Отозван, Сеансы.ПоколениеАвторизации КАК ПоколениеАвторизации,
            |ВЫБОР КОГДА Сеансы.ИдентификаторЭкземпляра = &ТекущийИдентификатор ТОГДА 0
            |КОГДА НЕ Сеансы.Отозван И Сеансы.ПоколениеАвторизации = &Поколение
            |И Сеансы.СрокИстеченияБездействия > &ТекущееВремя
            |И Сеансы.АбсолютныйСрокИстечения > &ТекущееВремя ТОГДА 1 ИНАЧЕ 2 КОНЕЦ КАК Приоритет
            |ИЗ РегистрСведений.СеансыКабинета КАК Сеансы
            |ГДЕ Сеансы.УчетнаяЗаписьДействующегоЛица = &УчетнаяЗапись
            |УПОРЯДОЧИТЬ ПО Приоритет, Сеансы.ДатаСоздания УБЫВ, Сеансы.ИдентификаторЭкземпляра");
        Страница = ПолитикаДоступа.ПараметрыСтраницыIAM(СсылкаУчетнойЗаписи, Лимит, Курсор,
            "sessions", Формат(УчетнаяЗапись.ПоколениеАвторизации, "ЧГ=0;ЧДЦ=0"));
        ПолитикаДоступа.НастроитьЗапросСтраницыIAM(Запрос, Страница, "ВЫБРАТЬ ПЕРВЫЕ 50", "Сеансы.ИдентификаторЭкземпляра");
        Запрос.УстановитьПараметр("УчетнаяЗапись", СсылкаУчетнойЗаписи);
        Запрос.УстановитьПараметр("ТекущийИдентификатор", ТекущийИдентификатор);
        Запрос.УстановитьПараметр("Поколение", УчетнаяЗапись.ПоколениеАвторизации);
        Запрос.УстановитьПараметр("ТекущееВремя", ТекущееВремя);
        ВыборкаДанных = Запрос.Выполнить().Выбрать();
        Пока ВыборкаДанных.Следующий() Цикл
            Состояние = "active";
            Если ВыборкаДанных.Отозван Или ВыборкаДанных.ПоколениеАвторизации <> УчетнаяЗапись.ПоколениеАвторизации Тогда
                Состояние = "revoked";
            ИначеЕсли ТекущееВремя >= ВыборкаДанных.СрокИстеченияБездействия Или ТекущееВремя >= ВыборкаДанных.АбсолютныйСрокИстечения Тогда
                Состояние = "expired";
            КонецЕсли;
            Результат.Добавить(Новый Структура(
                "id,createdAt,lastSeenAt,idleExpiresAt,absoluteExpiresAt,current,state",
                ВыборкаДанных.ИдентификаторЭкземпляра, XMLСтрока(ВыборкаДанных.ДатаСоздания) + "Z", XMLСтрока(ВыборкаДанных.ДатаПоследнейАктивности) + "Z",
                XMLСтрока(ВыборкаДанных.СрокИстеченияБездействия) + "Z", XMLСтрока(ВыборкаДанных.АбсолютныйСрокИстечения) + "Z",
                ВыборкаДанных.ИдентификаторЭкземпляра = ТекущийИдентификатор, Состояние));
        КонецЦикла;
        ЗафиксироватьТранзакцию();
    Исключение
        Если ТранзакцияАктивна() Тогда
            ОтменитьТранзакцию();
        КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
    Возврат ПолитикаДоступа.РезультатСтраницыIAM(Результат, Страница);
КонецФункции

Функция ОтозватьСобственныйСеанс(СсылкаУчетнойЗаписи, ИдентификаторЭкземпляра) Экспорт
    ПроверитьНезависимуюТранзакцию();
    ПроверитьСсылкуНаУчетнуюЗапись(СсылкаУчетнойЗаписи);
    ИдентификаторЦели = НормализоватьИдентификаторЦелевогоЭкземпляра(ИдентификаторЭкземпляра);
    ТекущийИдентификатор = ИдентификаторТекущегоЭкземпляра();
    Сбой = "";

    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьУчетнуюЗапись(СсылкаУчетнойЗаписи);
        ТекущаяУчетнаяЗаписьУчастника(СсылкаУчетнойЗаписи);
        ЗаблокироватьЭкземпляр(ИдентификаторЦели);
        ЗаписьДанных = ПрочитатьСеанс(ИдентификаторЦели);
        Если Не ЗаписьДанных.Выбран() Тогда
            Сбой = "кабинет_сеанс_не_найдено";
        ИначеЕсли ЗаписьДанных.УчетнаяЗаписьДействующегоЛица <> СсылкаУчетнойЗаписи Тогда
            Сбой = "кабинет_сеанс_не_найдено";
        ИначеЕсли Не ЗаписьДанных.Отозван Тогда
            ЗаписьДанных.Отозван = Истина;
            ЗаписьДанных.Записать();
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        Если ТранзакцияАктивна() Тогда
            ОтменитьТранзакцию();
        КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;

    Если Сбой <> "" Тогда
        ВызватьИсключение Сбой;
    КонецЕсли;
    Возврат Новый Структура("id,revoked,current", ИдентификаторЦели, Истина, ИдентификаторЦели = ТекущийИдентификатор);
КонецФункции

Функция ПроверитьСеанс(СсылкаУчетнойЗаписи, ПоколениеАвторизации, ОбновлятьАктивность = Истина) Экспорт
    ПроверитьНезависимуюТранзакцию();
    Если ТипЗнч(ОбновлятьАктивность) <> Тип("Булево") Тогда ВызватьИсключение "кабинет_сеанс_некорректно_активность_режим"; КонецЕсли;
    ПроверитьСсылкуНаУчетнуюЗапись(СсылкаУчетнойЗаписи);
    ПроверитьПоколениеСеанса(ПоколениеАвторизации);
    ИдентификаторЭкземпляра = ИдентификаторТекущегоЭкземпляра();
    Сбой = "";
    Результат = Неопределено;

    НачатьТранзакцию();
    Попытка
        ЗаблокироватьУчетнуюЗапись(СсылкаУчетнойЗаписи);
        УчетнаяЗапись = ТекущаяУчетнаяЗаписьУчастника(СсылкаУчетнойЗаписи);
        ЗаблокироватьЭкземпляр(ИдентификаторЭкземпляра);
        ЗаписьДанных = ПрочитатьСеанс(ИдентификаторЭкземпляра);
        Если Не ЗаписьДанных.Выбран() Тогда
            Сбой = "кабинет_сеанс_отсутствует";
        Иначе
            ТекущееВремя = ТекущаяУниверсальнаяДата();
            Сбой = ПроверитьЗаписьСеанса(ЗаписьДанных, СсылкаУчетнойЗаписи, ПоколениеАвторизации, УчетнаяЗапись.ПоколениеАвторизации, ТекущееВремя);
            Если Сбой = "" Тогда
                Если ОбновлятьАктивность Тогда
                    ЗаписьДанных.ДатаПоследнейАктивности = ТекущееВремя;
                    ЗаписьДанных.СрокИстеченияБездействия = Мин(ТекущееВремя + СрокБездействияВСекундах(), ЗаписьДанных.АбсолютныйСрокИстечения);
                    ЗаписьДанных.Записать();
                КонецЕсли;
                Результат = СведенияОСеансе(ЗаписьДанных);
            КонецЕсли;
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        Если ТранзакцияАктивна() Тогда
            ОтменитьТранзакцию();
        КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;

    Если Сбой <> "" Тогда
        ВызватьИсключение Сбой;
    КонецЕсли;
    Возврат Результат;
КонецФункции

