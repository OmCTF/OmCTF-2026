            Сбой = "кабинет_сеанс_участник_несовпадение";
        Иначе
            ЗаписьДанных.Отозван = Истина;
            ЗаписьДанных.Записать();
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        Если ТранзакцияАктивна() Тогда
