Функция ОбработатьЗапросКабинета(Действие, УчетнаяЗаписьСсылка, Запрос, Корреляция) Экспорт
    Попытка
        Если Действие = "ownershipTransfers" Тогда
            Данные = ПередачаВладенияПространством.Список(УчетнаяЗаписьСсылка, ЛимитЗапроса(Запрос), APIКабинета.ТекстПараметраЗапроса(Запрос, "cursor", 36));
        ИначеЕсли Действие = "ownershipCreate" Тогда
            Данные = ПередачаВладенияПространством.Создать(УчетнаяЗаписьСсылка, APIКабинета.РазобратьТелоЗапроса(Запрос), Корреляция);
        ИначеЕсли Действие = "ownershipAccept" Или Действие = "ownershipDecline" Или Действие = "ownershipRevoke" Тогда
            Операция = "accept"; Если Действие = "ownershipDecline" Тогда Операция = "decline"; ИначеЕсли Действие = "ownershipRevoke" Тогда Операция = "revoke"; КонецЕсли;
            Данные = ПередачаВладенияПространством.Решить(УчетнаяЗаписьСсылка, Запрос.ПараметрыURL.Получить("id"), Операция,
                APIКабинета.РазобратьТелоЗапроса(Запрос), Корреляция);
        ИначеЕсли Действие = "identityOwnAccounts" Тогда
            Данные = ДоступКЛицевымСчетам.ПолучитьСобственныеЛицевыеСчетаСтраница(УчетнаяЗаписьСсылка,
                ЛимитЗапроса(Запрос), APIКабинета.ТекстПараметраЗапроса(Запрос, "cursor", 256));
        ИначеЕсли Действие = "identityContact" Тогда
            Данные = УзкийКонтурИдентичности1С.ПрофильКонтакта(УчетнаяЗаписьСсылка);
        ИначеЕсли Действие = "identityMailbox" Тогда
            Данные = УзкийКонтурИдентичности1С.СобственныеПисьма(УчетнаяЗаписьСсылка);
        ИначеЕсли Действие = "identityMailboxConfigure" Тогда
            УчетнаяЗапись = ПолитикаДоступа.ПроверитьУчетнуюЗапись();
            Сеанс = СеансыКабинета.ПроверитьСеанс(УчетнаяЗаписьСсылка, УчетнаяЗапись.ПоколениеАвторизации, Ложь);
            Данные = УзкийКонтурИдентичности1С.НастроитьЯщик(УчетнаяЗаписьСсылка, APIКабинета.РазобратьТелоЗапроса(Запрос), Сеанс.createdAt);
        ИначеЕсли Действие = "identityContactRequest" Тогда
            Данные = УзкийКонтурИдентичности1С.ЗапроситьПодтверждение(УчетнаяЗаписьСсылка, APIКабинета.РазобратьТелоЗапроса(Запрос));
        ИначеЕсли Действие = "identityContactConfirm" Тогда
            Данные = УзкийКонтурИдентичности1С.ПодтвердитьКонтакт(УчетнаяЗаписьСсылка, APIКабинета.РазобратьТелоЗапроса(Запрос));
        Иначе ВызватьИсключение "идентификация_некорректно_ввод"; КонецЕсли;
        Возврат APIКабинета.СформироватьОтветHTTP(?(Действие = "ownershipCreate", 201, 200), Данные, Корреляция);
    Исключение
        Описание = ОписаниеОшибки(); Код = "идентификация_недоступно"; Статус = 503;
        Для Каждого Разрешенный Из СтрРазделить("идентификация_некорректно_ввод,идентификация_код_некорректно,идентификация_почтовый_ящик_не_найдено,идентификация_версия_конфликт,идентификация_регистрация_конфликт,идентификация_частота_ограничено,кабинет_повторная_авторизация_требуется,кабинет_участник_несовпадение,кабинет_учетная_запись_отключено,владение_некорректно_ввод,владение_не_найдено,владение_запрос_конфликт,владение_ожидание_конфликт,владение_привязка_конфликт,владение_версия_конфликт,владение_состояние_конфликт,владение_истекло,кабинет_пространство_запрещено,кабинет_абонент_некорректно_страница,кабинет_некорректно_идентификатор", ",") Цикл
            Если СтрНайти(Описание, Разрешенный) > 0 Тогда Код = Разрешенный; Прервать; КонецЕсли;
        КонецЦикла;
        Если Код = "идентификация_некорректно_ввод" Или Код = "идентификация_код_некорректно" Или Код = "владение_некорректно_ввод" Или Код = "кабинет_абонент_некорректно_страница" Или Код = "кабинет_некорректно_идентификатор" Тогда Статус = 400;
        ИначеЕсли Код = "идентификация_почтовый_ящик_не_найдено" Или Код = "владение_не_найдено" Или Код = "кабинет_пространство_запрещено" Тогда Статус = 404;
        ИначеЕсли Лев(Код, СтрДлина("владение_")) = "владение_" Тогда Статус = 409;
        ИначеЕсли Код = "идентификация_версия_конфликт" Или Код = "идентификация_регистрация_конфликт" Тогда Статус = 409;
        ИначеЕсли Код = "идентификация_частота_ограничено" Тогда Статус = 429;
        ИначеЕсли Код = "кабинет_повторная_авторизация_требуется" Или Код = "кабинет_участник_несовпадение" Или Код = "кабинет_учетная_запись_отключено" Тогда Статус = 403; КонецЕсли;
        Результат = APIКабинета.СформироватьОтветHTTP(Статус, Ошибка(Код, Корреляция), Корреляция);
        Если Статус = 429 Тогда Результат.Заголовки.Вставить("Retry-After", "60"); КонецЕсли;
        Возврат Результат;
    КонецПопытки;
КонецФункции

Функция ЛимитЗапроса(Запрос)
    ТекстЛимита = APIКабинета.ТекстПараметраЗапроса(Запрос, "limit", 3);
    Если ТекстЛимита = "" Тогда Возврат 25; КонецЕсли;
    Для Позиция = 1 По СтрДлина(ТекстЛимита) Цикл
        Если СтрНайти("0123456789", Сред(ТекстЛимита, Позиция, 1)) = 0 Тогда ВызватьИсключение "идентификация_некорректно_ввод"; КонецЕсли;
    КонецЦикла;
    Лимит = Число(ТекстЛимита);
    Если Лимит < 1 Или Лимит > 100 Тогда ВызватьИсключение "идентификация_некорректно_ввод"; КонецЕсли;
    Возврат Лимит;
КонецФункции

Функция ОбработатьЗапрос(Действие, Запрос) Экспорт
    Корреляция = Строка(СервисДокументов.НовыйUUIDv4());
    Попытка
        УзкийКонтурИдентичности1С.ПроверитьШлюз();
        Если Запрос.HTTPМетод <> "POST" Тогда Возврат Ответ(405, Ошибка("идентификация_метод_не_разрешено", Корреляция)); КонецЕсли;
        Если Запрос.ПараметрыЗапроса.Количество() <> 0 Тогда ВызватьИсключение "идентификация_некорректно_ввод"; КонецЕсли;
        Если Заголовок(Запрос, "X-Vodokanal-Request") <> "1" Тогда ВызватьИсключение "идентификация_защита_запроса_запрещено"; КонецЕсли;
        ИсточникOrigin = НРег(Заголовок(Запрос, "Origin")); Хост = НРег(Заголовок(Запрос, "Host"));
        Если ИсточникOrigin <> "" И ИсточникOrigin <> "http://" + Хост И ИсточникOrigin <> "https://" + Хост Тогда
            ВызватьИсключение "идентификация_защита_запроса_запрещено";
        КонецЕсли;
        Если Заголовок(Запрос, "Cookie") <> "" Или Заголовок(Запрос, "Authorization") <> "" Тогда ВызватьИсключение "идентификация_некорректно_ввод"; КонецЕсли;
        Если Лев(НРег(Заголовок(Запрос, "Content-Type")), 16) <> "application/json" Тогда ВызватьИсключение "идентификация_некорректно_ввод"; КонецЕсли;
        Источник = Заголовок(Запрос, "X-Vodokanal-Source");
        Если ПустаяСтрока(Источник) Или СтрДлина(Источник) > 128 Тогда ВызватьИсключение "идентификация_шлюз_недоступно"; КонецЕсли;
        Тело = Запрос.ПолучитьТелоКакДвоичныеДанные();
        Если Тело = Неопределено Тогда ВызватьИсключение "идентификация_некорректно_ввод"; КонецЕсли;
        Если Тело.Размер() > 16384 Тогда Возврат Ответ(413, Ошибка("идентификация_тело_слишком_большое", Корреляция)); КонецЕсли;
        Чтение = Новый ЧтениеJSON;
        Попытка
            Чтение.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
            Данные = ПрочитатьJSON(Чтение); Чтение.Закрыть();
        Исключение
            Чтение.Закрыть(); ВызватьИсключение "идентификация_некорректно_ввод";
        КонецПопытки;
        Если Действие <> "mailbox" Тогда
            Если ТипЗнч(Данные) <> Тип("Структура") Тогда ВызватьИсключение "идентификация_некорректно_ввод"; КонецЕсли;
            Идемпотентность = Неопределено;
            Если Не Данные.Свойство("requestId", Идемпотентность) Тогда ВызватьИсключение "идентификация_некорректно_ввод"; КонецЕсли;
            Если ТипЗнч(Идемпотентность) <> Тип("Строка") Тогда ВызватьИсключение "идентификация_некорректно_ввод"; КонецЕсли;
            Если Заголовок(Запрос, "Idempotency-Key") <> Идемпотентность Тогда ВызватьИсключение "идентификация_некорректно_ввод"; КонецЕсли;
        КонецЕсли;
        Статус = 200;
        Если Действие = "register" Тогда
            Результат = УзкийКонтурИдентичности1С.Зарегистрировать(Данные, Источник); Статус = 201;
        ИначеЕсли Действие = "mailbox" Тогда
            Результат = УзкийКонтурИдентичности1С.ОткрытьЯщик(Данные, Источник);
        ИначеЕсли Действие = "recoveryRequest" Тогда
            Результат = УзкийКонтурИдентичности1С.ЗапроситьВосстановление(Данные, Источник); Статус = 202;
        ИначеЕсли Действие = "recoveryComplete" Тогда
            Результат = УзкийКонтурИдентичности1С.ЗавершитьВосстановление(Данные, Источник);
        Иначе Возврат Ответ(404, Ошибка("идентификация_не_найдено", Корреляция)); КонецЕсли;
        Возврат Ответ(Статус, Результат);
    Исключение
        Описание = ОписаниеОшибки(); Код = "идентификация_недоступно"; Статус = 503;
        Для Каждого Допустимый Из СтрРазделить("идентификация_некорректно_ввод,идентификация_регистрация_конфликт,идентификация_код_некорректно,идентификация_почтовый_ящик_не_найдено,идентификация_контакт_не_подтверждено,идентификация_частота_ограничено,идентификация_восстановление_ожидание,идентификация_шлюз_запрещено,идентификация_защита_запроса_запрещено", ",") Цикл
            Если СтрНайти(Описание, Допустимый) > 0 Тогда Код = Допустимый; Прервать; КонецЕсли;
        КонецЦикла;
        Если Код = "идентификация_некорректно_ввод" Или Код = "идентификация_код_некорректно" Тогда Статус = 400;
        ИначеЕсли Код = "идентификация_регистрация_конфликт" Или Код = "идентификация_контакт_не_подтверждено" Или Код = "идентификация_восстановление_ожидание" Тогда Статус = 409;
        ИначеЕсли Код = "идентификация_почтовый_ящик_не_найдено" Тогда Статус = 404;
        ИначеЕсли Код = "идентификация_шлюз_запрещено" Или Код = "идентификация_защита_запроса_запрещено" Тогда Статус = 403;
        ИначеЕсли Код = "идентификация_частота_ограничено" Тогда Статус = 429; КонецЕсли;
        Возврат Ответ(Статус, Ошибка(Код, Корреляция));
    КонецПопытки;
КонецФункции

Функция Ошибка(Код, Корреляция)
    Возврат Новый Структура("error,requestId", Новый Структура("code,message", Код, "Операция не выполнена. Проверьте данные или повторите позже."), Корреляция);
КонецФункции

Функция Ответ(Статус, Данные)
    Писатель = Новый ЗаписьJSON; Писатель.УстановитьСтроку(); ЗаписатьJSON(Писатель, Данные);
    ОтветHTTP = Новый HTTPСервисОтвет(Статус); ОтветHTTP.УстановитьТелоИзСтроки(Писатель.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
    ОтветHTTP.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    ОтветHTTP.Заголовки.Вставить("Cache-Control", "no-store"); ОтветHTTP.Заголовки.Вставить("Pragma", "no-cache");
    ОтветHTTP.Заголовки.Вставить("X-Content-Type-Options", "nosniff"); ОтветHTTP.Заголовки.Вставить("Referrer-Policy", "no-referrer");
    Если Статус = 429 Тогда ОтветHTTP.Заголовки.Вставить("Retry-After", "60"); КонецЕсли;
    Возврат ОтветHTTP;
КонецФункции

Функция Заголовок(Запрос, Имя)
    Для Каждого Пара Из Запрос.Заголовки Цикл
        Если НРег(Пара.Ключ) = НРег(Имя) Тогда Возврат Строка(Пара.Значение); КонецЕсли;
    КонецЦикла;
    Возврат "";
КонецФункции
