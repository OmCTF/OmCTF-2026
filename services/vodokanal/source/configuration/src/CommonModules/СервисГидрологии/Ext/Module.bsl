Функция Справочники() Экспорт
    Реки = Новый Массив;
    Реки.Добавить(Новый Структура("code,name,unit,datum", "irtysh", "Иртыш", "cm", НольОтсчета()));
    Реки.Добавить(Новый Структура("code,name,unit,datum", "om", "Омь", "cm", НольОтсчета()));
    Возврат Новый Структура("referenceVersion,rivers,warning", "hydrology-rivers-v1", Реки, Предупреждение());
КонецФункции

Функция Посты(УчетнаяЗапись, ПространствоИд, ОбластьИд, Лимит = 25, После = "", КодРеки = "") Экспорт
    ЦелоеЧисло(Лимит, 1, 100);
    Если ТипЗнч(После) <> Тип("Строка") Или ТипЗнч(КодРеки) <> Тип("Строка") Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
    Если КодРеки <> "" Тогда НазваниеРеки(КодРеки); КонецЕсли;
    Контекст = НачатьЧтениеОбласти(УчетнаяЗапись, ПространствоИд, ОбластьИд);
    Попытка
        ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит + 1, "ЧГ=0") + " Ссылка ИЗ Справочник.Гидропосты
            |ГДЕ РабочееПространство = &Пространство И Область = &Область И НЕ ПометкаУдаления";
        Если После <> "" Тогда ТекстЗапроса = ТекстЗапроса + " И Ссылка > &После"; КонецЕсли;
        Если КодРеки <> "" Тогда ТекстЗапроса = ТекстЗапроса + " И КодРеки = &КодРеки"; КонецЕсли;
        Запрос = Новый Запрос(ТекстЗапроса + " УПОРЯДОЧИТЬ ПО Ссылка");
        Запрос.УстановитьПараметр("Пространство", Контекст.РабочееПространство);
        Запрос.УстановитьПараметр("Область", Контекст.Область);
        Если После <> "" Тогда Запрос.УстановитьПараметр("После", СсылкаПоИд("Гидропосты", После)); КонецЕсли;
        Если КодРеки <> "" Тогда Запрос.УстановитьПараметр("КодРеки", КодРеки); КонецЕсли;
        Результат = СписокПостов(Запрос, Ложь, Лимит);
        ЗафиксироватьТранзакцию(); Возврат Результат;
    Исключение
        Откат(); ВызватьИсключение;
    КонецПопытки;
КонецФункции

Функция Ряд(УчетнаяЗапись, ПостИд, Начало, Конец, После = "", Лимит = 25, Курсор = "") Экспорт
    ПроверитьАктера(УчетнаяЗапись);
    Пост = ПолучитьПост(ПостИд);
    Контекст = НачатьЧтениеЧастногоПоста(УчетнаяЗапись, Пост);
    Попытка
        Блокировать("Справочник.Гидропосты", Пост.Ссылка);
        Пост = ПолучитьПост(ПостИд);
        Результат = ДанныеРяда(Пост, Начало, Конец, После, Ложь, Лимит, Курсор);
        ЗафиксироватьТранзакцию(); Возврат Результат;
    Исключение
        Откат(); ВызватьИсключение;
    КонецПопытки;
КонецФункции

Функция История(УчетнаяЗапись, ПостИд, Время, Лимит = 25, Курсор = "") Экспорт
    ПроверитьАктера(УчетнаяЗапись);
    Пост = ПолучитьПост(ПостИд);
    Контекст = НачатьЧтениеЧастногоПоста(УчетнаяЗапись, Пост);
    Попытка
        Блокировать("Справочник.Гидропосты", Пост.Ссылка);
        Момент = ДатаВхода(Время);
        ЦелоеЧисло(Лимит, 1, 100);
        ДоРевизии = РевизияКурсора(Курсор, "measurement", ПостИд, Время);
        Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит + 1, "ЧГ=0") + " * ИЗ РегистрСведений.РедакцииИзмеренийГидрологии
            |ГДЕ Гидропост = &Пост И ВремяИзмерения = &Момент И Ревизия < &ДоРевизии УПОРЯДОЧИТЬ ПО Ревизия УБЫВ, Идентификатор");
        Запрос.УстановитьПараметр("Пост", Пост.Ссылка); Запрос.УстановитьПараметр("Момент", Момент);
        Запрос.УстановитьПараметр("ДоРевизии", ДоРевизии);
        Элементы = Новый Массив; Выборка = Запрос.Выполнить().Выбрать(); ЕстьЕще = Ложь;
        Пока Выборка.Следующий() Цикл
            Если Элементы.Количество() = Лимит Тогда ЕстьЕще = Истина; Прервать; КонецЕсли;
            Элемент = ДанныеИзмерения(Выборка);
            Элемент.Вставить("previousId", Выборка.ПредыдущийИдентификатор);
            Элемент.Вставить("reason", Выборка.Основание); Элемент.Вставить("authorId", Ид(Выборка.Автор));
            Элемент.Вставить("recordedAt", ДатаВыхода(Выборка.МоментЗаписи));
            Элемент.Вставить("algorithmVersion", Выборка.ВерсияАлгоритма); Элемент.Вставить("seed", Выборка.НачальноеЗначение);
            Элемент.Вставить("commandId", Выборка.КлючКоманды); Элементы.Добавить(Элемент);
        КонецЦикла;
        Следующий = "";
        Если ЕстьЕще Тогда Следующий = КурсорРевизии("measurement", ПостИд, Время, Элементы[Элементы.Количество() - 1].revision); КонецЕсли;
        Результат = Новый Структура("items,limit,hasMore,nextCursor,snapshotAt", Элементы, Лимит, ЕстьЕще, Следующий, ДатаВыхода(ТекущаяУниверсальнаяДата()));
        ЗафиксироватьТранзакцию(); Возврат Результат;
    Исключение
        Откат(); ВызватьИсключение;
    КонецПопытки;
КонецФункции

Функция ИсторияНастроек(УчетнаяЗапись, ПостИд, Лимит = 25, Курсор = "") Экспорт
    ПроверитьАктера(УчетнаяЗапись);
    Пост = ПолучитьПост(ПостИд);
    Контекст = НачатьЧтениеЧастногоПоста(УчетнаяЗапись, Пост);
    Попытка
        Блокировать("Справочник.Гидропосты", Пост.Ссылка);
        Пост = ПолучитьПост(ПостИд); ЦелоеЧисло(Лимит, 1, 100);
        ДоРевизии = РевизияКурсора(Курсор, "settings", ПостИд, "");
        Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит + 1, "ЧГ=0") + " * ИЗ РегистрСведений.ИсторияГидропостов
            |ГДЕ Гидропост = &Пост И Ревизия < &ДоРевизии УПОРЯДОЧИТЬ ПО Ревизия УБЫВ, КлючКоманды");
        Запрос.УстановитьПараметр("Пост", Пост.Ссылка); Запрос.УстановитьПараметр("ДоРевизии", ДоРевизии);
        Элементы = Новый Массив; ЕстьЕще = Ложь; Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            Если Элементы.Количество() = Лимит Тогда ЕстьЕще = Истина; Прервать; КонецЕсли;
            ДоИзменения = Неопределено;
            Если Выборка.ДоИзменения <> "" Тогда ДоИзменения = ПроекцияИсторииПоста(Выборка.ДоИзменения, Пост, Выборка.Ревизия - 1); КонецЕсли;
            ПослеИзменения = ПроекцияИсторииПоста(Выборка.ПослеИзменения, Пост, Выборка.Ревизия);
            Элементы.Добавить(Новый Структура("id,postId,revision,operation,authorId,recordedAt,reason,commandId,before,after",
                Выборка.КлючКоманды, ПостИд, Выборка.Ревизия, ?(Выборка.Ревизия = 1, "create", "configure"),
                Ид(Выборка.Автор), ДатаВыхода(Выборка.Момент), Выборка.Основание, Выборка.КлючКоманды, ДоИзменения, ПослеИзменения));
        КонецЦикла;
        Следующий = "";
        Если ЕстьЕще Тогда Следующий = КурсорРевизии("settings", ПостИд, "", Элементы[Элементы.Количество() - 1].revision); КонецЕсли;
        Результат = Новый Структура("items,limit,hasMore,nextCursor,snapshotAt", Элементы, Лимит, ЕстьЕще, Следующий, ДатаВыхода(ТекущаяУниверсальнаяДата()));
        ЗафиксироватьТранзакцию(); Возврат Результат;
    Исключение
        Откат(); ВызватьИсключение;
    КонецПопытки;
КонецФункции

Функция ПроекцияИсторииПоста(ТекстДанных, Пост, Ревизия)
    Данные = ПрочитатьДанные(ТекстДанных);
    Поля = "id,name,riverCode,riverName,referenceVersion,location,unit,datum,lowThreshold,highThreshold,staleAfterSeconds,published,revision,training,warning,workspaceId,areaId";
    Если ТипЗнч(Данные) <> Тип("Структура") Тогда ВызватьИсключение "кабинет_гидрология_привязка_конфликт"; КонецЕсли;
    Результат = Новый Структура;
    Для Каждого Поле Из СтрРазделить(Поля, ",", Ложь) Цикл
        Если Не Данные.Свойство(Поле) Тогда ВызватьИсключение "кабинет_гидрология_привязка_конфликт"; КонецЕсли;
        Результат.Вставить(Поле, Данные[Поле]);
    КонецЦикла;
    Если Результат.id <> Ид(Пост.Ссылка) Или Результат.workspaceId <> Ид(Пост.РабочееПространство)
        Или Результат.areaId <> Ид(Пост.Область) Или Результат.revision <> Ревизия Тогда ВызватьИсключение "кабинет_гидрология_привязка_конфликт"; КонецЕсли;
    Возврат Результат;
КонецФункции

Функция КурсорРевизии(Вид, ПостИд, Время, Ревизия)
    Возврат "hh1|" + Вид + "|" + ПостИд + "|" + Время + "|" + Формат(Ревизия, "ЧГ=0");
КонецФункции

Функция РевизияКурсора(Курсор, Вид, ПостИд, Время)
    Если ТипЗнч(Курсор) <> Тип("Строка") Или СтрДлина(Курсор) > 128 Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
    Если Курсор = "" Тогда Возврат 10001; КонецЕсли;
    Части = СтрРазделить(Курсор, "|", Истина);
    Если Части.Количество() <> 5 Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
    Если Части[0] <> "hh1" Или Части[1] <> Вид Или Части[2] <> ПостИд Или Части[3] <> Время Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
    Ревизия = ЧислоИзТекста(Части[4]); ЦелоеЧисло(Ревизия, 1, 10000);
    Если Формат(Ревизия, "ЧГ=0") <> Части[4] Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
    Возврат Ревизия;
КонецФункции

Функция ЛимитСтраницы(Значение = Неопределено) Экспорт
    Если Значение = Неопределено Тогда Возврат 25; КонецЕсли;
    Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) > 3 Или Значение = "" Или Лев(Значение, 1) = "0" Тогда
        ВызватьИсключение "кабинет_гидрология_некорректно_ввод";
    КонецЕсли;
    Для Номер = 1 По СтрДлина(Значение) Цикл
        Если СтрНайти("0123456789", Сред(Значение, Номер, 1)) = 0 Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
    КонецЦикла;
    Возврат ЦелоеЧисло(XMLЗначение(Тип("Число"), Значение), 1, 100);
КонецФункции

Функция ПубличныеПосты(Лимит = 25, После = "", КодРеки = "") Экспорт
    ПроверитьРежим();
    ЦелоеЧисло(Лимит, 1, 100);
    Если ТипЗнч(После) <> Тип("Строка") Или ТипЗнч(КодРеки) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_гидрология_некорректно_ввод";
    КонецЕсли;
    Если КодРеки <> "" Тогда НазваниеРеки(КодРеки); КонецЕсли;
    ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ " + Формат(Лимит + 1, "ЧГ=0") + " Ссылка, Наименование, КодРеки, ВерсияСправочника, Местоположение,
        |НижнийПорог, ВерхнийПорог, СрокАктуальности, Опубликован, Ревизия ИЗ Справочник.Гидропосты
        |ГДЕ Опубликован И НЕ ПометкаУдаления";
    Если После <> "" Тогда ТекстЗапроса = ТекстЗапроса + " И Ссылка > &После"; КонецЕсли;
    Если КодРеки <> "" Тогда ТекстЗапроса = ТекстЗапроса + " И КодРеки = &КодРеки"; КонецЕсли;
    Запрос = Новый Запрос(ТекстЗапроса + " УПОРЯДОЧИТЬ ПО Ссылка");
    Если После <> "" Тогда Запрос.УстановитьПараметр("После", СсылкаПоИд("Гидропосты", После)); КонецЕсли;
    Если КодРеки <> "" Тогда Запрос.УстановитьПараметр("КодРеки", КодРеки); КонецЕсли;
    Возврат СписокПостов(Запрос, Истина, Лимит);
КонецФункции

Функция ПубличныйРяд(ПостИд, Начало, Конец, После = "", Лимит = 25, Курсор = "") Экспорт
    ПроверитьРежим();
    Если ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_гидрология_вложенная_транзакция"; КонецЕсли;
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        Ссылка = СсылкаПоИд("Гидропосты", ПостИд); Блокировать("Справочник.Гидропосты", Ссылка, Истина);
        Пост = ПолучитьПубличныйПост(Ссылка);
        Результат = ДанныеРяда(Пост, Начало, Конец, После, Истина, Лимит, Курсор);
        ЗафиксироватьТранзакцию(); Возврат Результат;
    Исключение
        Откат(); ВызватьИсключение;
    КонецПопытки;
КонецФункции

Функция ВыполнитьКоманду(УчетнаяЗапись, Операция, ПостИд, Тело, Ключ) Экспорт
    ПроверитьАктера(УчетнаяЗапись);
    Если ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_гидрология_вложенная_транзакция"; КонецЕсли;
    ПроверитьКлюч(Ключ);
    Поля = ПоляКоманды(Операция); ПроверитьПоля(Тело, Поля);
    Намерение = Новый Структура;
    Для Каждого Поле Из СтрРазделить(Поля, ",", Ложь) Цикл Намерение.Вставить(Поле, Тело[Поле]); КонецЦикла;
    ТекстНамерения = СериализоватьДанные(Намерение);
    Если СтрДлина(ТекстНамерения) > 16000 Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
    Если Операция = "create" Тогда
        Если ПостИд <> "" Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
    Иначе ПроверитьКлюч(ПостИд);
    КонецЕсли;
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        Блокировать("Справочник.УчетныеЗаписи", УчетнаяЗапись); ПроверитьАктера(УчетнаяЗапись);
        Команда = РегистрыСведений.КомандыГидрологии.СоздатьМенеджерЗаписи();
        Команда.УчетнаяЗапись = УчетнаяЗапись; Команда.КлючЗапроса = Ключ; Команда.Прочитать();
        Если Команда.Выбран() Тогда
            Контекст = КонтекстОбласти(УчетнаяЗапись, Команда.РабочееПространство, Команда.Область);
            ЗаблокироватьОбласть(Контекст);
            Если Команда.Операция <> Операция Или Команда.Цель <> ПостИд Или Команда.Намерение <> ТекстНамерения Тогда
                ВызватьИсключение "кабинет_гидрология_запрос_конфликт";
            КонецЕсли;
            Результат = ПрочитатьДанные(Команда.Результат);
            Если Результат.commandId <> Ключ Или Результат.operation <> Операция
                Или Результат.workspaceId <> Ид(Контекст.РабочееПространство) Или Результат.areaId <> Ид(Контекст.Область) Тогда
                ВызватьИсключение "кабинет_гидрология_привязка_конфликт";
            КонецЕсли;
            ЗафиксироватьТранзакцию(); Возврат Результат;
        КонецЕсли;
        Контекст = КонтекстОбласти(УчетнаяЗапись, СсылкаПоИд("РабочиеПространства", Тело.workspaceId), СсылкаПоИд("Области", Тело.areaId));
        ЗаблокироватьОбласть(Контекст);
        Причина = Текст(Тело.reason, 500); Сейчас = ТекущаяУниверсальнаяДата();
        Если ТипЗнч(Тело.published) <> Тип("Булево") Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
        РасходКвоты(Контекст, Операция = "create");
        Если Операция = "create" Тогда
            Пост = Справочники.Гидропосты.СоздатьЭлемент();
            Пост.SetNewObjectRef(Справочники.Гидропосты.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
            Пост.РабочееПространство = Контекст.РабочееПространство; Пост.Область = Контекст.Область;
            НазваниеРеки(Тело.riverCode); Пост.КодРеки = Тело.riverCode;
            Пост.ВерсияСправочника = "hydrology-rivers-v1"; Пост.Ревизия = 1;
            Пост.КемСоздано = УчетнаяЗапись; Пост.ДатаСоздания = Сейчас; Пост.ЧислоРедакций = 0;
        Иначе
            Блокировать("Справочник.Гидропосты", СсылкаПоИд("Гидропосты", ПостИд)); Пост = ПолучитьПост(ПостИд);
            Если Пост.РабочееПространство <> Контекст.РабочееПространство Или Пост.Область <> Контекст.Область Тогда
                ВызватьИсключение "кабинет_гидрология_не_найдено";
            КонецЕсли;
        КонецЕсли;
        Результаты = Новый Массив; Алгоритм = ""; Начальное = 0;
        Если Операция = "create" Или Операция = "configure" Тогда
            Перед = "";
            Если Операция = "configure" Тогда
                ПроверитьРевизию(Тело.expectedRevision, Пост.Ревизия);
                Если Пост.Ревизия >= 10000 Тогда ВызватьИсключение "кабинет_гидрология_квота_превышено"; КонецЕсли;
                Перед = СериализоватьДанные(ДанныеПоста(Пост, Ложь)); Пост.Ревизия = Пост.Ревизия + 1;
            КонецЕсли;
            Пост.Наименование = Текст(Тело.name, 150); Пост.Местоположение = Текст(Тело.location, 250);
            Пост.НижнийПорог = Уровень(Тело.lowThreshold); Пост.ВерхнийПорог = Уровень(Тело.highThreshold);
            Если Пост.НижнийПорог >= Пост.ВерхнийПорог Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
            Пост.СрокАктуальности = ЦелоеЧисло(Тело.staleAfterSeconds, 300, 604800);
            Пост.Опубликован = Тело.published; Пост.ДатаОбновления = Сейчас; Пост.Записать();
            СохранитьНастройку(Пост, Перед, Причина, УчетнаяЗапись, Ключ, Сейчас);
        Иначе
            Строки = ПодготовитьСтроки(Операция, Тело, Сейчас);
            Если Операция = "generate" Тогда Алгоритм = "hydrology-lcg-v1"; Начальное = Тело.seed; КонецЕсли;
            Если Пост.ЧислоРедакций + Строки.Количество() > 10000 Тогда ВызватьИсключение "кабинет_гидрология_квота_превышено"; КонецЕсли;
            Для Каждого СтрокаИзмерения Из Строки Цикл
                Результаты.Добавить(ЗаписатьРедакцию(Пост.Ссылка, СтрокаИзмерения, Операция = "correct", Тело,
                    УчетнаяЗапись, Ключ, Причина, Сейчас, Алгоритм, Начальное));
            КонецЦикла;
            Пост.ЧислоРедакций = Пост.ЧислоРедакций + Строки.Количество(); Пост.Записать();
        КонецЕсли;
        Результат = Новый Структура("commandId,operation,postId,workspaceId,areaId,postRevision,measurementCount,measurements,algorithmVersion,seed,committedAt",
            Ключ, Операция, Ид(Пост.Ссылка), Ид(Контекст.РабочееПространство), Ид(Контекст.Область), Пост.Ревизия,
            Результаты.Количество(), Результаты, Алгоритм, Начальное, ДатаВыхода(Сейчас));
        Команда.УчетнаяЗапись = УчетнаяЗапись; Команда.КлючЗапроса = Ключ;
        Команда.РабочееПространство = Контекст.РабочееПространство; Команда.Область = Контекст.Область;
        Команда.Операция = Операция; Команда.Цель = ПостИд; Команда.Намерение = ТекстНамерения;
        Команда.Результат = СериализоватьДанные(Результат); Команда.Записать();
        ПолитикаДоступа.ЗаписатьСобытиеАудита(УчетнаяЗапись, Контекст.РабочееПространство, "hydrology." + Операция, Ид(Пост.Ссылка), "success", Ключ);
        ЗафиксироватьТранзакцию(); Возврат Результат;
    Исключение
        Откат(); ВызватьИсключение;
    КонецПопытки;
КонецФункции

Функция ЗаписатьРедакцию(Пост, СтрокаИзмерения, Исправление, Тело, Автор, Ключ, Причина, Сейчас, Алгоритм, Начальное)
    Голова = РегистрыСведений.ТекущиеИзмеренияГидрологии.СоздатьМенеджерЗаписи();
    Голова.Гидропост = Пост; Голова.ВремяИзмерения = СтрокаИзмерения.Момент; Голова.Прочитать();
    Ревизия = 1; Предыдущий = "";
    Если Исправление Тогда
        Если Не Голова.Выбран() Тогда ВызватьИсключение "кабинет_гидрология_не_найдено"; КонецЕсли;
        ПроверитьРевизию(Тело.expectedRevision, Голова.Ревизия);
        Если Голова.Ревизия >= 100 Тогда ВызватьИсключение "кабинет_гидрология_квота_превышено"; КонецЕсли;
        Предыдущая = РегистрыСведений.РедакцииИзмеренийГидрологии.СоздатьМенеджерЗаписи();
        Предыдущая.Гидропост = Пост; Предыдущая.ВремяИзмерения = СтрокаИзмерения.Момент;
        Предыдущая.Ревизия = Голова.Ревизия; Предыдущая.Прочитать();
        Если Не Предыдущая.Выбран() Или Предыдущая.Идентификатор <> Голова.Идентификатор Тогда
            ВызватьИсключение "кабинет_гидрология_привязка_конфликт";
        КонецЕсли;
        Ревизия = Голова.Ревизия + 1; Предыдущий = Голова.Идентификатор;
    ИначеЕсли Голова.Выбран() Тогда ВызватьИсключение "кабинет_гидрология_измерение_конфликт";
    КонецЕсли;
    Запись = РегистрыСведений.РедакцииИзмеренийГидрологии.СоздатьМенеджерЗаписи();
    Запись.Гидропост = Пост; Запись.ВремяИзмерения = СтрокаИзмерения.Момент; Запись.Ревизия = Ревизия; Запись.Прочитать();
    Если Запись.Выбран() Тогда ВызватьИсключение "кабинет_гидрология_привязка_конфликт"; КонецЕсли;
    Запись.Гидропост = Пост; Запись.ВремяИзмерения = СтрокаИзмерения.Момент; Запись.Ревизия = Ревизия;
    Запись.Идентификатор = Строка(СервисДокументов.НовыйUUIDv4()); Запись.ПредыдущийИдентификатор = Предыдущий;
    Запись.Уровень = СтрокаИзмерения.Значение; Запись.Источник = СтрокаИзмерения.Источник;
    Запись.Опубликован = Тело.published; Запись.Основание = Причина; Запись.Автор = Автор;
    Запись.МоментЗаписи = Сейчас; Запись.КлючКоманды = Ключ; Запись.ВерсияАлгоритма = Алгоритм;
    Запись.НачальноеЗначение = Начальное; Запись.Записать();
    Голова.Гидропост = Пост; Голова.ВремяИзмерения = СтрокаИзмерения.Момент;
    Голова.Ревизия = Ревизия; Голова.Идентификатор = Запись.Идентификатор; Голова.Записать();
    Возврат Новый Структура("id,measuredAt,revision", Запись.Идентификатор, ДатаВыхода(СтрокаИзмерения.Момент), Ревизия);
КонецФункции

Функция ПодготовитьСтроки(Операция, Тело, Сейчас)
    Строки = Новый Массив;
    Если Операция = "measure" Или Операция = "correct" Тогда
        Строки.Добавить(Новый Структура("Момент,Значение,Источник", ДатаВхода(Тело.measuredAt), Уровень(Тело.level), Текст(Тело.source, 120)));
    ИначеЕсли Операция = "import" Тогда
        Данные = Текст(Тело.csv, 12000);
        Если СтрНайти(Данные, Символ(65279)) > 0 Или СтрНайти(Данные, Символ(34)) > 0 Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
        Данные = СтрЗаменить(Данные, Символы.ВК + Символы.ПС, Символы.ПС);
        Если СтрНайти(Данные, Символы.ВК) > 0 Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
        Если Прав(Данные, 1) = Символы.ПС Тогда Данные = Лев(Данные, СтрДлина(Данные) - 1); КонецЕсли;
        Линии = СтрРазделить(Данные, Символы.ПС, Истина);
        Если Линии.Количество() < 2 Или Линии.Количество() > 101 Или Линии[0] <> "measuredAt,level,source" Тогда
            ВызватьИсключение "кабинет_гидрология_некорректно_ввод";
        КонецЕсли;
        Для Номер = 1 По Линии.Количество() - 1 Цикл
            Ячейки = СтрРазделить(Линии[Номер], ",", Истина);
            Если Ячейки.Количество() <> 3 Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
            Значение = ЧислоИзТекста(Ячейки[1]);
            Строки.Добавить(Новый Структура("Момент,Значение,Источник", ДатаВхода(Ячейки[0]), Значение, Текст(Ячейки[2], 120)));
        КонецЦикла;
    ИначеЕсли Операция = "generate" Тогда
        Начало = ДатаВхода(Тело.startAt); Количество = ЦелоеЧисло(Тело.count, 1, 100);
        Интервал = ЦелоеЧисло(Тело.intervalSeconds, 300, 86400); Состояние = ЦелоеЧисло(Тело.seed, 0, 2147483646);
        Для Номер = 0 По Количество - 1 Цикл
            Состояние = (Состояние * 48271 + 1) % 2147483647;
            Значение = (Состояние % 10000) / 10;
            Строки.Добавить(Новый Структура("Момент,Значение,Источник", Начало + Номер * Интервал, Значение,
                "synthetic:hydrology-lcg-v1:" + Формат(Тело.seed, "ЧГ=0;ЧДЦ=0")));
        КонецЦикла;
    Иначе ВызватьИсключение "кабинет_гидрология_некорректно_ввод";
    КонецЕсли;
    Времена = Новый Соответствие;
    Для Каждого СтрокаИзмерения Из Строки Цикл
        Если СтрокаИзмерения.Момент > Сейчас Или Времена.Получить(СтрокаИзмерения.Момент) <> Неопределено Тогда
            ВызватьИсключение "кабинет_гидрология_некорректно_ввод";
        КонецЕсли;
        Времена.Вставить(СтрокаИзмерения.Момент, Истина);
    КонецЦикла;
    Возврат Строки;
КонецФункции

Процедура СохранитьНастройку(Пост, Перед, Причина, Автор, Ключ, Сейчас)
    Запись = РегистрыСведений.ИсторияГидропостов.СоздатьМенеджерЗаписи();
    Запись.Гидропост = Пост.Ссылка; Запись.Ревизия = Пост.Ревизия; Запись.Прочитать();
    Если Запись.Выбран() Тогда ВызватьИсключение "кабинет_гидрология_привязка_конфликт"; КонецЕсли;
    Запись.Гидропост = Пост.Ссылка; Запись.Ревизия = Пост.Ревизия;
    Запись.ДоИзменения = Перед; Запись.ПослеИзменения = СериализоватьДанные(ДанныеПоста(Пост, Ложь));
    Запись.Основание = Причина; Запись.Автор = Автор; Запись.КлючКоманды = Ключ; Запись.Момент = Сейчас; Запись.Записать();
КонецПроцедуры

Процедура РасходКвоты(Контекст, Создание)
    Квота = РегистрыСведений.КвотыГидрологии.СоздатьМенеджерЗаписи();
    Квота.РабочееПространство = Контекст.РабочееПространство; Квота.Область = Контекст.Область; Квота.Прочитать();
    Если Квота.Команды >= 20000 Или (Создание И Квота.Гидропосты >= 100) Тогда ВызватьИсключение "кабинет_гидрология_квота_превышено"; КонецЕсли;
    Квота.РабочееПространство = Контекст.РабочееПространство; Квота.Область = Контекст.Область;
    Квота.Команды = Квота.Команды + 1;
    Если Создание Тогда Квота.Гидропосты = Квота.Гидропосты + 1; КонецЕсли;
    Квота.Записать();
КонецПроцедуры

Функция ДанныеРяда(Пост, Начало, Конец, После, Публичный, Лимит = 25, КурсорСтраницы = "")
    ЦелоеЧисло(Лимит, 1, 100);
    От = ДатаВхода(Начало); До = ДатаВхода(Конец);
    Если До < От Или До - От > 365 * 86400 Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
    Если ТипЗнч(КурсорСтраницы) <> Тип("Строка") Или СтрДлина(КурсорСтраницы) > 128 Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
    Если КурсорСтраницы <> "" Тогда
        Если После <> "" Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
        Части = СтрРазделить(КурсорСтраницы, "|", Истина);
        Если Части.Количество() <> 5 Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
        Если Части[0] <> "h1" Или Части[1] <> Ид(Пост.Ссылка) Или Части[2] <> Начало Или Части[3] <> Конец Тогда
            ВызватьИсключение "кабинет_гидрология_некорректно_ввод";
        КонецЕсли;
        После = Части[4];
    КонецЕсли;
    Курсор = От - 1;
    Если После <> "" Тогда
        Курсор = ДатаВхода(После);
        Если Курсор < От Или Курсор > До Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
    КонецЕсли;
    Сейчас = ТекущаяУниверсальнаяДата();
    Запрос = ЗапросРяда(Пост.Ссылка, Публичный, Ложь, Лимит);
    Запрос.УстановитьПараметр("От", От); Запрос.УстановитьПараметр("До", До); Запрос.УстановитьПараметр("Курсор", Курсор);
    Выборка = Запрос.Выполнить().Выбрать(); Элементы = Новый Массив; ЕстьЕще = Ложь;
    Пока Выборка.Следующий() Цикл
        Если Элементы.Количество() = Лимит Тогда ЕстьЕще = Истина; Прервать; КонецЕсли;
        Элементы.Добавить(ДанныеИзмерения(Выборка));
    КонецЦикла;
    Запрос = ЗапросРяда(Пост.Ссылка, Публичный, Истина); Выборка = Запрос.Выполнить().Выбрать();
    Текущее = Неопределено; Состояние = "missing"; Устарело = Ложь; ЕстьДанные = Ложь;
    Если Выборка.Следующий() Тогда
        Текущее = ДанныеИзмерения(Выборка); ЕстьДанные = Истина;
        Устарело = Сейчас - Выборка.ВремяИзмерения > Пост.СрокАктуальности;
        Если Устарело Тогда Состояние = "stale";
        ИначеЕсли Выборка.Уровень < Пост.НижнийПорог Тогда Состояние = "low";
        ИначеЕсли Выборка.Уровень > Пост.ВерхнийПорог Тогда Состояние = "high";
        Иначе Состояние = "normal";
        КонецЕсли;
    КонецЕсли;
    Следующий = ""; СледующееВремя = "";
    Если ЕстьЕще Тогда
        СледующееВремя = Элементы[Элементы.Количество() - 1].measuredAt;
        Следующий = "h1|" + Ид(Пост.Ссылка) + "|" + Начало + "|" + Конец + "|" + СледующееВремя;
    КонецЕсли;
    Возврат Новый Структура("post,current,condition,stale,hasData,from,to,items,limit,hasMore,nextCursor,nextAfterTime,snapshotAt",
        ДанныеПоста(Пост, Публичный), Текущее, Состояние, Устарело, ЕстьДанные, Начало, Конец, Элементы, Лимит,
        ЕстьЕще, Следующий, СледующееВремя, ДатаВыхода(Сейчас));
КонецФункции

Функция ЗапросРяда(Пост, Публичный, Последний, Лимит = 25)
    ТекстЗапроса = "ВЫБРАТЬ " + ?(Публичный, "РАЗРЕШЕННЫЕ ", "") + "ПЕРВЫЕ " + ?(Последний, "1", Формат(Лимит + 1, "ЧГ=0")) + " Редакции.Гидропост, Редакции.ВремяИзмерения,
        |Редакции.Ревизия, Редакции.Идентификатор, Редакции.Уровень, Редакции.Источник, Редакции.Опубликован
        |ИЗ РегистрСведений.ТекущиеИзмеренияГидрологии КАК Головы
        |ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РедакцииИзмеренийГидрологии КАК Редакции
        |ПО Головы.Гидропост = Редакции.Гидропост И Головы.ВремяИзмерения = Редакции.ВремяИзмерения
        |И Головы.Ревизия = Редакции.Ревизия И Головы.Идентификатор = Редакции.Идентификатор
        |ГДЕ Головы.Гидропост = &Пост";
    Если Публичный Тогда ТекстЗапроса = ТекстЗапроса + " И Редакции.Опубликован"; КонецЕсли;
    Если Не Последний Тогда
        ТекстЗапроса = ТекстЗапроса + " И Головы.ВремяИзмерения >= &От И Головы.ВремяИзмерения <= &До И Головы.ВремяИзмерения > &Курсор";
    КонецЕсли;
    ТекстЗапроса = ТекстЗапроса + " УПОРЯДОЧИТЬ ПО Головы.ВремяИзмерения" + ?(Последний, " УБЫВ", "") + ", Редакции.Идентификатор";
    Запрос = Новый Запрос(ТекстЗапроса); Запрос.УстановитьПараметр("Пост", Пост); Возврат Запрос;
КонецФункции

Функция СписокПостов(Запрос, Публичный, Лимит = 25)
    Элементы = Новый Массив; ЕстьЕще = Ложь; Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Если Элементы.Количество() = Лимит Тогда ЕстьЕще = Истина; Прервать; КонецЕсли;
        Если Публичный Тогда
            Элементы.Добавить(ДанныеПоста(Выборка, Истина));
        Иначе
            Пост = Выборка.Ссылка.ПолучитьОбъект();
            Если Пост = Неопределено Или Пост.ПометкаУдаления Тогда Продолжить; КонецЕсли;
            Элементы.Добавить(ДанныеПоста(Пост, Ложь));
        КонецЕсли;
    КонецЦикла;
    Результат = Новый Структура("items,limit,hasMore,snapshotAt", Элементы, Лимит, ЕстьЕще, ДатаВыхода(ТекущаяУниверсальнаяДата()));
    СледующийКурсор = "";
    Если ЕстьЕще Тогда СледующийКурсор = Элементы[Элементы.Количество() - 1].id; КонецЕсли;
    Результат.Вставить("nextCursor", СледующийКурсор);
    Возврат Результат;
КонецФункции

Функция ДанныеПоста(Пост, Публичный)
    Результат = Новый Структура("id,name,riverCode,riverName,referenceVersion,location,unit,datum,lowThreshold,highThreshold,staleAfterSeconds,published,revision,training,warning",
        Ид(Пост.Ссылка), Пост.Наименование, Пост.КодРеки, НазваниеРеки(Пост.КодРеки), Пост.ВерсияСправочника,
        Пост.Местоположение, "cm", НольОтсчета(), Пост.НижнийПорог, Пост.ВерхнийПорог, Пост.СрокАктуальности,
        Пост.Опубликован, Пост.Ревизия, Истина, Предупреждение());
    Если Не Публичный Тогда
        Результат.Вставить("workspaceId", Ид(Пост.РабочееПространство)); Результат.Вставить("areaId", Ид(Пост.Область));
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ДанныеИзмерения(Запись)
    Возврат Новый Структура("id,postId,measuredAt,level,unit,source,revision,published,training", Запись.Идентификатор,
        Ид(Запись.Гидропост), ДатаВыхода(Запись.ВремяИзмерения), Запись.Уровень, "cm", Запись.Источник, Запись.Ревизия, Запись.Опубликован, Истина);
КонецФункции

Функция НачатьЧтениеЧастногоПоста(УчетнаяЗапись, Пост)
    Попытка
        Возврат НачатьЧтениеОбласти(УчетнаяЗапись, Ид(Пост.РабочееПространство), Ид(Пост.Область));
    Исключение
        Описание = ОписаниеОшибки();
        Для Каждого Код Из СтрРазделить("кабинет_пространство_запрещено,кабинет_область_запрещено,кабинет_пространство_не_найдено,кабинет_область_не_найдено,кабинет_пространство_неактивно", ",") Цикл
            Если СтрНайти(Описание, Код) > 0 Тогда ВызватьИсключение "кабинет_гидрология_не_найдено"; КонецЕсли;
        КонецЦикла;
        ВызватьИсключение;
    КонецПопытки;
КонецФункции

Функция НачатьЧтениеОбласти(УчетнаяЗапись, ПространствоИд, ОбластьИд)
    ПроверитьАктера(УчетнаяЗапись);
    Если ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_гидрология_вложенная_транзакция"; КонецЕсли;
    Контекст = КонтекстОбласти(УчетнаяЗапись, СсылкаПоИд("РабочиеПространства", ПространствоИд), СсылкаПоИд("Области", ОбластьИд));
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        Блокировать("Справочник.УчетныеЗаписи", УчетнаяЗапись); ЗаблокироватьОбласть(Контекст);
    Исключение Откат(); ВызватьИсключение;
    КонецПопытки;
    Возврат Контекст;
КонецФункции

Функция КонтекстОбласти(УчетнаяЗапись, Пространство, Область)
    Возврат Новый Структура("УчетнаяЗапись,РабочееПространство,Область", УчетнаяЗапись, Пространство, Область);
КонецФункции

Процедура ЗаблокироватьОбласть(Контекст)
    Блокировать("Справочник.РабочиеПространства", Контекст.РабочееПространство);
    Блокировать("Справочник.Области", Контекст.Область); ПроверитьАктера(Контекст.УчетнаяЗапись);
    ПолитикаДоступа.ПроверитьДоступКОбласти(Контекст.УчетнаяЗапись, Ид(Контекст.РабочееПространство), Ид(Контекст.Область), "Dispatcher");
КонецПроцедуры

Процедура Блокировать(Таблица, Ссылка, Разделяемая = Ложь)
    Блокировка = Новый БлокировкаДанных; Элемент = Блокировка.Добавить(Таблица); Элемент.УстановитьЗначение("Ссылка", Ссылка);
    Элемент.Режим = ?(Разделяемая, РежимБлокировкиДанных.Разделяемый, РежимБлокировкиДанных.Исключительный); Блокировка.Заблокировать();
КонецПроцедуры

Процедура ПроверитьРежим()
    Если ПривилегированныйРежим() Тогда ВызватьИсключение "кабинет_гидрология_привилегированный_запрещено"; КонецЕсли;
КонецПроцедуры

Процедура ПроверитьАктера(УчетнаяЗапись)
    ПроверитьРежим(); Текущая = ПолитикаДоступа.ПроверитьУчетнуюЗапись();
    Если ТипЗнч(УчетнаяЗапись) <> Тип("СправочникСсылка.УчетныеЗаписи") Или Текущая.Ссылка <> УчетнаяЗапись Тогда
        ВызватьИсключение "кабинет_участник_несовпадение";
    КонецЕсли;
КонецПроцедуры

Функция ПолучитьПост(ПостИд)
    Ссылка = СсылкаПоИд("Гидропосты", ПостИд); Пост = Ссылка.ПолучитьОбъект();
    Если Пост = Неопределено Или Пост.ПометкаУдаления Тогда ВызватьИсключение "кабинет_гидрология_не_найдено"; КонецЕсли;
    Возврат Пост;
КонецФункции

Функция ПолучитьПубличныйПост(Ссылка)
    Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ Ссылка, Наименование, КодРеки, ВерсияСправочника, Местоположение,
        |НижнийПорог, ВерхнийПорог, СрокАктуальности, Опубликован, Ревизия ИЗ Справочник.Гидропосты
        |ГДЕ Ссылка = &Пост И Опубликован И НЕ ПометкаУдаления");
    Запрос.УстановитьПараметр("Пост", Ссылка); Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Тогда ВызватьИсключение "кабинет_гидрология_не_найдено"; КонецЕсли;
    Возврат Выборка;
КонецФункции

Функция СсылкаПоИд(Каталог, Значение)
    ПроверитьКлюч(Значение);
    Возврат Справочники[Каталог].ПолучитьСсылку(Новый УникальныйИдентификатор(Значение));
КонецФункции

Процедура ПроверитьКлюч(Значение)
    Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) <> 36 Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
    Попытка Идентификатор = Новый УникальныйИдентификатор(Значение);
    Исключение ВызватьИсключение "кабинет_гидрология_некорректно_ввод";
    КонецПопытки;
    Если Строка(Идентификатор) <> НРег(Значение) Или Значение <> НРег(Значение)
        Или Значение = "00000000-0000-0000-0000-000000000000" Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
КонецПроцедуры

Функция Ид(Ссылка)
    Возврат Строка(Ссылка.УникальныйИдентификатор());
КонецФункции

Функция ПоляКоманды(Операция)
    Префикс = "workspaceId,areaId,";
    Если Операция = "create" Тогда Возврат Префикс + "name,riverCode,location,lowThreshold,highThreshold,staleAfterSeconds,published,reason";
    ИначеЕсли Операция = "configure" Тогда Возврат Префикс + "expectedRevision,name,location,lowThreshold,highThreshold,staleAfterSeconds,published,reason";
    ИначеЕсли Операция = "measure" Тогда Возврат Префикс + "measuredAt,level,source,published,reason";
    ИначеЕсли Операция = "correct" Тогда Возврат Префикс + "measuredAt,expectedRevision,level,source,published,reason";
    ИначеЕсли Операция = "import" Тогда Возврат Префикс + "csv,published,reason";
    ИначеЕсли Операция = "generate" Тогда Возврат Префикс + "startAt,count,intervalSeconds,seed,published,reason";
    КонецЕсли;
    ВызватьИсключение "кабинет_гидрология_некорректно_ввод";
КонецФункции

Процедура ПроверитьПоля(Тело, Поля)
    Если ТипЗнч(Тело) <> Тип("Структура") Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
    Имена = СтрРазделить(Поля, ",", Ложь);
    Если Тело.Количество() <> Имена.Количество() Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
    Для Каждого Пара Из Тело Цикл
        Если Имена.Найти(Пара.Ключ) = Неопределено Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция Текст(Значение, Предел)
    Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) > Предел Или ПустаяСтрока(Значение)
        Или СтрНайти(Значение, Символ(0)) > 0 Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
    Возврат Значение;
КонецФункции

Функция Уровень(Значение)
    Если ТипЗнч(Значение) <> Тип("Число") Или Значение < -10000 Или Значение > 10000 Или Значение * 10 <> Цел(Значение * 10) Тогда
        ВызватьИсключение "кабинет_гидрология_некорректно_ввод";
    КонецЕсли;
    Возврат Значение;
КонецФункции

Функция ЦелоеЧисло(Значение, Минимум, Максимум)
    Если ТипЗнч(Значение) <> Тип("Число") Или Значение <> Цел(Значение) Или Значение < Минимум Или Значение > Максимум Тогда
        ВызватьИсключение "кабинет_гидрология_некорректно_ввод";
    КонецЕсли;
    Возврат Значение;
КонецФункции

Функция ЧислоИзТекста(Значение)
    Если СтрДлина(Значение) = 0 Или СтрДлина(Значение) > 9 Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
    Для Номер = 1 По СтрДлина(Значение) Цикл
        Если СтрНайти("0123456789.-", Сред(Значение, Номер, 1)) = 0 Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
    КонецЦикла;
    Попытка Числовое = XMLЗначение(Тип("Число"), Значение);
    Исключение ВызватьИсключение "кабинет_гидрология_некорректно_ввод";
    КонецПопытки;
    Возврат Уровень(Числовое);
КонецФункции

Процедура ПроверитьРевизию(Ожидаемая, Текущая)
    ЦелоеЧисло(Ожидаемая, 1, 10000);
    Если Ожидаемая <> Текущая Тогда ВызватьИсключение "кабинет_гидрология_редакция_конфликт"; КонецЕсли;
КонецПроцедуры

Функция ДатаВхода(Значение)
    Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) <> 20 Или Прав(Значение, 1) <> "Z" Тогда
        ВызватьИсключение "кабинет_гидрология_некорректно_ввод";
    КонецЕсли;
    Попытка Момент = XMLЗначение(Тип("Дата"), Лев(Значение, 19));
    Исключение ВызватьИсключение "кабинет_гидрология_некорректно_ввод";
    КонецПопытки;
    Если ДатаВыхода(Момент) <> Значение Или Момент < Дата(2000, 1, 1) Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
    Возврат Момент;
КонецФункции

Функция ДатаВыхода(Момент)
    Возврат Формат(Момент, "ДФ=yyyy-MM-dd'T'HH:mm:ss") + "Z";
КонецФункции

Функция НазваниеРеки(Код)
    Если Код = "irtysh" Тогда Возврат "Иртыш"; ИначеЕсли Код = "om" Тогда Возврат "Омь"; КонецЕсли;
    ВызватьИсключение "кабинет_гидрология_некорректно_ввод";
КонецФункции

Функция НольОтсчета()
    Возврат "Учебный условный ноль; не абсолютная отметка";
КонецФункции

Функция Предупреждение()
    Возврат "Учебные данные. Не использовать для оценки паводковой опасности или принятия решений о безопасности.";
КонецФункции

Функция СериализоватьДанные(Данные)
    Запись = Новый ЗаписьJSON; Запись.УстановитьСтроку(); ЗаписатьJSON(Запись, Данные); Возврат Запись.Закрыть();
КонецФункции

Функция ПрочитатьДанные(ТекстДанных)
    Чтение = Новый ЧтениеJSON; Чтение.УстановитьСтроку(ТекстДанных); Данные = ПрочитатьJSON(Чтение); Чтение.Закрыть(); Возврат Данные;
КонецФункции

Процедура Откат()
    Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
КонецПроцедуры
