Функция СоздатьИзолированногоЧитателяИзФайлаОператора() Экспорт
    Возврат СоздатьЧитателяИзФайла(Истина);
КонецФункции

Функция ПроверитьИзолированногоЧитателяИзФайлаОператора() Экспорт
    ПроверитьАдминистратора();
    Попытка
        ФайлРезультата = Новый Файл("/run/vodokanal-portal-reader/result.json");
        Если ФайлРезультата.Существует() Тогда Отказать(); КонецЕсли;
        ФайлВвода = Новый Файл("/run/vodokanal-portal-reader/input.json");
        Если Не ФайлВвода.Существует() Тогда Отказать(); КонецЕсли;
        Если ФайлВвода.Размер() < 2 Или ФайлВвода.Размер() > 16384 Тогда Отказать(); КонецЕсли;
        Чтение = Новый ЧтениеJSON; Чтение.ОткрытьФайл(ФайлВвода.ПолноеИмя); Вход = ПрочитатьJSON(Чтение); Чтение.Закрыть();
        ПроверитьВводПроверки(Вход);
        Роль = Метаданные.Роли.Найти("ПубличноеЧтениеПортала");
        Если Роль = Неопределено Тогда Отказать(); КонецЕсли;
        Если Роль.РасширениеКонфигурации() <> Неопределено Или Роль.ЕстьИзмененияРасширениямиКонфигурации() Тогда Отказать(); КонецЕсли;
        НативныйИд = Новый УникальныйИдентификатор(Вход.nativeUserId);
        Свежий = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(НативныйИд);
        ПоИмени = ПользователиИнформационнойБазы.НайтиПоИмени("vodokanal_portal_reader");
        Если Свежий = Неопределено Или ПоИмени = Неопределено Тогда Отказать(); КонецЕсли;
        Если Свежий.УникальныйИдентификатор <> НативныйИд Или Свежий.Имя <> "vodokanal_portal_reader"
            Или ПоИмени.УникальныйИдентификатор <> НативныйИд Или ПоИмени.Имя <> "vodokanal_portal_reader"
            Или Не Свежий.АутентификацияСтандартная Или Свежий.АутентификацияОС Или Свежий.ПоказыватьВСпискеВыбора Тогда Отказать(); КонецЕсли;
        Количество = 0;
        Для Каждого Назначенная Из Свежий.Роли Цикл
            Количество = Количество + 1; Если Назначенная <> Роль Тогда Отказать(); КонецЕсли;
        КонецЦикла;
        Если Количество <> 1 Тогда Отказать(); КонецЕсли;
        ПроверитьОтсутствиеПривязок(Строка(Свежий.УникальныйИдентификатор));
        Результат = Новый Структура("schema,purpose,mode,operationId,status,name,nativeUserId,roleName,configurationVersion,checkedAtUtc,server,ref",
            1, "public_portal_native_principal", "verify", Вход.operationId, "verified", Свежий.Имя,
            Строка(Свежий.УникальныйИдентификатор), "ПубличноеЧтениеПортала", Метаданные.Версия,
            XMLСтрока(ТекущаяУниверсальнаяДата()) + "Z", "onec:1541", Вход.target.ref);
        Результат.Вставить("standardAuth", Свежий.АутентификацияСтандартная);
        Результат.Вставить("osAuth", Свежий.АутентификацияОС);
        Результат.Вставить("showInList", Свежий.ПоказыватьВСпискеВыбора);
        Запись = Новый ЗаписьJSON; Запись.УстановитьСтроку(); ЗаписатьJSON(Запись, Результат);
        Данные = ПолучитьДвоичныеДанныеИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8, Ложь);
        Поток = Новый ФайловыйПоток("/run/vodokanal-portal-reader/result.json", РежимОткрытияФайла.СоздатьНовый, ДоступКФайлу.Запись);
        Попытка Данные.Записать(Поток); Поток.Закрыть(); Исключение Попытка Поток.Закрыть(); Исключение КонецПопытки; Отказать(); КонецПопытки;
        Возврат "portal_reader_verify_completed";
    Исключение
        Отказать();
    КонецПопытки;
КонецФункции

Процедура ПроверитьВводПроверки(Вход)
    Если ТипЗнч(Вход) <> Тип("Структура") Или Вход.Количество() <> 7 Тогда Отказать(); КонецЕсли;
    Для Каждого Ключ Из СтрРазделить("schema,purpose,mode,operationId,currentVersion,target,nativeUserId", ",") Цикл
        Если Не Вход.Свойство(Ключ) Тогда Отказать(); КонецЕсли;
    КонецЦикла;
    Если Вход.Свойство("password") Тогда Отказать(); КонецЕсли;
    Если ТипЗнч(Вход.schema) <> Тип("Число") Или Вход.schema <> 1
        Или ТипЗнч(Вход.purpose) <> Тип("Строка") Или Вход.purpose <> "public_portal_native_principal"
        Или ТипЗнч(Вход.mode) <> Тип("Строка") Или Вход.mode <> "verify" Тогда Отказать(); КонецЕсли;
    Если ТипЗнч(Вход.currentVersion) <> Тип("Строка") Или Вход.currentVersion <> "1.0"
        Или Вход.currentVersion <> Метаданные.Версия Тогда Отказать(); КонецЕсли;
    Для Каждого Ключ Из СтрРазделить("operationId,nativeUserId", ",") Цикл
        Значение = Вход[Ключ];
        Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) <> 36 Тогда Отказать(); КонецЕсли;
        Ид = Новый УникальныйИдентификатор(Значение); Если НРег(Строка(Ид)) <> Значение Тогда Отказать(); КонецЕсли;
    КонецЦикла;
    Если ТипЗнч(Вход.target) <> Тип("Структура") Или Вход.target.Количество() <> 2 Тогда Отказать(); КонецЕсли;
    Если Не Вход.target.Свойство("server") Или Не Вход.target.Свойство("ref") Тогда Отказать(); КонецЕсли;
    Если ТипЗнч(Вход.target.server) <> Тип("Строка") Или Вход.target.server <> "onec:1541" Тогда Отказать(); КонецЕсли;
    ПроверитьИмяВосстановленнойБазы(Вход.target.ref);
    ПроверитьСоединение(Вход.target.ref);
КонецПроцедуры

Функция СоздатьЧитателяИзФайла(ИзолированнаяБаза)
    ПроверитьАдминистратора();
    Если Не ИзолированнаяБаза Тогда ПроверитьСоединение(); КонецЕсли;
    Вход = Неопределено;
    Попытка
        ФайлРезультата = Новый Файл("/run/vodokanal-portal-reader/result.json");
        Если ФайлРезультата.Существует() Тогда Отказать(); КонецЕсли;
        ФайлВвода = Новый Файл("/run/vodokanal-portal-reader/input.json");
        Если Не ФайлВвода.Существует() Тогда Отказать(); КонецЕсли;
        Если ФайлВвода.Размер() < 2 Или ФайлВвода.Размер() > 16384 Тогда Отказать(); КонецЕсли;
        Чтение = Новый ЧтениеJSON; Чтение.ОткрытьФайл(ФайлВвода.ПолноеИмя); Вход = ПрочитатьJSON(Чтение); Чтение.Закрыть();
        ПроверитьВвод(Вход, ИзолированнаяБаза);
        Роль = Метаданные.Роли.Найти("ПубличноеЧтениеПортала");
        Если Роль = Неопределено Тогда Отказать(); КонецЕсли;
        Если Роль.РасширениеКонфигурации() <> Неопределено Или Роль.ЕстьИзмененияРасширениямиКонфигурации() Тогда Отказать(); КонецЕсли;
        Для Каждого Существующий Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
            Если НРег(Существующий.Имя) = "vodokanal_portal_reader" Тогда Отказать(); КонецЕсли;
        КонецЦикла;
        ПроверитьОтсутствиеПривязок("");
        Пользователь = ПользователиИнформационнойБазы.СоздатьПользователя();
        Для Каждого Назначенная Из Пользователь.Роли Цикл Отказать(); КонецЦикла;
        Пользователь.Имя = "vodokanal_portal_reader"; Пользователь.ПолноеИмя = "Публичное чтение учебного портала";
        Пользователь.АутентификацияСтандартная = Истина; Пользователь.АутентификацияОС = Ложь; Пользователь.ПоказыватьВСпискеВыбора = Ложь;
        Пользователь.Роли.Добавить(Роль); Пользователь.Пароль = Вход.password;
        Пользователь.Записать(); Вход.password = "";
        НативныйИд = Пользователь.УникальныйИдентификатор;
        Свежий = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(НативныйИд);
        ПоИмени = ПользователиИнформационнойБазы.НайтиПоИмени("vodokanal_portal_reader");
        Если Свежий = Неопределено Или ПоИмени = Неопределено Тогда Отказать(); КонецЕсли;
        Если Свежий.Имя <> "vodokanal_portal_reader" Или ПоИмени.УникальныйИдентификатор <> НативныйИд
            Или Не Свежий.АутентификацияСтандартная Или Свежий.АутентификацияОС Или Свежий.ПоказыватьВСпискеВыбора Тогда Отказать(); КонецЕсли;
        Количество = 0;
        Для Каждого Назначенная Из Свежий.Роли Цикл
            Количество = Количество + 1; Если Назначенная <> Роль Тогда Отказать(); КонецЕсли;
        КонецЦикла;
        Если Количество <> 1 Тогда Отказать(); КонецЕсли;
        ПроверитьОтсутствиеПривязок(Строка(НативныйИд));
        Результат = Новый Структура("schema,purpose,mode,operationId,status,name,nativeUserId,roleName,configurationVersion,checkedAtUtc,server,ref",
            1, "public_portal_native_principal", "create", Вход.operationId, "created", Свежий.Имя,
            Строка(НативныйИд), "ПубличноеЧтениеПортала", Метаданные.Версия, XMLСтрока(ТекущаяУниверсальнаяДата()) + "Z", "onec:1541", Вход.target.ref);
        Результат.Вставить("standardAuth", Истина); Результат.Вставить("osAuth", Ложь); Результат.Вставить("showInList", Ложь);
        Запись = Новый ЗаписьJSON; Запись.УстановитьСтроку(); ЗаписатьJSON(Запись, Результат);
        Данные = ПолучитьДвоичныеДанныеИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8, Ложь);
        Поток = Новый ФайловыйПоток("/run/vodokanal-portal-reader/result.json", РежимОткрытияФайла.СоздатьНовый, ДоступКФайлу.Запись);
        Попытка Данные.Записать(Поток); Поток.Закрыть(); Исключение Попытка Поток.Закрыть(); Исключение КонецПопытки; Отказать(); КонецПопытки;
        Возврат "portal_reader_create_completed";
    Исключение
        Если ТипЗнч(Вход) = Тип("Структура") Тогда Если Вход.Свойство("password") Тогда Вход.password = ""; КонецЕсли; КонецЕсли;
        Отказать();
    КонецПопытки;
КонецФункции

Процедура ПроверитьАдминистратора()
    Если ПривилегированныйРежим() Или ТранзакцияАктивна() Или Не РольДоступна("Администратор") Тогда Отказать(); КонецЕсли;
    Текущий = ПользователиИнформационнойБазы.ТекущийПользователь(); Если Текущий = Неопределено Тогда Отказать(); КонецЕсли;
    Свежий = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Текущий.УникальныйИдентификатор);
    Если Свежий = Неопределено Тогда Отказать(); КонецЕсли;
    Если ПустаяСтрока(Свежий.Имя) Или Свежий.Имя <> Текущий.Имя Тогда Отказать(); КонецЕсли;
    Администратор = Ложь;
    Для Каждого Роль Из Свежий.Роли Цикл Если Роль = Метаданные.Роли.Администратор Тогда Администратор = Истина; КонецЕсли; КонецЦикла;
    Если Не Администратор Тогда Отказать(); КонецЕсли;
КонецПроцедуры

Процедура ПроверитьВвод(Вход, ИзолированнаяБаза = Ложь)
    Если ТипЗнч(Вход) <> Тип("Структура") Или Вход.Количество() <> 7 Тогда Отказать(); КонецЕсли;
    Для Каждого Ключ Из СтрРазделить("schema,purpose,mode,operationId,currentVersion,target,password", ",") Цикл
        Если Не Вход.Свойство(Ключ) Тогда Отказать(); КонецЕсли;
    КонецЦикла;
    Если ТипЗнч(Вход.schema) <> Тип("Число") Или ТипЗнч(Вход.purpose) <> Тип("Строка") Или ТипЗнч(Вход.mode) <> Тип("Строка") Тогда Отказать(); КонецЕсли;
    Если Вход.schema <> 1 Или Вход.purpose <> "public_portal_native_principal" Или Вход.mode <> "create" Тогда Отказать(); КонецЕсли;
    Если ТипЗнч(Вход.currentVersion) <> Тип("Строка") Или СтрДлина(Вход.currentVersion) < 1 Или СтрДлина(Вход.currentVersion) > 64 Тогда Отказать(); КонецЕсли;
    Если Метаданные.Версия <> Вход.currentVersion Тогда Отказать(); КонецЕсли;
    Если ТипЗнч(Вход.operationId) <> Тип("Строка") Или СтрДлина(Вход.operationId) <> 36 Тогда Отказать(); КонецЕсли;
    Ид = Новый УникальныйИдентификатор(Вход.operationId); Если НРег(Строка(Ид)) <> Вход.operationId Тогда Отказать(); КонецЕсли;
    Если ТипЗнч(Вход.target) <> Тип("Структура") Или Вход.target.Количество() <> 2 Тогда Отказать(); КонецЕсли;
    Если Не Вход.target.Свойство("server") Или Не Вход.target.Свойство("ref") Тогда Отказать(); КонецЕсли;
    Если ТипЗнч(Вход.target.server) <> Тип("Строка") Или ТипЗнч(Вход.target.ref) <> Тип("Строка") Тогда Отказать(); КонецЕсли;
    Если Вход.target.server <> "onec:1541" Тогда Отказать(); КонецЕсли;
    Если ИзолированнаяБаза Тогда
        Если Вход.currentVersion <> "1.0" Тогда Отказать(); КонецЕсли;
        ПроверитьИмяВосстановленнойБазы(Вход.target.ref);
        ПроверитьСоединение(Вход.target.ref);
    ИначеЕсли Вход.target.ref <> "vodokanal" Тогда Отказать(); КонецЕсли;
    Если ТипЗнч(Вход.password) <> Тип("Строка") Или СтрДлина(Вход.password) <> 64 Тогда Отказать(); КонецЕсли;
    Верх = Ложь; Низ = Ложь; Цифра = Ложь;
    Для Н = 1 По 64 Цикл
        Сим = Сред(Вход.password, Н, 1);
        Если СтрНайти("ABCDEFGHIJKLMNOPQRSTUVWXYZ", Сим) > 0 Тогда Верх = Истина;
        ИначеЕсли СтрНайти("abcdefghijklmnopqrstuvwxyz", Сим) > 0 Тогда Низ = Истина;
        ИначеЕсли СтрНайти("0123456789", Сим) > 0 Тогда Цифра = Истина;
        ИначеЕсли Сим <> "_" И Сим <> "-" Тогда Отказать(); КонецЕсли;
    КонецЦикла;
    Если Не Верх Или Не Низ Или Не Цифра Тогда Отказать(); КонецЕсли;
КонецПроцедуры

Процедура ПроверитьИмяВосстановленнойБазы(ИмяБазы)
    Если ТипЗнч(ИмяБазы) <> Тип("Строка") Тогда Отказать(); КонецЕсли;
    Если Лев(ИмяБазы, 11) <> "vk_restore_" Или СтрДлина(ИмяБазы) < 12 Или СтрДлина(ИмяБазы) > 43 Тогда Отказать(); КонецЕсли;
    Для Н = 12 По СтрДлина(ИмяБазы) Цикл
        Если СтрНайти("abcdefghijklmnopqrstuvwxyz0123456789_", Сред(ИмяБазы, Н, 1)) = 0 Тогда Отказать(); КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура ПроверитьСоединение(ОжидаемаяБаза = "vodokanal")
    Части = Новый Соответствие; СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
    Если СтрДлина(СтрокаСоединения) > 4096 Тогда Отказать(); КонецЕсли;
    Для Каждого Часть Из СтрРазделить(СтрокаСоединения, ";", Ложь) Цикл
        Часть = СокрЛП(Часть); Если Часть = "" Тогда Продолжить; КонецЕсли;
        Разделитель = СтрНайти(Часть, "="); Если Разделитель < 2 Тогда Отказать(); КонецЕсли;
        Ключ = НРег(СокрЛП(Лев(Часть, Разделитель - 1)));
        Если (Ключ <> "srvr" И Ключ <> "ref") Или Части.Получить(Ключ) <> Неопределено Тогда Отказать(); КонецЕсли;
        Значение = СокрЛП(Сред(Часть, Разделитель + 1));
        Если Лев(Значение, 1) = """" Тогда
            Если СтрДлина(Значение) < 2 Или Прав(Значение, 1) <> """" Тогда Отказать(); КонецЕсли;
            Значение = Сред(Значение, 2, СтрДлина(Значение) - 2);
        КонецЕсли;
        Если СтрНайти(Значение, """") > 0 Тогда Отказать(); КонецЕсли;
        Части.Вставить(Ключ, Значение);
    КонецЦикла;
    Если Части.Количество() <> 2 Или Части.Получить("srvr") <> "onec:1541" Или Части.Получить("ref") <> ОжидаемаяБаза Тогда Отказать(); КонецЕсли;
КонецПроцедуры

Процедура ПроверитьОтсутствиеПривязок(Ид)
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.УчетныеЗаписи ГДЕ НормализованныйЛогин = &Логин");
    Запрос.УстановитьПараметр("Логин", "vodokanal_portal_reader"); Если Не Запрос.Выполнить().Пустой() Тогда Отказать(); КонецЕсли;
    Логин = РегистрыСведений.ПривязкиЛогинов.СоздатьМенеджерЗаписи(); Логин.НормализованныйЛогин = "vodokanal_portal_reader"; Логин.Прочитать();
    Если Логин.Выбран() Тогда Отказать(); КонецЕсли;
    Если Ид = "" Тогда Возврат; КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.УчетныеЗаписи ГДЕ ИдентификаторПользователя1С = &Ид");
    Запрос.УстановитьПараметр("Ид", Ид); Если Не Запрос.Выполнить().Пустой() Тогда Отказать(); КонецЕсли;
    Привязка = РегистрыСведений.ПривязкиПользователей1С.СоздатьМенеджерЗаписи(); Привязка.ИдентификаторПользователя1С = Ид; Привязка.Прочитать();
    Если Привязка.Выбран() Тогда Отказать(); КонецЕсли;
КонецПроцедуры

Процедура Отказать()
    ВызватьИсключение "кабинет_читатель_настройка_не_удалось";
КонецПроцедуры
