
Функция СтрокаДатыUTC(Значение)
    Возврат XMLСтрока(Значение) + "Z";
КонецФункции

Функция ИД(Значение)
    Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) <> 36 Тогда ВызватьИсключение "кабинет_документ_некорректно_поле"; КонецЕсли;
    Попытка Результат = Новый УникальныйИдентификатор(Значение); Исключение ВызватьИсключение "кабинет_документ_некорректно_поле"; КонецПопытки;
    Если Строка(Результат) <> НРег(Значение) Тогда ВызватьИсключение "кабинет_документ_некорректно_поле"; КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ИДс(Ссылка)
    Если Не ЗначениеЗаполнено(Ссылка) Тогда Возврат ""; КонецЕсли;
    Возврат Строка(Ссылка.УникальныйИдентификатор());
КонецФункции

Функция НовыйUUIDv4() Экспорт
    Чтение = Новый ЧтениеТекста("/proc/sys/kernel/random/uuid", КодировкаТекста.UTF8);
    Попытка
        Значение = НРег(СокрЛП(Чтение.ПрочитатьСтроку()));
        Чтение.Закрыть();
    Исключение
        Чтение.Закрыть();
        ВызватьИсключение "кабинет_документ_идентификатор_недоступно";
    КонецПопытки;
    Если СтрДлина(Значение) <> 36 Или Сред(Значение, 15, 1) <> "4"
        Или СтрНайти("89ab", Сред(Значение, 20, 1)) = 0 Тогда
        ВызватьИсключение "кабинет_документ_идентификатор_недоступно";
    КонецЕсли;
    Возврат Новый УникальныйИдентификатор(Значение);
КонецФункции

Функция ПодготовитьПакетСводки(Сводка) Экспорт
    СтрокаПакета = РегистрыСведений.ТекущиеПакетыСводок.СоздатьМенеджерЗаписи();
    КлючСнимка = КлючСнимкаСводки(Сводка);
    СтрокаПакета.КлючПакета = КлючСнимка;
    СтрокаПакета.СодержимоеПакета = Сводка.Содержимое;
    СтрокаПакета.Записать();
    Длина = 0;
    Для Индекс = 1 По СтрДлина(Сводка.Содержимое) Цикл
        Если КодСимвола(Сводка.Содержимое, Индекс) >= 32 Тогда Длина = Длина + 1; КонецЕсли;
    КонецЦикла;
    Возврат Новый Структура("Ключ,Длина", КлючСнимка, Длина);
КонецФункции

Функция КлючСнимкаСводки(Сводка)
    ИДВладельца = Строка(Сводка.УчетнаяЗаписьВладельца.УникальныйИдентификатор());
    Возврат Сводка.КлючПакета + "/" + Прав(ИДВладельца, 12);
КонецФункции

Функция СсылкаСводкиДляИндекса(Ссылка) Экспорт
    Если Ссылка.Пустая() Тогда Возврат Ссылка; КонецЕсли;
    ЧастиЗаголовка = СтрРазделить(Ссылка.Наименование, "-", Ложь);
    КлючИндекса = ЧастиЗаголовка[0];
    Возврат Справочники.ПриватныеСводки.НайтиПоНаименованию(КлючИндекса,
        Ложь, Неопределено, Ссылка.УчетнаяЗаписьВладельца);
КонецФункции

Процедура Актер(УчетнаяЗапись)
    Текущий = ПолитикаДоступа.ПроверитьУчетнуюЗапись();
    Если Текущий.Ссылка <> УчетнаяЗапись Тогда ВызватьИсключение "кабинет_участник_несовпадение"; КонецЕсли;
КонецПроцедуры

Процедура Поля(Тело, Обязательные, Необязательные = "")
    Если ТипЗнч(Тело) <> Тип("Структура") Тогда ВызватьИсключение "кабинет_документ_некорректно_поле"; КонецЕсли;
    Разрешенные = СтрРазделить(Обязательные + "," + Необязательные, ",", Ложь);
    Для Каждого Поле Из Тело Цикл
        Если Разрешенные.Найти(Поле.Ключ) = Неопределено Тогда ВызватьИсключение "кабинет_документ_некорректно_поле"; КонецЕсли;
    КонецЦикла;
    Для Каждого Поле Из СтрРазделить(Обязательные, ",", Ложь) Цикл
        Если Не Тело.Свойство(Поле) Тогда ВызватьИсключение "кабинет_документ_некорректно_поле"; КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция Текст(Значение, Максимум, Пустой = Ложь)
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда ВызватьИсключение "кабинет_документ_некорректно_поле"; КонецЕсли;
    Если СтрДлина(Значение) > Максимум Или (Не Пустой И ПустаяСтрока(Значение)) Тогда ВызватьИсключение "кабинет_документ_некорректно_поле"; КонецЕсли;
    Для П = 1 По СтрДлина(Значение) Цикл
        Если КодСимвола(Значение, П) < 32 Или КодСимвола(Значение, П) = 127 Тогда ВызватьИсключение "кабинет_документ_некорректно_поле"; КонецЕсли;
    КонецЦикла;
    Возврат Значение;
КонецФункции

Функция Целое(Значение, Минимум, Максимум)
    Если ТипЗнч(Значение) <> Тип("Число") Или Значение <> Цел(Значение) Или Значение < Минимум Или Значение > Максимум Тогда ВызватьИсключение "кабинет_документ_некорректно_поле"; КонецЕсли;
    Возврат Значение;
КонецФункции

Процедура Блокировать(Таблица, Ссылка)
    Б = Новый БлокировкаДанных; Э = Б.Добавить(Таблица); Э.УстановитьЗначение("Ссылка", Ссылка);
    Э.Режим = РежимБлокировкиДанных.Исключительный; Б.Заблокировать();
КонецПроцедуры

Процедура Начать(УчетнаяЗапись)
    Актер(УчетнаяЗапись);
    Если ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_документ_вложенная_транзакция"; КонецЕсли;
    НачатьТранзакцию();
    Попытка Блокировать("Справочник.УчетныеЗаписи", УчетнаяЗапись); Актер(УчетнаяЗапись);
    Исключение ОтменитьТранзакцию(); ВызватьИсключение; КонецПопытки;
КонецПроцедуры

Процедура Откат()
    Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
КонецПроцедуры

Функция JSON(Данные)
    Запись = Новый ЗаписьJSON; Запись.УстановитьСтроку(); ЗаписатьJSON(Запись, Данные); Возврат Запись.Закрыть();
КонецФункции

Функция ИзJSON(СтрокаJSON)
    Чтение = Новый ЧтениеJSON; Чтение.УстановитьСтроку(СтрокаJSON); Результат = ПрочитатьJSON(Чтение); Чтение.Закрыть(); Возврат Результат;
КонецФункции

Функция Хеш(Данные)
    Х = Новый ХешированиеДанных(ХешФункция.SHA256); Х.Добавить(Данные);
    Возврат СтрЗаменить(СтрЗаменить(Base64Строка(Х.ХешСумма), Символ(13), ""), Символ(10), "");
КонецФункции

Функция Заказ(УчетнаяЗапись, Ссылка, Запись = Ложь)
    Объект = Ссылка.ПолучитьОбъект();
    Если Объект = Неопределено Тогда ВызватьИсключение "кабинет_документ_не_найдено"; КонецЕсли;
    Блокировать("Справочник.РабочиеПространства", Объект.РабочееПространство);
    Блокировать("Справочник.Области", Объект.Область);
    Блокировать("Справочник.ЗаказыЛаборатории", Ссылка); Объект = Ссылка.ПолучитьОбъект();
    Если Объект.ПометкаУдаления Или Объект.УчетнаяЗаписьВладельца <> УчетнаяЗапись
        Или Объект.РабочееПространство.ПометкаУдаления Или Объект.РабочееПространство.Состояние <> "Active"
        Или Объект.Область.ПометкаУдаления Или Объект.Область.Состояние <> "Active"
        Или Объект.Область.РабочееПространство <> Объект.РабочееПространство Тогда ВызватьИсключение "кабинет_документ_не_найдено"; КонецЕсли;
    Если Запись Тогда
        ПолитикаДоступа.ПроверитьДоступКРабочемуПространству(УчетнаяЗапись, ИДс(Объект.РабочееПространство));
        Если Объект.Состояние = "Cancelled" Тогда ВызватьИсключение "кабинет_документ_состояние_конфликт"; КонецЕсли;
    КонецЕсли;
    Возврат Объект;
КонецФункции

Функция Документ(УчетнаяЗапись, Идентификатор, Запись = Ложь, РазрешитьУдаленный = Ложь)
    Ссылка = Справочники.ДокументыКабинета.ПолучитьСсылку(ИД(Идентификатор)); Объект = Ссылка.ПолучитьОбъект();
    Если Объект = Неопределено Тогда ВызватьИсключение "кабинет_документ_не_найдено"; КонецЕсли;
    Родитель = Заказ(УчетнаяЗапись, Объект.ЗаказЛаборатории, Запись);
    Блокировать("Справочник.ДокументыКабинета", Ссылка); Объект = Ссылка.ПолучитьОбъект();
    Если Объект.ПометкаУдаления Или (Объект.Состояние = "Deleted" И Не РазрешитьУдаленный) Или Объект.УчетнаяЗаписьВладельца <> УчетнаяЗапись
        Или Объект.ЗаказЛаборатории <> Родитель.Ссылка Или Объект.РабочееПространство <> Родитель.РабочееПространство
        Или Объект.Область <> Родитель.Область Или Объект.ВидПоля <> "labOrderAttachment" Тогда ВызватьИсключение "кабинет_документ_не_найдено"; КонецЕсли;
    Если Запись И Объект.Состояние = "Archived" Тогда ВызватьИсключение "кабинет_документ_состояние_конфликт"; КонецЕсли;
    Возврат Объект;
КонецФункции

Функция ВерсияДокумента(Объект, Версия = 0)
    Целое(Версия, 0, 100);
    Если Версия = 0 Тогда Версия = Объект.Ревизия; КонецЕсли;
    З = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2 Ссылка ИЗ Справочник.ВерсииДокументовКабинета ГДЕ Документ = &Документ И Версия = &Версия");
    З.УстановитьПараметр("Документ", Объект.Ссылка); З.УстановитьПараметр("Версия", Версия); В = З.Выполнить().Выбрать();
    Если Не В.Следующий() Тогда ВызватьИсключение "кабинет_документ_не_найдено"; КонецЕсли;
    Р = В.Ссылка.ПолучитьОбъект();
    Если В.Следующий() Или Р.ПометкаУдаления Или Р.УчетнаяЗаписьВладельца <> Объект.УчетнаяЗаписьВладельца
        Или Р.ЗаказЛаборатории <> Объект.ЗаказЛаборатории Или Р.РабочееПространство <> Объект.РабочееПространство
        Или Р.Область <> Объект.Область Или (Версия = Объект.Ревизия И Р.Ссылка <> Объект.ТекущаяВерсия) Тогда ВызватьИсключение "кабинет_документ_целостность_конфликт"; КонецЕсли;
    Возврат Р;
КонецФункции

Функция Метаданные(Объект, Версия)
    Возврат Новый Структура("id,kind,objectType,objectId,ownerAccountId,workspaceId,areaId,state,version,revision,revisionId,previousRevisionId,filename,mime,byteCount,sha256,createdAt,reason",
        ИДс(Объект.Ссылка), "incoming", "labOrder", ИДс(Объект.ЗаказЛаборатории), ИДс(Объект.УчетнаяЗаписьВладельца),
        ИДс(Объект.РабочееПространство), ИДс(Объект.Область), Объект.Состояние, Версия.Версия, Версия.Версия, ИДс(Версия.Ссылка), ИДс(Версия.ПредыдущаяВерсия),
        Версия.ИмяФайла, Версия.ТипMIME, Версия.КоличествоБайт, Версия.ХешSHA256, СтрокаДатыUTC(Версия.ДатаСоздания), Версия.Причина);
КонецФункции

Процедура НормализоватьВерсиюКоманды(Тело)
    Если ТипЗнч(Тело) <> Тип("Структура") Тогда ВызватьИсключение "кабинет_документ_некорректно_поле"; КонецЕсли;
    Если Тело.Свойство("expectedVersion") Тогда
        Если Тело.Свойство("expectedRevision") Тогда ВызватьИсключение "кабинет_документ_некорректно_поле"; КонецЕсли;
        Тело.Вставить("expectedRevision", Тело.expectedVersion); Тело.Удалить("expectedVersion");
    КонецЕсли;
КонецПроцедуры

Функция Команда(УчетнаяЗапись, Ключ, Намерение)
    Ключ = Строка(ИД(Ключ)); Б = Новый БлокировкаДанных; Э = Б.Добавить("РегистрСведений.КомандыДокументовКабинета");
    Э.УстановитьЗначение("УчетнаяЗапись", УчетнаяЗапись); Э.УстановитьЗначение("ИдентификаторЗапроса", Ключ);
    Э.Режим = РежимБлокировкиДанных.Исключительный; Б.Заблокировать();
    К = РегистрыСведений.КомандыДокументовКабинета.СоздатьМенеджерЗаписи(); К.УчетнаяЗапись = УчетнаяЗапись; К.ИдентификаторЗапроса = Ключ; К.Прочитать();
    Если К.Выбран() И К.НамерениеJSON <> Намерение Тогда ВызватьИсключение "кабинет_документ_запрос_конфликт"; КонецЕсли;
    К.УчетнаяЗапись = УчетнаяЗапись; К.ИдентификаторЗапроса = Ключ; К.НамерениеJSON = Намерение; Возврат К;
КонецФункции

Процедура Квота(Родитель, Байты, НовыйДокумент)
    Контекст = Новый Структура("РабочееПространство,Область", Родитель.РабочееПространство, Родитель.Область);
    СервисФайлов.ПроверитьОбщуюКвотуВложений(Контекст, Байты);
    З = Новый Запрос("ВЫБРАТЬ ЕСТЬNULL(СУММА(КоличествоБайт), 0) КАК Байты ИЗ Справочник.ВерсииДокументовКабинета ГДЕ ЗаказЛаборатории = &Заказ");
    З.УстановитьПараметр("Заказ", Родитель.Ссылка); В = З.Выполнить().Выбрать();
    Если Не В.Следующий() Или В.Байты + Байты > 20971520 Тогда ВызватьИсключение "кабинет_документ_квота_превышено"; КонецЕсли;
    Если НовыйДокумент Тогда
        З.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Справочник.ДокументыКабинета ГДЕ ЗаказЛаборатории = &Заказ";
        В = З.Выполнить().Выбрать(); Если Не В.Следующий() Или В.Количество >= 100 Тогда ВызватьИсключение "кабинет_документ_квота_превышено"; КонецЕсли;
    КонецЕсли;
КонецПроцедуры

Функция ЗагрузитьДокумент(УчетнаяЗапись, Тело, Ключ, Идентификатор = "") Экспорт
    Актер(УчетнаяЗапись);
    Если Идентификатор = "" Тогда Поля(Тело, "objectType,objectId,field,filename,mime,contentBase64");
    Иначе НормализоватьВерсиюКоманды(Тело); Поля(Тело, "expectedRevision,reason,filename,mime,contentBase64"); КонецЕсли;
    Вход = СервисФайлов.ПроверитьБайтыВложения(Новый Структура("filename,mime,contentBase64", Тело.filename, Тело.mime, Тело.contentBase64));
    Причина = "Первое вложение"; Ожидаемая = 0;
    Если Идентификатор <> "" Тогда Причина = Текст(Тело.reason, 250); Ожидаемая = Целое(Тело.expectedRevision, 1, 99);
    ИначеЕсли Тело.objectType <> "labOrder" Или Тело.field <> "labOrderAttachment" Тогда ВызватьИсключение "кабинет_документ_некорректно_поле"; КонецЕсли;
    Начать(УчетнаяЗапись);
    Попытка
        Если Идентификатор = "" Тогда
            Родитель = Заказ(УчетнаяЗапись, Справочники.ЗаказыЛаборатории.ПолучитьСсылку(ИД(Тело.objectId)), Истина); Объект = Неопределено;
        Иначе
            Объект = Документ(УчетнаяЗапись, Идентификатор, Ложь, Истина); Родитель = Заказ(УчетнаяЗапись, Объект.ЗаказЛаборатории, Истина);
        КонецЕсли;
        Намерение = JSON(Новый Структура("operation,objectId,id,filename,mime,sha256,bytes,revision,reason", "upload", ИДс(Родитель.Ссылка), Идентификатор,
            Вход.ИмяФайла, Вход.ТипMIME, Вход.Содержимое.ХешSHA256, Вход.Содержимое.КоличествоБайт, Ожидаемая, Причина));
        К = Команда(УчетнаяЗапись, Ключ, Намерение);
        Если К.Выбран() Тогда
            Документ(УчетнаяЗапись, ИДс(К.Документ), Ложь, Истина); Результат = ИзJSON(К.РезультатJSON);
        Иначе
            Если Объект <> Неопределено И Объект.Состояние <> "Draft" И Объект.Состояние <> "Submitted" Тогда ВызватьИсключение "кабинет_документ_состояние_конфликт"; КонецЕсли;
            Если Объект <> Неопределено И Объект.Ревизия <> Ожидаемая Тогда ВызватьИсключение "кабинет_документ_редакция_конфликт"; КонецЕсли;
            Квота(Родитель, Вход.Содержимое.КоличествоБайт, Объект = Неопределено);
            Если Объект = Неопределено Тогда
                Объект = Справочники.ДокументыКабинета.СоздатьЭлемент();
                Объект.SetNewObjectRef(Справочники.ДокументыКабинета.ПолучитьСсылку(НовыйUUIDv4())); Объект.Наименование = "Входящее приложение к заказу лаборатории";
                Объект.РабочееПространство = Родитель.РабочееПространство; Объект.Область = Родитель.Область;
                Объект.УчетнаяЗаписьВладельца = УчетнаяЗапись; Объект.ЗаказЛаборатории = Родитель.Ссылка; Объект.ВидПоля = "labOrderAttachment";
                Объект.Состояние = "Draft"; Объект.ДатаСоздания = ТекущаяУниверсальнаяДата(); Объект.Ревизия = 0; Объект.Записать();
            КонецЕсли;
            Версия = Справочники.ВерсииДокументовКабинета.СоздатьЭлемент();
            Версия.SetNewObjectRef(Справочники.ВерсииДокументовКабинета.ПолучитьСсылку(НовыйUUIDv4())); Версия.Наименование = "Редакция входящего приложения";
            Версия.Документ = Объект.Ссылка; Версия.РабочееПространство = Родитель.РабочееПространство; Версия.Область = Родитель.Область;
            Версия.ЗаказЛаборатории = Родитель.Ссылка; Версия.УчетнаяЗаписьВладельца = УчетнаяЗапись; Версия.Версия = Объект.Ревизия + 1;
            Версия.ПредыдущаяВерсия = Объект.ТекущаяВерсия; Версия.ИмяФайла = Вход.ИмяФайла; Версия.ТипMIME = Вход.ТипMIME;
            Версия.КоличествоБайт = Вход.Содержимое.КоличествоБайт; Версия.ХешSHA256 = Вход.Содержимое.ХешSHA256;
            Версия.ДанныеФайла = Новый ХранилищеЗначения(Вход.Содержимое.Данные); Версия.Причина = Причина; Версия.ДатаСоздания = ТекущаяУниверсальнаяДата(); Версия.Записать();
            Объект.ТекущаяВерсия = Версия.Ссылка; Объект.Ревизия = Версия.Версия; Объект.ДатаИзменения = Версия.ДатаСоздания; Объект.Записать();
            Результат = Метаданные(Объект, Версия); К.Документ = Объект.Ссылка; К.РезультатJSON = JSON(Результат); К.Записать();
            ПолитикаДоступа.ЗаписатьСобытиеАудита(УчетнаяЗапись, Родитель.РабочееПространство, "documents.upload", ИДс(Объект.Ссылка));
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение Откат(); ВызватьИсключение; КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ИзменитьСостояниеДокумента(УчетнаяЗапись, Идентификатор, Действие, Тело, Ключ) Экспорт
    НормализоватьВерсиюКоманды(Тело); Поля(Тело, "expectedRevision,reason"); Ревизия = Целое(Тело.expectedRevision, 1, 100); Причина = Текст(Тело.reason, 250);
    Если СтрРазделить("submit,archive,delete", ",").Найти(Действие) = Неопределено Тогда ВызватьИсключение "кабинет_документ_некорректно_поле"; КонецЕсли;
    Начать(УчетнаяЗапись);
    Попытка
        Объект = Документ(УчетнаяЗапись, Идентификатор, Ложь, Истина);
        К = Команда(УчетнаяЗапись, Ключ, JSON(Новый Структура("operation,id,revision,reason", Действие, Идентификатор, Ревизия, Причина)));
        Если К.Выбран() Тогда Результат = ИзJSON(К.РезультатJSON);
        Иначе
            Заказ(УчетнаяЗапись, Объект.ЗаказЛаборатории, Истина);
            Если Объект.Состояние = "Deleted" Или Объект.Состояние = "Archived" Тогда ВызватьИсключение "кабинет_документ_состояние_конфликт"; КонецЕсли;
            Если Объект.Ревизия <> Ревизия Тогда ВызватьИсключение "кабинет_документ_редакция_конфликт"; КонецЕсли;
            Если (Действие = "delete" Или Действие = "submit") И Объект.Состояние <> "Draft" Тогда ВызватьИсключение "кабинет_документ_состояние_конфликт"; КонецЕсли;
            Если Действие = "archive" И Объект.Состояние <> "Submitted" Тогда ВызватьИсключение "кабинет_документ_состояние_конфликт"; КонецЕсли;
            Объект.Состояние = ?(Действие = "delete", "Deleted", ?(Действие = "archive", "Archived", "Submitted"));
            Объект.ДатаИзменения = ТекущаяУниверсальнаяДата(); Объект.ПричинаСостояния = Причина; Объект.Записать();
            Результат = Метаданные(Объект, ВерсияДокумента(Объект)); К.Документ = Объект.Ссылка; К.РезультатJSON = JSON(Результат); К.Записать();
            ПолитикаДоступа.ЗаписатьСобытиеАудита(УчетнаяЗапись, Объект.РабочееПространство, "documents." + Действие, Идентификатор);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение Откат(); ВызватьИсключение; КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПолучитьДокумент(УчетнаяЗапись, Идентификатор) Экспорт
    Начать(УчетнаяЗапись);
    Попытка
        Объект = Документ(УчетнаяЗапись, Идентификатор); Версии = Новый Массив;
        Для Номер = 1 По Объект.Ревизия Цикл Версии.Добавить(Метаданные(Объект, ВерсияДокумента(Объект, Номер))); КонецЦикла;
        Результат = Новый Структура("document,versions", Метаданные(Объект, ВерсияДокумента(Объект)), Версии); ЗафиксироватьТранзакцию();
    Исключение Откат(); ВызватьИсключение; КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СкачатьДокумент(УчетнаяЗапись, Идентификатор, Версия = 0) Экспорт
    Начать(УчетнаяЗапись);
    Попытка
        Объект = Документ(УчетнаяЗапись, Идентификатор); Р = ВерсияДокумента(Объект, Версия); Данные = Р.ДанныеФайла.Получить();
        ПроверитьБайты(Данные, Р.КоличествоБайт, Р.ХешSHA256);
        Результат = Новый Структура("binary,mime,filename", Данные, Р.ТипMIME, Р.ИмяФайла); ЗафиксироватьТранзакцию();
    Исключение Откат(); ВызватьИсключение; КонецПопытки;
    Возврат Результат;
КонецФункции

Процедура ПроверитьБайты(Данные, Размер, ХешСодержимого)
    Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда ВызватьИсключение "кабинет_документ_целостность_конфликт"; КонецЕсли;
    Если Данные.Размер() <> Размер Или Хеш(Данные) <> ХешСодержимого Тогда ВызватьИсключение "кабинет_документ_целостность_конфликт"; КонецЕсли;
КонецПроцедуры

Процедура ПроверитьНативнуюВерсию(Объект) Экспорт
    Если Не ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_документ_вложенная_транзакция"; КонецЕсли;
    Актер(Объект.УчетнаяЗаписьВладельца); Родитель = Заказ(Объект.УчетнаяЗаписьВладельца, Объект.ЗаказЛаборатории, Истина);
    Данные = Объект.ДанныеФайла.Получить(); ПроверитьБайты(Данные, Объект.КоличествоБайт, Объект.ХешSHA256);
    Кодированный = СтрЗаменить(СтрЗаменить(Base64Строка(Данные), Символ(13), ""), Символ(10), "");
    СервисФайлов.ПроверитьБайтыВложения(Новый Структура("filename,mime,contentBase64", Объект.ИмяФайла, Объект.ТипMIME, Кодированный));
    Квота(Родитель, Объект.КоличествоБайт, Ложь);
КонецПроцедуры

Функция ПараметрыСписка(Параметры)
    Поля(Параметры, "", "kind,from,to,objectId,state,limit,cursor");
    Р = Новый Структура("kind,from,to,objectId,state,limit,cursor", "", "", "", "", "", "25", "");
    Для Каждого П Из Параметры Цикл Р.Вставить(П.Ключ, Текст(П.Значение, 120, Истина)); КонецЦикла;
    Если СтрРазделить(",incoming,request,export", ",", Истина).Найти(Р.kind) = Неопределено Тогда ВызватьИсключение "кабинет_документ_некорректно_поле"; КонецЕсли;
    Если СтрРазделить(",Draft,Submitted,Archived,Active,Ready", ",", Истина).Найти(Р.state) = Неопределено Тогда ВызватьИсключение "кабинет_документ_некорректно_поле"; КонецЕсли;
    Если Р.objectId <> "" Тогда ИД(Р.objectId); КонецЕсли;
    Если Р.limit = "" Тогда Р.limit = "25"; КонецЕсли;
    Если СтрДлина(Р.limit) > 3 Тогда ВызватьИсключение "кабинет_документ_некорректно_поле"; КонецЕсли;
    Для П = 1 По СтрДлина(Р.limit) Цикл Если СтрНайти("0123456789", Сред(Р.limit, П, 1)) = 0 Тогда ВызватьИсключение "кабинет_документ_некорректно_поле"; КонецЕсли; КонецЦикла;
    Р.limit = Целое(Число(Р.limit), 1, 100);
    Р.Вставить("start", Дата(2000, 1, 1)); Р.Вставить("end", Дата(3999, 1, 1));
    Если Р.from <> "" Тогда Р.start = ДеньФильтра(Р.from); КонецЕсли;
    Если Р.to <> "" Тогда Р.end = ДеньФильтра(Р.to) + 86400; КонецЕсли;
    Если Р.start >= Р.end Тогда ВызватьИсключение "кабинет_документ_некорректно_поле"; КонецЕсли;
    Р.Вставить("cursorKind", "incoming"); Р.Вставить("cursorId", "");
    Если Р.cursor <> "" Тогда
        Части = СтрРазделить(Р.cursor, "|", Истина);
        Если Части.Количество() <> 2 Тогда ВызватьИсключение "кабинет_документ_некорректно_поле"; КонецЕсли;
        Если СтрРазделить("incoming,request,export", ",").Найти(Части[0]) = Неопределено Тогда ВызватьИсключение "кабинет_документ_некорректно_поле"; КонецЕсли;
        ИД(Части[1]); Р.cursorKind = Части[0]; Р.cursorId = Части[1];
    КонецЕсли;
    Возврат Р;
КонецФункции

Функция ДеньФильтра(Значение)
    Если СтрДлина(Значение) <> 10 Тогда ВызватьИсключение "кабинет_документ_некорректно_поле"; КонецЕсли;
    Попытка Д = XMLЗначение(Тип("Дата"), Значение + "T00:00:00"); Исключение ВызватьИсключение "кабинет_документ_некорректно_поле"; КонецПопытки;
    Если Лев(XMLСтрока(Д), 10) <> Значение Тогда ВызватьИсключение "кабинет_документ_некорректно_поле"; КонецЕсли;
    Возврат Д;
КонецФункции

Функция МоиДокументы(УчетнаяЗапись, Параметры) Экспорт
    Актер(УчетнаяЗапись); П = ПараметрыСписка(Параметры); Элементы = Новый Массив; Еще = Ложь; Последний = "";
    Виды = СтрРазделить("incoming,request,export", ","); Старт = Виды.Найти(П.cursorKind);
    Для Индекс = Старт По Виды.Количество() - 1 Цикл
        Вид = Виды[Индекс]; Если П.kind <> "" И П.kind <> Вид Тогда Продолжить; КонецЕсли;
        Если Вид = "incoming" Тогда
            Менеджер = Справочники.ДокументыКабинета;
            ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 101 Ссылка ИЗ Справочник.ДокументыКабинета ГДЕ УчетнаяЗаписьВладельца = &УчетнаяЗапись
                |И НЕ ПометкаУдаления И Состояние <> &Удалено И Ссылка > &После И ДатаСоздания >= &Начало И ДатаСоздания < &Конец
                |И (&ВсеСостояния ИЛИ Состояние = &Состояние) И (&ВсеОбъекты ИЛИ ЗаказЛаборатории = &Объект) УПОРЯДОЧИТЬ ПО Ссылка";
        ИначеЕсли Вид = "request" Тогда
            Менеджер = Справочники.ФайлыОбращений;
            ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 101 Ссылка ИЗ Справочник.ФайлыОбращений ГДЕ РодительскоеОбращение.Заявитель = &УчетнаяЗапись
                |И Видимость = &Общая И НЕ ПометкаУдаления И Ссылка > &После И ДатаСоздания >= &Начало И ДатаСоздания < &Конец
                |И (&ВсеСостояния ИЛИ Состояние = &Состояние) И (&ВсеОбъекты ИЛИ РодительскоеОбращение = &Объект) УПОРЯДОЧИТЬ ПО Ссылка";
        Иначе
            Менеджер = Справочники.СохраненныеЭкспорты;
            ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 101 Ссылка ИЗ Справочник.СохраненныеЭкспорты ГДЕ УчетнаяЗаписьВладельца = &УчетнаяЗапись
                |И НЕ ПометкаУдаления И Ссылка > &После И ДоступенДо > &Сейчас И Состояние = &Готово
                |И ДатаСоздания >= &Начало И ДатаСоздания < &Конец И (&ВсеСостояния ИЛИ Состояние = &Состояние)
                |И (&ВсеОбъекты ИЛИ ИдентификаторОбъекта = &ИдентификаторОбъекта) УПОРЯДОЧИТЬ ПО Ссылка";
        КонецЕсли;
        После = Менеджер.ПустаяСсылка(); Если Индекс = Старт И П.cursorId <> "" Тогда После = Менеджер.ПолучитьСсылку(ИД(П.cursorId)); КонецЕсли;
        З = Новый Запрос(ТекстЗапроса); З.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись); З.УстановитьПараметр("После", После);
        З.УстановитьПараметр("Начало", П.start); З.УстановитьПараметр("Конец", П.end); З.УстановитьПараметр("ВсеСостояния", П.state = ""); З.УстановитьПараметр("Состояние", П.state);
        З.УстановитьПараметр("ВсеОбъекты", П.objectId = ""); З.УстановитьПараметр("Удалено", "Deleted"); З.УстановитьПараметр("Общая", "Public");
        З.УстановитьПараметр("Сейчас", ТекущаяУниверсальнаяДата()); З.УстановитьПараметр("Готово", "Ready"); З.УстановитьПараметр("ИдентификаторОбъекта", П.objectId);
        Если Вид = "incoming" Тогда Родитель = Справочники.ЗаказыЛаборатории.ПустаяСсылка();
        Иначе Родитель = Справочники.ОбращенияДиспетчерской.ПустаяСсылка(); КонецЕсли;
        Если П.objectId <> "" И Вид <> "export" Тогда
            Если Вид = "incoming" Тогда Родитель = Справочники.ЗаказыЛаборатории.ПолучитьСсылку(ИД(П.objectId)); Иначе Родитель = Справочники.ОбращенияДиспетчерской.ПолучитьСсылку(ИД(П.objectId)); КонецЕсли;
        КонецЕсли;
        З.УстановитьПараметр("Объект", Родитель); В = З.Выполнить().Выбрать();
        Пока В.Следующий() Цикл
            Если Элементы.Количество() = П.limit Тогда Еще = Истина; Прервать; КонецЕсли;
            Если Вид = "incoming" Тогда Данные = ПолучитьДокумент(УчетнаяЗапись, ИДс(В.Ссылка)).document;
            ИначеЕсли Вид = "request" Тогда
                Ф = СервисФайлов.ПолучитьВложениеОбращения(УчетнаяЗапись, ИДс(В.Ссылка)).file; О = В.Ссылка.ПолучитьОбъект();
                Данные = Новый Структура("id,kind,objectType,objectId,ownerAccountId,workspaceId,areaId,state,version,revision,revisionId,previousRevisionId,filename,mime,byteCount,sha256,createdAt,reason",
                    Ф.id, "request", "request", Ф.parentRequestId, ИДс(УчетнаяЗапись), ИДс(О.РабочееПространство), ИДс(О.Область), О.Состояние,
                    Ф.version, Ф.version, Ф.revisionId, Ф.previousRevisionId, Ф.filename, Ф.mime, Ф.byteCount, Ф.sha256, Ф.createdAt, Ф.reason);
            Иначе Данные = МетаданныеЭкспорта(В.Ссылка.ПолучитьОбъект()); КонецЕсли;
            Элементы.Добавить(Данные); Последний = Вид + "|" + ИДс(В.Ссылка);
        КонецЦикла;
        Если Еще Тогда Прервать; КонецЕсли;
    КонецЦикла;
    Возврат Новый Структура("items,limit,hasMore,nextCursor,snapshotAt", Элементы, П.limit, Еще, ?(Еще, Последний, ""), СтрокаДатыUTC(ТекущаяУниверсальнаяДата()));
КонецФункции

Функция МетаданныеЭкспорта(Объект)
    Возврат Новый Структура("id,kind,objectType,objectId,ownerAccountId,workspaceId,areaId,state,version,revision,revisionId,previousRevisionId,filename,mime,byteCount,sha256,createdAt,reason,expiresAt,sourceKind",
        ИДс(Объект.Ссылка), "export", Объект.ВидИсточника, Объект.ИдентификаторОбъекта, ИДс(Объект.УчетнаяЗаписьВладельца), ИДс(Объект.РабочееПространство), ИДс(Объект.Область), Объект.Состояние,
        1, 1, ИДс(Объект.Ссылка), "", Объект.ИмяФайла, Объект.ТипMIME, Объект.КоличествоБайт, Объект.ХешSHA256, СтрокаДатыUTC(Объект.ДатаСоздания), "Учебный исходящий документ", СтрокаДатыUTC(Объект.ДоступенДо), Объект.ВидИсточника);
КонецФункции

Функция ПроверитьПараметрыИсточника(Вид, П, Формат)
    Если Формат <> "pdf" И Формат <> "csv" Тогда ВызватьИсключение "кабинет_документ_некорректно_поле"; КонецЕсли;
    Если Вид = "labProtocol" Или Вид = "workAppendix" Тогда
        Поля(П, "id,version"); ИД(П.id); Целое(П.version, 0, 1000);
        Если Вид = "workAppendix" И Формат <> "pdf" Тогда ВызватьИсключение "кабинет_документ_некорректно_поле"; КонецЕсли;
    ИначеЕсли Вид = "workOrder" Или Вид = "workAct" Тогда
        Поля(П, "id"); ИД(П.id); Если Формат <> "pdf" Тогда ВызватьИсключение "кабинет_документ_некорректно_поле"; КонецЕсли;
    ИначеЕсли Вид = "subscriberRegistry" Тогда
        Поля(П, "workspaceId,areaId,resource,state,search"); ИД(П.workspaceId); ИД(П.areaId); Текст(П.resource, 32); Текст(П.state, 32, Истина); Текст(П.search, 150, Истина);
        Если Формат <> "csv" Тогда ВызватьИсключение "кабинет_документ_некорректно_поле"; КонецЕсли;
    ИначеЕсли Вид = "documentRegistry" Тогда ПараметрыСписка(П);
    Иначе ВызватьИсключение "кабинет_документ_некорректно_поле"; КонецЕсли;
    Возврат П;
КонецФункции

Функция СоздатьЭкспорт(УчетнаяЗапись, Тело, Ключ) Экспорт
    Актер(УчетнаяЗапись); Поля(Тело, "sourceKind,parameters,format"); Вид = Текст(Тело.sourceKind, 32); Формат = Текст(Тело.format, 8);
    П = ПроверитьПараметрыИсточника(Вид, Тело.parameters, Формат); Ключ = Строка(ИД(Ключ)); Намерение = JSON(Тело);
    З = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2 Ссылка ИЗ Справочник.СохраненныеЭкспорты ГДЕ УчетнаяЗаписьВладельца = &УчетнаяЗапись И КлючЗапроса = &Ключ");
    З.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись); З.УстановитьПараметр("Ключ", Ключ); В = З.Выполнить().Выбрать();
    Если В.Следующий() Тогда
        О = В.Ссылка.ПолучитьОбъект(); Если В.Следующий() Или О.НамерениеJSON <> Намерение Тогда ВызватьИсключение "кабинет_документ_запрос_конфликт"; КонецЕсли;
        Если О.Состояние <> "Ready" Или О.ДоступенДо <= ТекущаяУниверсальнаяДата() Тогда ВызватьИсключение "кабинет_документ_экспорт_истекло"; КонецЕсли;
        ПроверитьИсточник(УчетнаяЗапись, О.ВидИсточника, ИзJSON(О.ПараметрыИсточникаJSON), О.Формат, О.ИсточникиJSON);
        Возврат МетаданныеЭкспорта(О);
    КонецЕсли;
    ОбластиЭкспорта = ОбластиДляЭкспорта(УчетнаяЗапись, Вид, П, Формат);
    СобственныйДопуск = Истина;
    ДопускТяжелогоЗадания = ОграниченияТяжелыхЗаданий.Начать(УчетнаяЗапись, ?(Вид = "workOrder" Или Вид = "workAct", "workPrint", Вид), ОбластиЭкспорта);
    Попытка
        Результат = СоздатьЭкспортБезЛимита(УчетнаяЗапись, Тело, Ключ, ДопускТяжелогоЗадания, ОбластиЭкспорта);
    Исключение
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
        Если СобственныйДопуск Тогда ОграниченияТяжелыхЗаданий.Завершить(УчетнаяЗапись, ДопускТяжелогоЗадания); КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
    Если СобственныйДопуск Тогда ОграниченияТяжелыхЗаданий.Завершить(УчетнаяЗапись, ДопускТяжелогоЗадания); КонецЕсли;
    Возврат Результат;
КонецФункции

Функция СоздатьЭкспортБезЛимита(УчетнаяЗапись, Тело, Ключ, ДопускТяжелогоЗадания, ОбластиЭкспорта)
    Актер(УчетнаяЗапись); Поля(Тело, "sourceKind,parameters,format"); Вид = Текст(Тело.sourceKind, 32); Формат = Текст(Тело.format, 8);
    П = ПроверитьПараметрыИсточника(Вид, Тело.parameters, Формат); Ключ = Строка(ИД(Ключ)); Намерение = JSON(Тело);
    З = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2 Ссылка ИЗ Справочник.СохраненныеЭкспорты ГДЕ УчетнаяЗаписьВладельца = &УчетнаяЗапись И КлючЗапроса = &Ключ");
    З.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись); З.УстановитьПараметр("Ключ", Ключ); В = З.Выполнить().Выбрать();
    Если В.Следующий() Тогда
        О = В.Ссылка.ПолучитьОбъект(); Если В.Следующий() Или О.НамерениеJSON <> Намерение Тогда ВызватьИсключение "кабинет_документ_запрос_конфликт"; КонецЕсли;
        Если О.Состояние <> "Ready" Или О.ДоступенДо <= ТекущаяУниверсальнаяДата() Тогда ВызватьИсключение "кабинет_документ_экспорт_истекло"; КонецЕсли;
        ПроверитьИсточник(УчетнаяЗапись, О.ВидИсточника, ИзJSON(О.ПараметрыИсточникаJSON), О.Формат, О.ИсточникиJSON);
        Возврат МетаданныеЭкспорта(О);
    КонецЕсли;
    Если Вид = "labProtocol" Тогда
        Протокол = СервисЛаборатории.ПолучитьПротокол(УчетнаяЗапись, П.id, П.version, "owner"); П.version = Протокол.version;
        Если Формат = "pdf" Тогда Файл = СервисЛаборатории.СформироватьПротоколPDF(УчетнаяЗапись, П.id, П.version, "owner", ДопускТяжелогоЗадания);
        Иначе Файл = СервисЛаборатории.ЭкспортПротоколаCSV(УчетнаяЗапись, П.id, П.version, "owner", ДопускТяжелогоЗадания); КонецЕсли;
    ИначеЕсли Вид = "workAppendix" Тогда
        Приложение = СервисНарядов.ПолучитьПриложениеНаряда(УчетнаяЗапись, П.id, П.version); П.version = Приложение.version;
        Файл = СервисНарядов.ЭкспортПриложенияНаряда(УчетнаяЗапись, П.id, П.version, ДопускТяжелогоЗадания);
    ИначеЕсли Вид = "workOrder" Или Вид = "workAct" Тогда
        Файл = СервисНарядов.ПечатныйНаряд(УчетнаяЗапись, П.id, ?(Вид = "workOrder", "order", "act"), ДопускТяжелогоЗадания);
    ИначеЕсли Вид = "subscriberRegistry" Тогда
        Файл = РеестрАбонентов.ВыгрузитьРеестр(УчетнаяЗапись, П.workspaceId, П.areaId, П.resource, П.state, П.search, ДопускТяжелогоЗадания);
    Иначе Файл = ЭкспортРеестраДокументов(УчетнаяЗапись, П, Формат, ДопускТяжелогоЗадания); КонецЕсли;
    Если Формат = "csv" Тогда Данные = ПолучитьДвоичныеДанныеИзСтроки(Файл.csv, КодировкаТекста.UTF8); Имя = Файл.filename;
    ИначеЕсли Вид = "workOrder" Или Вид = "workAct" Или Вид = "workAppendix" Тогда
        Данные = Файл.binary; Имя = Файл.filename;
    Иначе Данные = Файл.Данные; Имя = Файл.ИмяФайла; КонецЕсли;
    Если Данные.Размер() < 1 Или Данные.Размер() > 5242880 Тогда ВызватьИсключение "кабинет_документ_экспорт_слишком_большое"; КонецЕсли;
    Начать(УчетнаяЗапись);
    Попытка
        З = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2 Ссылка ИЗ Справочник.СохраненныеЭкспорты ГДЕ УчетнаяЗаписьВладельца = &УчетнаяЗапись И КлючЗапроса = &Ключ");
        З.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись); З.УстановитьПараметр("Ключ", Ключ); В = З.Выполнить().Выбрать();
        Если В.Следующий() Тогда
            О = В.Ссылка.ПолучитьОбъект(); Если В.Следующий() Или О.НамерениеJSON <> Намерение Тогда ВызватьИсключение "кабинет_документ_запрос_конфликт"; КонецЕсли;
            Если О.Состояние <> "Ready" Или О.ДоступенДо <= ТекущаяУниверсальнаяДата() Тогда ВызватьИсключение "кабинет_документ_экспорт_истекло"; КонецЕсли;
            Результат = МетаданныеЭкспорта(О); ЗафиксироватьТранзакцию(); Возврат Результат;
        КонецЕсли;
        Сейчас = ТекущаяУниверсальнаяДата(); З = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество, ЕСТЬNULL(СУММА(КоличествоБайт), 0) КАК Байты
            |ИЗ Справочник.СохраненныеЭкспорты ГДЕ УчетнаяЗаписьВладельца = &УчетнаяЗапись И Состояние = &Готово");
        З.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись); З.УстановитьПараметр("Готово", "Ready"); В = З.Выполнить().Выбрать();
        Если Не В.Следующий() Или В.Количество >= 100 Или В.Байты + Данные.Размер() > 20971520 Тогда ВызватьИсключение "кабинет_документ_квота_превышено"; КонецЕсли;
        О = Справочники.СохраненныеЭкспорты.СоздатьЭлемент();
        О.SetNewObjectRef(Справочники.СохраненныеЭкспорты.ПолучитьСсылку(НовыйUUIDv4())); О.Наименование = "Учебный временный экспорт"; О.УчетнаяЗаписьВладельца = УчетнаяЗапись;
        О.ВидИсточника = Вид; О.ПараметрыИсточникаJSON = JSON(П); О.Формат = Формат; О.ДатаСоздания = Сейчас; О.ДоступенДо = Сейчас + 86400;
        О.КлючЗапроса = Ключ; О.НамерениеJSON = Намерение;
        Источники = Новый Массив; Если Не Файл.Свойство("sources", Источники) Тогда Источники = Новый Массив; КонецЕсли; О.ИсточникиJSON = JSON(Источники);
        О.ИмяФайла = Имя; О.ТипMIME = ?(Формат = "pdf", "application/pdf", "text/csv"); О.КоличествоБайт = Данные.Размер(); О.ХешSHA256 = Хеш(Данные);
        О.ДанныеФайла = Новый ХранилищеЗначения(Данные); О.Состояние = "Ready";
        ОбъектИд = ""; Если Не П.Свойство("id", ОбъектИд) Тогда ОбъектИд = ""; КонецЕсли; О.ИдентификаторОбъекта = ОбъектИд;
        Версия = 0; Если Не П.Свойство("version", Версия) Тогда Версия = 0; КонецЕсли; О.ВерсияИсточника = Версия;
        Если Вид = "labProtocol" Тогда ИсточникОбъект = Справочники.ПробыЛаборатории.ПолучитьСсылку(ИД(П.id)); О.РабочееПространство = ИсточникОбъект.РабочееПространство; О.Область = ИсточникОбъект.Область;
        ИначеЕсли Вид = "workOrder" Или Вид = "workAct" Или Вид = "workAppendix" Тогда ИсточникОбъект = Справочники.Наряды.ПолучитьСсылку(ИД(П.id)); О.РабочееПространство = ИсточникОбъект.РабочееПространство; О.Область = ИсточникОбъект.Область;
        ИначеЕсли Вид = "subscriberRegistry" Тогда О.РабочееПространство = Справочники.РабочиеПространства.ПолучитьСсылку(ИД(П.workspaceId)); О.Область = Справочники.Области.ПолучитьСсылку(ИД(П.areaId)); КонецЕсли;
        ПроверитьКвотуОбъектовЭкспорта(ОбластиЭкспорта);
        О.Записать(); СохранитьОбластиЭкспорта(О.Ссылка, ОбластиЭкспорта); Результат = МетаданныеЭкспорта(О);
        СервисУведомлений.СоздатьСобытие(УчетнаяЗапись, "document", "export:" + ИДс(О.Ссылка), ИДс(О.Ссылка), "Ready", О.РабочееПространство);
        ЗафиксироватьТранзакцию();
    Исключение Откат(); ВызватьИсключение; КонецПопытки;
    Возврат Результат;
КонецФункции

Процедура ПроверитьИсточник(УчетнаяЗапись, Вид, П, Формат, ИсточникиJSON = "[]")
    ПроверитьПараметрыИсточника(Вид, П, Формат);
    Если Вид = "labProtocol" Тогда СервисЛаборатории.ПолучитьПротокол(УчетнаяЗапись, П.id, П.version, "owner");
    ИначеЕсли Вид = "workAppendix" Тогда СервисНарядов.ПолучитьПриложениеНаряда(УчетнаяЗапись, П.id, П.version);
    ИначеЕсли Вид = "workOrder" Или Вид = "workAct" Тогда СервисНарядов.ПолучитьНаряд(УчетнаяЗапись, П.id);
    ИначеЕсли Вид = "subscriberRegistry" Тогда РеестрАбонентов.ПроверитьДоступКВыгрузке(УчетнаяЗапись, П.workspaceId, П.areaId);
    Иначе
        ПроверитьИсточникиРеестра(УчетнаяЗапись, ИзJSON(ИсточникиJSON));
    КонецЕсли;
КонецПроцедуры

Функция СкачатьЭкспорт(УчетнаяЗапись, Идентификатор) Экспорт
    Актер(УчетнаяЗапись); Ссылка = Справочники.СохраненныеЭкспорты.ПолучитьСсылку(ИД(Идентификатор)); О = Ссылка.ПолучитьОбъект();
    Если О = Неопределено Тогда ВызватьИсключение "кабинет_документ_не_найдено"; КонецЕсли;
    Если О.ПометкаУдаления Или О.УчетнаяЗаписьВладельца <> УчетнаяЗапись Или О.Состояние <> "Ready" Или О.ДоступенДо <= ТекущаяУниверсальнаяДата() Тогда ВызватьИсключение "кабинет_документ_не_найдено"; КонецЕсли;
    П = ИзJSON(О.ПараметрыИсточникаJSON); ПроверитьИсточник(УчетнаяЗапись, О.ВидИсточника, П, О.Формат, О.ИсточникиJSON);
    Начать(УчетнаяЗапись);
    Попытка
        Блокировать("Справочник.СохраненныеЭкспорты", Ссылка); Свежий = Ссылка.ПолучитьОбъект();
        Если Свежий.Состояние <> "Ready" Или Свежий.ДоступенДо <= ТекущаяУниверсальнаяДата() Или Свежий.УчетнаяЗаписьВладельца <> УчетнаяЗапись
            Или Свежий.ПараметрыИсточникаJSON <> О.ПараметрыИсточникаJSON Или Свежий.ХешSHA256 <> О.ХешSHA256 Тогда ВызватьИсключение "кабинет_документ_не_найдено"; КонецЕсли;
        Если Свежий.ВидИсточника = "workAppendix" Тогда СервисНарядов.ПроверитьДоступКПриложениюНаряда(УчетнаяЗапись, П.id, "Read", П.version); КонецЕсли;
        Данные = Свежий.ДанныеФайла.Получить(); ПроверитьБайты(Данные, Свежий.КоличествоБайт, Свежий.ХешSHA256);
        Результат = Новый Структура("binary,mime,filename", Данные, Свежий.ТипMIME, Свежий.ИмяФайла); ЗафиксироватьТранзакцию();
    Исключение Откат(); ВызватьИсключение; КонецПопытки;
    Возврат Результат;
КонецФункции

Процедура ПроверитьИсточникиРеестра(УчетнаяЗапись, Источники)
    Если ТипЗнч(Источники) <> Тип("Массив") Или Источники.Количество() > 1000 Тогда ВызватьИсключение "кабинет_документ_целостность_конфликт"; КонецЕсли;
    Для Каждого Источник Из Источники Цикл
        Поля(Источник, "kind,id"); ИД(Источник.id);
        Если Источник.kind = "incoming" Тогда ПолучитьДокумент(УчетнаяЗапись, Источник.id);
        ИначеЕсли Источник.kind = "request" Тогда СервисФайлов.ПолучитьВложениеОбращения(УчетнаяЗапись, Источник.id);
        ИначеЕсли Источник.kind = "export" Тогда
            О = Справочники.СохраненныеЭкспорты.ПолучитьСсылку(ИД(Источник.id)).ПолучитьОбъект();
            Если О = Неопределено Тогда ВызватьИсключение "кабинет_документ_не_найдено"; КонецЕсли;
            Если О.УчетнаяЗаписьВладельца <> УчетнаяЗапись Или О.ПометкаУдаления Тогда ВызватьИсключение "кабинет_документ_не_найдено"; КонецЕсли;
        Иначе ВызватьИсключение "кабинет_документ_целостность_конфликт"; КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ЯчейкаCSV(Значение)
    Р = Строка(Значение); Начало = СокрЛ(Р);
    Если СтрДлина(Начало) > 0 И СтрНайти("=+-@", Лев(Начало, 1)) > 0 Тогда Р = "'" + Р; КонецЕсли;
    Возврат """" + СтрЗаменить(Р, """", """""") + """";
КонецФункции

Функция ЭкспортРеестраДокументов(УчетнаяЗапись, Параметры, Формат, ВложенныйДопуск = Неопределено) Экспорт
    ОбластиЭкспорта = ОбластиДляЭкспорта(УчетнаяЗапись, "documentRegistry", Параметры, Формат);
    СобственныйДопуск = ВложенныйДопуск = Неопределено;
    ДопускТяжелогоЗадания = ОграниченияТяжелыхЗаданий.Начать(УчетнаяЗапись, "documentRegistry", ОбластиЭкспорта, ВложенныйДопуск);
    Попытка
        Результат = ЭкспортРеестраДокументовБезЛимита(УчетнаяЗапись, Параметры, Формат, ОбластиЭкспорта);
    Исключение
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
        Если СобственныйДопуск Тогда ОграниченияТяжелыхЗаданий.Завершить(УчетнаяЗапись, ДопускТяжелогоЗадания); КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
    Если СобственныйДопуск Тогда ОграниченияТяжелыхЗаданий.Завершить(УчетнаяЗапись, ДопускТяжелогоЗадания); КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ЭкспортРеестраДокументовБезЛимита(УчетнаяЗапись, Параметры, Формат, ДопустимыеОбласти)
    Актер(УчетнаяЗапись); ПараметрыСписка(Параметры);
    Если Формат <> "csv" И Формат <> "pdf" Тогда ВызватьИсключение "кабинет_документ_некорректно_поле"; КонецЕсли;
    П = Новый Структура; Для Каждого Э Из Параметры Цикл П.Вставить(Э.Ключ, Э.Значение); КонецЦикла;
    П.Вставить("limit", "100"); П.Вставить("cursor", ""); Строки = Новый Массив; Источники = Новый Массив;
    Строки.Добавить("УЧЕБНЫЕ ДАННЫЕ. Реестр личных документов, не юридически значимый документ.");
    CSV = ЯчейкаCSV(Строки[0]) + Символ(13) + Символ(10) + "id;kind;objectId;revision;filename;mime;bytes;sha256;createdAt;state" + Символ(13) + Символ(10);
    Продолжать = Истина;
    Пока Продолжать Цикл
        Страница = МоиДокументы(УчетнаяЗапись, П);
        Для Каждого Д Из Страница.items Цикл
            ПроверитьОбластьСтрокиЭкспорта(Д, ДопустимыеОбласти);
            Если Источники.Количество() >= 1000 Тогда ВызватьИсключение "кабинет_документ_экспорт_слишком_большое"; КонецЕсли;
            Источники.Добавить(Новый Структура("kind,id", Д.kind, Д.id));
            CSV = CSV + ЯчейкаCSV(Д.id) + ";" + ЯчейкаCSV(Д.kind) + ";" + ЯчейкаCSV(Д.objectId) + ";" + ЯчейкаCSV(Д.revision) + ";" + ЯчейкаCSV(Д.filename)
                + ";" + ЯчейкаCSV(Д.mime) + ";" + ЯчейкаCSV(Д.byteCount) + ";" + ЯчейкаCSV(Д.sha256) + ";" + ЯчейкаCSV(Д.createdAt) + ";" + ЯчейкаCSV(Д.state) + Символ(13) + Символ(10);
            Строки.Добавить(Д.filename + " | " + Д.kind + " | редакция " + Строка(Д.revision) + " | " + Д.createdAt + " | " + Д.state);
            Строки.Добавить("Объект: " + Д.objectId + "; документ: " + Д.id + "; SHA256: " + Д.sha256);
        КонецЦикла;
        Продолжать = Страница.hasMore; П.Вставить("cursor", Страница.nextCursor);
    КонецЦикла;
    Если Формат = "csv" Тогда Возврат Новый Структура("csv,filename,sources", CSV, "training-my-documents.csv", Источники); КонецЕсли;
    Таблица = Новый ТабличныйДокумент; Таблица.АвтоМасштаб = Истина; Таблица.Вывод = ИспользованиеВывода.Разрешить;
    Таблица.Область(1, 1, Строки.Количество(), 1).ШиринаКолонки = 115;
    Таблица.Область(1, 1, Строки.Количество(), 1).Шрифт = Новый Шрифт("DejaVu Sans", 9);
    Таблица.Область(1, 1, Строки.Количество(), 1).РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
    Таблица.Область(1, 1, Строки.Количество(), 1).ВысотаСтроки = 0;
    Таблица.Область(1, 1, Строки.Количество(), 1).АвтоВысотаСтроки = Истина;
    Н = 1; Для Каждого СтрокаТекста Из Строки Цикл Таблица.Область(Н, 1).Текст = СтрокаТекста; Н = Н + 1; КонецЦикла;
    Путь = ПолучитьИмяВременногоФайла("pdf");
    Попытка Таблица.Записать(Путь, ТипФайлаТабличногоДокумента.PDF); Данные = Новый ДвоичныеДанные(Путь); УдалитьФайлы(Путь);
    Исключение Попытка УдалитьФайлы(Путь); Исключение КонецПопытки; ВызватьИсключение; КонецПопытки;
    Если Данные.Размер() > 5242880 Тогда ВызватьИсключение "кабинет_документ_экспорт_слишком_большое"; КонецЕсли;
    Возврат Новый Структура("Данные,ИмяФайла,sources", Данные, "training-my-documents.pdf", Источники);
КонецФункции

Функция ОбработатьЗапросКабинета(Действие, УчетнаяЗапись, Запрос, Корреляция) Экспорт
    Идентификатор = Запрос.ПараметрыURL.Получить("id"); Результат = Неопределено;
    Если Действие <> "documentsList" Тогда
        Для Каждого Поле Из Запрос.ПараметрыЗапроса Цикл
            Если Действие <> "documentsDownload" Или Поле.Ключ <> "version" Тогда ВызватьИсключение "кабинет_документ_некорректно_поле"; КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    Если Действие = "documentsList" Тогда
        П = Новый Структура;
        Для Каждого Параметр Из Запрос.ПараметрыЗапроса Цикл П.Вставить(Параметр.Ключ, Параметр.Значение); КонецЦикла;
        Результат = МоиДокументы(УчетнаяЗапись, П);
    ИначеЕсли Действие = "documentsGet" Тогда Результат = ПолучитьДокумент(УчетнаяЗапись, Идентификатор);
    ИначеЕсли Действие = "documentsDownload" Тогда
        Версия = APIКабинета.ТекстПараметраЗапроса(Запрос, "version", 3); Если Версия = "" Тогда Версия = "0"; КонецЕсли;
        Для Н = 1 По СтрДлина(Версия) Цикл Если СтрНайти("0123456789", Сред(Версия, Н, 1)) = 0 Тогда ВызватьИсключение "кабинет_документ_некорректно_поле"; КонецЕсли; КонецЦикла;
        Возврат APIКабинета.СформироватьОтветФайла(СкачатьДокумент(УчетнаяЗапись, Идентификатор, Число(Версия)), Корреляция);
    ИначеЕсли Действие = "exportsDownload" Тогда Возврат APIКабинета.СформироватьОтветФайла(СкачатьЭкспорт(УчетнаяЗапись, Идентификатор), Корреляция);
    ИначеЕсли Действие = "documentsUpload" Или Действие = "documentsReplace" Тогда
        Тело = APIКабинета.РазобратьТелоЗапроса(Запрос, 6995000); Ключ = APIКабинета.ЗаголовокЗапроса(Запрос, "Idempotency-Key");
        Результат = ЗагрузитьДокумент(УчетнаяЗапись, Тело, Ключ, ?(Действие = "documentsUpload", "", Идентификатор));
    ИначеЕсли Действие = "documentsSubmit" Или Действие = "documentsArchive" Или Действие = "documentsDelete" Тогда
        Тело = APIКабинета.РазобратьТелоЗапроса(Запрос); Ключ = APIКабинета.ЗаголовокЗапроса(Запрос, "Idempotency-Key");
        Операция = ?(Действие = "documentsSubmit", "submit", ?(Действие = "documentsArchive", "archive", "delete"));
        Результат = ИзменитьСостояниеДокумента(УчетнаяЗапись, Идентификатор, Операция, Тело, Ключ);
    ИначеЕсли Действие = "exportsCreate" Тогда Результат = СоздатьЭкспорт(УчетнаяЗапись, APIКабинета.РазобратьТелоЗапроса(Запрос), APIКабинета.ЗаголовокЗапроса(Запрос, "Idempotency-Key"));
    Иначе ВызватьИсключение "кабинет_документ_не_найдено"; КонецЕсли;
    КодОтвета = ?(Действие = "documentsUpload" Или Действие = "documentsReplace" Или Действие = "exportsCreate", 201, 200);
    Возврат APIКабинета.СформироватьОтветHTTP(КодОтвета, Результат, Корреляция);
КонецФункции

Функция УдалитьИстекшиеЭкспорты(Предел = 100) Экспорт
    Если Не РольДоступна("Администратор") Тогда ВызватьИсключение "кабинет_документ_запрещено"; КонецЕсли;
    Целое(Предел, 1, 100); Если ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_документ_вложенная_транзакция"; КонецЕсли;
    З = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 100 Ссылка ИЗ Справочник.СохраненныеЭкспорты ГДЕ ДоступенДо <= &Сейчас И Состояние = &Готово УПОРЯДОЧИТЬ ПО ДоступенДо, Ссылка");
    З.УстановитьПараметр("Сейчас", ТекущаяУниверсальнаяДата()); З.УстановитьПараметр("Готово", "Ready"); В = З.Выполнить().Выбрать(); Количество = 0;
    Пока В.Следующий() И Количество < Предел Цикл
        НачатьТранзакцию();
        Попытка
            Блокировать("Справочник.СохраненныеЭкспорты", В.Ссылка); О = В.Ссылка.ПолучитьОбъект();
            Если О.Состояние = "Ready" И О.ДоступенДо <= ТекущаяУниверсальнаяДата() Тогда
                О.ДанныеФайла = Новый ХранилищеЗначения(Неопределено); О.Состояние = "Expired"; О.Записать(); Количество = Количество + 1;
            КонецЕсли;
            ЗафиксироватьТранзакцию();
        Исключение Откат(); ВызватьИсключение; КонецПопытки;
    КонецЦикла;
    Возврат Количество;
КонецФункции

Функция ОбластиДляЭкспорта(УчетнаяЗапись, Вид, П, Формат)
    Актер(УчетнаяЗапись); ПроверитьПараметрыИсточника(Вид, П, Формат);
    Если Вид = "documentRegistry" Тогда
        Копия = Новый Структура; Для Каждого Э Из П Цикл Копия.Вставить(Э.Ключ, Э.Значение); КонецЦикла;
        Копия.Вставить("limit", "100"); Копия.Вставить("cursor", ""); Области = Новый Массив; КлючиОбластей = Новый Соответствие; Число = 0;
        Продолжать = Истина;
        Пока Продолжать Цикл
            Страница = МоиДокументы(УчетнаяЗапись, Копия);
            Для Каждого Д Из Страница.items Цикл
                Число = Число + 1; Если Число > 1000 Тогда ВызватьИсключение "кабинет_документ_экспорт_слишком_большое"; КонецЕсли;
                Если Д.workspaceId = "" И Д.areaId = "" Тогда
                    Если Д.kind <> "export" Или Д.sourceKind <> "documentRegistry" Тогда ВызватьИсключение "кабинет_документ_целостность_конфликт"; КонецЕсли;
                    Продолжить;
                КонецЕсли;
                ДобавитьОбластьСнимка(Области, КлючиОбластей, Справочники.РабочиеПространства.ПолучитьСсылку(ИД(Д.workspaceId)), Справочники.Области.ПолучитьСсылку(ИД(Д.areaId)));
            КонецЦикла;
            Продолжать = Страница.hasMore; Копия.Вставить("cursor", Страница.nextCursor);
        КонецЦикла;
        Возврат Области;
    КонецЕсли;
    ПроверитьИсточник(УчетнаяЗапись, Вид, П, Формат);
    Если Вид = "subscriberRegistry" Тогда
        Возврат ОграниченияТяжелыхЗаданий.ОднаОбласть(Справочники.РабочиеПространства.ПолучитьСсылку(ИД(П.workspaceId)), Справочники.Области.ПолучитьСсылку(ИД(П.areaId)));
    КонецЕсли;
    Если Вид = "labProtocol" Тогда Источник = Справочники.ПробыЛаборатории.ПолучитьСсылку(ИД(П.id));
    Иначе Источник = Справочники.Наряды.ПолучитьСсылку(ИД(П.id)); КонецЕсли;
    Возврат ОграниченияТяжелыхЗаданий.ОднаОбласть(Источник.РабочееПространство, Источник.Область);
КонецФункции

Процедура ПроверитьОбластьСтрокиЭкспорта(Д, Области)
    Если Д.workspaceId = "" И Д.areaId = "" Тогда
        Если Д.kind <> "export" Или Д.sourceKind <> "documentRegistry" Тогда ВызватьИсключение "кабинет_документ_целостность_конфликт"; КонецЕсли;
        Возврат;
    КонецЕсли;
    Для Каждого О Из Области Цикл
        Если Строка(О.РабочееПространство.УникальныйИдентификатор()) = Д.workspaceId И Строка(О.Область.УникальныйИдентификатор()) = Д.areaId Тогда Возврат; КонецЕсли;
    КонецЦикла;
    ВызватьИсключение "кабинет_тяжелый_аренда_несовпадение";
КонецПроцедуры

Процедура ПроверитьКвотуОбъектовЭкспорта(Области)
    Если Не ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_документ_вложенная_транзакция"; КонецЕсли;
    Б = Новый БлокировкаДанных; Э = Б.Добавить("РегистрСведений.ОбластиСохраненныхЭкспортов");
    Э.Режим = РежимБлокировкиДанных.Исключительный; Б.Заблокировать();
    ПроверитьГотовностьОбластейЭкспортов();
    Пространства = Новый Массив; ИдентификаторыОбластей = Новый Массив;
    Для Каждого О Из Области Цикл
        Если Пространства.Найти(О.РабочееПространство) = Неопределено Тогда Пространства.Добавить(О.РабочееПространство); КонецЕсли;
        Если ИдентификаторыОбластей.Найти(О.Область) = Неопределено Тогда ИдентификаторыОбластей.Добавить(О.Область); КонецЕсли;
    КонецЦикла;
    Если Пространства.Количество() = 0 Тогда Возврат; КонецЕсли;
    З = Новый Запрос("ВЫБРАТЬ РабочееПространство, КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Экспорт) КАК Количество
        |ИЗ РегистрСведений.ОбластиСохраненныхЭкспортов ГДЕ РабочееПространство В (&Пространства)
        |СГРУППИРОВАТЬ ПО РабочееПространство");
    З.УстановитьПараметр("Пространства", Пространства); В = З.Выполнить().Выбрать();
    Пока В.Следующий() Цикл Если В.Количество >= 5000 Тогда ВызватьИсключение "кабинет_документ_квота_превышено"; КонецЕсли; КонецЦикла;
    З.Текст = "ВЫБРАТЬ Область, КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Экспорт) КАК Количество
        |ИЗ РегистрСведений.ОбластиСохраненныхЭкспортов ГДЕ Область В (&Области) СГРУППИРОВАТЬ ПО Область";
    З.УстановитьПараметр("Области", ИдентификаторыОбластей); В = З.Выполнить().Выбрать();
    Пока В.Следующий() Цикл Если В.Количество >= 1000 Тогда ВызватьИсключение "кабинет_документ_квота_превышено"; КонецЕсли; КонецЦикла;
КонецПроцедуры

Процедура СохранитьОбластиЭкспорта(СсылкаЭкспорта, Области)
    Если Не ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_документ_вложенная_транзакция"; КонецЕсли;
    Для Каждого О Из Области Цикл
        ЗаписатьОбластьЭкспорта(СсылкаЭкспорта, О.РабочееПространство, О.Область);
    КонецЦикла;
    ЗаписатьОбластьЭкспорта(СсылкаЭкспорта, Справочники.РабочиеПространства.ПустаяСсылка(), Справочники.Области.ПустаяСсылка());
КонецПроцедуры

Процедура ЗаписатьОбластьЭкспорта(СсылкаЭкспорта, Пространство, Область)
    Р = РегистрыСведений.ОбластиСохраненныхЭкспортов.СоздатьМенеджерЗаписи();
    Р.Экспорт = СсылкаЭкспорта; Р.РабочееПространство = Пространство; Р.Область = Область; Р.ДатаФиксации = ТекущаяУниверсальнаяДата(); Р.Записать();
КонецПроцедуры

Функция ВосстановитьОбластиЭкспортов(Предел = 100, После = "") Экспорт
    ОграниченияТяжелыхЗаданий.ПроверитьОператораВосстановления();
    Целое(Предел, 1, 100); Если ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_документ_вложенная_транзакция"; КонецЕсли;
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        Б = Новый БлокировкаДанных; Э = Б.Добавить("РегистрСведений.ОбластиСохраненныхЭкспортов");
        Э.Режим = РежимБлокировкиДанных.Исключительный; Б.Заблокировать();
        З = ЗапросНезавершенныхОбластей(101);
        З.Текст = З.Текст + " И Ссылка > &После УПОРЯДОЧИТЬ ПО Ссылка";
        СсылкаПосле = Справочники.СохраненныеЭкспорты.ПустаяСсылка(); Если После <> "" Тогда СсылкаПосле = Справочники.СохраненныеЭкспорты.ПолучитьСсылку(ИД(После)); КонецЕсли;
        З.УстановитьПараметр("После", СсылкаПосле); Таблица = З.Выполнить().Выгрузить(); Число = Мин(Предел, Таблица.Количество()); Завершено = 0; Добавлено = 0; Просмотрено = 0; Курсор = После;
        Для Номер = 0 По Число - 1 Цикл
            О = Таблица[Номер].Ссылка.ПолучитьОбъект(); Если О = Неопределено Тогда ВызватьИсключение "кабинет_документ_целостность_конфликт"; КонецЕсли;
            Итог = МигрироватьПорциюОбластей(О, 1000 - Добавлено); Добавлено = Добавлено + Итог.added; Если Итог.complete Тогда Завершено = Завершено + 1; КонецЕсли;
            Курсор = ИДс(О.Ссылка); Просмотрено = Просмотрено + 1; Если Добавлено >= 1000 Тогда Прервать; КонецЕсли;
        КонецЦикла;
        Еще = Таблица.Количество() > Просмотрено; Все = ЗапросНезавершенныхОбластей(1).Выполнить().Пустой();
        Результат = Новый Структура("scanned,completed,bindingsAdded,hasMore,nextCursor,complete", Просмотрено, Завершено, Добавлено, Еще, ?(Еще, Курсор, ""), Все);
        ЗафиксироватьТранзакцию(); Возврат Результат;
    Исключение Откат(); ВызватьИсключение; КонецПопытки;
КонецФункции

Функция МигрироватьПорциюОбластей(О, Бюджет)
    Если Бюджет < 1 Или Бюджет > 1000 Тогда ВызватьИсключение "кабинет_документ_целостность_конфликт"; КонецЕсли;
    ПрямыеОбласти = Новый Массив;
    Если ЗначениеЗаполнено(О.РабочееПространство) И ЗначениеЗаполнено(О.Область) Тогда
        Если О.Область.РабочееПространство <> О.РабочееПространство Тогда ВызватьИсключение "кабинет_документ_целостность_конфликт"; КонецЕсли;
        ПрямыеОбласти.Добавить(О.Область);
    Иначе
        Если О.ВидИсточника <> "documentRegistry" Тогда ВызватьИсключение "кабинет_документ_целостность_конфликт"; КонецЕсли;
        Источники = ИзJSON(О.ИсточникиJSON);
        Если ТипЗнч(Источники) <> Тип("Массив") Или Источники.Количество() > 1000 Тогда ВызватьИсключение "кабинет_документ_целостность_конфликт"; КонецЕсли;
        Для Каждого ИсточникСнимка Из Источники Цикл
            Поля(ИсточникСнимка, "kind,id");
            Если ИсточникСнимка.kind = "incoming" Тогда
                Файл = Справочники.ДокументыКабинета.ПолучитьСсылку(ИД(ИсточникСнимка.id)).ПолучитьОбъект();
                Если Файл = Неопределено Или Файл.УчетнаяЗаписьВладельца <> О.УчетнаяЗаписьВладельца Тогда ВызватьИсключение "кабинет_документ_целостность_конфликт"; КонецЕсли;
                Если Не ЗначениеЗаполнено(Файл.РабочееПространство) Или Файл.Область.РабочееПространство <> Файл.РабочееПространство Тогда ВызватьИсключение "кабинет_документ_целостность_конфликт"; КонецЕсли;
                ПрямыеОбласти.Добавить(Файл.Область);
            ИначеЕсли ИсточникСнимка.kind = "request" Тогда
                Файл = Справочники.ФайлыОбращений.ПолучитьСсылку(ИД(ИсточникСнимка.id)).ПолучитьОбъект();
                Если Файл = Неопределено Или Файл.РодительскоеОбращение.Заявитель <> О.УчетнаяЗаписьВладельца Тогда ВызватьИсключение "кабинет_документ_целостность_конфликт"; КонецЕсли;
                Если Не ЗначениеЗаполнено(Файл.РабочееПространство) Или Файл.Область.РабочееПространство <> Файл.РабочееПространство Тогда ВызватьИсключение "кабинет_документ_целостность_конфликт"; КонецЕсли;
                ПрямыеОбласти.Добавить(Файл.Область);
            ИначеЕсли ИсточникСнимка.kind = "export" Тогда
                ОбъектЭкспорта = Справочники.СохраненныеЭкспорты.ПолучитьСсылку(ИД(ИсточникСнимка.id)).ПолучитьОбъект();
                Если ОбъектЭкспорта = Неопределено Или ОбъектЭкспорта.УчетнаяЗаписьВладельца <> О.УчетнаяЗаписьВладельца Тогда ВызватьИсключение "кабинет_документ_целостность_конфликт"; КонецЕсли;
                Если Не ЗначениеЗаполнено(ОбъектЭкспорта.РабочееПространство) И Не ЗначениеЗаполнено(ОбъектЭкспорта.Область) Тогда
                    Если ОбъектЭкспорта.ВидИсточника <> "documentRegistry" Тогда ВызватьИсключение "кабинет_документ_целостность_конфликт"; КонецЕсли;
                Иначе
                    Если Не ЗначениеЗаполнено(ОбъектЭкспорта.РабочееПространство) Или Не ЗначениеЗаполнено(ОбъектЭкспорта.Область)
                        Или ОбъектЭкспорта.Область.РабочееПространство <> ОбъектЭкспорта.РабочееПространство Тогда ВызватьИсключение "кабинет_документ_целостность_конфликт"; КонецЕсли;
                    ПрямыеОбласти.Добавить(ОбъектЭкспорта.Область);
                КонецЕсли;
            Иначе ВызватьИсключение "кабинет_документ_целостность_конфликт"; КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    Для Каждого Область Из ПрямыеОбласти Цикл
        Если Не ЗначениеЗаполнено(Область) Или Область.ПолучитьОбъект() = Неопределено Тогда ВызватьИсключение "кабинет_документ_целостность_конфликт"; КонецЕсли;
    КонецЦикла;
    Последний = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Область ИЗ РегистрСведений.ОбластиСохраненныхЭкспортов ГДЕ Экспорт = &Экспорт УПОРЯДОЧИТЬ ПО Область УБЫВ");
    Последний.УстановитьПараметр("Экспорт", О.Ссылка); В = Последний.Выполнить().Выбрать(); После = Справочники.Области.ПустаяСсылка(); Если В.Следующий() Тогда После = В.Область; КонецЕсли;
    З = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1001 А.РабочееПространство, А.Ссылка КАК Область
        |ИЗ Справочник.Области КАК А ГДЕ А.Ссылка В (&Прямые)
        |И А.Ссылка > &После УПОРЯДОЧИТЬ ПО А.Ссылка");
    З.УстановитьПараметр("Прямые", ПрямыеОбласти); З.УстановитьПараметр("После", После);
    Таблица = З.Выполнить().Выгрузить(); Число = Мин(Бюджет, Таблица.Количество());
    Для Номер = 0 По Число - 1 Цикл
        Строка = Таблица[Номер]; Если Строка.Область.РабочееПространство <> Строка.РабочееПространство Тогда ВызватьИсключение "кабинет_документ_целостность_конфликт"; КонецЕсли;
        ЗаписатьОбластьЭкспорта(О.Ссылка, Строка.РабочееПространство, Строка.Область);
    КонецЦикла;
    Все = Таблица.Количество() <= Бюджет;
    Если Все Тогда СохранитьОбластиЭкспорта(О.Ссылка, Новый Массив); КонецЕсли;
    Возврат Новый Структура("added,complete", Число, Все);
КонецФункции

Процедура ДобавитьОбластьСнимка(Области, Ключи, Пространство, Область)
    Если Не ЗначениеЗаполнено(Пространство) Или Не ЗначениеЗаполнено(Область) Или Область.РабочееПространство <> Пространство Тогда ВызватьИсключение "кабинет_документ_целостность_конфликт"; КонецЕсли;
    К = ИДс(Область); Если Ключи.Получить(К) <> Неопределено Тогда Возврат; КонецЕсли;
    Если Области.Количество() >= 1000 Тогда ВызватьИсключение "кабинет_документ_экспорт_слишком_большое"; КонецЕсли;
    Ключи.Вставить(К, Истина); Области.Добавить(Новый Структура("РабочееПространство,Область", Пространство, Область));
КонецПроцедуры

Функция ЗапросНезавершенныхОбластей(Предел)
    Если Предел <> 1 И Предел <> 101 Тогда ВызватьИсключение "кабинет_документ_целостность_конфликт"; КонецЕсли;
    Возврат Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ " + Формат(Предел, "ЧГ=0") + " Ссылка ИЗ Справочник.СохраненныеЭкспорты
        |ГДЕ Ссылка НЕ В (ВЫБРАТЬ Экспорт ИЗ РегистрСведений.ОбластиСохраненныхЭкспортов
        |ГДЕ РабочееПространство = ЗНАЧЕНИЕ(Справочник.РабочиеПространства.ПустаяСсылка)
        |И Область = ЗНАЧЕНИЕ(Справочник.Области.ПустаяСсылка))");
КонецФункции

Процедура ПроверитьГотовностьОбластейЭкспортов() Экспорт
    Если Не ЗапросНезавершенныхОбластей(1).Выполнить().Пустой() Тогда ВызватьИсключение "кабинет_документ_граница_миграция_требуется"; КонецЕсли;
КонецПроцедуры

Функция ПолнаяПроекцияПакета(Пакет, Вид) Экспорт
    Если Вид <> "full" Тогда Возврат ""; КонецЕсли;
    СтрокаПакета = РегистрыСведений.ТекущиеПакетыСводок.СоздатьМенеджерЗаписи();
    СтрокаПакета.КлючПакета = Пакет.Ключ;
    СтрокаПакета.Прочитать();
    Если СтрокаПакета.Выбран() Тогда Возврат СтрокаПакета.СодержимоеПакета; КонецЕсли;
    Возврат "";
КонецФункции
