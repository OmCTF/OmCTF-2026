Функция ПолитикаКорневыхОбъектов() Экспорт
    Возврат "root-objects-v1";
КонецФункции

Функция СемействаКорневыхОбъектов()
    Семейства = Новый Соответствие;
    Для Каждого Имя Из СтрРазделить("Гидропосты,Абоненты,ОбъектыНедвижимости,ТочкиОбслуживания,Договоры,ЛицевыеСчета,ПаспортаПриборов,УстановкиПриборов,ЗаявкиКорректировкиПоказаний,ИсточникиВоды,ПунктыВыдачиВоды,ПолучателиВоды,ЗаказыВоды,ПубличныеПриемные,ОбращенияДиспетчерской,ИнцидентыДиспетчерской,РабочиеБригады,РесурсыНарядов,ЗаказыУслуг,Наряды,ФайлыОбращений,ЗаказыЛаборатории,ПробыЛаборатории,ЕдиницыМатериалов,Материалы,СкладыМатериалов,ЯчейкиМатериалов,ЗаявкиМатериалов,ДокументыКабинета,ОбъектыУчебнойСети,СвязиУчебнойСети,ОтключенияВодоснабжения", ",") Цикл
        Семейства.Вставить("Справочник." + Имя, "СправочникОбъект." + Имя);
    КонецЦикла;
    Для Каждого Имя Из СтрРазделить("ИзмерениеПрибора,ДвижениеВоды,ДвижениеМатериалов", ",") Цикл
        Семейства.Вставить("Документ." + Имя, "ДокументОбъект." + Имя);
    КонецЦикла;
    Возврат Семейства;
КонецФункции

Процедура ТребоватьТранзакцию()
    Если Не ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_объект_квота_транзакция_требуется"; КонецЕсли;
КонецПроцедуры

Функция ИдентификаторОбластиДействия(Ссылка)
    Если Не ЗначениеЗаполнено(Ссылка) Тогда ВызватьИсключение "кабинет_объект_квота_граница_конфликт"; КонецЕсли;
    Возврат НРег(Строка(Ссылка.УникальныйИдентификатор()));
КонецФункции

Процедура ПроверитьОбласть(Пространство, Область)
    Если ТипЗнч(Пространство) <> Тип("СправочникСсылка.РабочиеПространства")
        Или ТипЗнч(Область) <> Тип("СправочникСсылка.Области")
        Или Не ЗначениеЗаполнено(Пространство) Или Не ЗначениеЗаполнено(Область) Тогда
        ВызватьИсключение "кабинет_объект_квота_граница_конфликт";
    КонецЕсли;
    Если Область.РабочееПространство <> Пространство Тогда ВызватьИсключение "кабинет_объект_квота_граница_конфликт"; КонецЕсли;
КонецПроцедуры

Процедура ЗаблокироватьСчетчик(Вид, Идентификатор)
    ТребоватьТранзакцию();
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("РегистрСведений.КвотыКорневыхОбъектов");
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Элемент.УстановитьЗначение("ВидОбластиДействия", Вид);
    Элемент.УстановитьЗначение("ИдентификаторОбластиДействия", Идентификатор);
    Блокировка.Заблокировать();
КонецПроцедуры

Функция ПрочитатьСчетчик(Вид, Идентификатор, Обязателен = Истина)
    Запись = РегистрыСведений.КвотыКорневыхОбъектов.СоздатьМенеджерЗаписи();
    Запись.ВидОбластиДействия = Вид;
    Запись.ИдентификаторОбластиДействия = Идентификатор;
    Запись.Прочитать();
    Если Не Запись.Выбран() Тогда
        Если Обязателен Тогда ВызватьИсключение "кабинет_объект_квота_миграция_требуется"; КонецЕсли;
        Запись.ВидОбластиДействия = Вид;
        Запись.ИдентификаторОбластиДействия = Идентификатор;
        Возврат Запись;
    КонецЕсли;
    Если Запись.ВерсияПолитики <> ПолитикаКорневыхОбъектов() Тогда ВызватьИсключение "кабинет_объект_квота_миграция_требуется"; КонецЕсли;
    Если Запись.Использовано < 0 Или Запись.Использовано <> Цел(Запись.Использовано)
        Или Запись.Использовано > 9999999999 Или Запись.ДатаИнициализации = Дата(1,1,1) Тогда
        ВызватьИсключение "кабинет_объект_квота_целостность_конфликт";
    КонецЕсли;
    Возврат Запись;
КонецФункции

Процедура ПроверитьНовуюЗапись(Объект) Экспорт
    ТребоватьТранзакцию();
    Разрешен = Ложь;
    Для Каждого Семейство Из СемействаКорневыхОбъектов() Цикл
        Если ТипЗнч(Объект) = Тип(Семейство.Значение) Тогда Разрешен = Истина; Прервать; КонецЕсли;
    КонецЦикла;
    Если Не Разрешен Тогда ВызватьИсключение "кабинет_объект_квота_граница_конфликт"; КонецЕсли;
    ПлатитьПространство = Истина; ПлатитьОбласть = Истина;
    Если Не Объект.ЭтоНовый() Тогда
        Старый = Объект.Ссылка.ПолучитьОбъект();
        Если Старый = Неопределено Тогда ВызватьИсключение "кабинет_объект_квота_целостность_конфликт"; КонецЕсли;
        ПлатитьПространство = Старый.РабочееПространство <> Объект.РабочееПространство;
        ПлатитьОбласть = Старый.Область <> Объект.Область;
        Если Не ПлатитьПространство И Не ПлатитьОбласть Тогда Возврат; КонецЕсли;
    КонецЕсли;
    ПроверитьГотовностьКвот();
    Если Объект.ОбменДанными.Загрузка Тогда ВызватьИсключение "кабинет_объект_квота_миграция_требуется"; КонецЕсли;
    ПроверитьОбласть(Объект.РабочееПространство, Объект.Область);
    ПространствоИд = ИдентификаторОбластиДействия(Объект.РабочееПространство);
    ОбластьИд = ИдентификаторОбластиДействия(Объект.Область);
    ЗаблокироватьСчетчик("Workspace", ПространствоИд);
    ЗаблокироватьСчетчик("Area", ОбластьИд);
    Пространство = ПрочитатьСчетчик("Workspace", ПространствоИд);
    Область = ПрочитатьСчетчик("Area", ОбластьИд);
    Если (ПлатитьПространство И Пространство.Использовано >= 50000)
        Или (ПлатитьОбласть И Область.Использовано >= 10000) Тогда
        ВызватьИсключение "кабинет_объект_квота_превышено";
    КонецЕсли;
    Если ПлатитьПространство Тогда Пространство.Использовано = Пространство.Использовано + 1; Пространство.Записать(); КонецЕсли;
    Если ПлатитьОбласть Тогда Область.Использовано = Область.Использовано + 1; Область.Записать(); КонецЕсли;
КонецПроцедуры

Процедура ПроверитьГотовностьКвот() Экспорт
    Маркер = ПрочитатьСчетчик("Bootstrap", "00000000-0000-0000-0000-000000000000");
    Если Маркер.Использовано <> 0 Тогда ВызватьИсключение "кабинет_объект_квота_миграция_требуется"; КонецЕсли;
КонецПроцедуры

Процедура СохранитьНулевойСчетчик(Вид, Ссылка)
    ТребоватьТранзакцию(); Ид = ИдентификаторОбластиДействия(Ссылка);
    ЗаблокироватьСчетчик(Вид, Ид);
    Запись = ПрочитатьСчетчик(Вид, Ид, Ложь);
    Если Запись.Выбран() Тогда ВызватьИсключение "кабинет_объект_квота_целостность_конфликт"; КонецЕсли;
    Запись.Использовано = 0; Запись.ВерсияПолитики = ПолитикаКорневыхОбъектов();
    Запись.ДатаИнициализации = ТекущаяУниверсальнаяДата(); Запись.Записать();
КонецПроцедуры

Процедура ИнициализироватьНовоеПространство(Пространство) Экспорт
    Если ТипЗнч(Пространство) <> Тип("СправочникСсылка.РабочиеПространства") Тогда ВызватьИсключение "кабинет_объект_квота_граница_конфликт"; КонецЕсли;
    СохранитьНулевойСчетчик("Workspace", Пространство);
КонецПроцедуры

Процедура ИнициализироватьНовуюОбласть(Область) Экспорт
    Если ТипЗнч(Область) <> Тип("СправочникСсылка.Области") Тогда ВызватьИсключение "кабинет_объект_квота_граница_конфликт"; КонецЕсли;
    ПроверитьОбласть(Область.РабочееПространство, Область);
    ПространствоИд = ИдентификаторОбластиДействия(Область.РабочееПространство);
    ЗаблокироватьСчетчик("Workspace", ПространствоИд);
    ПрочитатьСчетчик("Workspace", ПространствоИд);
    СохранитьНулевойСчетчик("Area", Область);
КонецПроцедуры

Процедура ПроверитьАдминистратораМиграции(ОжидаемаяВерсия, ОжидаемаяПолитика)
    ТребоватьТранзакцию();
    Если ПривилегированныйРежим() Или Не МонопольныйРежим()
        Или ОжидаемаяВерсия <> "1.0" Или Метаданные.Версия <> ОжидаемаяВерсия
        Или ОжидаемаяПолитика <> ПолитикаКорневыхОбъектов() Тогда ВызватьИсключение "кабинет_объект_квота_миграция_требуется"; КонецЕсли;
    Текущий = ПользователиИнформационнойБазы.ТекущийПользователь();
    Если Текущий = Неопределено Тогда ВызватьИсключение "кабинет_объект_квота_миграция_требуется"; КонецЕсли;
    Свежий = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Текущий.УникальныйИдентификатор);
    Если Свежий = Неопределено Тогда ВызватьИсключение "кабинет_объект_квота_миграция_требуется"; КонецЕсли;
    Администратор = Ложь;
    Для Каждого Роль Из Свежий.Роли Цикл Если Роль = Метаданные.Роли.Администратор Тогда Администратор = Истина; КонецЕсли; КонецЦикла;
    Если Не Администратор Тогда ВызватьИсключение "кабинет_объект_квота_миграция_требуется"; КонецЕсли;
КонецПроцедуры

Функция ДиагностикаСуществующихКорней()
    Диагностика = Новый Массив;
    Для Каждого Семейство Из СемействаКорневыхОбъектов() Цикл
        Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего,"
            + " ЕСТЬNULL(СУММА(ВЫБОР КОГДА К.РабочееПространство = &ПустоеПространство ТОГДА 1 ИНАЧЕ 0 КОНЕЦ), 0) КАК ПустыеПространства,"
            + " ЕСТЬNULL(СУММА(ВЫБОР КОГДА К.Область = &ПустаяОбласть ТОГДА 1 ИНАЧЕ 0 КОНЕЦ), 0) КАК ПустыеОбласти,"
            + " ЕСТЬNULL(СУММА(ВЫБОР КОГДА П.Ссылка ЕСТЬ NULL ТОГДА 1 ИНАЧЕ 0 КОНЕЦ), 0) КАК НеизвестныеПространства,"
            + " ЕСТЬNULL(СУММА(ВЫБОР КОГДА О.Ссылка ЕСТЬ NULL ТОГДА 1 ИНАЧЕ 0 КОНЕЦ), 0) КАК НеизвестныеОбласти,"
            + " ЕСТЬNULL(СУММА(ВЫБОР КОГДА О.Ссылка ЕСТЬ НЕ NULL И О.РабочееПространство <> К.РабочееПространство ТОГДА 1 ИНАЧЕ 0 КОНЕЦ), 0) КАК НесовпадающиеПространства"
            + " ИЗ " + Семейство.Ключ + " КАК К ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РабочиеПространства КАК П ПО К.РабочееПространство = П.Ссылка"
            + " ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Области КАК О ПО К.Область = О.Ссылка");
        Запрос.УстановитьПараметр("ПустоеПространство", Справочники.РабочиеПространства.ПустаяСсылка());
        Запрос.УстановитьПараметр("ПустаяОбласть", Справочники.Области.ПустаяСсылка());
        Строка = Запрос.Выполнить().Выбрать();
        Если Не Строка.Следующий() Тогда ВызватьИсключение "кабинет_объект_квота_целостность_конфликт"; КонецЕсли;
        Диагностика.Добавить(Новый Структура("Семейство,Всего,ПустыеПространства,ПустыеОбласти,НеизвестныеПространства,НеизвестныеОбласти,НесовпадающиеПространства",
            Семейство.Ключ, Строка.Всего, Строка.ПустыеПространства, Строка.ПустыеОбласти, Строка.НеизвестныеПространства, Строка.НеизвестныеОбласти, Строка.НесовпадающиеПространства));
    КонецЦикла;
    Возврат Диагностика;
КонецФункции

Процедура ДобавитьСуществующееЧисло(Числа, Ссылка, Число, ПределОбластей)
    Текущее = Числа.Получить(Ссылка);
    Если Текущее = Неопределено Тогда
        Если Числа.Количество() >= ПределОбластей Тогда ВызватьИсключение "кабинет_объект_квота_миграция_требуется"; КонецЕсли;
        Текущее = 0;
    КонецЕсли;
    Числа.Вставить(Ссылка, Текущее + Число);
КонецПроцедуры

Функция ЧислаСуществующихКорневыхОбъектов(Вид, Ссылки, ПределОбластей)
    Числа = Новый Соответствие;
    Для Каждого Ссылка Из Ссылки Цикл Числа.Вставить(Ссылка, 0); КонецЦикла;
    Для Каждого Семейство Из СемействаКорневыхОбъектов() Цикл
        Поле = ?(Вид = "Workspace", "РабочееПространство", "Область");
        Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ " + Формат(ПределОбластей + 1, "ЧГ=0") + " " + Поле + " КАК ОбластьДействия, КОЛИЧЕСТВО(*) КАК Число ИЗ " + Семейство.Ключ + " СГРУППИРОВАТЬ ПО " + Поле + " УПОРЯДОЧИТЬ ПО " + Поле);
        Выборка = Запрос.Выполнить().Выбрать(); ЧислоГрупп = 0;
        Пока Выборка.Следующий() Цикл
            ЧислоГрупп = ЧислоГрупп + 1;
            Если ЧислоГрупп > ПределОбластей Тогда ВызватьИсключение "кабинет_объект_квота_миграция_требуется"; КонецЕсли;
            ДобавитьСуществующееЧисло(Числа, Выборка.ОбластьДействия, Выборка.Число, ПределОбластей);
        КонецЦикла;
        Если Вид = "Workspace" Тогда
            Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(ПределОбластей + 1, "ЧГ=0")
                + " О.РабочееПространство КАК ОбластьДействия, КОЛИЧЕСТВО(*) КАК Число ИЗ " + Семейство.Ключ + " КАК К"
                + " ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Области КАК О ПО К.Область = О.Ссылка"
                + " ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РабочиеПространства КАК П ПО О.РабочееПространство = П.Ссылка"
                + " ГДЕ О.РабочееПространство <> К.РабочееПространство СГРУППИРОВАТЬ ПО О.РабочееПространство УПОРЯДОЧИТЬ ПО О.РабочееПространство";
            Выборка = Запрос.Выполнить().Выбрать(); ЧислоГрупп = 0;
            Пока Выборка.Следующий() Цикл
                ЧислоГрупп = ЧислоГрупп + 1;
                Если ЧислоГрупп > ПределОбластей Тогда ВызватьИсключение "кабинет_объект_квота_миграция_требуется"; КонецЕсли;
                ДобавитьСуществующееЧисло(Числа, Выборка.ОбластьДействия, Выборка.Число, ПределОбластей);
            КонецЦикла;
        КонецЕсли;
    КонецЦикла;
    Возврат Числа;
КонецФункции

Процедура ИнициализироватьСчетчикАдминистратора(Вид, Ссылка, Существующие)
    Ид = НРег(Строка(Ссылка.УникальныйИдентификатор()));
    Запись = ПрочитатьСчетчик(Вид, Ид, Ложь);
    Если Запись.Выбран() Тогда
        Запись.Использовано = Макс(Запись.Использовано, Существующие);
    Иначе
        Запись.Использовано = Существующие;
        Запись.ВерсияПолитики = ПолитикаКорневыхОбъектов(); Запись.ДатаИнициализации = ТекущаяУниверсальнаяДата();
    КонецЕсли;
    Если Запись.Использовано > 9999999999 Тогда ВызватьИсключение "кабинет_объект_квота_целостность_конфликт"; КонецЕсли;
    Запись.Записать();
КонецПроцедуры

Функция ИнициализироватьВсеКвотыАдминистратора(ОжидаемаяВерсия, ОжидаемаяПолитика) Экспорт
    ПроверитьАдминистратораМиграции(ОжидаемаяВерсия, ОжидаемаяПолитика);
    Пространства = Новый Массив; Области = Новый Массив;
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1001 Ссылка ИЗ Справочник.РабочиеПространства УПОРЯДОЧИТЬ ПО Ссылка");
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл Пространства.Добавить(Выборка.Ссылка); КонецЦикла;
    Если Пространства.Количество() > 1000 Тогда ВызватьИсключение "кабинет_объект_квота_миграция_требуется"; КонецЕсли;
    Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 10001 Ссылка ИЗ Справочник.Области УПОРЯДОЧИТЬ ПО РабочееПространство, Ссылка";
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл Области.Добавить(Выборка.Ссылка); КонецЦикла;
    Если Области.Количество() > 10000 Тогда ВызватьИсключение "кабинет_объект_квота_миграция_требуется"; КонецЕсли;
    Диагностика = ДиагностикаСуществующихКорней();
    ЧислаПространств = ЧислаСуществующихКорневыхОбъектов("Workspace", Пространства, 1000);
    ЧислаОбластей = ЧислаСуществующихКорневыхОбъектов("Area", Области, 10000);
    Для Каждого Пара Из ЧислаПространств Цикл ЗаблокироватьСчетчик("Workspace", НРег(Строка(Пара.Ключ.УникальныйИдентификатор()))); КонецЦикла;
    Для Каждого Пара Из ЧислаОбластей Цикл ЗаблокироватьСчетчик("Area", НРег(Строка(Пара.Ключ.УникальныйИдентификатор()))); КонецЦикла;
    Для Каждого Пара Из ЧислаПространств Цикл ИнициализироватьСчетчикАдминистратора("Workspace", Пара.Ключ, Пара.Значение); КонецЦикла;
    Для Каждого Пара Из ЧислаОбластей Цикл ИнициализироватьСчетчикАдминистратора("Area", Пара.Ключ, Пара.Значение); КонецЦикла;
    ЗаблокироватьСчетчик("Bootstrap", "00000000-0000-0000-0000-000000000000");
    Маркер = ПрочитатьСчетчик("Bootstrap", "00000000-0000-0000-0000-000000000000", Ложь);
    Если Маркер.Выбран() И Маркер.Использовано <> 0 Тогда ВызватьИсключение "кабинет_объект_квота_целостность_конфликт"; КонецЕсли;
    Маркер.Использовано = 0; Маркер.ВерсияПолитики = ПолитикаКорневыхОбъектов();
    Маркер.ДатаИнициализации = ТекущаяУниверсальнаяДата(); Маркер.Записать();
    Возврат Новый Структура("policy,workspaces,areas,workspaceCounterKeys,areaCounterKeys,diagnostics", ПолитикаКорневыхОбъектов(), Пространства.Количество(), Области.Количество(), ЧислаПространств.Количество(), ЧислаОбластей.Количество(), Диагностика);
КонецФункции
