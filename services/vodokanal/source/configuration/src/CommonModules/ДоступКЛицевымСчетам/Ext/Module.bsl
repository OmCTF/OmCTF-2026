
Функция ЗапроситьПривязкуЛицевогоСчета(СсылкаУчетнойЗаписи, ЛицевойУчетнаяЗаписьИдентификатор, ИдентификаторЗапроса) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ЛицевойСсылка = Справочники.ЛицевыеСчета.ПолучитьСсылку(РазобратьИдентификатор(ЛицевойУчетнаяЗаписьИдентификатор));
    ИдентификаторЗапроса = Строка(РазобратьИдентификатор(ИдентификаторЗапроса));
    ПредварительныйСнимок = СтрокаЛицевогоСчета(ЛицевойСсылка, Ложь);
    НачатьИзменениеДанных(СсылкаУчетнойЗаписи, СсылкаУчетнойЗаписи, ПредварительныйСнимок.РабочееПространство, ПредварительныйСнимок.Область);
    Попытка
        Адресат = СтрокаЛицевогоСчета(ЛицевойСсылка, Ложь);
        ПроверитьОбластьЦелевогоОбъекта(Адресат, ПредварительныйСнимок.РабочееПространство, ПредварительныйСнимок.Область);
        ЗаблокироватьКлючЗаявки(СсылкаУчетнойЗаписи, ИдентификаторЗапроса);
        Привязка = РегистрыСведений.ПривязкиЗаявокДоступаКСчетам.СоздатьМенеджерЗаписи();
        Привязка.УчетнаяЗапись = СсылкаУчетнойЗаписи;
        Привязка.ИдентификаторЗапроса = ИдентификаторЗапроса;
        Привязка.Прочитать();
        Если Привязка.Выбран() Тогда
            Объект = Привязка.ЗаявкаНаСвязь.ПолучитьОбъект();
            Если Объект = Неопределено Тогда
                ВызватьИсключение "кабинет_абонент_запрос_привязка_конфликт";
            КонецЕсли;
            Если Объект.ПометкаУдаления Или Объект.УчетнаяЗапись <> СсылкаУчетнойЗаписи Или Объект.ИдентификаторЗапроса <> ИдентификаторЗапроса
                Или Объект.ЛицевойСчет <> ЛицевойСсылка Или Объект.РабочееПространство <> Адресат.РабочееПространство Или Объект.Область <> Адресат.Область Тогда
                ВызватьИсключение "кабинет_абонент_запрос_привязка_конфликт";
            КонецЕсли;
        Иначе
            Запрос = Новый Запрос(
                "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК ОжидающийКоличество ИЗ Справочник.ЗаявкиДоступаКСчетам
                |ГДЕ УчетнаяЗапись = &УчетнаяЗапись И Состояние = &Ожидающий И НЕ ПометкаУдаления");
            Запрос.УстановитьПараметр("УчетнаяЗапись", СсылкаУчетнойЗаписи);
            Запрос.УстановитьПараметр("Ожидающий", "Pending");
            Счетчики = Запрос.Выполнить().Выбрать();
            Счетчики.Следующий();
            Если Счетчики.ОжидающийКоличество >= 10 Тогда
                ВызватьИсключение "кабинет_абонент_ожидание_квота_превышено";
            КонецЕсли;
            Объект = Справочники.ЗаявкиДоступаКСчетам.СоздатьЭлемент();
            Объект.SetNewObjectRef(Справочники.ЗаявкиДоступаКСчетам.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
            Объект.Наименование = "Personal account confirmation";
            Объект.РабочееПространство = Адресат.РабочееПространство;
            Объект.Область = Адресат.Область;
            Объект.УчетнаяЗапись = СсылкаУчетнойЗаписи;
            Объект.ЛицевойСчет = ЛицевойСсылка;
            Объект.ИдентификаторЗапроса = ИдентификаторЗапроса;
            Объект.Состояние = "Pending";
            Объект.Ревизия = 1;
            Объект.ДатаСоздания = ТекущаяУниверсальнаяДата();
            Объект.Записать();
            Привязка.УчетнаяЗапись = СсылкаУчетнойЗаписи;
            Привязка.ИдентификаторЗапроса = ИдентификаторЗапроса;
            Привязка.ЗаявкаНаСвязь = Объект.Ссылка;
            Привязка.Записать();
            ПолитикаДоступа.ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, Адресат.РабочееПространство, "customer.link.request", Строка(Объект.Ссылка.УникальныйИдентификатор()));
        КонецЕсли;
        Результат = ДанныеЗаявки(Объект);
        ЗафиксироватьТранзакцию();
    Исключение
        ОткатитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СписокМоихЗаявок(СсылкаУчетнойЗаписи, Лимит = Неопределено, Курсор = "") Экспорт
    НачатьЧтениеСобственныхДанных(СсылкаУчетнойЗаписи);
    Попытка
        Запрос = Новый Запрос(
            "ВЫБРАТЬ ПЕРВЫЕ 100 Ссылка, ЛицевойСчет, Состояние, Ревизия, ДатаСоздания, ДатаРешения
            |ИЗ Справочник.ЗаявкиДоступаКСчетам
            |ГДЕ УчетнаяЗапись = &УчетнаяЗапись И НЕ ПометкаУдаления
            |УПОРЯДОЧИТЬ ПО ДатаСоздания УБЫВ, Ссылка");
        Страница = ПолитикаДоступа.ПараметрыСтраницыIAM(СсылкаУчетнойЗаписи, Лимит, Курсор, "myAccountLinks");
        ПолитикаДоступа.НастроитьЗапросСтраницыIAM(Запрос, Страница, "ВЫБРАТЬ ПЕРВЫЕ 100", "Ссылка");
        Запрос.УстановитьПараметр("УчетнаяЗапись", СсылкаУчетнойЗаписи);
        Выборка = Запрос.Выполнить().Выбрать();
        Результат = Новый Массив;
        Пока Выборка.Следующий() Цикл
            Результат.Добавить(ДанныеЗаявки(Выборка));
        КонецЦикла;
        ЗафиксироватьТранзакцию();
    Исключение
        ОткатитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат ПолитикаДоступа.РезультатСтраницыIAM(Результат, Страница);
КонецФункции

Функция СписокОжидающихЗаявок(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, Лимит = Неопределено, Курсор = "") Экспорт
    СсылкаРабочейОбласти = Справочники.РабочиеПространства.ПолучитьСсылку(РазобратьИдентификатор(РабочаяОбластьИдентификатор));
    СсылкаОбласти = Справочники.Области.ПолучитьСсылку(РазобратьИдентификатор(ОбластьИдентификатор));
    НачатьИзменениеДанных(СсылкаУчетнойЗаписи, СсылкаУчетнойЗаписи, СсылкаРабочейОбласти, СсылкаОбласти);
    Попытка
        ПроверитьПолномочияСотрудника(СсылкаУчетнойЗаписи, СсылкаРабочейОбласти, СсылкаОбласти);
        Запрос = Новый Запрос(
            "ВЫБРАТЬ ПЕРВЫЕ 100 Ссылка, РабочееПространство, Область, УчетнаяЗапись, ЛицевойСчет, Состояние, Ревизия,
            |ДатаСоздания, ДатаРешения, КемПринятоРешение, Причина
            |ИЗ Справочник.ЗаявкиДоступаКСчетам
            |ГДЕ РабочееПространство = &РабочееПространство И Область = &Область И Состояние = &Ожидающий И НЕ ПометкаУдаления
            |УПОРЯДОЧИТЬ ПО ДатаСоздания, Ссылка");
        Страница = ПолитикаДоступа.ПараметрыСтраницыIAM(СсылкаУчетнойЗаписи, Лимит, Курсор, "pendingAccountLinks",
            Строка(СсылкаРабочейОбласти.УникальныйИдентификатор()) + "/" + Строка(СсылкаОбласти.УникальныйИдентификатор()) + "/Pending");
        ПолитикаДоступа.НастроитьЗапросСтраницыIAM(Запрос, Страница, "ВЫБРАТЬ ПЕРВЫЕ 100", "Ссылка");
        Запрос.УстановитьПараметр("РабочееПространство", СсылкаРабочейОбласти);
        Запрос.УстановитьПараметр("Область", СсылкаОбласти);
        Запрос.УстановитьПараметр("Ожидающий", "Pending");
        Выборка = Запрос.Выполнить().Выбрать();
        Результат = Новый Массив;
        Пока Выборка.Следующий() Цикл
            Данные = ДанныеЗаявки(Выборка);
            Данные.Вставить("workspaceId", Строка(Выборка.РабочееПространство.УникальныйИдентификатор()));
            Данные.Вставить("areaId", Строка(Выборка.Область.УникальныйИдентификатор()));
            Данные.Вставить("accountId", Строка(Выборка.УчетнаяЗапись.УникальныйИдентификатор()));
            Результат.Добавить(Данные);
        КонецЦикла;
        ЗафиксироватьТранзакцию();
    Исключение
        ОткатитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат ПолитикаДоступа.РезультатСтраницыIAM(Результат, Страница);
КонецФункции

Функция ОдобритьЗаявку(СсылкаУчетнойЗаписи, СвязатьЗапросКлиентаИдентификатор, ОжидаемаяРевизия, Причина) Экспорт
    Возврат ПринятьРешениеПоЗаявке(СсылкаУчетнойЗаписи, СвязатьЗапросКлиентаИдентификатор, ОжидаемаяРевизия, Причина, "Approved");
КонецФункции

Функция ОтклонитьЗаявку(СсылкаУчетнойЗаписи, СвязатьЗапросКлиентаИдентификатор, ОжидаемаяРевизия, Причина) Экспорт
    Возврат ПринятьРешениеПоЗаявке(СсылкаУчетнойЗаписи, СвязатьЗапросКлиентаИдентификатор, ОжидаемаяРевизия, Причина, "Rejected");
КонецФункции

Функция ОтменитьЗаявку(СсылкаУчетнойЗаписи, СвязатьЗапросКлиентаИдентификатор, ОжидаемаяРевизия) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьНомерРевизии(ОжидаемаяРевизия);
    ИдентификаторСсылки = Справочники.ЗаявкиДоступаКСчетам.ПолучитьСсылку(РазобратьИдентификатор(СвязатьЗапросКлиентаИдентификатор));
    ПредварительныйСнимок = ОбъектЗаявки(ИдентификаторСсылки);
    Если ПредварительныйСнимок.УчетнаяЗапись <> СсылкаУчетнойЗаписи Тогда
        ВызватьИсключение "кабинет_абонент_запрос_не_найдено";
    КонецЕсли;
    НачатьИзменениеДанных(СсылкаУчетнойЗаписи, СсылкаУчетнойЗаписи, ПредварительныйСнимок.РабочееПространство, ПредварительныйСнимок.Область);
    Попытка
        ЗаблокироватьОбъектПоСсылке("Справочник.ЗаявкиДоступаКСчетам", ИдентификаторСсылки);
        Объект = ОбъектЗаявки(ИдентификаторСсылки);
        ПроверитьСнимокЗаявки(Объект, ПредварительныйСнимок);
        Если Объект.УчетнаяЗапись <> СсылкаУчетнойЗаписи Тогда
            ВызватьИсключение "кабинет_абонент_запрос_не_найдено";
        КонецЕсли;
        Если Не ТочныйПовторРешения(Объект, СсылкаУчетнойЗаписи, ОжидаемаяРевизия, "Cancelled", "") Тогда
            ПроверитьРевизиюОжидающейЗаявки(Объект, ОжидаемаяРевизия);
            УстановитьРешениеПоЗаявке(Объект, СсылкаУчетнойЗаписи, "Cancelled", "");
            ПолитикаДоступа.ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, Объект.РабочееПространство, "customer.link.cancel", Строка(ИдентификаторСсылки.УникальныйИдентификатор()));
        КонецЕсли;
        Результат = ДанныеЗаявки(Объект);
        ЗафиксироватьТранзакцию();
    Исключение
        ОткатитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ОтозватьДоступКЛицевомуСчету(СсылкаУчетнойЗаписи, СвязатьИдентификатор, ОжидаемаяРевизия, Причина = "") Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьНомерРевизии(ОжидаемаяРевизия);
    Причина = ПроверенноеОснование(Причина, Ложь);
    ИдентификаторСсылки = Справочники.СвязиДоступаКЛицевымСчетам.ПолучитьСсылку(РазобратьИдентификатор(СвязатьИдентификатор));
    ПредварительныйСнимок = ОбъектСвязиСЛицевымСчетом(ИдентификаторСсылки);
    НачатьИзменениеДанных(СсылкаУчетнойЗаписи, ПредварительныйСнимок.УчетнаяЗапись, ПредварительныйСнимок.РабочееПространство, ПредварительныйСнимок.Область);
    Попытка
        ЗаблокироватьКлючСвязи(ПредварительныйСнимок.УчетнаяЗапись, ПредварительныйСнимок.ЛицевойСчет);
        Связь = ОбъектСвязиСЛицевымСчетом(ИдентификаторСсылки);
        ПроверитьСнимокСвязи(Связь, ПредварительныйСнимок);
        Привязка = ПрочитатьПривязкуСвязи(Связь.УчетнаяЗапись, Связь.ЛицевойСчет);
        Если Не Привязка.Выбран() Тогда
            ВызватьИсключение "кабинет_абонент_связь_привязка_конфликт";
        КонецЕсли;
        Если Привязка.Связь <> Связь.Ссылка Тогда
            ВызватьИсключение "кабинет_абонент_связь_привязка_конфликт";
        КонецЕсли;
        Если Связь.УчетнаяЗапись <> СсылкаУчетнойЗаписи Тогда
            ПроверитьПолномочияСотрудника(СсылкаУчетнойЗаписи, Связь.РабочееПространство, Связь.Область);
            Причина = ПроверенноеОснование(Причина, Истина);
        КонецЕсли;
        Если Связь.Состояние = "Revoked" И Связь.РевизияДоИзмененияСостояния = ОжидаемаяРевизия И Связь.Ревизия = ОжидаемаяРевизия + 1
            И Связь.КемОтозвано = СсылкаУчетнойЗаписи И Связь.ОснованиеОтзыва = Причина Тогда
        Иначе
            Если Связь.Ревизия <> ОжидаемаяРевизия Тогда
                ВызватьИсключение "кабинет_редакция_конфликт";
            КонецЕсли;
            Если Связь.Состояние <> "Active" Тогда
                ВызватьИсключение "кабинет_абонент_связь_состояние_конфликт";
            КонецЕсли;
            ПроверитьВозможностьУвеличения(Связь.Ревизия);
            Связь.РевизияДоИзмененияСостояния = Связь.Ревизия;
            Связь.Состояние = "Revoked";
            Связь.Ревизия = Связь.Ревизия + 1;
            Связь.КемОтозвано = СсылкаУчетнойЗаписи;
            Связь.ДатаОтзыва = ТекущаяУниверсальнаяДата();
            Связь.ОснованиеОтзыва = Причина;
            Связь.Записать();
            ПолитикаДоступа.ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, Связь.РабочееПространство, "customer.link.revoke", Строка(ИдентификаторСсылки.УникальныйИдентификатор()));
        КонецЕсли;
        Результат = ДанныеСвязиСЛицевымСчетом(Связь);
        ЗафиксироватьТранзакцию();
    Исключение
        ОткатитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПолучитьСобственныйЛицевойСчет(СсылкаУчетнойЗаписи, Идентификатор) Экспорт
    НачатьЧтениеСобственныхДанных(СсылкаУчетнойЗаписи);
    Попытка
        Разрешенный = ПроверитьДоступКЛицевомуСчету(СсылкаУчетнойЗаписи, Идентификатор, "Read", Ложь);
        Лицевой = Разрешенный.ЛицевойСчет;
        Связь = Разрешенный.Связь;
        Результат = Новый Структура("id,workspaceId,areaId,numberNormalized,state,contractId,propertyId,servicePointId,address,linkId,linkRevision,expiresAt",
            Строка(Лицевой.Ссылка.УникальныйИдентификатор()), Строка(Лицевой.РабочееПространство.УникальныйИдентификатор()), Строка(Лицевой.Область.УникальныйИдентификатор()),
            Лицевой.НормализованныйНомер, Лицевой.Состояние, Строка(Лицевой.Договор.УникальныйИдентификатор()), Строка(Лицевой.ОбъектНедвижимости.УникальныйИдентификатор()),
            Строка(Лицевой.ТочкаОбслуживания.УникальныйИдентификатор()), Лицевой.ОбъектНедвижимости.Адрес, Строка(Связь.Ссылка.УникальныйИдентификатор()), Связь.Ревизия, XMLСтрока(Связь.СрокИстечения) + "Z");
        ЗафиксироватьТранзакцию();
    Исключение
        ОткатитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПолучитьСобственныеЛицевыеСчета(СсылкаУчетнойЗаписи, ЛимитСтраницы = 100, КурсорСтраницы = "", ВернутьСтраницу = Ложь) Экспорт
    Если ТипЗнч(ВернутьСтраницу) <> Тип("Булево") Или ТипЗнч(ЛимитСтраницы) <> Тип("Число") Тогда ВызватьИсключение "кабинет_абонент_некорректно_страница"; КонецЕсли;
    Если ЛимитСтраницы < 1 Или ЛимитСтраницы > 100 Или Окр(ЛимитСтраницы, 0) <> ЛимитСтраницы Тогда ВызватьИсключение "кабинет_абонент_некорректно_страница"; КонецЕсли;
    Если ТипЗнч(КурсорСтраницы) <> Тип("Строка") Тогда ВызватьИсключение "кабинет_абонент_некорректно_страница"; КонецЕсли;
    Если Не ВернутьСтраницу И КурсорСтраницы <> "" Тогда ВызватьИсключение "кабинет_абонент_некорректно_страница"; КонецЕсли;
    НачатьЧтениеСобственныхДанных(СсылкаУчетнойЗаписи);
    Попытка
        Страница = ПолитикаДоступа.ПараметрыСтраницыIAM(СсылкаУчетнойЗаписи,
            ?(ВернутьСтраницу, ЛимитСтраницы, Неопределено), КурсорСтраницы, "personalAccounts");
        Запрос = Новый Запрос(
            "ВЫБРАТЬ ПЕРВЫЕ 100 Лицевой.Ссылка КАК Ссылка, Лицевой.РабочееПространство КАК РабочееПространство, Лицевой.Область КАК Область,
            |Лицевой.НормализованныйНомер КАК НормализованныйНомер, Лицевой.Состояние КАК Состояние, Лицевой.Договор КАК Договор,
            |Лицевой.ОбъектНедвижимости КАК ОбъектНедвижимости, Лицевой.ТочкаОбслуживания КАК ТочкаОбслуживания, Лицевой.ОбъектНедвижимости.Адрес КАК Адрес,
            |СвязатьСтрокаВыборки.Ссылка КАК Связь, СвязатьСтрокаВыборки.Ревизия КАК СвязатьРевизия, СвязатьСтрокаВыборки.СрокИстечения КАК СрокИстечения
            |ИЗ РегистрСведений.ПривязкиДоступаКЛицевымСчетам КАК Привязка
            |ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СвязиДоступаКЛицевымСчетам КАК СвязатьСтрокаВыборки ПО Привязка.Связь = СвязатьСтрокаВыборки.Ссылка
            |ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЛицевыеСчета КАК Лицевой ПО Привязка.ЛицевойСчет = Лицевой.Ссылка
            |ГДЕ Привязка.УчетнаяЗапись = &УчетнаяЗапись И СвязатьСтрокаВыборки.УчетнаяЗапись = &УчетнаяЗапись
            |И СвязатьСтрокаВыборки.ЛицевойСчет = Лицевой.Ссылка И СвязатьСтрокаВыборки.РабочееПространство = Лицевой.РабочееПространство
            |И СвязатьСтрокаВыборки.Область = Лицевой.Область И СвязатьСтрокаВыборки.Состояние = &Действующий И НЕ СвязатьСтрокаВыборки.ПометкаУдаления
            |И (СвязатьСтрокаВыборки.СрокИстечения = &НетИстечениеСрока ИЛИ СвязатьСтрокаВыборки.СрокИстечения > &ТекущееВремя)
            |И НЕ Лицевой.ПометкаУдаления И (Лицевой.Состояние = &Действующий ИЛИ Лицевой.Состояние = &Закрытый)
            |И Лицевой.РабочееПространство.Состояние = &Действующий И НЕ Лицевой.РабочееПространство.ПометкаУдаления
            |И Лицевой.Область.РабочееПространство = Лицевой.РабочееПространство И Лицевой.Область.Состояние = &Действующий И НЕ Лицевой.Область.ПометкаУдаления
            |И Лицевой.Договор.РабочееПространство = Лицевой.РабочееПространство И Лицевой.Договор.Область = Лицевой.Область И НЕ Лицевой.Договор.ПометкаУдаления
            |И Лицевой.ОбъектНедвижимости.РабочееПространство = Лицевой.РабочееПространство И Лицевой.ОбъектНедвижимости.Область = Лицевой.Область И НЕ Лицевой.ОбъектНедвижимости.ПометкаУдаления
            |И Лицевой.ТочкаОбслуживания.РабочееПространство = Лицевой.РабочееПространство И Лицевой.ТочкаОбслуживания.Область = Лицевой.Область И НЕ Лицевой.ТочкаОбслуживания.ПометкаУдаления
            |И Лицевой.Договор.Абонент.РабочееПространство = Лицевой.РабочееПространство И Лицевой.Договор.Абонент.Область = Лицевой.Область
            |И НЕ Лицевой.Договор.Абонент.ПометкаУдаления
            |И Лицевой.ОбъектНедвижимости.АбонентВладелец = Лицевой.Договор.Абонент
            |И Лицевой.Договор.ОбъектНедвижимости = Лицевой.ОбъектНедвижимости И Лицевой.Договор.ТочкаОбслуживания = Лицевой.ТочкаОбслуживания
            |И Лицевой.ТочкаОбслуживания.ОбъектНедвижимости = Лицевой.ОбъектНедвижимости И Лицевой.ТочкаОбслуживания.ВидУслуги = Лицевой.Договор.ВидУслуги
            |И (Лицевой.Договор.Состояние = &Действующий ИЛИ Лицевой.Договор.Состояние = &Закрытый)
            |И (Лицевой.ОбъектНедвижимости.Состояние = &Действующий ИЛИ Лицевой.ОбъектНедвижимости.Состояние = &Закрытый)
            |И (Лицевой.ТочкаОбслуживания.Состояние = &Действующий ИЛИ Лицевой.ТочкаОбслуживания.Состояние = &Закрытый)
            |И (Лицевой.Договор.Абонент.Состояние = &Действующий ИЛИ Лицевой.Договор.Абонент.Состояние = &Закрытый)
            |УПОРЯДОЧИТЬ ПО Лицевой.НормализованныйНомер, Лицевой.Ссылка");
        ПолитикаДоступа.НастроитьЗапросСтраницыIAM(Запрос, Страница, "ВЫБРАТЬ ПЕРВЫЕ 100", "Лицевой.Ссылка");
        Запрос.УстановитьПараметр("УчетнаяЗапись", СсылкаУчетнойЗаписи);
        Запрос.УстановитьПараметр("Действующий", "Active");
        Запрос.УстановитьПараметр("Закрытый", "Closed");
        Запрос.УстановитьПараметр("НетИстечениеСрока", Дата(1, 1, 1));
        Запрос.УстановитьПараметр("ТекущееВремя", ТекущаяУниверсальнаяДата());
        Выборка = Запрос.Выполнить().Выбрать();
        Результат = Новый Массив;
        Пока Выборка.Следующий() Цикл
            Результат.Добавить(Новый Структура("id,workspaceId,areaId,numberNormalized,state,contractId,propertyId,servicePointId,address,linkId,linkRevision,expiresAt",
                Строка(Выборка.Ссылка.УникальныйИдентификатор()), Строка(Выборка.РабочееПространство.УникальныйИдентификатор()), Строка(Выборка.Область.УникальныйИдентификатор()), Выборка.НормализованныйНомер,
                Выборка.Состояние, Строка(Выборка.Договор.УникальныйИдентификатор()), Строка(Выборка.ОбъектНедвижимости.УникальныйИдентификатор()), Строка(Выборка.ТочкаОбслуживания.УникальныйИдентификатор()),
                Выборка.Адрес, Строка(Выборка.Связь.УникальныйИдентификатор()), Выборка.СвязатьРевизия, XMLСтрока(Выборка.СрокИстечения) + "Z"));
        КонецЦикла;
        ЗафиксироватьТранзакцию();
    Исключение
        ОткатитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат ПолитикаДоступа.РезультатСтраницыIAM(Результат, Страница);
КонецФункции

Функция ПолучитьСобственныеЛицевыеСчетаСтраница(СсылкаУчетнойЗаписи, Лимит = 25, Курсор = "") Экспорт
    Возврат ПолучитьСобственныеЛицевыеСчета(СсылкаУчетнойЗаписи, Лимит, Курсор, Истина);
КонецФункции

Функция ПроверитьВладельцаОбъекта(СсылкаУчетнойЗаписи, СсылкаОбъекта) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    Если Не ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_абонент_транзакция_требуется"; КонецЕсли;
    Объект = КонтекстСобственногоОбъекта(СсылкаОбъекта);
    ЗаблокироватьУчетныеЗаписи(СсылкаУчетнойЗаписи, СсылкаУчетнойЗаписи);
    ЗаблокироватьОбъектПоСсылке("Справочник.РабочиеПространства", Объект.РабочееПространство);
    ЗаблокироватьОбъектПоСсылке("Справочник.Области", Объект.Область);
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    Объект = КонтекстСобственногоОбъекта(СсылкаОбъекта);
    Если Не ЕстьПодтвержденнаяЛичнаяСвязьОбъекта(СсылкаУчетнойЗаписи, Объект) Тогда ВызватьИсключение "кабинет_абонент_учетная_запись_не_найдено"; КонецЕсли;
    Возврат Объект;
КонецФункции

Функция ПолучательИмеетДоступКОбъекту(СсылкаИнициатора, СсылкаПолучателя, СсылкаОбъекта) Экспорт
    ПроверитьТекущегоУчастника(СсылкаИнициатора);
    Если Не ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_абонент_транзакция_требуется"; КонецЕсли;
    Если ТипЗнч(СсылкаПолучателя) <> Тип("СправочникСсылка.УчетныеЗаписи") Тогда ВызватьИсключение "кабинет_абонент_некорректно_участник"; КонецЕсли;
    Объект = КонтекстСобственногоОбъекта(СсылкаОбъекта);
    ЗаблокироватьУчетныеЗаписи(СсылкаИнициатора, СсылкаПолучателя);
    ЗаблокироватьОбъектПоСсылке("Справочник.РабочиеПространства", Объект.РабочееПространство);
    ЗаблокироватьОбъектПоСсылке("Справочник.Области", Объект.Область);
    ПолитикаДоступа.ПроверитьДоступКОбласти(СсылкаИнициатора, Строка(Объект.РабочееПространство.УникальныйИдентификатор()),
        Строка(Объект.Область.УникальныйИдентификатор()), "Dispatcher");
    Объект = КонтекстСобственногоОбъекта(СсылкаОбъекта);
    Получатель = СсылкаПолучателя.ПолучитьОбъект();
    Если Получатель = Неопределено Тогда Возврат Ложь; КонецЕсли;
    Если Получатель.ПометкаУдаления Или Получатель.Состояние <> "Active" Тогда Возврат Ложь; КонецЕсли;
    Возврат ЕстьПодтвержденнаяЛичнаяСвязьОбъекта(СсылкаПолучателя, Объект);
КонецФункции

Функция КонтекстСобственногоОбъекта(СсылкаОбъекта)
    Если ТипЗнч(СсылкаОбъекта) <> Тип("СправочникСсылка.ОбъектыНедвижимости") Тогда ВызватьИсключение "кабинет_абонент_учетная_запись_не_найдено"; КонецЕсли;
    Объект = СсылкаОбъекта.ПолучитьОбъект();
    Если Объект = Неопределено Тогда ВызватьИсключение "кабинет_абонент_учетная_запись_не_найдено"; КонецЕсли;
    Если Объект.ПометкаУдаления Или Объект.Состояние <> "Active" Или Объект.РабочееПространство.ПометкаУдаления
        Или Объект.РабочееПространство.Состояние <> "Active" Или Объект.Область.ПометкаУдаления
        Или Объект.Область.Состояние <> "Active" Или Объект.Область.РабочееПространство <> Объект.РабочееПространство Тогда
        ВызватьИсключение "кабинет_абонент_учетная_запись_не_найдено";
    КонецЕсли;
    Возврат Объект;
КонецФункции

Функция ЕстьПодтвержденнаяЛичнаяСвязьОбъекта(УчетнаяЗапись, Объект)
    Запрос = Новый Запрос(
        "ВЫБРАТЬ Привязка.ЛицевойСчет КАК ЛицевойСчет ИЗ РегистрСведений.ПривязкиДоступаКЛицевымСчетам КАК Привязка
        |ГДЕ Привязка.УчетнаяЗапись = &УчетнаяЗапись И Привязка.ЛицевойСчет.ОбъектНедвижимости = &Объект
        |УПОРЯДОЧИТЬ ПО Привязка.ЛицевойСчет");
    Запрос.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись); Запрос.УстановитьПараметр("Объект", Объект.Ссылка);
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        ЗаблокироватьКлючСвязи(УчетнаяЗапись, Выборка.ЛицевойСчет);
        Привязка = ПрочитатьПривязкуСвязи(УчетнаяЗапись, Выборка.ЛицевойСчет);
        Если Не Привязка.Выбран() Тогда Продолжить; КонецЕсли;
        Связь = Привязка.Связь.ПолучитьОбъект();
        Если Связь = Неопределено Тогда Продолжить; КонецЕсли;
        Если Связь.ПометкаУдаления Или Связь.Состояние <> "Active" Или Связь.УчетнаяЗапись <> УчетнаяЗапись
            Или Связь.ЛицевойСчет <> Выборка.ЛицевойСчет Или Связь.РабочееПространство <> Объект.РабочееПространство
            Или Связь.Область <> Объект.Область Или (Связь.СрокИстечения <> Дата(1, 1, 1) И Связь.СрокИстечения <= ТекущаяУниверсальнаяДата()) Тогда Продолжить; КонецЕсли;
        Основание = Связь.ЗапросПолномочия.ПолучитьОбъект();
        Если Основание = Неопределено Тогда Продолжить; КонецЕсли;
        Если Основание.ПометкаУдаления Или Основание.Состояние <> "Approved" Или Основание.УчетнаяЗапись <> УчетнаяЗапись
            Или Основание.ЛицевойСчет <> Выборка.ЛицевойСчет Или Основание.РабочееПространство <> Объект.РабочееПространство
            Или Основание.Область <> Объект.Область Тогда Продолжить; КонецЕсли;
        Попытка
            Проверенный = СтрокаЛицевогоСчета(Выборка.ЛицевойСчет, Истина);
        Исключение
            Если СтрНайти(ОписаниеОшибки(), "кабинет_абонент_учетная_запись_не_найдено") > 0 Тогда Продолжить; КонецЕсли;
            ВызватьИсключение;
        КонецПопытки;
        Если Проверенный.РабочееПространство = Объект.РабочееПространство И Проверенный.Область = Объект.Область Тогда Возврат Истина; КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

Функция ПроверитьЛицевойСчет(СсылкаУчетнойЗаписи, Идентификатор, Полномочие = "Read") Экспорт
    Разрешенный = ПроверитьДоступКЛицевомуСчету(СсылкаУчетнойЗаписи, Идентификатор, Полномочие, Истина);
    Возврат Разрешенный.ЛицевойСчет;
КонецФункции

Функция ПринятьРешениеПоЗаявке(СсылкаУчетнойЗаписи, СвязатьЗапросКлиентаИдентификатор, ОжидаемаяРевизия, Причина, НовыйСостояние)
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьНомерРевизии(ОжидаемаяРевизия);
    Причина = ПроверенноеОснование(Причина, Истина);
    ИдентификаторСсылки = Справочники.ЗаявкиДоступаКСчетам.ПолучитьСсылку(РазобратьИдентификатор(СвязатьЗапросКлиентаИдентификатор));
    ПредварительныйСнимок = ОбъектЗаявки(ИдентификаторСсылки);
    НачатьИзменениеДанных(СсылкаУчетнойЗаписи, ПредварительныйСнимок.УчетнаяЗапись, ПредварительныйСнимок.РабочееПространство, ПредварительныйСнимок.Область);
    Попытка
        ПроверитьПолномочияСотрудника(СсылкаУчетнойЗаписи, ПредварительныйСнимок.РабочееПространство, ПредварительныйСнимок.Область);
        ПроверитьАктивностьЦелевойУчетнойЗаписи(ПредварительныйСнимок.УчетнаяЗапись);
        ЗаблокироватьОбъектПоСсылке("Справочник.ЗаявкиДоступаКСчетам", ИдентификаторСсылки);
        Объект = ОбъектЗаявки(ИдентификаторСсылки);
        ПроверитьСнимокЗаявки(Объект, ПредварительныйСнимок);
        Адресат = СтрокаЛицевогоСчета(Объект.ЛицевойСчет, Ложь);
        ПроверитьОбластьЦелевогоОбъекта(Адресат, Объект.РабочееПространство, Объект.Область);
        Если Не ТочныйПовторРешения(Объект, СсылкаУчетнойЗаписи, ОжидаемаяРевизия, НовыйСостояние, Причина) Тогда
            ПроверитьРевизиюОжидающейЗаявки(Объект, ОжидаемаяРевизия);
            Если НовыйСостояние = "Approved" Тогда
                ПредоставитьДоступКЛицевомуСчету(Объект);
            КонецЕсли;
            УстановитьРешениеПоЗаявке(Объект, СсылкаУчетнойЗаписи, НовыйСостояние, Причина);
            ПолитикаДоступа.ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, Объект.РабочееПространство, "customer.link." + НРег(НовыйСостояние), Строка(ИдентификаторСсылки.УникальныйИдентификатор()));
        КонецЕсли;
        Результат = ДанныеЗаявки(Объект);
        ЗафиксироватьТранзакцию();
    Исключение
        ОткатитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Процедура ПредоставитьДоступКЛицевомуСчету(Объект)
    ЗаблокироватьКлючСвязи(Объект.УчетнаяЗапись, Объект.ЛицевойСчет);
    Привязка = ПрочитатьПривязкуСвязи(Объект.УчетнаяЗапись, Объект.ЛицевойСчет);
    Если Привязка.Выбран() Тогда
        Связь = ОбъектСвязиСЛицевымСчетом(Привязка.Связь);
        ПроверитьПривязаннуюСвязь(Связь, Объект.УчетнаяЗапись, Объект.ЛицевойСчет, Объект.РабочееПространство, Объект.Область);
        Если Связь.Состояние <> "Revoked" Тогда
            ВызватьИсключение "кабинет_абонент_связь_состояние_конфликт";
        КонецЕсли;
        ПроверитьВозможностьУвеличения(Связь.Ревизия);
    Иначе
        Связь = Справочники.СвязиДоступаКЛицевымСчетам.СоздатьЭлемент();
        Связь.SetNewObjectRef(Справочники.СвязиДоступаКЛицевымСчетам.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
        Связь.Наименование = "Confirmed personal account";
        Связь.РабочееПространство = Объект.РабочееПространство;
        Связь.Область = Объект.Область;
        Связь.УчетнаяЗапись = Объект.УчетнаяЗапись;
        Связь.ЛицевойСчет = Объект.ЛицевойСчет;
        Связь.Ревизия = 0;
    КонецЕсли;
    Связь.Состояние = "Active";
    Связь.СрокИстечения = Дата(1, 1, 1);
    Связь.Ревизия = Связь.Ревизия + 1;
    Связь.ЗапросПолномочия = Объект.Ссылка;
    Связь.РевизияДоИзмененияСостояния = 0;
    Связь.КемОтозвано = Справочники.УчетныеЗаписи.ПустаяСсылка();
    Связь.ДатаОтзыва = Дата(1, 1, 1);
    Связь.ОснованиеОтзыва = "";
    Связь.Записать();
    Привязка.УчетнаяЗапись = Объект.УчетнаяЗапись;
    Привязка.ЛицевойСчет = Объект.ЛицевойСчет;
    Привязка.Связь = Связь.Ссылка;
    Привязка.Записать();
КонецПроцедуры

Функция ПроверитьДоступКЛицевомуСчету(СсылкаУчетнойЗаписи, Идентификатор, Полномочие, РазрешитьСотрудник)
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    Если ТипЗнч(Полномочие) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_абонент_некорректно_право";
    КонецЕсли;
    Если Полномочие <> "Read" И Полномочие <> "SubmitReading" Тогда
        ВызватьИсключение "кабинет_абонент_некорректно_право";
    КонецЕсли;
    Если Не ТранзакцияАктивна() Тогда
        ВызватьИсключение "кабинет_абонент_транзакция_требуется";
    КонецЕсли;
    ЛицевойСсылка = Справочники.ЛицевыеСчета.ПолучитьСсылку(РазобратьИдентификатор(Идентификатор));
    ПредварительныйСнимок = СтрокаЛицевогоСчета(ЛицевойСсылка, Полномочие = "SubmitReading");
    ЗаблокироватьУчетныеЗаписи(СсылкаУчетнойЗаписи, СсылкаУчетнойЗаписи);
    ЗаблокироватьОбъектПоСсылке("Справочник.РабочиеПространства", ПредварительныйСнимок.РабочееПространство);
    ЗаблокироватьОбъектПоСсылке("Справочник.Области", ПредварительныйСнимок.Область);
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    Адресат = СтрокаЛицевогоСчета(ЛицевойСсылка, Полномочие = "SubmitReading");
    ПроверитьОбластьЦелевогоОбъекта(Адресат, ПредварительныйСнимок.РабочееПространство, ПредварительныйСнимок.Область);
    ЗаблокироватьКлючСвязи(СсылкаУчетнойЗаписи, ЛицевойСсылка);
    Привязка = ПрочитатьПривязкуСвязи(СсылкаУчетнойЗаписи, ЛицевойСсылка);
    Связь = Неопределено;
    Разрешенные = Ложь;
    Если Привязка.Выбран() Тогда
        Связь = ОбъектСвязиСЛицевымСчетом(Привязка.Связь);
        ПроверитьПривязаннуюСвязь(Связь, СсылкаУчетнойЗаписи, ЛицевойСсылка, Адресат.РабочееПространство, Адресат.Область);
        Разрешенные = Связь.Состояние = "Active" И (Связь.СрокИстечения = Дата(1, 1, 1) Или Связь.СрокИстечения > ТекущаяУниверсальнаяДата());
    КонецЕсли;
    Если Не Разрешенные Тогда
        Если Не РазрешитьСотрудник Тогда
            ВызватьИсключение "кабинет_абонент_учетная_запись_не_найдено";
        КонецЕсли;
        ПроверитьПолномочияСотрудника(СсылкаУчетнойЗаписи, Адресат.РабочееПространство, Адресат.Область);
    КонецЕсли;
    Лицевой = ЛицевойСсылка.ПолучитьОбъект();
    Если Лицевой = Неопределено Тогда
        ВызватьИсключение "кабинет_абонент_учетная_запись_не_найдено";
    КонецЕсли;
    Возврат Новый Структура("ЛицевойСчет,Связь", Лицевой, Связь);
КонецФункции

Функция СтрокаЛицевогоСчета(ЛицевойСсылка, ДействующийТолько)
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка, РабочееПространство, Область ИЗ Справочник.ЛицевыеСчета
        |ГДЕ Ссылка = &ЛицевойСчет И НЕ ПометкаУдаления
        |И (Состояние = &Действующий ИЛИ (НЕ &ДействующийТолько И Состояние = &Закрытый))
        |И РабочееПространство.Состояние = &Действующий И НЕ РабочееПространство.ПометкаУдаления
        |И Область.РабочееПространство = РабочееПространство И Область.Состояние = &Действующий И НЕ Область.ПометкаУдаления
        |И Договор.РабочееПространство = РабочееПространство И Договор.Область = Область И НЕ Договор.ПометкаУдаления
        |И ОбъектНедвижимости.РабочееПространство = РабочееПространство И ОбъектНедвижимости.Область = Область И НЕ ОбъектНедвижимости.ПометкаУдаления
        |И ТочкаОбслуживания.РабочееПространство = РабочееПространство И ТочкаОбслуживания.Область = Область И НЕ ТочкаОбслуживания.ПометкаУдаления
        |И Договор.Абонент.РабочееПространство = РабочееПространство И Договор.Абонент.Область = Область И НЕ Договор.Абонент.ПометкаУдаления
        |И ОбъектНедвижимости.АбонентВладелец = Договор.Абонент И Договор.ОбъектНедвижимости = ОбъектНедвижимости И Договор.ТочкаОбслуживания = ТочкаОбслуживания
        |И ТочкаОбслуживания.ОбъектНедвижимости = ОбъектНедвижимости И ТочкаОбслуживания.ВидУслуги = Договор.ВидУслуги
        |И (Договор.Состояние = &Действующий ИЛИ (НЕ &ДействующийТолько И Договор.Состояние = &Закрытый))
        |И (ОбъектНедвижимости.Состояние = &Действующий ИЛИ (НЕ &ДействующийТолько И ОбъектНедвижимости.Состояние = &Закрытый))
        |И (ТочкаОбслуживания.Состояние = &Действующий ИЛИ (НЕ &ДействующийТолько И ТочкаОбслуживания.Состояние = &Закрытый))
        |И (Договор.Абонент.Состояние = &Действующий ИЛИ (НЕ &ДействующийТолько И Договор.Абонент.Состояние = &Закрытый))");
    Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСсылка);
    Запрос.УстановитьПараметр("ДействующийТолько", ДействующийТолько);
    Запрос.УстановитьПараметр("Действующий", "Active");
    Запрос.УстановитьПараметр("Закрытый", "Closed");
    Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Тогда
        ВызватьИсключение "кабинет_абонент_учетная_запись_не_найдено";
    КонецЕсли;
    Возврат Новый Структура("Ссылка,РабочееПространство,Область", Выборка.Ссылка, Выборка.РабочееПространство, Выборка.Область);
КонецФункции

Процедура ПроверитьПолномочияСотрудника(СсылкаУчетнойЗаписи, СсылкаРабочейОбласти, СсылкаОбласти)
    ПолитикаДоступа.ПроверитьДоступКОбласти(СсылкаУчетнойЗаписи, Строка(СсылкаРабочейОбласти.УникальныйИдентификатор()), Строка(СсылкаОбласти.УникальныйИдентификатор()), "BillingSpecialist");
КонецПроцедуры

Процедура ПроверитьАктивностьЦелевойУчетнойЗаписи(СсылкаУчетнойЗаписи)
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.УчетныеЗаписи ГДЕ Ссылка = &УчетнаяЗапись И Состояние = &Действующий И НЕ ПометкаУдаления");
    Запрос.УстановитьПараметр("УчетнаяЗапись", СсылкаУчетнойЗаписи);
    Запрос.УстановитьПараметр("Действующий", "Active");
    Если Запрос.Выполнить().Пустой() Тогда
        ВызватьИсключение "кабинет_цель_учетная_запись_отключено";
    КонецЕсли;
КонецПроцедуры

Функция ТочныйПовторРешения(Объект, СсылкаУчетнойЗаписи, ОжидаемаяРевизия, НовыйСостояние, Причина)
    Возврат Объект.Состояние = НовыйСостояние И Объект.РевизияДоИзмененияСостояния = ОжидаемаяРевизия И Объект.Ревизия = ОжидаемаяРевизия + 1
        И Объект.КемПринятоРешение = СсылкаУчетнойЗаписи И Объект.Причина = Причина;
КонецФункции

Процедура ПроверитьРевизиюОжидающейЗаявки(Объект, ОжидаемаяРевизия)
    Если Объект.Ревизия <> ОжидаемаяРевизия Тогда
        ВызватьИсключение "кабинет_редакция_конфликт";
    КонецЕсли;
    Если Объект.Состояние <> "Pending" Тогда
        ВызватьИсключение "кабинет_абонент_запрос_состояние_конфликт";
    КонецЕсли;
    ПроверитьВозможностьУвеличения(Объект.Ревизия);
КонецПроцедуры

Процедура УстановитьРешениеПоЗаявке(Объект, СсылкаУчетнойЗаписи, НовыйСостояние, Причина)
    Объект.РевизияДоИзмененияСостояния = Объект.Ревизия;
    Объект.Ревизия = Объект.Ревизия + 1;
    Объект.Состояние = НовыйСостояние;
    Объект.КемПринятоРешение = СсылкаУчетнойЗаписи;
    Объект.ДатаРешения = ТекущаяУниверсальнаяДата();
    Объект.Причина = Причина;
    Объект.Записать();
КонецПроцедуры

Функция ОбъектЗаявки(ИдентификаторСсылки)
    Объект = ИдентификаторСсылки.ПолучитьОбъект();
    Если Объект = Неопределено Тогда
        ВызватьИсключение "кабинет_абонент_запрос_не_найдено";
    КонецЕсли;
    Если Объект.ПометкаУдаления Тогда
        ВызватьИсключение "кабинет_абонент_запрос_не_найдено";
    КонецЕсли;
    Возврат Объект;
КонецФункции

Функция ОбъектСвязиСЛицевымСчетом(ИдентификаторСсылки)
    Объект = ИдентификаторСсылки.ПолучитьОбъект();
    Если Объект = Неопределено Тогда
        ВызватьИсключение "кабинет_абонент_связь_не_найдено";
    КонецЕсли;
    Если Объект.ПометкаУдаления Тогда
        ВызватьИсключение "кабинет_абонент_связь_не_найдено";
    КонецЕсли;
    Возврат Объект;
КонецФункции

Процедура ПроверитьСнимокЗаявки(Объект, ПредварительныйСнимок)
    Если Объект.УчетнаяЗапись <> ПредварительныйСнимок.УчетнаяЗапись Или Объект.ЛицевойСчет <> ПредварительныйСнимок.ЛицевойСчет
        Или Объект.РабочееПространство <> ПредварительныйСнимок.РабочееПространство Или Объект.Область <> ПредварительныйСнимок.Область Или Объект.ИдентификаторЗапроса <> ПредварительныйСнимок.ИдентификаторЗапроса Тогда
        ВызватьИсключение "кабинет_абонент_запрос_привязка_конфликт";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьСнимокСвязи(Объект, ПредварительныйСнимок)
    ПроверитьПривязаннуюСвязь(Объект, ПредварительныйСнимок.УчетнаяЗапись, ПредварительныйСнимок.ЛицевойСчет, ПредварительныйСнимок.РабочееПространство, ПредварительныйСнимок.Область);
КонецПроцедуры

Процедура ПроверитьПривязаннуюСвязь(Связь, СсылкаУчетнойЗаписи, ЛицевойСсылка, СсылкаРабочейОбласти, СсылкаОбласти)
    Если Связь.УчетнаяЗапись <> СсылкаУчетнойЗаписи Или Связь.ЛицевойСчет <> ЛицевойСсылка
        Или Связь.РабочееПространство <> СсылкаРабочейОбласти Или Связь.Область <> СсылкаОбласти Тогда
        ВызватьИсключение "кабинет_абонент_связь_привязка_конфликт";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьОбластьЦелевогоОбъекта(Адресат, СсылкаРабочейОбласти, СсылкаОбласти)
    Если Адресат.РабочееПространство <> СсылкаРабочейОбласти Или Адресат.Область <> СсылкаОбласти Тогда
        ВызватьИсключение "кабинет_абонент_связь_привязка_конфликт";
    КонецЕсли;
КонецПроцедуры

Функция ПрочитатьПривязкуСвязи(СсылкаУчетнойЗаписи, ЛицевойСсылка)
    Привязка = РегистрыСведений.ПривязкиДоступаКЛицевымСчетам.СоздатьМенеджерЗаписи();
    Привязка.УчетнаяЗапись = СсылкаУчетнойЗаписи;
    Привязка.ЛицевойСчет = ЛицевойСсылка;
    Привязка.Прочитать();
    Возврат Привязка;
КонецФункции

Процедура НачатьИзменениеДанных(СсылкаУчетнойЗаписи, ДругойУчетнаяЗапись, СсылкаРабочейОбласти, СсылкаОбласти)
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьОтсутствиеТранзакции();
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьУчетныеЗаписи(СсылкаУчетнойЗаписи, ДругойУчетнаяЗапись);
        ЗаблокироватьОбъектПоСсылке("Справочник.РабочиеПространства", СсылкаРабочейОбласти);
        ЗаблокироватьОбъектПоСсылке("Справочник.Области", СсылкаОбласти);
        ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    Исключение
        ОткатитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

Процедура НачатьЧтениеСобственныхДанных(СсылкаУчетнойЗаписи)
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьОтсутствиеТранзакции();
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьУчетныеЗаписи(СсылкаУчетнойЗаписи, СсылкаУчетнойЗаписи);
        ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    Исключение
        ОткатитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

Процедура ПроверитьОтсутствиеТранзакции()
    Если ТранзакцияАктивна() Тогда
        ВызватьИсключение "кабинет_абонент_вложенная_транзакция";
    КонецЕсли;
КонецПроцедуры

Процедура ОткатитьСобственнуюТранзакцию()
    Если ТранзакцияАктивна() Тогда
        ОтменитьТранзакцию();
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи)
    Текущий = ПолитикаДоступа.ПроверитьУчетнуюЗапись();
    Если ТипЗнч(СсылкаУчетнойЗаписи) <> Тип("СправочникСсылка.УчетныеЗаписи") Тогда
        ВызватьИсключение "кабинет_участник_несовпадение";
    КонецЕсли;
    Если Текущий.Ссылка <> СсылкаУчетнойЗаписи Тогда
        ВызватьИсключение "кабинет_участник_несовпадение";
    КонецЕсли;
КонецПроцедуры

Функция ПроверенноеОснование(Причина, Требуемый)
    Если ТипЗнч(Причина) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_абонент_некорректно_причина";
    КонецЕсли;
    Если СтрДлина(Причина) > 250 Тогда
        ВызватьИсключение "кабинет_абонент_некорректно_причина";
    КонецЕсли;
    Для Позиция = 1 По СтрДлина(Причина) Цикл
        Код = КодСимвола(Причина, Позиция);
        Если Код < 32 Или (Код >= 127 И Код <= 159)
            Или (Код >= 8203 И Код <= 8207) Или (Код >= 8234 И Код <= 8238)
            Или (Код >= 8288 И Код <= 8297) Или Код = 65279 Тогда
            ВызватьИсключение "кабинет_абонент_некорректно_причина";
        КонецЕсли;
    КонецЦикла;
    Причина = СокрЛП(Причина);
    Если Требуемый И ПустаяСтрока(Причина) Тогда
        ВызватьИсключение "кабинет_абонент_некорректно_причина";
    КонецЕсли;
    Возврат Причина;
КонецФункции

Процедура ПроверитьНомерРевизии(Ревизия)
    Если ТипЗнч(Ревизия) <> Тип("Число") Тогда
        ВызватьИсключение "кабинет_некорректно_редакция";
    КонецЕсли;
    Если Ревизия < 0 Или Ревизия >= 999999999999999 Или Окр(Ревизия, 0) <> Ревизия Тогда
        ВызватьИсключение "кабинет_некорректно_редакция";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьВозможностьУвеличения(Ревизия)
    Если Ревизия < 0 Или Ревизия >= 999999999999998 Или Окр(Ревизия, 0) <> Ревизия Тогда
        ВызватьИсключение "кабинет_редакция_конфликт";
    КонецЕсли;
КонецПроцедуры

Функция РазобратьИдентификатор(Идентификатор)
    Если ТипЗнч(Идентификатор) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецЕсли;
    Если СтрДлина(Идентификатор) <> 36 Тогда
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецЕсли;
    Попытка
        Разобранный = Новый УникальныйИдентификатор(Идентификатор);
    Исключение
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецПопытки;
    Если Строка(Разобранный) = "00000000-0000-0000-0000-000000000000" Тогда
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецЕсли;
    Возврат Разобранный;
КонецФункции

Процедура ЗаблокироватьУчетныеЗаписи(СсылкаУчетнойЗаписи, ДругойУчетнаяЗапись)
    Первый = СсылкаУчетнойЗаписи;
    Второй = ДругойУчетнаяЗапись;
    Если Строка(Второй.УникальныйИдентификатор()) < Строка(Первый.УникальныйИдентификатор()) Тогда
        Первый = ДругойУчетнаяЗапись;
        Второй = СсылкаУчетнойЗаписи;
    КонецЕсли;
    Блокировка = Новый БлокировкаДанных;
    Запись = Блокировка.Добавить("Справочник.УчетныеЗаписи");
    Запись.УстановитьЗначение("Ссылка", Первый);
    Запись.Режим = РежимБлокировкиДанных.Исключительный;
    Если Первый <> Второй Тогда
        Запись = Блокировка.Добавить("Справочник.УчетныеЗаписи");
        Запись.УстановитьЗначение("Ссылка", Второй);
        Запись.Режим = РежимБлокировкиДанных.Исключительный;
    КонецЕсли;
    Блокировка.Заблокировать();
КонецПроцедуры

Процедура ЗаблокироватьОбъектПоСсылке(ПространствоИмен, ИдентификаторСсылки)
    Блокировка = Новый БлокировкаДанных;
    Запись = Блокировка.Добавить(ПространствоИмен);
    Запись.УстановитьЗначение("Ссылка", ИдентификаторСсылки);
    Запись.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
КонецПроцедуры

Процедура ЗаблокироватьКлючЗаявки(СсылкаУчетнойЗаписи, ИдентификаторЗапроса)
    Блокировка = Новый БлокировкаДанных;
    Запись = Блокировка.Добавить("РегистрСведений.ПривязкиЗаявокДоступаКСчетам");
    Запись.УстановитьЗначение("УчетнаяЗапись", СсылкаУчетнойЗаписи);
    Запись.УстановитьЗначение("ИдентификаторЗапроса", ИдентификаторЗапроса);
    Запись.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
КонецПроцедуры

Процедура ЗаблокироватьКлючСвязи(СсылкаУчетнойЗаписи, ЛицевойСсылка)
    Блокировка = Новый БлокировкаДанных;
    Запись = Блокировка.Добавить("РегистрСведений.ПривязкиДоступаКЛицевымСчетам");
    Запись.УстановитьЗначение("УчетнаяЗапись", СсылкаУчетнойЗаписи);
    Запись.УстановитьЗначение("ЛицевойСчет", ЛицевойСсылка);
    Запись.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
КонецПроцедуры

Функция ДанныеЗаявки(Объект)
    Возврат Новый Структура("id,personalAccountId,state,revision,createdAt,decidedAt", Строка(Объект.Ссылка.УникальныйИдентификатор()),
        Строка(Объект.ЛицевойСчет.УникальныйИдентификатор()), Объект.Состояние, Объект.Ревизия, XMLСтрока(Объект.ДатаСоздания) + "Z", XMLСтрока(Объект.ДатаРешения) + "Z");
КонецФункции

Функция ДанныеСвязиСЛицевымСчетом(Объект)
    Возврат Новый Структура("id,personalAccountId,state,revision,expiresAt", Строка(Объект.Ссылка.УникальныйИдентификатор()),
        Строка(Объект.ЛицевойСчет.УникальныйИдентификатор()), Объект.Состояние, Объект.Ревизия, XMLСтрока(Объект.СрокИстечения) + "Z");
КонецФункции
