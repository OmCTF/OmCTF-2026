Функция ОбработатьЗапросКабинета(Действие, УчетнаяЗапись, Запрос, Корреляция) Экспорт
    Если Действие = "notifications" Тогда
        СервисЭксплуатации.ПроверитьПараметрыКабинета(Запрос, "limit,cursor,unread");
        Страница = СервисЭксплуатации.ПараметрыСпискаКабинета(Запрос);
        Фильтр = APIКабинета.ТекстПараметраЗапроса(Запрос, "unread", 5);
        Если Фильтр <> "" И Фильтр <> "true" И Фильтр <> "false" Тогда ВызватьИсключение "кабинет_некорректно_фильтр"; КонецЕсли;
        Данные = ПолучитьУведомления(УчетнаяЗапись, Страница.limit, Страница.cursor, Фильтр = "true");
    ИначеЕсли Действие = "notificationSettings" Тогда
        СервисЭксплуатации.ПроверитьПараметрыКабинета(Запрос, ""); Данные = ПолучитьНастройки(УчетнаяЗапись);
    ИначеЕсли Действие = "notificationDeliveries" Тогда
        СервисЭксплуатации.ПроверитьПараметрыКабинета(Запрос, "limit,cursor"); Страница = СервисЭксплуатации.ПараметрыСпискаКабинета(Запрос);
        Данные = ПолучитьОчередь(УчетнаяЗапись, Страница.limit, Страница.cursor);
    Иначе
        СервисЭксплуатации.ПроверитьПараметрыКабинета(Запрос, ""); Тело = APIКабинета.РазобратьТелоЗапроса(Запрос, 1024);
        Если Действие = "notificationRead" Тогда
            СервисЭксплуатации.ПроверитьТелоКабинета(Тело, "expectedRevision");
            Данные = ОтметитьПрочитанным(УчетнаяЗапись, Запрос.ПараметрыURL.Получить("id"), Тело.expectedRevision);
        ИначеЕсли Действие = "notificationSettingsChange" Тогда
            СервисЭксплуатации.ПроверитьТелоКабинета(Тело, "topic,email,sms,expectedRevision");
            Данные = ИзменитьНастройки(УчетнаяЗапись, Тело.topic, Тело.email, Тело.sms, Тело.expectedRevision);
        ИначеЕсли Действие = "notificationRetry" Тогда
            СервисЭксплуатации.ПроверитьТелоКабинета(Тело, "expectedRevision");
            Данные = ПовторитьДоставку(УчетнаяЗапись, Запрос.ПараметрыURL.Получить("id"), Тело.expectedRevision);
        Иначе ВызватьИсключение "кабинет_операции_некорректно_действие"; КонецЕсли;
    КонецЕсли;
    Возврат APIКабинета.СформироватьОтветHTTP(200, Данные, Корреляция);
КонецФункции

Функция СоздатьСобытие(Получатель, Тема, КлючСобытия, ИдентификаторОбъекта, Статус, РабочееПространство = Неопределено, УстановкаПрибора = Неопределено) Экспорт
    Если Не ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_уведомление_транзакция_требуется"; КонецЕсли;
    Если ТипЗнч(Получатель) <> Тип("СправочникСсылка.УчетныеЗаписи") Или Не ЗначениеЗаполнено(Получатель) Тогда
        ВызватьИсключение "кабинет_уведомление_получатель_некорректно";
    КонецЕсли;
    ПроверитьТему(Тема); ПроверитьКлючСобытия(КлючСобытия); ПроверитьКод(Статус, 64);
    ИдентификаторОбъекта = Строка(РазобратьUUID(ИдентификаторОбъекта));
    Если РабочееПространство = Неопределено Тогда РабочееПространство = Справочники.РабочиеПространства.ПустаяСсылка(); КонецЕсли;
    Если ТипЗнч(РабочееПространство) <> Тип("СправочникСсылка.РабочиеПространства") Тогда
        ВызватьИсключение "кабинет_уведомление_контекст_некорректно";
    КонецЕсли;
    Если УстановкаПрибора = Неопределено Тогда УстановкаПрибора = Справочники.УстановкиПриборов.ПустаяСсылка(); КонецЕсли;
    Если ТипЗнч(УстановкаПрибора) <> Тип("СправочникСсылка.УстановкиПриборов") Тогда ВызватьИсключение "кабинет_уведомление_контекст_некорректно"; КонецЕсли;
    Если (Тема = "verification" И Статус = "VerificationDue") <> ЗначениеЗаполнено(УстановкаПрибора) Тогда
        ВызватьИсключение "кабинет_уведомление_контекст_некорректно";
    КонецЕсли;
    Если ЗначениеЗаполнено(УстановкаПрибора) Тогда
        Если Строка(УстановкаПрибора.УникальныйИдентификатор()) <> ИдентификаторОбъекта Тогда ВызватьИсключение "кабинет_уведомление_контекст_некорректно"; КонецЕсли;
        Установка = УстановкаПрибора.ПолучитьОбъект();
        Если Установка = Неопределено Тогда ВызватьИсключение "кабинет_уведомление_контекст_некорректно"; КонецЕсли;
        Если Установка.РабочееПространство <> РабочееПространство Тогда ВызватьИсключение "кабинет_уведомление_контекст_некорректно"; КонецЕсли;
    КонецЕсли;
    ЗаблокироватьПолучателя(Получатель);
    Привязка = РегистрыСведений.ПривязкиУведомлений.СоздатьМенеджерЗаписи();
    Привязка.Получатель = Получатель; Привязка.КлючСобытия = КлючСобытия; Привязка.Прочитать();
    Если Привязка.Выбран() Тогда
        Существующее = Привязка.Уведомление.ПолучитьОбъект();
        Если Существующее = Неопределено Тогда ВызватьИсключение "кабинет_уведомление_привязка_конфликт"; КонецЕсли;
        Если Существующее.Получатель <> Получатель Или Существующее.Тема <> Тема Или Существующее.КлючСобытия <> КлючСобытия
            Или Существующее.ИдентификаторОбъекта <> ИдентификаторОбъекта Или Существующее.СтатусОбъекта <> Статус
            Или Существующее.РабочееПространство <> РабочееПространство Или Существующее.УстановкаПрибора <> УстановкаПрибора Тогда
            ВызватьИсключение "кабинет_уведомление_привязка_конфликт";
        КонецЕсли;
        Возврат Существующее.Ссылка;
    КонецЕсли;
    УчетнаяЗапись = Получатель.ПолучитьОбъект();
    Если УчетнаяЗапись = Неопределено Тогда ВызватьИсключение "кабинет_уведомление_получатель_некорректно"; КонецЕсли;
    Если УчетнаяЗапись.ПометкаУдаления Или УчетнаяЗапись.Состояние <> "Active" Тогда Возврат Неопределено; КонецЕсли;
    ЗапросКвоты = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Справочник.УведомленияКабинета ГДЕ Получатель = &Получатель");
    ЗапросКвоты.УстановитьПараметр("Получатель", Получатель);
    Квота = ЗапросКвоты.Выполнить().Выбрать(); Квота.Следующий();
    Если Квота.Количество >= 10000 Тогда ВызватьИсключение "кабинет_уведомление_квота"; КонецЕсли;
    Если ЗначениеЗаполнено(РабочееПространство) Тогда
        ЗапросКвоты.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Справочник.УведомленияКабинета ГДЕ Получатель = &Получатель И РабочееПространство = &Workspace";
        ЗапросКвоты.УстановитьПараметр("Workspace", РабочееПространство); Квота = ЗапросКвоты.Выполнить().Выбрать(); Квота.Следующий();
        Если Квота.Количество >= СервисЭксплуатации.ПрочитатьЧисловуюНастройку(РабочееПространство, "notificationQuota") Тогда
            ВызватьИсключение "кабинет_уведомление_квота";
        КонецЕсли;
    КонецЕсли;
    Объект = Справочники.УведомленияКабинета.СоздатьЭлемент();
    Объект.SetNewObjectRef(Справочники.УведомленияКабинета.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
    Объект.Наименование = ЗаголовокТемы(Тема); Объект.Получатель = Получатель; Объект.РабочееПространство = РабочееПространство;
    Объект.Тема = Тема; Объект.КлючСобытия = КлючСобытия; Объект.ИдентификаторОбъекта = ИдентификаторОбъекта;
    Объект.УстановкаПрибора = УстановкаПрибора;
    Объект.СтатусОбъекта = Статус; Объект.ДатаСоздания = ТекущаяУниверсальнаяДата(); Объект.Ревизия = 1;
    Объект.Записать();
    Привязка.Получатель = Получатель; Привязка.КлючСобытия = КлючСобытия; Привязка.Уведомление = Объект.Ссылка; Привязка.Записать();
    Настройки = ПрочитатьПредпочтения(Получатель, Тема);
    Если Настройки.Email Тогда ДобавитьВДоставку(Объект, "email"); КонецЕсли;
    Если Настройки.SMS Тогда ДобавитьВДоставку(Объект, "sms"); КонецЕсли;
    Возврат Объект.Ссылка;
КонецФункции

Функция ПолучитьУведомления(УчетнаяЗапись, Лимит = 25, Курсор = "", ТолькоНепрочитанные = Ложь) Экспорт
    ПроверитьВладельца(УчетнаяЗапись); ПроверитьСтраницу(Лимит);
    Если ТипЗнч(ТолькоНепрочитанные) <> Тип("Булево") Тогда ВызватьИсключение "кабинет_некорректно_фильтр"; КонецЕсли;
    После = СсылкаКурсора(Курсор, "notifications", УчетнаяЗапись, ТолькоНепрочитанные);
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит + 1, "ЧГ=0") + " Ссылка, Тема, ИдентификаторОбъекта,
        |СтатусОбъекта, ДатаСоздания, ДатаПрочтения, Ревизия ИЗ Справочник.УведомленияКабинета
        |ГДЕ Получатель = &Получатель И НЕ ПометкаУдаления И Ссылка > &После
        |И (НЕ &ТолькоНепрочитанные ИЛИ ДатаПрочтения = &ПустаяДата) УПОРЯДОЧИТЬ ПО Ссылка");
    Запрос.УстановитьПараметр("Получатель", УчетнаяЗапись); Запрос.УстановитьПараметр("После", После);
    Запрос.УстановитьПараметр("ТолькоНепрочитанные", ТолькоНепрочитанные); Запрос.УстановитьПараметр("ПустаяДата", Дата(1,1,1));
    Выборка = Запрос.Выполнить().Выбрать(); Список = Новый Массив; Еще = Ложь; Следующий = "";
    Пока Выборка.Следующий() Цикл
        Если Список.Количество() = Лимит Тогда Еще = Истина; Прервать; КонецЕсли;
        Список.Добавить(ДанныеУведомления(Выборка));
        Следующий = КурсорСтраницы("notifications", УчетнаяЗапись, ТолькоНепрочитанные, Выборка.Ссылка);
    КонецЦикла;
    Возврат Новый Структура("items,limit,hasMore,nextCursor", Список, Лимит, Еще, ?(Еще, Следующий, ""));
КонецФункции

Функция ОтметитьПрочитанным(УчетнаяЗапись, Идентификатор, ОжидаемаяРевизия) Экспорт
    ПроверитьВладельца(УчетнаяЗапись); ПроверитьРевизию(ОжидаемаяРевизия);
    Ссылка = Справочники.УведомленияКабинета.ПолучитьСсылку(РазобратьUUID(Идентификатор));
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьПолучателя(УчетнаяЗапись); ПроверитьВладельца(УчетнаяЗапись);
        Объект = Ссылка.ПолучитьОбъект();
        Если Объект = Неопределено Тогда ВызватьИсключение "кабинет_уведомление_не_найдено"; КонецЕсли;
        Если Объект.ПометкаУдаления Или Объект.Получатель <> УчетнаяЗапись Тогда ВызватьИсключение "кабинет_уведомление_не_найдено"; КонецЕсли;
        Если Объект.ДатаПрочтения = Дата(1,1,1) Тогда
            Если Объект.Ревизия <> ОжидаемаяРевизия Тогда ВызватьИсключение "кабинет_редакция_конфликт"; КонецЕсли;
            Объект.ДатаПрочтения = ТекущаяУниверсальнаяДата(); Объект.Ревизия = Объект.Ревизия + 1; Объект.Записать();
        ИначеЕсли Объект.Ревизия <> ОжидаемаяРевизия И Объект.Ревизия <> ОжидаемаяРевизия + 1 Тогда
            ВызватьИсключение "кабинет_редакция_конфликт";
        КонецЕсли;
        Результат = ДанныеУведомления(Объект); ЗафиксироватьТранзакцию(); Возврат Результат;
    Исключение
        ОтменитьТранзакцию(); ВызватьИсключение;
    КонецПопытки;
КонецФункции

Функция ПолучитьНастройки(УчетнаяЗапись) Экспорт
    ПроверитьВладельца(УчетнаяЗапись); Список = Новый Массив;
    Для Каждого Тема Из Темы() Цикл
        Настройки = ПрочитатьПредпочтения(УчетнаяЗапись, Тема);
        Список.Добавить(Новый Структура("topic,title,inApp,email,sms,revision", Тема, ЗаголовокТемы(Тема), Истина,
            Настройки.Email, Настройки.SMS, Настройки.Ревизия));
    КонецЦикла;
    Возврат Новый Структура("items,deliveryMode", Список, "local-emulator");
КонецФункции

Функция ИзменитьНастройки(УчетнаяЗапись, Тема, Email, SMS, ОжидаемаяРевизия) Экспорт
    ПроверитьВладельца(УчетнаяЗапись); ПроверитьТему(Тема); ПроверитьРевизию(ОжидаемаяРевизия, Истина);
    Если ТипЗнч(Email) <> Тип("Булево") Или ТипЗнч(SMS) <> Тип("Булево") Тогда ВызватьИсключение "кабинет_некорректно_уведомление_настройки"; КонецЕсли;
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьПолучателя(УчетнаяЗапись); ПроверитьВладельца(УчетнаяЗапись);
        Запись = ПрочитатьПредпочтения(УчетнаяЗапись, Тема);
        Если Запись.Ревизия <> ОжидаемаяРевизия Тогда ВызватьИсключение "кабинет_редакция_конфликт"; КонецЕсли;
        Запись.Получатель = УчетнаяЗапись; Запись.Тема = Тема; Запись.Email = Email; Запись.SMS = SMS;
        Запись.Ревизия = Запись.Ревизия + 1; Запись.ДатаИзменения = ТекущаяУниверсальнаяДата(); Запись.Записать();
        ЗафиксироватьТранзакцию();
        Возврат Новый Структура("topic,title,inApp,email,sms,revision", Тема, ЗаголовокТемы(Тема), Истина, Email, SMS, Запись.Ревизия);
    Исключение
        ОтменитьТранзакцию(); ВызватьИсключение;
    КонецПопытки;
КонецФункции

Функция ПолучитьОчередь(УчетнаяЗапись, Лимит = 25, Курсор = "", WorkspaceID = "") Экспорт
    ПроверитьВладельца(УчетнаяЗапись); ПроверитьСтраницу(Лимит);
    Workspace = Справочники.РабочиеПространства.ПустаяСсылка(); ВидКурсора = "deliveries";
    Если WorkspaceID <> "" Тогда
        Workspace = ПолитикаДоступа.ПроверитьДоступКРабочемуПространству(УчетнаяЗапись, WorkspaceID, "WorkspaceOwner");
        ВидКурсора = "deliveries." + Строка(Workspace.УникальныйИдентификатор());
    КонецЕсли;
    После = СсылкаКурсора(Курсор, ВидКурсора, УчетнаяЗапись, Ложь);
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит + 1, "ЧГ=0") + " Ссылка, Канал, Состояние, Попытки,
        |Ревизия, ДатаСоздания, СледующаяПопытка, ДатаЗавершения, КодОшибки, Квитанция
        |ИЗ Справочник.ОчередьУведомлений ГДЕ ((НЕ &Администрирование И Получатель = &Получатель)
        |ИЛИ (&Администрирование И РабочееПространство = &Workspace)) И Ссылка > &После И НЕ ПометкаУдаления УПОРЯДОЧИТЬ ПО Ссылка");
    Запрос.УстановитьПараметр("Получатель", УчетнаяЗапись); Запрос.УстановитьПараметр("После", После);
    Запрос.УстановитьПараметр("Администрирование", WorkspaceID <> ""); Запрос.УстановитьПараметр("Workspace", Workspace);
    Выборка = Запрос.Выполнить().Выбрать(); Список = Новый Массив; Еще = Ложь; Следующий = "";
    Пока Выборка.Следующий() Цикл
        Если Список.Количество() = Лимит Тогда Еще = Истина; Прервать; КонецЕсли;
        Список.Добавить(ДанныеДоставки(Выборка)); Следующий = КурсорСтраницы(ВидКурсора, УчетнаяЗапись, Ложь, Выборка.Ссылка);
    КонецЦикла;
    Возврат Новый Структура("items,limit,hasMore,nextCursor", Список, Лимит, Еще, ?(Еще, Следующий, ""));
КонецФункции

Функция ПовторитьДоставку(УчетнаяЗапись, Идентификатор, ОжидаемаяРевизия, WorkspaceID = "") Экспорт
    ПроверитьВладельца(УчетнаяЗапись); ПроверитьРевизию(ОжидаемаяРевизия);
    Workspace = Справочники.РабочиеПространства.ПустаяСсылка();
    Если WorkspaceID <> "" Тогда Workspace = ПолитикаДоступа.ПроверитьДоступКРабочемуПространству(УчетнаяЗапись, WorkspaceID, "WorkspaceOwner"); КонецЕсли;
    Ссылка = Справочники.ОчередьУведомлений.ПолучитьСсылку(РазобратьUUID(Идентификатор));
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьЗадание(Ссылка); ПроверитьВладельца(УчетнаяЗапись); Объект = Ссылка.ПолучитьОбъект();
        Если Объект = Неопределено Тогда ВызватьИсключение "кабинет_доставка_не_найдено"; КонецЕсли;
        Если WorkspaceID <> "" Тогда ПолитикаДоступа.ПроверитьДоступКРабочемуПространству(УчетнаяЗапись, WorkspaceID, "WorkspaceOwner"); КонецЕсли;
        Если Объект.ПометкаУдаления Или (WorkspaceID = "" И Объект.Получатель <> УчетнаяЗапись)
            Или (WorkspaceID <> "" И Объект.РабочееПространство <> Workspace) Тогда ВызватьИсключение "кабинет_доставка_не_найдено"; КонецЕсли;
        Если Объект.Ревизия <> ОжидаемаяРевизия Тогда ВызватьИсключение "кабинет_редакция_конфликт"; КонецЕсли;
        Если Объект.Состояние <> "Failed" Или Объект.Попытки >= 5 Тогда ВызватьИсключение "кабинет_доставка_повтор_запрещено"; КонецЕсли;
        Объект.Состояние = "Pending"; Объект.КодОшибки = ""; Объект.СледующаяПопытка = ТекущаяУниверсальнаяДата();
        Объект.Ревизия = Объект.Ревизия + 1; Объект.Записать(); Результат = ДанныеДоставки(Объект);
        ЗафиксироватьТранзакцию(); Возврат Результат;
    Исключение
        ОтменитьТранзакцию(); ВызватьИсключение;
    КонецПопытки;
КонецФункции

Функция ВыполнитьОчередь(Предел = 25) Экспорт
    Если Не РольДоступна("Администратор") Тогда ВызватьИсключение "кабинет_операции_запрещено"; КонецЕсли;
    ПроверитьСтраницу(Предел); Если Предел > 25 Тогда ВызватьИсключение "кабинет_некорректно_лимит"; КонецЕсли;
    Если ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_операции_транзакция_активно"; КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ " + Формат(Предел, "ЧГ=0") + " Ссылка ИЗ Справочник.ОчередьУведомлений
        |ГДЕ Состояние = &Состояние И СледующаяПопытка <= &Сейчас И НЕ ПометкаУдаления УПОРЯДОЧИТЬ ПО СледующаяПопытка, Ссылка");
    Запрос.УстановитьПараметр("Состояние", "Pending"); Запрос.УстановитьПараметр("Сейчас", ТекущаяУниверсальнаяДата());
    Список = Запрос.Выполнить().Выгрузить(); Обработано = 0;
    Для Каждого СтрокаЗадания Из Список Цикл
        Если ВыполнитьДоставку(СтрокаЗадания.Ссылка) Тогда Обработано = Обработано + 1; КонецЕсли;
    КонецЦикла;
    Возврат Обработано;
КонецФункции

Функция ВыполнитьДоставку(Ссылка)
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьЗадание(Ссылка); Объект = Ссылка.ПолучитьОбъект();
        Если Объект = Неопределено Тогда ЗафиксироватьТранзакцию(); Возврат Ложь; КонецЕсли;
        Если Объект.ПометкаУдаления Или Объект.Состояние <> "Pending" Или Объект.СледующаяПопытка > ТекущаяУниверсальнаяДата() Тогда
            ЗафиксироватьТранзакцию(); Возврат Ложь;
        КонецЕсли;
        Объект.Попытки = Объект.Попытки + 1; Объект.Ревизия = Объект.Ревизия + 1;
        Получатель = Объект.Получатель.ПолучитьОбъект();
        Если Получатель = Неопределено Тогда Объект.Состояние = "Failed"; Объект.КодОшибки = "получатель_недоступно";
        ИначеЕсли Получатель.ПометкаУдаления Или Получатель.Состояние <> "Active" Тогда
            Объект.Состояние = "Failed"; Объект.КодОшибки = "получатель_недоступно";
        Иначе
            Квитанция = РегистрыСведений.КвитанцииДоставкиУведомлений.СоздатьМенеджерЗаписи();
            Квитанция.Задание = Ссылка; Квитанция.Прочитать();
            Если Не Квитанция.Выбран() Тогда
                Квитанция.Задание = Ссылка; Квитанция.Квитанция = Строка(СервисДокументов.НовыйUUIDv4());
                Квитанция.ДатаДоставки = ТекущаяУниверсальнаяДата(); Квитанция.Записать();
            КонецЕсли;
            Объект.Квитанция = Квитанция.Квитанция; Объект.ДатаЗавершения = Квитанция.ДатаДоставки;
            Объект.Состояние = "Delivered"; Объект.КодОшибки = "";
        КонецЕсли;
        Объект.Записать(); ЗафиксироватьТранзакцию(); Возврат Истина;
    Исключение
        ОтменитьТранзакцию();
        ЗафиксироватьОшибкаДоставки(Ссылка); Возврат Ложь;
    КонецПопытки;
КонецФункции

Процедура ЗафиксироватьОшибкаДоставки(Ссылка)
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьЗадание(Ссылка); Объект = Ссылка.ПолучитьОбъект();
        Если Объект <> Неопределено Тогда
            Если Объект.Состояние = "Pending" Тогда
                Объект.Попытки = Мин(5, Объект.Попытки + 1); Объект.Состояние = "Failed";
                Объект.КодОшибки = "локальный_доставка_не_удалось"; Объект.Ревизия = Объект.Ревизия + 1; Объект.Записать();
            КонецЕсли;
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию(); ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

Процедура ДобавитьВДоставку(Уведомление, Канал)
    Задание = Справочники.ОчередьУведомлений.СоздатьЭлемент();
    Задание.SetNewObjectRef(Справочники.ОчередьУведомлений.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4())); Задание.Наименование = "Локальная доставка " + Канал;
    Задание.Уведомление = Уведомление.Ссылка; Задание.Получатель = Уведомление.Получатель;
    Задание.РабочееПространство = Уведомление.РабочееПространство; Задание.Канал = Канал; Задание.Состояние = "Pending";
    Задание.Попытки = 0; Задание.Ревизия = 1; Задание.ДатаСоздания = Уведомление.ДатаСоздания;
    Задание.СледующаяПопытка = Уведомление.ДатаСоздания; Задание.Записать();
КонецПроцедуры

Функция ПрочитатьПредпочтения(Получатель, Тема)
    Запись = РегистрыСведений.КаналыУведомлений.СоздатьМенеджерЗаписи();
    Запись.Получатель = Получатель; Запись.Тема = Тема; Запись.Прочитать(); Возврат Запись;
КонецФункции

Функция ДанныеУведомления(Объект)
    Возврат Новый Структура("id,topic,title,objectId,objectState,createdAt,read,readAt,revision",
        Строка(Объект.Ссылка.УникальныйИдентификатор()), Объект.Тема, ЗаголовокТемы(Объект.Тема), Объект.ИдентификаторОбъекта,
        Объект.СтатусОбъекта, XMLСтрока(Объект.ДатаСоздания) + "Z", Объект.ДатаПрочтения <> Дата(1,1,1),
        ?(Объект.ДатаПрочтения = Дата(1,1,1), "", XMLСтрока(Объект.ДатаПрочтения) + "Z"), Объект.Ревизия);
КонецФункции

Функция ДанныеДоставки(Объект)
    Возврат Новый Структура("id,channel,state,attempts,revision,createdAt,nextAttemptAt,completedAt,errorCode,receiptId",
        Строка(Объект.Ссылка.УникальныйИдентификатор()), Объект.Канал, Объект.Состояние, Объект.Попытки, Объект.Ревизия,
        XMLСтрока(Объект.ДатаСоздания) + "Z", XMLСтрока(Объект.СледующаяПопытка) + "Z",
        ?(Объект.ДатаЗавершения = Дата(1,1,1), "", XMLСтрока(Объект.ДатаЗавершения) + "Z"), Объект.КодОшибки, Объект.Квитанция);
КонецФункции

Функция Темы()
    Возврат СтрРазделить("application,request,assignment,result,verification,outage,document", ",");
КонецФункции

Функция ЗаголовокТемы(Тема)
    Заголовки = Новый Соответствие;
    Заголовки.Вставить("application", "Изменился статус заявки"); Заголовки.Вставить("request", "Требуется уточнение заявки");
    Заголовки.Вставить("assignment", "Назначена работа"); Заголовки.Вставить("result", "Получен результат");
    Заголовки.Вставить("verification", "Событие поверки прибора"); Заголовки.Вставить("outage", "Обновление отключения");
    Заголовки.Вставить("document", "Готов документ"); Возврат Заголовки.Получить(Тема);
КонецФункции

Процедура ПроверитьВладельца(УчетнаяЗапись)
    Текущий = ПолитикаДоступа.ПроверитьУчетнуюЗапись();
    Если Текущий.Ссылка <> УчетнаяЗапись Тогда ВызватьИсключение "кабинет_участник_несовпадение"; КонецЕсли;
КонецПроцедуры

Процедура ПроверитьТему(Тема)
    Если ТипЗнч(Тема) <> Тип("Строка") Тогда ВызватьИсключение "кабинет_некорректно_уведомление_тема"; КонецЕсли;
    Если Темы().Найти(Тема) = Неопределено Тогда ВызватьИсключение "кабинет_некорректно_уведомление_тема"; КонецЕсли;
КонецПроцедуры

Процедура ПроверитьКлючСобытия(Значение)
    ПроверитьКод(Значение, 150);
КонецПроцедуры

Процедура ПроверитьКод(Значение, Максимум)
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда ВызватьИсключение "кабинет_некорректно_уведомление_событие"; КонецЕсли;
    Если СтрДлина(Значение) < 1 Или СтрДлина(Значение) > Максимум Тогда ВызватьИсключение "кабинет_некорректно_уведомление_событие"; КонецЕсли;
    Для Номер = 1 По СтрДлина(Значение) Цикл
        Если СтрНайти("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._:-", Сред(Значение, Номер, 1)) = 0 Тогда
            ВызватьИсключение "кабинет_некорректно_уведомление_событие";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура ПроверитьСтраницу(Лимит)
    Если ТипЗнч(Лимит) <> Тип("Число") Тогда ВызватьИсключение "кабинет_некорректно_лимит"; КонецЕсли;
    Если Лимит <> Цел(Лимит) Или Лимит < 1 Или Лимит > 100 Тогда ВызватьИсключение "кабинет_некорректно_лимит"; КонецЕсли;
КонецПроцедуры

Процедура ПроверитьРевизию(Ревизия, НольРазрешен = Ложь)
    Если ТипЗнч(Ревизия) <> Тип("Число") Тогда ВызватьИсключение "кабинет_некорректно_редакция"; КонецЕсли;
    Если Ревизия <> Цел(Ревизия) Или Ревизия < ?(НольРазрешен, 0, 1) Или Ревизия > 99999999999999 Тогда
        ВызватьИсключение "кабинет_некорректно_редакция";
    КонецЕсли;
КонецПроцедуры

Функция РазобратьUUID(Значение)
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда ВызватьИсключение "кабинет_некорректно_идентификатор"; КонецЕсли;
    Если СтрДлина(Значение) <> 36 Тогда ВызватьИсключение "кабинет_некорректно_идентификатор"; КонецЕсли;
    Попытка Возврат Новый УникальныйИдентификатор(Значение); Исключение ВызватьИсключение "кабинет_некорректно_идентификатор"; КонецПопытки;
КонецФункции

Функция КурсорСтраницы(Вид, УчетнаяЗапись, ТолькоНепрочитанные, Ссылка)
    Возврат "n1|" + Вид + "|" + Строка(УчетнаяЗапись.УникальныйИдентификатор()) + "|" + ?(ТолькоНепрочитанные, "1", "0")
        + "|" + Строка(Ссылка.УникальныйИдентификатор());
КонецФункции

Функция СсылкаКурсора(Курсор, Вид, УчетнаяЗапись, ТолькоНепрочитанные)
    Если ТипЗнч(Курсор) <> Тип("Строка") Или СтрДлина(Курсор) > 150 Тогда ВызватьИсключение "кабинет_некорректно_курсор"; КонецЕсли;
    Ссылка = ?(Вид = "notifications", Справочники.УведомленияКабинета.ПустаяСсылка(), Справочники.ОчередьУведомлений.ПустаяСсылка());
    Если Курсор = "" Тогда Возврат Ссылка; КонецЕсли;
    Части = СтрРазделить(Курсор, "|", Истина);
    Если Части.Количество() <> 5 Тогда ВызватьИсключение "кабинет_некорректно_курсор"; КонецЕсли;
    Если Части[0] <> "n1" Или Части[1] <> Вид Или Части[2] <> Строка(УчетнаяЗапись.УникальныйИдентификатор())
        Или Части[3] <> ?(ТолькоНепрочитанные, "1", "0") Тогда ВызватьИсключение "кабинет_некорректно_курсор"; КонецЕсли;
    Идентификатор = РазобратьUUID(Части[4]);
    Возврат ?(Вид = "notifications", Справочники.УведомленияКабинета.ПолучитьСсылку(Идентификатор), Справочники.ОчередьУведомлений.ПолучитьСсылку(Идентификатор));
КонецФункции

Процедура ЗаблокироватьПолучателя(Получатель)
    Блокировка = Новый БлокировкаДанных; Элемент = Блокировка.Добавить("РегистрСведений.ПривязкиУведомлений");
    Элемент.УстановитьЗначение("Получатель", Получатель); Элемент.Режим = РежимБлокировкиДанных.Исключительный; Блокировка.Заблокировать();
КонецПроцедуры

Процедура ЗаблокироватьЗадание(Ссылка)
    Блокировка = Новый БлокировкаДанных; Элемент = Блокировка.Добавить("Справочник.ОчередьУведомлений");
    Элемент.УстановитьЗначение("Ссылка", Ссылка); Элемент.Режим = РежимБлокировкиДанных.Исключительный; Блокировка.Заблокировать();
КонецПроцедуры
