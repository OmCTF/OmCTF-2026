Функция ИзменитьСобственныйПароль(СсылкаУчетнойЗаписи, НовыйПароль, СеансСозданныйМомент) Экспорт
    Если ТранзакцияАктивна() Тогда
        ВызватьИсключение "кабинет_пароль_изменение_транзакция_активно";
    КонецЕсли;
    ПроверитьПароль(НовыйПароль);
    ПроверитьСвежуюАутентификацию(СеансСозданныйМомент);
    ПроверитьСобственнуюУчетнуюЗапись(СсылкаУчетнойЗаписи);

    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    СбойКод = "кабинет_пароль_изменение_не_удалось";
    Попытка
        Блокировка = Новый БлокировкаДанных;
        Элемент = Блокировка.Добавить("Справочник.УчетныеЗаписи");
        Элемент.УстановитьЗначение("Ссылка", СсылкаУчетнойЗаписи);
        Элемент.Режим = РежимБлокировкиДанных.Исключительный;
        Блокировка.Заблокировать();

        СбойКод = "кабинет_участник_несовпадение";
        УчетнаяЗапись = ПроверитьСобственнуюУчетнуюЗапись(СсылкаУчетнойЗаписи);
        СбойКод = "кабинет_повторная_авторизация_требуется";
        ПроверитьСвежуюАутентификацию(СеансСозданныйМомент);
        СбойКод = "кабинет_пароль_изменение_не_удалось";
        Если УчетнаяЗапись.ПоколениеАвторизации < 0 Или УчетнаяЗапись.ПоколениеАвторизации >= 999999999999999
            Или Окр(УчетнаяЗапись.ПоколениеАвторизации, 0) <> УчетнаяЗапись.ПоколениеАвторизации Тогда
            ВызватьИсключение "кабинет_некорректно_авторизация_поколение";
        КонецЕсли;

        Текущий = ПользователиИнформационнойБазы.ТекущийПользователь();
        Если Текущий = Неопределено Тогда
            СбойКод = "кабинет_участник_несовпадение";
            ВызватьИсключение СбойКод;
        КонецЕсли;
        Если ПустаяСтрока(Текущий.Имя)
            Или НРег(Строка(Текущий.УникальныйИдентификатор)) <> НРег(УчетнаяЗапись.ИдентификаторПользователя1С) Тогда
            СбойКод = "кабинет_участник_несовпадение";
            ВызватьИсключение СбойКод;
        КонецЕсли;
        Пользователь = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Текущий.УникальныйИдентификатор);
        Пользователь.Пароль = НовыйПароль;
        Пользователь.Записать();
        УчетнаяЗапись.ПоколениеАвторизации = УчетнаяЗапись.ПоколениеАвторизации + 1;
        УчетнаяЗапись.Записать();
        ПолитикаДоступа.ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, Справочники.РабочиеПространства.ПустаяСсылка(),
            "account.password.change", Строка(СсылкаУчетнойЗаписи.УникальныйИдентификатор()));
        ЗафиксироватьТранзакцию();
    Исключение
        Если ТранзакцияАктивна() Тогда
            ОтменитьТранзакцию();
        КонецЕсли;
        ВызватьИсключение СбойКод;
    КонецПопытки;

    Возврат Истина;
КонецФункции

Функция ПроверитьСобственнуюУчетнуюЗапись(СсылкаУчетнойЗаписи)
    Если ТипЗнч(СсылкаУчетнойЗаписи) <> Тип("СправочникСсылка.УчетныеЗаписи") Тогда
        ВызватьИсключение "кабинет_участник_несовпадение";
    КонецЕсли;
    Если Не ЗначениеЗаполнено(СсылкаУчетнойЗаписи) Тогда
        ВызватьИсключение "кабинет_участник_несовпадение";
    КонецЕсли;
    УчетнаяЗапись = ПолитикаДоступа.ПроверитьУчетнуюЗапись();
    Если УчетнаяЗапись.Ссылка <> СсылкаУчетнойЗаписи Тогда
        ВызватьИсключение "кабинет_участник_несовпадение";
    КонецЕсли;
    Если УчетнаяЗапись.ПометкаУдаления Или УчетнаяЗапись.Состояние <> "Active" Тогда
        ВызватьИсключение "кабинет_учетная_запись_отключено";
    КонецЕсли;
    Возврат УчетнаяЗапись;
КонецФункции

Процедура ПроверитьСвежуюАутентификацию(СеансСозданныйМомент)
    Если ТипЗнч(СеансСозданныйМомент) <> Тип("Дата") Тогда
        ВызватьИсключение "кабинет_повторная_авторизация_требуется";
    КонецЕсли;
    Возраст = ТекущаяУниверсальнаяДата() - СеансСозданныйМомент;
    Если Возраст < 0 Или Возраст > 60 Тогда
        ВызватьИсключение "кабинет_повторная_авторизация_требуется";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьПароль(НовыйПароль)
    Если ТипЗнч(НовыйПароль) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_некорректно_пароль";
    КонецЕсли;
    Если СтрДлина(НовыйПароль) < 12 Или СтрДлина(НовыйПароль) > 128 Тогда
        ВызватьИсключение "кабинет_некорректно_пароль";
    КонецЕсли;
    Для Позиция = 1 По СтрДлина(НовыйПароль) Цикл
        Код = КодСимвола(НовыйПароль, Позиция);
        Если Код < 32 Или (Код >= 127 И Код <= 159) Тогда
            ВызватьИсключение "кабинет_некорректно_пароль";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры
