Функция ДопуститьЗапрос(УчетнаяЗапись, Запись, ЭкспортДанных) Экспорт
    ПроверитьРежим(); ПроверитьСсылку(УчетнаяЗапись);
    Если ТипЗнч(Запись) <> Тип("Булево") Или ТипЗнч(ЭкспортДанных) <> Тип("Булево") Тогда
        ВызватьИсключение "кабинет_апи_частота_некорректно_контекст";
    КонецЕсли;
    ТекущаяУчетнаяЗапись = ПолитикаДоступа.ПроверитьУчетнуюЗапись();
    Если ТекущаяУчетнаяЗапись.Ссылка <> УчетнаяЗапись Тогда ВызватьИсключение "кабинет_апи_частота_некорректно_контекст"; КонецЕсли;
    Экземпляр = ТекущийЭкземпляр();
    Допуск = Новый Структура("allowed,code,retryAfter,leaseKey", Ложь, "кабинет_апи_частота_лимит", 1, "");
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьУчетнуюЗапись(УчетнаяЗапись);
        Состояние = ПрочитатьСостояние(УчетнаяЗапись);
        Сейчас = ТекущаяУниверсальнаяДата();
        Если Не Состояние.Выбран() Тогда
            Состояние.ТокеныЗаписи = 10; Состояние.ДатаТокеновЗаписи = Сейчас; Состояние.ПоследнийМомент = Сейчас;
        КонецЕсли;
        ПроверитьСостояние(Состояние);
        Момент = Макс(Сейчас, Состояние.ПоследнийМомент);
        Состояние.ТокеныЗаписи = Мин(10, Состояние.ТокеныЗаписи + Макс(0, Момент - Состояние.ДатаТокеновЗаписи));
        Состояние.ДатаТокеновЗаписи = Момент; Состояние.ПоследнийМомент = Момент;
        Если Запись Тогда
            Если Состояние.ТокеныЗаписи >= 1 Тогда
                Состояние.ТокеныЗаписи = Состояние.ТокеныЗаписи - 1; Допуск.allowed = Истина;
            Иначе Допуск.retryAfter = Макс(1, Момент + 1 - Сейчас);
            КонецЕсли;
        Иначе
            ДопускЧтения = УчестьЧтение(УчетнаяЗапись, Момент);
            Допуск.allowed = ДопускЧтения.allowed;
            Допуск.retryAfter = Макс(1, ДопускЧтения.retryAfter + (Момент - Сейчас));
        КонецЕсли;
        Если Допуск.allowed И ЭкспортДанных Тогда
            Если ЕстьПросроченнаяАренда(Состояние, Момент) Тогда
                Допуск.allowed = Ложь; Допуск.code = "кабинет_апи_экспорт_лимит"; Допуск.retryAfter = 60;
            ИначеЕсли Состояние.Экспорт1Ключ = "" Или Состояние.Экспорт2Ключ = "" Тогда
                Ключ = Строка(СервисДокументов.НовыйUUIDv4());
                Номер = ?(Состояние.Экспорт1Ключ = "", 1, 2);
                ЗаполнитьАренду(Состояние, Номер, Ключ, Экземпляр, Момент);
                Допуск.leaseKey = Ключ;
            Иначе
                Допуск.allowed = Ложь; Допуск.code = "кабинет_апи_экспорт_лимит";
                Допуск.retryAfter = Макс(1, Мин(Состояние.Экспорт1Истекает, Состояние.Экспорт2Истекает) - Сейчас);
            КонецЕсли;
        КонецЕсли;
        Если Допуск.allowed Тогда Допуск.code = ""; Допуск.retryAfter = 0; КонецЕсли;
        Состояние.Записать(); ЗафиксироватьТранзакцию();
        Возврат Допуск;
    Исключение
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
КонецФункции

Функция ЗавершитьЭкспорт(УчетнаяЗапись, Ключ) Экспорт
    ПроверитьРежим(); ПроверитьСсылку(УчетнаяЗапись); ПроверитьКлюч(Ключ);
    Экземпляр = ТекущийЭкземпляр();
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьУчетнуюЗапись(УчетнаяЗапись); Состояние = ПрочитатьСостояние(УчетнаяЗапись);
        Если Не Состояние.Выбран() Тогда ВызватьИсключение "кабинет_апи_экспорт_аренда_несовпадение"; КонецЕсли;
        ПроверитьСостояние(Состояние);
        Номер = 0;
        Если Состояние.Экспорт1Ключ = Ключ И Состояние.Экспорт1Экземпляр = Экземпляр Тогда Номер = 1;
        ИначеЕсли Состояние.Экспорт2Ключ = Ключ И Состояние.Экспорт2Экземпляр = Экземпляр Тогда Номер = 2;
        КонецЕсли;
        Если Номер = 0 Тогда ВызватьИсключение "кабинет_апи_экспорт_аренда_несовпадение"; КонецЕсли;
        Срок = ?(Номер = 1, Состояние.Экспорт1Истекает, Состояние.Экспорт2Истекает);
        Своевременно = Макс(ТекущаяУниверсальнаяДата(), Состояние.ПоследнийМомент) < Срок;
        ЗаполнитьАренду(Состояние, Номер, "", "", Дата(1, 1, 1));
        Состояние.Записать(); ЗафиксироватьТранзакцию(); Возврат Своевременно;
    Исключение
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
КонецФункции

Функция ДиагностикаЭкспортов(УчетнаяЗапись) Экспорт
    ПроверитьРежим(); ПроверитьСсылку(УчетнаяЗапись);
    Если Не РольДоступна("Администратор") Тогда ВызватьИсключение "кабинет_апи_частота_диагностика_запрещено"; КонецЕсли;
    Результат = Новый Массив;
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьУчетнуюЗапись(УчетнаяЗапись); Состояние = ПрочитатьСостояние(УчетнаяЗапись);
        Если Состояние.Выбран() Тогда
            ПроверитьСостояние(Состояние);
            Для Номер = 1 По 2 Цикл
                Аренда = ДанныеАренды(Состояние, Номер);
                Если Аренда.ключ <> "" Тогда
                    Результат.Добавить(Новый Структура("slot,leaseKey,sessionInstanceId,startedAt,expiresAt,expired",
                        Номер, Аренда.ключ, Аренда.экземпляр, Аренда.начат, Аренда.истекает,
                        ТекущаяУниверсальнаяДата() >= Аренда.истекает));
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;
        ЗафиксироватьТранзакцию(); Возврат Результат;
    Исключение
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
КонецФункции

Функция УчестьЧтение(УчетнаяЗапись, Момент)
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 61 Секунда, Количество ИЗ РегистрСведений.СчетчикиЧтенийAPI
        |ГДЕ УчетнаяЗапись = &УчетнаяЗапись УПОРЯДОЧИТЬ ПО Секунда");
    Запрос.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись); СтрокиСчетчиков = Запрос.Выполнить().Выгрузить();
    Если СтрокиСчетчиков.Количество() > 60 Тогда ВызватьИсключение "кабинет_апи_частота_состояние_некорректно"; КонецЕсли;
    Набор = РегистрыСведений.СчетчикиЧтенийAPI.СоздатьНаборЗаписей();
    Набор.Отбор.УчетнаяЗапись.Установить(УчетнаяЗапись);
    Всего = 0; Ранняя = Момент; ТекущаяСтрока = Неопределено;
    Для Каждого СтрокаСчетчика Из СтрокиСчетчиков Цикл
        Если СтрокаСчетчика.Количество < 1 Или СтрокаСчетчика.Количество > 300
            Или СтрокаСчетчика.Секунда > Момент Тогда ВызватьИсключение "кабинет_апи_частота_состояние_некорректно"; КонецЕсли;
        Если СтрокаСчетчика.Секунда <= Момент - 60 Тогда Продолжить; КонецЕсли;
        Новая = Набор.Добавить(); Новая.УчетнаяЗапись = УчетнаяЗапись;
        Новая.Секунда = СтрокаСчетчика.Секунда; Новая.Количество = СтрокаСчетчика.Количество;
        Всего = Всего + Новая.Количество; Ранняя = Мин(Ранняя, Новая.Секунда);
        Если Новая.Секунда = Момент Тогда ТекущаяСтрока = Новая; КонецЕсли;
    КонецЦикла;
    Если Всего > 300 Тогда ВызватьИсключение "кабинет_апи_частота_состояние_некорректно"; КонецЕсли;
    Разрешен = Всего < 300;
    Если Разрешен Тогда
        Если ТекущаяСтрока = Неопределено Тогда
            ТекущаяСтрока = Набор.Добавить(); ТекущаяСтрока.УчетнаяЗапись = УчетнаяЗапись; ТекущаяСтрока.Секунда = Момент;
        КонецЕсли;
        ТекущаяСтрока.Количество = ТекущаяСтрока.Количество + 1;
    КонецЕсли;
    Набор.Записать();
    Возврат Новый Структура("allowed,retryAfter", Разрешен, ?(Разрешен, 0, Макс(1, Ранняя + 60 - Момент)));
КонецФункции

Процедура ЗаполнитьАренду(Состояние, Номер, Ключ, Экземпляр, Момент)
    Если Номер = 1 Тогда
        Состояние.Экспорт1Ключ = Ключ; Состояние.Экспорт1Экземпляр = Экземпляр;
        Состояние.Экспорт1Начат = Момент; Состояние.Экспорт1Истекает = ?(Ключ = "", Момент, Момент + 300);
    Иначе
        Состояние.Экспорт2Ключ = Ключ; Состояние.Экспорт2Экземпляр = Экземпляр;
        Состояние.Экспорт2Начат = Момент; Состояние.Экспорт2Истекает = ?(Ключ = "", Момент, Момент + 300);
    КонецЕсли;
КонецПроцедуры

Функция ДанныеАренды(Состояние, Номер)
    Если Номер = 1 Тогда
        Возврат Новый Структура("ключ,экземпляр,начат,истекает", Состояние.Экспорт1Ключ,
            Состояние.Экспорт1Экземпляр, Состояние.Экспорт1Начат, Состояние.Экспорт1Истекает);
    КонецЕсли;
    Возврат Новый Структура("ключ,экземпляр,начат,истекает", Состояние.Экспорт2Ключ,
        Состояние.Экспорт2Экземпляр, Состояние.Экспорт2Начат, Состояние.Экспорт2Истекает);
КонецФункции

Функция ЕстьПросроченнаяАренда(Состояние, Момент)
    Возврат (Состояние.Экспорт1Ключ <> "" И Состояние.Экспорт1Истекает <= Момент)
        Или (Состояние.Экспорт2Ключ <> "" И Состояние.Экспорт2Истекает <= Момент);
КонецФункции

Процедура ПроверитьСостояние(Состояние)
    Если Состояние.ТокеныЗаписи < 0 Или Состояние.ТокеныЗаписи > 10
        Или Состояние.ДатаТокеновЗаписи < Дата(2000, 1, 1)
        Или Состояние.ПоследнийМомент < Состояние.ДатаТокеновЗаписи Тогда ВызватьИсключение "кабинет_апи_частота_состояние_некорректно"; КонецЕсли;
    Для Номер = 1 По 2 Цикл
        Аренда = ДанныеАренды(Состояние, Номер);
        Если Аренда.ключ <> "" Тогда
            ПроверитьКлюч(Аренда.ключ); ПроверитьКлюч(Аренда.экземпляр);
            Если Аренда.начат < Дата(2000, 1, 1) Или Аренда.начат > Состояние.ПоследнийМомент
                Или Аренда.истекает <> Аренда.начат + 300 Тогда
                ВызватьИсключение "кабинет_апи_частота_состояние_некорректно";
            КонецЕсли;
        ИначеЕсли Аренда.экземпляр <> "" Или Аренда.начат <> Дата(1, 1, 1) Или Аренда.истекает <> Дата(1, 1, 1) Тогда
            ВызватьИсключение "кабинет_апи_частота_состояние_некорректно";
        КонецЕсли;
    КонецЦикла;
    Если Состояние.Экспорт1Ключ <> "" И Состояние.Экспорт1Ключ = Состояние.Экспорт2Ключ Тогда
        ВызватьИсключение "кабинет_апи_частота_состояние_некорректно";
    КонецЕсли;
КонецПроцедуры

Функция ПрочитатьСостояние(УчетнаяЗапись)
    Состояние = РегистрыСведений.ЛимитыЗапросовAPI.СоздатьМенеджерЗаписи();
    Состояние.УчетнаяЗапись = УчетнаяЗапись; Состояние.Прочитать();
    Состояние.УчетнаяЗапись = УчетнаяЗапись; Возврат Состояние;
КонецФункции

Процедура ЗаблокироватьУчетнуюЗапись(УчетнаяЗапись)
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("РегистрСведений.ЛимитыЗапросовAPI");
    Элемент.УстановитьЗначение("УчетнаяЗапись", УчетнаяЗапись);
    Элемент.Режим = РежимБлокировкиДанных.Исключительный; Блокировка.Заблокировать();
КонецПроцедуры

Функция ТекущийЭкземпляр()
    Экземпляр = ПараметрыСеанса.ЭкземплярСеансаКабинета; ПроверитьКлюч(Экземпляр); Возврат Экземпляр;
КонецФункции

Процедура ПроверитьКлюч(Ключ)
    Если ТипЗнч(Ключ) <> Тип("Строка") Или СтрДлина(Ключ) <> 36 Тогда ВызватьИсключение "кабинет_апи_частота_некорректно_контекст"; КонецЕсли;
    Попытка Значение = Новый УникальныйИдентификатор(Ключ); Исключение ВызватьИсключение "кабинет_апи_частота_некорректно_контекст"; КонецПопытки;
    Если Строка(Значение) <> Ключ Или Ключ = "00000000-0000-0000-0000-000000000000" Тогда ВызватьИсключение "кабинет_апи_частота_некорректно_контекст"; КонецЕсли;
КонецПроцедуры

Процедура ПроверитьСсылку(УчетнаяЗапись)
    Если ТипЗнч(УчетнаяЗапись) <> Тип("СправочникСсылка.УчетныеЗаписи") Или Не ЗначениеЗаполнено(УчетнаяЗапись) Тогда
        ВызватьИсключение "кабинет_апи_частота_некорректно_контекст";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьРежим()
    Если ПривилегированныйРежим() Или ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_апи_частота_транзакция_контекст"; КонецЕсли;
КонецПроцедуры
