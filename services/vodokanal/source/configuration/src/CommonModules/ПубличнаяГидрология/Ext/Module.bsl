Функция ОбработатьЗапрос(Действие, Запрос) Экспорт
    Идентификатор = Строка(СервисДокументов.НовыйUUIDv4());
    Попытка
        ПроверитьСубъекта();
        Если Запрос.HTTPМетод <> "GET" Тогда Возврат ОтветОшибки(405, "метод_не_разрешено", Идентификатор); КонецЕсли;
        Для Каждого Заголовок Из Запрос.Заголовки Цикл
            Имя = НРег(Заголовок.Ключ);
            Если Имя = "authorization" Или Имя = "cookie" Или Имя = "transfer-encoding"
                Или (Имя = "content-length" И СокрЛП(Заголовок.Значение) <> "0") Тогда
                ВызватьИсключение "кабинет_гидрология_некорректно_ввод";
            КонецЕсли;
        КонецЦикла;
        Тело = Запрос.ПолучитьТелоКакДвоичныеДанные();
        Если Тело <> Неопределено Тогда
            Если Тело.Размер() <> 0 Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
        КонецЕсли;
        Если Действие = "reference" Тогда
            ПроверитьПараметры(Запрос, ""); Данные = СервисГидрологии.Справочники();
        ИначеЕсли Действие = "posts" Тогда
            ПроверитьПараметры(Запрос, "limit,cursor,riverCode");
            Данные = СервисГидрологии.ПубличныеПосты(ЛимитКаталога(Запрос),
                Параметр(Запрос, "cursor", 36), Параметр(Запрос, "riverCode", 6));
        ИначеЕсли Действие = "series" Тогда
            ПроверитьПараметры(Запрос, "from,to,afterTime,limit,cursor");
            Данные = СервисГидрологии.ПубличныйРяд(Запрос.ПараметрыURL.Получить("id"),
                Параметр(Запрос, "from"), Параметр(Запрос, "to"), Параметр(Запрос, "afterTime"),
                СервисГидрологии.ЛимитСтраницы(Запрос.ПараметрыЗапроса.Получить("limit")), Параметр(Запрос, "cursor", 128));
        Иначе ВызватьИсключение "кабинет_гидрология_не_найдено";
        КонецЕсли;
        Возврат Ответ(200, Данные, Идентификатор);
    Исключение
        ТекстОшибки = ОписаниеОшибки(); Код = "внутренний_ошибка"; Статус = 500;
        Если СтрНайти(ТекстОшибки, "публичный_гидрология_учетная_запись_запрещено") > 0 Тогда Код = "forbidden"; Статус = 403;
        ИначеЕсли СтрНайти(ТекстОшибки, "кабинет_гидрология_не_найдено") > 0 Тогда Код = "кабинет_гидрология_не_найдено"; Статус = 404;
        ИначеЕсли СтрНайти(ТекстОшибки, "кабинет_гидрология_некорректно_ввод") > 0 Тогда Код = "кабинет_гидрология_некорректно_ввод"; Статус = 400;
        КонецЕсли;
        Возврат ОтветОшибки(Статус, Код, Идентификатор);
    КонецПопытки;
КонецФункции

Процедура ПроверитьСубъекта()
    Если ПривилегированныйРежим() Тогда ВызватьИсключение "публичный_гидрология_учетная_запись_запрещено"; КонецЕсли;
    Текущий = ПользователиИнформационнойБазы.ТекущийПользователь();
    Если Текущий = Неопределено Тогда ВызватьИсключение "публичный_гидрология_учетная_запись_запрещено"; КонецЕсли;
    Количество = 0;
    Для Каждого Роль Из Текущий.Роли Цикл Количество = Количество + 1; КонецЦикла;
    Если Текущий.Имя <> "vodokanal_hydrology_reader" Или Количество <> 1 Или Не РольДоступна("ПубличноеЧтениеГидрологии") Тогда
        ВызватьИсключение "публичный_гидрология_учетная_запись_запрещено";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьПараметры(Запрос, Поля)
    Разрешенные = СтрРазделить(Поля, ",", Ложь);
    Для Каждого Пара Из Запрос.ПараметрыЗапроса Цикл
        Если Разрешенные.Найти(Пара.Ключ) = Неопределено Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция Параметр(Запрос, Имя, Максимум = 20)
    Значение = Запрос.ПараметрыЗапроса.Получить(Имя);
    Если Значение = Неопределено Тогда Возврат ""; КонецЕсли;
    Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) > Максимум Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
    Возврат Значение;
КонецФункции

Функция ЛимитКаталога(Запрос)
    Если Запрос.ПараметрыЗапроса.Получить("limit") = Неопределено Тогда Возврат 25; КонецЕсли;
    Значение = Параметр(Запрос, "limit", 3);
    Если Значение = "" Или Лев(Значение, 1) = "0" Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
    Для Номер = 1 По СтрДлина(Значение) Цикл
        Если СтрНайти("0123456789", Сред(Значение, Номер, 1)) = 0 Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
    КонецЦикла;
    Лимит = XMLЗначение(Тип("Число"), Значение);
    Если Лимит > 100 Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
    Возврат Лимит;
КонецФункции

Функция ОтветОшибки(Статус, Код, Идентификатор)
    Сообщение = "Не удалось получить учебные наблюдения. Повторите запрос позже.";
    Если Статус = 400 Тогда Сообщение = "Проверьте параметры периода и страницы.";
    ИначеЕсли Статус = 403 Тогда Сообщение = "Публичное чтение недоступно.";
    ИначеЕсли Статус = 404 Тогда Сообщение = "Опубликованный гидропост не найден.";
    ИначеЕсли Статус = 405 Тогда Сообщение = "Поддерживается только чтение данных.";
    КонецЕсли;
    Возврат Ответ(Статус, Новый Структура("error,requestId", Новый Структура("code,message", Код, Сообщение), Идентификатор), Идентификатор);
КонецФункции

Функция Ответ(Статус, Данные, Идентификатор)
    Запись = Новый ЗаписьJSON; Запись.УстановитьСтроку(); ЗаписатьJSON(Запись, Данные);
    Результат = Новый HTTPСервисОтвет(Статус);
    Результат.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Результат.Заголовки.Вставить("Cache-Control", "no-store");
    Результат.Заголовки.Вставить("X-Content-Type-Options", "nosniff");
    Результат.Заголовки.Вставить("X-API-Contract", "1.0");
    Результат.Заголовки.Вставить("X-Request-ID", Идентификатор);
    Результат.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8); Возврат Результат;
КонецФункции
