Функция ОбработатьЗапросКабинета(Действие, УчетнаяЗапись, Запрос, Корреляция) Экспорт
    Если Действие = "operationsJobs" Тогда
        ПроверитьПараметрыКабинета(Запрос, "workspaceId,limit,cursor"); Страница = ПараметрыСпискаКабинета(Запрос);
        WorkspaceID = APIКабинета.ТекстПараметраЗапроса(Запрос, "workspaceId", 36);
        Если WorkspaceID = "" Тогда ВызватьИсключение "кабинет_некорректно_идентификатор"; КонецЕсли;
        Данные = СервисУведомлений.ПолучитьОчередь(УчетнаяЗапись, Страница.limit, Страница.cursor, WorkspaceID);
    ИначеЕсли Действие = "operationsJobRetry" Тогда
        ПроверитьПараметрыКабинета(Запрос, ""); Тело = APIКабинета.РазобратьТелоЗапроса(Запрос, 1024);
        ПроверитьТелоКабинета(Тело, "workspaceId,expectedRevision");
        Если Тело.workspaceId = "" Тогда ВызватьИсключение "кабинет_некорректно_идентификатор"; КонецЕсли;
        Данные = СервисУведомлений.ПовторитьДоставку(УчетнаяЗапись, Запрос.ПараметрыURL.Получить("id"), Тело.expectedRevision, Тело.workspaceId);
    ИначеЕсли Действие = "operationsSettings" Тогда
        ПроверитьПараметрыКабинета(Запрос, "workspaceId");
        Данные = ПолучитьНастройки(УчетнаяЗапись, APIКабинета.ТекстПараметраЗапроса(Запрос, "workspaceId", 36));
    ИначеЕсли Действие = "operationsSettingChange" Тогда
        ПроверитьПараметрыКабинета(Запрос, ""); Тело = APIКабинета.РазобратьТелоЗапроса(Запрос, 2048);
        ПроверитьТелоКабинета(Тело, "workspaceId,key,value,expectedVersion");
        Данные = ИзменитьНастройку(УчетнаяЗапись, Тело.workspaceId, Тело.key, Тело.value, Тело.expectedVersion, Корреляция);
    ИначеЕсли Действие = "operationsSettingHistory" Или Действие = "operationsAudit" Тогда
        ПроверитьПараметрыКабинета(Запрос, "workspaceId,limit,cursor"); Страница = ПараметрыСпискаКабинета(Запрос);
        WorkspaceID = APIКабинета.ТекстПараметраЗапроса(Запрос, "workspaceId", 36);
        Если Действие = "operationsAudit" Тогда Данные = ПолучитьАудит(УчетнаяЗапись, WorkspaceID, Страница.limit, Страница.cursor);
        Иначе Данные = ПолучитьИсториюНастроек(УчетнаяЗапись, WorkspaceID, Страница.limit, Страница.cursor); КонецЕсли;
    Иначе ВызватьИсключение "кабинет_операции_некорректно_действие";
    КонецЕсли;
    Возврат APIКабинета.СформироватьОтветHTTP(200, Данные, Корреляция);
КонецФункции

Процедура ПроверитьТелоКабинета(Тело, Поля) Экспорт
    Разрешенные = СтрРазделить(Поля, ",", Ложь);
    Для Каждого Поле Из Тело Цикл
        Если Разрешенные.Найти(Поле.Ключ) = Неопределено Тогда ВызватьИсключение "кабинет_некорректно_поле"; КонецЕсли;
    КонецЦикла;
    Для Каждого Поле Из Разрешенные Цикл
        Если Не Тело.Свойство(Поле) Тогда ВызватьИсключение "кабинет_некорректно_поле"; КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура ПроверитьПараметрыКабинета(Запрос, Поля) Экспорт
    Разрешенные = СтрРазделить(Поля, ",", Ложь);
    Для Каждого Поле Из Запрос.ПараметрыЗапроса Цикл
        Если Разрешенные.Найти(Поле.Ключ) = Неопределено Тогда ВызватьИсключение "кабинет_некорректно_поле"; КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ПараметрыСпискаКабинета(Запрос) Экспорт
    ТекстЛимита = APIКабинета.ТекстПараметраЗапроса(Запрос, "limit", 3); Лимит = 25;
    Если ТекстЛимита <> "" Тогда
        Для Индекс = 1 По СтрДлина(ТекстЛимита) Цикл
            Если СтрНайти("0123456789", Сред(ТекстЛимита, Индекс, 1)) = 0 Тогда ВызватьИсключение "кабинет_некорректно_лимит"; КонецЕсли;
        КонецЦикла;
        Лимит = Число(ТекстЛимита); ПроверитьЛимит(Лимит);
    КонецЕсли;
    Возврат Новый Структура("limit,cursor", Лимит, APIКабинета.ТекстПараметраЗапроса(Запрос, "cursor", 150));
КонецФункции

Функция ПолучитьНастройки(УчетнаяЗапись, WorkspaceID) Экспорт
    Workspace = ПолитикаДоступа.ПроверитьДоступКРабочемуПространству(УчетнаяЗапись, WorkspaceID, "WorkspaceOwner");
    Список = Новый Массив;
    Для Каждого Ключ Из КлючиНастроек() Цикл Список.Добавить(ДанныеНастройки(Workspace, Ключ)); КонецЦикла;
    Возврат Новый Структура("items,schemaVersion,temporaryExportHours,businessCleanup",
        Список, Метаданные.Версия, 24, "operator-reviewed-only");
КонецФункции

Функция ИзменитьНастройку(УчетнаяЗапись, WorkspaceID, Ключ, Значение, ОжидаемаяВерсия, Корреляция) Экспорт
    Workspace = ПолитикаДоступа.ПроверитьДоступКРабочемуПространству(УчетнаяЗапись, WorkspaceID, "WorkspaceOwner");
    ПроверитьНастройку(Ключ, Значение); ПроверитьВерсию(ОжидаемаяВерсия); Корреляция = Строка(UUID(Корреляция));
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьWorkspace(Workspace);
        ПолитикаДоступа.ПроверитьДоступКРабочемуПространству(УчетнаяЗапись, WorkspaceID, "WorkspaceOwner");
        Запись = ПрочитатьНастройку(Workspace, Ключ);
        Если Запись.Версия <> ОжидаемаяВерсия Тогда ВызватьИсключение "кабинет_редакция_конфликт"; КонецЕсли;
        Запись.РабочееПространство = Workspace; Запись.Ключ = Ключ; Запись.Значение = Значение; Запись.ЧисловоеЗначение = Число(Значение);
        Запись.Версия = Запись.Версия + 1; Запись.Автор = УчетнаяЗапись; Запись.ДатаИзменения = ТекущаяУниверсальнаяДата(); Запись.Записать();
        История = Справочники.ИсторияНастроекЭксплуатации.СоздатьЭлемент();
        История.SetNewObjectRef(Справочники.ИсторияНастроекЭксплуатации.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4())); История.Наименование = Ключ;
        История.РабочееПространство = Workspace; История.Ключ = Ключ; История.Версия = Запись.Версия; История.Значение = Значение;
        История.Автор = УчетнаяЗапись; История.ДатаИзменения = Запись.ДатаИзменения; История.ИдентификаторКорреляции = Корреляция; История.Записать();
        ПолитикаДоступа.ЗаписатьСобытиеАудита(УчетнаяЗапись, Workspace, "operations.setting.change",
            Строка(История.Ссылка.УникальныйИдентификатор()), "success", Корреляция);
        Результат = ДанныеНастройки(Workspace, Ключ); ЗафиксироватьТранзакцию(); Возврат Результат;
    Исключение
        ОтменитьТранзакцию(); ВызватьИсключение;
    КонецПопытки;
КонецФункции

Функция ПолучитьИсториюНастроек(УчетнаяЗапись, WorkspaceID, Лимит = 25, Курсор = "") Экспорт
    Workspace = ПолитикаДоступа.ПроверитьДоступКРабочемуПространству(УчетнаяЗапись, WorkspaceID, "WorkspaceOwner");
    ПроверитьЛимит(Лимит); После = КурсорПосле(Курсор, "settings", УчетнаяЗапись, Workspace);
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит + 1, "ЧГ=0") + " Ссылка, Ключ, Версия, Значение, Автор,
        |ДатаИзменения, ИдентификаторКорреляции ИЗ Справочник.ИсторияНастроекЭксплуатации
        |ГДЕ РабочееПространство = &Workspace И Ссылка > &После УПОРЯДОЧИТЬ ПО Ссылка");
    Запрос.УстановитьПараметр("Workspace", Workspace); Запрос.УстановитьПараметр("После", После);
    Выборка = Запрос.Выполнить().Выбрать(); Список = Новый Массив; Еще = Ложь; Следующий = "";
    Пока Выборка.Следующий() Цикл
        Если Список.Количество() = Лимит Тогда Еще = Истина; Прервать; КонецЕсли;
        Список.Добавить(Новый Структура("id,key,version,value,authorId,changedAt,correlationId", Строка(Выборка.Ссылка.УникальныйИдентификатор()),
            Выборка.Ключ, Выборка.Версия, Выборка.Значение, Строка(Выборка.Автор.УникальныйИдентификатор()),
            XMLСтрока(Выборка.ДатаИзменения) + "Z", Выборка.ИдентификаторКорреляции));
        Следующий = КурсорДля("settings", УчетнаяЗапись, Workspace, Выборка.Ссылка);
    КонецЦикла;
    Возврат Новый Структура("items,limit,hasMore,nextCursor", Список, Лимит, Еще, ?(Еще, Следующий, ""));
КонецФункции

Функция ПолучитьАудит(УчетнаяЗапись, WorkspaceID, Лимит = 25, Курсор = "") Экспорт
    Workspace = ПолитикаДоступа.ПроверитьДоступКРабочемуПространству(УчетнаяЗапись, WorkspaceID, "WorkspaceOwner");
    ПроверитьЛимит(Лимит); После = КурсорПосле(Курсор, "audit", УчетнаяЗапись, Workspace);
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит + 1, "ЧГ=0") + " Ссылка, ДействующееЛицо, Действие,
        |ИдентификаторОбъекта, Результат, ИдентификаторКорреляции, ФактическаяДата ИЗ Справочник.СобытияАудита
        |ГДЕ РабочееПространство = &Workspace И Ссылка > &После УПОРЯДОЧИТЬ ПО Ссылка");
    Запрос.УстановитьПараметр("Workspace", Workspace); Запрос.УстановитьПараметр("После", После);
    Выборка = Запрос.Выполнить().Выбрать(); Список = Новый Массив; Еще = Ложь; Следующий = "";
    Пока Выборка.Следующий() Цикл
        Если Список.Количество() = Лимит Тогда Еще = Истина; Прервать; КонецЕсли;
        Список.Добавить(Новый Структура("id,actorId,action,objectId,outcome,correlationId,occurredAt",
            Строка(Выборка.Ссылка.УникальныйИдентификатор()), Строка(Выборка.ДействующееЛицо.УникальныйИдентификатор()),
            Выборка.Действие, Выборка.ИдентификаторОбъекта, Выборка.Результат, Выборка.ИдентификаторКорреляции, XMLСтрока(Выборка.ФактическаяДата) + "Z"));
        Следующий = КурсорДля("audit", УчетнаяЗапись, Workspace, Выборка.Ссылка);
    КонецЦикла;
    Возврат Новый Структура("items,limit,hasMore,nextCursor", Список, Лимит, Еще, ?(Еще, Следующий, ""));
КонецФункции

Функция ПрочитатьЧисловуюНастройку(Workspace, Ключ) Экспорт
    Если КлючиНастроек().Найти(Ключ) = Неопределено Тогда ВызватьИсключение "кабинет_некорректно_настройка"; КонецЕсли;
    Запись = ПрочитатьНастройку(Workspace, Ключ);
    Если Запись.Выбран() Тогда ПроверитьНастройку(Ключ, Запись.Значение); Возврат Число(Запись.Значение); КонецЕсли;
    Возврат ОписаниеНастройки(Ключ).defaultValue;
КонецФункции

Функция КлючиНастроек()
    Возврат СтрРазделить("auditDays,seasonDays,notificationQuota", ",");
КонецФункции

Функция ОписаниеНастройки(Ключ)
    Если Ключ = "auditDays" Тогда Возврат Новый Структура("title,min,max,defaultValue", "Хранение аудита, дней", 30, 365, 30); КонецЕсли;
    Если Ключ = "seasonDays" Тогда Возврат Новый Структура("title,min,max,defaultValue", "Минимальный срок хранения учебного сезона, дней", 30, 3650, 365); КонецЕсли;
    Если Ключ = "notificationQuota" Тогда Возврат Новый Структура("title,min,max,defaultValue", "Уведомлений на получателя в области", 100, 10000, 5000); КонецЕсли;
    ВызватьИсключение "кабинет_некорректно_настройка";
КонецФункции

Процедура ПроверитьНастройку(Ключ, Значение)
    Если ТипЗнч(Ключ) <> Тип("Строка") Или ТипЗнч(Значение) <> Тип("Строка") Тогда ВызватьИсключение "кабинет_некорректно_настройка"; КонецЕсли;
    Описание = ОписаниеНастройки(Ключ);
    Если СтрДлина(Значение) < 1 Или СтрДлина(Значение) > 5 Тогда ВызватьИсключение "кабинет_некорректно_настройка_значение"; КонецЕсли;
    Для Номер = 1 По СтрДлина(Значение) Цикл
        Если СтрНайти("0123456789", Сред(Значение, Номер, 1)) = 0 Тогда ВызватьИсключение "кабинет_некорректно_настройка_значение"; КонецЕсли;
    КонецЦикла;
    Если Число(Значение) < Описание.min Или Число(Значение) > Описание.max Тогда ВызватьИсключение "кабинет_некорректно_настройка_значение"; КонецЕсли;
КонецПроцедуры

Функция ПрочитатьНастройку(Workspace, Ключ)
    Запись = РегистрыСведений.НастройкиЭксплуатации.СоздатьМенеджерЗаписи();
    Запись.РабочееПространство = Workspace; Запись.Ключ = Ключ; Запись.Прочитать(); Возврат Запись;
КонецФункции

Функция ДанныеНастройки(Workspace, Ключ)
    Запись = ПрочитатьНастройку(Workspace, Ключ); Описание = ОписаниеНастройки(Ключ);
    Возврат Новый Структура("key,title,value,version,authorId,changedAt,min,max",
        Ключ, Описание.title, ?(Запись.Выбран(), Запись.Значение, Формат(Описание.defaultValue, "ЧГ=0")), Запись.Версия,
        ?(ЗначениеЗаполнено(Запись.Автор), Строка(Запись.Автор.УникальныйИдентификатор()), ""),
        ?(Запись.Выбран(), XMLСтрока(Запись.ДатаИзменения) + "Z", ""), Описание.min, Описание.max);
КонецФункции

Процедура ВыполнитьРегламентноеОбслуживание() Экспорт
    ПроверитьАдминистратора();
    Ключ = "maintenance:" + Формат(ТекущаяУниверсальнаяДата(), "ДФ=yyyyMMddHHmm");
    ВыполнитьОбслуживание(Ключ);
КонецПроцедуры

Функция ВыполнитьОбслуживание(Ключ) Экспорт
    ПроверитьАдминистратора();
    Если ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_операции_транзакция_активно"; КонецЕсли;
    Если ТипЗнч(Ключ) <> Тип("Строка") Или СтрДлина(Ключ) <> 24 Или Лев(Ключ, 12) <> "maintenance:" Тогда
        ВызватьИсключение "кабинет_операции_ключ_некорректно";
    КонецЕсли;
    Для Индекс = 13 По 24 Цикл
        Если СтрНайти("0123456789", Сред(Ключ, Индекс, 1)) = 0 Тогда ВызватьИсключение "кабинет_операции_ключ_некорректно"; КонецЕсли;
    КонецЦикла;
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        Блокировка = Новый БлокировкаДанных; Элемент = Блокировка.Добавить("РегистрСведений.ПривязкиЗаданийЭксплуатации");
        Элемент.Режим = РежимБлокировкиДанных.Исключительный; Блокировка.Заблокировать();
        Привязка = РегистрыСведений.ПривязкиЗаданийЭксплуатации.СоздатьМенеджерЗаписи(); Привязка.Ключ = Ключ; Привязка.Прочитать();
        Если Привязка.Выбран() Тогда
            Задание = Привязка.Задание.ПолучитьОбъект();
            Если Задание = Неопределено Тогда ВызватьИсключение "кабинет_операции_привязка_конфликт"; КонецЕсли;
            Если Задание.Состояние = "Done" Тогда ЗафиксироватьТранзакцию(); Возврат Строка(Задание.Ссылка.УникальныйИдентификатор()); КонецЕсли;
            Если Задание.Состояние <> "Failed" Тогда ВызватьИсключение "кабинет_операции_задание_активно"; КонецЕсли;
        Иначе
            ПроверкаКвоты = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Справочник.ЗаданияЭксплуатации");
            Квота = ПроверкаКвоты.Выполнить().Выбрать(); Квота.Следующий();
            Если Квота.Количество >= 50000 Тогда ВызватьИсключение "кабинет_операции_задание_квота"; КонецЕсли;
            Задание = Справочники.ЗаданияЭксплуатации.СоздатьЭлемент();
            Задание.SetNewObjectRef(Справочники.ЗаданияЭксплуатации.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4())); Задание.Наименование = "Обслуживание кабинета";
            Задание.Ключ = Ключ; Задание.Вид = "maintenance"; Задание.Состояние = "Pending";
            Задание.ДатаСоздания = ТекущаяУниверсальнаяДата(); Задание.ИдентификаторКорреляции = Строка(СервисДокументов.НовыйUUIDv4());
        КонецЕсли;
        Активные = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ЗаданияЭксплуатации ГДЕ Вид = &Вид И Состояние = &Состояние");
        Активные.УстановитьПараметр("Вид", "maintenance"); Активные.УстановитьПараметр("Состояние", "Pending");
        Если Не Активные.Выполнить().Пустой() Тогда ВызватьИсключение "кабинет_операции_задание_активно"; КонецЕсли;
        Если Задание.Попытки >= 5 Тогда ВызватьИсключение "кабинет_операции_повтор_лимит"; КонецЕсли;
        Задание.Попытки = Задание.Попытки + 1; Задание.ДатаНачала = ТекущаяУниверсальнаяДата();
        Задание.Состояние = "Pending"; Задание.Записать();
        Привязка.Ключ = Ключ; Привязка.Задание = Задание.Ссылка; Привязка.Записать();
        СсылкаЗадания = Задание.Ссылка; ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию(); ВызватьИсключение;
    КонецПопытки;
    Попытка
        СозданоНапоминаний = СервисУчетаПоказаний.СоздатьУведомленияОСрокеПоверки(25);
        Доставлено = СервисУведомлений.ВыполнитьОчередь(25);
        УдаленоАудита = РотироватьАудит(100);
        УдаленоЭкспортов = СервисДокументов.УдалитьИстекшиеЭкспорты(100);
        УдаленоЛимитов = РотироватьЛимитыИдентичности(100);
        УдаленоГостевыхЛимитов = РотироватьЛимитыПубличногоШлюза(100);
        РотироватьИсториюЗаданий(100);
        ЗакончитьЗадание(СсылкаЗадания, "Done", "", СозданоНапоминаний + Доставлено + УдаленоАудита + УдаленоЭкспортов + УдаленоЛимитов + УдаленоГостевыхЛимитов);
    Исключение
        ЗакончитьЗадание(СсылкаЗадания, "Failed", "обслуживание_шаг_не_удалось", 0);
    КонецПопытки;
    Возврат Строка(СсылкаЗадания.УникальныйИдентификатор());
КонецФункции

Процедура ЗакончитьЗадание(Ссылка, Состояние, КодОшибки, Количество)
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        Блокировка = Новый БлокировкаДанных; Элемент = Блокировка.Добавить("Справочник.ЗаданияЭксплуатации");
        Элемент.УстановитьЗначение("Ссылка", Ссылка); Элемент.Режим = РежимБлокировкиДанных.Исключительный; Блокировка.Заблокировать();
        Задание = Ссылка.ПолучитьОбъект();
        Если Задание.Состояние <> "Done" Тогда
            Задание.Состояние = Состояние; Задание.КодОшибки = КодОшибки; Задание.Обработано = Количество;
            Задание.ДатаЗавершения = ТекущаяУниверсальнаяДата(); Задание.Записать();
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию(); ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

Функция РотироватьАудит(Предел = 100) Экспорт
    ПроверитьАдминистратора(); ПроверитьЛимит(Предел);
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        Блокировка = Новый БлокировкаДанных; Элемент = Блокировка.Добавить("Справочник.СобытияАудита");
        Элемент.Режим = РежимБлокировкиДанных.Исключительный; Блокировка.Заблокировать();
        Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ " + Формат(Предел, "ЧГ=0") + " Аудит.Ссылка КАК Ссылка,
            |Аудит.РабочееПространство КАК РабочееПространство, Аудит.ФактическаяДата КАК ФактическаяДата
            |ИЗ Справочник.СобытияАудита КАК Аудит ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЭксплуатации КАК Настройки
            |ПО Настройки.РабочееПространство = Аудит.РабочееПространство И Настройки.Ключ = &Ключ
            |ГДЕ Аудит.ФактическаяДата < ДОБАВИТЬКДАТЕ(&Сейчас, ДЕНЬ, -ЕСТЬNULL(Настройки.ЧисловоеЗначение, 30))
            |УПОРЯДОЧИТЬ ПО ФактическаяДата, Ссылка");
        Запрос.УстановитьПараметр("Ключ", "auditDays"); Запрос.УстановитьПараметр("Сейчас", ТекущаяУниверсальнаяДата());
        Выборка = Запрос.Выполнить().Выбрать(); Удалено = 0;
        Пока Выборка.Следующий() Цикл
            Срок = ПрочитатьЧисловуюНастройку(Выборка.РабочееПространство, "auditDays");
            Если Выборка.ФактическаяДата < ТекущаяУниверсальнаяДата() - Срок * 86400 Тогда
                Объект = Выборка.Ссылка.ПолучитьОбъект(); Объект.Удалить(); Удалено = Удалено + 1;
            КонецЕсли;
        КонецЦикла;
        ЗафиксироватьТранзакцию(); Возврат Удалено;
    Исключение
        ОтменитьТранзакцию(); ВызватьИсключение;
    КонецПопытки;
КонецФункции

Функция РотироватьЛимитыПубличногоШлюза(Предел = 100) Экспорт
    ПроверитьАдминистратора(); ПроверитьЛимит(Предел);
    Если ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_операции_транзакция_активно"; КонецЕсли;
    Граница = ТекущаяУниверсальнаяДата() - 86400;
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ " + Формат(Предел, "ЧГ=0") + " Ключ ИЗ РегистрСведений.ЛимитыПубличногоШлюза
        |ГДЕ НачалоОкна < &Граница И ПоследнийМомент < &Граница
        |И (Ключ ПОДОБНО &Чтения ИЛИ Ключ ПОДОБНО &Записи) УПОРЯДОЧИТЬ ПО ПоследнийМомент, Ключ");
    Запрос.УстановитьПараметр("Граница", Граница);
    Запрос.УстановитьПараметр("Чтения", "dispatch:read:%"); Запрос.УстановитьПараметр("Записи", "dispatch:write:%");
    Кандидаты = Запрос.Выполнить().Выгрузить(); Удалено = 0;
    Для Каждого Кандидат Из Кандидаты Цикл
        Если Не ЭтоКлючИсточникаГостевогоЛимита(Кандидат.Ключ) Тогда Продолжить; КонецЕсли;
        НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
        Попытка
            Блокировка = Новый БлокировкаДанных; Элемент = Блокировка.Добавить("РегистрСведений.ЛимитыПубличногоШлюза");
            Элемент.УстановитьЗначение("Ключ", Кандидат.Ключ); Элемент.Режим = РежимБлокировкиДанных.Исключительный;
            Блокировка.Заблокировать();
            Запись = РегистрыСведений.ЛимитыПубличногоШлюза.СоздатьМенеджерЗаписи(); Запись.Ключ = Кандидат.Ключ; Запись.Прочитать();
            СвежаяГраница = Мин(Граница, ТекущаяУниверсальнаяДата() - 86400);
            Если Запись.Выбран() Тогда
                Если Запись.НачалоОкна > Дата(1,1,1) И Запись.ПоследнийМомент >= Запись.НачалоОкна
                    И Запись.НачалоОкна < СвежаяГраница И Запись.ПоследнийМомент < СвежаяГраница Тогда
                    Запись.Удалить(); Удалено = Удалено + 1;
                КонецЕсли;
            КонецЕсли;
            ЗафиксироватьТранзакцию();
        Исключение
            ОтменитьТранзакцию(); ВызватьИсключение;
        КонецПопытки;
    КонецЦикла;
    Возврат Удалено;
КонецФункции

Функция ЭтоКлючИсточникаГостевогоЛимита(Ключ)
    Если ТипЗнч(Ключ) <> Тип("Строка") Тогда Возврат Ложь; КонецЕсли;
    Если Лев(Ключ, 14) = "dispatch:read:" Тогда Хеш = Сред(Ключ, 15);
    ИначеЕсли Лев(Ключ, 15) = "dispatch:write:" Тогда Хеш = Сред(Ключ, 16);
    Иначе Возврат Ложь; КонецЕсли;
    Если СтрДлина(Хеш) <> 44 Или Прав(Хеш, 1) <> "=" Тогда Возврат Ложь; КонецЕсли;
    Для Индекс = 1 По 43 Цикл
        Если СтрНайти("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/", Сред(Хеш, Индекс, 1)) = 0 Тогда Возврат Ложь; КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции

Функция РотироватьЛимитыИдентичности(Предел = 100) Экспорт
    ПроверитьАдминистратора(); ПроверитьЛимит(Предел);
    Если ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_операции_транзакция_активно"; КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ " + Формат(Предел, "ЧГ=0") + " Ключ ИЗ РегистрСведений.ЛимитыИдентичности
        |ГДЕ НачалоОкна < &Дата УПОРЯДОЧИТЬ ПО НачалоОкна, Ключ");
    Запрос.УстановитьПараметр("Дата", ТекущаяУниверсальнаяДата() - 86400); Выборка = Запрос.Выполнить().Выбрать(); Удалено = 0;
    Пока Выборка.Следующий() Цикл
        НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
        Попытка
            Блокировка = Новый БлокировкаДанных; Элемент = Блокировка.Добавить("РегистрСведений.ЛимитыИдентичности");
            Элемент.УстановитьЗначение("Ключ", Выборка.Ключ); Элемент.Режим = РежимБлокировкиДанных.Исключительный; Блокировка.Заблокировать();
            Запись = РегистрыСведений.ЛимитыИдентичности.СоздатьМенеджерЗаписи(); Запись.Ключ = Выборка.Ключ; Запись.Прочитать();
            Если Запись.Выбран() Тогда
                Если Запись.НачалоОкна < ТекущаяУниверсальнаяДата() - 86400 Тогда Запись.Удалить(); Удалено = Удалено + 1; КонецЕсли;
            КонецЕсли;
            ЗафиксироватьТранзакцию();
        Исключение
            ОтменитьТранзакцию(); ВызватьИсключение;
        КонецПопытки;
    КонецЦикла;
    Возврат Удалено;
КонецФункции

Процедура РотироватьИсториюЗаданий(Предел = 100)
    ПроверитьАдминистратора(); ПроверитьЛимит(Предел);
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        Блокировка = Новый БлокировкаДанных; Элемент = Блокировка.Добавить("РегистрСведений.ПривязкиЗаданийЭксплуатации");
        Элемент.Режим = РежимБлокировкиДанных.Исключительный; Блокировка.Заблокировать();
        Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ " + Формат(Предел, "ЧГ=0") + " Ссылка, Ключ ИЗ Справочник.ЗаданияЭксплуатации
            |ГДЕ Состояние = &Завершено И ДатаЗавершения < &Дата УПОРЯДОЧИТЬ ПО ДатаЗавершения, Ссылка");
        Запрос.УстановитьПараметр("Завершено", "Done"); Запрос.УстановитьПараметр("Дата", ТекущаяУниверсальнаяДата() - 30 * 86400);
        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            Привязка = РегистрыСведений.ПривязкиЗаданийЭксплуатации.СоздатьМенеджерЗаписи(); Привязка.Ключ = Выборка.Ключ; Привязка.Прочитать();
            Если Привязка.Выбран() Тогда
                Если Привязка.Задание <> Выборка.Ссылка Тогда ВызватьИсключение "кабинет_операции_привязка_конфликт"; КонецЕсли;
                Привязка.Удалить();
            КонецЕсли;
            Объект = Выборка.Ссылка.ПолучитьОбъект(); Объект.Удалить();
        КонецЦикла;
        ЗафиксироватьТранзакцию();
    Исключение ОтменитьТранзакцию(); ВызватьИсключение; КонецПопытки;
КонецПроцедуры

Функция НастроитьРегламентноеОбслуживание(Включить) Экспорт
    ПроверитьАдминистратора();
    Если ТипЗнч(Включить) <> Тип("Булево") Тогда ВызватьИсключение "кабинет_некорректно_поле"; КонецЕсли;
    Если ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_операции_транзакция_активно"; КонецЕсли;
    Отбор = Новый Структура("Метаданные", Метаданные.РегламентныеЗадания.ОбслуживаниеКабинета);
    Задания = РегламентныеЗадания.ПолучитьРегламентныеЗадания(Отбор);
    Если Задания.Количество() > 1 Тогда ВызватьИсключение "кабинет_операции_расписание_конфликт"; КонецЕсли;
    Если Задания.Количество() = 0 Тогда
        Задание = РегламентныеЗадания.СоздатьРегламентноеЗадание(Метаданные.РегламентныеЗадания.ОбслуживаниеКабинета);
    Иначе Задание = Задания[0]; КонецЕсли;
    Если Включить Тогда
        ПользовательЗадания = ПользователиИнформационнойБазы.ТекущийПользователь();
        Если ПользовательЗадания = Неопределено Тогда ВызватьИсключение "кабинет_операции_запрещено"; КонецЕсли;
        Если ПустаяСтрока(ПользовательЗадания.Имя) Тогда ВызватьИсключение "кабинет_операции_запрещено"; КонецЕсли;
        Задание.ИмяПользователя = ПользовательЗадания.Имя;
    КонецЕсли;
    Расписание = Новый РасписаниеРегламентногоЗадания;
    Расписание.ПериодПовтораДней = 1; Расписание.ПериодПовтораВТечениеДня = 60;
    Задание.Расписание = Расписание; Задание.Использование = Включить; Задание.Записать();
    ПолитикаДоступа.ЗаписатьСобытиеАудита(Справочники.УчетныеЗаписи.ПустаяСсылка(), Справочники.РабочиеПространства.ПустаяСсылка(),
        "operations.schedule.change", "maintenance", ?(Включить, "enabled", "disabled"));
    Возврат Новый Структура("enabled,intervalSeconds", Включить, 60);
КонецФункции

Функция ПолучитьЗаданияОператора(Лимит = 25) Экспорт
    ПроверитьАдминистратора(); ПроверитьЛимит(Лимит);
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + " Ссылка, Ключ, Состояние, Попытки,
        |Обработано, ДатаСоздания, ДатаЗавершения, КодОшибки, ИдентификаторКорреляции
        |ИЗ Справочник.ЗаданияЭксплуатации УПОРЯДОЧИТЬ ПО ДатаСоздания УБЫВ, Ссылка");
    Выборка = Запрос.Выполнить().Выбрать(); Список = Новый Массив;
    Пока Выборка.Следующий() Цикл
        Список.Добавить(Новый Структура("id,key,state,attempts,processed,createdAt,completedAt,errorCode,correlationId",
            Строка(Выборка.Ссылка.УникальныйИдентификатор()), Выборка.Ключ, Выборка.Состояние, Выборка.Попытки, Выборка.Обработано,
            XMLСтрока(Выборка.ДатаСоздания) + "Z", XMLСтрока(Выборка.ДатаЗавершения) + "Z", Выборка.КодОшибки, Выборка.ИдентификаторКорреляции));
    КонецЦикла;
    Возврат Список;
КонецФункции

Процедура ОсвободитьЭкспортыПослеОстановки(УчетнаяЗапись, ПервыйКлюч, ВторойКлюч) Экспорт
    ПроверитьАдминистратора();
    Если Не МонопольныйРежим() Тогда ВызватьИсключение "кабинет_операции_монопольный_режим_требуется"; КонецЕсли;
    Если ТипЗнч(УчетнаяЗапись) <> Тип("СправочникСсылка.УчетныеЗаписи") Или Не ЗначениеЗаполнено(УчетнаяЗапись) Тогда ВызватьИсключение "кабинет_некорректно_идентификатор"; КонецЕсли;
    Если ПервыйКлюч <> "" Тогда UUID(ПервыйКлюч); КонецЕсли; Если ВторойКлюч <> "" Тогда UUID(ВторойКлюч); КонецЕсли;
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        Блокировка = Новый БлокировкаДанных; Элемент = Блокировка.Добавить("РегистрСведений.ЛимитыЗапросовAPI");
        Элемент.УстановитьЗначение("УчетнаяЗапись", УчетнаяЗапись); Элемент.Режим = РежимБлокировкиДанных.Исключительный; Блокировка.Заблокировать();
        Запись = РегистрыСведений.ЛимитыЗапросовAPI.СоздатьМенеджерЗаписи(); Запись.УчетнаяЗапись = УчетнаяЗапись; Запись.Прочитать();
        Если Не Запись.Выбран() Тогда ВызватьИсключение "кабинет_операции_аренда_изменено"; КонецЕсли;
        Если Запись.Экспорт1Ключ <> ПервыйКлюч Или Запись.Экспорт2Ключ <> ВторойКлюч Тогда ВызватьИсключение "кабинет_операции_аренда_изменено"; КонецЕсли;
        Запись.Экспорт1Ключ = ""; Запись.Экспорт1Экземпляр = ""; Запись.Экспорт1Начат = Дата(1,1,1); Запись.Экспорт1Истекает = Дата(1,1,1);
        Запись.Экспорт2Ключ = ""; Запись.Экспорт2Экземпляр = ""; Запись.Экспорт2Начат = Дата(1,1,1); Запись.Экспорт2Истекает = Дата(1,1,1); Запись.Записать();
        ПолитикаДоступа.ЗаписатьСобытиеАудита(Справочники.УчетныеЗаписи.ПустаяСсылка(), Справочники.РабочиеПространства.ПустаяСсылка(),
            "operations.export.recover", Строка(УчетнаяЗапись.УникальныйИдентификатор()));
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию(); ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

Процедура ПроверитьАдминистратора()
    Если Не РольДоступна("Администратор") Тогда ВызватьИсключение "кабинет_операции_запрещено"; КонецЕсли;
КонецПроцедуры

Процедура ПроверитьВерсию(Значение)
    Если ТипЗнч(Значение) <> Тип("Число") Тогда ВызватьИсключение "кабинет_некорректно_редакция"; КонецЕсли;
    Если Значение <> Цел(Значение) Или Значение < 0 Или Значение > 99999999999999 Тогда ВызватьИсключение "кабинет_некорректно_редакция"; КонецЕсли;
КонецПроцедуры

Процедура ПроверитьЛимит(Значение)
    Если ТипЗнч(Значение) <> Тип("Число") Тогда ВызватьИсключение "кабинет_некорректно_лимит"; КонецЕсли;
    Если Значение <> Цел(Значение) Или Значение < 1 Или Значение > 100 Тогда ВызватьИсключение "кабинет_некорректно_лимит"; КонецЕсли;
КонецПроцедуры

Функция UUID(Значение)
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда ВызватьИсключение "кабинет_некорректно_идентификатор"; КонецЕсли;
    Если СтрДлина(Значение) <> 36 Тогда ВызватьИсключение "кабинет_некорректно_идентификатор"; КонецЕсли;
    Попытка Возврат Новый УникальныйИдентификатор(Значение); Исключение ВызватьИсключение "кабинет_некорректно_идентификатор"; КонецПопытки;
КонецФункции

Процедура ЗаблокироватьWorkspace(Workspace)
    Блокировка = Новый БлокировкаДанных; Элемент = Блокировка.Добавить("Справочник.РабочиеПространства");
    Элемент.УстановитьЗначение("Ссылка", Workspace); Элемент.Режим = РежимБлокировкиДанных.Исключительный; Блокировка.Заблокировать();
КонецПроцедуры

Функция КурсорДля(Вид, УчетнаяЗапись, Workspace, Ссылка)
    Возврат "a1|" + Вид + "|" + Строка(УчетнаяЗапись.УникальныйИдентификатор()) + "|" + Строка(Workspace.УникальныйИдентификатор())
        + "|" + Строка(Ссылка.УникальныйИдентификатор());
КонецФункции

Функция КурсорПосле(Курсор, Вид, УчетнаяЗапись, Workspace)
    Если ТипЗнч(Курсор) <> Тип("Строка") Или СтрДлина(Курсор) > 150 Тогда ВызватьИсключение "кабинет_некорректно_курсор"; КонецЕсли;
    Если Курсор = "" Тогда
        Возврат ?(Вид = "settings", Справочники.ИсторияНастроекЭксплуатации.ПустаяСсылка(), Справочники.СобытияАудита.ПустаяСсылка());
    КонецЕсли;
    Части = СтрРазделить(Курсор, "|", Истина);
    Если Части.Количество() <> 5 Тогда ВызватьИсключение "кабинет_некорректно_курсор"; КонецЕсли;
    Если Части[0] <> "a1" Или Части[1] <> Вид Или Части[2] <> Строка(УчетнаяЗапись.УникальныйИдентификатор())
        Или Части[3] <> Строка(Workspace.УникальныйИдентификатор()) Тогда ВызватьИсключение "кабинет_некорректно_курсор"; КонецЕсли;
    Идентификатор = UUID(Части[4]);
    Возврат ?(Вид = "settings", Справочники.ИсторияНастроекЭксплуатации.ПолучитьСсылку(Идентификатор), Справочники.СобытияАудита.ПолучитьСсылку(Идентификатор));
КонецФункции

Процедура ОтметитьПрерванноеОбслуживание(Идентификатор, Ключ, Попытки, ДатаНачала, Корреляция) Экспорт
    ОграниченияТяжелыхЗаданий.ПроверитьОператораВосстановления();
    Ссылка = Справочники.ЗаданияЭксплуатации.ПолучитьСсылку(UUID(Идентификатор)); UUID(Корреляция);
    Если ТипЗнч(Ключ) <> Тип("Строка") Или ТипЗнч(Попытки) <> Тип("Число") Или ТипЗнч(ДатаНачала) <> Тип("Дата") Тогда ВызватьИсключение "кабинет_операции_аренда_изменено"; КонецЕсли;
    Если Попытки <> Цел(Попытки) Или Попытки < 1 Или Попытки > 5 Тогда ВызватьИсключение "кабинет_операции_аренда_изменено"; КонецЕсли;
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        Б = Новый БлокировкаДанных; Э = Б.Добавить("РегистрСведений.ПривязкиЗаданийЭксплуатации");
        Э.Режим = РежимБлокировкиДанных.Исключительный; Б.Заблокировать();
        Привязка = РегистрыСведений.ПривязкиЗаданийЭксплуатации.СоздатьМенеджерЗаписи(); Привязка.Ключ = Ключ; Привязка.Прочитать();
        Если Не Привязка.Выбран() Или Привязка.Задание <> Ссылка Тогда ВызватьИсключение "кабинет_операции_аренда_изменено"; КонецЕсли;
        Б = Новый БлокировкаДанных; Э = Б.Добавить("Справочник.ЗаданияЭксплуатации");
        Э.УстановитьЗначение("Ссылка", Ссылка); Э.Режим = РежимБлокировкиДанных.Исключительный; Б.Заблокировать();
        Задание = Ссылка.ПолучитьОбъект();
        Если Задание = Неопределено Тогда ВызватьИсключение "кабинет_операции_аренда_изменено"; КонецЕсли;
        Если Задание.Вид <> "maintenance" Или Задание.Состояние <> "Pending" Или Задание.Ключ <> Ключ
            Или Задание.Попытки <> Попытки Или Задание.ДатаНачала <> ДатаНачала Или Задание.ИдентификаторКорреляции <> Корреляция Тогда
            ВызватьИсключение "кабинет_операции_аренда_изменено";
        КонецЕсли;
        Задание.Состояние = "Failed"; Задание.КодОшибки = "оператор_остановлено"; Задание.ДатаЗавершения = ТекущаяУниверсальнаяДата(); Задание.Записать();
        ПолитикаДоступа.ЗаписатьСобытиеАудита(Справочники.УчетныеЗаписи.ПустаяСсылка(), Справочники.РабочиеПространства.ПустаяСсылка(),
            "operations.maintenance.recover", Идентификатор);
        ЗафиксироватьТранзакцию();
    Исключение
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли; ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры
