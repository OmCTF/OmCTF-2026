Функция ОбработатьЗапрос(Действие, Запрос) Экспорт
    Корреляция = Строка(СервисДокументов.НовыйUUIDv4());
    Попытка
        Если ПривилегированныйРежим() Тогда ВызватьИсключение "гость_шлюз_запрещено"; КонецЕсли;
        ПроверитьТекущегоПользователя();
        Если Действие = "publicDispatchHazard" Тогда Метод = "POST";
        ИначеЕсли СтрРазделить("publicDispatchIntakes,publicDispatchAddresses,publicDispatchOutages,publicDispatchReceipt", ",").Найти(Действие) <> Неопределено Тогда Метод = "GET";
        Иначе ВызватьИсключение "гость_шлюз_не_найдено"; КонецЕсли;
        Если Запрос.HTTPМетод <> Метод Тогда Возврат Ошибка(405, "метод_не_разрешено", Корреляция); КонецЕсли;
        Для Каждого Заголовок Из Запрос.Заголовки Цикл
            Имя = НРег(Заголовок.Ключ);
            Если Имя = "authorization" Или Имя = "proxy-authorization" Или Имя = "cookie" Или Имя = "ibsession"
                Или Имя = "transfer-encoding" Или Имя = "forwarded" Тогда ВызватьИсключение "гость_шлюз_некорректно_ввод"; КонецЕсли;
        КонецЦикла;
        Если Метод = "GET" Тогда
            Тело = Запрос.ПолучитьТелоКакДвоичныеДанные();
            Если Тело <> Неопределено Тогда Если Тело.Размер() <> 0 Тогда ВызватьИсключение "гость_шлюз_некорректно_ввод"; КонецЕсли; КонецЕсли;
        Иначе
            ТипСодержимого = НРег(APIКабинета.ЗаголовокЗапроса(Запрос, "Content-Type"));
            Если ТипСодержимого <> "application/json" И Лев(ТипСодержимого, 17) <> "application/json;" Тогда ВызватьИсключение "гость_шлюз_некорректно_ввод"; КонецЕсли;
            Длина = APIКабинета.ЗаголовокЗапроса(Запрос, "Content-Length");
            Если Длина <> "" Тогда
                Если СтрДлина(Длина) > 8 Тогда ВызватьИсключение "гость_шлюз_тело_слишком_большое"; КонецЕсли;
                Для Н = 1 По СтрДлина(Длина) Цикл Если СтрНайти("0123456789", Сред(Длина, Н, 1)) = 0 Тогда ВызватьИсключение "гость_шлюз_некорректно_ввод"; КонецЕсли; КонецЦикла;
                Если Число(Длина) > 7340032 Тогда ВызватьИсключение "гость_шлюз_тело_слишком_большое"; КонецЕсли;
            КонецЕсли;
        КонецЕсли;
        Возврат УзкийКонтурГостевыхОбращений.Обработать(Действие, Запрос, Корреляция);
    Исключение
        Текст = ОписаниеОшибки(); Код = "гость_шлюз_недоступно"; Статус = 503;
        Если СтрНайти(Текст, "гость_шлюз_запрещено") > 0 Тогда Код = "forbidden"; Статус = 403;
        ИначеЕсли СтрНайти(Текст, "гость_шлюз_источник_запрещено") > 0 Тогда Код = "forbidden"; Статус = 403;
        ИначеЕсли СтрНайти(Текст, "гость_шлюз_тело_слишком_большое") > 0 Тогда Код = "тело_слишком_большое"; Статус = 413;
        ИначеЕсли СтрНайти(Текст, "гость_шлюз_частота_ограничено") > 0 Тогда Код = "гость_шлюз_частота_ограничено"; Статус = 429;
        ИначеЕсли СтрНайти(Текст, "кабинет_диспетчерская_квота_превышено") > 0 Тогда Код = "кабинет_диспетчерская_квота_превышено"; Статус = 429;
        ИначеЕсли СтрНайти(Текст, "кабинет_диспетчерская_квитанция_не_найдено") > 0 Или СтрНайти(Текст, "кабинет_диспетчерская_не_найдено") > 0 Или СтрНайти(Текст, "гость_шлюз_не_найдено") > 0 Тогда Код = "не_найдено"; Статус = 404;
        ИначеЕсли СтрНайти(Текст, "кабинет_диспетчерская_запрос_конфликт") > 0 Или СтрНайти(Текст, "кабинет_диспетчерская_маршрутизация_конфликт") > 0 Тогда Код = "запрос_конфликт"; Статус = 409;
        ИначеЕсли СтрНайти(Текст, "гость_шлюз_некорректно_ввод") > 0 Или СтрНайти(Текст, "кабинет_диспетчерская_некорректно_") > 0 Или СтрНайти(Текст, "кабинет_файл_некорректно_") > 0 Или СтрНайти(Текст, "кабинет_некорректно_джсон") > 0 Или СтрНайти(Текст, "кабинет_тело_слишком_большое") > 0 Тогда Код = "некорректно_ввод"; Статус = 400;
        ИначеЕсли СтрНайти(Текст, "кабинет_диспетчерская_прием_закрыто") > 0 Или СтрНайти(Текст, "кабинет_диспетчерская_необслуживаемо_адрес_или_категория") > 0 Тогда Код = "прием_недоступно"; Статус = 409;
        КонецЕсли;
        Возврат Ошибка(Статус, Код, Корреляция);
    КонецПопытки;
КонецФункции

Процедура ПроверитьТекущегоПользователя()
    Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
    Если Пользователь = Неопределено Тогда ВызватьИсключение "гость_шлюз_запрещено"; КонецЕсли;
    Если Пользователь.Имя <> "vodokanal_intake_gateway" Или Не РольДоступна("ШлюзГостевыхОбращений") Тогда ВызватьИсключение "гость_шлюз_запрещено"; КонецЕсли;
    Количество = 0; Для Каждого Роль Из Пользователь.Роли Цикл Количество = Количество + 1; КонецЦикла;
    Если Количество <> 1 Тогда ВызватьИсключение "гость_шлюз_запрещено"; КонецЕсли;
КонецПроцедуры

Функция Ошибка(Статус, Код, Корреляция)
    Ответ = APIКабинета.СформироватьОтветHTTP(Статус, Новый Структура("error,requestId", Код, Корреляция), Корреляция);
    Ответ.Заголовки.Вставить("Cache-Control", "no-store");
    Если Код = "гость_шлюз_частота_ограничено" Тогда Ответ.Заголовки.Вставить("Retry-After", "60"); КонецЕсли;
    Возврат Ответ;
КонецФункции
