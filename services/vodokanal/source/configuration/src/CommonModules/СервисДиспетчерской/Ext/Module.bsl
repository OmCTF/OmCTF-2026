
Функция ПроверитьДоступКВложениюОбращения(СсылкаУчетнойЗаписи, Идентификатор, СотрудникРежим = Ложь, Записать = Ложь, Видимость = "Public") Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    Если Не ТранзакцияАктивна() Тогда
        ВызватьИсключение "кабинет_диспетчерская_транзакция_требуется";
    КонецЕсли;
    Если ТипЗнч(СотрудникРежим) <> Тип("Булево") Или ТипЗнч(Записать) <> Тип("Булево")
        Или ТипЗнч(Видимость) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_диспетчерская_некорректно_поле";
    КонецЕсли;
    Если Видимость <> "Public" И Видимость <> "Internal" Тогда
        ВызватьИсключение "кабинет_диспетчерская_некорректно_поле";
    КонецЕсли;
    Если Не СотрудникРежим И Видимость <> "Public" Тогда
        ВызватьИсключение "кабинет_диспетчерская_не_найдено";
    КонецЕсли;
    ПредварительныйСнимок = ПредставлениеОбращения(РазобратьИдентификатор(Идентификатор));
    ЗаблокироватьОбъектПоСсылке("Справочник.УчетныеЗаписи", СсылкаУчетнойЗаписи);
    ЗаблокироватьОбъектПоСсылке("Справочник.РабочиеПространства", ПредварительныйСнимок.РабочееПространство);
    ЗаблокироватьОбъектПоСсылке("Справочник.Области", ПредварительныйСнимок.Область);
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьАктивностьОбласти(ПредварительныйСнимок.РабочееПространство, ПредварительныйСнимок.Область);
    Если СотрудникРежим Тогда
        ПолитикаДоступа.ПроверитьДоступКОбласти(СсылкаУчетнойЗаписи, Строка(ПредварительныйСнимок.РабочееПространство.УникальныйИдентификатор()), Строка(ПредварительныйСнимок.Область.УникальныйИдентификатор()), "Dispatcher");
    КонецЕсли;
    Объект = ПолучитьЗаблокированноеОбращение(РазобратьИдентификатор(Идентификатор), ПредварительныйСнимок.РабочееПространство, ПредварительныйСнимок.Область);
    Если Не СотрудникРежим Тогда
        ПроверитьЗаявителяОбращения(СсылкаУчетнойЗаписи, Объект);
    КонецЕсли;
    Если Записать И Видимость = "Public" И ЗавершенноеСостояние(Объект.Состояние) Тогда
        ВызватьИсключение "кабинет_диспетчерская_состояние_конфликт";
    КонецЕсли;
    Возврат Новый Структура("РабочееПространство,Область,Запрос", Объект.РабочееПространство, Объект.Область, Объект.Ссылка);
КонецФункции

Функция СоздатьПриемную(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, "workspaceId,defaultAreaId,name,addresses,categories,published,accepting");
    РабочаяОбластьИдентификатор = ТекстовоеПоле(ТелоЗапроса, "workspaceId", 36);
    Конфигурация = НастройкиПриемной(ТелоЗапроса);
    Намерение = КодироватьЗначение(Новый Структура("operation,workspaceId,config", "intake.create", Строка(РазобратьИдентификатор(РабочаяОбластьИдентификатор)), Конфигурация), 16000);
    КонтекстДоступа = НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, Конфигурация.defaultAreaId, "WorkspaceOwner");
    Попытка
        Команда = ОткрытьПривязкуКоманды(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, "intake.create", Намерение, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
        Если Команда.Выбран() Тогда
            Объект = ПолучитьЗаблокированнуюПриемную(РазобратьИдентификатор(Команда.ИдентификаторСущности), КонтекстДоступа.РабочееПространство);
            Результат = ПовторитьСохраненныйРезультат(Команда, "IntakeOwner", Объект.Ссылка);
            ЗафиксироватьТранзакцию();
            Возврат Результат;
        КонецЕсли;
        Квота = КвотаРабочегоПространства(КонтекстДоступа.РабочееПространство);
        Если Квота.КоличествоПриемных >= 20 Тогда
            ВызватьИсключение "кабинет_диспетчерская_квота_превышено";
        КонецЕсли;
        Объект = Справочники.ПубличныеПриемные.СоздатьЭлемент();
        Объект.SetNewObjectRef(Справочники.ПубличныеПриемные.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
        ЗаполнитьСлужебныеОтметки(Объект, СсылкаУчетнойЗаписи, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
        ПрименитьНастройкиПриемной(Объект, Конфигурация, КонтекстДоступа.Область);
        Объект.Записать();
        Квота.КоличествоПриемных = Квота.КоличествоПриемных + 1;
        Квота.Записать();
        Результат = ДанныеПриемнойДляВладельца(Объект);
        ДобавитьЗаписьИстории("Intake", Объект, "intake.create", "Internal", "Initial intake configuration", Новый Структура, Результат, СсылкаУчетнойЗаписи, ИдентификаторЗапроса);
        СохранитьПривязкуКоманды(Команда, "IntakeOwner", Объект.Ссылка, Результат);
        ПолитикаДоступа.ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, КонтекстДоступа.РабочееПространство, "dispatch.intake.create", Строка(Объект.Ссылка.УникальныйИдентификатор()));
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция НастроитьПриемную(СсылкаУчетнойЗаписи, ПриемнаяИдентификатор, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, "expectedRevision,defaultAreaId,name,addresses,categories,published,accepting");
    Конфигурация = НастройкиПриемной(ТелоЗапроса);
    Ревизия = ПолеРевизии(ТелоЗапроса, "expectedRevision");
    ПредварительныйСнимок = ПредставлениеПриемной(РазобратьИдентификатор(ПриемнаяИдентификатор));
    КонтекстДоступа = НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, Строка(ПредварительныйСнимок.РабочееПространство.УникальныйИдентификатор()), Конфигурация.defaultAreaId, "WorkspaceOwner");
    Попытка
        Объект = ПолучитьЗаблокированнуюПриемную(РазобратьИдентификатор(ПриемнаяИдентификатор), КонтекстДоступа.РабочееПространство);
        Намерение = КодироватьЗначение(Новый Структура("operation,intakeId,workspaceId,expectedRevision,config", "intake.configure", Строка(Объект.Ссылка.УникальныйИдентификатор()),
            Строка(КонтекстДоступа.РабочееПространство.УникальныйИдентификатор()), Ревизия, Конфигурация), 16000);
        Команда = ОткрытьПривязкуКоманды(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, "intake.configure", Намерение, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
        Если Команда.Выбран() Тогда
            Результат = ПовторитьСохраненныйРезультат(Команда, "IntakeOwner", Объект.Ссылка);
            ЗафиксироватьТранзакцию();
            Возврат Результат;
        КонецЕсли;
        ПроверитьТекущуюРевизию(Объект, Ревизия);
        Перед = ДанныеПриемнойДляВладельца(Объект);
        ПрименитьНастройкиПриемной(Объект, Конфигурация, КонтекстДоступа.Область);
        УвеличитьРевизиюОбъекта(Объект);
        Объект.Записать();
        Результат = ДанныеПриемнойДляВладельца(Объект);
        ДобавитьЗаписьИстории("Intake", Объект, "intake.configure", "Internal", "Intake configuration", Перед, Результат, СсылкаУчетнойЗаписи, ИдентификаторЗапроса);
        СохранитьПривязкуКоманды(Команда, "IntakeOwner", Объект.Ссылка, Результат);
        ПолитикаДоступа.ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, КонтекстДоступа.РабочееПространство, "dispatch.intake.configure", Строка(Объект.Ссылка.УникальныйИдентификатор()));
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СписокПриемныхВладельца(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьОтсутствиеТранзакции();
    СсылкаРабочейОбласти = Справочники.РабочиеПространства.ПолучитьСсылку(РазобратьИдентификатор(РабочаяОбластьИдентификатор));
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьОбъектПоСсылке("Справочник.УчетныеЗаписи", СсылкаУчетнойЗаписи);
        ЗаблокироватьОбъектПоСсылке("Справочник.РабочиеПространства", СсылкаРабочейОбласти);
        ПолитикаДоступа.ПроверитьДоступКРабочемуПространству(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, "WorkspaceOwner");
        Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 100 Ссылка ИЗ Справочник.ПубличныеПриемные ГДЕ РабочееПространство = &РабочееПространство И НЕ ПометкаУдаления УПОРЯДОЧИТЬ ПО ДатаСоздания, Ссылка");
        Запрос.УстановитьПараметр("РабочееПространство", СсылкаРабочейОбласти);
        Выборка = Запрос.Выполнить().Выбрать();
        Результат = Новый Массив;
        Пока Выборка.Следующий() Цикл
            Результат.Добавить(ДанныеПриемнойДляВладельца(Выборка.Ссылка.ПолучитьОбъект()));
        КонецЦикла;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СписокОпубликованныхПриемных(СсылкаУчетнойЗаписи) Экспорт
    НачатьОперациюУчастника(СсылкаУчетнойЗаписи);
    Попытка
        Запрос = Новый Запрос(
            "ВЫБРАТЬ ПЕРВЫЕ 100 Ссылка ИЗ Справочник.ПубличныеПриемные
            |ГДЕ Опубликована И НЕ ПометкаУдаления И РабочееПространство.Состояние = &Действующий И НЕ РабочееПространство.ПометкаУдаления
            |И ОбластьПоУмолчанию.РабочееПространство = РабочееПространство И ОбластьПоУмолчанию.Состояние = &Действующий И НЕ ОбластьПоУмолчанию.ПометкаУдаления
            |УПОРЯДОЧИТЬ ПО Наименование, Ссылка");
        Запрос.УстановитьПараметр("Действующий", "Active");
        Выборка = Запрос.Выполнить().Выбрать();
        Результат = Новый Массив;
        Пока Выборка.Следующий() Цикл
            Результат.Добавить(ДанныеПриемнойДляЗаявителя(Выборка.Ссылка.ПолучитьОбъект()));
        КонецЦикла;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СоздатьСобственноеОбращение(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, "publicIntakeId,address,category,title,description,contact");
    ПриемнаяИдентификатор = Строка(РазобратьИдентификатор(ТекстовоеПоле(ТелоЗапроса, "publicIntakeId", 36)));
    Адрес = ТекстовоеПоле(ТелоЗапроса, "address", 250);
    Категория = ПолеИзПеречня(ТелоЗапроса, "category", "Leak,NoWater,Pressure,Sewer,Manhole,Quality,Billing,Other");
    ЗаголовокЗадачи = ТекстовоеПоле(ТелоЗапроса, "title", 150);
    Описание = ТекстовоеПоле(ТелоЗапроса, "description", 2000, Истина);
    Контакт = ПолеПечатногоТекста(ТелоЗапроса, "contact", 128);
    Намерение = КодироватьЗначение(Новый Структура("operation,publicIntakeId,address,category,title,description,contact",
        "request.create", ПриемнаяИдентификатор, Адрес, Категория, ЗаголовокЗадачи, Описание, Контакт), 16000);
    Маршрут = МаршрутКоманды(СсылкаУчетнойЗаписи, ИдентификаторЗапроса);
    Если Маршрут <> Неопределено Тогда
        Если Маршрут.Операция <> "request.create" Или Маршрут.ВидСущности <> "RequestPublic" Тогда
            ВызватьИсключение "кабинет_диспетчерская_запрос_конфликт";
        КонецЕсли;
        КонтекстДоступа = НачатьОперациюСОбращением(СсылкаУчетнойЗаписи, Маршрут.ИдентификаторСущности, Ложь);
        Попытка
            Команда = ОткрытьПривязкуКоманды(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, "request.create", Намерение, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
            Если Не Команда.Выбран() Тогда
                ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт";
            КонецЕсли;
            Результат = ПовторитьСохраненныйРезультат(Команда, "RequestPublic", КонтекстДоступа.Объект.Ссылка);
            ЗафиксироватьТранзакцию();
        Исключение
            ОтменитьСобственнуюТранзакцию();
            ВызватьИсключение;
        КонецПопытки;
        Возврат Результат;
    КонецЕсли;
    ПредварительныйСнимок = ПредставлениеПриемной(РазобратьИдентификатор(ПриемнаяИдентификатор));
    КонтекстДоступа = НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, Строка(ПредварительныйСнимок.РабочееПространство.УникальныйИдентификатор()), Строка(ПредварительныйСнимок.ОбластьПоУмолчанию.УникальныйИдентификатор()), "");
    Попытка
        Приемная = ПолучитьЗаблокированнуюПриемную(РазобратьИдентификатор(ПриемнаяИдентификатор), КонтекстДоступа.РабочееПространство);
        Команда = ОткрытьПривязкуКоманды(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, "request.create", Намерение, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
        Если Команда.Выбран() Тогда
            Объект = ПолучитьЗаблокированноеОбращение(РазобратьИдентификатор(Команда.ИдентификаторСущности), КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
            ПроверитьЗаявителяОбращения(СсылкаУчетнойЗаписи, Объект);
            Результат = ПовторитьСохраненныйРезультат(Команда, "RequestPublic", Объект.Ссылка);
            ЗафиксироватьТранзакцию();
            Возврат Результат;
        КонецЕсли;
        Если Приемная.ОбластьПоУмолчанию <> КонтекстДоступа.Область Тогда
            ВызватьИсключение "кабинет_диспетчерская_маршрутизация_конфликт";
        КонецЕсли;
        Если Не Приемная.Опубликована Или Не Приемная.ПринимаетОбращения Тогда
            ВызватьИсключение "кабинет_диспетчерская_прием_закрыто";
        КонецЕсли;
        Адреса = СохраненныеАдреса(Приемная.АдресаJSON);
        Категории = СохраненныеКатегории(Приемная.КатегорииJSON);
        Если Адреса.Найти(Адрес) = Неопределено Или Категории.Найти(Категория) = Неопределено Тогда
            ВызватьИсключение "кабинет_диспетчерская_необслуживаемо_адрес_или_категория";
        КонецЕсли;
        ДействующееЛицоКвота = ПрочитатьКвотуУчастника(СсылкаУчетнойЗаписи);
        Квота = КвотаРабочегоПространства(КонтекстДоступа.РабочееПространство);
        Если ДействующееЛицоКвота.КоличествоОбращений >= 1000 Или Квота.КоличествоОбращений >= 10000 Тогда
            ВызватьИсключение "кабинет_диспетчерская_квота_превышено";
        КонецЕсли;
        Объект = Справочники.ОбращенияДиспетчерской.СоздатьЭлемент();
        Объект.SetNewObjectRef(Справочники.ОбращенияДиспетчерской.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
        ЗаполнитьСлужебныеОтметки(Объект, СсылкаУчетнойЗаписи, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
        Объект.Наименование = ЗаголовокЗадачи;
        Объект.Заявитель = СсылкаУчетнойЗаписи;
        Объект.Источник = "Portal";
        Объект.Приемная = Приемная.Ссылка;
        Объект.НаименованиеПриемной = Приемная.Наименование;
        Объект.Адрес = Адрес;
        Объект.Категория = Категория;
        Объект.Подробности = Описание;
        Объект.Контакт = Контакт;
        Объект.Состояние = "Submitted";
        Объект.СостояниеВозобновления = "";
        Объект.Этап = 1;
        Объект.КоличествоСообщений = 0;
        Объект.Приоритет = "Normal";
        Если Категория = "Manhole" Тогда
            Объект.Приоритет = "Critical";
        ИначеЕсли Категория = "NoWater" Тогда
            Объект.Приоритет = "High";
        КонецЕсли;
        Объект.СрокИсполнения = ТекущаяУниверсальнаяДата() + 172800;
        Объект.Ответственный = Справочники.УчетныеЗаписи.ПустаяСсылка();
        Объект.Инцидент = Справочники.ИнцидентыДиспетчерской.ПустаяСсылка();
        Объект.ДатаПринятия = Дата(1, 1, 1);
        Объект.ДатаЗавершения = Дата(1, 1, 1);
        Объект.ПоследнееПубличноеОснование = "";
        Объект.Записать();
        ДействующееЛицоКвота.КоличествоОбращений = ДействующееЛицоКвота.КоличествоОбращений + 1;
        ДействующееЛицоКвота.Записать();
        Квота.КоличествоОбращений = Квота.КоличествоОбращений + 1;
        Квота.Записать();
        Результат = ДанныеСобственногоОбращения(Объект);
        ДобавитьЗаписьИстории("Request", Объект, "request.create", "Public", "Submitted", Новый Структура, СлужебныеДанныеОбращения(Объект), СсылкаУчетнойЗаписи, ИдентификаторЗапроса);
        СохранитьПривязкуКоманды(Команда, "RequestPublic", Объект.Ссылка, Результат);
        ПолитикаДоступа.ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, КонтекстДоступа.РабочееПространство, "dispatch.request.create", Строка(Объект.Ссылка.УникальныйИдентификатор()));
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СписокМоихЗаявок(СсылкаУчетнойЗаписи) Экспорт
