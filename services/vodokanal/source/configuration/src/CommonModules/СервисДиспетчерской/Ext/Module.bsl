Функция СписокОбращенийДиспетчерской(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, Состояние = "") Экспорт
    Если Состояние <> "" И СтрРазделить("Submitted,Accepted,AwaitingInfo,Rejected,Resolved", ",").Найти(Состояние) = Неопределено Тогда
        ВызватьИсключение "кабинет_диспетчерская_некорректно_состояние";
    КонецЕсли;
    КонтекстДоступа = НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, "Dispatcher");
    Попытка
        Запрос = Новый Запрос(
            "ВЫБРАТЬ ПЕРВЫЕ 100 Ссылка ИЗ Справочник.ОбращенияДиспетчерской
            |ГДЕ РабочееПространство = &РабочееПространство И Область = &Область И НЕ ПометкаУдаления
            |И (&ЛюбойСостояние ИЛИ Состояние = &Состояние) УПОРЯДОЧИТЬ ПО СрокИсполнения, ДатаСоздания, Ссылка");
        УстановитьКонтекстОбласти(Запрос, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
        Запрос.УстановитьПараметр("ЛюбойСостояние", Состояние = "");
        Запрос.УстановитьПараметр("Состояние", Состояние);
        Выборка = Запрос.Выполнить().Выбрать();
        Результат = Новый Массив;
        Пока Выборка.Следующий() Цикл
            Результат.Добавить(СлужебныеДанныеОбращения(Выборка.Ссылка.ПолучитьОбъект()));
        КонецЦикла;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

