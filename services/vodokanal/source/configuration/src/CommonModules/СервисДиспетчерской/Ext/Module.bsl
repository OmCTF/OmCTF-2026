Функция СписокЗаписейИсторииОбращения(СсылкаУчетнойЗаписи, Идентификатор, СотрудникРежим = Ложь, Лимит = 25, Курсор = "") Экспорт
    КонтекстДоступа = НачатьОперациюСОбращением(СсылкаУчетнойЗаписи, Идентификатор, СотрудникРежим);
    Попытка
        Если ТипЗнч(Лимит) <> Тип("Число") Или Лимит < 1 Или Лимит > 100 Или Цел(Лимит) <> Лимит Тогда ВызватьИсключение "кабинет_диспетчерская_некорректно_поле"; КонецЕсли;
        Префикс = "dh1|" + Строка(СсылкаУчетнойЗаписи.УникальныйИдентификатор()) + "|" + Идентификатор + "|" + Строка(СотрудникРежим) + "|";
        ПослеРевизии = 999999999999999;
        Если Курсор <> "" Тогда
            Если ТипЗнч(Курсор) <> Тип("Строка") Или Лев(Курсор, СтрДлина(Префикс)) <> Префикс Тогда ВызватьИсключение "кабинет_диспетчерская_некорректно_поле"; КонецЕсли;
            Позиция = Сред(Курсор, СтрДлина(Префикс) + 1);
            Если СтрДлина(Позиция) < 1 Или СтрДлина(Позиция) > 15 Тогда ВызватьИсключение "кабинет_диспетчерская_некорректно_поле"; КонецЕсли;
            Для П = 1 По СтрДлина(Позиция) Цикл Если СтрНайти("0123456789", Сред(Позиция, П, 1)) = 0 Тогда ВызватьИсключение "кабинет_диспетчерская_некорректно_поле"; КонецЕсли; КонецЦикла;
            ПослеРевизии = Число(Позиция);
        КонецЕсли;
        Запрос = Новый Запрос(
            "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит + 1, "ЧГ=0") + " Ревизия, Операция, Видимость, Причина, ДействующееЛицо, ДатаИзменения, СнимокДоJSON, СнимокПослеJSON
            |ИЗ РегистрСведений.ИсторияДиспетчерской ГДЕ РабочееПространство = &РабочееПространство И Область = &Область
            |И ВидСущности = &Вид И ИдентификаторСущности = &ИдентификаторСущности И (&Сотрудник ИЛИ Видимость = &Общедоступный)
            |И Ревизия < &ПослеРевизии УПОРЯДОЧИТЬ ПО Ревизия УБЫВ");
        Запрос.УстановитьПараметр("ПослеРевизии", ПослеРевизии);
        УстановитьКонтекстОбласти(Запрос, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
        Запрос.УстановитьПараметр("Вид", "Request");
        Запрос.УстановитьПараметр("ИдентификаторСущности", Строка(КонтекстДоступа.Объект.Ссылка.УникальныйИдентификатор()));
        Запрос.УстановитьПараметр("Сотрудник", СотрудникРежим);
        Запрос.УстановитьПараметр("Общедоступный", "Public");
        Выборка = Запрос.Выполнить().Выбрать();
        Результат = Новый Массив; ЕстьЕще = Ложь; Следующий = "";
        Пока Выборка.Следующий() Цикл
            Если Результат.Количество() = Лимит Тогда ЕстьЕще = Истина; Прервать; КонецЕсли;
            Перед = ПроверенныйСнимокОбращения(ДекодироватьСтруктуру(Выборка.СнимокДоJSON), КонтекстДоступа.Объект);
            После = ПроверенныйСнимокОбращения(ДекодироватьСтруктуру(Выборка.СнимокПослеJSON), КонтекстДоступа.Объект);
            Если После.Количество() = 0 Тогда
                ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт";
            КонецЕсли;
            Если После.revision <> Выборка.Ревизия Тогда
                ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт";
            КонецЕсли;
            Если Перед.Количество() > 0 Тогда
                Если Перед.revision + 1 <> Выборка.Ревизия Тогда
                    ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт";
                КонецЕсли;
            КонецЕсли;
            Если Не СотрудникРежим Тогда
                Перед = СнимокДанныхДляЗаявителя(Перед);
                После = СнимокДанныхДляЗаявителя(После);
            КонецЕсли;
            Событие = Новый Структура("revision,operation,reason,changedAt,before,after", Выборка.Ревизия,
                Выборка.Операция, Выборка.Причина, XMLСтрока(Выборка.ДатаИзменения) + "Z", Перед, После);
            Если СотрудникРежим Тогда
                Событие.Вставить("actorAccountId", Строка(Выборка.ДействующееЛицо.УникальныйИдентификатор()));
                Событие.Вставить("visibility", Выборка.Видимость);
            Иначе
                Если ЗначениеЗаполнено(Выборка.ДействующееЛицо) Тогда
                    Событие.Вставить("authorLabel", МеткаАвтора(Выборка.ДействующееЛицо = КонтекстДоступа.Объект.Заявитель));
                Иначе
                    Событие.Вставить("authorLabel", "Guest");
                КонецЕсли;
            КонецЕсли;
            Результат.Добавить(Событие);
            Следующий = Префикс + Формат(Выборка.Ревизия, "ЧГ=0");
        КонецЦикла;
        Если Не ЕстьЕще Тогда Следующий = ""; КонецЕсли;
        Результат = Новый Структура("items,limit,hasMore,nextCursor", Результат, Лимит, ЕстьЕще, Следующий);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СоздатьИнцидент(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, "workspaceId,areaId,title,type,severity,startedAt,forecastAt,description");
    РабочаяОбластьИдентификатор = ТекстовоеПоле(ТелоЗапроса, "workspaceId", 36);
    ОбластьИдентификатор = ТекстовоеПоле(ТелоЗапроса, "areaId", 36);
    ЗаголовокЗадачи = ТекстовоеПоле(ТелоЗапроса, "title", 150);
    ТипИнцидента = ПолеИзПеречня(ТелоЗапроса, "type", "Leak,Supply,Sewer,Other");
    Тяжесть = ПолеИзПеречня(ТелоЗапроса, "severity", "Minor,Moderate,Major,Critical");
    ДатаФактическогоНачала = ПолеДатыUTC(ТелоЗапроса, "startedAt");
    ПрогнозОкончания = ПолеДатыUTC(ТелоЗапроса, "forecastAt");
    Подробности = ТекстовоеПоле(ТелоЗапроса, "description", 2000, Истина);
    Намерение = КодироватьЗначение(Новый Структура("operation,workspaceId,areaId,title,type,severity,startedAt,forecastAt,description",
        "incident.create", Строка(РазобратьИдентификатор(РабочаяОбластьИдентификатор)), Строка(РазобратьИдентификатор(ОбластьИдентификатор)), ЗаголовокЗадачи, ТипИнцидента, Тяжесть,
        XMLСтрока(ДатаФактическогоНачала), XMLСтрока(ПрогнозОкончания), Подробности), 16000);
    КонтекстДоступа = НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, "Dispatcher");
    Попытка
        Команда = ОткрытьПривязкуКоманды(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, "incident.create", Намерение, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
        Если Команда.Выбран() Тогда
            Объект = ПолучитьЗаблокированныйИнцидент(РазобратьИдентификатор(Команда.ИдентификаторСущности), КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
            Результат = ПовторитьСохраненныйРезультат(Команда, "IncidentStaff", Объект.Ссылка);
            ЗафиксироватьТранзакцию();
            Возврат Результат;
        КонецЕсли;
        ПроверитьДатыИнцидента(ДатаФактическогоНачала, ПрогнозОкончания);
        Квота = КвотаРабочегоПространства(КонтекстДоступа.РабочееПространство);
        Если Квота.КоличествоИнцидентов >= 1000 Тогда
            ВызватьИсключение "кабинет_диспетчерская_квота_превышено";
        КонецЕсли;
        Объект = Справочники.ИнцидентыДиспетчерской.СоздатьЭлемент();
        Объект.SetNewObjectRef(Справочники.ИнцидентыДиспетчерской.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
        ЗаполнитьСлужебныеОтметки(Объект, СсылкаУчетнойЗаписи, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
        Объект.Наименование = ЗаголовокЗадачи;
        Объект.ТипИнцидента = ТипИнцидента;
        Объект.Тяжесть = Тяжесть;
        Объект.ДатаФактическогоНачала = ДатаФактическогоНачала;
        Объект.ПрогнозОкончания = ПрогнозОкончания;
        Объект.ДатаЗавершения = Дата(1, 1, 1);
        Объект.Подробности = Подробности;
        Объект.Ответственный = СсылкаУчетнойЗаписи;
        Объект.Состояние = "Open";
        Объект.Записать();
        Квота.КоличествоИнцидентов = Квота.КоличествоИнцидентов + 1;
        Квота.Записать();
        Результат = ДанныеИнцидента(Объект);
        ДобавитьЗаписьИстории("Incident", Объект, "incident.create", "Internal", "Initial incident", Новый Структура, Результат, СсылкаУчетнойЗаписи, ИдентификаторЗапроса);
        СохранитьПривязкуКоманды(Команда, "IncidentStaff", Объект.Ссылка, Результат);
        ПолитикаДоступа.ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, КонтекстДоступа.РабочееПространство, "dispatch.incident.create", Строка(Объект.Ссылка.УникальныйИдентификатор()));
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СписокИнцидентов(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор) Экспорт
    КонтекстДоступа = НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, "Dispatcher");
    Попытка
        Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 100 Ссылка ИЗ Справочник.ИнцидентыДиспетчерской ГДЕ РабочееПространство = &РабочееПространство И Область = &Область И НЕ ПометкаУдаления УПОРЯДОЧИТЬ ПО ДатаСоздания УБЫВ, Ссылка");
        УстановитьКонтекстОбласти(Запрос, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
        Выборка = Запрос.Выполнить().Выбрать();
        Результат = Новый Массив;
        Пока Выборка.Следующий() Цикл
            Результат.Добавить(ДанныеИнцидента(Выборка.Ссылка.ПолучитьОбъект()));
        КонецЦикла;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПолучитьИнцидент(СсылкаУчетнойЗаписи, Идентификатор) Экспорт
    КонтекстДоступа = НачатьОперациюСИнцидентом(СсылкаУчетнойЗаписи, Идентификатор);
    Попытка
        Результат = Новый Структура("incident,requests", ДанныеИнцидента(КонтекстДоступа.Объект), СвязанныеОбращения(КонтекстДоступа.Объект));
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ОбновитьИнцидент(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    Возврат ИзменитьИнцидент(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса, Ложь);
КонецФункции

Функция ЗавершитьИнцидент(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    Возврат ИзменитьИнцидент(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса, Истина);
КонецФункции

Функция СвязатьСИнцидентом(СсылкаУчетнойЗаписи, Идентификатор, ИнцидентИдентификатор, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    Возврат ИзменитьСвязь(СсылкаУчетнойЗаписи, Идентификатор, ИнцидентИдентификатор, ТелоЗапроса, ИдентификаторЗапроса, Ложь);
КонецФункции

Функция ОтменитьСвязьСИнцидентом(СсылкаУчетнойЗаписи, Идентификатор, ИнцидентИдентификатор, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    Возврат ИзменитьСвязь(СсылкаУчетнойЗаписи, Идентификатор, ИнцидентИдентификатор, ТелоЗапроса, ИдентификаторЗапроса, Истина);
КонецФункции

Функция ИзменитьОбращение(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса, Операция, СотрудникРежим)
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ЭтоСообщение = Операция = "requester.reply" Или Операция = "staff.reply" Или Операция = "staff.note";
    Если ЭтоСообщение Тогда
        ПроверитьПоляТелаЗапроса(ТелоЗапроса, "expectedRevision,text");
        Текст = ТекстовоеПоле(ТелоЗапроса, "text", 4000, Истина);
        Причина = "Public reply";
        Если Операция = "staff.note" Тогда
            Причина = "Internal note";
        КонецЕсли;
    ИначеЕсли Операция = "staff.triage" Тогда
        ПроверитьПоляТелаЗапроса(ТелоЗапроса, "expectedRevision,priority,dueAt,reason");
        Приоритет = ПолеИзПеречня(ТелоЗапроса, "priority", "Low,Normal,High,Critical");
        СрокИсполнения = ПолеДатыUTC(ТелоЗапроса, "dueAt");
        Причина = ТекстовоеПоле(ТелоЗапроса, "reason", 250);
    Иначе
        ПроверитьПоляТелаЗапроса(ТелоЗапроса, "expectedRevision,reason");
        Причина = ТекстовоеПоле(ТелоЗапроса, "reason", 250);
    КонецЕсли;
    Ревизия = ПолеРевизии(ТелоЗапроса, "expectedRevision");
    Изменения = Новый Структура("expectedRevision,reason", Ревизия, Причина);
    Если ЭтоСообщение Тогда
        Изменения.Вставить("text", Текст);
    ИначеЕсли Операция = "staff.triage" Тогда
        Изменения.Вставить("priority", Приоритет);
        Изменения.Вставить("dueAt", XMLСтрока(СрокИсполнения));
    КонецЕсли;
    КонтекстДоступа = НачатьОперациюСОбращением(СсылкаУчетнойЗаписи, Идентификатор, СотрудникРежим);
    Попытка
        Объект = КонтекстДоступа.Объект;
        Намерение = КодироватьЗначение(Новый Структура("operation,workspaceId,areaId,entityId,changes", Операция,
            Строка(КонтекстДоступа.РабочееПространство.УникальныйИдентификатор()), Строка(КонтекстДоступа.Область.УникальныйИдентификатор()), Строка(Объект.Ссылка.УникальныйИдентификатор()), Изменения), 16000);
        ВидРезультата = "RequestPublic";
        Если СотрудникРежим Тогда
            ВидРезультата = "RequestStaff";
        КонецЕсли;
        Команда = ОткрытьПривязкуКоманды(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, Операция, Намерение, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
        Если Команда.Выбран() Тогда
            Результат = ПовторитьСохраненныйРезультат(Команда, ВидРезультата, Объект.Ссылка);
            ЗафиксироватьТранзакцию();
            Возврат Результат;
        КонецЕсли;
        ПроверитьТекущуюРевизию(Объект, Ревизия);
        Перед = СлужебныеДанныеОбращения(Объект);
        Видимость = "Public";
        ТекущееВремя = ТекущаяУниверсальнаяДата();
        Если ЭтоСообщение Тогда
            Если Операция <> "staff.note" И ЗавершенноеСостояние(Объект.Состояние) Тогда
                ВызватьИсключение "кабинет_диспетчерская_состояние_конфликт";
            КонецЕсли;
            Если Объект.КоличествоСообщений >= 200 Тогда
                ВызватьИсключение "кабинет_диспетчерская_квота_превышено";
            КонецЕсли;
            Если Операция = "staff.note" Тогда
                Видимость = "Internal";
            КонецЕсли;
            Если Операция = "requester.reply" И Объект.Состояние = "AwaitingInfo" Тогда
                Если Объект.СостояниеВозобновления <> "Submitted" И Объект.СостояниеВозобновления <> "Accepted" Тогда
                    ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт";
                КонецЕсли;
                Объект.Состояние = Объект.СостояниеВозобновления;
                Объект.СостояниеВозобновления = "";
            КонецЕсли;
            Объект.КоличествоСообщений = Объект.КоличествоСообщений + 1;
            Сообщение = Справочники.СообщенияОбращений.СоздатьЭлемент();
            Сообщение.SetNewObjectRef(Справочники.СообщенияОбращений.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
            ЗаполнитьСлужебныеОтметки(Сообщение, СсылкаУчетнойЗаписи, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
            Сообщение.Наименование = "Immutable dispatch message";
            Сообщение.ЗаявкаНаОбслуживание = Объект.Ссылка;
            Сообщение.Видимость = Видимость;
            Сообщение.ТекстСообщения = Текст;
            Сообщение.ВидАвтора = "Dispatcher";
            Если Операция = "requester.reply" Тогда
                Сообщение.ВидАвтора = "Requester";
            КонецЕсли;
            Сообщение.Записать();
        ИначеЕсли Операция = "staff.triage" Тогда
            Если ЗавершенноеСостояние(Объект.Состояние) Тогда
                ВызватьИсключение "кабинет_диспетчерская_состояние_конфликт";
            КонецЕсли;
            Если СрокИсполнения < ТекущееВремя Или СрокИсполнения > ТекущееВремя + 2592000 Тогда
                ВызватьИсключение "кабинет_диспетчерская_некорректно_даты";
            КонецЕсли;
            Видимость = "Internal";
            Объект.Приоритет = Приоритет;
            Объект.СрокИсполнения = СрокИсполнения;
            Объект.Ответственный = СсылкаУчетнойЗаписи;
        ИначеЕсли Операция = "staff.accept" Тогда
            Если Объект.Состояние <> "Submitted" Тогда
                ВызватьИсключение "кабинет_диспетчерская_состояние_конфликт";
            КонецЕсли;
            Объект.Состояние = "Accepted";
            Объект.ДатаПринятия = ТекущееВремя;
            Объект.Ответственный = СсылкаУчетнойЗаписи;
            Объект.СрокИсполнения = ТекущееВремя + 172800;
        ИначеЕсли Операция = "staff.reject" Тогда
            Если Объект.Состояние <> "Submitted" И Объект.Состояние <> "Accepted" Тогда
                ВызватьИсключение "кабинет_диспетчерская_состояние_конфликт";
            КонецЕсли;
            Объект.Состояние = "Rejected";
            Объект.ДатаЗавершения = ТекущееВремя;
        ИначеЕсли Операция = "staff.ask-info" Тогда
            Если Объект.Состояние <> "Submitted" И Объект.Состояние <> "Accepted" Тогда
                ВызватьИсключение "кабинет_диспетчерская_состояние_конфликт";
            КонецЕсли;
            Объект.СостояниеВозобновления = Объект.Состояние;
            Объект.Состояние = "AwaitingInfo";
        ИначеЕсли Операция = "staff.resolve" Тогда
            Если Объект.Состояние <> "Accepted" Тогда
                ВызватьИсключение "кабинет_диспетчерская_состояние_конфликт";
            КонецЕсли;
            Объект.Состояние = "Resolved";
            Объект.ДатаЗавершения = ТекущееВремя;
        ИначеЕсли Операция = "staff.reopen" Или Операция = "requester.reopen" Тогда
            Если Не ЗавершенноеСостояние(Объект.Состояние) Тогда
                ВызватьИсключение "кабинет_диспетчерская_состояние_конфликт";
            КонецЕсли;
            Если Объект.Этап >= 20 Тогда
                ВызватьИсключение "кабинет_диспетчерская_квота_превышено";
            КонецЕсли;
            Объект.Этап = Объект.Этап + 1;
            Объект.СостояниеВозобновления = "";
            Объект.ДатаЗавершения = Дата(1, 1, 1);
            Объект.СрокИсполнения = ТекущееВремя + 172800;
            Если Операция = "staff.reopen" Тогда
                Объект.Состояние = "Accepted";
                Объект.Ответственный = СсылкаУчетнойЗаписи;
                Объект.ДатаПринятия = ТекущееВремя;
            Иначе
                Объект.Состояние = "Submitted";
                Объект.Ответственный = Справочники.УчетныеЗаписи.ПустаяСсылка();
                Объект.ДатаПринятия = Дата(1, 1, 1);
            КонецЕсли;
        Иначе
            ВызватьИсключение "кабинет_диспетчерская_некорректно_действие";
        КонецЕсли;
        Если Не ЭтоСообщение И Видимость = "Public" Тогда
            Объект.ПоследнееПубличноеОснование = Причина;
        КонецЕсли;
        УвеличитьРевизиюОбъекта(Объект);
        Объект.Записать();
        После = СлужебныеДанныеОбращения(Объект);
        ДобавитьЗаписьИстории("Request", Объект, Операция, Видимость, Причина, Перед, После, СсылкаУчетнойЗаписи, ИдентификаторЗапроса);
        Если СотрудникРежим Тогда
            Результат = После;
        Иначе
            Результат = ДанныеСобственногоОбращения(Объект);
        КонецЕсли;
        СохранитьПривязкуКоманды(Команда, ВидРезультата, Объект.Ссылка, Результат);
        Если СотрудникРежим И Видимость = "Public" И ЗначениеЗаполнено(Объект.Заявитель) Тогда
            ИдСобытия = Строка(Объект.Ссылка.УникальныйИдентификатор());
            ТемаСобытия = ?(Объект.Состояние = "AwaitingInfo", "request", "application");
            СервисУведомлений.СоздатьСобытие(Объект.Заявитель, ТемаСобытия, "dispatch:" + ИдСобытия + ":" + Формат(Объект.Ревизия, "ЧГ=0"), ИдСобытия, Объект.Состояние, Объект.РабочееПространство);
        КонецЕсли;
        ПолитикаДоступа.ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, КонтекстДоступа.РабочееПространство, "dispatch." + Операция, Строка(Объект.Ссылка.УникальныйИдентификатор()));
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ИзменитьИнцидент(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса, Разрешить)
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    Операция = "incident.update";
    Если Разрешить Тогда
        ПроверитьПоляТелаЗапроса(ТелоЗапроса, "expectedRevision,reason");
        Операция = "incident.resolve";
    Иначе
        ПроверитьПоляТелаЗапроса(ТелоЗапроса, "expectedRevision,severity,forecastAt,description,reason");
        Тяжесть = ПолеИзПеречня(ТелоЗапроса, "severity", "Minor,Moderate,Major,Critical");
        ПрогнозОкончания = ПолеДатыUTC(ТелоЗапроса, "forecastAt");
        Подробности = ТекстовоеПоле(ТелоЗапроса, "description", 2000, Истина);
    КонецЕсли;
    Ревизия = ПолеРевизии(ТелоЗапроса, "expectedRevision");
    Причина = ТекстовоеПоле(ТелоЗапроса, "reason", 250);
    Изменения = Новый Структура("expectedRevision,reason", Ревизия, Причина);
    Если Не Разрешить Тогда
        Изменения.Вставить("severity", Тяжесть);
        Изменения.Вставить("forecastAt", XMLСтрока(ПрогнозОкончания));
        Изменения.Вставить("description", Подробности);
    КонецЕсли;
    КонтекстДоступа = НачатьОперациюСИнцидентом(СсылкаУчетнойЗаписи, Идентификатор);
    Попытка
        Объект = КонтекстДоступа.Объект;
        Намерение = КодироватьЗначение(Новый Структура("operation,workspaceId,areaId,entityId,changes", Операция,
            Строка(КонтекстДоступа.РабочееПространство.УникальныйИдентификатор()), Строка(КонтекстДоступа.Область.УникальныйИдентификатор()), Строка(Объект.Ссылка.УникальныйИдентификатор()), Изменения), 16000);
        Команда = ОткрытьПривязкуКоманды(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, Операция, Намерение, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
        Если Команда.Выбран() Тогда
            Результат = ПовторитьСохраненныйРезультат(Команда, "IncidentStaff", Объект.Ссылка);
            ЗафиксироватьТранзакцию();
            Возврат Результат;
        КонецЕсли;
        ПроверитьТекущуюРевизию(Объект, Ревизия);
        Если Объект.Состояние <> "Open" Тогда
            ВызватьИсключение "кабинет_диспетчерская_состояние_конфликт";
        КонецЕсли;
        Перед = ДанныеИнцидента(Объект);
        Если Разрешить Тогда
            Если ТекущаяУниверсальнаяДата() < Объект.ДатаФактическогоНачала Тогда
                ВызватьИсключение "кабинет_диспетчерская_некорректно_даты";
            КонецЕсли;
            Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ОбращенияДиспетчерской ГДЕ Инцидент = &Инцидент И НЕ ПометкаУдаления И Состояние <> &Разрешенный И Состояние <> &Отклоненный");
            Запрос.УстановитьПараметр("Инцидент", Объект.Ссылка);
            Запрос.УстановитьПараметр("Разрешенный", "Resolved");
            Запрос.УстановитьПараметр("Отклоненный", "Rejected");
            Если Не Запрос.Выполнить().Пустой() Тогда
                ВызватьИсключение "кабинет_диспетчерская_активно_связано_запросы";
            КонецЕсли;
            СервисНарядов.ПроверитьГотовностьИнцидента(СсылкаУчетнойЗаписи, Объект.Ссылка);
            Объект.Состояние = "Resolved";
            Объект.ДатаЗавершения = ТекущаяУниверсальнаяДата();
        Иначе
            ПроверитьДатыИнцидента(Объект.ДатаФактическогоНачала, ПрогнозОкончания);
            Объект.Тяжесть = Тяжесть;
            Объект.ПрогнозОкончания = ПрогнозОкончания;
            Объект.Подробности = Подробности;
            Объект.Ответственный = СсылкаУчетнойЗаписи;
        КонецЕсли;
        УвеличитьРевизиюОбъекта(Объект);
        Объект.Записать();
        Результат = ДанныеИнцидента(Объект);
        ДобавитьЗаписьИстории("Incident", Объект, Операция, "Internal", Причина, Перед, Результат, СсылкаУчетнойЗаписи, ИдентификаторЗапроса);
        СохранитьПривязкуКоманды(Команда, "IncidentStaff", Объект.Ссылка, Результат);
        ПолитикаДоступа.ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, КонтекстДоступа.РабочееПространство, "dispatch." + Операция, Строка(Объект.Ссылка.УникальныйИдентификатор()));
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ИзменитьСвязь(СсылкаУчетнойЗаписи, Идентификатор, ИнцидентИдентификатор, ТелоЗапроса, ИдентификаторЗапроса, Отвязать)
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, "requestExpectedRevision,incidentExpectedRevision,reason");
    ЗапросКлиентаРевизия = ПолеРевизии(ТелоЗапроса, "requestExpectedRevision");
    ИнцидентРевизия = ПолеРевизии(ТелоЗапроса, "incidentExpectedRevision");
    Причина = ТекстовоеПоле(ТелоЗапроса, "reason", 250);
    ПредварительныйСнимок = ПредставлениеОбращения(РазобратьИдентификатор(Идентификатор));
    КонтекстДоступа = НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, Строка(ПредварительныйСнимок.РабочееПространство.УникальныйИдентификатор()), Строка(ПредварительныйСнимок.Область.УникальныйИдентификатор()), "Dispatcher");
    Попытка
        Инцидент = ПолучитьЗаблокированныйИнцидент(РазобратьИдентификатор(ИнцидентИдентификатор), КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
        Объект = ПолучитьЗаблокированноеОбращение(РазобратьИдентификатор(Идентификатор), КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
        Операция = "incident.link";
        Если Отвязать Тогда
            Операция = "incident.unlink";
        КонецЕсли;
        Намерение = КодироватьЗначение(Новый Структура("operation,workspaceId,areaId,requestId,incidentId,requestExpectedRevision,incidentExpectedRevision,reason",
            Операция, Строка(КонтекстДоступа.РабочееПространство.УникальныйИдентификатор()), Строка(КонтекстДоступа.Область.УникальныйИдентификатор()), Строка(Объект.Ссылка.УникальныйИдентификатор()), Строка(Инцидент.Ссылка.УникальныйИдентификатор()),
            ЗапросКлиентаРевизия, ИнцидентРевизия, Причина), 16000);
        Команда = ОткрытьПривязкуКоманды(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, Операция, Намерение, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
        Если Команда.Выбран() Тогда
            Результат = ПовторитьСохраненныйРезультат(Команда, "LinkStaff", Объект.Ссылка);
            ЗафиксироватьТранзакцию();
            Возврат Результат;
        КонецЕсли;
        ПроверитьТекущуюРевизию(Инцидент, ИнцидентРевизия);
        ПроверитьТекущуюРевизию(Объект, ЗапросКлиентаРевизия);
        ПередЗапросКлиента = СлужебныеДанныеОбращения(Объект);
        ПередИнцидент = ДанныеИнцидента(Инцидент);
        Если Отвязать Тогда
            Если Объект.Инцидент <> Инцидент.Ссылка Тогда
                ВызватьИсключение "кабинет_диспетчерская_связь_конфликт";
            КонецЕсли;
            Объект.Инцидент = Справочники.ИнцидентыДиспетчерской.ПустаяСсылка();
        Иначе
            Если ЗначениеЗаполнено(Объект.Инцидент) Или Инцидент.Состояние <> "Open" Или ЗавершенноеСостояние(Объект.Состояние) Тогда
                ВызватьИсключение "кабинет_диспетчерская_состояние_конфликт";
            КонецЕсли;
            Если КоличествоСвязанныхОбращений(Инцидент.Ссылка) >= 100 Тогда
                ВызватьИсключение "кабинет_диспетчерская_квота_превышено";
            КонецЕсли;
            Объект.Инцидент = Инцидент.Ссылка;
        КонецЕсли;
        УвеличитьРевизиюОбъекта(Объект);
        УвеличитьРевизиюОбъекта(Инцидент);
        Объект.Записать();
        Инцидент.Записать();
        ПослеЗапросКлиента = СлужебныеДанныеОбращения(Объект);
        ПослеИнцидент = ДанныеИнцидента(Инцидент);
        ДобавитьЗаписьИстории("Request", Объект, Операция, "Internal", Причина, ПередЗапросКлиента, ПослеЗапросКлиента, СсылкаУчетнойЗаписи, ИдентификаторЗапроса);
        ДобавитьЗаписьИстории("Incident", Инцидент, Операция, "Internal", Причина, ПередИнцидент, ПослеИнцидент, СсылкаУчетнойЗаписи, ИдентификаторЗапроса);
        Результат = Новый Структура("request,incident", ПослеЗапросКлиента, ПослеИнцидент);
        СохранитьПривязкуКоманды(Команда, "LinkStaff", Объект.Ссылка, Результат);
        ПолитикаДоступа.ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, КонтекстДоступа.РабочееПространство, "dispatch." + Операция, Строка(Объект.Ссылка.УникальныйИдентификатор()));
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПрочитатьКарточкуОбращения(СсылкаУчетнойЗаписи, Идентификатор, СотрудникРежим)
    КонтекстДоступа = НачатьОперациюСОбращением(СсылкаУчетнойЗаписи, Идентификатор, СотрудникРежим);
    Попытка
        Если СотрудникРежим Тогда
            Данные = СлужебныеДанныеОбращения(КонтекстДоступа.Объект);
        Иначе
            Данные = ДанныеСобственногоОбращения(КонтекстДоступа.Объект);
        КонецЕсли;
        Результат = Новый Структура("request,messages", Данные, ПрочитатьСообщения(КонтекстДоступа.Объект, СотрудникРежим));
        Результат.Вставить("guestPhoto", КонтекстДоступа.Объект.Источник = "GuestReceipt");
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПрочитатьСообщения(Объект, СотрудникРежим)
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 200 Ссылка, ТекстСообщения, Видимость, ВидАвтора, КемСоздано, ДатаСоздания
        |ИЗ Справочник.СообщенияОбращений ГДЕ ЗаявкаНаОбслуживание = &Запрос И РабочееПространство = &РабочееПространство
        |И Область = &Область И НЕ ПометкаУдаления И (&Сотрудник ИЛИ Видимость = &Общедоступный) УПОРЯДОЧИТЬ ПО ДатаСоздания, Ссылка");
    УстановитьКонтекстОбласти(Запрос, Объект.РабочееПространство, Объект.Область);
    Запрос.УстановитьПараметр("Запрос", Объект.Ссылка);
    Запрос.УстановитьПараметр("Сотрудник", СотрудникРежим);
    Запрос.УстановитьПараметр("Общедоступный", "Public");
    Выборка = Запрос.Выполнить().Выбрать();
    Результат = Новый Массив;
    Пока Выборка.Следующий() Цикл
        Сообщение = Новый Структура("id,text,authorLabel,createdAt", Строка(Выборка.Ссылка.УникальныйИдентификатор()), Выборка.ТекстСообщения,
            Выборка.ВидАвтора, XMLСтрока(Выборка.ДатаСоздания) + "Z");
        Если СотрудникРежим Тогда
            Сообщение.Вставить("visibility", Выборка.Видимость);
            Сообщение.Вставить("actorAccountId", Строка(Выборка.КемСоздано.УникальныйИдентификатор()));
        КонецЕсли;
        Результат.Добавить(Сообщение);
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция СвязанныеОбращения(Инцидент)
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 100 Ссылка ИЗ Справочник.ОбращенияДиспетчерской ГДЕ Инцидент = &Инцидент И РабочееПространство = &РабочееПространство И Область = &Область И НЕ ПометкаУдаления УПОРЯДОЧИТЬ ПО ДатаСоздания, Ссылка");
    УстановитьКонтекстОбласти(Запрос, Инцидент.РабочееПространство, Инцидент.Область);
    Запрос.УстановитьПараметр("Инцидент", Инцидент.Ссылка);
    Выборка = Запрос.Выполнить().Выбрать();
    Результат = Новый Массив;
    Пока Выборка.Следующий() Цикл
        Результат.Добавить(СлужебныеДанныеОбращения(Выборка.Ссылка.ПолучитьОбъект()));
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция КоличествоСвязанныхОбращений(ИнцидентСсылка)
    Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Объем ИЗ Справочник.ОбращенияДиспетчерской ГДЕ Инцидент = &Инцидент И НЕ ПометкаУдаления");
    Запрос.УстановитьПараметр("Инцидент", ИнцидентСсылка);
    Выборка = Запрос.Выполнить().Выбрать();
    Выборка.Следующий();
    Возврат Выборка.Объем;
КонецФункции

Функция НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, Роль)
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьОтсутствиеТранзакции();
    СсылкаРабочейОбласти = Справочники.РабочиеПространства.ПолучитьСсылку(РазобратьИдентификатор(РабочаяОбластьИдентификатор));
    СсылкаОбласти = Справочники.Области.ПолучитьСсылку(РазобратьИдентификатор(ОбластьИдентификатор));
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьОбъектПоСсылке("Справочник.УчетныеЗаписи", СсылкаУчетнойЗаписи);
        ЗаблокироватьОбъектПоСсылке("Справочник.РабочиеПространства", СсылкаРабочейОбласти);
        ЗаблокироватьОбъектПоСсылке("Справочник.Области", СсылкаОбласти);
        ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
        ПроверитьАктивностьОбласти(СсылкаРабочейОбласти, СсылкаОбласти);
        Если Роль <> "" Тогда
            ПолитикаДоступа.ПроверитьДоступКОбласти(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, Роль);
        КонецЕсли;
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Новый Структура("РабочееПространство,Область", СсылкаРабочейОбласти, СсылкаОбласти);
КонецФункции

Процедура НачатьОперациюУчастника(СсылкаУчетнойЗаписи)
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьОтсутствиеТранзакции();
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьОбъектПоСсылке("Справочник.УчетныеЗаписи", СсылкаУчетнойЗаписи);
        ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

Функция НачатьОперациюСОбращением(СсылкаУчетнойЗаписи, Идентификатор, СотрудникРежим)
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    Если ТипЗнч(СотрудникРежим) <> Тип("Булево") Тогда
        ВызватьИсключение "кабинет_диспетчерская_некорректно_поле";
    КонецЕсли;
    ПредварительныйСнимок = ПредставлениеОбращения(РазобратьИдентификатор(Идентификатор));
    Роль = "";
    Если СотрудникРежим Тогда
        Роль = "Dispatcher";
    КонецЕсли;
    КонтекстДоступа = НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, Строка(ПредварительныйСнимок.РабочееПространство.УникальныйИдентификатор()), Строка(ПредварительныйСнимок.Область.УникальныйИдентификатор()), Роль);
    Попытка
        Объект = ПолучитьЗаблокированноеОбращение(РазобратьИдентификатор(Идентификатор), КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
        Если Не СотрудникРежим Тогда
            ПроверитьЗаявителяОбращения(СсылкаУчетнойЗаписи, Объект);
        КонецЕсли;
        КонтекстДоступа.Вставить("Объект", Объект);
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат КонтекстДоступа;
КонецФункции

Функция НачатьОперациюСИнцидентом(СсылкаУчетнойЗаписи, Идентификатор)
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПредварительныйСнимок = ПредставлениеИнцидента(РазобратьИдентификатор(Идентификатор));
    КонтекстДоступа = НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, Строка(ПредварительныйСнимок.РабочееПространство.УникальныйИдентификатор()), Строка(ПредварительныйСнимок.Область.УникальныйИдентификатор()), "Dispatcher");
    Попытка
        КонтекстДоступа.Вставить("Объект", ПолучитьЗаблокированныйИнцидент(РазобратьИдентификатор(Идентификатор), КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область));
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат КонтекстДоступа;
КонецФункции

Процедура ПроверитьАктивностьОбласти(СсылкаРабочейОбласти, СсылкаОбласти)
    РабочееПространство = СсылкаРабочейОбласти.ПолучитьОбъект();
    Область = СсылкаОбласти.ПолучитьОбъект();
    Если РабочееПространство = Неопределено Или Область = Неопределено Тогда
        ВызватьИсключение "кабинет_диспетчерская_не_найдено";
    КонецЕсли;
    Если РабочееПространство.ПометкаУдаления Или РабочееПространство.Состояние <> "Active" Или Область.ПометкаУдаления
        Или Область.Состояние <> "Active" Или Область.РабочееПространство <> СсылкаРабочейОбласти Тогда
        ВызватьИсключение "кабинет_диспетчерская_не_найдено";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьЗаявителяОбращения(СсылкаУчетнойЗаписи, Объект)
    Если Объект.Заявитель <> СсылкаУчетнойЗаписи Тогда
        ВызватьИсключение "кабинет_диспетчерская_не_найдено";
    КонецЕсли;
КонецПроцедуры

Функция ПредставлениеПриемной(Разобранный)
    ИдентификаторСсылки = Справочники.ПубличныеПриемные.ПолучитьСсылку(Разобранный);
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 РабочееПространство, ОбластьПоУмолчанию ИЗ Справочник.ПубличныеПриемные ГДЕ Ссылка = &ИдентификаторСсылки И НЕ ПометкаУдаления");
    Запрос.УстановитьПараметр("ИдентификаторСсылки", ИдентификаторСсылки);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Тогда
        ВызватьИсключение "кабинет_диспетчерская_не_найдено";
    КонецЕсли;
    Возврат Новый Структура("РабочееПространство,ОбластьПоУмолчанию", Выборка.РабочееПространство, Выборка.ОбластьПоУмолчанию);
КонецФункции

Функция ПредставлениеОбращения(Разобранный)
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 РабочееПространство, Область ИЗ Справочник.ОбращенияДиспетчерской ГДЕ Ссылка = &ИдентификаторСсылки И НЕ ПометкаУдаления");
    Запрос.УстановитьПараметр("ИдентификаторСсылки", Справочники.ОбращенияДиспетчерской.ПолучитьСсылку(Разобранный));
    Возврат ПрочитатьПредставлениеОбъекта(Запрос);
КонецФункции

Функция ПредставлениеИнцидента(Разобранный)
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 РабочееПространство, Область ИЗ Справочник.ИнцидентыДиспетчерской ГДЕ Ссылка = &ИдентификаторСсылки И НЕ ПометкаУдаления");
    Запрос.УстановитьПараметр("ИдентификаторСсылки", Справочники.ИнцидентыДиспетчерской.ПолучитьСсылку(Разобранный));
    Возврат ПрочитатьПредставлениеОбъекта(Запрос);
КонецФункции

Функция ПрочитатьПредставлениеОбъекта(Запрос)
    Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Тогда
        ВызватьИсключение "кабинет_диспетчерская_не_найдено";
    КонецЕсли;
    Возврат Новый Структура("РабочееПространство,Область", Выборка.РабочееПространство, Выборка.Область);
КонецФункции

Функция ПолучитьЗаблокированнуюПриемную(Разобранный, СсылкаРабочейОбласти)
    ИдентификаторСсылки = Справочники.ПубличныеПриемные.ПолучитьСсылку(Разобранный);
    ЗаблокироватьОбъектПоСсылке("Справочник.ПубличныеПриемные", ИдентификаторСсылки);
    Объект = ИдентификаторСсылки.ПолучитьОбъект();
    Если Объект = Неопределено Тогда
        ВызватьИсключение "кабинет_диспетчерская_не_найдено";
    КонецЕсли;
    Если Объект.ПометкаУдаления Или Объект.РабочееПространство <> СсылкаРабочейОбласти Тогда
        ВызватьИсключение "кабинет_диспетчерская_не_найдено";
    КонецЕсли;
    Если Не ЗначениеЗаполнено(Объект.КемСоздано) Или Объект.ДатаСоздания = Дата(1, 1, 1)
        Или Объект.Ревизия < 1 Или Объект.Ревизия <> Цел(Объект.Ревизия) Тогда
        ВызватьИсключение "кабинет_диспетчерская_не_найдено";
    КонецЕсли;
    Возврат Объект;
КонецФункции

Функция ПолучитьЗаблокированноеОбращение(Разобранный, СсылкаРабочейОбласти, СсылкаОбласти)
    ИдентификаторСсылки = Справочники.ОбращенияДиспетчерской.ПолучитьСсылку(Разобранный);
    ЗаблокироватьОбъектПоСсылке("Справочник.ОбращенияДиспетчерской", ИдентификаторСсылки);
    Объект = ИдентификаторСсылки.ПолучитьОбъект();
    Гостевой = Объект <> Неопределено И Объект.Источник = "GuestReceipt";
    ПроверитьДанныеЭлемента(Объект, СсылкаРабочейОбласти, СсылкаОбласти, Гостевой);
    Если Гостевой Тогда
        ПроверитьПривязкуГостевогоОбращения(Объект);
    КонецЕсли;
    Если (Не Гостевой И (Не ЗначениеЗаполнено(Объект.Заявитель) Или Объект.Заявитель <> Объект.КемСоздано))
        Или СтрРазделить("Submitted,Accepted,AwaitingInfo,Rejected,Resolved", ",").Найти(Объект.Состояние) = Неопределено
        Или Объект.Этап < 1 Или Объект.Этап > 20 Или Объект.Этап <> Цел(Объект.Этап)
        Или Объект.КоличествоСообщений < 0 Или Объект.КоличествоСообщений > 200 Или Объект.КоличествоСообщений <> Цел(Объект.КоличествоСообщений) Тогда
        ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт";
    КонецЕсли;
    Возврат Объект;
КонецФункции

Функция ПолучитьЗаблокированныйИнцидент(Разобранный, СсылкаРабочейОбласти, СсылкаОбласти)
    ИдентификаторСсылки = Справочники.ИнцидентыДиспетчерской.ПолучитьСсылку(Разобранный);
    ЗаблокироватьОбъектПоСсылке("Справочник.ИнцидентыДиспетчерской", ИдентификаторСсылки);
    Объект = ИдентификаторСсылки.ПолучитьОбъект();
    ПроверитьДанныеЭлемента(Объект, СсылкаРабочейОбласти, СсылкаОбласти);
    Если Объект.Состояние <> "Open" И Объект.Состояние <> "Resolved" Тогда
        ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт";
    КонецЕсли;
    Возврат Объект;
КонецФункции

Процедура ПроверитьДанныеЭлемента(Объект, СсылкаРабочейОбласти, СсылкаОбласти, Гостевой = Ложь)
    Если Объект = Неопределено Тогда
        ВызватьИсключение "кабинет_диспетчерская_не_найдено";
    КонецЕсли;
    Если Объект.ПометкаУдаления Или Объект.РабочееПространство <> СсылкаРабочейОбласти Или Объект.Область <> СсылкаОбласти
        Или (Не Гостевой И Не ЗначениеЗаполнено(Объект.КемСоздано)) Или Объект.ДатаСоздания = Дата(1, 1, 1)
        Или Объект.Ревизия < 1 Или Объект.Ревизия <> Цел(Объект.Ревизия) Тогда
        ВызватьИсключение "кабинет_диспетчерская_не_найдено";
    КонецЕсли;
КонецПроцедуры

Функция МаршрутКоманды(СсылкаУчетнойЗаписи, ИдентификаторЗапроса)
    Привязка = РегистрыСведений.ПривязкиКомандДиспетчерской.СоздатьМенеджерЗаписи();
    Привязка.УчетнаяЗапись = СсылкаУчетнойЗаписи;
    Привязка.ИдентификаторЗапроса = Строка(РазобратьИдентификатор(ИдентификаторЗапроса));
    Привязка.Прочитать();
    Если Не Привязка.Выбран() Тогда
        Возврат Неопределено;
    КонецЕсли;
    Возврат Новый Структура("Операция,ВидСущности,ИдентификаторСущности", Привязка.Операция, Привязка.ВидСущности, Привязка.ИдентификаторСущности);
КонецФункции

Функция ОткрытьПривязкуКоманды(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, Операция, Намерение, СсылкаРабочейОбласти, СсылкаОбласти)
    ЗапросКлиентаКлюч = Строка(РазобратьИдентификатор(ИдентификаторЗапроса));
    Блокировка = Новый БлокировкаДанных;
    БлокировкаЗапись = Блокировка.Добавить("РегистрСведений.ПривязкиКомандДиспетчерской");
    БлокировкаЗапись.УстановитьЗначение("УчетнаяЗапись", СсылкаУчетнойЗаписи);
    БлокировкаЗапись.УстановитьЗначение("ИдентификаторЗапроса", ЗапросКлиентаКлюч);
    БлокировкаЗапись.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
    Привязка = РегистрыСведений.ПривязкиКомандДиспетчерской.СоздатьМенеджерЗаписи();
    Привязка.УчетнаяЗапись = СсылкаУчетнойЗаписи;
    Привязка.ИдентификаторЗапроса = ЗапросКлиентаКлюч;
    Привязка.Прочитать();
    Если Привязка.Выбран() Тогда
        Если Привязка.Операция <> Операция Или Привязка.НамерениеJSON <> Намерение
            Или Привязка.РабочееПространство <> СсылкаРабочейОбласти Или Привязка.Область <> СсылкаОбласти Тогда
            ВызватьИсключение "кабинет_диспетчерская_запрос_конфликт";
        КонецЕсли;
    Иначе
        Привязка.УчетнаяЗапись = СсылкаУчетнойЗаписи;
        Привязка.ИдентификаторЗапроса = ЗапросКлиентаКлюч;
        Привязка.Операция = Операция;
        Привязка.НамерениеJSON = Намерение;
        Привязка.РабочееПространство = СсылкаРабочейОбласти;
        Привязка.Область = СсылкаОбласти;
    КонецЕсли;
    Возврат Привязка;
КонецФункции

Процедура СохранитьПривязкуКоманды(Команда, ВидРезультата, ИдентификаторСсылки, Результат)
    Команда.ВидСущности = ВидРезультата;
    Команда.ИдентификаторСущности = Строка(ИдентификаторСсылки.УникальныйИдентификатор());
    Команда.РезультатJSON = КодироватьЗначение(Результат, 16000);
    Если ВидРезультата = "LinkStaff" Тогда
        Команда.РевизияРезультата = Результат.request.revision;
    Иначе
        Команда.РевизияРезультата = Результат.revision;
    КонецЕсли;
    Команда.Записать();
КонецПроцедуры

Функция ПовторитьСохраненныйРезультат(Команда, ВидРезультата, ИдентификаторСсылки)
    Если Команда.ВидСущности <> ВидРезультата Или Команда.ИдентификаторСущности <> Строка(ИдентификаторСсылки.УникальныйИдентификатор()) Тогда
        ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт";
    КонецЕсли;
    Вид = "Request";
    Если ВидРезультата = "IntakeOwner" Тогда
        Вид = "Intake";
    ИначеЕсли ВидРезультата = "IncidentStaff" Тогда
        Вид = "Incident";
    КонецЕсли;
    История = ПрочитатьЗаписьИстории(Вид, Команда.ИдентификаторСущности, Команда.РевизияРезультата, Команда);
    Данные = ДекодироватьСтруктуру(Команда.РезультатJSON);
    Если ВидРезультата = "RequestPublic" Тогда
        Ожидаемый = СнимокДанныхДляЗаявителя(ДекодироватьСтруктуру(История.СнимокПослеJSON));
        Если КодироватьЗначение(Ожидаемый, 16000) <> Команда.РезультатJSON Тогда
            ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт";
        КонецЕсли;
        Возврат Ожидаемый;
    ИначеЕсли ВидРезультата = "LinkStaff" Тогда
        ДанныеЗаявки = Неопределено;
        ПовторКомандыИнцидентДанные = Неопределено;
        Если Не Данные.Свойство("request", ДанныеЗаявки) Или Не Данные.Свойство("incident", ПовторКомандыИнцидентДанные) Тогда
            ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт";
        КонецЕсли;
        Если ТипЗнч(ДанныеЗаявки) <> Тип("Структура") Или ТипЗнч(ПовторКомандыИнцидентДанные) <> Тип("Структура") Тогда
            ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт";
        КонецЕсли;
        Если КодироватьЗначение(ДанныеЗаявки, 16000) <> История.СнимокПослеJSON Тогда
            ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт";
        КонецЕсли;
        Другой = ПрочитатьЗаписьИстории("Incident", ПовторКомандыИнцидентДанные.id, ПовторКомандыИнцидентДанные.revision, Команда);
        Если КодироватьЗначение(ПовторКомандыИнцидентДанные, 16000) <> Другой.СнимокПослеJSON Тогда
            ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт";
        КонецЕсли;
    ИначеЕсли История.СнимокПослеJSON <> Команда.РезультатJSON Тогда
        ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт";
    КонецЕсли;
    Возврат Данные;
КонецФункции

Функция ПрочитатьЗаписьИстории(Вид, ИдентификаторСущности, Ревизия, Команда)
    Объект = РегистрыСведений.ИсторияДиспетчерской.СоздатьМенеджерЗаписи();
    Объект.ВидСущности = Вид;
    Объект.ИдентификаторСущности = ИдентификаторСущности;
    Объект.Ревизия = Ревизия;
    Объект.Прочитать();
    Если Не Объект.Выбран() Тогда
        ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт";
    КонецЕсли;
    Если Объект.РабочееПространство <> Команда.РабочееПространство Или Объект.Область <> Команда.Область
        Или Объект.ДействующееЛицо <> Команда.УчетнаяЗапись Или Объект.ИдентификаторЗапроса <> Команда.ИдентификаторЗапроса Или Объект.Операция <> Команда.Операция Тогда
        ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт";
    КонецЕсли;
    Возврат Объект;
КонецФункции

Процедура ДобавитьЗаписьИстории(Вид, Сущность, Операция, Видимость, Причина, Перед, После, СсылкаУчетнойЗаписи, ИдентификаторЗапроса)
    ИдентификаторСущности = Строка(Сущность.Ссылка.УникальныйИдентификатор());
    Блокировка = Новый БлокировкаДанных;
    БлокировкаЗапись = Блокировка.Добавить("РегистрСведений.ИсторияДиспетчерской");
    БлокировкаЗапись.УстановитьЗначение("ВидСущности", Вид);
    БлокировкаЗапись.УстановитьЗначение("ИдентификаторСущности", ИдентификаторСущности);
    БлокировкаЗапись.УстановитьЗначение("Ревизия", Сущность.Ревизия);
    БлокировкаЗапись.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
    Объект = РегистрыСведений.ИсторияДиспетчерской.СоздатьМенеджерЗаписи();
    Объект.ВидСущности = Вид;
    Объект.ИдентификаторСущности = ИдентификаторСущности;
    Объект.Ревизия = Сущность.Ревизия;
    Объект.Прочитать();
    Если Объект.Выбран() Тогда
        ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт";
    КонецЕсли;
    Объект.ВидСущности = Вид;
    Объект.ИдентификаторСущности = ИдентификаторСущности;
    Объект.Ревизия = Сущность.Ревизия;
    Объект.РабочееПространство = Сущность.РабочееПространство;
    Объект.Область = Сущность.Область;
    Объект.ДействующееЛицо = СсылкаУчетнойЗаписи;
    Объект.ИдентификаторЗапроса = Строка(РазобратьИдентификатор(ИдентификаторЗапроса));
    Объект.Операция = Операция;
    Объект.Видимость = Видимость;
    Объект.Причина = Причина;
    Объект.ДатаИзменения = Сущность.ДатаОбновления;
    Объект.СнимокДоJSON = КодироватьЗначение(Перед, 16000);
    Объект.СнимокПослеJSON = КодироватьЗначение(После, 16000);
    Объект.Записать();
КонецПроцедуры

Функция ПрочитатьКвотуУчастника(СсылкаУчетнойЗаписи)
    Блокировка = Новый БлокировкаДанных;
    БлокировкаЗапись = Блокировка.Добавить("РегистрСведений.КвотыОбращенийПользователей");
    БлокировкаЗапись.УстановитьЗначение("УчетнаяЗапись", СсылкаУчетнойЗаписи);
    БлокировкаЗапись.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
    Объект = РегистрыСведений.КвотыОбращенийПользователей.СоздатьМенеджерЗаписи();
    Объект.УчетнаяЗапись = СсылкаУчетнойЗаписи;
    Объект.Прочитать();
    Если Не Объект.Выбран() Тогда
        Объект.УчетнаяЗапись = СсылкаУчетнойЗаписи;
        Объект.КоличествоОбращений = 0;
    КонецЕсли;
    Если Объект.КоличествоОбращений < 0 Или Объект.КоличествоОбращений > 1000 Или Объект.КоличествоОбращений <> Цел(Объект.КоличествоОбращений) Тогда
        ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт";
    КонецЕсли;
    Возврат Объект;
КонецФункции

Функция КвотаРабочегоПространства(СсылкаРабочейОбласти)
    Блокировка = Новый БлокировкаДанных;
    БлокировкаЗапись = Блокировка.Добавить("РегистрСведений.КвотыОбращенийПространств");
    БлокировкаЗапись.УстановитьЗначение("РабочееПространство", СсылкаРабочейОбласти);
    БлокировкаЗапись.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
    Объект = РегистрыСведений.КвотыОбращенийПространств.СоздатьМенеджерЗаписи();
    Объект.РабочееПространство = СсылкаРабочейОбласти;
    Объект.Прочитать();
    Если Не Объект.Выбран() Тогда
        Объект.РабочееПространство = СсылкаРабочейОбласти;
        Объект.КоличествоОбращений = 0;
        Объект.КоличествоПриемных = 0;
        Объект.КоличествоИнцидентов = 0;
    КонецЕсли;
    Если Объект.КоличествоОбращений < 0 Или Объект.КоличествоОбращений > 10000 Или Объект.КоличествоОбращений <> Цел(Объект.КоличествоОбращений)
        Или Объект.КоличествоПриемных < 0 Или Объект.КоличествоПриемных > 20 Или Объект.КоличествоПриемных <> Цел(Объект.КоличествоПриемных)
        Или Объект.КоличествоИнцидентов < 0 Или Объект.КоличествоИнцидентов > 1000 Или Объект.КоличествоИнцидентов <> Цел(Объект.КоличествоИнцидентов) Тогда
        ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт";
    КонецЕсли;
    Возврат Объект;
КонецФункции

Функция НастройкиПриемной(ТелоЗапроса)
    ПоУмолчаниюОбластьИдентификатор = Строка(РазобратьИдентификатор(ТекстовоеПоле(ТелоЗапроса, "defaultAreaId", 36)));
    Имя = ТекстовоеПоле(ТелоЗапроса, "name", 150);
    Адреса = Неопределено;
    Категории = Неопределено;
    Если Не ТелоЗапроса.Свойство("addresses", Адреса) Или Не ТелоЗапроса.Свойство("categories", Категории) Тогда
        ВызватьИсключение "кабинет_диспетчерская_некорректно_поле";
    КонецЕсли;
    Адреса = ПроверенныеАдреса(Адреса);
    Категории = ПроверенныеКатегории(Категории);
    Опубликована = ЛогическоеПоле(ТелоЗапроса, "published");
    ПринимаетОбращения = ЛогическоеПоле(ТелоЗапроса, "accepting");
    Если ПринимаетОбращения И Не Опубликована Тогда
        ВызватьИсключение "кабинет_диспетчерская_некорректно_поле";
    КонецЕсли;
    Возврат Новый Структура("defaultAreaId,name,addresses,categories,published,accepting",
        ПоУмолчаниюОбластьИдентификатор, Имя, Адреса, Категории, Опубликована, ПринимаетОбращения);
КонецФункции

Процедура ПрименитьНастройкиПриемной(Объект, Конфигурация, ОбластьПоУмолчанию)
    Объект.Область = ОбластьПоУмолчанию;
    Объект.ОбластьПоУмолчанию = ОбластьПоУмолчанию;
    Объект.Наименование = Конфигурация.name;
    Объект.АдресаJSON = КодироватьЗначение(Конфигурация.addresses, 10000);
    Объект.КатегорииJSON = КодироватьЗначение(Конфигурация.categories, 1024);
    Объект.Опубликована = Конфигурация.published;
    Объект.ПринимаетОбращения = Конфигурация.accepting;
КонецПроцедуры

Функция ПроверенныеАдреса(Значение)
    Если ТипЗнч(Значение) <> Тип("Массив") Тогда
        ВызватьИсключение "кабинет_диспетчерская_некорректно_поле";
    КонецЕсли;
    Если Значение.Количество() < 1 Или Значение.Количество() > 30 Тогда
        ВызватьИсключение "кабинет_диспетчерская_некорректно_поле";
    КонецЕсли;
    Результат = Новый Массив;
    Для Каждого Запись Из Значение Цикл
        Адрес = ПроверенныйТекст(Запись, 250, Ложь);
        Если Результат.Найти(Адрес) <> Неопределено Тогда
            ВызватьИсключение "кабинет_диспетчерская_некорректно_поле";
        КонецЕсли;
        Результат.Добавить(Адрес);
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция ПроверенныеКатегории(Значение)
    Если ТипЗнч(Значение) <> Тип("Массив") Тогда
        ВызватьИсключение "кабинет_диспетчерская_некорректно_поле";
    КонецЕсли;
    Если Значение.Количество() < 1 Или Значение.Количество() > 8 Тогда
        ВызватьИсключение "кабинет_диспетчерская_некорректно_поле";
    КонецЕсли;
    Результат = Новый Массив;
    Разрешенные = СтрРазделить("Leak,NoWater,Pressure,Sewer,Manhole,Quality,Billing,Other", ",");
    Для Каждого Запись Из Значение Цикл
        Если ТипЗнч(Запись) <> Тип("Строка") Тогда
            ВызватьИсключение "кабинет_диспетчерская_некорректно_поле";
        КонецЕсли;
        Если Разрешенные.Найти(Запись) = Неопределено Или Результат.Найти(Запись) <> Неопределено Тогда
            ВызватьИсключение "кабинет_диспетчерская_некорректно_поле";
        КонецЕсли;
        Результат.Добавить(Запись);
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция СохраненныеАдреса(Текст)
    Возврат ПроверенныеАдреса(ДекодироватьЗначение(Текст));
КонецФункции

Функция СохраненныеКатегории(Текст)
    Возврат ПроверенныеКатегории(ДекодироватьЗначение(Текст));
КонецФункции

Процедура ЗаполнитьСлужебныеОтметки(Объект, СсылкаУчетнойЗаписи, СсылкаРабочейОбласти, СсылкаОбласти)
    Объект.РабочееПространство = СсылкаРабочейОбласти;
    Объект.Область = СсылкаОбласти;
    Объект.КемСоздано = СсылкаУчетнойЗаписи;
    Объект.ДатаСоздания = ТекущаяУниверсальнаяДата();
    Объект.ДатаОбновления = Объект.ДатаСоздания;
    Объект.Ревизия = 1;
КонецПроцедуры

Процедура УвеличитьРевизиюОбъекта(Объект)
    Если Объект.Ревизия >= 999999999999997 Тогда
        ВызватьИсключение "кабинет_диспетчерская_редакция_конфликт";
    КонецЕсли;
    Объект.Ревизия = Объект.Ревизия + 1;
    Объект.ДатаОбновления = ТекущаяУниверсальнаяДата();
КонецПроцедуры

Процедура ПроверитьТекущуюРевизию(Объект, Ревизия)
    Если Объект.Ревизия <> Ревизия Или Объект.Ревизия >= 999999999999997 Тогда
        ВызватьИсключение "кабинет_диспетчерская_редакция_конфликт";
    КонецЕсли;
КонецПроцедуры

Функция ЗавершенноеСостояние(Состояние)
    Возврат Состояние = "Rejected" Или Состояние = "Resolved";
КонецФункции

Процедура ПроверитьДатыИнцидента(ДатаФактическогоНачала, ПрогнозОкончания)
    Если ДатаФактическогоНачала > ТекущаяУниверсальнаяДата() + 300 Или ПрогнозОкончания < ДатаФактическогоНачала Или ПрогнозОкончания > ТекущаяУниверсальнаяДата() + 7776000 Тогда
        ВызватьИсключение "кабинет_диспетчерская_некорректно_даты";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи)
    Текущий = ПолитикаДоступа.ПроверитьУчетнуюЗапись();
    Если ТипЗнч(СсылкаУчетнойЗаписи) <> Тип("СправочникСсылка.УчетныеЗаписи") Тогда
        ВызватьИсключение "кабинет_участник_несовпадение";
    КонецЕсли;
    Если Текущий.Ссылка <> СсылкаУчетнойЗаписи Тогда
        ВызватьИсключение "кабинет_участник_несовпадение";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьОтсутствиеТранзакции()
    Если ТранзакцияАктивна() Тогда
        ВызватьИсключение "кабинет_диспетчерская_вложенная_транзакция";
    КонецЕсли;
КонецПроцедуры

Процедура ОтменитьСобственнуюТранзакцию()
    Если ТранзакцияАктивна() Тогда
        ОтменитьТранзакцию();
    КонецЕсли;
КонецПроцедуры

Процедура ЗаблокироватьОбъектПоСсылке(ПространствоИмен, ИдентификаторСсылки)
    Блокировка = Новый БлокировкаДанных;
    БлокировкаЗапись = Блокировка.Добавить(ПространствоИмен);
    БлокировкаЗапись.УстановитьЗначение("Ссылка", ИдентификаторСсылки);
    БлокировкаЗапись.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
КонецПроцедуры

Процедура УстановитьКонтекстОбласти(Запрос, СсылкаРабочейОбласти, СсылкаОбласти)
    Запрос.УстановитьПараметр("РабочееПространство", СсылкаРабочейОбласти);
    Запрос.УстановитьПараметр("Область", СсылкаОбласти);
КонецПроцедуры

Процедура ПроверитьПоляТелаЗапроса(ТелоЗапроса, Поля)
    Если ТипЗнч(ТелоЗапроса) <> Тип("Структура") Тогда
        ВызватьИсключение "кабинет_диспетчерская_некорректно_тело";
    КонецЕсли;
    Разрешенные = СтрРазделить(Поля, ",");
    Для Каждого ТелоЗапись Из ТелоЗапроса Цикл
        Если Разрешенные.Найти(ТелоЗапись.Ключ) = Неопределено Тогда
            ВызватьИсключение "кабинет_диспетчерская_некорректно_поле";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ТекстовоеПоле(ТелоЗапроса, Имя, Максимум, Строки = Ложь)
    Значение = Неопределено;
    Если Не ТелоЗапроса.Свойство(Имя, Значение) Тогда
        ВызватьИсключение "кабинет_диспетчерская_некорректно_поле";
    КонецЕсли;
    Возврат ПроверенныйТекст(Значение, Максимум, Строки);
КонецФункции

Функция ПроверенныйТекст(Значение, Максимум, Строки)
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_диспетчерская_некорректно_поле";
    КонецЕсли;
    Если СтрДлина(Значение) > Максимум Тогда
        ВызватьИсключение "кабинет_диспетчерская_некорректно_поле";
    КонецЕсли;
    Для Позиция = 1 По СтрДлина(Значение) Цикл
        Код = КодСимвола(Значение, Позиция);
        Если (Код < 32 И Не (Строки И (Код = 10 Или Код = 13))) Или (Код >= 127 И Код <= 159)
            Или (Код >= 8203 И Код <= 8207) Или (Код >= 8234 И Код <= 8238)
            Или (Код >= 8288 И Код <= 8297) Или Код = 65279 Или (Код >= 55296 И Код <= 57343) Тогда
            ВызватьИсключение "кабинет_диспетчерская_некорректно_поле";
        КонецЕсли;
    КонецЦикла;
    Если Строки Тогда
        Значение = СтрЗаменить(Значение, Символ(13) + Символ(10), Символ(10));
        Значение = СтрЗаменить(Значение, Символ(13), Символ(10));
    КонецЕсли;
    Значение = СокрЛП(Значение);
    Если ПустаяСтрока(Значение) Тогда
        ВызватьИсключение "кабинет_диспетчерская_некорректно_поле";
    КонецЕсли;
    Возврат Значение;
КонецФункции

Функция ПолеПечатногоТекста(ТелоЗапроса, Имя, Максимум)
    Значение = ТекстовоеПоле(ТелоЗапроса, Имя, Максимум);
    Для Позиция = 1 По СтрДлина(Значение) Цикл
        Если КодСимвола(Значение, Позиция) > 126 Тогда
            ВызватьИсключение "кабинет_диспетчерская_некорректно_поле";
        КонецЕсли;
    КонецЦикла;
    Возврат Значение;
КонецФункции

Функция ПолеИзПеречня(ТелоЗапроса, Имя, Варианты)
    Значение = ТекстовоеПоле(ТелоЗапроса, Имя, 32);
    Если СтрРазделить(Варианты, ",").Найти(Значение) = Неопределено Тогда
        ВызватьИсключение "кабинет_диспетчерская_некорректно_поле";
    КонецЕсли;
    Возврат Значение;
КонецФункции

Функция ЛогическоеПоле(ТелоЗапроса, Имя)
    Значение = Неопределено;
    Если Не ТелоЗапроса.Свойство(Имя, Значение) Тогда
        ВызватьИсключение "кабинет_диспетчерская_некорректно_поле";
    КонецЕсли;
    Если ТипЗнч(Значение) <> Тип("Булево") Тогда
        ВызватьИсключение "кабинет_диспетчерская_некорректно_поле";
    КонецЕсли;
    Возврат Значение;
КонецФункции

Функция ПолеРевизии(ТелоЗапроса, Имя)
    Значение = Неопределено;
    Если Не ТелоЗапроса.Свойство(Имя, Значение) Тогда
        ВызватьИсключение "кабинет_диспетчерская_некорректно_поле";
    КонецЕсли;
    Если ТипЗнч(Значение) <> Тип("Число") Тогда
        ВызватьИсключение "кабинет_диспетчерская_некорректно_поле";
    КонецЕсли;
    Если Значение < 1 Или Значение > 999999999999997 Или Значение <> Цел(Значение) Тогда
        ВызватьИсключение "кабинет_диспетчерская_некорректно_поле";
    КонецЕсли;
    Возврат Значение;
КонецФункции

Функция ПолеДатыUTC(ТелоЗапроса, Имя)
    Значение = ТекстовоеПоле(ТелоЗапроса, Имя, 20);
    Если СтрДлина(Значение) <> 20 Или Сред(Значение, 5, 1) <> "-" Или Сред(Значение, 8, 1) <> "-"
        Или Сред(Значение, 11, 1) <> "T" Или Сред(Значение, 14, 1) <> ":"
        Или Сред(Значение, 17, 1) <> ":" Или Прав(Значение, 1) <> "Z" Тогда
        ВызватьИсключение "кабинет_диспетчерская_некорректно_даты";
    КонецЕсли;
    Цифры = Лев(Значение, 4) + Сред(Значение, 6, 2) + Сред(Значение, 9, 2) + Сред(Значение, 12, 2) + Сред(Значение, 15, 2) + Сред(Значение, 18, 2);
    Для Позиция = 1 По СтрДлина(Цифры) Цикл
        Если СтрНайти("0123456789", Сред(Цифры, Позиция, 1)) = 0 Тогда
            ВызватьИсключение "кабинет_диспетчерская_некорректно_даты";
        КонецЕсли;
    КонецЦикла;
    Попытка
        Разобранный = XMLЗначение(Тип("Дата"), Лев(Значение, 19));
    Исключение
        ВызватьИсключение "кабинет_диспетчерская_некорректно_даты";
    КонецПопытки;
    Если Разобранный = Дата(1, 1, 1) Или XMLСтрока(Разобранный) <> Лев(Значение, 19) Тогда
        ВызватьИсключение "кабинет_диспетчерская_некорректно_даты";
    КонецЕсли;
    Возврат Разобранный;
КонецФункции

Функция РазобратьИдентификатор(Идентификатор)
    Если ТипЗнч(Идентификатор) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецЕсли;
    Если СтрДлина(Идентификатор) <> 36 Тогда
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецЕсли;
    Попытка
        Разобранный = Новый УникальныйИдентификатор(Идентификатор);
    Исключение
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецПопытки;
    Если Строка(Разобранный) = "00000000-0000-0000-0000-000000000000" Тогда
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецЕсли;
    Возврат Разобранный;
КонецФункции

Функция КодироватьЗначение(Значение, Максимум)
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Значение);
    Результат = Запись.Закрыть();
    Если СтрДлина(Результат) > Максимум Тогда
        ВызватьИсключение "кабинет_диспетчерская_некорректно_поле";
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ДекодироватьЗначение(Текст)
    Если ТипЗнч(Текст) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт";
    КонецЕсли;
    Если СтрДлина(Текст) > 16000 Тогда
        ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт";
    КонецЕсли;
    Чтение = Новый ЧтениеJSON;
    Попытка
        Чтение.УстановитьСтроку(Текст);
        Результат = ПрочитатьJSON(Чтение);
        Чтение.Закрыть();
    Исключение
        Чтение.Закрыть();
        ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт";
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ДекодироватьСтруктуру(Текст)
    Результат = ДекодироватьЗначение(Текст);
    Если ТипЗнч(Результат) <> Тип("Структура") Тогда
        ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт";
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция НеобязательныйИдентификатор(ИдентификаторСсылки)
    Если Не ЗначениеЗаполнено(ИдентификаторСсылки) Тогда
        Возврат "";
    КонецЕсли;
    Возврат Строка(ИдентификаторСсылки.УникальныйИдентификатор());
КонецФункции

Функция МеткаАвтора(Заявитель)
    Если Заявитель Тогда
        Возврат "Requester";
    КонецЕсли;
    Возврат "Dispatcher";
КонецФункции

Функция ОбщиеДанныеОбъекта(Объект)
    Возврат Новый Структура("id,workspaceId,areaId,createdBy,createdAt,updatedAt,revision",
        Строка(Объект.Ссылка.УникальныйИдентификатор()), Строка(Объект.РабочееПространство.УникальныйИдентификатор()), Строка(Объект.Область.УникальныйИдентификатор()), Строка(Объект.КемСоздано.УникальныйИдентификатор()),
        XMLСтрока(Объект.ДатаСоздания) + "Z", XMLСтрока(Объект.ДатаОбновления) + "Z", Объект.Ревизия);
КонецФункции

Функция ДанныеПриемнойДляЗаявителя(Объект)
    Возврат Новый Структура("id,name,addresses,categories,accepting,revision,updatedAt", Строка(Объект.Ссылка.УникальныйИдентификатор()), Объект.Наименование,
        СохраненныеАдреса(Объект.АдресаJSON), СохраненныеКатегории(Объект.КатегорииJSON), Объект.ПринимаетОбращения, Объект.Ревизия, XMLСтрока(Объект.ДатаОбновления) + "Z");
КонецФункции

Функция ДанныеПриемнойДляВладельца(Объект)
    Результат = ОбщиеДанныеОбъекта(Объект);
    Результат.Вставить("defaultAreaId", Строка(Объект.ОбластьПоУмолчанию.УникальныйИдентификатор()));
    Результат.Вставить("name", Объект.Наименование);
    Результат.Вставить("addresses", СохраненныеАдреса(Объект.АдресаJSON));
    Результат.Вставить("categories", СохраненныеКатегории(Объект.КатегорииJSON));
    Результат.Вставить("published", Объект.Опубликована);
    Результат.Вставить("accepting", Объект.ПринимаетОбращения);
    Возврат Результат;
КонецФункции

Функция ДанныеСобственногоОбращения(Объект)
    Возврат Новый Структура("id,publicIntakeId,intakeName,address,category,title,description,contact,state,stage,acceptedAt,resolvedAt,lastPublicReason,createdAt,updatedAt,revision",
        Строка(Объект.Ссылка.УникальныйИдентификатор()), Строка(Объект.Приемная.УникальныйИдентификатор()), Объект.НаименованиеПриемной, Объект.Адрес, Объект.Категория, Объект.Наименование, Объект.Подробности,
        Объект.Контакт, Объект.Состояние, Объект.Этап, XMLСтрока(Объект.ДатаПринятия) + "Z", XMLСтрока(Объект.ДатаЗавершения) + "Z", Объект.ПоследнееПубличноеОснование,
        XMLСтрока(Объект.ДатаСоздания) + "Z", XMLСтрока(Объект.ДатаОбновления) + "Z", Объект.Ревизия);
КонецФункции

Функция СлужебныеДанныеОбращения(Объект)
    Результат = ДанныеСобственногоОбращения(Объект);
    Результат.Вставить("workspaceId", Строка(Объект.РабочееПространство.УникальныйИдентификатор()));
    Результат.Вставить("areaId", Строка(Объект.Область.УникальныйИдентификатор()));
    Результат.Вставить("requesterAccountId", Строка(Объект.Заявитель.УникальныйИдентификатор()));
    Результат.Вставить("responsibleAccountId", НеобязательныйИдентификатор(Объект.Ответственный));
    Результат.Вставить("incidentId", НеобязательныйИдентификатор(Объект.Инцидент));
    Результат.Вставить("priority", Объект.Приоритет);
    Результат.Вставить("dueAt", XMLСтрока(Объект.СрокИсполнения) + "Z");
    Результат.Вставить("overdue", Не ЗавершенноеСостояние(Объект.Состояние) И Объект.СрокИсполнения < ТекущаяУниверсальнаяДата());
    Результат.Вставить("messageCount", Объект.КоличествоСообщений);
    Источник = Объект.Источник; Если Источник = "" Тогда Источник = "Portal"; КонецЕсли;
    Результат.Вставить("source", Источник);
    Результат.Вставить("guestPhoto", Источник = "GuestReceipt");
    Результат.Вставить("resumeState", Объект.СостояниеВозобновления);
    Результат.Вставить("createdBy", Строка(Объект.КемСоздано.УникальныйИдентификатор()));
    Возврат Результат;
КонецФункции

Функция СнимокДанныхДляЗаявителя(Данные)
    Результат = Новый Структура;
    Поля = СтрРазделить("id,publicIntakeId,intakeName,address,category,title,description,contact,state,stage,acceptedAt,resolvedAt,lastPublicReason,createdAt,updatedAt,revision", ",");
    Для Каждого Имя Из Поля Цикл
        Значение = Неопределено;
        Если Данные.Свойство(Имя, Значение) Тогда
            Если ТипЗнч(Значение) <> Тип("Строка") И ТипЗнч(Значение) <> Тип("Число") Тогда
                ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт";
            КонецЕсли;
            Результат.Вставить(Имя, Значение);
        КонецЕсли;
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция ПроверенныйСнимокОбращения(Данные, Объект)
    Если Данные.Количество() = 0 Тогда
        Возврат Новый Структура;
    КонецЕсли;
    Идентификатор = Неопределено;
    РабочаяОбластьИдентификатор = Неопределено;
    ОбластьИдентификатор = Неопределено;
    ЗаявительИдентификатор = Неопределено;
    Если Не Данные.Свойство("id", Идентификатор) Или Не Данные.Свойство("workspaceId", РабочаяОбластьИдентификатор)
        Или Не Данные.Свойство("areaId", ОбластьИдентификатор) Или Не Данные.Свойство("requesterAccountId", ЗаявительИдентификатор) Тогда
        ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт";
    КонецЕсли;
    Если Идентификатор <> Строка(Объект.Ссылка.УникальныйИдентификатор()) Или РабочаяОбластьИдентификатор <> Строка(Объект.РабочееПространство.УникальныйИдентификатор())
        Или ОбластьИдентификатор <> Строка(Объект.Область.УникальныйИдентификатор())
        Или (ЗаявительИдентификатор <> Строка(Объект.Заявитель.УникальныйИдентификатор()) И Не (Объект.Источник = "GuestReceipt" И ЗаявительИдентификатор = "00000000-0000-0000-0000-000000000000")) Тогда
        ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт";
    КонецЕсли;
    Результат = СнимокДанныхДляЗаявителя(Данные);
    Если Результат.Количество() <> 16 Тогда
        ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт";
    КонецЕсли;
    Если ТипЗнч(Результат.revision) <> Тип("Число") Или ТипЗнч(Результат.stage) <> Тип("Число") Тогда
        ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт";
    КонецЕсли;
    Поля = СтрРазделить("workspaceId,areaId,requesterAccountId,responsibleAccountId,incidentId,priority,dueAt,overdue,messageCount,resumeState,createdBy", ",");
    Для Каждого Имя Из Поля Цикл
        Значение = Неопределено;
        Если Не Данные.Свойство(Имя, Значение) Тогда
            ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт";
        КонецЕсли;
        Если ТипЗнч(Значение) <> Тип("Строка") И ТипЗнч(Значение) <> Тип("Число") И ТипЗнч(Значение) <> Тип("Булево") Тогда
            ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт";
        КонецЕсли;
        Результат.Вставить(Имя, Значение);
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция ХешТекстаДиспетчерской(Текст)
    Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
    Хеш.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8));
    Возврат СтрЗаменить(СтрЗаменить(Base64Строка(Хеш.ХешСумма), Символы.ВК, ""), Символы.ПС, "");
КонецФункции

Функция ХешСекретаКвитанции(Секрет)
    Если ТипЗнч(Секрет) <> Тип("Строка") Или СтрДлина(Секрет) <> 64 Тогда ВызватьИсключение "кабинет_диспетчерская_квитанция_не_найдено"; КонецЕсли;
    Для П = 1 По 64 Цикл
        Если СтрНайти("0123456789abcdef", Сред(Секрет, П, 1)) = 0 Тогда ВызватьИсключение "кабинет_диспетчерская_квитанция_не_найдено"; КонецЕсли;
    КонецЦикла;
    Возврат ХешТекстаДиспетчерской(Секрет);
КонецФункции

Функция ЗаписьКвитанции(Идентификатор, Блокировать = Ложь)
    Идентификатор = Строка(РазобратьИдентификатор(Идентификатор));
    Если Блокировать Тогда
        Блокировка = Новый БлокировкаДанных;
        Элемент = Блокировка.Добавить("РегистрСведений.КвитанцииГостевыхОбращений");
        Элемент.УстановитьЗначение("Идентификатор", Идентификатор);
        Элемент.Режим = РежимБлокировкиДанных.Исключительный;
        Блокировка.Заблокировать();
    КонецЕсли;
    Запись = РегистрыСведений.КвитанцииГостевыхОбращений.СоздатьМенеджерЗаписи();
    Запись.Идентификатор = Идентификатор; Запись.Прочитать();
    Запись.Идентификатор = Идентификатор;
    Возврат Запись;
КонецФункции

Процедура ПроверитьПривязкуГостевогоОбращения(Объект) Экспорт
    Если ЗначениеЗаполнено(Объект.КемСоздано) Или СтрДлина(Объект.КвитанцияГостя) <> 36 Тогда ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт"; КонецЕсли;
    Квитанция = ЗаписьКвитанции(Объект.КвитанцияГостя);
    СсылкаОбращения = Объект.Ссылка;
    Если Объект.ЭтоНовый() Тогда СсылкаОбращения = Объект.ПолучитьСсылкуНового(); КонецЕсли;
    Если Не Квитанция.Выбран() Или Не ЗначениеЗаполнено(Квитанция.Обращение)
        Или Не ЗначениеЗаполнено(СсылкаОбращения) Или Квитанция.Обращение <> СсылкаОбращения
        Или СтрДлина(Квитанция.ХешСекрета) <> 44
        Или Квитанция.ПрисоединеноКем <> Объект.Заявитель Тогда ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт"; КонецЕсли;
КонецПроцедуры

Процедура УчестьГостевуюКвоту(Ключ, Предел)
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("РегистрСведений.ЛимитыГостевыхОбращений");
    Элемент.УстановитьЗначение("Ключ", Ключ); Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
    Счетчик = РегистрыСведений.ЛимитыГостевыхОбращений.СоздатьМенеджерЗаписи();
    Счетчик.Ключ = Ключ; Счетчик.Прочитать(); Счетчик.Ключ = Ключ;
    Сейчас = ТекущаяУниверсальнаяДата();
    Если Сейчас >= Счетчик.Окно + 3600 Тогда Счетчик.Окно = Сейчас; Счетчик.Количество = 0; КонецЕсли;
    Если Счетчик.Количество >= Предел Тогда ВызватьИсключение "кабинет_диспетчерская_квота_превышено"; КонецЕсли;
    Счетчик.Количество = Счетчик.Количество + 1; Счетчик.Записать();
КонецПроцедуры

Функция СоздатьГостевоеОбращение(ТелоЗапроса, ИдентификаторЗапроса, ИсточникХеш) Экспорт
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, "publicIntakeId,address,location,description,contact,photo,receiptSecret");
    Если ТипЗнч(ИсточникХеш) <> Тип("Строка") Или СтрДлина(ИсточникХеш) < 32 Или СтрДлина(ИсточникХеш) > 100 Тогда ВызватьИсключение "кабинет_диспетчерская_некорректно_поле"; КонецЕсли;
    ПриемнаяИд = ТекстовоеПоле(ТелоЗапроса, "publicIntakeId", 36);
    Адрес = ТекстовоеПоле(ТелоЗапроса, "address", 250);
    Расположение = ТекстовоеПоле(ТелоЗапроса, "location", 250);
    Описание = ТекстовоеПоле(ТелоЗапроса, "description", 1500, Истина);
    Контакт = ТекстовоеПоле(ТелоЗапроса, "contact", 128);
    ХешСекрета = ХешСекретаКвитанции(ТекстовоеПоле(ТелоЗапроса, "receiptSecret", 64));
    Фото = СервисФайлов.ПроверитьБайтыФотографии(ТелоЗапроса.photo);
    Намерение = ХешТекстаДиспетчерской(КодироватьЗначение(Новый Структура("intake,address,location,description,contact,photoHash,secretHash",
        ПриемнаяИд, Адрес, Расположение, Описание, Контакт, Фото.Содержимое.ХешSHA256, ХешСекрета), 16000));
    Предварительно = ПредставлениеПриемной(РазобратьИдентификатор(ПриемнаяИд));
    ПроверитьОтсутствиеТранзакции();
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьОбъектПоСсылке("Справочник.РабочиеПространства", Предварительно.РабочееПространство);
        ЗаблокироватьОбъектПоСсылке("Справочник.Области", Предварительно.ОбластьПоУмолчанию);
        ПроверитьАктивностьОбласти(Предварительно.РабочееПространство, Предварительно.ОбластьПоУмолчанию);
        Приемная = ПолучитьЗаблокированнуюПриемную(РазобратьИдентификатор(ПриемнаяИд), Предварительно.РабочееПространство);
        Квитанция = ЗаписьКвитанции(ИдентификаторЗапроса, Истина);
        Если Квитанция.Выбран() Тогда
            Если Квитанция.ХешНамерения <> Намерение Или Квитанция.ХешСекрета <> ХешСекрета Или Квитанция.ИсточникХеш <> ИсточникХеш Тогда ВызватьИсключение "кабинет_диспетчерская_запрос_конфликт"; КонецЕсли;
            Объект = Квитанция.Обращение.ПолучитьОбъект(); ПроверитьПривязкуГостевогоОбращения(Объект);
            Результат = ОграниченныйСтатусКвитанции(Квитанция, Объект);
            ЗафиксироватьТранзакцию(); Возврат Результат;
        КонецЕсли;
        Если Не Приемная.Опубликована Или Не Приемная.ПринимаетОбращения Тогда ВызватьИсключение "кабинет_диспетчерская_прием_закрыто"; КонецЕсли;
        Если Приемная.ОбластьПоУмолчанию <> Предварительно.ОбластьПоУмолчанию Тогда ВызватьИсключение "кабинет_диспетчерская_маршрутизация_конфликт"; КонецЕсли;
        Если СохраненныеАдреса(Приемная.АдресаJSON).Найти(Адрес) = Неопределено Или СохраненныеКатегории(Приемная.КатегорииJSON).Найти("Manhole") = Неопределено Тогда ВызватьИсключение "кабинет_диспетчерская_необслуживаемо_адрес_или_категория"; КонецЕсли;
        УчестьГостевуюКвоту("area:" + Строка(Предварительно.ОбластьПоУмолчанию.УникальныйИдентификатор()), 100);
        Квота = КвотаРабочегоПространства(Предварительно.РабочееПространство);
        Если Квота.КоличествоОбращений >= 10000 Тогда ВызватьИсключение "кабинет_диспетчерская_квота_превышено"; КонецЕсли;
        СервисФайлов.ПроверитьОбщуюКвотуВложений(Новый Структура("РабочееПространство,Область", Предварительно.РабочееПространство, Предварительно.ОбластьПоУмолчанию), Фото.Содержимое.КоличествоБайт);
        ПустойАвтор = Справочники.УчетныеЗаписи.ПустаяСсылка();
        Объект = Справочники.ОбращенияДиспетчерской.СоздатьЭлемент();
        НоваяСсылка = Справочники.ОбращенияДиспетчерской.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4());
        Объект.УстановитьСсылкуНового(НоваяСсылка);
        ЗаполнитьСлужебныеОтметки(Объект, ПустойАвтор, Предварительно.РабочееПространство, Предварительно.ОбластьПоУмолчанию);
        Объект.Заявитель = ПустойАвтор; Объект.Источник = "GuestReceipt"; Объект.КвитанцияГостя = Строка(РазобратьИдентификатор(ИдентификаторЗапроса));
        Объект.Наименование = "Опасный люк: " + Лев(Расположение, 120); Объект.Приемная = Приемная.Ссылка; Объект.НаименованиеПриемной = Приемная.Наименование;
        Объект.Адрес = Адрес; Объект.Категория = "Manhole"; Объект.Подробности = Расположение + Символы.ПС + Описание; Объект.Контакт = Контакт;
        Объект.Состояние = "Submitted"; Объект.Этап = 1; Объект.Приоритет = "Critical"; Объект.СрокИсполнения = ТекущаяУниверсальнаяДата() + 7200;
        Квитанция.Обращение = НоваяСсылка; Квитанция.ХешСекрета = ХешСекрета; Квитанция.ХешНамерения = Намерение; Квитанция.ИсточникХеш = ИсточникХеш;
        Квитанция.ДатаСоздания = ТекущаяУниверсальнаяДата(); Квитанция.ФотоMIME = Фото.ТипMIME; Квитанция.ФотоИмя = Фото.ИмяФайла;
        Квитанция.ФотоБайт = Фото.Содержимое.КоличествоБайт; Квитанция.Фото = Новый ХранилищеЗначения(Фото.Содержимое.Данные); Квитанция.Записать();
        Объект.Записать();
        ПроверитьПривязкуГостевогоОбращения(Объект);
        Квота.КоличествоОбращений = Квота.КоличествоОбращений + 1; Квота.Записать();
        ДобавитьЗаписьИстории("Request", Объект, "guest.create", "Public", "Гостевое сообщение", Новый Структура, СлужебныеДанныеОбращения(Объект), ПустойАвтор, ИдентификаторЗапроса);
        ПолитикаДоступа.ЗаписатьСобытиеАудита(ПустойАвтор, Объект.РабочееПространство, "dispatch.guest.create", Строка(Объект.Ссылка.УникальныйИдентификатор()), "success", ИдентификаторЗапроса);
        Результат = ОграниченныйСтатусКвитанции(Квитанция, Объект);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ОграниченныйСтатусКвитанции(Квитанция, Объект)
    Возврат Новый Структура("receiptId,state,stage,createdAt,updatedAt,claimed",
        Квитанция.Идентификатор, Объект.Состояние, Объект.Этап, XMLСтрока(Объект.ДатаСоздания) + "Z", XMLСтрока(Объект.ДатаОбновления) + "Z", ЗначениеЗаполнено(Квитанция.ПрисоединеноКем));
КонецФункции

Функция СтатусГостевойКвитанции(Идентификатор, Секрет) Экспорт
    Хеш = ХешСекретаКвитанции(Секрет); Квитанция = ЗаписьКвитанции(Идентификатор);
    Если Не Квитанция.Выбран() Или Квитанция.ХешСекрета <> Хеш Тогда ВызватьИсключение "кабинет_диспетчерская_квитанция_не_найдено"; КонецЕсли;
    Объект = Квитанция.Обращение.ПолучитьОбъект();
    Если Объект = Неопределено Или Объект.ПометкаУдаления Тогда ВызватьИсключение "кабинет_диспетчерская_квитанция_не_найдено"; КонецЕсли;
    ПроверитьАктивностьОбласти(Объект.РабочееПространство, Объект.Область); ПроверитьПривязкуГостевогоОбращения(Объект);
    Возврат ОграниченныйСтатусКвитанции(Квитанция, Объект);
КонецФункции

Функция ПрисоединитьГостевоеОбращение(УчетнаяЗапись, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, "receiptSecret");
    Хеш = ХешСекретаКвитанции(ТекстовоеПоле(ТелоЗапроса, "receiptSecret", 64)); Исходная = ЗаписьКвитанции(Идентификатор);
    Если Не Исходная.Выбран() Или Исходная.ХешСекрета <> Хеш Тогда ВызватьИсключение "кабинет_диспетчерская_квитанция_не_найдено"; КонецЕсли;
    Предварительно = Исходная.Обращение.ПолучитьОбъект();
    Контекст = НачатьОперациюВОбласти(УчетнаяЗапись, Строка(Предварительно.РабочееПространство.УникальныйИдентификатор()), Строка(Предварительно.Область.УникальныйИдентификатор()), "");
    Попытка
        Квитанция = ЗаписьКвитанции(Идентификатор, Истина);
        Если Не Квитанция.Выбран() Или Квитанция.ХешСекрета <> Хеш Тогда ВызватьИсключение "кабинет_диспетчерская_квитанция_не_найдено"; КонецЕсли;
        Объект = ПолучитьЗаблокированноеОбращение(Квитанция.Обращение.УникальныйИдентификатор(), Контекст.РабочееПространство, Контекст.Область);
        Если ЗначениеЗаполнено(Квитанция.ПрисоединеноКем) И Квитанция.ПрисоединеноКем <> УчетнаяЗапись Тогда ВызватьИсключение "кабинет_диспетчерская_квитанция_не_найдено"; КонецЕсли;
        Если Не ЗначениеЗаполнено(Квитанция.ПрисоединеноКем) Тогда
            Перед = СлужебныеДанныеОбращения(Объект);
            Квитанция.ПрисоединеноКем = УчетнаяЗапись; Квитанция.ДатаПрисоединения = ТекущаяУниверсальнаяДата(); Квитанция.Записать();
            Объект.Заявитель = УчетнаяЗапись; УвеличитьРевизиюОбъекта(Объект); Объект.Записать();
            ДобавитьЗаписьИстории("Request", Объект, "guest.claim", "Public", "Подтверждено владение квитанцией", Перед, СлужебныеДанныеОбращения(Объект), УчетнаяЗапись, ИдентификаторЗапроса);
            ПолитикаДоступа.ЗаписатьСобытиеАудита(УчетнаяЗапись, Контекст.РабочееПространство, "dispatch.guest.claim", Строка(Объект.Ссылка.УникальныйИдентификатор()), "success", ИдентификаторЗапроса);
        КонецЕсли;
        Результат = ДанныеСобственногоОбращения(Объект); ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПолучитьГостевоеФото(УчетнаяЗапись, Идентификатор, СотрудникРежим = Ложь) Экспорт
    Контекст = НачатьОперациюСОбращением(УчетнаяЗапись, Идентификатор, СотрудникРежим);
    Попытка
        Если Контекст.Объект.Источник <> "GuestReceipt" Тогда ВызватьИсключение "кабинет_диспетчерская_не_найдено"; КонецЕсли;
        Квитанция = ЗаписьКвитанции(Контекст.Объект.КвитанцияГостя);
        ПроверитьПривязкуГостевогоОбращения(Контекст.Объект);
        Результат = Новый Структура("binary,mime,filename", Квитанция.Фото.Получить(), Квитанция.ФотоMIME, Квитанция.ФотоИмя);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПараметрДиспетчерской(Параметры, Имя, ПоУмолчанию = "")
    Значение = Неопределено;
    Если ТипЗнч(Параметры) = Тип("Структура") Тогда Параметры.Свойство(Имя, Значение);
    ИначеЕсли Параметры <> Неопределено Тогда Значение = Параметры.Получить(Имя); КонецЕсли;
    Если Значение = Неопределено Тогда Возврат ПоУмолчанию; КонецЕсли;
    Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) > 1024 Тогда ВызватьИсключение "кабинет_диспетчерская_некорректно_поле"; КонецЕсли;
    Возврат Значение;
КонецФункции

Функция ЛимитДиспетчерской(Параметры)
    Значение = ПараметрДиспетчерской(Параметры, "limit", "25");
    Если СтрДлина(Значение) < 1 Или СтрДлина(Значение) > 3 Или Лев(Значение, 1) = "0" Тогда ВызватьИсключение "кабинет_диспетчерская_некорректно_поле"; КонецЕсли;
    Для П = 1 По СтрДлина(Значение) Цикл
        Если СтрНайти("0123456789", Сред(Значение, П, 1)) = 0 Тогда ВызватьИсключение "кабинет_диспетчерская_некорректно_поле"; КонецЕсли;
    КонецЦикла;
    Лимит = Число(Значение);
    Если Лимит > 100 Тогда ВызватьИсключение "кабинет_диспетчерская_некорректно_поле"; КонецЕсли;
    Возврат Лимит;
КонецФункции

Функция ИсторияСправочникаДиспетчерской(УчетнаяЗапись, Вид, Контекст, Параметры, Лимит)
    Если Вид = "intakes" Тогда Каталог = "ПубличныеПриемные"; ИсторияВид = "Intake";
    ИначеЕсли Вид = "network" Тогда Каталог = "ОбъектыУчебнойСети"; ИсторияВид = "Network";
    ИначеЕсли Вид = "networkLinks" Тогда Каталог = "СвязиУчебнойСети"; ИсторияВид = "NetworkLink";
    ИначеЕсли Вид = "outages" Тогда Каталог = "ОтключенияВодоснабжения"; ИсторияВид = "Outage";
    Иначе ВызватьИсключение "кабинет_диспетчерская_некорректно_действие"; КонецЕсли;
    Идентификатор = Строка(РазобратьИдентификатор(ПараметрДиспетчерской(Параметры, "historyId")));
    Ссылка = Справочники[Каталог].ПолучитьСсылку(РазобратьИдентификатор(Идентификатор));
    ЗаблокироватьОбъектПоСсылке("Справочник." + Каталог, Ссылка);
    Объект = Ссылка.ПолучитьОбъект(); ПроверитьДанныеЭлемента(Объект, Контекст.РабочееПространство, Контекст.Область);
    ПространствоИд = Строка(Контекст.РабочееПространство.УникальныйИдентификатор()); ОбластьИд = Строка(Контекст.Область.УникальныйИдентификатор());
    Префикс = "dh1|" + ХешТекстаДиспетчерской(Вид + "|" + Строка(УчетнаяЗапись.УникальныйИдентификатор()) + "|" + ПространствоИд + "|" + ОбластьИд + "|" + Идентификатор) + "|";
    Курсор = ПараметрДиспетчерской(Параметры, "cursor"); ПослеРевизии = 999999999999999;
    Если Курсор <> "" Тогда
        Если Лев(Курсор, СтрДлина(Префикс)) <> Префикс Или СтрДлина(Курсор) > 128 Тогда ВызватьИсключение "кабинет_диспетчерская_некорректно_поле"; КонецЕсли;
        Позиция = Сред(Курсор, СтрДлина(Префикс) + 1);
        Если СтрДлина(Позиция) < 1 Или СтрДлина(Позиция) > 15 Или Лев(Позиция, 1) = "0" Тогда ВызватьИсключение "кабинет_диспетчерская_некорректно_поле"; КонецЕсли;
        Для Номер = 1 По СтрДлина(Позиция) Цикл
            Если СтрНайти("0123456789", Сред(Позиция, Номер, 1)) = 0 Тогда ВызватьИсключение "кабинет_диспетчерская_некорректно_поле"; КонецЕсли;
        КонецЦикла;
        ПослеРевизии = Число(Позиция);
    КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит + 1, "ЧГ=0") + " Ревизия, Операция, ДатаИзменения, ДействующееЛицо
        |ИЗ РегистрСведений.ИсторияДиспетчерской ГДЕ ВидСущности = &Вид И ИдентификаторСущности = &Идентификатор
        |И РабочееПространство = &РабочееПространство И Область = &Область И Ревизия < &ПослеРевизии УПОРЯДОЧИТЬ ПО Ревизия УБЫВ");
    УстановитьКонтекстОбласти(Запрос, Контекст.РабочееПространство, Контекст.Область);
    Запрос.УстановитьПараметр("Вид", ИсторияВид); Запрос.УстановитьПараметр("Идентификатор", Идентификатор); Запрос.УстановитьПараметр("ПослеРевизии", ПослеРевизии);
    Выборка = Запрос.Выполнить().Выбрать(); Элементы = Новый Массив; ЕстьЕще = Ложь; Следующий = "";
    Пока Выборка.Следующий() Цикл
        Если Элементы.Количество() = Лимит Тогда ЕстьЕще = Истина; Прервать; КонецЕсли;
        Элементы.Добавить(Новый Структура("revision,operation,changedAt,actorAccountId", Выборка.Ревизия, Выборка.Операция,
            XMLСтрока(Выборка.ДатаИзменения) + "Z", Строка(Выборка.ДействующееЛицо.УникальныйИдентификатор())));
        Следующий = Префикс + Формат(Выборка.Ревизия, "ЧГ=0");
    КонецЦикла;
    Возврат Новый Структура("kind,objectId,workspaceId,areaId,createdBy,currentRevision,items,limit,hasMore,nextCursor", Вид,
        Идентификатор, ПространствоИд, ОбластьИд, Строка(Объект.КемСоздано.УникальныйИдентификатор()), Объект.Ревизия,
        Элементы, Лимит, ЕстьЕще, ?(ЕстьЕще, Следующий, ""));
КонецФункции

Функция СтраницаДиспетчерской(УчетнаяЗапись, Вид, Параметры) Экспорт
    Лимит = ЛимитДиспетчерской(Параметры);
    ПространствоИд = ПараметрДиспетчерской(Параметры, "workspaceId");
    ОбластьИд = ПараметрДиспетчерской(Параметры, "areaId");
    Если Вид = "myRequests" Тогда НачатьОперациюУчастника(УчетнаяЗапись);
    Иначе
        Роль = "Dispatcher"; Если Вид = "intakes" Тогда Роль = "WorkspaceOwner"; КонецЕсли;
        Контекст = НачатьОперациюВОбласти(УчетнаяЗапись, ПространствоИд, ОбластьИд, Роль);
    КонецЕсли;
    Попытка
        ВидПредставления = ПараметрДиспетчерской(Параметры, "view");
        Если ВидПредставления <> "" Тогда
            Если ВидПредставления <> "history" Или СтрРазделить("intakes,network,networkLinks,outages", ",").Найти(Вид) = Неопределено Тогда ВызватьИсключение "кабинет_диспетчерская_некорректно_действие"; КонецЕсли;
            Результат = ИсторияСправочникаДиспетчерской(УчетнаяЗапись, Вид, Контекст, Параметры, Лимит);
            ЗафиксироватьТранзакцию(); Возврат Результат;
        КонецЕсли;
        Каталог = ""; Условия = "НЕ ПометкаУдаления";
        Если Вид = "myRequests" Или Вид = "requests" Тогда Каталог = "ОбращенияДиспетчерской";
        ИначеЕсли Вид = "incidents" Тогда Каталог = "ИнцидентыДиспетчерской";
        ИначеЕсли Вид = "intakes" Тогда Каталог = "ПубличныеПриемные";
        ИначеЕсли Вид = "outages" Тогда Каталог = "ОтключенияВодоснабжения";
        ИначеЕсли Вид = "network" Тогда Каталог = "ОбъектыУчебнойСети";
        ИначеЕсли Вид = "networkLinks" Тогда Каталог = "СвязиУчебнойСети";
        Иначе ВызватьИсключение "кабинет_диспетчерская_некорректно_действие"; КонецЕсли;
        Если Вид = "myRequests" Тогда
            Условия = Условия + " И Заявитель = &УчетнаяЗапись И РабочееПространство.Состояние = ""Active"" И НЕ РабочееПространство.ПометкаУдаления И Область.Состояние = ""Active"" И НЕ Область.ПометкаУдаления";
        Иначе Условия = Условия + " И РабочееПространство = &РабочееПространство И Область = &Область"; КонецЕсли;
        Запрос = Новый Запрос;
        Если Вид = "myRequests" Тогда Запрос.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
        Иначе УстановитьКонтекстОбласти(Запрос, Контекст.РабочееПространство, Контекст.Область); КонецЕсли;
        Фильтры = Новый Структура;
        Если Вид = "requests" Или Вид = "myRequests" Тогда
            Для Каждого Имя Из СтрРазделить("state,priority,source,address,responsibleAccountId,overdue,from,to", ",") Цикл
                Значение = ПараметрДиспетчерской(Параметры, Имя); Фильтры.Вставить(Имя, Значение);
                Если Значение = "" Тогда Продолжить; КонецЕсли;
                Если Имя = "state" Тогда
                    Если СтрРазделить("Submitted,Accepted,AwaitingInfo,Rejected,Resolved", ",").Найти(Значение) = Неопределено Тогда ВызватьИсключение "кабинет_диспетчерская_некорректно_состояние"; КонецЕсли;
                    Условия = Условия + " И Состояние = &state"; Запрос.УстановитьПараметр("state", Значение);
                ИначеЕсли Имя = "priority" Тогда
                    Если СтрРазделить("Low,Normal,High,Critical", ",").Найти(Значение) = Неопределено Тогда ВызватьИсключение "кабинет_диспетчерская_некорректно_поле"; КонецЕсли;
                    Условия = Условия + " И Приоритет = &priority"; Запрос.УстановитьПараметр("priority", Значение);
                ИначеЕсли Имя = "source" Тогда
                    Если Значение <> "Portal" И Значение <> "GuestReceipt" Тогда ВызватьИсключение "кабинет_диспетчерская_некорректно_поле"; КонецЕсли;
                    Условия = Условия + " И (Источник = &source ИЛИ (Источник = """" И &source = ""Portal""))"; Запрос.УстановитьПараметр("source", Значение);
                ИначеЕсли Имя = "address" Тогда
                    Условия = Условия + " И Адрес = &address"; Запрос.УстановитьПараметр("address", ПроверенныйТекст(Значение, 250, Ложь));
                ИначеЕсли Имя = "responsibleAccountId" Тогда
                    Условия = Условия + " И Ответственный = &responsible"; Запрос.УстановитьПараметр("responsible", Справочники.УчетныеЗаписи.ПолучитьСсылку(РазобратьИдентификатор(Значение)));
                ИначеЕсли Имя = "overdue" Тогда
                    Если Значение <> "true" И Значение <> "false" Тогда ВызватьИсключение "кабинет_диспетчерская_некорректно_поле"; КонецЕсли;
                    Условия = Условия + " И ((СрокИсполнения < &now И Состояние <> ""Resolved"" И Состояние <> ""Rejected"") = &overdue)";
                    Запрос.УстановитьПараметр("now", ТекущаяУниверсальнаяДата()); Запрос.УстановитьПараметр("overdue", Значение = "true");
                Иначе
                    ДатаФильтра = ПолеДатыUTC(Новый Структура("date", Значение), "date");
                    Если Имя = "from" Тогда Условия = Условия + " И ДатаСоздания >= &from"; Иначе Условия = Условия + " И ДатаСоздания <= &to"; КонецЕсли;
                    Запрос.УстановитьПараметр(Имя, ДатаФильтра);
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;
        Префикс = "d1|" + ХешТекстаДиспетчерской(Вид + "|" + Строка(УчетнаяЗапись.УникальныйИдентификатор()) + "|" + ПространствоИд + "|" + ОбластьИд + "|" + КодироватьЗначение(Фильтры, 16000)) + "|";
        Курсор = ПараметрДиспетчерской(Параметры, "cursor");
        Если Курсор <> "" Тогда
            Если Лев(Курсор, СтрДлина(Префикс)) <> Префикс Тогда ВызватьИсключение "кабинет_диспетчерская_некорректно_поле"; КонецЕсли;
            После = РазобратьИдентификатор(Сред(Курсор, СтрДлина(Префикс) + 1));
            Условия = Условия + " И Ссылка > &После";
            Запрос.УстановитьПараметр("После", Справочники[Каталог].ПолучитьСсылку(После));
        КонецЕсли;
        Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит + 1, "ЧГ=0") + " Ссылка ИЗ Справочник." + Каталог + " ГДЕ " + Условия + " УПОРЯДОЧИТЬ ПО Ссылка";
        Выборка = Запрос.Выполнить().Выбрать(); Элементы = Новый Массив; ЕстьЕще = Ложь; Следующий = "";
        Пока Выборка.Следующий() Цикл
            Если Элементы.Количество() = Лимит Тогда ЕстьЕще = Истина; Прервать; КонецЕсли;
            Объект = Выборка.Ссылка.ПолучитьОбъект();
            Если Вид = "myRequests" Тогда Данные = ДанныеСобственногоОбращения(Объект);
            ИначеЕсли Вид = "requests" Тогда Данные = СлужебныеДанныеОбращения(Объект);
            ИначеЕсли Вид = "incidents" Тогда Данные = ДанныеИнцидента(Объект);
            ИначеЕсли Вид = "intakes" Тогда Данные = ДанныеПриемнойДляВладельца(Объект);
            ИначеЕсли Вид = "outages" Тогда Данные = ДанныеОтключения(Объект);
            ИначеЕсли Вид = "network" Тогда Данные = ДанныеСетевогоОбъекта(Объект);
            Иначе Данные = ДанныеСвязиСети(Объект); КонецЕсли;
            Элементы.Добавить(Данные); Следующий = Префикс + Строка(Выборка.Ссылка.УникальныйИдентификатор());
        КонецЦикла;
        Если Не ЕстьЕще Тогда Следующий = ""; КонецЕсли;
        Результат = Новый Структура("items,limit,hasMore,nextCursor", Элементы, Лимит, ЕстьЕще, Следующий);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПубличныеПриемные(Параметры) Экспорт
    Лимит = ЛимитДиспетчерской(Параметры); Курсор = ПараметрДиспетчерской(Параметры, "cursor");
    Текст = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит + 1, "ЧГ=0") + " Ссылка ИЗ Справочник.ПубличныеПриемные ГДЕ Опубликована И НЕ ПометкаУдаления
        |И РабочееПространство.Состояние = ""Active"" И НЕ РабочееПространство.ПометкаУдаления И ОбластьПоУмолчанию.Состояние = ""Active"" И НЕ ОбластьПоУмолчанию.ПометкаУдаления
        |И ОбластьПоУмолчанию.РабочееПространство = РабочееПространство";
    Запрос = Новый Запрос;
    Если Курсор <> "" Тогда
        Текст = Текст + " И Ссылка > &После";
        Запрос.УстановитьПараметр("После", Справочники.ПубличныеПриемные.ПолучитьСсылку(РазобратьИдентификатор(Курсор)));
    КонецЕсли;
    Запрос.Текст = Текст + " УПОРЯДОЧИТЬ ПО Ссылка";
    Выборка = Запрос.Выполнить().Выбрать(); Элементы = Новый Массив; ЕстьЕще = Ложь; Следующий = "";
    Пока Выборка.Следующий() Цикл
        Если Элементы.Количество() = Лимит Тогда ЕстьЕще = Истина; Прервать; КонецЕсли;
        Элементы.Добавить(ДанныеПриемнойДляЗаявителя(Выборка.Ссылка.ПолучитьОбъект()));
        Следующий = Строка(Выборка.Ссылка.УникальныйИдентификатор());
    КонецЦикла;
    Если Не ЕстьЕще Тогда Следующий = ""; КонецЕсли;
    Возврат Новый Структура("items,limit,hasMore,nextCursor", Элементы, Лимит, ЕстьЕще, Следующий);
КонецФункции

Функция ДанныеСетевогоОбъекта(Объект)
    Результат = ОбщиеДанныеОбъекта(Объект);
    Результат.Вставить("name", Объект.Наименование); Результат.Вставить("address", Объект.Адрес);
    Результат.Вставить("type", Объект.ВидОбъекта); Результат.Вставить("state", Объект.Состояние);
    Результат.Вставить("description", Объект.Описание); Результат.Вставить("x", Объект.КоординатаX); Результат.Вставить("y", Объект.КоординатаY);
    Возврат Результат;
КонецФункции

Функция ДанныеСвязиСети(Объект)
    Результат = ОбщиеДанныеОбъекта(Объект); Результат.Вставить("state", Объект.Состояние);
    Результат.Вставить("fromId", Строка(Объект.НачальныйОбъект.УникальныйИдентификатор())); Результат.Вставить("toId", Строка(Объект.КонечныйОбъект.УникальныйИдентификатор()));
    Возврат Результат;
КонецФункции

Функция ПовторНовойКоманды(Команда, Вид, Объект)
    Если Команда.ВидСущности <> Вид Или Команда.ИдентификаторСущности <> Строка(Объект.Ссылка.УникальныйИдентификатор()) Тогда ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт"; КонецЕсли;
    Результат = ДекодироватьСтруктуру(Команда.РезультатJSON);
    Если Результат.id <> Команда.ИдентификаторСущности Или Результат.revision <> Команда.РевизияРезультата Тогда ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт"; КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ЗаписатьСетевойОбъект(УчетнаяЗапись, Идентификатор, Тело, Ключ) Экспорт
    ПроверитьПоляТелаЗапроса(Тело, "workspaceId,areaId,expectedRevision,name,address,type,state,description,x,y,reason");
    Имя = ТекстовоеПоле(Тело, "name", 150); Адрес = ТекстовоеПоле(Тело, "address", 250);
    Вид = ПолеИзПеречня(Тело, "type", "Pipe,Valve,Well,Pump,Reservoir,Hydrant,Other");
    Состояние = ПолеИзПеречня(Тело, "state", "Active,Fault,Maintenance,Retired");
    Описание = ТекстовоеПоле(Тело, "description", 2000, Истина); Причина = ТекстовоеПоле(Тело, "reason", 250);
    Для Каждого Поле Из СтрРазделить("x,y", ",") Цикл
        Если Не Тело.Свойство(Поле) Тогда ВызватьИсключение "кабинет_диспетчерская_некорректно_поле"; КонецЕсли;
        Значение = Тело[Поле];
        Если ТипЗнч(Значение) <> Тип("Число") Или Значение < 0 Или Значение > 1000 Или Значение <> Цел(Значение) Тогда ВызватьИсключение "кабинет_диспетчерская_некорректно_поле"; КонецЕсли;
    КонецЦикла;
    Контекст = НачатьОперациюВОбласти(УчетнаяЗапись, ТекстовоеПоле(Тело, "workspaceId", 36), ТекстовоеПоле(Тело, "areaId", 36), "Dispatcher");
    Попытка
        Намерение = КодироватьЗначение(Новый Структура("id,body", Идентификатор, Тело), 16000);
        Команда = ОткрытьПривязкуКоманды(УчетнаяЗапись, Ключ, "network.save", Намерение, Контекст.РабочееПространство, Контекст.Область);
        Если Команда.Выбран() Тогда
            Объект = Справочники.ОбъектыУчебнойСети.ПолучитьСсылку(РазобратьИдентификатор(Команда.ИдентификаторСущности)).ПолучитьОбъект();
            ПроверитьДанныеЭлемента(Объект, Контекст.РабочееПространство, Контекст.Область);
            Результат = ПовторНовойКоманды(Команда, "Network", Объект); ЗафиксироватьТранзакцию(); Возврат Результат;
        КонецЕсли;
        Перед = Новый Структура;
        Если Идентификатор = "" Тогда
            Объект = Справочники.ОбъектыУчебнойСети.СоздатьЭлемент();
            Объект.SetNewObjectRef(Справочники.ОбъектыУчебнойСети.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
            ЗаполнитьСлужебныеОтметки(Объект, УчетнаяЗапись, Контекст.РабочееПространство, Контекст.Область);
        Иначе
            Ссылка = Справочники.ОбъектыУчебнойСети.ПолучитьСсылку(РазобратьИдентификатор(Идентификатор));
            ЗаблокироватьОбъектПоСсылке("Справочник.ОбъектыУчебнойСети", Ссылка); Объект = Ссылка.ПолучитьОбъект();
            ПроверитьДанныеЭлемента(Объект, Контекст.РабочееПространство, Контекст.Область); ПроверитьТекущуюРевизию(Объект, ПолеРевизии(Тело, "expectedRevision"));
            Перед = ДанныеСетевогоОбъекта(Объект); УвеличитьРевизиюОбъекта(Объект);
        КонецЕсли;
        Объект.Наименование = Имя; Объект.Адрес = Адрес; Объект.ВидОбъекта = Вид; Объект.Состояние = Состояние; Объект.Описание = Описание;
        Объект.КоординатаX = Тело.x; Объект.КоординатаY = Тело.y; Объект.Записать(); Результат = ДанныеСетевогоОбъекта(Объект);
        ДобавитьЗаписьИстории("Network", Объект, "network.save", "Internal", Причина, Перед, Результат, УчетнаяЗапись, Ключ);
        ПолитикаДоступа.ЗаписатьСобытиеАудита(УчетнаяЗапись, Контекст.РабочееПространство, "dispatch.network.save", Строка(Объект.Ссылка.УникальныйИдентификатор()), "success", Ключ);
        СохранитьПривязкуКоманды(Команда, "Network", Объект.Ссылка, Результат); ЗафиксироватьТранзакцию();
    Исключение ОтменитьСобственнуюТранзакцию(); ВызватьИсключение; КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ЗаписатьСвязьСети(УчетнаяЗапись, Идентификатор, Тело, Ключ) Экспорт
    ПроверитьПоляТелаЗапроса(Тело, "workspaceId,areaId,expectedRevision,fromId,toId,state,reason");
    От = Справочники.ОбъектыУчебнойСети.ПолучитьСсылку(РазобратьИдентификатор(ТекстовоеПоле(Тело, "fromId", 36)));
    До = Справочники.ОбъектыУчебнойСети.ПолучитьСсылку(РазобратьИдентификатор(ТекстовоеПоле(Тело, "toId", 36)));
    Если От = До Тогда ВызватьИсключение "кабинет_диспетчерская_связь_конфликт"; КонецЕсли;
    Состояние = ПолеИзПеречня(Тело, "state", "Active,Fault,Maintenance,Retired"); Причина = ТекстовоеПоле(Тело, "reason", 250);
    Контекст = НачатьОперациюВОбласти(УчетнаяЗапись, ТекстовоеПоле(Тело, "workspaceId", 36), ТекстовоеПоле(Тело, "areaId", 36), "Dispatcher");
    Попытка
        ПроверитьДанныеЭлемента(От.ПолучитьОбъект(), Контекст.РабочееПространство, Контекст.Область);
        ПроверитьДанныеЭлемента(До.ПолучитьОбъект(), Контекст.РабочееПространство, Контекст.Область);
        Намерение = КодироватьЗначение(Новый Структура("id,body", Идентификатор, Тело), 16000);
        Команда = ОткрытьПривязкуКоманды(УчетнаяЗапись, Ключ, "network.link", Намерение, Контекст.РабочееПространство, Контекст.Область);
        Если Команда.Выбран() Тогда
            Объект = Справочники.СвязиУчебнойСети.ПолучитьСсылку(РазобратьИдентификатор(Команда.ИдентификаторСущности)).ПолучитьОбъект();
            ПроверитьДанныеЭлемента(Объект, Контекст.РабочееПространство, Контекст.Область);
            Результат = ПовторНовойКоманды(Команда, "NetworkLink", Объект); ЗафиксироватьТранзакцию(); Возврат Результат;
        КонецЕсли;
        Перед = Новый Структура;
        Если Идентификатор = "" Тогда
            Объект = Справочники.СвязиУчебнойСети.СоздатьЭлемент();
            Объект.SetNewObjectRef(Справочники.СвязиУчебнойСети.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4())); ЗаполнитьСлужебныеОтметки(Объект, УчетнаяЗапись, Контекст.РабочееПространство, Контекст.Область);
        Иначе
            Ссылка = Справочники.СвязиУчебнойСети.ПолучитьСсылку(РазобратьИдентификатор(Идентификатор));
            ЗаблокироватьОбъектПоСсылке("Справочник.СвязиУчебнойСети", Ссылка); Объект = Ссылка.ПолучитьОбъект();
            ПроверитьДанныеЭлемента(Объект, Контекст.РабочееПространство, Контекст.Область); ПроверитьТекущуюРевизию(Объект, ПолеРевизии(Тело, "expectedRevision"));
            Перед = ДанныеСвязиСети(Объект); УвеличитьРевизиюОбъекта(Объект);
        КонецЕсли;
        Объект.Наименование = "Учебная связь"; Объект.НачальныйОбъект = От; Объект.КонечныйОбъект = До; Объект.Состояние = Состояние; Объект.Записать();
        Результат = ДанныеСвязиСети(Объект); ДобавитьЗаписьИстории("NetworkLink", Объект, "network.link", "Internal", Причина, Перед, Результат, УчетнаяЗапись, Ключ);
        ПолитикаДоступа.ЗаписатьСобытиеАудита(УчетнаяЗапись, Контекст.РабочееПространство, "dispatch.network.link", Строка(Объект.Ссылка.УникальныйИдентификатор()), "success", Ключ);
        СохранитьПривязкуКоманды(Команда, "NetworkLink", Объект.Ссылка, Результат); ЗафиксироватьТранзакцию();
    Исключение ОтменитьСобственнуюТранзакцию(); ВызватьИсключение; КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПривязатьОбъектКИнциденту(УчетнаяЗапись, Идентификатор, Тело, Ключ) Экспорт
    ПроверитьПоляТелаЗапроса(Тело, "expectedRevision,networkAssetId,reason");
    Ссылка = Справочники.ОбъектыУчебнойСети.ПолучитьСсылку(РазобратьИдентификатор(ТекстовоеПоле(Тело, "networkAssetId", 36)));
    Причина = ТекстовоеПоле(Тело, "reason", 250);
    Контекст = НачатьОперациюСИнцидентом(УчетнаяЗапись, Идентификатор);
    Попытка
        Объект = Контекст.Объект;
        ЗаблокироватьОбъектПоСсылке("Справочник.ОбъектыУчебнойСети", Ссылка);
        ПроверитьДанныеЭлемента(Ссылка.ПолучитьОбъект(), Контекст.РабочееПространство, Контекст.Область);
        Команда = ОткрытьПривязкуКоманды(УчетнаяЗапись, Ключ, "incident.asset", КодироватьЗначение(Новый Структура("id,body", Идентификатор, Тело), 16000), Контекст.РабочееПространство, Контекст.Область);
        Если Команда.Выбран() Тогда Результат = ПовторНовойКоманды(Команда, "IncidentStaff", Объект);
        Иначе
            ПроверитьТекущуюРевизию(Объект, ПолеРевизии(Тело, "expectedRevision"));
            Если Объект.Состояние <> "Open" Тогда ВызватьИсключение "кабинет_диспетчерская_состояние_конфликт"; КонецЕсли;
            Перед = ДанныеИнцидента(Объект); Объект.СетевойОбъект = Ссылка; УвеличитьРевизиюОбъекта(Объект); Объект.Записать();
            Результат = ДанныеИнцидента(Объект); ДобавитьЗаписьИстории("Incident", Объект, "incident.asset", "Internal", Причина, Перед, Результат, УчетнаяЗапись, Ключ);
            ПолитикаДоступа.ЗаписатьСобытиеАудита(УчетнаяЗапись, Контекст.РабочееПространство, "dispatch.incident.asset", Строка(Объект.Ссылка.УникальныйИдентификатор()), "success", Ключ);
            СохранитьПривязкуКоманды(Команда, "IncidentStaff", Объект.Ссылка, Результат);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение ОтменитьСобственнуюТранзакцию(); ВызватьИсключение; КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПубличнаяДата(Значение)
    Если Значение = Дата(1, 1, 1) Тогда Возврат ""; КонецЕсли;
    Возврат XMLСтрока(Значение) + "Z";
КонецФункции

Функция ДанныеОтключения(Объект)
    Результат = ОбщиеДанныеОбъекта(Объект);
    Результат.Вставить("type", Объект.ТипОтключения); Результат.Вставить("reason", Объект.Причина);
    Результат.Вставить("sourceType", Объект.ВидИсточника);
    Источник = Объект.Инцидент; Если Объект.ВидИсточника = "WorkOrder" Тогда Источник = Объект.Наряд; КонецЕсли;
    Результат.Вставить("sourceId", НеобязательныйИдентификатор(Источник));
    Результат.Вставить("addresses", СохраненныеАдреса(Объект.АдресаJSON));
    Результат.Вставить("waterPoints", ДекодироватьЗначение(Объект.ТочкиПодвозаJSON));
    Результат.Вставить("startedAt", ПубличнаяДата(Объект.Начало)); Результат.Вставить("expectedRestoredAt", ПубличнаяДата(Объект.ПрогнозОкончания)); Результат.Вставить("restoredAt", ПубличнаяДата(Объект.Восстановлено));
    Результат.Вставить("state", Объект.Состояние); Результат.Вставить("publishedRevision", Объект.ОпубликованнаяРедакция);
    Результат.Вставить("approvedAt", ПубличнаяДата(Объект.ДатаУтверждения));
    Возврат Результат;
КонецФункции

Процедура ПроверитьАдресаОтключения(Адреса, Контекст)
    Запрос = Новый Запрос("ВЫБРАТЬ АдресаJSON ИЗ Справочник.ПубличныеПриемные ГДЕ РабочееПространство = &РабочееПространство И ОбластьПоУмолчанию = &Область И Опубликована И НЕ ПометкаУдаления");
    УстановитьКонтекстОбласти(Запрос, Контекст.РабочееПространство, Контекст.Область);
    Выборка = Запрос.Выполнить().Выбрать(); Разрешенные = Новый Соответствие;
    Пока Выборка.Следующий() Цикл
        Для Каждого Адрес Из СохраненныеАдреса(Выборка.АдресаJSON) Цикл Разрешенные.Вставить(Адрес, Истина); КонецЦикла;
    КонецЦикла;
    Для Каждого Адрес Из Адреса Цикл
        Если Разрешенные.Получить(Адрес) <> Истина Тогда ВызватьИсключение "кабинет_диспетчерская_необслуживаемо_адрес_или_категория"; КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ПроверенныеТочкиПодвоза(Тело)
    Значение = Неопределено; Тело.Свойство("waterPoints", Значение);
    Если ТипЗнч(Значение) <> Тип("Массив") Или Значение.Количество() > 20 Тогда ВызватьИсключение "кабинет_диспетчерская_некорректно_поле"; КонецЕсли;
    Результат = Новый Массив;
    Для Каждого Точка Из Значение Цикл
        ПроверитьПоляТелаЗапроса(Точка, "address,from,to,note");
        Адрес = ТекстовоеПоле(Точка, "address", 250); Начало = ПолеДатыUTC(Точка, "from"); Конец = ПолеДатыUTC(Точка, "to");
        Если Начало >= Конец Тогда ВызватьИсключение "кабинет_диспетчерская_некорректно_даты"; КонецЕсли;
        Результат.Добавить(Новый Структура("address,from,to,note", Адрес, ПубличнаяДата(Начало), ПубличнаяДата(Конец), ТекстовоеПоле(Точка, "note", 250)));
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция СохранитьОтключение(УчетнаяЗапись, Идентификатор, Тело, Ключ) Экспорт
    ПроверитьПоляТелаЗапроса(Тело, "workspaceId,areaId,expectedRevision,sourceType,sourceId,type,reason,addresses,waterPoints,startedAt,expectedRestoredAt,restoredAt,state");
    ВидИсточника = ПолеИзПеречня(Тело, "sourceType", "Incident,WorkOrder");
    Вид = ПолеИзПеречня(Тело, "type", "Emergency,Planned"); Причина = ТекстовоеПоле(Тело, "reason", 1000, Истина);
    Состояние = ПолеИзПеречня(Тело, "state", "Planned,Active,Restored"); Адреса = ПроверенныеАдреса(Тело.addresses); Точки = ПроверенныеТочкиПодвоза(Тело);
    Начало = ПолеДатыUTC(Тело, "startedAt"); Прогноз = Дата(1, 1, 1); Восстановлено = Дата(1, 1, 1);
    Если ПараметрДиспетчерской(Тело, "expectedRestoredAt") <> "" Тогда Прогноз = ПолеДатыUTC(Тело, "expectedRestoredAt"); КонецЕсли;
    Если ПараметрДиспетчерской(Тело, "restoredAt") <> "" Тогда Восстановлено = ПолеДатыUTC(Тело, "restoredAt"); КонецЕсли;
    Если (Прогноз <> Дата(1, 1, 1) И (Начало >= Прогноз Или Прогноз - Начало > 2592000)) Или (Состояние = "Restored" И (Восстановлено < Начало Или Восстановлено > ТекущаяУниверсальнаяДата()))
        Или (Состояние <> "Restored" И Восстановлено <> Дата(1, 1, 1)) Тогда ВызватьИсключение "кабинет_диспетчерская_некорректно_даты"; КонецЕсли;
    ИсточникИд = РазобратьИдентификатор(ТекстовоеПоле(Тело, "sourceId", 36));
    Контекст = НачатьОперациюВОбласти(УчетнаяЗапись, ТекстовоеПоле(Тело, "workspaceId", 36), ТекстовоеПоле(Тело, "areaId", 36), "Dispatcher");
    Попытка
        Если ВидИсточника = "Incident" Тогда
            Источник = ПолучитьЗаблокированныйИнцидент(ИсточникИд, Контекст.РабочееПространство, Контекст.Область);
        Иначе
            ИсточникСсылка = Справочники.Наряды.ПолучитьСсылку(ИсточникИд); ЗаблокироватьОбъектПоСсылке("Справочник.Наряды", ИсточникСсылка);
            Источник = ИсточникСсылка.ПолучитьОбъект(); ПроверитьДанныеЭлемента(Источник, Контекст.РабочееПространство, Контекст.Область);
        КонецЕсли;
        Намерение = КодироватьЗначение(Новый Структура("id,body", Идентификатор, Тело), 16000);
        Команда = ОткрытьПривязкуКоманды(УчетнаяЗапись, Ключ, "outage.save", Намерение, Контекст.РабочееПространство, Контекст.Область);
        Если Команда.Выбран() Тогда
            Объект = Справочники.ОтключенияВодоснабжения.ПолучитьСсылку(РазобратьИдентификатор(Команда.ИдентификаторСущности)).ПолучитьОбъект();
            ПроверитьДанныеЭлемента(Объект, Контекст.РабочееПространство, Контекст.Область);
            Результат = ПовторНовойКоманды(Команда, "Outage", Объект); ЗафиксироватьТранзакцию(); Возврат Результат;
        КонецЕсли;
        ПроверитьАдресаОтключения(Адреса, Контекст);
        Перед = Новый Структура;
        Если Идентификатор = "" Тогда
            Объект = Справочники.ОтключенияВодоснабжения.СоздатьЭлемент();
            Объект.SetNewObjectRef(Справочники.ОтключенияВодоснабжения.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4())); ЗаполнитьСлужебныеОтметки(Объект, УчетнаяЗапись, Контекст.РабочееПространство, Контекст.Область);
            Объект.ВидИсточника = ВидИсточника;
            Если ВидИсточника = "Incident" Тогда Объект.Инцидент = Источник.Ссылка; Иначе Объект.Наряд = Источник.Ссылка; КонецЕсли;
        Иначе
            Ссылка = Справочники.ОтключенияВодоснабжения.ПолучитьСсылку(РазобратьИдентификатор(Идентификатор)); ЗаблокироватьОбъектПоСсылке("Справочник.ОтключенияВодоснабжения", Ссылка);
            Объект = Ссылка.ПолучитьОбъект(); ПроверитьДанныеЭлемента(Объект, Контекст.РабочееПространство, Контекст.Область);
            ПроверитьТекущуюРевизию(Объект, ПолеРевизии(Тело, "expectedRevision"));
            Если Объект.ВидИсточника <> ВидИсточника Или (ВидИсточника = "Incident" И Объект.Инцидент <> Источник.Ссылка) Или (ВидИсточника = "WorkOrder" И Объект.Наряд <> Источник.Ссылка) Тогда ВызватьИсключение "кабинет_диспетчерская_связь_конфликт"; КонецЕсли;
            Перед = ДанныеОтключения(Объект); УвеличитьРевизиюОбъекта(Объект);
        КонецЕсли;
        Объект.Наименование = Лев(Причина, 150); Объект.ТипОтключения = Вид; Объект.Причина = Причина;
        Объект.АдресаJSON = КодироватьЗначение(Адреса, 10000); Объект.ТочкиПодвозаJSON = КодироватьЗначение(Точки, 10000);
        Объект.Начало = Начало; Объект.ПрогнозОкончания = Прогноз; Объект.Восстановлено = Восстановлено; Объект.Состояние = Состояние; Объект.Записать();
        Результат = ДанныеОтключения(Объект); ДобавитьЗаписьИстории("Outage", Объект, "outage.save", "Internal", Лев(Причина, 250), Перед, Результат, УчетнаяЗапись, Ключ);
        ПолитикаДоступа.ЗаписатьСобытиеАудита(УчетнаяЗапись, Контекст.РабочееПространство, "dispatch.outage.save", Строка(Объект.Ссылка.УникальныйИдентификатор()), "success", Ключ);
        СохранитьПривязкуКоманды(Команда, "Outage", Объект.Ссылка, Результат); ЗафиксироватьТранзакцию();
    Исключение ОтменитьСобственнуюТранзакцию(); ВызватьИсключение; КонецПопытки;
    Возврат Результат;
КонецФункции

Функция УтвердитьОтключение(УчетнаяЗапись, Идентификатор, Тело, Ключ) Экспорт
    ПроверитьПоляТелаЗапроса(Тело, "expectedRevision,reason"); Причина = ТекстовоеПоле(Тело, "reason", 250);
    Ссылка = Справочники.ОтключенияВодоснабжения.ПолучитьСсылку(РазобратьИдентификатор(Идентификатор)); Предварительно = Ссылка.ПолучитьОбъект();
    Если Предварительно = Неопределено Тогда ВызватьИсключение "кабинет_диспетчерская_не_найдено"; КонецЕсли;
    Контекст = НачатьОперациюВОбласти(УчетнаяЗапись, Строка(Предварительно.РабочееПространство.УникальныйИдентификатор()), Строка(Предварительно.Область.УникальныйИдентификатор()), "Dispatcher");
    Попытка
        ЗаблокироватьОбъектПоСсылке("Справочник.ОтключенияВодоснабжения", Ссылка); Объект = Ссылка.ПолучитьОбъект(); ПроверитьДанныеЭлемента(Объект, Контекст.РабочееПространство, Контекст.Область);
        Команда = ОткрытьПривязкуКоманды(УчетнаяЗапись, Ключ, "outage.publish", КодироватьЗначение(Новый Структура("id,body", Идентификатор, Тело), 16000), Контекст.РабочееПространство, Контекст.Область);
        Если Команда.Выбран() Тогда Результат = ПовторНовойКоманды(Команда, "Outage", Объект);
        Иначе
            ПроверитьТекущуюРевизию(Объект, ПолеРевизии(Тело, "expectedRevision")); ПроверитьАдресаОтключения(СохраненныеАдреса(Объект.АдресаJSON), Контекст);
            Перед = ДанныеОтключения(Объект); УвеличитьРевизиюОбъекта(Объект);
            Объект.ОпубликованнаяРедакция = Объект.ОпубликованнаяРедакция + 1; Объект.ДатаУтверждения = ТекущаяУниверсальнаяДата(); Объект.УтвержденоКем = УчетнаяЗапись;
            Снимок = Новый Структура("id,type,reason,addresses,startedAt,expectedRestoredAt,restoredAt,updatedAt,waterPoints,state,revision",
                Идентификатор, Объект.ТипОтключения, Объект.Причина, СохраненныеАдреса(Объект.АдресаJSON), ПубличнаяДата(Объект.Начало), ПубличнаяДата(Объект.ПрогнозОкончания),
                ПубличнаяДата(Объект.Восстановлено), ПубличнаяДата(Объект.ДатаУтверждения), ДекодироватьЗначение(Объект.ТочкиПодвозаJSON), Объект.Состояние, Объект.ОпубликованнаяРедакция);
            Объект.ПубличныйСнимокJSON = КодироватьЗначение(Снимок, 16000); Объект.Записать();
            Результат = ДанныеОтключения(Объект); ДобавитьЗаписьИстории("Outage", Объект, "outage.publish", "Internal", Причина, Перед, Результат, УчетнаяЗапись, Ключ);
            ПолитикаДоступа.ЗаписатьСобытиеАудита(УчетнаяЗапись, Контекст.РабочееПространство, "dispatch.outage.publish", Строка(Объект.Ссылка.УникальныйИдентификатор()), "success", Ключ);
            УведомитьПодписчиковОтключения(Объект);
            СохранитьПривязкуКоманды(Команда, "Outage", Объект.Ссылка, Результат);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение ОтменитьСобственнуюТранзакцию(); ВызватьИсключение; КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПубличныеОтключения(Параметры) Экспорт
    Лимит = ЛимитДиспетчерской(Параметры); Адрес = ПараметрДиспетчерской(Параметры, "address"); Статус = ПараметрДиспетчерской(Параметры, "status");
    От = ПараметрДиспетчерской(Параметры, "from"); До = ПараметрДиспетчерской(Параметры, "to"); Курсор = ПараметрДиспетчерской(Параметры, "cursor");
    Если СтрДлина(Адрес) > 250 Или (Статус <> "" И СтрРазделить("active,planned,archived", ",").Найти(Статус) = Неопределено) Тогда ВызватьИсключение "кабинет_диспетчерская_некорректно_поле"; КонецЕсли;
    ДатаОт = Дата(1, 1, 1); ДатаДо = Дата(3999, 1, 1);
    Если От <> "" Тогда ДатаОт = ПолеДатыUTC(Новый Структура("date", От), "date"); КонецЕсли;
    Если До <> "" Тогда ДатаДо = ПолеДатыUTC(Новый Структура("date", До), "date"); КонецЕсли;
    Если ДатаОт >= ДатаДо Тогда ВызватьИсключение "кабинет_диспетчерская_некорректно_даты"; КонецЕсли;
    Префикс = "o2|" + ХешТекстаДиспетчерской(Адрес + "|" + Статус + "|" + От + "|" + До) + "|";
    Текст = "ВЫБРАТЬ Ссылка, ПубличныйСнимокJSON ИЗ Справочник.ОтключенияВодоснабжения ГДЕ ОпубликованнаяРедакция > 0 И НЕ ПометкаУдаления
        |И РабочееПространство.Состояние = ""Active"" И НЕ РабочееПространство.ПометкаУдаления И Область.Состояние = ""Active"" И НЕ Область.ПометкаУдаления";
    Запрос = Новый Запрос;
    Если Курсор <> "" Тогда
        Если Лев(Курсор, СтрДлина(Префикс)) <> Префикс Тогда ВызватьИсключение "кабинет_диспетчерская_некорректно_поле"; КонецЕсли;
        Текст = Текст + " И Ссылка > &После"; Запрос.УстановитьПараметр("После", Справочники.ОтключенияВодоснабжения.ПолучитьСсылку(РазобратьИдентификатор(Сред(Курсор, СтрДлина(Префикс) + 1))));
    КонецЕсли;
    Запрос.Текст = Текст + " УПОРЯДОЧИТЬ ПО Ссылка"; Выборка = Запрос.Выполнить().Выбрать(); Элементы = Новый Массив; ЕстьЕще = Ложь; Следующий = "";
    Пока Выборка.Следующий() Цикл
        Снимок = ДекодироватьСтруктуру(Выборка.ПубличныйСнимокJSON);
        Если Снимок.Количество() <> 11 Или Снимок.id <> Строка(Выборка.Ссылка.УникальныйИдентификатор()) Тогда ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт"; КонецЕсли;
        Если Адрес <> "" И Снимок.addresses.Найти(Адрес) = Неопределено Тогда Продолжить; КонецЕсли;
        Если (Статус = "active" И Снимок.state <> "Active") Или (Статус = "planned" И Снимок.state <> "Planned") Или (Статус = "archived" И Снимок.state <> "Restored") Тогда Продолжить; КонецЕсли;
        Начало = ПолеДатыUTC(Снимок, "startedAt");
        Если Начало < ДатаОт Или Начало >= ДатаДо Тогда Продолжить; КонецЕсли;
        Если Элементы.Количество() = Лимит Тогда ЕстьЕще = Истина; Прервать; КонецЕсли;
        Элементы.Добавить(Снимок); Следующий = Префикс + Снимок.id;
    КонецЦикла;
    Если Не ЕстьЕще Тогда Следующий = ""; КонецЕсли;
    Возврат Новый Структура("items,limit,hasMore,nextCursor,snapshotAt", Элементы, Лимит, ЕстьЕще, Следующий, ПубличнаяДата(ТекущаяУниверсальнаяДата()));
КонецФункции

Функция ПубличныеАдреса(Параметры) Экспорт
    Лимит = ЛимитДиспетчерской(Параметры); Поиск = ПараметрДиспетчерской(Параметры, "q"); Курсор = ПараметрДиспетчерской(Параметры, "cursor");
    Если СтрДлина(Поиск) > 250 Тогда ВызватьИсключение "кабинет_диспетчерская_некорректно_поле"; КонецЕсли;
    Префикс = "a1|" + ХешТекстаДиспетчерской(Поиск) + "|"; После = "";
    Если Курсор <> "" Тогда
        Если Лев(Курсор, СтрДлина(Префикс)) <> Префикс Тогда ВызватьИсключение "кабинет_диспетчерская_некорректно_поле"; КонецЕсли;
        После = Сред(Курсор, СтрДлина(Префикс) + 1); Если СтрДлина(После) > 250 Тогда ВызватьИсключение "кабинет_диспетчерская_некорректно_поле"; КонецЕсли;
    КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ АдресаJSON, ДатаОбновления ИЗ Справочник.ПубличныеПриемные ГДЕ Опубликована И НЕ ПометкаУдаления
        |И РабочееПространство.Состояние = ""Active"" И НЕ РабочееПространство.ПометкаУдаления И ОбластьПоУмолчанию.Состояние = ""Active"" И НЕ ОбластьПоУмолчанию.ПометкаУдаления
        |И ОбластьПоУмолчанию.РабочееПространство = РабочееПространство");
    Выборка = Запрос.Выполнить().Выбрать(); Адреса = Новый Соответствие;
    Пока Выборка.Следующий() Цикл
        Для Каждого Адрес Из СохраненныеАдреса(Выборка.АдресаJSON) Цикл
            Если Адрес <= После Или (Поиск <> "" И СтрНайти(НРег(Адрес), НРег(Поиск)) = 0) Тогда Продолжить; КонецЕсли;
            Текущий = Адреса.Получить(Адрес);
            Если Текущий = Неопределено Или Текущий < Выборка.ДатаОбновления Тогда Адреса.Вставить(Адрес, Выборка.ДатаОбновления); КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Таблица = Новый ТаблицаЗначений; Таблица.Колонки.Добавить("Адрес"); Таблица.Колонки.Добавить("Дата");
    Для Каждого Пара Из Адреса Цикл СтрокаТ = Таблица.Добавить(); СтрокаТ.Адрес = Пара.Ключ; СтрокаТ.Дата = Пара.Значение; КонецЦикла;
    Таблица.Сортировать("Адрес"); Элементы = Новый Массив; ЕстьЕще = Ложь; Следующий = "";
    Для Каждого СтрокаТ Из Таблица Цикл
        Если Элементы.Количество() = Лимит Тогда ЕстьЕще = Истина; Прервать; КонецЕсли;
        Элементы.Добавить(Новый Структура("address,updatedAt", СтрокаТ.Адрес, ПубличнаяДата(СтрокаТ.Дата))); Следующий = Префикс + СтрокаТ.Адрес;
    КонецЦикла;
    Если Не ЕстьЕще Тогда Следующий = ""; КонецЕсли;
    Возврат Новый Структура("items,limit,hasMore,nextCursor,snapshotAt", Элементы, Лимит, ЕстьЕще, Следующий, ПубличнаяДата(ТекущаяУниверсальнаяДата()));
КонецФункции

Функция НастроитьПодпискуОтключений(УчетнаяЗапись, Тело, Ключ) Экспорт
    ПроверитьПоляТелаЗапроса(Тело, "propertyId,enabled"); Включена = ЛогическоеПоле(Тело, "enabled");
    ОбъектСсылка = Справочники.ОбъектыНедвижимости.ПолучитьСсылку(РазобратьИдентификатор(ТекстовоеПоле(Тело, "propertyId", 36)));
    Предварительно = ОбъектСсылка.ПолучитьОбъект();
    Если Предварительно = Неопределено Тогда ВызватьИсключение "кабинет_диспетчерская_не_найдено"; КонецЕсли;
    Контекст = НачатьОперациюВОбласти(УчетнаяЗапись, Строка(Предварительно.РабочееПространство.УникальныйИдентификатор()), Строка(Предварительно.Область.УникальныйИдентификатор()), "");
    Попытка
        Объект = ДоступКЛицевымСчетам.ПроверитьВладельцаОбъекта(УчетнаяЗапись, ОбъектСсылка);
        Команда = ОткрытьПривязкуКоманды(УчетнаяЗапись, Ключ, "outage.subscribe", КодироватьЗначение(Тело, 16000), Контекст.РабочееПространство, Контекст.Область);
        Если Команда.Выбран() Тогда
            Если Команда.ВидСущности <> "Subscription" Или Команда.ИдентификаторСущности <> Тело.propertyId Тогда ВызватьИсключение "кабинет_диспетчерская_привязка_конфликт"; КонецЕсли;
            Результат = ДекодироватьСтруктуру(Команда.РезультатJSON); ЗафиксироватьТранзакцию(); Возврат Результат;
        КонецЕсли;
        Запись = РегистрыСведений.ПодпискиОтключений.СоздатьМенеджерЗаписи();
        Запись.УчетнаяЗапись = УчетнаяЗапись; Запись.ОбслуживаемыйОбъект = ОбъектСсылка; Запись.Прочитать();
        Запись.УчетнаяЗапись = УчетнаяЗапись; Запись.ОбслуживаемыйОбъект = ОбъектСсылка;
        Запись.РабочееПространство = Контекст.РабочееПространство; Запись.Область = Контекст.Область; Запись.Адрес = Объект.Адрес;
        Запись.Включена = Включена; Запись.ДатаОбновления = ТекущаяУниверсальнаяДата(); Запись.Записать();
        Результат = Новый Структура("id,propertyId,address,enabled,updatedAt,revision", Тело.propertyId, Тело.propertyId, Запись.Адрес, Включена, ПубличнаяДата(Запись.ДатаОбновления), 1);
        ПолитикаДоступа.ЗаписатьСобытиеАудита(УчетнаяЗапись, Контекст.РабочееПространство, "dispatch.outage.subscribe", Тело.propertyId, "success", Ключ);
        СохранитьПривязкуКоманды(Команда, "Subscription", ОбъектСсылка, Результат); ЗафиксироватьТранзакцию();
    Исключение ОтменитьСобственнуюТранзакцию(); ВызватьИсключение; КонецПопытки;
    Возврат Результат;
КонецФункции

Процедура УведомитьПодписчиковОтключения(Объект)
    Запрос = Новый Запрос("ВЫБРАТЬ УчетнаяЗапись, ОбслуживаемыйОбъект, Адрес ИЗ РегистрСведений.ПодпискиОтключений
        |ГДЕ РабочееПространство = &Пространство И Область = &Область И Включена");
    Запрос.УстановитьПараметр("Пространство", Объект.РабочееПространство); Запрос.УстановитьПараметр("Область", Объект.Область);
    Выборка = Запрос.Выполнить().Выбрать(); Адреса = СохраненныеАдреса(Объект.АдресаJSON);
    Пока Выборка.Следующий() Цикл
        Если Адреса.Найти(Выборка.Адрес) = Неопределено Тогда Продолжить; КонецЕсли;
        Если Не ДоступКЛицевымСчетам.ПолучательИмеетДоступКОбъекту(Объект.УтвержденоКем, Выборка.УчетнаяЗапись, Выборка.ОбслуживаемыйОбъект) Тогда Продолжить; КонецЕсли;
        Ид = Строка(Объект.Ссылка.УникальныйИдентификатор());
        СервисУведомлений.СоздатьСобытие(Выборка.УчетнаяЗапись, "outage", "outage:" + Ид + ":" + Формат(Объект.ОпубликованнаяРедакция, "ЧГ=0"), Ид, Объект.Состояние, Объект.РабочееПространство);
    КонецЦикла;
КонецПроцедуры

Функция ОбработатьЗапросКабинета(Действие, УчетнаяЗапись, Запрос, Корреляция) Экспорт
    КодОтвета = 200;
    Идентификатор = Запрос.ПараметрыURL.Получить("id"); Если Идентификатор = Неопределено Тогда Идентификатор = ""; КонецЕсли;
    Если Идентификатор = "" И (Действие = "p0DispatchSaveOutage" Или Действие = "p0DispatchSaveNetwork" Или Действие = "p0DispatchSaveNetworkLink") Тогда КодОтвета = 201; КонецЕсли;
    Если Действие = "p0DispatchPage" Тогда
        Результат = СтраницаДиспетчерской(УчетнаяЗапись, Запрос.ПараметрыURL.Получить("kind"), Запрос.ПараметрыЗапроса);
    ИначеЕсли Действие = "p0DispatchPublicIntakes" Тогда
        ПроверитьТекущегоУчастника(УчетнаяЗапись); Результат = ПубличныеПриемные(Запрос.ПараметрыЗапроса);
    ИначеЕсли Действие = "p0DispatchOwnGuestPhoto" Или Действие = "p0DispatchStaffGuestPhoto" Тогда
        Файл = ПолучитьГостевоеФото(УчетнаяЗапись, Идентификатор, Действие = "p0DispatchStaffGuestPhoto");
        Возврат APIКабинета.СформироватьОтветФайла(Файл, Корреляция);
    ИначеЕсли Действие = "p0DispatchOwnHistory" Или Действие = "p0DispatchStaffHistory" Тогда
        Результат = СписокЗаписейИсторииОбращения(УчетнаяЗапись, Идентификатор, Действие = "p0DispatchStaffHistory", ЛимитДиспетчерской(Запрос.ПараметрыЗапроса), ПараметрДиспетчерской(Запрос.ПараметрыЗапроса, "cursor"));
    ИначеЕсли Действие = "p0WorkCrewProfile" Тогда
        ВидПредставления = ПараметрДиспетчерской(Запрос.ПараметрыЗапроса, "view");
        Если ВидПредставления <> "" И ВидПредставления <> "history" Тогда ВызватьИсключение "кабинет_диспетчерская_некорректно_поле"; КонецЕсли;
        Результат = СервисНарядов.ПрочитатьПрофильБригады(УчетнаяЗапись, Идентификатор, ВидПредставления = "history",
            ЛимитДиспетчерской(Запрос.ПараметрыЗапроса), ПараметрДиспетчерской(Запрос.ПараметрыЗапроса, "cursor"));
    Иначе
        Тело = APIКабинета.РазобратьТелоЗапроса(Запрос);
        Ключ = APIКабинета.ЗаголовокЗапроса(Запрос, "Idempotency-Key"); РазобратьИдентификатор(Ключ);
        Если Действие = "p0DispatchClaimReceipt" Тогда Результат = ПрисоединитьГостевоеОбращение(УчетнаяЗапись, Идентификатор, Тело, Ключ);
        ИначеЕсли Действие = "p0DispatchSaveOutage" Тогда Результат = СохранитьОтключение(УчетнаяЗапись, Идентификатор, Тело, Ключ);
        ИначеЕсли Действие = "p0DispatchPublishOutage" Тогда Результат = УтвердитьОтключение(УчетнаяЗапись, Идентификатор, Тело, Ключ);
        ИначеЕсли Действие = "p0DispatchSaveNetwork" Тогда Результат = ЗаписатьСетевойОбъект(УчетнаяЗапись, Идентификатор, Тело, Ключ);
        ИначеЕсли Действие = "p0DispatchSaveNetworkLink" Тогда Результат = ЗаписатьСвязьСети(УчетнаяЗапись, Идентификатор, Тело, Ключ);
        ИначеЕсли Действие = "p0DispatchIncidentAsset" Тогда Результат = ПривязатьОбъектКИнциденту(УчетнаяЗапись, Идентификатор, Тело, Ключ);
        ИначеЕсли Действие = "p0DispatchSubscription" Тогда Результат = НастроитьПодпискуОтключений(УчетнаяЗапись, Тело, Ключ);
        ИначеЕсли Действие = "p0WorkSaveCrewProfile" Тогда Результат = СервисНарядов.ЗаписатьПрофильБригады(УчетнаяЗапись, Идентификатор, Тело, Ключ);
        Иначе ВызватьИсключение "кабинет_диспетчерская_некорректно_действие"; КонецЕсли;
    КонецЕсли;
    Возврат APIКабинета.СформироватьОтветHTTP(КодОтвета, Результат, Корреляция);
КонецФункции

Функция ОбработатьПубличныйЗапрос(Действие, Запрос, Корреляция, ИсточникХеш = "") Экспорт
    Если Действие = "publicDispatchIntakes" Тогда Результат = ПубличныеПриемные(Запрос.ПараметрыЗапроса);
    ИначеЕсли Действие = "publicDispatchAddresses" Тогда Результат = ПубличныеАдреса(Запрос.ПараметрыЗапроса);
    ИначеЕсли Действие = "publicDispatchOutages" Тогда Результат = ПубличныеОтключения(Запрос.ПараметрыЗапроса);
    ИначеЕсли Действие = "publicDispatchReceipt" Тогда
        Результат = СтатусГостевойКвитанции(Запрос.ПараметрыURL.Получить("id"), APIКабинета.ЗаголовокЗапроса(Запрос, "X-Receipt-Secret"));
    ИначеЕсли Действие = "publicDispatchHazard" Тогда
        Результат = СоздатьГостевоеОбращение(APIКабинета.РазобратьТелоЗапроса(Запрос, 7340032), APIКабинета.ЗаголовокЗапроса(Запрос, "Idempotency-Key"), ИсточникХеш);
    Иначе ВызватьИсключение "кабинет_диспетчерская_некорректно_действие"; КонецЕсли;
    Возврат APIКабинета.СформироватьОтветHTTP(?(Действие = "publicDispatchHazard", 201, 200), Результат, Корреляция);
КонецФункции

Функция ДанныеИнцидента(Объект)
    Результат = ОбщиеДанныеОбъекта(Объект);
    Результат.Вставить("title", Объект.Наименование);
    Результат.Вставить("type", Объект.ТипИнцидента);
    Результат.Вставить("severity", Объект.Тяжесть);
    Результат.Вставить("startedAt", XMLСтрока(Объект.ДатаФактическогоНачала) + "Z");
    Результат.Вставить("forecastAt", XMLСтрока(Объект.ПрогнозОкончания) + "Z");
    Результат.Вставить("resolvedAt", XMLСтрока(Объект.ДатаЗавершения) + "Z");
    Результат.Вставить("description", Объект.Подробности);
    Результат.Вставить("responsibleAccountId", Строка(Объект.Ответственный.УникальныйИдентификатор()));
    Результат.Вставить("state", Объект.Состояние);
    Результат.Вставить("networkAssetId", НеобязательныйИдентификатор(Объект.СетевойОбъект));
    Возврат Результат;
КонецФункции
