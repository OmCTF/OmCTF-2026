
Функция ПолучитьСправочники(УчетнаяЗапись) Экспорт
    ПроверитьУчастника(УчетнаяЗапись);
    Озера = Новый Массив;
    Для Каждого Код Из СтрРазделить("danilovo,lenyovo,shchuchye,shaitan,potaennoe", ",") Цикл
        Озера.Добавить(Новый Структура("code,name,public", Код, НазваниеОзера(Код), ПубличноеОзеро(Код)));
    КонецЦикла;
    Панели = Новый Массив;
    Панели.Добавить(Новый Структура("code,estimatedCost,indicatorCodes", "basic", 1000, СтрРазделить("ph,turbidity,appearance", ",")));
    Панели.Добавить(Новый Структура("code,estimatedCost,indicatorCodes", "extended", 1500, СтрРазделить("ph,turbidity,appearance,temperature", ",")));
    Показатели = Новый Массив;
    Для Каждого Код Из СтрРазделить("ph,turbidity,appearance,temperature", ",") Цикл
        Показатели.Добавить(ОписаниеПоказателя(Код));
    КонецЦикла;
    Возврат Новый Структура("dictionaryVersion,source,warning,lakes,waterTypes,places,collectionMethods,panels,indicators",
        "lab-demo-2026-01", "SPEC-6.8/demo-v1", УчебнаяМаркировка(), Озера, СтрРазделить("lake,tap,well", ","),
        СтрРазделить("shore,center,intake", ","), СтрРазделить("customer,courier", ","), Панели, Показатели);
КонецФункции

Функция УчебнаяМаркировка()
    Возврат "УЧЕБНЫЕ ДАННЫЕ: не реальные анализы, нормативы или медицинские рекомендации";
КонецФункции

Функция НазваниеОзера(Код)
    Если Код = "danilovo" Тогда Возврат "Данилово";
    ИначеЕсли Код = "lenyovo" Тогда Возврат "Ленёво";
    ИначеЕсли Код = "shchuchye" Тогда Возврат "Щучье";
    ИначеЕсли Код = "shaitan" Тогда Возврат "Шайтан";
    ИначеЕсли Код = "potaennoe" Тогда Возврат "Потаённое";
    КонецЕсли;
    ВызватьИсключение "кабинет_лаборатория_некорректно_справочник";
КонецФункции

Функция ПубличноеОзеро(Код)
    НазваниеОзера(Код);
    Возврат Код <> "potaennoe";
КонецФункции

Функция ОписаниеПоказателя(Код)
    Если Код = "ph" Тогда
        Возврат Новый Структура("code,kind,unit,method,min,max", Код, "decimal", "pH", "demo-ph-v1", "0", "14");
    ИначеЕсли Код = "turbidity" Тогда
        Возврат Новый Структура("code,kind,unit,method,min,max", Код, "decimal", "NTU", "demo-ntu-v1", "0", "10000");
    ИначеЕсли Код = "temperature" Тогда
        Возврат Новый Структура("code,kind,unit,method,min,max", Код, "decimal", "C", "demo-temp-v1", "-20", "100");
    ИначеЕсли Код = "appearance" Тогда
        Возврат Новый Структура("code,kind,unit,method,allowed", Код, "qualitative", "code", "demo-visual-v1", СтрРазделить("clear,turbid", ","));
    КонецЕсли;
    ВызватьИсключение "кабинет_лаборатория_некорректно_показатель";
КонецФункции

Процедура ПроверитьУчастника(УчетнаяЗапись)
    ТекущаяЗапись = ПолитикаДоступа.ПроверитьУчетнуюЗапись();
    Если ТипЗнч(УчетнаяЗапись) <> Тип("СправочникСсылка.УчетныеЗаписи") Или ТекущаяЗапись.Ссылка <> УчетнаяЗапись Тогда
        ВызватьИсключение "кабинет_участник_несовпадение";
    КонецЕсли;
КонецПроцедуры

Функция Идентификатор(Значение)
    Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) <> 36 Тогда
        ВызватьИсключение "кабинет_лаборатория_некорректно_идентификатор";
    КонецЕсли;
    Попытка
        Возврат Новый УникальныйИдентификатор(Значение);
    Исключение
        ВызватьИсключение "кабинет_лаборатория_некорректно_идентификатор";
    КонецПопытки;
КонецФункции

Функция СтрокаСсылки(Ссылка)
    Если Не ЗначениеЗаполнено(Ссылка) Тогда Возврат ""; КонецЕсли;
    Возврат Строка(Ссылка.УникальныйИдентификатор());
КонецФункции

Процедура ПроверитьПоля(Тело, Разрешенные)
    Если ТипЗнч(Тело) <> Тип("Структура") Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_тело"; КонецЕсли;
    Набор = СтрРазделить(Разрешенные, ",");
    Для Каждого Пара Из Тело Цикл
        Если Набор.Найти(Пара.Ключ) = Неопределено Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_поле"; КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция Текст(Тело, Поле, Максимум, Многострочный = Ложь)
    Значение = Неопределено;
    Если Не Тело.Свойство(Поле, Значение) Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_поле"; КонецЕсли;
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_поле"; КонецЕсли;
    Если СтрДлина(Значение) > Максимум Или ПустаяСтрока(СокрЛП(Значение)) Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_поле"; КонецЕсли;
    Для Позиция = 1 По СтрДлина(Значение) Цикл
        Код = КодСимвола(Значение, Позиция);
        Если Код < 32 И Не (Многострочный И (Код = 10 Или Код = 13)) Или Код = 127 Тогда
            ВызватьИсключение "кабинет_лаборатория_некорректно_поле";
        КонецЕсли;
    КонецЦикла;
    Возврат Значение;
КонецФункции

Функция КодИзПеречня(Тело, Поле, Перечень)
    Значение = Текст(Тело, Поле, 32);
    Если СтрРазделить(Перечень, ",").Найти(Значение) = Неопределено Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_поле"; КонецЕсли;
    Возврат Значение;
КонецФункции

Функция Ревизия(Тело, Поле = "expectedRevision")
    Значение = Неопределено;
    Если Не Тело.Свойство(Поле, Значение) Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_редакция"; КонецЕсли;
    Если ТипЗнч(Значение) <> Тип("Число") Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_редакция"; КонецЕсли;
    Если Значение < 0 Или Значение > 200 Или Окр(Значение, 0) <> Значение Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_редакция"; КонецЕсли;
    Возврат Значение;
КонецФункции

Функция СтрокаДатыUTC(Значение)
    Возврат XMLСтрока(Значение) + "Z";
КонецФункции

Функция ДатаИзСтроки(Значение)
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_дата"; КонецЕсли;
    Если СтрДлина(Значение) <> 20 Или Сред(Значение, 11, 1) <> "T" Или Прав(Значение, 1) <> "Z" Тогда
        ВызватьИсключение "кабинет_лаборатория_некорректно_дата";
    КонецЕсли;
    Для Позиция = 1 По 19 Цикл
        Знак = Сред(Значение, Позиция, 1);
        Если Позиция = 5 Или Позиция = 8 Тогда
            Если Знак <> "-" Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_дата"; КонецЕсли;
        ИначеЕсли Позиция = 14 Или Позиция = 17 Тогда
            Если Знак <> ":" Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_дата"; КонецЕсли;
        ИначеЕсли Позиция <> 11 И СтрНайти("0123456789", Знак) = 0 Тогда
            ВызватьИсключение "кабинет_лаборатория_некорректно_дата";
        КонецЕсли;
    КонецЦикла;
    Попытка
        Разобранный = XMLЗначение(Тип("Дата"), Лев(Значение, 19));
    Исключение
        ВызватьИсключение "кабинет_лаборатория_некорректно_дата";
    КонецПопытки;
    Если Разобранный = Дата(1, 1, 1) Или XMLСтрока(Разобранный) <> Лев(Значение, 19) Тогда
        ВызватьИсключение "кабинет_лаборатория_некорректно_дата";
    КонецЕсли;
    Возврат Разобранный;
КонецФункции

Функция ТочноеЧисло(Значение)
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_десятичное"; КонецЕсли;
    Цифры = Значение;
    Если Лев(Цифры, 1) = "-" Тогда Цифры = Сред(Цифры, 2); КонецЕсли;
    Части = СтрРазделить(Цифры, ".", Истина);
    Если Части.Количество() < 1 Или Части.Количество() > 2 Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_десятичное"; КонецЕсли;
    Если СтрДлина(Части[0]) < 1 Или СтрДлина(Части[0]) > 9 Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_десятичное"; КонецЕсли;
    Если СтрДлина(Части[0]) > 1 И Лев(Части[0], 1) = "0" Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_десятичное"; КонецЕсли;
    Если Части.Количество() = 2 Тогда
        Если СтрДлина(Части[1]) < 1 Или СтрДлина(Части[1]) > 6 Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_десятичное"; КонецЕсли;
    КонецЕсли;
    Для Позиция = 1 По СтрДлина(Цифры) Цикл
        Если СтрНайти("0123456789.", Сред(Цифры, Позиция, 1)) = 0 Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_десятичное"; КонецЕсли;
    КонецЦикла;
    Попытка
        ЧисловоеЗначение = XMLЗначение(Тип("Число"), Значение);
    Исключение
        ВызватьИсключение "кабинет_лаборатория_некорректно_десятичное";
    КонецПопытки;
    Если ЧисловоеЗначение = 0 И Лев(Значение, 1) = "-" Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_десятичное"; КонецЕсли;
    Возврат ЧисловоеЗначение;
КонецФункции

Процедура ЗаблокироватьСсылку(Пространство, Ссылка)
    Блокировка = Новый БлокировкаДанных;
    ЭлементБлокировки = Блокировка.Добавить(Пространство);
    ЭлементБлокировки.УстановитьЗначение("Ссылка", Ссылка);
    ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
КонецПроцедуры

Процедура ЗаблокироватьУчастников(УчетнаяЗапись, Назначаемый)
    Если Назначаемый = Неопределено Или Назначаемый = УчетнаяЗапись Тогда
        ЗаблокироватьСсылку("Справочник.УчетныеЗаписи", УчетнаяЗапись);
        Возврат;
    КонецЕсли;
    Если СтрокаСсылки(УчетнаяЗапись) < СтрокаСсылки(Назначаемый) Тогда
        ЗаблокироватьСсылку("Справочник.УчетныеЗаписи", УчетнаяЗапись);
        ЗаблокироватьСсылку("Справочник.УчетныеЗаписи", Назначаемый);
    Иначе
        ЗаблокироватьСсылку("Справочник.УчетныеЗаписи", Назначаемый);
        ЗаблокироватьСсылку("Справочник.УчетныеЗаписи", УчетнаяЗапись);
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьАктивнуюОбласть(Контекст)
    Пространство = Контекст.РабочееПространство.ПолучитьОбъект();
    Область = Контекст.Область.ПолучитьОбъект();
    Если Пространство = Неопределено Или Область = Неопределено Тогда ВызватьИсключение "кабинет_лаборатория_не_найдено"; КонецЕсли;
    Если Пространство.ПометкаУдаления Или Область.ПометкаУдаления Или Пространство.Состояние <> "Active"
        Или Область.Состояние <> "Active" Или Область.РабочееПространство <> Контекст.РабочееПространство Тогда
        ВызватьИсключение "кабинет_лаборатория_не_найдено";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьРоль(УчетнаяЗапись, Контекст, Роль)
    ПолитикаДоступа.ПроверитьДоступКОбласти(УчетнаяЗапись, СтрокаСсылки(Контекст.РабочееПространство), СтрокаСсылки(Контекст.Область), Роль);
КонецПроцедуры

Функция НачатьВОбласти(УчетнаяЗапись, ПространствоИд, ОбластьИд, Роль = "", Назначаемый = Неопределено)
    ПроверитьУчастника(УчетнаяЗапись);
    Если ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_лаборатория_вложенная_транзакция"; КонецЕсли;
    Контекст = Новый Структура("РабочееПространство,Область", Справочники.РабочиеПространства.ПолучитьСсылку(Идентификатор(ПространствоИд)), Справочники.Области.ПолучитьСсылку(Идентификатор(ОбластьИд)));
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьУчастников(УчетнаяЗапись, Назначаемый);
        ЗаблокироватьСсылку("Справочник.РабочиеПространства", Контекст.РабочееПространство);
        ЗаблокироватьСсылку("Справочник.Области", Контекст.Область);
        ПроверитьУчастника(УчетнаяЗапись);
        ПроверитьАктивнуюОбласть(Контекст);
        Если Роль <> "" Тогда ПроверитьРоль(УчетнаяЗапись, Контекст, Роль); КонецЕсли;
    Исключение
        ОтменитьОперацию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Контекст;
КонецФункции

Процедура ОтменитьОперацию()
    Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
КонецПроцедуры

Процедура ПроверитьОбъект(Объект, Контекст)
    Если Объект = Неопределено Тогда ВызватьИсключение "кабинет_лаборатория_не_найдено"; КонецЕсли;
    Если Объект.ПометкаУдаления Или Объект.РабочееПространство <> Контекст.РабочееПространство Или Объект.Область <> Контекст.Область Тогда
        ВызватьИсключение "кабинет_лаборатория_не_найдено";
    КонецЕсли;
КонецПроцедуры

Функция НачатьСЗаказом(УчетнаяЗапись, Ид, Роль = "", Назначаемый = Неопределено)
    ПроверитьУчастника(УчетнаяЗапись);
    Ссылка = Справочники.ЗаказыЛаборатории.ПолучитьСсылку(Идентификатор(Ид));
    Предварительный = Ссылка.ПолучитьОбъект();
    Если Предварительный = Неопределено Тогда ВызватьИсключение "кабинет_лаборатория_не_найдено"; КонецЕсли;
    Контекст = НачатьВОбласти(УчетнаяЗапись, СтрокаСсылки(Предварительный.РабочееПространство), СтрокаСсылки(Предварительный.Область), Роль, Назначаемый);
    Попытка
        ЗаблокироватьСсылку("Справочник.ЗаказыЛаборатории", Ссылка);
        Объект = Ссылка.ПолучитьОбъект();
        ПроверитьОбъект(Объект, Контекст);
        Контекст.Вставить("Заказ", Объект);
    Исключение
        ОтменитьОперацию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Контекст;
КонецФункции

Функция НачатьСПробой(УчетнаяЗапись, Ид, Роль = "", Назначаемый = Неопределено)
    ПроверитьУчастника(УчетнаяЗапись);
    Ссылка = Справочники.ПробыЛаборатории.ПолучитьСсылку(Идентификатор(Ид));
    Предварительный = Ссылка.ПолучитьОбъект();
    Если Предварительный = Неопределено Тогда ВызватьИсключение "кабинет_лаборатория_не_найдено"; КонецЕсли;
    Контекст = НачатьСЗаказом(УчетнаяЗапись, СтрокаСсылки(Предварительный.Заказ), Роль, Назначаемый);
    Попытка
        ЗаблокироватьСсылку("Справочник.ПробыЛаборатории", Ссылка);
        Проба = Ссылка.ПолучитьОбъект();
        ПроверитьОбъект(Проба, Контекст);
        Если Проба.Заказ <> Контекст.Заказ.Ссылка Или Проба.УчетнаяЗаписьВладельца <> Контекст.Заказ.УчетнаяЗаписьВладельца Тогда
            ВызватьИсключение "кабинет_лаборатория_не_найдено";
        КонецЕсли;
        Контекст.Вставить("Проба", Проба);
    Исключение
        ОтменитьОперацию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Контекст;
КонецФункции

Процедура ПроверитьВладельца(УчетнаяЗапись, Объект)
    Если Объект.УчетнаяЗаписьВладельца <> УчетнаяЗапись Тогда ВызватьИсключение "кабинет_лаборатория_не_найдено"; КонецЕсли;
КонецПроцедуры

Функция РольПредставления(Вид)
    Если Вид = "owner" Или Вид = "public" Тогда Возврат "";
    ИначеЕсли Вид = "technician" Тогда Возврат "LabTechnician";
    ИначеЕсли Вид = "approver" Тогда Возврат "LabApprover";
    КонецЕсли;
    ВызватьИсключение "кабинет_лаборатория_некорректно_просмотр";
КонецФункции

Процедура ПроверитьПредставление(УчетнаяЗапись, Контекст, Вид, ПубличноеРазрешено = Ложь)
    РольПредставления(Вид);
    Если Вид = "owner" Тогда
        ПроверитьВладельца(УчетнаяЗапись, Контекст.Заказ);
    ИначеЕсли Вид = "public" Тогда
        Если Не ПубличноеРазрешено Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_просмотр"; КонецЕсли;
        Если Не ПубличноеОзеро(Контекст.Проба.КодОзера) Тогда ВызватьИсключение "кабинет_лаборатория_не_найдено"; КонецЕсли;
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьНазначаемого(УчетнаяЗапись, Контекст)
    Объект = УчетнаяЗапись.ПолучитьОбъект();
    Если Объект = Неопределено Тогда ВызватьИсключение "кабинет_лаборатория_цель_запрещено"; КонецЕсли;
    Если Объект.ПометкаУдаления Или Объект.Состояние <> "Active" Тогда ВызватьИсключение "кабинет_лаборатория_цель_запрещено"; КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Участие.Ссылка КАК Ссылка ИЗ Справочник.Участия КАК Участие
        |ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПривязкиПользователей1С КАК Привязка
        |ПО Привязка.УчетнаяЗапись = Участие.УчетнаяЗапись
        |И Привязка.ИдентификаторПользователя1С = Участие.УчетнаяЗапись.ИдентификаторПользователя1С
        |ГДЕ Участие.УчетнаяЗапись = &УчетнаяЗапись И РабочееПространство = &РабочееПространство
        |И Роль = &Роль И Состояние = &Состояние И НЕ ПометкаУдаления
        |И (СрокИстечения = &ПустаяДата ИЛИ СрокИстечения > &Сейчас)
        |И ((ОхватОбластей = &Все И Область = &ПустаяОбласть)
        |ИЛИ (ОхватОбластей = &Одна И Область = &Область И НЕ Область.ПометкаУдаления И Область.Состояние = &Состояние))");
    Запрос.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
    Запрос.УстановитьПараметр("РабочееПространство", Контекст.РабочееПространство);
    Запрос.УстановитьПараметр("Область", Контекст.Область);
    Запрос.УстановитьПараметр("Роль", "LabTechnician");
    Запрос.УстановитьПараметр("Состояние", "Active");
    Запрос.УстановитьПараметр("ПустаяДата", Дата(1, 1, 1));
    Запрос.УстановитьПараметр("Сейчас", ТекущаяУниверсальнаяДата());
    Запрос.УстановитьПараметр("Все", "All");
    Запрос.УстановитьПараметр("Одна", "Area");
    Запрос.УстановитьПараметр("ПустаяОбласть", Справочники.Области.ПустаяСсылка());
    Если Запрос.Выполнить().Пустой() Тогда ВызватьИсключение "кабинет_лаборатория_цель_запрещено"; КонецЕсли;
КонецПроцедуры

Функция Кодировать(Значение, Максимум = 32768)
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Значение);
    Результат = Запись.Закрыть();
    Если СтрДлина(Результат) > Максимум Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_поле"; КонецЕсли;
    Возврат Результат;
КонецФункции

Функция Декодировать(СтрокаJSON)
    Чтение = Новый ЧтениеJSON;
    Попытка
        Чтение.УстановитьСтроку(СтрокаJSON);
        Результат = ПрочитатьJSON(Чтение);
        Чтение.Закрыть();
    Исключение
        Чтение.Закрыть(); ВызватьИсключение "кабинет_лаборатория_привязка_конфликт";
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция КаноническоеНамерение(Значение, Глубина = 0)
    Если Глубина > 5 Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_тело"; КонецЕсли;
    Если ТипЗнч(Значение) = Тип("Структура") Тогда
        Таблица = Новый ТаблицаЗначений;
        Таблица.Колонки.Добавить("Имя"); Таблица.Колонки.Добавить("Значение");
        Для Каждого Пара Из Значение Цикл
            СтрокаТаблицы = Таблица.Добавить(); СтрокаТаблицы.Имя = Пара.Ключ; СтрокаТаблицы.Значение = Пара.Значение;
        КонецЦикла;
        Таблица.Сортировать("Имя");
        Результат = Новый Структура;
        Для Каждого СтрокаТаблицы Из Таблица Цикл
            Результат.Вставить(СтрокаТаблицы.Имя, КаноническоеНамерение(СтрокаТаблицы.Значение, Глубина + 1));
        КонецЦикла;
        Возврат Результат;
    ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
        Результат = Новый Массив;
        Для Каждого Элемент Из Значение Цикл Результат.Добавить(КаноническоеНамерение(Элемент, Глубина + 1)); КонецЦикла;
        Возврат Результат;
    ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Или ТипЗнч(Значение) = Тип("Число") Или ТипЗнч(Значение) = Тип("Булево") Тогда
        Возврат Значение;
    КонецЕсли;
    ВызватьИсключение "кабинет_лаборатория_некорректно_тело";
КонецФункции

Функция ОткрытьКоманду(УчетнаяЗапись, Контекст, ЗапросИд, Операция, Цель, Тело)
    ЗапросИд = Строка(Идентификатор(ЗапросИд));
    Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
    Хеширование.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Кодировать(КаноническоеНамерение(Тело)), КодировкаТекста.UTF8, Ложь));
    Хеш = СтрЗаменить(СтрЗаменить(Base64Строка(Хеширование.ХешСумма), Символ(13), ""), Символ(10), "");
    Блокировка = Новый БлокировкаДанных;
    ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.КомандыЛаборатории");
    ЭлементБлокировки.УстановитьЗначение("УчетнаяЗапись", УчетнаяЗапись);
    ЭлементБлокировки.УстановитьЗначение("ИдентификаторЗапроса", ЗапросИд);
    ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный; Блокировка.Заблокировать();
    Команда = РегистрыСведений.КомандыЛаборатории.СоздатьМенеджерЗаписи();
    Команда.УчетнаяЗапись = УчетнаяЗапись; Команда.ИдентификаторЗапроса = ЗапросИд; Команда.Прочитать();
    Если Команда.Выбран() Тогда
        Если Команда.Операция <> Операция Или Команда.Цель <> Цель Или Команда.ХешНамерения <> Хеш
            Или Команда.РабочееПространство <> Контекст.РабочееПространство Или Команда.Область <> Контекст.Область Тогда
            ВызватьИсключение "кабинет_лаборатория_запрос_конфликт";
        КонецЕсли;
    Иначе
        Команда.УчетнаяЗапись = УчетнаяЗапись; Команда.ИдентификаторЗапроса = ЗапросИд;
        Команда.РабочееПространство = Контекст.РабочееПространство; Команда.Область = Контекст.Область;
        Команда.Операция = Операция; Команда.Цель = Цель; Команда.ХешНамерения = Хеш;
    КонецЕсли;
    Возврат Команда;
КонецФункции

Процедура РасходКвоты(ВидОбласти, ИдОбласти, ВидРасхода, Количество, Предел)
    Блокировка = Новый БлокировкаДанных;
    ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.КвотыЛаборатории");
    ЭлементБлокировки.УстановитьЗначение("ВидОбластиДействия", ВидОбласти);
    ЭлементБлокировки.УстановитьЗначение("ИдентификаторОбластиДействия", ИдОбласти);
    ЭлементБлокировки.УстановитьЗначение("ВидРасхода", ВидРасхода);
    ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный; Блокировка.Заблокировать();
    Запись = РегистрыСведений.КвотыЛаборатории.СоздатьМенеджерЗаписи();
    Запись.ВидОбластиДействия = ВидОбласти; Запись.ИдентификаторОбластиДействия = ИдОбласти; Запись.ВидРасхода = ВидРасхода;
    Запись.Прочитать(); Использовано = 0;
    Если Запись.Выбран() Тогда Использовано = Запись.Использовано; КонецЕсли;
    Если Использовано + Количество > Предел Тогда ВызватьИсключение "кабинет_лаборатория_квота_превышено"; КонецЕсли;
    Запись.ВидОбластиДействия = ВидОбласти; Запись.ИдентификаторОбластиДействия = ИдОбласти; Запись.ВидРасхода = ВидРасхода;
    Запись.Использовано = Использовано + Количество; Запись.Записать();
КонецПроцедуры

Процедура ЗавершитьКоманду(Команда, Контекст, Результат)
    РасходКвоты("Actor", СтрокаСсылки(Команда.УчетнаяЗапись), "Command", 1, 1000);
    РасходКвоты("Workspace", СтрокаСсылки(Контекст.РабочееПространство), "Command", 1, 10000);
    Команда.РезультатJSON = Кодировать(Результат);
    Команда.ДатаСоздания = ТекущаяУниверсальнаяДата(); Команда.Записать();
    ПолитикаДоступа.ЗаписатьСобытиеАудита(Команда.УчетнаяЗапись, Контекст.РабочееПространство, "lab." + Команда.Операция, Команда.Цель, "success", Команда.ИдентификаторЗапроса);
КонецПроцедуры

Функция ВыбратьПоляСнимка(Снимок, Поля)
    Если ТипЗнч(Снимок) <> Тип("Структура") Тогда ВызватьИсключение "кабинет_лаборатория_привязка_конфликт"; КонецЕсли;
    Результат = Новый Структура;
    Для Каждого ИмяПоля Из СтрРазделить(Поля, ",") Цикл
        Значение = Неопределено;
        Если Не Снимок.Свойство(ИмяПоля, Значение) Тогда ВызватьИсключение "кабинет_лаборатория_привязка_конфликт"; КонецЕсли;
        Если ТипЗнч(Значение) <> Тип("Строка") И ТипЗнч(Значение) <> Тип("Число") Тогда ВызватьИсключение "кабинет_лаборатория_привязка_конфликт"; КонецЕсли;
        Результат.Вставить(ИмяПоля, Значение);
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция ПоляПробы()
    Возврат "id,orderId,workspaceId,areaId,lakeCode,waterType,placeCode,source,location,collectedAt,conditions,panel,registrationNumber,clarification,lastReason,state,revision,createdAt,updatedAt,approvedVersion";
КонецФункции

Функция ПовторитьРезультат(Команда)
    Снимок = Декодировать(Команда.РезультатJSON);
    Если Команда.Операция = "private.save" Тогда
        Возврат ВыбратьПоляСнимка(Снимок, "sampleId,versionId,version,createdAt");
    ИначеЕсли Лев(Команда.Операция, 6) = "order." Тогда
        Результат = ВыбратьПоляСнимка(Снимок, "id,workspaceId,areaId,contact,collectionMethod,estimatedCost,state,revision,createdAt,updatedAt");
        Элементы = Неопределено;
        Если Не Снимок.Свойство("samples", Элементы) Тогда ВызватьИсключение "кабинет_лаборатория_привязка_конфликт"; КонецЕсли;
        Если ТипЗнч(Элементы) <> Тип("Массив") Или Элементы.Количество() > 5 Тогда ВызватьИсключение "кабинет_лаборатория_привязка_конфликт"; КонецЕсли;
        Пробы = Новый Массив;
        Для Каждого Элемент Из Элементы Цикл Пробы.Добавить(ВыбратьПоляСнимка(Элемент, ПоляПробы())); КонецЦикла;
        Результат.Вставить("samples", Пробы); Возврат Результат;
    КонецЕсли;
    Возврат ВыбратьПоляСнимка(Снимок, ПоляПробы());
КонецФункции

Функция ДанныеПробы(Проба)
    УтвержденнаяВерсия = 0;
    Если ЗначениеЗаполнено(Проба.УтвержденныйПротокол) Тогда УтвержденнаяВерсия = Проба.УтвержденныйПротокол.Версия; КонецЕсли;
    Возврат Новый Структура(ПоляПробы(), СтрокаСсылки(Проба.Ссылка), СтрокаСсылки(Проба.Заказ), СтрокаСсылки(Проба.РабочееПространство),
        СтрокаСсылки(Проба.Область), Проба.КодОзера, Проба.ТипВоды, Проба.КодМеста, Проба.Источник, Проба.МестоОтбора,
        СтрокаДатыUTC(Проба.ВремяОтбора), Проба.УсловияПриемки, Проба.Панель, Проба.РегистрационныйНомер, Проба.ПояснениеВладельца,
        Проба.ПоследняяПричина, Проба.Состояние, Проба.Ревизия, СтрокаДатыUTC(Проба.ДатаСоздания), СтрокаДатыUTC(Проба.ДатаИзменения), УтвержденнаяВерсия);
КонецФункции

Процедура СохранитьИсторию(УчетнаяЗапись, Контекст, Вид, Объект, Операция, Причина, Перед, После)
    Запись = РегистрыСведений.ИсторияЛаборатории.СоздатьМенеджерЗаписи();
    Запись.Вид = Вид; Запись.ИдентификаторСущности = СтрокаСсылки(Объект.Ссылка); Запись.Ревизия = Объект.Ревизия;
    Запись.Прочитать();
    Если Запись.Выбран() Тогда ВызватьИсключение "кабинет_лаборатория_привязка_конфликт"; КонецЕсли;
    Запись.Вид = Вид; Запись.ИдентификаторСущности = СтрокаСсылки(Объект.Ссылка); Запись.Ревизия = Объект.Ревизия;
    Запись.РабочееПространство = Контекст.РабочееПространство; Запись.Область = Контекст.Область;
    Запись.ДействующееЛицо = УчетнаяЗапись; Запись.Операция = Операция; Запись.Причина = Причина;
    Запись.ДатаИзменения = ТекущаяУниверсальнаяДата();
    Запись.СнимокДоJSON = Кодировать(Перед, 8192); Запись.СнимокПослеJSON = Кодировать(После, 8192); Запись.Записать();
КонецПроцедуры

Процедура ПроверитьСмену(Объект, ОжидаемаяРевизия)
    Если Объект.Ревизия <> ОжидаемаяРевизия Тогда ВызватьИсключение "кабинет_лаборатория_редакция_конфликт"; КонецЕсли;
    Если Объект.Ревизия >= 200 Тогда ВызватьИсключение "кабинет_лаборатория_квота_превышено"; КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьСменуПробы(УчетнаяЗапись, Контекст, Операция, Причина, Перед)
    Проба = Контекст.Проба;
    Проба.Ревизия = Проба.Ревизия + 1; Проба.ДатаИзменения = ТекущаяУниверсальнаяДата(); Проба.Записать();
    СохранитьИсторию(УчетнаяЗапись, Контекст, "Sample", Проба, Операция, Причина, Перед, ДанныеПробы(Проба));
КонецПроцедуры

Функция ПробыЗаказа(Заказ)
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 6 Ссылка ИЗ Справочник.ПробыЛаборатории ГДЕ Заказ = &Заказ УПОРЯДОЧИТЬ ПО Ссылка");
    Запрос.УстановитьПараметр("Заказ", Заказ.Ссылка);
    Выборка = Запрос.Выполнить().Выбрать(); Пробы = Новый Массив;
    Пока Выборка.Следующий() Цикл
        Если Пробы.Количество() = 5 Тогда ВызватьИсключение "кабинет_лаборатория_привязка_конфликт"; КонецЕсли;
        Проба = Выборка.Ссылка.ПолучитьОбъект();
        Если Проба = Неопределено Тогда ВызватьИсключение "кабинет_лаборатория_привязка_конфликт"; КонецЕсли;
        Если Проба.ПометкаУдаления Или Проба.РабочееПространство <> Заказ.РабочееПространство Или Проба.Область <> Заказ.Область
            Или Проба.УчетнаяЗаписьВладельца <> Заказ.УчетнаяЗаписьВладельца Тогда ВызватьИсключение "кабинет_лаборатория_привязка_конфликт"; КонецЕсли;
        Пробы.Добавить(Проба);
    КонецЦикла;
    Если Пробы.Количество() = 0 Тогда ВызватьИсключение "кабинет_лаборатория_привязка_конфликт"; КонецЕсли;
    Возврат Пробы;
КонецФункции

Функция ДанныеЗаказа(Заказ, СПробами = Истина)
    Результат = Новый Структура("id,workspaceId,areaId,contact,collectionMethod,estimatedCost,state,revision,createdAt,updatedAt",
        СтрокаСсылки(Заказ.Ссылка), СтрокаСсылки(Заказ.РабочееПространство), СтрокаСсылки(Заказ.Область), Заказ.Контакт,
        Заказ.СпособОтбора, Заказ.РасчетнаяСтоимость, Заказ.Состояние, Заказ.Ревизия, СтрокаДатыUTC(Заказ.ДатаСоздания), СтрокаДатыUTC(Заказ.ДатаИзменения));
    Если СПробами Тогда
        МассивПроб = Новый Массив;
        Для Каждого Проба Из ПробыЗаказа(Заказ) Цикл МассивПроб.Добавить(ДанныеПробы(Проба)); КонецЦикла;
        Результат.Вставить("samples", МассивПроб);
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ПроверитьНовыеПробы(Тело)
    Пробы = Неопределено;
    Если Не Тело.Свойство("samples", Пробы) Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_пробы"; КонецЕсли;
    Если ТипЗнч(Пробы) <> Тип("Массив") Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_пробы"; КонецЕсли;
    Если Пробы.Количество() < 1 Или Пробы.Количество() > 5 Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_пробы"; КонецЕсли;
    Стоимость = 0;
    Для Каждого Проба Из Пробы Цикл
        ПроверитьПоля(Проба, "lakeCode,waterType,placeCode,source,location,collectedAt,conditions,panel");
        НазваниеОзера(Текст(Проба, "lakeCode", 24));
        КодИзПеречня(Проба, "waterType", "lake,tap,well"); КодИзПеречня(Проба, "placeCode", "shore,center,intake");
        Текст(Проба, "source", 250); Текст(Проба, "location", 250); Текст(Проба, "conditions", 500, Истина);
        ДатаИзСтроки(Текст(Проба, "collectedAt", 20));
        Панель = КодИзПеречня(Проба, "panel", "basic,extended");
        Стоимость = Стоимость + ?(Панель = "basic", 1000, 1500);
    КонецЦикла;
    Возврат Новый Структура("Пробы,Стоимость", Пробы, Стоимость);
КонецФункции

Функция СоздатьЗаказ(УчетнаяЗапись, Тело, ЗапросИд) Экспорт
    ПроверитьУчастника(УчетнаяЗапись);
    ПроверитьПоля(Тело, "workspaceId,areaId,contact,collectionMethod,samples");
    ПространствоИд = Текст(Тело, "workspaceId", 36); ОбластьИд = Текст(Тело, "areaId", 36);
    Контакт = Текст(Тело, "contact", 128);
    Для Позиция = 1 По СтрДлина(Контакт) Цикл
        Если КодСимвола(Контакт, Позиция) > 126 Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_контакт"; КонецЕсли;
    КонецЦикла;
    Способ = КодИзПеречня(Тело, "collectionMethod", "customer,courier");
    Данные = ПроверитьНовыеПробы(Тело);
    Контекст = НачатьВОбласти(УчетнаяЗапись, ПространствоИд, ОбластьИд);
    Попытка
        ПроверитьРоль(УчетнаяЗапись, Контекст, "");
        Команда = ОткрытьКоманду(УчетнаяЗапись, Контекст, ЗапросИд, "order.create", СтрокаСсылки(Контекст.РабочееПространство), Тело);
        Если Команда.Выбран() Тогда
            Результат = ПовторитьРезультат(Команда);
        Иначе
            Для Каждого Вход Из Данные.Пробы Цикл
                ВремяОтбора = ДатаИзСтроки(Вход.collectedAt);
                Если ВремяОтбора < Дата(2000, 1, 1) Или ВремяОтбора > ТекущаяУниверсальнаяДата() Тогда
                    ВызватьИсключение "кабинет_лаборатория_некорректно_забор_время";
                КонецЕсли;
            КонецЦикла;
            РасходКвоты("Actor", СтрокаСсылки(УчетнаяЗапись), "Order", 1, 100);
            РасходКвоты("Workspace", СтрокаСсылки(Контекст.РабочееПространство), "Order", 1, 1000);
            РасходКвоты("Actor", СтрокаСсылки(УчетнаяЗапись), "Sample", Данные.Пробы.Количество(), 500);
            РасходКвоты("Workspace", СтрокаСсылки(Контекст.РабочееПространство), "Sample", Данные.Пробы.Количество(), 5000);
            Сейчас = ТекущаяУниверсальнаяДата();
            Заказ = Справочники.ЗаказыЛаборатории.СоздатьЭлемент();
            Заказ.SetNewObjectRef(Справочники.ЗаказыЛаборатории.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
            Заказ.РабочееПространство = Контекст.РабочееПространство; Заказ.Область = Контекст.Область;
            Заказ.УчетнаяЗаписьВладельца = УчетнаяЗапись; Заказ.Контакт = Контакт; Заказ.СпособОтбора = Способ;
            Заказ.РасчетнаяСтоимость = Данные.Стоимость; Заказ.Состояние = "Draft"; Заказ.Ревизия = 1;
            Заказ.ДатаСоздания = Сейчас; Заказ.ДатаИзменения = Сейчас; Заказ.Наименование = "Учебный заказ лаборатории"; Заказ.Записать();
            Для Каждого Вход Из Данные.Пробы Цикл
                Проба = Справочники.ПробыЛаборатории.СоздатьЭлемент();
                Проба.РабочееПространство = Контекст.РабочееПространство; Проба.Область = Контекст.Область;
                Проба.Заказ = Заказ.Ссылка; Проба.УчетнаяЗаписьВладельца = УчетнаяЗапись;
                Проба.КодОзера = Вход.lakeCode; Проба.ТипВоды = Вход.waterType; Проба.КодМеста = Вход.placeCode;
                Проба.Источник = Вход.source; Проба.МестоОтбора = Вход.location; Проба.ВремяОтбора = ДатаИзСтроки(Вход.collectedAt);
                Проба.УсловияПриемки = Вход.conditions; Проба.Панель = Вход.panel;
                Проба.Состояние = "Draft"; Проба.Ревизия = 1; Проба.ПоследняяВерсия = 0;
                Проба.ДатаСоздания = Сейчас; Проба.ДатаИзменения = Сейчас; Проба.Наименование = "Учебная проба";
                ИдентификаторНовойПробы = СервисДокументов.НовыйUUIDv4();
                Проба.УстановитьСсылкуНового(Справочники.ПробыЛаборатории.ПолучитьСсылку(ИдентификаторНовойПробы));
                Проба.РегистрационныйНомер = "ЛБ-" + Строка(ИдентификаторНовойПробы); Проба.Записать();
                СохранитьИсторию(УчетнаяЗапись, Контекст, "Sample", Проба, "sample.create", "Создание пробы", Новый Структура, ДанныеПробы(Проба));
            КонецЦикла;
            Результат = ДанныеЗаказа(Заказ);
            СохранитьИсторию(УчетнаяЗапись, Контекст, "Order", Заказ, "order.create", "Создание заказа", Новый Структура, ДанныеЗаказа(Заказ, Ложь));
            ЗавершитьКоманду(Команда, Контекст, Результат);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьОперацию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПолучитьЗаказ(УчетнаяЗапись, Ид, Вид = "owner") Экспорт
    Если Вид = "public" Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_просмотр"; КонецЕсли;
    Контекст = НачатьСЗаказом(УчетнаяЗапись, Ид, РольПредставления(Вид));
    Попытка
        ПроверитьПредставление(УчетнаяЗапись, Контекст, Вид);
        Результат = ДанныеЗаказа(Контекст.Заказ); ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьОперацию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПолучитьПробу(УчетнаяЗапись, Ид, Вид = "owner") Экспорт
    Если Вид = "public" Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_просмотр"; КонецЕсли;
    Контекст = НачатьСПробой(УчетнаяЗапись, Ид, РольПредставления(Вид));
    Попытка
        ПроверитьПредставление(УчетнаяЗапись, Контекст, Вид);
        Результат = ДанныеПробы(Контекст.Проба);
        Если Вид <> "owner" Тогда
            Результат.Вставить("technicianAccountId", СтрокаСсылки(Контекст.Проба.НазначенныйЛаборант));
            Результат.Вставить("currentProtocolId", СтрокаСсылки(Контекст.Проба.ТекущийПротокол));
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьОперацию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ИзменитьЗаказ(УчетнаяЗапись, Ид, Действие, Тело, ЗапросИд) Экспорт
    Если Действие <> "submit" И Действие <> "cancel" Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_действие"; КонецЕсли;
    ПроверитьПоля(Тело, "expectedRevision,reason"); Ожидаемая = Ревизия(Тело); Причина = Текст(Тело, "reason", 500);
    Контекст = НачатьСЗаказом(УчетнаяЗапись, Ид);
    Попытка
        Заказ = Контекст.Заказ; ПроверитьВладельца(УчетнаяЗапись, Заказ);
        Команда = ОткрытьКоманду(УчетнаяЗапись, Контекст, ЗапросИд, "order." + Действие, СтрокаСсылки(Заказ.Ссылка), Тело);
        Если Команда.Выбран() Тогда
            Результат = ПовторитьРезультат(Команда);
        Иначе
            ПроверитьСмену(Заказ, Ожидаемая);
            Если Действие = "submit" И Заказ.Состояние <> "Draft" Или Действие = "cancel" И Заказ.Состояние <> "Draft" И Заказ.Состояние <> "Submitted" Тогда
                ВызватьИсключение "кабинет_лаборатория_состояние_конфликт";
            КонецЕсли;
            Перед = ДанныеЗаказа(Заказ, Ложь);
            Для Каждого Проба Из ПробыЗаказа(Заказ) Цикл
                ЗаблокироватьСсылку("Справочник.ПробыЛаборатории", Проба.Ссылка);
                Проба = Проба.Ссылка.ПолучитьОбъект(); ПроверитьОбъект(Проба, Контекст);
                Если Действие = "submit" И Проба.Состояние <> "Draft" Или Действие = "cancel" И СтрРазделить("Draft,Submitted,NeedsInfo", ",").Найти(Проба.Состояние) = Неопределено Тогда
                    ВызватьИсключение "кабинет_лаборатория_состояние_конфликт";
                КонецЕсли;
                ПроверитьСмену(Проба, Проба.Ревизия); ПередПроба = ДанныеПробы(Проба);
                Проба.Состояние = ?(Действие = "submit", "Submitted", "Rejected"); Проба.ПоследняяПричина = Причина;
                Контекст.Вставить("Проба", Проба); ЗаписатьСменуПробы(УчетнаяЗапись, Контекст, "order." + Действие, Причина, ПередПроба);
            КонецЦикла;
            Заказ.Состояние = ?(Действие = "submit", "Submitted", "Cancelled"); Заказ.Ревизия = Заказ.Ревизия + 1;
            Заказ.ДатаИзменения = ТекущаяУниверсальнаяДата(); Заказ.Записать();
            СохранитьИсторию(УчетнаяЗапись, Контекст, "Order", Заказ, "order." + Действие, Причина, Перед, ДанныеЗаказа(Заказ, Ложь));
            Результат = ДанныеЗаказа(Заказ); ЗавершитьКоманду(Команда, Контекст, Результат);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьОперацию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ИзменитьПробу(УчетнаяЗапись, Ид, Действие, Тело, ЗапросИд) Экспорт
    Если СтрРазделить("register,reject,ask-info,assign,start-analysis,answer,archive,correct", ",").Найти(Действие) = Неопределено Тогда
        ВызватьИсключение "кабинет_лаборатория_некорректно_действие";
    КонецЕсли;
    ПроверитьПоля(Тело, ?(Действие = "assign", "expectedRevision,reason,technicianAccountId", "expectedRevision,reason"));
    Ожидаемая = Ревизия(Тело); Причина = Текст(Тело, "reason", 500);
    Назначаемый = Неопределено;
    Если Действие = "assign" Тогда Назначаемый = Справочники.УчетныеЗаписи.ПолучитьСсылку(Идентификатор(Текст(Тело, "technicianAccountId", 36))); КонецЕсли;
    Роль = ?(Действие = "answer", "", "LabTechnician");
    Контекст = НачатьСПробой(УчетнаяЗапись, Ид, Роль, Назначаемый);
    Попытка
        Проба = Контекст.Проба;
        Если Действие = "answer" Тогда ПроверитьВладельца(УчетнаяЗапись, Проба); КонецЕсли;
        Если Действие = "start-analysis" Тогда
            Если Проба.НазначенныйЛаборант <> УчетнаяЗапись Тогда ВызватьИсключение "кабинет_лаборатория_не_найдено"; КонецЕсли;
        КонецЕсли;
        Команда = ОткрытьКоманду(УчетнаяЗапись, Контекст, ЗапросИд, "sample." + Действие, СтрокаСсылки(Проба.Ссылка), Тело);
        Если Команда.Выбран() Тогда
            Результат = ПовторитьРезультат(Команда);
        Иначе
            ПроверитьСмену(Проба, Ожидаемая); Перед = ДанныеПробы(Проба);
            Если Действие = "register" Тогда
                Если Проба.Состояние <> "Submitted" Тогда ВызватьИсключение "кабинет_лаборатория_состояние_конфликт"; КонецЕсли;
                Проба.Состояние = "Registered";
            ИначеЕсли Действие = "reject" Или Действие = "ask-info" Тогда
                Если Проба.Состояние <> "Submitted" И Проба.Состояние <> "Registered" Тогда ВызватьИсключение "кабинет_лаборатория_состояние_конфликт"; КонецЕсли;
                Проба.Состояние = ?(Действие = "reject", "Rejected", "NeedsInfo");
            ИначеЕсли Действие = "answer" Тогда
                Если Проба.Состояние <> "NeedsInfo" Тогда ВызватьИсключение "кабинет_лаборатория_состояние_конфликт"; КонецЕсли;
                Проба.ПояснениеВладельца = Причина; Проба.Состояние = "Submitted";
            ИначеЕсли Действие = "assign" Тогда
                Если Проба.Состояние <> "Registered" Тогда ВызватьИсключение "кабинет_лаборатория_состояние_конфликт"; КонецЕсли;
                ПроверитьНазначаемого(Назначаемый, Контекст); Проба.НазначенныйЛаборант = Назначаемый;
            ИначеЕсли Действие = "start-analysis" Тогда
                Если Проба.Состояние <> "Registered" Тогда ВызватьИсключение "кабинет_лаборатория_состояние_конфликт"; КонецЕсли;
                Проба.Состояние = "InAnalysis";
            ИначеЕсли Действие = "archive" Тогда
                Если Проба.Состояние <> "Approved" Тогда ВызватьИсключение "кабинет_лаборатория_состояние_конфликт"; КонецЕсли;
                Проба.Состояние = "Archived";
            ИначеЕсли Действие = "correct" Тогда
                Если Проба.Состояние <> "Approved" И Проба.Состояние <> "Archived" Тогда ВызватьИсключение "кабинет_лаборатория_состояние_конфликт"; КонецЕсли;
                Если Проба.ПоследняяВерсия >= 20 Тогда ВызватьИсключение "кабинет_лаборатория_квота_превышено"; КонецЕсли;
                Проба.НазначенныйЛаборант = УчетнаяЗапись; Проба.Состояние = "InAnalysis";
            КонецЕсли;
            Проба.ПоследняяПричина = Причина; ЗаписатьСменуПробы(УчетнаяЗапись, Контекст, "sample." + Действие, Причина, Перед);
            Результат = ДанныеПробы(Проба); ЗавершитьКоманду(Команда, Контекст, Результат);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьОперацию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПроверитьИзмерения(Тело, Панель)
    Значения = Неопределено;
    Если Не Тело.Свойство("values", Значения) Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_значения"; КонецЕсли;
    Если ТипЗнч(Значения) <> Тип("Массив") Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_значения"; КонецЕсли;
    Ожидаемые = СтрРазделить(?(Панель = "basic", "ph,turbidity,appearance", "ph,turbidity,appearance,temperature"), ",");
    Если Значения.Количество() <> Ожидаемые.Количество() Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_значения"; КонецЕсли;
    Проверенные = Новый Соответствие;
    Для Каждого Элемент Из Значения Цикл
        ПроверитьПоля(Элемент, "indicatorCode,value");
        Код = Текст(Элемент, "indicatorCode", 32); Значение = Текст(Элемент, "value", 32);
        Если Ожидаемые.Найти(Код) = Неопределено Или Проверенные.Получить(Код) <> Неопределено Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_значения"; КонецЕсли;
        Описание = ОписаниеПоказателя(Код);
        Если Описание.kind = "decimal" Тогда
            ЧисловоеЗначение = ТочноеЧисло(Значение);
            Если ЧисловоеЗначение < ТочноеЧисло(Описание.min) Или ЧисловоеЗначение > ТочноеЧисло(Описание.max) Тогда
                ВызватьИсключение "кабинет_лаборатория_значение_вне_из_диапазон";
            КонецЕсли;
        ИначеЕсли Описание.allowed.Найти(Значение) = Неопределено Тогда
            ВызватьИсключение "кабинет_лаборатория_некорректно_качественный";
        КонецЕсли;
        Проверенные.Вставить(Код, Новый Структура("indicatorCode,value,kind,unit,method", Код, Значение, Описание.kind, Описание.unit, Описание.method));
    КонецЦикла;
    Возврат Проверенные;
КонецФункции

Функция ПодатьРезультаты(УчетнаяЗапись, Ид, Тело, ЗапросИд) Экспорт
    ПроверитьПоля(Тело, "expectedRevision,comment,values"); Ожидаемая = Ревизия(Тело); Комментарий = Текст(Тело, "comment", 500, Истина);
    Контекст = НачатьСПробой(УчетнаяЗапись, Ид, "LabTechnician");
    Попытка
        Проба = Контекст.Проба;
        Если Проба.НазначенныйЛаборант <> УчетнаяЗапись Тогда ВызватьИсключение "кабинет_лаборатория_не_найдено"; КонецЕсли;
        Команда = ОткрытьКоманду(УчетнаяЗапись, Контекст, ЗапросИд, "sample.results", СтрокаСсылки(Проба.Ссылка), Тело);
        Если Команда.Выбран() Тогда
            Результат = ПовторитьРезультат(Команда);
        Иначе
            ПроверитьСмену(Проба, Ожидаемая);
            Если Проба.Состояние <> "InAnalysis" Тогда ВызватьИсключение "кабинет_лаборатория_состояние_конфликт"; КонецЕсли;
            Если Проба.ПоследняяВерсия >= 20 Тогда ВызватьИсключение "кабинет_лаборатория_квота_превышено"; КонецЕсли;
            Измерения = ПроверитьИзмерения(Тело, Проба.Панель); Перед = ДанныеПробы(Проба);
            Редакция = Справочники.РедакцииЛабораторныхПротоколов.СоздатьЭлемент();
            Редакция.SetNewObjectRef(Справочники.РедакцииЛабораторныхПротоколов.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
            Редакция.РабочееПространство = Контекст.РабочееПространство; Редакция.Область = Контекст.Область;
            Редакция.Проба = Проба.Ссылка; Редакция.Версия = Проба.ПоследняяВерсия + 1; Редакция.АвторВвода = УчетнаяЗапись;
            Личность = ПолитикаДоступа.НативнаяИдентичность(); Редакция.ИдентификаторАвтораВвода = Личность.nativeUserId;
            Редакция.ПредыдущийУтвержденный = Проба.УтвержденныйПротокол;
            Редакция.ПричинаИсправления = ?(ЗначениеЗаполнено(Проба.УтвержденныйПротокол), Проба.ПоследняяПричина, "");
            Редакция.Комментарий = Комментарий; Редакция.ВерсияСправочника = "lab-demo-2026-01";
            Редакция.Состояние = "Review"; Редакция.ДатаСоздания = ТекущаяУниверсальнаяДата();
            Редакция.Наименование = "Учебный протокол " + Строка(Редакция.Версия); Редакция.Записать();
            Для Каждого Пара Из Измерения Цикл
                Измерение = Пара.Значение;
                Запись = РегистрыСведений.ИзмеренияРедакцийПротоколов.СоздатьМенеджерЗаписи();
                Запись.Редакция = Редакция.Ссылка; Запись.КодПоказателя = Измерение.indicatorCode;
                Запись.ЗначениеТекстом = Измерение.value; Запись.ВидЗначения = Измерение.kind;
                Запись.Единица = Измерение.unit; Запись.Метод = Измерение.method; Запись.Записать();
            КонецЦикла;
            Проба.ТекущийПротокол = Редакция.Ссылка; Проба.ПоследняяВерсия = Редакция.Версия; Проба.Состояние = "Review";
            ЗаписатьСменуПробы(УчетнаяЗапись, Контекст, "sample.results", "Результаты переданы на независимую проверку", Перед);
            Результат = ДанныеПробы(Проба); ЗавершитьКоманду(Команда, Контекст, Результат);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьОперацию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция РешениеПоПротоколу(УчетнаяЗапись, Ид, Действие, Тело, ЗапросИд) Экспорт
    Если Действие <> "approve" И Действие <> "rework" Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_действие"; КонецЕсли;
    ПроверитьПоля(Тело, "expectedRevision,reason"); Ожидаемая = Ревизия(Тело); Причина = Текст(Тело, "reason", 500);
    Контекст = НачатьСПробой(УчетнаяЗапись, Ид, "LabApprover");
    Попытка
        Проба = Контекст.Проба;
        Команда = ОткрытьКоманду(УчетнаяЗапись, Контекст, ЗапросИд, "sample." + Действие, СтрокаСсылки(Проба.Ссылка), Тело);
        Если Команда.Выбран() Тогда
            Результат = ПовторитьРезультат(Команда);
        Иначе
            ПроверитьСмену(Проба, Ожидаемая);
            Если Проба.Состояние <> "Review" Или Не ЗначениеЗаполнено(Проба.ТекущийПротокол) Тогда ВызватьИсключение "кабинет_лаборатория_состояние_конфликт"; КонецЕсли;
            ЗаблокироватьСсылку("Справочник.РедакцииЛабораторныхПротоколов", Проба.ТекущийПротокол);
            Редакция = Проба.ТекущийПротокол.ПолучитьОбъект(); ПроверитьОбъект(Редакция, Контекст);
            Если Редакция.Проба <> Проба.Ссылка Или Редакция.Состояние <> "Review" Тогда ВызватьИсключение "кабинет_лаборатория_привязка_конфликт"; КонецЕсли;
            Личность = ПолитикаДоступа.НативнаяИдентичность();
            Если Редакция.АвторВвода = УчетнаяЗапись Или Редакция.ИдентификаторАвтораВвода = Личность.nativeUserId Тогда
                ВызватьИсключение "кабинет_лаборатория_независимый_утверждение_требуется";
            КонецЕсли;
            Перед = ДанныеПробы(Проба);
            Если Действие = "approve" Тогда
                Редакция.Состояние = "Approved"; Редакция.Утвердивший = УчетнаяЗапись;
                Редакция.ИдентификаторУтвердившего = Личность.nativeUserId;
                Редакция.ДатаУтверждения = ТекущаяУниверсальнаяДата(); Проба.Состояние = "Approved";
                Проба.УтвержденныйПротокол = Редакция.Ссылка;
            Иначе
                Редакция.Состояние = "Reworked"; Проба.Состояние = "InAnalysis";
            КонецЕсли;
            Редакция.Записать(); Проба.ПоследняяПричина = Причина;
            ЗаписатьСменуПробы(УчетнаяЗапись, Контекст, "sample." + Действие, Причина, Перед);
            Результат = ДанныеПробы(Проба); ЗавершитьКоманду(Команда, Контекст, Результат);
            Если Действие = "approve" Тогда
                СервисУведомлений.СоздатьСобытие(Проба.УчетнаяЗаписьВладельца, "result", "lab-approved:" + СтрокаСсылки(Редакция.Ссылка), СтрокаСсылки(Проба.Ссылка), "Approved", Проба.РабочееПространство);
            КонецЕсли;
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьОперацию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ИзмеренияПротокола(Редакция, Панель)
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 9 КодПоказателя, ЗначениеТекстом, ВидЗначения, Единица, Метод
        |ИЗ РегистрСведений.ИзмеренияРедакцийПротоколов ГДЕ Редакция = &Редакция УПОРЯДОЧИТЬ ПО КодПоказателя");
    Запрос.УстановитьПараметр("Редакция", Редакция.Ссылка); Выборка = Запрос.Выполнить().Выбрать();
    Результат = Новый Массив; Проверка = Новый Массив;
    Пока Выборка.Следующий() Цикл
        Если Результат.Количество() = 8 Тогда ВызватьИсключение "кабинет_лаборатория_привязка_конфликт"; КонецЕсли;
        Описание = ОписаниеПоказателя(Выборка.КодПоказателя);
        Если Выборка.Единица <> Описание.unit Или Выборка.Метод <> Описание.method Или Выборка.ВидЗначения <> Описание.kind Тогда
            ВызватьИсключение "кабинет_лаборатория_привязка_конфликт";
        КонецЕсли;
        Результат.Добавить(Новый Структура("indicatorCode,value,kind,unit,method", Выборка.КодПоказателя, Выборка.ЗначениеТекстом, Выборка.ВидЗначения, Выборка.Единица, Выборка.Метод));
        Проверка.Добавить(Новый Структура("indicatorCode,value", Выборка.КодПоказателя, Выборка.ЗначениеТекстом));
    КонецЦикла;
    ПроверитьИзмерения(Новый Структура("values", Проверка), Панель);
    Возврат Результат;
КонецФункции

Функция НайтиРедакцию(Проба, Версия, Вид)
    Если ТипЗнч(Версия) <> Тип("Число") Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_версия"; КонецЕсли;
    Если Версия < 0 Или Версия > 20 Или Окр(Версия, 0) <> Версия Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_версия"; КонецЕсли;
    Если Версия = 0 Тогда
        Ссылка = ?(Вид = "owner" Или Вид = "public", Проба.УтвержденныйПротокол, Проба.ТекущийПротокол);
        Если Не ЗначениеЗаполнено(Ссылка) Тогда ВызватьИсключение "кабинет_лаборатория_не_найдено"; КонецЕсли;
    Иначе
        Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2 Ссылка ИЗ Справочник.РедакцииЛабораторныхПротоколов ГДЕ Проба = &Проба И Версия = &Версия УПОРЯДОЧИТЬ ПО Ссылка");
        Запрос.УстановитьПараметр("Проба", Проба.Ссылка); Запрос.УстановитьПараметр("Версия", Версия);
        Выборка = Запрос.Выполнить().Выбрать();
        Если Не Выборка.Следующий() Тогда ВызватьИсключение "кабинет_лаборатория_не_найдено"; КонецЕсли;
        Ссылка = Выборка.Ссылка;
        Если Выборка.Следующий() Тогда ВызватьИсключение "кабинет_лаборатория_привязка_конфликт"; КонецЕсли;
    КонецЕсли;
    Редакция = Ссылка.ПолучитьОбъект();
    Если Редакция = Неопределено Тогда ВызватьИсключение "кабинет_лаборатория_не_найдено"; КонецЕсли;
    Если Редакция.ПометкаУдаления Или Редакция.Проба <> Проба.Ссылка Или Редакция.РабочееПространство <> Проба.РабочееПространство
        Или Редакция.Область <> Проба.Область Или Редакция.ВерсияСправочника <> "lab-demo-2026-01" Тогда ВызватьИсключение "кабинет_лаборатория_не_найдено"; КонецЕсли;
    Если (Вид = "owner" Или Вид = "public") И Редакция.Состояние <> "Approved" Тогда ВызватьИсключение "кабинет_лаборатория_не_найдено"; КонецЕсли;
    Если Редакция.Состояние = "Approved" И (Редакция.АвторВвода = Редакция.Утвердивший Или Не ЗначениеЗаполнено(Редакция.Утвердивший)) Тогда
        ВызватьИсключение "кабинет_лаборатория_привязка_конфликт";
    КонецЕсли;
    Если СтрДлина(Редакция.ИдентификаторАвтораВвода) <> 36 Тогда ВызватьИсключение "кабинет_лаборатория_привязка_конфликт"; КонецЕсли;
    Если Редакция.Состояние = "Approved" И (Редакция.ИдентификаторАвтораВвода = Редакция.ИдентификаторУтвердившего Или СтрДлина(Редакция.ИдентификаторУтвердившего) <> 36) Тогда
        ВызватьИсключение "кабинет_лаборатория_привязка_конфликт";
    КонецЕсли;
    Возврат Редакция;
КонецФункции

Функция ДанныеПротокола(Проба, Редакция, Вид)
    Результат = Новый Структура("sampleId,protocolId,version,previousApprovedProtocolId,lakeCode,lakeName,collectedAt,approvedAt,state,dictionaryVersion,source,warning,values",
        СтрокаСсылки(Проба.Ссылка), СтрокаСсылки(Редакция.Ссылка), Редакция.Версия, СтрокаСсылки(Редакция.ПредыдущийУтвержденный), Проба.КодОзера,
        НазваниеОзера(Проба.КодОзера), СтрокаДатыUTC(Проба.ВремяОтбора), ?(Редакция.Состояние = "Approved", СтрокаДатыUTC(Редакция.ДатаУтверждения), ""),
        Редакция.Состояние, Редакция.ВерсияСправочника, "SPEC-6.8/demo-v1", УчебнаяМаркировка(), ИзмеренияПротокола(Редакция, Проба.Панель));
    Если Вид <> "public" Тогда
        Результат.Вставить("registrationNumber", Проба.РегистрационныйНомер);
        Результат.Вставить("location", Проба.МестоОтбора); Результат.Вставить("collectionSource", Проба.Источник);
        Результат.Вставить("conditions", Проба.УсловияПриемки); Результат.Вставить("correctionReason", Редакция.ПричинаИсправления);
    КонецЕсли;
    Если Вид = "technician" Или Вид = "approver" Тогда
        Результат.Вставить("comment", Редакция.Комментарий); Результат.Вставить("enteredBy", СтрокаСсылки(Редакция.АвторВвода));
        Результат.Вставить("approvedBy", СтрокаСсылки(Редакция.Утвердивший));
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ПолучитьПротокол(УчетнаяЗапись, Ид, Версия = 0, Вид = "owner") Экспорт
    Контекст = НачатьСПробой(УчетнаяЗапись, Ид, РольПредставления(Вид));
    Попытка
        ПроверитьПредставление(УчетнаяЗапись, Контекст, Вид, Истина);
        Редакция = НайтиРедакцию(Контекст.Проба, Версия, Вид);
        Результат = ДанныеПротокола(Контекст.Проба, Редакция, Вид); ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьОперацию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Процедура ПроверитьПределСтраницы(Предел)
    Если ТипЗнч(Предел) <> Тип("Число") Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_поле"; КонецЕсли;
    Если Предел <> Цел(Предел) Или Предел < 1 Или Предел > 100 Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_поле"; КонецЕсли;
КонецПроцедуры

Функция ПолучитьИсторию(УчетнаяЗапись, Ид, Вид = "owner", ПослеРевизии = 0, Предел = 25) Экспорт
    ПроверитьПределСтраницы(Предел);
    Если Вид = "public" Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_просмотр"; КонецЕсли;
    Ревизия(Новый Структура("expectedRevision", ПослеРевизии));
    Контекст = НачатьСПробой(УчетнаяЗапись, Ид, РольПредставления(Вид));
    Попытка
        ПроверитьПредставление(УчетнаяЗапись, Контекст, Вид);
        Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 101 Ревизия, Операция, Причина, ДатаИзменения, ДействующееЛицо, СнимокДоJSON, СнимокПослеJSON
            |ИЗ РегистрСведений.ИсторияЛаборатории ГДЕ Вид = &Вид И ИдентификаторСущности = &Ид
            |И РабочееПространство = &Пространство И Область = &Область И Ревизия > &После УПОРЯДОЧИТЬ ПО Ревизия");
        Запрос.УстановитьПараметр("Вид", "Sample"); Запрос.УстановитьПараметр("Ид", СтрокаСсылки(Контекст.Проба.Ссылка));
        Запрос.УстановитьПараметр("Пространство", Контекст.РабочееПространство); Запрос.УстановитьПараметр("Область", Контекст.Область);
        Запрос.УстановитьПараметр("После", ПослеРевизии); Выборка = Запрос.Выполнить().Выбрать();
        Элементы = Новый Массив; ЕстьЕще = Ложь; Последняя = ПослеРевизии;
        Пока Выборка.Следующий() Цикл
            Если Элементы.Количество() = Предел Тогда ЕстьЕще = Истина; Прервать; КонецЕсли;
            Перед = Декодировать(Выборка.СнимокДоJSON);
            Если Перед.Количество() > 0 Тогда Перед = ВыбратьПоляСнимка(Перед, ПоляПробы()); КонецЕсли;
            После = ВыбратьПоляСнимка(Декодировать(Выборка.СнимокПослеJSON), ПоляПробы());
            Элемент = Новый Структура("revision,operation,reason,changedAt,before,after", Выборка.Ревизия, Выборка.Операция, Выборка.Причина, СтрокаДатыUTC(Выборка.ДатаИзменения), Перед, После);
            Если Вид <> "owner" Тогда Элемент.Вставить("actorAccountId", СтрокаСсылки(Выборка.ДействующееЛицо)); КонецЕсли;
            Элементы.Добавить(Элемент); Последняя = Выборка.Ревизия;
        КонецЦикла;
        Результат = Новый Структура("items,hasMore,nextCursor,nextRevision", Элементы, ЕстьЕще, ?(ЕстьЕще, Формат(Последняя, "ЧГ=0;ЧДЦ=0"), ""), Последняя); ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьОперацию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Процедура ПроверитьЧастныйОбъект(УчетнаяЗапись, Контекст)
    ПроверитьВладельца(УчетнаяЗапись, Контекст.Проба);
    Если Контекст.Проба.КодОзера <> "potaennoe" Тогда ВызватьИсключение "кабинет_лаборатория_не_найдено"; КонецЕсли;
КонецПроцедуры

Функция ОткрытьЧастныйУказатель(Проба)
    Блокировка = Новый БлокировкаДанных;
    ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ТекущиеЧастныеЗаключенияПроб");
    ЭлементБлокировки.УстановитьЗначение("Проба", Проба.Ссылка);
    ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный; Блокировка.Заблокировать();
    Указатель = РегистрыСведений.ТекущиеЧастныеЗаключенияПроб.СоздатьМенеджерЗаписи();
    Указатель.Проба = Проба.Ссылка; Указатель.Прочитать();
    Возврат Указатель;
КонецФункции

Функция СохранитьЧастноеЗаключение(УчетнаяЗапись, Ид, Тело, ЗапросИд) Экспорт
    ПроверитьПоля(Тело, "expectedVersion,text"); ОжидаемаяВерсия = Ревизия(Тело, "expectedVersion");
    ЧастныйТекст = Текст(Тело, "text", 8192, Истина);
    Контекст = НачатьСПробой(УчетнаяЗапись, Ид);
    Попытка
        ПроверитьЧастныйОбъект(УчетнаяЗапись, Контекст);
        Указатель = ОткрытьЧастныйУказатель(Контекст.Проба);
        Команда = ОткрытьКоманду(УчетнаяЗапись, Контекст, ЗапросИд, "private.save", СтрокаСсылки(Контекст.Проба.Ссылка), Тело);
        Если Команда.Выбран() Тогда
            Результат = ПовторитьРезультат(Команда);
        Иначе
            Версия = ?(Указатель.Выбран(), Указатель.Версия, 0);
            Если Версия <> ОжидаемаяВерсия Тогда ВызватьИсключение "кабинет_лаборатория_редакция_конфликт"; КонецЕсли;
            Если Версия >= 20 Тогда ВызватьИсключение "кабинет_лаборатория_квота_превышено"; КонецЕсли;
            Заключение = Справочники.ЧастныеЗаключенияПроб.СоздатьЭлемент();
            Заключение.SetNewObjectRef(Справочники.ЧастныеЗаключенияПроб.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
            Заключение.РабочееПространство = Контекст.РабочееПространство; Заключение.Область = Контекст.Область;
            Заключение.Проба = Контекст.Проба.Ссылка; Заключение.УчетнаяЗаписьВладельца = УчетнаяЗапись;
            Заключение.Версия = Версия + 1; Заключение.Текст = ЧастныйТекст; Заключение.ДатаСоздания = ТекущаяУниверсальнаяДата();
            Заключение.Наименование = "Частное заключение"; Заключение.Записать();
            Указатель.Проба = Контекст.Проба.Ссылка; Указатель.Заключение = Заключение.Ссылка; Указатель.Версия = Заключение.Версия; Указатель.Записать();
            Результат = Новый Структура("sampleId,versionId,version,createdAt", СтрокаСсылки(Контекст.Проба.Ссылка), СтрокаСсылки(Заключение.Ссылка), Заключение.Версия, СтрокаДатыUTC(Заключение.ДатаСоздания));
            ЗавершитьКоманду(Команда, Контекст, Результат);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьОперацию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПолучитьЧастноеЗаключение(УчетнаяЗапись, Ид, Версия = 0) Экспорт
    Если ТипЗнч(Версия) <> Тип("Число") Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_версия"; КонецЕсли;
    Если Версия < 0 Или Версия > 20 Или Окр(Версия, 0) <> Версия Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_версия"; КонецЕсли;
    Контекст = НачатьСПробой(УчетнаяЗапись, Ид);
    Попытка
        ПроверитьЧастныйОбъект(УчетнаяЗапись, Контекст);
        Если Версия = 0 Тогда
            Указатель = ОткрытьЧастныйУказатель(Контекст.Проба);
            Если Не Указатель.Выбран() Тогда ВызватьИсключение "кабинет_лаборатория_не_найдено"; КонецЕсли;
            Ссылка = Указатель.Заключение;
        Иначе
            Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2 Ссылка ИЗ Справочник.ЧастныеЗаключенияПроб ГДЕ Проба = &Проба И Версия = &Версия УПОРЯДОЧИТЬ ПО Ссылка");
            Запрос.УстановитьПараметр("Проба", Контекст.Проба.Ссылка); Запрос.УстановитьПараметр("Версия", Версия);
            Выборка = Запрос.Выполнить().Выбрать();
            Если Не Выборка.Следующий() Тогда ВызватьИсключение "кабинет_лаборатория_не_найдено"; КонецЕсли;
            Ссылка = Выборка.Ссылка;
            Если Выборка.Следующий() Тогда ВызватьИсключение "кабинет_лаборатория_привязка_конфликт"; КонецЕсли;
        КонецЕсли;
        Заключение = Ссылка.ПолучитьОбъект(); ПроверитьОбъект(Заключение, Контекст);
        Если Заключение.Проба <> Контекст.Проба.Ссылка Или Заключение.УчетнаяЗаписьВладельца <> УчетнаяЗапись Тогда ВызватьИсключение "кабинет_лаборатория_не_найдено"; КонецЕсли;
        Результат = Новый Структура("sampleId,versionId,version,text,createdAt", СтрокаСсылки(Контекст.Проба.Ссылка), СтрокаСсылки(Заключение.Ссылка), Заключение.Версия, Заключение.Текст, СтрокаДатыUTC(Заключение.ДатаСоздания));
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьОперацию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Процедура НачатьЧтениеСписка(УчетнаяЗапись)
    ПроверитьУчастника(УчетнаяЗапись);
    Если ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_лаборатория_вложенная_транзакция"; КонецЕсли;
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьУчастников(УчетнаяЗапись, Неопределено); ПроверитьУчастника(УчетнаяЗапись);
    Исключение
        ОтменитьОперацию(); ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

Функция Курсор(ПослеИд, Вид)
    Если ПослеИд = "" Тогда
        Если Вид = "orders" Тогда Возврат Справочники.ЗаказыЛаборатории.ПустаяСсылка(); КонецЕсли;
        Возврат Справочники.ПробыЛаборатории.ПустаяСсылка();
    КонецЕсли;
    Если Вид = "orders" Тогда Возврат Справочники.ЗаказыЛаборатории.ПолучитьСсылку(Идентификатор(ПослеИд)); КонецЕсли;
    Возврат Справочники.ПробыЛаборатории.ПолучитьСсылку(Идентификатор(ПослеИд));
КонецФункции

Функция ПолучитьМоиОбъекты(УчетнаяЗапись, Вид, ПослеИд = "", Предел = 25) Экспорт
    ПроверитьПределСтраницы(Предел);
    Если Вид <> "orders" И Вид <> "samples" Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_вид"; КонецЕсли;
    После = Курсор(ПослеИд, Вид); НачатьЧтениеСписка(УчетнаяЗапись);
    Попытка
        Если Вид = "orders" Тогда
            Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 101 Ссылка ИЗ Справочник.ЗаказыЛаборатории
                |ГДЕ УчетнаяЗаписьВладельца = &УчетнаяЗапись И Ссылка > &После И НЕ ПометкаУдаления
                |И НЕ РабочееПространство.ПометкаУдаления И РабочееПространство.Состояние = &Активно
                |И НЕ Область.ПометкаУдаления И Область.Состояние = &Активно И Область.РабочееПространство = РабочееПространство УПОРЯДОЧИТЬ ПО Ссылка");
        Иначе
            Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 101 Ссылка ИЗ Справочник.ПробыЛаборатории
                |ГДЕ УчетнаяЗаписьВладельца = &УчетнаяЗапись И Ссылка > &После И НЕ ПометкаУдаления И НЕ Заказ.ПометкаУдаления
                |И Заказ.УчетнаяЗаписьВладельца = &УчетнаяЗапись И Заказ.РабочееПространство = РабочееПространство И Заказ.Область = Область
                |И НЕ РабочееПространство.ПометкаУдаления И РабочееПространство.Состояние = &Активно
                |И НЕ Область.ПометкаУдаления И Область.Состояние = &Активно И Область.РабочееПространство = РабочееПространство УПОРЯДОЧИТЬ ПО Ссылка");
        КонецЕсли;
        Запрос.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись); Запрос.УстановитьПараметр("После", После); Запрос.УстановитьПараметр("Активно", "Active");
        Выборка = Запрос.Выполнить().Выбрать(); Элементы = Новый Массив; ЕстьЕще = Ложь; Последний = "";
        Пока Выборка.Следующий() Цикл
            Если Элементы.Количество() = Предел Тогда ЕстьЕще = Истина; Прервать; КонецЕсли;
            Объект = Выборка.Ссылка.ПолучитьОбъект();
            Если Объект = Неопределено Тогда ВызватьИсключение "кабинет_лаборатория_не_найдено"; КонецЕсли;
            ПроверитьВладельца(УчетнаяЗапись, Объект);
            ПроверитьАктивнуюОбласть(Новый Структура("РабочееПространство,Область", Объект.РабочееПространство, Объект.Область));
            Элементы.Добавить(?(Вид = "orders", ДанныеЗаказа(Объект, Ложь), ДанныеПробы(Объект))); Последний = СтрокаСсылки(Выборка.Ссылка);
        КонецЦикла;
        Результат = Новый Структура("items,hasMore,nextCursor", Элементы, ЕстьЕще, ?(ЕстьЕще, Последний, "")); ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьОперацию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПолучитьОчередь(УчетнаяЗапись, ПространствоИд, ОбластьИд, Вид, Состояние = "", ПослеИд = "", Предел = 25) Экспорт
    ПроверитьПределСтраницы(Предел);
    Если Вид <> "technician" И Вид <> "approver" Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_просмотр"; КонецЕсли;
    Если Состояние <> "" И СтрРазделить("Draft,Submitted,Registered,InAnalysis,Review,Approved,Archived,NeedsInfo,Rejected", ",").Найти(Состояние) = Неопределено Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_состояние"; КонецЕсли;
    После = Курсор(ПослеИд, "samples"); Контекст = НачатьВОбласти(УчетнаяЗапись, ПространствоИд, ОбластьИд, РольПредставления(Вид));
    Попытка
        Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 101 Ссылка ИЗ Справочник.ПробыЛаборатории ГДЕ РабочееПространство = &Пространство
            |И Область = &Область И Ссылка > &После И НЕ ПометкаУдаления И НЕ Заказ.ПометкаУдаления
            |И Заказ.РабочееПространство = &Пространство И Заказ.Область = &Область
            |И (&Любое ИЛИ Состояние = &Состояние) УПОРЯДОЧИТЬ ПО Ссылка");
        Запрос.УстановитьПараметр("Пространство", Контекст.РабочееПространство); Запрос.УстановитьПараметр("Область", Контекст.Область);
        Запрос.УстановитьПараметр("После", После); Запрос.УстановитьПараметр("Любое", Состояние = ""); Запрос.УстановитьПараметр("Состояние", Состояние);
        Выборка = Запрос.Выполнить().Выбрать(); Элементы = Новый Массив; ЕстьЕще = Ложь; Последний = "";
        Пока Выборка.Следующий() Цикл
            Если Элементы.Количество() = Предел Тогда ЕстьЕще = Истина; Прервать; КонецЕсли;
            Проба = Выборка.Ссылка.ПолучитьОбъект(); ПроверитьОбъект(Проба, Контекст);
            Данные = ДанныеПробы(Проба); Данные.Вставить("technicianAccountId", СтрокаСсылки(Проба.НазначенныйЛаборант));
            Элементы.Добавить(Данные); Последний = СтрокаСсылки(Проба.Ссылка);
        КонецЦикла;
        Результат = Новый Структура("items,hasMore,nextCursor", Элементы, ЕстьЕще, ?(ЕстьЕще, Последний, "")); ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьОперацию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПолучитьЛаборантов(УчетнаяЗапись, ПространствоИд, ОбластьИд, ПослеИд = "", Предел = 25) Экспорт
    ПроверитьПределСтраницы(Предел);
    После = Справочники.УчетныеЗаписи.ПустаяСсылка();
    Если ПослеИд <> "" Тогда После = Справочники.УчетныеЗаписи.ПолучитьСсылку(Идентификатор(ПослеИд)); КонецЕсли;
    Контекст = НачатьВОбласти(УчетнаяЗапись, ПространствоИд, ОбластьИд, "LabTechnician");
    Попытка
        Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 101 Участие.УчетнаяЗапись КАК УчетнаяЗапись
            |ИЗ Справочник.Участия КАК Участие
            |ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПривязкиПользователей1С КАК Привязка
            |ПО Привязка.УчетнаяЗапись = Участие.УчетнаяЗапись
            |И Привязка.ИдентификаторПользователя1С = Участие.УчетнаяЗапись.ИдентификаторПользователя1С
            |ГДЕ Участие.РабочееПространство = &Пространство И Участие.Роль = &Роль
            |И Участие.Состояние = &Активно И НЕ Участие.ПометкаУдаления
            |И (Участие.СрокИстечения = &ПустаяДата ИЛИ Участие.СрокИстечения > &Сейчас)
            |И Участие.УчетнаяЗапись > &После И НЕ Участие.УчетнаяЗапись.ПометкаУдаления
            |И Участие.УчетнаяЗапись.Состояние = &Активно
            |И ((Участие.ОхватОбластей = &Все И Участие.Область = &ПустаяОбласть)
            |ИЛИ (Участие.ОхватОбластей = &Одна И Участие.Область = &Область
            |И НЕ Участие.Область.ПометкаУдаления И Участие.Область.Состояние = &Активно
            |И Участие.Область.РабочееПространство = &Пространство))
            |УПОРЯДОЧИТЬ ПО Участие.УчетнаяЗапись");
        Запрос.УстановитьПараметр("Пространство", Контекст.РабочееПространство);
        Запрос.УстановитьПараметр("Область", Контекст.Область);
        Запрос.УстановитьПараметр("После", После);
        Запрос.УстановитьПараметр("Роль", "LabTechnician");
        Запрос.УстановитьПараметр("Активно", "Active");
        Запрос.УстановитьПараметр("ПустаяДата", Дата(1, 1, 1));
        Запрос.УстановитьПараметр("Сейчас", ТекущаяУниверсальнаяДата());
        Запрос.УстановитьПараметр("Все", "All");
        Запрос.УстановитьПараметр("Одна", "Area");
        Запрос.УстановитьПараметр("ПустаяОбласть", Справочники.Области.ПустаяСсылка());
        Выборка = Запрос.Выполнить().Выбрать(); Элементы = Новый Массив; ЕстьЕще = Ложь; Последний = "";
        Пока Выборка.Следующий() Цикл
            ПроверитьНазначаемого(Выборка.УчетнаяЗапись, Контекст);
            Если Элементы.Количество() = Предел Тогда ЕстьЕще = Истина; Прервать; КонецЕсли;
            Кандидат = Выборка.УчетнаяЗапись.ПолучитьОбъект();
            Если Кандидат = Неопределено Тогда ВызватьИсключение "кабинет_лаборатория_цель_запрещено"; КонецЕсли;
            Если Кандидат.ПометкаУдаления Или Кандидат.Состояние <> "Active" Тогда ВызватьИсключение "кабинет_лаборатория_цель_запрещено"; КонецЕсли;
            Последний = СтрокаСсылки(Кандидат.Ссылка);
            Элементы.Добавить(Новый Структура("accountId,displayName", Последний, Кандидат.Наименование));
        КонецЦикла;
        Результат = Новый Структура("items,hasMore,nextCursor", Элементы, ЕстьЕще, ?(ЕстьЕще, Последний, ""));
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьОперацию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПубличныйПериод(КодОзера, От, До, Сводка = Ложь)
    Если КодОзера <> "" Тогда
        Если Не ПубличноеОзеро(КодОзера) Тогда ВызватьИсключение "кабинет_лаборатория_не_найдено"; КонецЕсли;
    КонецЕсли;
    Если Сводка И (От = "" Или До = "") Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_период"; КонецЕсли;
    Начало = ?(От = "", Дата(2000, 1, 1), ДатаИзСтроки(От));
    Конец = ?(До = "", ТекущаяУниверсальнаяДата() + 1, ДатаИзСтроки(До));
    Если Начало < Дата(2000, 1, 1) Или Начало >= Конец Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_период"; КонецЕсли;
    Если Сводка И Конец - Начало > 366 * 86400 Тогда ВызватьИсключение "кабинет_лаборатория_сводка_лимит"; КонецЕсли;
    Возврат Новый Структура("КодОзера,Начало,Конец", КодОзера, Начало, Конец);
КонецФункции

Процедура УстановитьПубличныйОтбор(Запрос, Период)
    Запрос.УстановитьПараметр("Озера", СтрРазделить("danilovo,lenyovo,shchuchye,shaitan", ","));
    Запрос.УстановитьПараметр("Любое", Период.КодОзера = ""); Запрос.УстановитьПараметр("КодОзера", Период.КодОзера);
    Запрос.УстановитьПараметр("Начало", Период.Начало); Запрос.УстановитьПараметр("Конец", Период.Конец);
    Запрос.УстановитьПараметр("Активно", "Active"); Запрос.УстановитьПараметр("Утверждено", "Approved");
КонецПроцедуры

Функция ПроверитьПубличнуюПробу(Проба)
    Если Проба = Неопределено Тогда ВызватьИсключение "кабинет_лаборатория_не_найдено"; КонецЕсли;
    Если Проба.ПометкаУдаления Или Не ПубличноеОзеро(Проба.КодОзера) Тогда ВызватьИсключение "кабинет_лаборатория_не_найдено"; КонецЕсли;
    Контекст = Новый Структура("РабочееПространство,Область", Проба.РабочееПространство, Проба.Область);
    ПроверитьАктивнуюОбласть(Контекст);
    Заказ = Проба.Заказ.ПолучитьОбъект(); ПроверитьОбъект(Заказ, Контекст);
    Если Заказ.УчетнаяЗаписьВладельца <> Проба.УчетнаяЗаписьВладельца Тогда ВызватьИсключение "кабинет_лаборатория_привязка_конфликт"; КонецЕсли;
    Возврат НайтиРедакцию(Проба, 0, "public");
КонецФункции

Функция ПолучитьПубличныеПротоколы(УчетнаяЗапись, КодОзера = "", От = "", До = "", ПослеИд = "") Экспорт
    Период = ПубличныйПериод(КодОзера, От, До); После = Курсор(ПослеИд, "samples"); НачатьЧтениеСписка(УчетнаяЗапись);
    Попытка
        Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 101 Ссылка ИЗ Справочник.ПробыЛаборатории
            |ГДЕ КодОзера В (&Озера) И (&Любое ИЛИ КодОзера = &КодОзера) И Ссылка > &После
            |И ВремяОтбора >= &Начало И ВремяОтбора < &Конец И НЕ ПометкаУдаления И НЕ Заказ.ПометкаУдаления
            |И НЕ РабочееПространство.ПометкаУдаления И РабочееПространство.Состояние = &Активно
            |И НЕ Область.ПометкаУдаления И Область.Состояние = &Активно И Область.РабочееПространство = РабочееПространство
            |И Заказ.РабочееПространство = РабочееПространство И Заказ.Область = Область
            |И НЕ УтвержденныйПротокол.ПометкаУдаления И УтвержденныйПротокол.Состояние = &Утверждено
            |И УтвержденныйПротокол.Проба = Ссылка УПОРЯДОЧИТЬ ПО Ссылка");
        УстановитьПубличныйОтбор(Запрос, Период); Запрос.УстановитьПараметр("После", После);
        Выборка = Запрос.Выполнить().Выбрать(); Элементы = Новый Массив; ЕстьЕще = Ложь; Последний = "";
        Пока Выборка.Следующий() Цикл
            Если Элементы.Количество() = 100 Тогда ЕстьЕще = Истина; Прервать; КонецЕсли;
            Проба = Выборка.Ссылка.ПолучитьОбъект(); Редакция = ПроверитьПубличнуюПробу(Проба);
            Элементы.Добавить(ДанныеПротокола(Проба, Редакция, "public")); Последний = СтрокаСсылки(Проба.Ссылка);
        КонецЦикла;
        Результат = Новый Структура("items,hasMore,nextCursor,warning,source", Элементы, ЕстьЕще, ?(ЕстьЕще, Последний, ""), УчебнаяМаркировка(), "SPEC-6.8/demo-v1");
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьОперацию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПолучитьПубличнуюСводку(УчетнаяЗапись, КодОзера, От, До) Экспорт
    Период = ПубличныйПериод(КодОзера, От, До, Истина); НачатьЧтениеСписка(УчетнаяЗапись);
    Попытка
        Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1001 Ссылка ИЗ Справочник.ПробыЛаборатории
            |ГДЕ КодОзера В (&Озера) И (&Любое ИЛИ КодОзера = &КодОзера)
            |И ВремяОтбора >= &Начало И ВремяОтбора < &Конец И НЕ ПометкаУдаления И НЕ Заказ.ПометкаУдаления
            |И НЕ РабочееПространство.ПометкаУдаления И РабочееПространство.Состояние = &Активно
            |И НЕ Область.ПометкаУдаления И Область.Состояние = &Активно И Область.РабочееПространство = РабочееПространство
            |И Заказ.РабочееПространство = РабочееПространство И Заказ.Область = Область
            |И НЕ УтвержденныйПротокол.ПометкаУдаления И УтвержденныйПротокол.Состояние = &Утверждено
            |И УтвержденныйПротокол.Проба = Ссылка УПОРЯДОЧИТЬ ПО Ссылка");
        УстановитьПубличныйОтбор(Запрос, Период); Выборка = Запрос.Выполнить().Выбрать();
        Статистика = Новый Соответствие; Количество = 0;
        Пока Выборка.Следующий() Цикл
            Если Количество = 1000 Тогда ВызватьИсключение "кабинет_лаборатория_сводка_лимит"; КонецЕсли;
            Проба = Выборка.Ссылка.ПолучитьОбъект(); Редакция = ПроверитьПубличнуюПробу(Проба);
            Для Каждого Измерение Из ИзмеренияПротокола(Редакция, Проба.Панель) Цикл
                СостояниеИндикатора = Статистика.Получить(Измерение.indicatorCode);
                Если СостояниеИндикатора = Неопределено Тогда
                    СостояниеИндикатора = Новый Структура("Код,Вид,Единица,Метод,Количество,Сумма,Минимум,Максимум,Прозрачных,Мутных", Измерение.indicatorCode, Измерение.kind, Измерение.unit, Измерение.method, 0, 0, 0, 0, 0, 0);
                    Статистика.Вставить(Измерение.indicatorCode, СостояниеИндикатора);
                КонецЕсли;
                Если Измерение.kind = "decimal" Тогда
                    ЧисловоеЗначение = ТочноеЧисло(Измерение.value);
                    Если СостояниеИндикатора.Количество = 0 Тогда
                        СостояниеИндикатора.Минимум = ЧисловоеЗначение; СостояниеИндикатора.Максимум = ЧисловоеЗначение;
                    Иначе
                        СостояниеИндикатора.Минимум = Мин(СостояниеИндикатора.Минимум, ЧисловоеЗначение);
                        СостояниеИндикатора.Максимум = Макс(СостояниеИндикатора.Максимум, ЧисловоеЗначение);
                    КонецЕсли;
                    СостояниеИндикатора.Сумма = СостояниеИндикатора.Сумма + ЧисловоеЗначение;
                ИначеЕсли Измерение.value = "clear" Тогда
                    СостояниеИндикатора.Прозрачных = СостояниеИндикатора.Прозрачных + 1;
                Иначе
                    СостояниеИндикатора.Мутных = СостояниеИндикатора.Мутных + 1;
                КонецЕсли;
                СостояниеИндикатора.Количество = СостояниеИндикатора.Количество + 1;
            КонецЦикла;
            Количество = Количество + 1;
        КонецЦикла;
        Итоги = Новый Массив;
        Для Каждого Код Из СтрРазделить("ph,turbidity,appearance,temperature", ",") Цикл
            Итог = Статистика.Получить(Код);
            Если Итог = Неопределено Тогда Продолжить; КонецЕсли;
            Данные = Новый Структура("indicatorCode,kind,unit,method,count", Код, Итог.Вид, Итог.Единица, Итог.Метод, Итог.Количество);
            Если Итог.Вид = "decimal" Тогда
                Данные.Вставить("sum", XMLСтрока(Итог.Сумма)); Данные.Вставить("min", XMLСтрока(Итог.Минимум)); Данные.Вставить("max", XMLСтрока(Итог.Максимум));
            Иначе
                Данные.Вставить("counts", Новый Структура("clear,turbid", Итог.Прозрачных, Итог.Мутных));
            КонецЕсли;
            Итоги.Добавить(Данные);
        КонецЦикла;
        Результат = Новый Структура("lakeCode,from,to,timeBasis,sampleCount,indicators,source,dictionaryVersion,status,generatedAt,warning",
            КодОзера, СтрокаДатыUTC(Период.Начало), СтрокаДатыUTC(Период.Конец), "collectedAt", Количество, Итоги, "SPEC-6.8/demo-v1", "lab-demo-2026-01", "Approved", СтрокаДатыUTC(ТекущаяУниверсальнаяДата()), УчебнаяМаркировка());
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьОперацию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ЯчейкаCSV(Значение)
    Представление = Строка(Значение);
    Проверка = Представление;
    Пока СтрДлина(Проверка) > 0 Цикл
        Код = КодСимвола(Проверка, 1);
        Если Код <= 32 Или Код = 160 Тогда Проверка = Сред(Проверка, 2); Иначе Прервать; КонецЕсли;
    КонецЦикла;
    Если СтрДлина(Проверка) > 0 Тогда
        Если СтрНайти("=+-@", Лев(Проверка, 1)) > 0 Тогда Представление = "'" + Представление; КонецЕсли;
    КонецЕсли;
    Возврат """" + СтрЗаменить(Представление, """", """""") + """";
КонецФункции

Функция СтрокаCSV(Ячейки)
    ТекстСтроки = "";
    Для Каждого Ячейка Из Ячейки Цикл
        Если ТекстСтроки <> "" Тогда ТекстСтроки = ТекстСтроки + ";"; КонецЕсли;
        ТекстСтроки = ТекстСтроки + ЯчейкаCSV(Ячейка);
    КонецЦикла;
    Возврат ТекстСтроки + Символ(13) + Символ(10);
КонецФункции

Функция ЭкспортПротоколаCSV(УчетнаяЗапись, Ид, Версия = 0, Вид = "owner", ВложенныйДопуск = Неопределено) Экспорт
    Протокол = ПолучитьПротокол(УчетнаяЗапись, Ид, Версия, Вид);
    Если Протокол.state <> "Approved" Тогда ВызватьИсключение "кабинет_лаборатория_неутверждено_экспорт"; КонецЕсли;
    Источник = Справочники.ПробыЛаборатории.ПолучитьСсылку(Новый УникальныйИдентификатор(Ид));
    ОбластиЭкспорта = ОграниченияТяжелыхЗаданий.ОднаОбласть(Источник.РабочееПространство, Источник.Область);
    СобственныйДопуск = ВложенныйДопуск = Неопределено;
    ДопускТяжелогоЗадания = ОграниченияТяжелыхЗаданий.Начать(УчетнаяЗапись, "labProtocol", ОбластиЭкспорта, ВложенныйДопуск);
    Попытка
        Результат = ЭкспортПротоколаCSVБезЛимита(УчетнаяЗапись, Ид, Версия, Вид);
    Исключение
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
        Если СобственныйДопуск Тогда ОграниченияТяжелыхЗаданий.Завершить(УчетнаяЗапись, ДопускТяжелогоЗадания); КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
    Если СобственныйДопуск Тогда ОграниченияТяжелыхЗаданий.Завершить(УчетнаяЗапись, ДопускТяжелогоЗадания); КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ЭкспортПротоколаCSVБезЛимита(УчетнаяЗапись, Ид, Версия = 0, Вид = "owner")
    Протокол = ПолучитьПротокол(УчетнаяЗапись, Ид, Версия, Вид);
    Если Протокол.state <> "Approved" Тогда ВызватьИсключение "кабинет_лаборатория_неутверждено_экспорт"; КонецЕсли;
    ТекстCSV = ЯчейкаCSV(УчебнаяМаркировка()) + Символ(13) + Символ(10);
    ТекстCSV = ТекстCSV + СтрокаCSV(СтрРазделить("sampleId;version;lake;collectedAt;approvedAt;source;dictionaryVersion", ";"));
    Ячейки = Новый Массив; Ячейки.Добавить(Протокол.sampleId); Ячейки.Добавить(Протокол.version); Ячейки.Добавить(Протокол.lakeName);
    Ячейки.Добавить(Протокол.collectedAt); Ячейки.Добавить(Протокол.approvedAt); Ячейки.Добавить(Протокол.source); Ячейки.Добавить(Протокол.dictionaryVersion);
    ТекстCSV = ТекстCSV + СтрокаCSV(Ячейки);
    ТекстCSV = ТекстCSV + СтрокаCSV(СтрРазделить("indicatorCode;value;unit;method", ";"));
    Для Каждого Измерение Из Протокол.values Цикл
        Ячейки = Новый Массив; Ячейки.Добавить(Измерение.indicatorCode); Ячейки.Добавить(Измерение.value); Ячейки.Добавить(Измерение.unit); Ячейки.Добавить(Измерение.method);
        ТекстCSV = ТекстCSV + СтрокаCSV(Ячейки);
    КонецЦикла;
    Возврат Новый Структура("csv,filename", ТекстCSV, "training-lab-" + Протокол.sampleId + "-v" + Строка(Протокол.version) + ".csv");
КонецФункции

