    Возврат 16384;
КонецФункции

Функция ЭтоЧтениеДиспетчерской(Действие)
    Возврат СтрРазделить("dispatchIntakes,publishedDispatchIntakes,ownDispatchRequests,ownDispatchRequest,ownDispatchHistory,staffDispatchRequests,staffDispatchRequest,staffDispatchHistory,dispatchIncidents,dispatchIncident", ",").Найти(Действие) <> Неопределено;
КонецФункции

Функция ЭтоИзменениеДиспетчерской(Действие)
    Возврат СтрРазделить("createDispatchIntake,configureDispatchIntake,createOwnDispatchRequest,replyOwnDispatchRequest,reopenOwnDispatchRequest,staffDispatchTransition,updateDispatchTriage,replyStaffDispatchRequest,addDispatchInternalNote,createDispatchIncident,updateDispatchIncident,resolveDispatchIncident,linkDispatchIncident,unlinkDispatchIncident", ",").Найти(Действие) <> Неопределено;
КонецФункции

Функция ОбработатьЧтениеДиспетчерской(Действие, СсылкаУчетнойЗаписи, Запрос)
    ВидСтраницы = "";
    Если Действие = "dispatchIntakes" Тогда ВидСтраницы = "intakes";
    ИначеЕсли Действие = "ownDispatchRequests" Тогда ВидСтраницы = "myRequests";
    ИначеЕсли Действие = "staffDispatchRequests" Тогда ВидСтраницы = "requests";
    ИначеЕсли Действие = "dispatchIncidents" Тогда ВидСтраницы = "incidents";
    КонецЕсли;
    Если ВидСтраницы <> "" Тогда
        Возврат СервисДиспетчерской.СтраницаДиспетчерской(СсылкаУчетнойЗаписи, ВидСтраницы, Запрос.ПараметрыЗапроса);
    КонецЕсли;
    Если Действие = "publishedDispatchIntakes" Тогда
        Возврат СервисДиспетчерской.ПубличныеПриемные(Запрос.ПараметрыЗапроса);
    КонецЕсли;
    Страница = ПараметрыСтраницыКабинета(Запрос);
    Идентификатор = Запрос.ПараметрыURL.Получить("id");
    Если Действие = "dispatchIntakes" Тогда
        Возврат СервисДиспетчерской.СписокПриемныхВладельца(СсылкаУчетнойЗаписи, ТекстПараметраЗапроса(Запрос, "workspaceId", 36));
    ИначеЕсли Действие = "publishedDispatchIntakes" Тогда
        Возврат СервисДиспетчерской.СписокОпубликованныхПриемных(СсылкаУчетнойЗаписи);
    ИначеЕсли Действие = "ownDispatchRequests" Тогда
        Возврат СервисДиспетчерской.СписокМоихЗаявок(СсылкаУчетнойЗаписи);
    ИначеЕсли Действие = "ownDispatchRequest" Тогда
        Возврат СервисДиспетчерской.ПолучитьСобственноеОбращение(СсылкаУчетнойЗаписи, Идентификатор);
    ИначеЕсли Действие = "ownDispatchHistory" Тогда
        Возврат СервисДиспетчерской.СписокЗаписейИсторииОбращения(СсылкаУчетнойЗаписи, Идентификатор, Ложь, Страница.limit, Страница.cursor);
    ИначеЕсли Действие = "staffDispatchRequests" Тогда
        Возврат СервисДиспетчерской.СписокОбращенийДиспетчерской(СсылкаУчетнойЗаписи, ТекстПараметраЗапроса(Запрос, "workspaceId", 36),
            ТекстПараметраЗапроса(Запрос, "areaId", 36), ТекстПараметраЗапроса(Запрос, "state", 32));
    ИначеЕсли Действие = "staffDispatchRequest" Тогда
        Возврат СервисДиспетчерской.ПолучитьСлужебнуюКарточкуОбращения(СсылкаУчетнойЗаписи, Идентификатор);
    ИначеЕсли Действие = "staffDispatchHistory" Тогда
        Возврат СервисДиспетчерской.СписокЗаписейИсторииОбращения(СсылкаУчетнойЗаписи, Идентификатор, Истина, Страница.limit, Страница.cursor);
    ИначеЕсли Действие = "dispatchIncidents" Тогда
        Возврат СервисДиспетчерской.СписокИнцидентов(СсылкаУчетнойЗаписи, ТекстПараметраЗапроса(Запрос, "workspaceId", 36),
            ТекстПараметраЗапроса(Запрос, "areaId", 36));
    ИначеЕсли Действие = "dispatchIncident" Тогда
        Возврат СервисДиспетчерской.ПолучитьИнцидент(СсылкаУчетнойЗаписи, Идентификатор);
    КонецЕсли;
    ВызватьИсключение "кабинет_диспетчерская_некорректно_действие";
КонецФункции

Функция ОбработатьИзменениеДиспетчерской(Действие, СсылкаУчетнойЗаписи, Запрос, ТелоЗапроса)
    Идентификатор = Запрос.ПараметрыURL.Получить("id");
    ИдентификаторЗапроса = ЗаголовокЗапроса(Запрос, "Idempotency-Key");
    Если Действие = "createDispatchIntake" Тогда
        Возврат СервисДиспетчерской.СоздатьПриемную(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "configureDispatchIntake" Тогда
        Возврат СервисДиспетчерской.НастроитьПриемную(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "createOwnDispatchRequest" Тогда
        Возврат СервисДиспетчерской.СоздатьСобственноеОбращение(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "replyOwnDispatchRequest" Тогда
        Возврат СервисДиспетчерской.ОтветитьНаСобственноеОбращение(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "reopenOwnDispatchRequest" Тогда
        Возврат СервисДиспетчерской.ПовторноОткрытьСобственноеОбращение(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "staffDispatchTransition" Тогда
        Переход = Запрос.ПараметрыURL.Получить("action");
        Если СтрРазделить("accept,reject,ask-info,resolve,reopen", ",").Найти(Переход) = Неопределено Тогда
            ВызватьИсключение "кабинет_диспетчерская_некорректно_действие";
        КонецЕсли;
        Возврат СервисДиспетчерской.ИзменитьСостояниеОбращения(СсылкаУчетнойЗаписи, Идентификатор, Переход, ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "updateDispatchTriage" Тогда
        Возврат СервисДиспетчерской.ОбновитьПриоритетИСрок(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "replyStaffDispatchRequest" Тогда
        Возврат СервисДиспетчерской.ДобавитьОтветСотрудникаНаОбращение(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "addDispatchInternalNote" Тогда
        Возврат СервисДиспетчерской.ДобавитьВнутреннююЗаметку(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "createDispatchIncident" Тогда
        Возврат СервисДиспетчерской.СоздатьИнцидент(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "updateDispatchIncident" Тогда
        Возврат СервисДиспетчерской.ОбновитьИнцидент(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "resolveDispatchIncident" Тогда
        Возврат СервисДиспетчерской.ЗавершитьИнцидент(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "linkDispatchIncident" Тогда
        Возврат СервисДиспетчерской.СвязатьСИнцидентом(СсылкаУчетнойЗаписи, Идентификатор, Запрос.ПараметрыURL.Получить("incidentId"), ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "unlinkDispatchIncident" Тогда
        Возврат СервисДиспетчерской.ОтменитьСвязьСИнцидентом(СсылкаУчетнойЗаписи, Идентификатор, Запрос.ПараметрыURL.Получить("incidentId"), ТелоЗапроса, ИдентификаторЗапроса);
    КонецЕсли;
    ВызватьИсключение "кабинет_диспетчерская_некорректно_действие";
КонецФункции

Процедура ПроверитьОбязательныеПоляТела(ТелоЗапроса, РазрешенныеПоля)
    Разрешенные = СтрРазделить(РазрешенныеПоля, ",");
    Для Каждого Поле Из ТелоЗапроса Цикл
        Если Разрешенные.Найти(Поле.Ключ) = Неопределено Тогда
            ВызватьИсключение "кабинет_некорректно_поле";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ТекстПараметраЗапроса(Запрос, Имя, МаксДлина) Экспорт
    Значение = Запрос.ПараметрыЗапроса.Получить(Имя);
    Если Значение = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_некорректно_поле";
    КонецЕсли;
    Если СтрДлина(Значение) > МаксДлина Тогда
        ВызватьИсключение "кабинет_некорректно_поле";
    КонецЕсли;
    Возврат Значение;
КонецФункции

Функция ПараметрыСтраницыКабинета(Запрос)
    ТекстЛимита = Запрос.ПараметрыЗапроса.Получить("limit");
    Лимит = 25;
    Если ТекстЛимита <> Неопределено Тогда
        Если ТипЗнч(ТекстЛимита) <> Тип("Строка") Или СтрДлина(ТекстЛимита) < 1 Или СтрДлина(ТекстЛимита) > 3 Тогда ВызватьИсключение "кабинет_некорректно_лимит"; КонецЕсли;
        Если Лев(ТекстЛимита, 1) = "0" Тогда ВызватьИсключение "кабинет_некорректно_лимит"; КонецЕсли;
        Для Номер = 1 По СтрДлина(ТекстЛимита) Цикл
            Если СтрНайти("0123456789", Сред(ТекстЛимита, Номер, 1)) = 0 Тогда ВызватьИсключение "кабинет_некорректно_лимит"; КонецЕсли;
        КонецЦикла;
        Лимит = Число(ТекстЛимита);
        Если Лимит > 100 Тогда ВызватьИсключение "кабинет_некорректно_лимит"; КонецЕсли;
    КонецЕсли;
    Возврат Новый Структура("limit,cursor", Лимит, ТекстПараметраЗапроса(Запрос, "cursor", 256));
КонецФункции

Функция ОбработатьЧтениеРеестра(Действие, Запрос, СсылкаУчетнойЗаписи)
    Лимит = ТекстПараметраЗапроса(Запрос, "limit", 3);
    Курсор = ТекстПараметраЗапроса(Запрос, "cursor", 256);
    РабочаяОбластьИдентификатор = ТекстПараметраЗапроса(Запрос, "workspaceId", 36);
    ОбластьИдентификатор = ТекстПараметраЗапроса(Запрос, "areaId", 36);
    Состояние = ТекстПараметраЗапроса(Запрос, "state", 16);
    Поиск = ТекстПараметраЗапроса(Запрос, "search", 250);
    Идентификатор = Запрос.ПараметрыURL.Получить("id");
    Если Действие = "registryListSubscribers" Тогда
        Возврат РеестрАбонентов.ПолучитьСписокАбонентов(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, Состояние, Поиск, Лимит, Курсор);
    ИначеЕсли Действие = "registryGetSubscriber" Тогда
        Возврат РеестрАбонентов.ПолучитьАбонента(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, Идентификатор);
    ИначеЕсли Действие = "registryListProperties" Тогда
        Возврат РеестрАбонентов.СписокОбъектовАбонентов(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, Состояние, Поиск, Лимит, Курсор);
    ИначеЕсли Действие = "registryGetProperty" Тогда
        Возврат РеестрАбонентов.ПолучитьОбъектАбонента(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, Идентификатор);
    ИначеЕсли Действие = "registryListServicePoints" Тогда
        Возврат РеестрАбонентов.СписокТочекОбслуживания(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, Состояние, Поиск, Лимит, Курсор);
    ИначеЕсли Действие = "registryGetServicePoint" Тогда
        Возврат РеестрАбонентов.ПолучитьТочкуОбслуживания(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, Идентификатор);
    ИначеЕсли Действие = "registryListContracts" Тогда
        Возврат РеестрАбонентов.СписокДоговоров(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, Состояние, Поиск, Лимит, Курсор);
    ИначеЕсли Действие = "registryGetContract" Тогда
        Возврат РеестрАбонентов.ПолучитьДоговор(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, Идентификатор);
    ИначеЕсли Действие = "registryListPersonalAccounts" Тогда
        Возврат РеестрАбонентов.СписокЛицевыхСчетов(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, Состояние, Поиск, Лимит, Курсор);
    ИначеЕсли Действие = "registryGetPersonalAccount" Тогда
        Возврат РеестрАбонентов.ПолучитьЛицевойСчет(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, Идентификатор);
    КонецЕсли;
    ВызватьИсключение "кабинет_реестр_не_найдено";
КонецФункции

Функция СоздатьЗаписьРеестра(Действие, СсылкаУчетнойЗаписи, ТелоЗапроса, Ключ)
    Если Действие = "registryCreateSubscriber" Тогда
        Возврат РеестрАбонентов.СоздатьАбонента(СсылкаУчетнойЗаписи, ТелоЗапроса, Ключ);
    ИначеЕсли Действие = "registryCreateProperty" Тогда
        Возврат РеестрАбонентов.СоздатьОбъектАбонента(СсылкаУчетнойЗаписи, ТелоЗапроса, Ключ);
    ИначеЕсли Действие = "registryCreateServicePoint" Тогда
        Возврат РеестрАбонентов.СоздатьТочкуОбслуживания(СсылкаУчетнойЗаписи, ТелоЗапроса, Ключ);
    ИначеЕсли Действие = "registryCreateContract" Тогда
        Возврат РеестрАбонентов.СоздатьДоговор(СсылкаУчетнойЗаписи, ТелоЗапроса, Ключ);
    ИначеЕсли Действие = "registryCreatePersonalAccount" Тогда
        Возврат РеестрАбонентов.СоздатьЛицевойСчет(СсылкаУчетнойЗаписи, ТелоЗапроса, Ключ);
    КонецЕсли;
    ВызватьИсключение "кабинет_реестр_не_найдено";
КонецФункции

Функция ОбязательнаяРевизияЗапроса(ТелоЗапроса)
    Ревизия = Неопределено;
    Если Не ТелоЗапроса.Свойство("expectedRevision", Ревизия) Тогда
        ВызватьИсключение "кабинет_некорректно_редакция";
    КонецЕсли;
    Если ТипЗнч(Ревизия) <> Тип("Число") Тогда
        ВызватьИсключение "кабинет_некорректно_редакция";
    КонецЕсли;
    Возврат Ревизия;
КонецФункции

Процедура ЗаписатьДиагностикуОператора(Описание, ИдентификаторКорреляции)
    Попытка
        ПризнакЧтение = Новый ЧтениеТекста("/run/vodokanal-diagnostics-enabled", КодировкаТекста.UTF8);
        ПризнакЧтение.Закрыть();
        Запись = Новый ЗаписьТекста("/tmp/vodokanal-portal-diagnostic.txt", КодировкаТекста.UTF8);
        Запись.ЗаписатьСтроку(ИдентификаторКорреляции);
        Запись.Записать(Описание);
        Запись.Закрыть();
    Исключение
    КонецПопытки;
КонецПроцедуры

Функция ДанныеТекущегоПользователя(Личность, УчетнаяЗапись, Сеанс)
    Результат = Новый Структура("actorId,nativeName,accountId", Личность.nativeUserId,
        Личность.nativeName, Строка(УчетнаяЗапись.Ссылка.УникальныйИдентификатор()));
    Результат.Вставить("workspaces", ПолитикаДоступа.ПолучитьСписокРабочихПространств(УчетнаяЗапись.Ссылка));
    Результат.Вставить("session", Новый Структура("idleTimeoutSeconds,absoluteTimeoutSeconds,remainingSeconds",
        Сеанс.idleTimeoutSeconds, Сеанс.absoluteTimeoutSeconds,
        Макс(0, Сеанс.absoluteExpiresAt - ТекущаяУниверсальнаяДата())));
    Возврат Результат;
КонецФункции

Процедура ПроверитьЗапросНаЗапись(Запрос)
    Если ЗаголовокЗапроса(Запрос, "X-Vodokanal-Request") <> "1" Тогда
        ВызватьИсключение "кабинет_запрос_заголовок_требуется";
    КонецЕсли;
    ИсточникЗапроса = НРег(ЗаголовокЗапроса(Запрос, "Origin"));
    Если ИсточникЗапроса <> "" И ИсточникЗапроса <> "http://127.0.0.1:8080" И ИсточникЗапроса <> "http://localhost:8080"
        И Не РазрешенныйВнутрисетевойИсточник(ИсточникЗапроса, ЗаголовокЗапроса(Запрос, "Host")) Тогда
        Если (ИсточникЗапроса <> "http://127.0.0.1:8081" И ИсточникЗапроса <> "http://localhost:8081")
            Или Не ИзолированнаяБазаДляИсточникаЗапроса() Тогда
            ВызватьИсключение "кабинет_источник_запрещено";
        КонецЕсли;
    КонецЕсли;
    ПолучитьДанныеМесто = НРег(ЗаголовокЗапроса(Запрос, "Sec-Fetch-Site"));
    Если ПолучитьДанныеМесто = "cross-site" Тогда
        ВызватьИсключение "кабинет_источник_запрещено";
    КонецЕсли;
КонецПроцедуры

Функция РазрешенныйВнутрисетевойИсточник(ИсточникЗапроса, Хост) Экспорт
    Если Лев(ИсточникЗапроса, 10) <> "http://10." Или Прав(ИсточникЗапроса, 5) <> ":8080" Тогда Возврат Ложь; КонецЕсли;
    Если ИсточникЗапроса <> "http://" + НРег(Хост) Тогда Возврат Ложь; КонецЕсли;
    Адрес = Сред(ИсточникЗапроса, 8, СтрДлина(ИсточникЗапроса) - 12);
    Если СтрНайти(Адрес, "..") > 0 Или Прав(Адрес, 1) = "." Тогда Возврат Ложь; КонецЕсли;
    Части = СтрРазделить(Адрес, ".", Ложь);
    Если Части.Количество() <> 4 Или Части[0] <> "10" Тогда Возврат Ложь; КонецЕсли;
    Для Каждого Часть Из Части Цикл
        Если СтрДлина(Часть) < 1 Или СтрДлина(Часть) > 3 Тогда Возврат Ложь; КонецЕсли;
        Если СтрДлина(Часть) > 1 И Лев(Часть, 1) = "0" Тогда Возврат Ложь; КонецЕсли;
        Для Н = 1 По СтрДлина(Часть) Цикл
            Если СтрНайти("0123456789", Сред(Часть, Н, 1)) = 0 Тогда Возврат Ложь; КонецЕсли;
        КонецЦикла;
        Если Число(Часть) > 255 Тогда Возврат Ложь; КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции

Функция ИзолированнаяБазаДляИсточникаЗапроса()
    Попытка
        Части = Новый Соответствие; Соединение = СтрокаСоединенияИнформационнойБазы();
        Если СтрДлина(Соединение) > 4096 Тогда Возврат Ложь; КонецЕсли;
        Для Каждого Часть Из СтрРазделить(Соединение, ";", Ложь) Цикл
            Часть = СокрЛП(Часть); Если Часть = "" Тогда Продолжить; КонецЕсли;
            Разделитель = СтрНайти(Часть, "="); Если Разделитель < 2 Тогда Возврат Ложь; КонецЕсли;
            Ключ = НРег(СокрЛП(Лев(Часть, Разделитель - 1)));
            Если (Ключ <> "srvr" И Ключ <> "ref") Или Части.Получить(Ключ) <> Неопределено Тогда Возврат Ложь; КонецЕсли;
            Значение = СокрЛП(Сред(Часть, Разделитель + 1));
            Если Лев(Значение, 1) = """" Тогда
                Если СтрДлина(Значение) < 2 Или Прав(Значение, 1) <> """" Тогда Возврат Ложь; КонецЕсли;
                Значение = Сред(Значение, 2, СтрДлина(Значение) - 2);
            КонецЕсли;
            Если СтрНайти(Значение, """") > 0 Тогда Возврат Ложь; КонецЕсли;
            Части.Вставить(Ключ, Значение);
        КонецЦикла;
        Если Части.Количество() <> 2 Или Части.Получить("srvr") <> "onec:1541" Тогда Возврат Ложь; КонецЕсли;
        ИмяБазы = Части.Получить("ref");
        Если Лев(ИмяБазы, 14) <> "vk_restore_p0_" Или СтрДлина(ИмяБазы) < 15 Или СтрДлина(ИмяБазы) > 43 Тогда Возврат Ложь; КонецЕсли;
        Для Н = 15 По СтрДлина(ИмяБазы) Цикл
            Если СтрНайти("abcdefghijklmnopqrstuvwxyz0123456789_", Сред(ИмяБазы, Н, 1)) = 0 Тогда Возврат Ложь; КонецЕсли;
        КонецЦикла;
        Возврат Истина;
    Исключение
        Возврат Ложь;
    КонецПопытки;
КонецФункции

Функция ЗаголовокЗапроса(Запрос, Имя) Экспорт
    Для Каждого Запись Из Запрос.Заголовки Цикл
        Если НРег(Запись.Ключ) = НРег(Имя) Тогда
            Возврат СокрЛП(Запись.Значение);
        КонецЕсли;
    КонецЦикла;
    Возврат "";
КонецФункции

Функция РазобратьТелоЗапроса(Запрос, МаксимумДлина = 16384) Экспорт
    СодержимоеТип = НРег(ЗаголовокЗапроса(Запрос, "Content-Type"));
    Если СодержимоеТип <> "application/json" И Лев(СодержимоеТип, 17) <> "application/json;" Тогда
        ВызватьИсключение "кабинет_джсон_требуется";
    КонецЕсли;
    Текст = Запрос.ПолучитьТелоКакСтроку();
    Если СтрДлина(Текст) > МаксимумДлина Тогда
        ВызватьИсключение "кабинет_тело_слишком_большое";
    КонецЕсли;
    Чтение = Новый ЧтениеJSON;
    Попытка
        Чтение.УстановитьСтроку(Текст);
        ТелоЗапроса = ПрочитатьJSON(Чтение);
        Чтение.Закрыть();
    Исключение
        Чтение.Закрыть();
        ВызватьИсключение "кабинет_некорректно_джсон";
    КонецПопытки;
    Если ТипЗнч(ТелоЗапроса) <> Тип("Структура") Тогда
        ВызватьИсключение "кабинет_некорректно_джсон";
    КонецЕсли;
    Возврат ТелоЗапроса;
КонецФункции

Функция ТекстовоеПоле(ТелоЗапроса, Имя, МаксДлина)
    Значение = "";
    Если Не ТелоЗапроса.Свойство(Имя, Значение) Тогда
        Возврат "";
    КонецЕсли;
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_некорректно_поле";
    КонецЕсли;
    Значение = СокрЛП(Значение);
    Если СтрДлина(Значение) > МаксДлина Тогда
        ВызватьИсключение "кабинет_некорректно_поле";
    КонецЕсли;
    Возврат Значение;
КонецФункции

