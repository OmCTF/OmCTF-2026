Функция ОбработатьЗапросHTTP(Действие, Запрос) Экспорт
    ИдентификаторКорреляции = Строка(СервисДокументов.НовыйUUIDv4());
    Допуск = Неопределено;
    Попытка
        Если Не ЭтоДействиеЧтения(Действие) Тогда
            ПроверитьЗапросНаЗапись(Запрос);
        КонецЕсли;
        Личность = ПолитикаДоступа.НативнаяИдентичность();
        УчетнаяЗапись = ПолитикаДоступа.ПроверитьУчетнуюЗапись();
        Если Действие <> "login" Тогда
            СеансыКабинета.ПроверитьСеанс(УчетнаяЗапись.Ссылка, УчетнаяЗапись.ПоколениеАвторизации, Ложь);
            Если Действие <> "logout" Тогда
                Допуск = ОграниченияЗапросовAPI.ДопуститьЗапрос(УчетнаяЗапись.Ссылка,
                    Не ЭтоДействиеЧтения(Действие), ЭтоГенерацияЭкспорта(Действие));
            КонецЕсли;
        КонецЕсли;
        Если Допуск <> Неопределено И Не Допуск.allowed Тогда
            Результат = ОтветОграничения(429, Допуск.code, Допуск.retryAfter, ИдентификаторКорреляции);
        Иначе
            Результат = ВыполнитьЗапросHTTP(Действие, Запрос, Личность, УчетнаяЗапись, ИдентификаторКорреляции);
        КонецЕсли;
    Исключение
        Описание = ОписаниеОшибки(); Результат = СформироватьОтветПриСбое(Описание, ИдентификаторКорреляции);
        Если Результат.КодСостояния = 500 Тогда ЗаписатьДиагностикуОператора(Описание, ИдентификаторКорреляции); КонецЕсли;
    КонецПопытки;
    Если Допуск <> Неопределено И Допуск.leaseKey <> "" Тогда
        Попытка
            Если ТранзакцияАктивна() Тогда
                ОтменитьТранзакцию();
                Результат = ОтветОграничения(503, "кабинет_апи_экспорт_недоступно", 60, ИдентификаторКорреляции);
            КонецЕсли;
            Своевременно = ОграниченияЗапросовAPI.ЗавершитьЭкспорт(УчетнаяЗапись.Ссылка, Допуск.leaseKey);
            Если Не Своевременно И Результат.КодСостояния < 400 Тогда
                Результат = ОтветОграничения(503, "кабинет_апи_экспорт_истекло", 1, ИдентификаторКорреляции);
            КонецЕсли;
        Исключение
            Результат = ОтветОграничения(503, "кабинет_апи_экспорт_недоступно", 60, ИдентификаторКорреляции);
            ЗаписатьДиагностикуОператора("кабинет_апи_экспорт_выпуск_не_удалось", ИдентификаторКорреляции);
        КонецПопытки;
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ЭтоГенерацияЭкспорта(Действие)
    Возврат МаршрутизацияКабинета.ЭтоЭкспорт(Действие) Или Действие = "exportRegistry" Или ФорматОтветаЛаборатории(Действие) <> "json"
        Или СтрРазделить("workPrint,workAppendixExport,workAppendixVersionExport", ",").Найти(Действие) <> Неопределено;
КонецФункции

Функция ОтветОграничения(Статус, Код, ПовторЧерез, Корреляция)
    Ответ = СформироватьОтветHTTP(Статус, Новый Структура("error,requestId", Код, Корреляция), Корреляция);
    Ответ.Заголовки.Вставить("Retry-After", Формат(Макс(1, ПовторЧерез), "ЧГ=0;ЧДЦ=0")); Возврат Ответ;
КонецФункции

Функция ВыполнитьЗапросHTTP(Действие, Запрос, Личность, УчетнаяЗапись, ИдентификаторКорреляции)
    Попытка
        Если Действие = "login" Тогда
            Если НРег(ЗаголовокЗапроса(Запрос, "IBSession")) <> "start"
                Или Лев(НРег(ЗаголовокЗапроса(Запрос, "Authorization")), 6) <> "basic " Тогда
                ВызватьИсключение "кабинет_новый_вход_требуется";
            КонецЕсли;
            Если СтрНайти(НРег(ЗаголовокЗапроса(Запрос, "Cookie")), "ibsession=") > 0 Тогда
                ВызватьИсключение "кабинет_новый_вход_требуется";
            КонецЕсли;
            РазобратьТелоЗапроса(Запрос);
            Сеанс = СеансыКабинета.ОткрытьСеанс(УчетнаяЗапись.Ссылка, УчетнаяЗапись.ПоколениеАвторизации);
            Если Не ПолитикаДоступа.ЕстьЛичноеРабочееПространство(УчетнаяЗапись.Ссылка) Тогда
                ПолитикаДоступа.СоздатьРабочееПространство(УчетнаяЗапись.Ссылка, Личность.nativeName);
            КонецЕсли;
            Возврат СформироватьОтветHTTP(200, ДанныеТекущегоПользователя(Личность, УчетнаяЗапись, Сеанс), ИдентификаторКорреляции);
        КонецЕсли;

        Сеанс = СеансыКабинета.ПроверитьСеанс(УчетнаяЗапись.Ссылка, УчетнаяЗапись.ПоколениеАвторизации);
        Если МаршрутизацияКабинета.МодульДействия(Действие) <> "" Тогда
            Возврат МаршрутизацияКабинета.ОбработатьЗапрос(Действие, УчетнаяЗапись.Ссылка, Запрос, ИдентификаторКорреляции);
        КонецЕсли;
        Если ЭтоЧтениеГидрологии(Действие) Тогда
            Возврат СформироватьОтветHTTP(200, ЧтениеГидрологии(Действие, УчетнаяЗапись.Ссылка, Запрос), ИдентификаторКорреляции);
        КонецЕсли;
        Если ЭтоЧтениеМатериаловНарядов(Действие) Тогда
            Возврат СформироватьОтветHTTP(200, ОбработатьЧтениеМатериаловНарядов(Действие, УчетнаяЗапись.Ссылка, Запрос), ИдентификаторКорреляции);
        КонецЕсли;
        Если ЭтоЧтениеСклада(Действие) Тогда
            Возврат СформироватьОтветHTTP(200, ОбработатьЧтениеСклада(Действие, УчетнаяЗапись.Ссылка, Запрос), ИдентификаторКорреляции);
        КонецЕсли;
        Если ЭтоЧтениеЛаборатории(Действие) Тогда
            Данные = ОбработатьЧтениеЛаборатории(Действие, УчетнаяЗапись.Ссылка, Запрос);
            Формат = ФорматОтветаЛаборатории(Действие);
            Если Формат = "csv" Тогда
                Возврат СформироватьОтветCSV(Данные, ИдентификаторКорреляции);
            ИначеЕсли Формат = "pdf" Тогда
                ФайлОтвета = Новый Структура("mime,filename,binary", "application/pdf", Данные.ИмяФайла, Данные.Данные);
                Возврат СформироватьОтветФайла(ФайлОтвета, ИдентификаторКорреляции);
            КонецЕсли;
            Возврат СформироватьОтветHTTP(200, Данные, ИдентификаторКорреляции);
        КонецЕсли;
        Если Действие = "appReadiness" Тогда
            Возврат СформироватьОтветHTTP(200, ПроверитьГотовностьСервиса(УчетнаяЗапись.Ссылка), ИдентификаторКорреляции);
        КонецЕсли;
        Если ЭтоЧтениеФайлов(Действие) Тогда
            Данные = ОбработатьЧтениеФайлов(Действие, УчетнаяЗапись.Ссылка, Запрос);
            Если ЭтоСкачиваниеФайла(Действие) Тогда
                Возврат СформироватьОтветФайла(Данные, ИдентификаторКорреляции);
            КонецЕсли;
            Возврат СформироватьОтветHTTP(200, Данные, ИдентификаторКорреляции);
        КонецЕсли;
        Если ЭтоЧтениеНарядов(Действие) Тогда
            Данные = ОбработатьЧтениеНарядов(Действие, УчетнаяЗапись.Ссылка, Запрос);
            Если СтрРазделить("workPhotoContent,workPrint,workAppendixExport,workAppendixVersionExport", ",").Найти(Действие) <> Неопределено Тогда
                Возврат СформироватьОтветФайла(Данные, ИдентификаторКорреляции);
            КонецЕсли;
            Возврат СформироватьОтветHTTP(200, Данные, ИдентификаторКорреляции);
        КонецЕсли;
        Если ЭтоЧтениеДиспетчерской(Действие) Тогда
            Возврат СформироватьОтветHTTP(200, ОбработатьЧтениеДиспетчерской(Действие, УчетнаяЗапись.Ссылка, Запрос), ИдентификаторКорреляции);
        КонецЕсли;
        Если Действие = "waterSetup" Тогда
            Возврат СформироватьОтветHTTP(200, СервисВодоснабжения.СписокНастроекРаздела(УчетнаяЗапись.Ссылка,
                ТекстПараметраЗапроса(Запрос, "workspaceId", 36), ТекстПараметраЗапроса(Запрос, "areaId", 36)), ИдентификаторКорреляции);
        ИначеЕсли Действие = "waterOrders" Тогда
            Возврат СформироватьОтветHTTP(200, СервисВодоснабжения.СписокЗаказов(УчетнаяЗапись.Ссылка,
                ТекстПараметраЗапроса(Запрос, "workspaceId", 36), ТекстПараметраЗапроса(Запрос, "areaId", 36),
                ТекстПараметраЗапроса(Запрос, "limit", 3), ТекстПараметраЗапроса(Запрос, "cursor", 256)), ИдентификаторКорреляции);
        ИначеЕсли Действие = "waterOrder" Тогда
            Возврат СформироватьОтветHTTP(200, СервисВодоснабжения.ПолучитьЗаказ(УчетнаяЗапись.Ссылка, Запрос.ПараметрыURL.Получить("id")), ИдентификаторКорреляции);
        ИначеЕсли Действие = "waterBalances" Тогда
            Возврат СформироватьОтветHTTP(200, СервисВодоснабжения.ПолучитьОстатки(УчетнаяЗапись.Ссылка,
                ТекстПараметраЗапроса(Запрос, "workspaceId", 36), ТекстПараметраЗапроса(Запрос, "areaId", 36),
                ТекстПараметраЗапроса(Запрос, "pointId", 36)), ИдентификаторКорреляции);
        ИначеЕсли Действие = "waterMovements" Тогда
            Возврат СформироватьОтветHTTP(200, СервисВодоснабжения.СписокДвижений(УчетнаяЗапись.Ссылка,
                ТекстПараметраЗапроса(Запрос, "workspaceId", 36), ТекстПараметраЗапроса(Запрос, "areaId", 36),
                ТекстПараметраЗапроса(Запрос, "pointId", 36), ТекстПараметраЗапроса(Запрос, "limit", 3),
                ТекстПараметраЗапроса(Запрос, "cursor", 256)), ИдентификаторКорреляции);
        КонецЕсли;
        Если Действие = "exportRegistry" Тогда
            Данные = РеестрАбонентов.ВыгрузитьРеестр(УчетнаяЗапись.Ссылка,
                ТекстПараметраЗапроса(Запрос, "workspaceId", 36), ТекстПараметраЗапроса(Запрос, "areaId", 36),
                Запрос.ПараметрыURL.Получить("resource"), ТекстПараметраЗапроса(Запрос, "state", 16),
                ТекстПараметраЗапроса(Запрос, "search", 250));
            Возврат СформироватьОтветCSV(Данные, ИдентификаторКорреляции);
        КонецЕсли;
        Если Действие = "registryHistory" Тогда
            ВидИстории = ТекстПараметраЗапроса(Запрос, "view", 16);
            Если Запрос.ПараметрыЗапроса.Получить("view") <> Неопределено Тогда
                Если ВидИстории <> "service" Или Запрос.ПараметрыURL.Получить("resource") <> "properties" Тогда
                    ВызватьИсключение "кабинет_жизненный_цикл_некорректно_поле";
                КонецЕсли;
                Для Каждого Параметр Из Запрос.ПараметрыЗапроса Цикл
                    Если СтрРазделить("workspaceId,areaId,view,limit,cursor", ",").Найти(Параметр.Ключ) = Неопределено Тогда
                        ВызватьИсключение "кабинет_жизненный_цикл_некорректно_поле";
                    КонецЕсли;
                КонецЦикла;
                Данные = ЖизненныйЦиклАбонентов.ИсторияОбслуживанияОбъекта(УчетнаяЗапись.Ссылка,
                    ТекстПараметраЗапроса(Запрос, "workspaceId", 36), ТекстПараметраЗапроса(Запрос, "areaId", 36),
                    Запрос.ПараметрыURL.Получить("id"), ТекстПараметраЗапроса(Запрос, "limit", 3),
                    ТекстПараметраЗапроса(Запрос, "cursor", 256));
                Возврат СформироватьОтветHTTP(200, Данные, ИдентификаторКорреляции);
            КонецЕсли;
            Данные = ЖизненныйЦиклАбонентов.СписокЗаписейИстории(УчетнаяЗапись.Ссылка,
                ТекстПараметраЗапроса(Запрос, "workspaceId", 36), ТекстПараметраЗапроса(Запрос, "areaId", 36),
                Запрос.ПараметрыURL.Получить("resource"), Запрос.ПараметрыURL.Получить("id"),
                ТекстПараметраЗапроса(Запрос, "limit", 3), ТекстПараметраЗапроса(Запрос, "cursor", 256));
            Возврат СформироватьОтветHTTP(200, Данные, ИдентификаторКорреляции);
        КонецЕсли;
        Если Лев(Действие, 12) = "registryList" Или Лев(Действие, 11) = "registryGet" Тогда
            Возврат СформироватьОтветHTTP(200, ОбработатьЧтениеРеестра(Действие, Запрос, УчетнаяЗапись.Ссылка), ИдентификаторКорреляции);
        КонецЕсли;
        Если СтрРазделить("workspaces,memberships,areas,invitations,ownSessions,myAccountLinkRequests,pendingAccountLinks,myPersonalAccounts", ",").Найти(Действие) <> Неопределено Тогда
            СтраницаIAM = ПараметрыСтраницыКабинета(Запрос);
        КонецЕсли;
        Если Действие = "me" Тогда
            Возврат СформироватьОтветHTTP(200, ДанныеТекущегоПользователя(Личность, УчетнаяЗапись, Сеанс), ИдентификаторКорреляции);
        ИначеЕсли Действие = "workspaces" Тогда
            Возврат СформироватьОтветHTTP(200, ПолитикаДоступа.ПолучитьСписокРабочихПространств(УчетнаяЗапись.Ссылка, СтраницаIAM.limit, СтраницаIAM.cursor), ИдентификаторКорреляции);
        ИначеЕсли Действие = "memberships" Тогда
            РабочаяОбластьИдентификатор = Запрос.ПараметрыЗапроса.Получить("workspaceId");
            ТолькоСвоиТекст = ТекстПараметраЗапроса(Запрос, "ownOnly", 5);
            Если ТолькоСвоиТекст <> "" И ТолькоСвоиТекст <> "true" И ТолькоСвоиТекст <> "false" Тогда ВызватьИсключение "кабинет_некорректно_фильтр"; КонецЕсли;
            Возврат СформироватьОтветHTTP(200, ПолитикаДоступа.ПолучитьСписокУчастий(УчетнаяЗапись.Ссылка, РабочаяОбластьИдентификатор,
                СтраницаIAM.limit, СтраницаIAM.cursor, ТолькоСвоиТекст = "true"), ИдентификаторКорреляции);
        ИначеЕсли Действие = "areas" Тогда
            Возврат СформироватьОтветHTTP(200, ПолитикаДоступа.ПолучитьСписокОбластей(УчетнаяЗапись.Ссылка, Запрос.ПараметрыЗапроса.Получить("workspaceId"),
                СтраницаIAM.limit, СтраницаIAM.cursor), ИдентификаторКорреляции);
        ИначеЕсли Действие = "area" Тогда
            Возврат СформироватьОтветHTTP(200, ПолитикаДоступа.ПолучитьОбласть(УчетнаяЗапись.Ссылка, Запрос.ПараметрыURL.Получить("id")), ИдентификаторКорреляции);
        ИначеЕсли Действие = "invitations" Тогда
            РабочаяОбластьИдентификатор = Запрос.ПараметрыЗапроса.Получить("workspaceId");
            Если РабочаяОбластьИдентификатор = Неопределено Тогда
                РабочаяОбластьИдентификатор = "";
            КонецЕсли;
            Возврат СформироватьОтветHTTP(200, УчастиеВПространствах.ПолучитьСписокПриглашений(УчетнаяЗапись.Ссылка, РабочаяОбластьИдентификатор,
                СтраницаIAM.limit, СтраницаIAM.cursor), ИдентификаторКорреляции);
        ИначеЕсли Действие = "ownSessions" Тогда
            Возврат СформироватьОтветHTTP(200, СеансыКабинета.ПолучитьСобственныеСеансы(УчетнаяЗапись.Ссылка, СтраницаIAM.limit, СтраницаIAM.cursor), ИдентификаторКорреляции);
        ИначеЕсли Действие = "myAccountLinkRequests" Тогда
            Возврат СформироватьОтветHTTP(200, ДоступКЛицевымСчетам.СписокМоихЗаявок(УчетнаяЗапись.Ссылка, СтраницаIAM.limit, СтраницаIAM.cursor), ИдентификаторКорреляции);
        ИначеЕсли Действие = "pendingAccountLinks" Тогда
            Возврат СформироватьОтветHTTP(200, ДоступКЛицевымСчетам.СписокОжидающихЗаявок(УчетнаяЗапись.Ссылка,
                ТекстПараметраЗапроса(Запрос, "workspaceId", 36), ТекстПараметраЗапроса(Запрос, "areaId", 36),
                СтраницаIAM.limit, СтраницаIAM.cursor), ИдентификаторКорреляции);
        ИначеЕсли Действие = "myPersonalAccounts" Тогда
            Возврат СформироватьОтветHTTP(200, ДоступКЛицевымСчетам.ПолучитьСобственныеЛицевыеСчетаСтраница(УчетнаяЗапись.Ссылка,
                СтраницаIAM.limit, СтраницаIAM.cursor), ИдентификаторКорреляции);
        ИначеЕсли Действие = "myPersonalAccount" Тогда
            Возврат СформироватьОтветHTTP(200, ДоступКЛицевымСчетам.ПолучитьСобственныйЛицевойСчет(УчетнаяЗапись.Ссылка,
                Запрос.ПараметрыURL.Получить("id")), ИдентификаторКорреляции);
        ИначеЕсли Действие = "meterPassports" Тогда
            Возврат СформироватьОтветHTTP(200, СервисУчетаПоказаний.СписокПаспортовПриборов(УчетнаяЗапись.Ссылка,
                ТекстПараметраЗапроса(Запрос, "workspaceId", 36), ТекстПараметраЗапроса(Запрос, "areaId", 36),
                ТекстПараметраЗапроса(Запрос, "limit", 3), ТекстПараметраЗапроса(Запрос, "cursor", 256)), ИдентификаторКорреляции);
        ИначеЕсли Действие = "meterInstallations" Тогда
            Возврат СформироватьОтветHTTP(200, СервисУчетаПоказаний.СписокУстановокПриборов(УчетнаяЗапись.Ссылка,
                ТекстПараметраЗапроса(Запрос, "personalAccountId", 36), ТекстПараметраЗапроса(Запрос, "limit", 3),
                ТекстПараметраЗапроса(Запрос, "cursor", 256)), ИдентификаторКорреляции);
        ИначеЕсли Действие = "meterInstallation" Тогда
            Возврат СформироватьОтветHTTP(200, СервисУчетаПоказаний.ПолучитьУстановкуПрибора(УчетнаяЗапись.Ссылка,
                Запрос.ПараметрыURL.Получить("id")), ИдентификаторКорреляции);
        ИначеЕсли Действие = "meterMeasurements" Тогда
            Возврат СформироватьОтветHTTP(200, СервисУчетаПоказаний.ПолучитьСписокПоказаний(УчетнаяЗапись.Ссылка,
                ТекстПараметраЗапроса(Запрос, "meterInstallationId", 36), ТекстПараметраЗапроса(Запрос, "limit", 3),
                ТекстПараметраЗапроса(Запрос, "cursor", 256)), ИдентификаторКорреляции);
        КонецЕсли;

        Если Действие = "logout" Тогда
            Если НРег(ЗаголовокЗапроса(Запрос, "IBSession")) <> "finish" Тогда
                ВызватьИсключение "кабинет_завершение_требуется";
            КонецЕсли;
            СеансыКабинета.ОтозватьТекущийСеанс(УчетнаяЗапись.Ссылка);
            Возврат СформироватьОтветHTTP(200, Новый Структура("loggedOut", Истина), ИдентификаторКорреляции);
