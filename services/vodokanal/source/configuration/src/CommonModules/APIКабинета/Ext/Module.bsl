Функция СформироватьОтветHTTP(СтатусКод, Данные, ИдентификаторКорреляции) Экспорт
    Если СтатусКод >= 400 Тогда
        КодОшибки = "внутренний_ошибка"; ЗначениеОшибки = Неопределено;
        Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("error", ЗначениеОшибки) Тогда
            Если ТипЗнч(ЗначениеОшибки) = Тип("Строка") Тогда КодОшибки = ЗначениеОшибки;
            ИначеЕсли ТипЗнч(ЗначениеОшибки) = Тип("Структура") Тогда
                ЗначениеОшибки.Свойство("code", КодОшибки);
            КонецЕсли;
        КонецЕсли;
        Если ТипЗнч(КодОшибки) <> Тип("Строка") Или СтрДлина(КодОшибки) = 0 Или СтрДлина(КодОшибки) > 150 Тогда
            КодОшибки = "внутренний_ошибка";
        КонецЕсли;
        Для НомерСимвола = 1 По СтрДлина(КодОшибки) Цикл
            Если СтрНайти("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-абвгдеёжзийклмнопрстуфхцчшщъыьэюяАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ", Сред(КодОшибки, НомерСимвола, 1)) = 0 Тогда
                КодОшибки = "внутренний_ошибка"; Прервать;
            КонецЕсли;
        КонецЦикла;
        Сообщение = "Не удалось выполнить запрос. Сообщите службе поддержки идентификатор запроса.";
        Если СтатусКод = 400 Тогда Сообщение = "Проверьте заполненные поля и параметры запроса.";
        ИначеЕсли СтатусКод = 401 Тогда Сообщение = "Войдите в кабинет заново.";
        ИначеЕсли СтатусКод = 403 Тогда Сообщение = "Недостаточно прав для этой операции.";
        ИначеЕсли СтатусКод = 404 Тогда Сообщение = "Запись не найдена или недоступна.";
        ИначеЕсли СтатусКод = 409 Тогда Сообщение = "Данные изменились. Обновите запись перед повторной операцией.";
        ИначеЕсли СтатусКод = 413 Тогда Сообщение = "Размер данных превышает допустимый предел.";
        ИначеЕсли СтатусКод = 429 Тогда Сообщение = "Достигнут лимит запросов. Повторите позже.";
        ИначеЕсли СтатусКод = 503 Тогда Сообщение = "Сервис временно недоступен. Повторите позже.";
        КонецЕсли;
        Данные = Новый Структура("error,requestId", Новый Структура("code,message", КодОшибки, Сообщение), ИдентификаторКорреляции);
    КонецЕсли;
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Данные);
    Результат = Новый HTTPСервисОтвет(СтатусКод);
    Результат.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Результат.Заголовки.Вставить("Cache-Control", "no-store");
    Результат.Заголовки.Вставить("X-Content-Type-Options", "nosniff");
    Результат.Заголовки.Вставить("X-Request-ID", ИдентификаторКорреляции);
    Результат.Заголовки.Вставить("X-API-Contract", "1.0");
    Если СтатусКод = 429 Или СтатусКод = 503 Тогда Результат.Заголовки.Вставить("Retry-After", "60"); КонецЕсли;
    Если СтатусКод = 401 Тогда
        Результат.Заголовки.Вставить("Set-Cookie", "ibsession=; Path=/vodokanal/; Max-Age=0; HttpOnly; SameSite=Lax");
    КонецЕсли;
    Результат.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8);
    Возврат Результат;
КонецФункции

Функция СформироватьОтветCSV(Данные, ИдентификаторКорреляции) Экспорт
    Результат = Новый HTTPСервисОтвет(200);
    Результат.Заголовки.Вставить("Content-Type", "text/csv; charset=utf-8");
    Результат.Заголовки.Вставить("Content-Disposition", "attachment; filename=""" + Данные.filename + """");
    Результат.Заголовки.Вставить("Cache-Control", "no-store");
    Результат.Заголовки.Вставить("X-Content-Type-Options", "nosniff");
    Результат.Заголовки.Вставить("X-Request-ID", ИдентификаторКорреляции);
    Результат.Заголовки.Вставить("X-API-Contract", "1.0");
    Результат.УстановитьТелоИзСтроки(Символ(65279) + Данные.csv, КодировкаТекста.UTF8);
    Возврат Результат;
КонецФункции

Функция СформироватьОтветФайла(Данные, ИдентификаторКорреляции) Экспорт
    Результат = Новый HTTPСервисОтвет(200);
    Результат.Заголовки.Вставить("Content-Type", Данные.mime);
    Результат.Заголовки.Вставить("Content-Disposition", "attachment; filename=""" + Данные.filename + """");
    Результат.Заголовки.Вставить("Cache-Control", "no-store");
    Результат.Заголовки.Вставить("X-Content-Type-Options", "nosniff");
    Результат.Заголовки.Вставить("X-Request-ID", ИдентификаторКорреляции);
    Результат.Заголовки.Вставить("X-API-Contract", "1.0");
    Результат.УстановитьТелоИзДвоичныхДанных(Данные.binary);
    Возврат Результат;
КонецФункции

