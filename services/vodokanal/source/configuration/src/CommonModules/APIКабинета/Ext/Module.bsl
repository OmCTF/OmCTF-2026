Функция ФорматОтветаЛаборатории(Действие)
    Если СтрРазделить("labMyProtocolCSV,labTechnicianProtocolCSV,labApproverProtocolCSV,labPublicProtocolCSV", ",").Найти(Действие) <> Неопределено Тогда
        Возврат "csv";
    КонецЕсли;
    Если СтрРазделить("labMyProtocolPDF,labTechnicianProtocolPDF,labApproverProtocolPDF,labPublicProtocolPDF", ",").Найти(Действие) <> Неопределено Тогда
        Возврат "pdf";
    КонецЕсли;
    Возврат "json";
КонецФункции

Процедура ПроверитьПараметрыЛаборатории(Запрос, РазрешенныеПоля)
    Разрешенные = СтрРазделить(РазрешенныеПоля, ",");
    Для Каждого Поле Из Запрос.ПараметрыЗапроса Цикл
        Если Разрешенные.Найти(Поле.Ключ) = Неопределено Тогда
            ВызватьИсключение "кабинет_лаборатория_некорректно_поле";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ЦелыйПараметрЛаборатории(Запрос, Имя, Максимум)
    Текст = ТекстПараметраЗапроса(Запрос, Имя, 3);
    Если Текст = "" Тогда Возврат 0; КонецЕсли;
    Если СтрДлина(Текст) > 1 И Лев(Текст, 1) = "0" Тогда
        ВызватьИсключение "кабинет_лаборатория_некорректно_поле";
    КонецЕсли;
    Для Индекс = 1 По СтрДлина(Текст) Цикл
        Если СтрНайти("0123456789", Сред(Текст, Индекс, 1)) = 0 Тогда
            ВызватьИсключение "кабинет_лаборатория_некорректно_поле";
        КонецЕсли;
    КонецЦикла;
    Значение = Число(Текст);
    Если Значение > Максимум Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_поле"; КонецЕсли;
    Возврат Значение;
КонецФункции

Функция ПределСтраницыЛаборатории(Запрос)
    Если Запрос.ПараметрыЗапроса.Получить("limit") = Неопределено Тогда Возврат 25; КонецЕсли;
    Предел = ЦелыйПараметрЛаборатории(Запрос, "limit", 100);
    Если Предел < 1 Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_поле"; КонецЕсли;
    Возврат Предел;
КонецФункции

Функция ОбработатьЧтениеЛаборатории(Действие, СсылкаУчетнойЗаписи, Запрос)
