Функция ОбработатьИзменениеНарядов(Действие, СсылкаУчетнойЗаписи, Запрос, ТелоЗапроса)
    Идентификатор = Запрос.ПараметрыURL.Получить("id");
    ИдентификаторЗапроса = ЗаголовокЗапроса(Запрос, "Idempotency-Key");
    Если Действие = "createWorkCrew" Тогда
        Возврат СервисНарядов.СоздатьБригаду(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "setWorkCrewMember" Тогда
        Возврат СервисНарядов.НазначитьУчастникаБригады(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "createWorkResource" Тогда
        Возврат СервисНарядов.СоздатьРесурс(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "createWorkServiceOrder" Тогда
        Для Каждого Параметр Из Запрос.ПараметрыЗапроса Цикл
            ВызватьИсключение "кабинет_наряд_некорректно_поле";
        КонецЦикла;
        Возврат СервисНарядов.СоздатьЗаказУслуги(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "createWorkOrder" Тогда
        Возврат СервисНарядов.СоздатьНаряд(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "assignWorkOrder" Тогда
        Возврат СервисНарядов.НазначитьНаряд(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "workLeaderTransition" Тогда
        Переход = Запрос.ПараметрыURL.Получить("action");
        Если СтрРазделить("accept,decline,start,pause,resume,submit", ",").Найти(Переход) = Неопределено Тогда
            ВызватьИсключение "кабинет_наряд_некорректно_действие";
        КонецЕсли;
        Возврат СервисНарядов.ИзменитьСостояниеОтИмениБригадира(СсылкаУчетнойЗаписи, Идентификатор, Переход, ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "reviewWorkOrder" Тогда
        Переход = Запрос.ПараметрыURL.Получить("action");
        Если СтрРазделить("approve,rework,close,cancel,restore", ",").Найти(Переход) = Неопределено Тогда
            ВызватьИсключение "кабинет_наряд_некорректно_действие";
        КонецЕсли;
        Возврат СервисНарядов.ПроверитьНаряд(СсылкаУчетнойЗаписи, Идентификатор, Переход, ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "inviteWorkPermit" Тогда
        Возврат СервисНарядов.ВыдатьПриглашениеКНаряду(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "respondWorkPermit" Тогда
        Переход = Запрос.ПараметрыURL.Получить("action");
        Если СтрРазделить("accept,decline", ",").Найти(Переход) = Неопределено Тогда
            ВызватьИсключение "кабинет_наряд_некорректно_действие";
        КонецЕсли;
        Возврат СервисНарядов.ОтветитьНаПриглашениеКНаряду(СсылкаУчетнойЗаписи, Идентификатор, Переход, ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "revokeWorkPermit" Тогда
        Возврат СервисНарядов.ОтозватьДопускКНаряду(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "createWorkAppendix" Тогда
        Возврат СервисНарядов.СоздатьВерсиюПриложенияНаряда(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "uploadWorkPhoto" Тогда
        Возврат СервисНарядов.ЗагрузитьФотографиюНаряда(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса);
    КонецЕсли;
    ВызватьИсключение "кабинет_наряд_некорректно_действие";
КонецФункции

Функция ПараметрыСтраницыНарядов(Запрос, ДополнительныеПоля = "")
    Поля = СтрРазделить("limit,cursor" + ?(ДополнительныеПоля = "", "", "," + ДополнительныеПоля), ",");
    Для Каждого Параметр Из Запрос.ПараметрыЗапроса Цикл
        Если Поля.Найти(Параметр.Ключ) = Неопределено Тогда ВызватьИсключение "кабинет_наряд_некорректно_поле"; КонецЕсли;
    КонецЦикла;
    Лимит = 25;
    Если Запрос.ПараметрыЗапроса.Получить("limit") <> Неопределено Тогда
        Текст = ТекстПараметраЗапроса(Запрос, "limit", 3);
        Если Текст = "" Или Лев(Текст, 1) = "0" Тогда ВызватьИсключение "кабинет_наряд_некорректно_поле"; КонецЕсли;
        Для Позиция = 1 По СтрДлина(Текст) Цикл
            Если СтрНайти("0123456789", Сред(Текст, Позиция, 1)) = 0 Тогда ВызватьИсключение "кабинет_наряд_некорректно_поле"; КонецЕсли;
        КонецЦикла;
        Лимит = Число(Текст);
        Если Лимит > 100 Тогда ВызватьИсключение "кабинет_наряд_некорректно_поле"; КонецЕсли;
    КонецЕсли;
    Возврат Новый Структура("Лимит,Курсор", Лимит, ТекстПараметраЗапроса(Запрос, "cursor", 256));
КонецФункции

Функция ВерсияИзПутиЗапроса(Запрос, Максимум, ОшибкаКод = "кабинет_наряд_некорректно_поле")
    Текст = Запрос.ПараметрыURL.Получить("version");
    Если ТипЗнч(Текст) <> Тип("Строка") Тогда
        ВызватьИсключение ОшибкаКод;
    КонецЕсли;
    Если СтрДлина(Текст) < 1 Или СтрДлина(Текст) > 4 Или Лев(Текст, 1) = "0" Тогда
        ВызватьИсключение ОшибкаКод;
    КонецЕсли;
    Для Позиция = 1 По СтрДлина(Текст) Цикл
        Код = КодСимвола(Текст, Позиция);
        Если Код < 48 Или Код > 57 Тогда
            ВызватьИсключение ОшибкаКод;
        КонецЕсли;
    КонецЦикла;
    Версия = Число(Текст);
    Если Версия > Максимум Тогда
        ВызватьИсключение ОшибкаКод;
    КонецЕсли;
    Возврат Версия;
КонецФункции

