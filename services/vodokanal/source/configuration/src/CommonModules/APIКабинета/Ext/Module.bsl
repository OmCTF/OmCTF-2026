Функция ОбработатьИзменениеЛаборатории(Действие, СсылкаУчетнойЗаписи, Запрос, ТелоЗапроса)
    ПроверитьПараметрыЛаборатории(Запрос, "");
    Идентификатор = Запрос.ПараметрыURL.Получить("id");
    ИдентификаторЗапроса = ЗаголовокЗапроса(Запрос, "Idempotency-Key");
    Если Действие = "labCreateOrder" Тогда
        Возврат СервисЛаборатории.СоздатьЗаказ(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "labOrderSubmit" Тогда
        Возврат СервисЛаборатории.ИзменитьЗаказ(СсылкаУчетнойЗаписи, Идентификатор, "submit", ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "labOrderCancel" Тогда
        Возврат СервисЛаборатории.ИзменитьЗаказ(СсылкаУчетнойЗаписи, Идентификатор, "cancel", ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "labSampleRegister" Тогда
        Возврат СервисЛаборатории.ИзменитьПробу(СсылкаУчетнойЗаписи, Идентификатор, "register", ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "labSampleReject" Тогда
        Возврат СервисЛаборатории.ИзменитьПробу(СсылкаУчетнойЗаписи, Идентификатор, "reject", ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "labSampleAskInfo" Тогда
        Возврат СервисЛаборатории.ИзменитьПробу(СсылкаУчетнойЗаписи, Идентификатор, "ask-info", ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "labSampleAssign" Тогда
        Возврат СервисЛаборатории.ИзменитьПробу(СсылкаУчетнойЗаписи, Идентификатор, "assign", ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "labSampleStartAnalysis" Тогда
        Возврат СервисЛаборатории.ИзменитьПробу(СсылкаУчетнойЗаписи, Идентификатор, "start-analysis", ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "labSampleAnswer" Тогда
        Возврат СервисЛаборатории.ИзменитьПробу(СсылкаУчетнойЗаписи, Идентификатор, "answer", ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "labSampleArchive" Тогда
        Возврат СервисЛаборатории.ИзменитьПробу(СсылкаУчетнойЗаписи, Идентификатор, "archive", ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "labSampleCorrect" Тогда
        Возврат СервисЛаборатории.ИзменитьПробу(СсылкаУчетнойЗаписи, Идентификатор, "correct", ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "labSubmitResults" Тогда
        Возврат СервисЛаборатории.ПодатьРезультаты(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "labProtocolApprove" Тогда
        Возврат СервисЛаборатории.РешениеПоПротоколу(СсылкаУчетнойЗаписи, Идентификатор, "approve", ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "labProtocolRework" Тогда
        Возврат СервисЛаборатории.РешениеПоПротоколу(СсылкаУчетнойЗаписи, Идентификатор, "rework", ТелоЗапроса, ИдентификаторЗапроса);
    ИначеЕсли Действие = "labSavePrivateConclusion" Тогда
        Возврат СервисЛаборатории.СохранитьЧастноеЗаключение(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса);
    КонецЕсли;
    ВызватьИсключение "кабинет_лаборатория_некорректно_действие";
КонецФункции


Функция ЭтоДействиеЧтения(Действие)
    Если МаршрутизацияКабинета.ЭтоЧтение(Действие) Тогда Возврат Истина; КонецЕсли;
    Если ЭтоЧтениеГидрологии(Действие) Тогда Возврат Истина; КонецЕсли;
    Если ЭтоЧтениеМатериаловНарядов(Действие) Тогда Возврат Истина; КонецЕсли;
    Если ЭтоЧтениеСклада(Действие) Тогда Возврат Истина; КонецЕсли;
    Если ЭтоЧтениеЛаборатории(Действие) Тогда
        Возврат Истина;
    КонецЕсли;
    Если Действие = "appReadiness" Тогда
        Возврат Истина;
    КонецЕсли;
    Если ЭтоЧтениеФайлов(Действие) Тогда
        Возврат Истина;
    КонецЕсли;
    Если ЭтоЧтениеНарядов(Действие) Тогда
        Возврат Истина;
    КонецЕсли;
    Если ЭтоЧтениеДиспетчерской(Действие) Тогда
        Возврат Истина;
    КонецЕсли;
    Если СтрРазделить("waterSetup,waterOrders,waterOrder,waterBalances,waterMovements", ",").Найти(Действие) <> Неопределено Тогда
        Возврат Истина;
    КонецЕсли;
    Если Лев(Действие, 12) = "registryList" Или Лев(Действие, 11) = "registryGet" Тогда
        Возврат Истина;
    КонецЕсли;
    Возврат СтрРазделить("me,workspaces,memberships,areas,area,invitations,ownSessions,myAccountLinkRequests,pendingAccountLinks,myPersonalAccounts,myPersonalAccount,exportRegistry,meterPassports,meterInstallations,meterInstallation,meterMeasurements,registryHistory", ",").Найти(Действие) <> Неопределено;
КонецФункции

Функция ПроверитьГотовностьСервиса(СсылкаУчетнойЗаписи)
    ОграниченияОбъектовОбластей.ПроверитьГотовностьКвот();
    СервисДокументов.ПроверитьГотовностьОбластейЭкспортов();
    ПолитикаДоступа.ПолучитьСписокРабочихПространств(СсылкаУчетнойЗаписи);
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 1 ВерсияФайла ИЗ РегистрСведений.ТекущиеВерсииФайловОбращений
        |ГДЕ Файл = ЗНАЧЕНИЕ(Справочник.ФайлыОбращений.ПустаяСсылка)");
    Запрос.Выполнить();
    ЗапросЛаборатории = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ПробыЛаборатории
        |ГДЕ Ссылка = ЗНАЧЕНИЕ(Справочник.ПробыЛаборатории.ПустаяСсылка)");
    ЗапросЛаборатории.Выполнить();
    ЗапросДокументов = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ДокументыКабинета
        |ГДЕ Ссылка = ЗНАЧЕНИЕ(Справочник.ДокументыКабинета.ПустаяСсылка)");
    ЗапросДокументов.Выполнить();
    ЗапросДоставок = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ДоставкиВоды
        |ГДЕ Ссылка = ЗНАЧЕНИЕ(Справочник.ДоставкиВоды.ПустаяСсылка)");
    ЗапросДоставок.Выполнить();
    ЗапросУведомлений = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.УведомленияКабинета
        |ГДЕ Ссылка = ЗНАЧЕНИЕ(Справочник.УведомленияКабинета.ПустаяСсылка)");
    ЗапросУведомлений.Выполнить();
    Возврат Новый Структура("status,service,schemaVersion,database,schema,ordinaryRead,observedAt,training",
        "ready", "vodokanal", Метаданные.Версия, Истина, Истина, Истина, XMLСтрока(ТекущаяУниверсальнаяДата()) + "Z", Истина);
