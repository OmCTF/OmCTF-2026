    Возврат СтрРазделить("inventoryCreateUnit,inventoryCreateMaterial,inventoryCreateWarehouse,inventoryCreateCell,inventoryCreateRequest,inventoryCreateDocument", ",").Найти(Действие) <> Неопределено;
КонецФункции

Процедура ПроверитьПараметрыСклада(Запрос, РазрешенныеПоля)
    Разрешенные = СтрРазделить(РазрешенныеПоля, ",");
    Для Каждого Поле Из Запрос.ПараметрыЗапроса Цикл
        Если Разрешенные.Найти(Поле.Ключ) = Неопределено Тогда ВызватьИсключение "кабинет_склад_некорректно_поле"; КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ИдентификаторПараметраСклада(Запрос, Имя, Обязательный = Истина)
    Текст = ТекстПараметраЗапроса(Запрос, Имя, 36);
    Если Текст = "" И Не Обязательный Тогда Возврат ""; КонецЕсли;
    Если СтрДлина(Текст) <> 36 Тогда ВызватьИсключение "кабинет_некорректно_идентификатор"; КонецЕсли;
    Попытка
        Значение = Новый УникальныйИдентификатор(Текст);
    Исключение
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецПопытки;
    Канонический = Строка(Значение);
    Если НРег(Текст) <> Канонический Или Канонический = "00000000-0000-0000-0000-000000000000" Тогда ВызватьИсключение "кабинет_некорректно_идентификатор"; КонецЕсли;
    Возврат Канонический;
КонецФункции

Функция ОбработатьЧтениеСклада(Действие, СсылкаУчетнойЗаписи, Запрос)
    Поля = "workspaceId,areaId";
    Если СтрРазделить("inventoryWorkOrders,inventoryStock,inventoryRequests,inventoryDocuments", ",").Найти(Действие) <> Неопределено Тогда
        Поля = Поля + ",limit,cursor";
    КонецЕсли;
    Страница = Новый Структура("limit,cursor", ТекстПараметраЗапроса(Запрос, "limit", 3), ТекстПараметраЗапроса(Запрос, "cursor", 400));
    Если Действие = "inventoryStock" Тогда Поля = Поля + ",warehouseId"; КонецЕсли;
    Если Действие = "inventoryRequests" Или Действие = "inventoryDocuments" Тогда Поля = Поля + ",workOrderId"; КонецЕсли;
    ПроверитьПараметрыСклада(Запрос, Поля);
    Пространство = ИдентификаторПараметраСклада(Запрос, "workspaceId");
    Область = ИдентификаторПараметраСклада(Запрос, "areaId");
    Если Действие = "inventorySetup" Тогда
        Возврат СервисСклада.НастройкиСклада(СсылкаУчетнойЗаписи, Пространство, Область);
    ИначеЕсли Действие = "inventoryWorkOrders" Тогда
        Возврат СервисСклада.НарядыСклада(СсылкаУчетнойЗаписи, Пространство, Область, Страница);
    ИначеЕсли Действие = "inventoryStock" Тогда
        Возврат СервисСклада.ОстаткиСклада(СсылкаУчетнойЗаписи, Пространство, Область, ИдентификаторПараметраСклада(Запрос, "warehouseId", Ложь), Страница);
    ИначеЕсли Действие = "inventoryRequests" Тогда
        Возврат СервисСклада.ЗаявкиМатериалов(СсылкаУчетнойЗаписи, Пространство, Область, ИдентификаторПараметраСклада(Запрос, "workOrderId", Ложь), Страница);
    ИначеЕсли Действие = "inventoryDocuments" Тогда
        Возврат СервисСклада.ДвиженияМатериалов(СсылкаУчетнойЗаписи, Пространство, Область, ИдентификаторПараметраСклада(Запрос, "workOrderId", Ложь), Страница);
    ИначеЕсли Действие = "inventoryDocument" Тогда
        Данные = СервисСклада.ПолучитьДвижениеМатериалов(СсылкаУчетнойЗаписи, Запрос.ПараметрыURL.Получить("id"));
        Если Данные.workspaceId <> Пространство Или Данные.areaId <> Область Тогда ВызватьИсключение "кабинет_склад_не_найдено"; КонецЕсли;
        Возврат Данные;
    КонецЕсли;
    ВызватьИсключение "кабинет_склад_некорректно_операция";
КонецФункции

Функция ОбработатьИзменениеСклада(Действие, СсылкаУчетнойЗаписи, Запрос, ТелоЗапроса)
    ПроверитьПараметрыСклада(Запрос, "");
    Ключ = ЗаголовокЗапроса(Запрос, "Idempotency-Key");
    Если Действие = "inventoryCreateUnit" Тогда
        Возврат СервисСклада.СоздатьНастройкуСклада(СсылкаУчетнойЗаписи, ТелоЗапроса, Ключ, "Unit");
    ИначеЕсли Действие = "inventoryCreateMaterial" Тогда
        Возврат СервисСклада.СоздатьНастройкуСклада(СсылкаУчетнойЗаписи, ТелоЗапроса, Ключ, "Material");
    ИначеЕсли Действие = "inventoryCreateWarehouse" Тогда
        Возврат СервисСклада.СоздатьНастройкуСклада(СсылкаУчетнойЗаписи, ТелоЗапроса, Ключ, "Warehouse");
    ИначеЕсли Действие = "inventoryCreateCell" Тогда
        Возврат СервисСклада.СоздатьНастройкуСклада(СсылкаУчетнойЗаписи, ТелоЗапроса, Ключ, "Cell");
    ИначеЕсли Действие = "inventoryCreateRequest" Тогда
        Возврат СервисСклада.СоздатьЗаявкуМатериалов(СсылкаУчетнойЗаписи, ТелоЗапроса, Ключ);
    ИначеЕсли Действие = "inventoryCreateDocument" Тогда
        Возврат СервисСклада.СоздатьДвижениеМатериалов(СсылкаУчетнойЗаписи, ТелоЗапроса, Ключ);
    КонецЕсли;
    ВызватьИсключение "кабинет_склад_некорректно_операция";
КонецФункции

Функция ЭтоЧтениеМатериаловНарядов(Действие)
    Возврат Действие = "workMaterialsOrders" Или Действие = "workMaterialsOrder";
КонецФункции

Функция ЭтоИзменениеМатериаловНарядов(Действие)
    Возврат СтрРазделить("workMaterialsRequest,workMaterialsConsume,workMaterialsCorrect", ",").Найти(Действие) <> Неопределено;
КонецФункции

Функция ОбработатьЧтениеМатериаловНарядов(Действие, УчетнаяЗапись, Запрос)
    ПроверитьПараметрыСклада(Запрос, ?(Действие = "workMaterialsOrders", "workspaceId,areaId,limit,cursor", "workspaceId,areaId"));
    Пространство = ИдентификаторПараметраСклада(Запрос, "workspaceId");
    Область = ИдентификаторПараметраСклада(Запрос, "areaId");
    Если Действие = "workMaterialsOrders" Тогда
        Страница = Новый Структура("limit,cursor", ТекстПараметраЗапроса(Запрос, "limit", 3), ТекстПараметраЗапроса(Запрос, "cursor", 400));
        Возврат СервисСклада.МатериальныеНаряды(УчетнаяЗапись, Пространство, Область, Страница);
    ИначеЕсли Действие = "workMaterialsOrder" Тогда
        Возврат СервисСклада.МатериалыНаряда(УчетнаяЗапись, Пространство, Область, Запрос.ПараметрыURL.Получить("id"));
    КонецЕсли;
    ВызватьИсключение "кабинет_склад_некорректно_операция";
КонецФункции

Функция ОбработатьИзменениеМатериаловНарядов(Действие, УчетнаяЗапись, Запрос, Тело)
    ПроверитьПараметрыСклада(Запрос, "");
    Ключ = ЗаголовокЗапроса(Запрос, "Idempotency-Key");
    Если Действие = "workMaterialsRequest" Тогда
        Возврат СервисСклада.СоздатьЗаявкуНаряда(УчетнаяЗапись, Тело, Ключ);
    ИначеЕсли Действие = "workMaterialsConsume" Тогда
        Возврат СервисСклада.СписатьМатериалыНаряда(УчетнаяЗапись, Тело, Ключ);
    ИначеЕсли Действие = "workMaterialsCorrect" Тогда
        Возврат СервисСклада.ИсправитьСписаниеНаряда(УчетнаяЗапись, Тело, Ключ);
    КонецЕсли;
    ВызватьИсключение "кабинет_склад_некорректно_операция";
КонецФункции

Функция ЭтоВнутреннийСбойСклада(Описание)
    Коды = "кабинет_склад_остаток_конфликт,кабинет_склад_привязка_конфликт,кабинет_склад_вложенная_транзакция,кабинет_склад_проведение_контекст_требуется,кабинет_склад_привилегированный_запрещено,кабинет_склад_некорректно_движение,кабинет_склад_обмен_запрещено,кабинет_склад_поставлено_движения_запрещено,движение_материалов_нельзя_изменять";
    Для Каждого Код Из СтрРазделить(Коды, ",") Цикл
        Если СтрНайти(Описание, Код) > 0 Тогда Возврат Истина; КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

Функция ЭтоЧтениеГидрологии(Действие)
    Возврат СтрРазделить("hydrologyReference,hydrologyPosts,hydrologySeries,hydrologyHistory,hydrologySettingsHistory", ",").Найти(Действие) <> Неопределено;
КонецФункции

Функция ЭтоЗаписьГидрологии(Действие)
    Возврат СтрРазделить("hydrologyCreate,hydrologyConfigure,hydrologyMeasure,hydrologyCorrect,hydrologyImport,hydrologyGenerate", ",").Найти(Действие) <> Неопределено;
КонецФункции

Процедура ПроверитьПараметрыГидрологии(Запрос, Поля)
    Разрешенные = СтрРазделить(Поля, ",", Ложь);
    Для Каждого Пара Из Запрос.ПараметрыЗапроса Цикл
        Если Разрешенные.Найти(Пара.Ключ) = Неопределено Тогда ВызватьИсключение "кабинет_гидрология_некорректно_ввод"; КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ЧтениеГидрологии(Действие, УчетнаяЗапись, Запрос)
    Если Действие = "hydrologyReference" Тогда
        ПроверитьПараметрыГидрологии(Запрос, ""); Возврат СервисГидрологии.Справочники();
    ИначеЕсли Действие = "hydrologyPosts" Тогда
        ПроверитьПараметрыГидрологии(Запрос, "workspaceId,areaId,limit,cursor,riverCode");
        Возврат СервисГидрологии.Посты(УчетнаяЗапись, ТекстПараметраЗапроса(Запрос, "workspaceId", 36), ТекстПараметраЗапроса(Запрос, "areaId", 36),
            СервисГидрологии.ЛимитСтраницы(Запрос.ПараметрыЗапроса.Получить("limit")), ТекстПараметраЗапроса(Запрос, "cursor", 36), ТекстПараметраЗапроса(Запрос, "riverCode", 6));
    ИначеЕсли Действие = "hydrologySeries" Тогда
        ПроверитьПараметрыГидрологии(Запрос, "from,to,afterTime,limit,cursor");
        Возврат СервисГидрологии.Ряд(УчетнаяЗапись, Запрос.ПараметрыURL.Получить("id"),
            ТекстПараметраЗапроса(Запрос, "from", 20), ТекстПараметраЗапроса(Запрос, "to", 20), ТекстПараметраЗапроса(Запрос, "afterTime", 20),
            СервисГидрологии.ЛимитСтраницы(Запрос.ПараметрыЗапроса.Получить("limit")), ТекстПараметраЗапроса(Запрос, "cursor", 128));
    ИначеЕсли Действие = "hydrologyHistory" Тогда
        ПроверитьПараметрыГидрологии(Запрос, "measuredAt,limit,cursor");
        Возврат СервисГидрологии.История(УчетнаяЗапись, Запрос.ПараметрыURL.Получить("id"), ТекстПараметраЗапроса(Запрос, "measuredAt", 20),
            СервисГидрологии.ЛимитСтраницы(Запрос.ПараметрыЗапроса.Получить("limit")), ТекстПараметраЗапроса(Запрос, "cursor", 128));
    ИначеЕсли Действие = "hydrologySettingsHistory" Тогда
        ПроверитьПараметрыГидрологии(Запрос, "limit,cursor");
        Возврат СервисГидрологии.ИсторияНастроек(УчетнаяЗапись, Запрос.ПараметрыURL.Получить("id"),
            СервисГидрологии.ЛимитСтраницы(Запрос.ПараметрыЗапроса.Получить("limit")), ТекстПараметраЗапроса(Запрос, "cursor", 128));
    КонецЕсли;
    ВызватьИсключение "кабинет_гидрология_некорректно_ввод";
КонецФункции

Функция ЗаписьГидрологии(Действие, УчетнаяЗапись, Запрос, Тело)
    ПроверитьПараметрыГидрологии(Запрос, ""); ПостИд = Запрос.ПараметрыURL.Получить("id");
    Если Действие = "hydrologyCreate" Тогда Операция = "create"; ПостИд = "";
    ИначеЕсли Действие = "hydrologyConfigure" Тогда Операция = "configure";
    ИначеЕсли Действие = "hydrologyMeasure" Тогда Операция = "measure";
    ИначеЕсли Действие = "hydrologyCorrect" Тогда Операция = "correct";
    ИначеЕсли Действие = "hydrologyImport" Тогда Операция = "import";
    ИначеЕсли Действие = "hydrologyGenerate" Тогда Операция = "generate";
    Иначе ВызватьИсключение "кабинет_гидрология_некорректно_ввод";
    КонецЕсли;
    Возврат СервисГидрологии.ВыполнитьКоманду(УчетнаяЗапись, Операция, ПостИд, Тело, ЗаголовокЗапроса(Запрос, "Idempotency-Key"));
КонецФункции

Функция ВнутреннийСбойГидрологии(Знач ТекстОшибки)
    Для Каждого Код Из СтрРазделить("кабинет_гидрология_вложенная_транзакция,кабинет_гидрология_привилегированный_запрещено,кабинет_гидрология_привязка_конфликт", ",") Цикл
        Если СтрНайти(ТекстОшибки, Код) > 0 Тогда Возврат Истина; КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции
