
Функция ДанныеПрофиляБригады(Объект)
    Результат = ДанныеБригады(Объект); Компетенции = Новый Массив;
    Если Объект.КомпетенцииJSON <> "" Тогда Компетенции = ДекодироватьЗначение(Объект.КомпетенцииJSON); КонецЕсли;
    Результат.Вставить("skills", Компетенции);
    Результат.Вставить("shiftFrom", ?(Объект.НачалоСмены = Дата(1, 1, 1), "", XMLСтрока(Объект.НачалоСмены) + "Z"));
    Результат.Вставить("shiftTo", ?(Объект.КонецСмены = Дата(1, 1, 1), "", XMLСтрока(Объект.КонецСмены) + "Z"));
    Возврат Результат;
КонецФункции

Функция ПрочитатьПрофильБригады(УчетнаяЗапись, Идентификатор, История = Ложь, Лимит = 25, Курсор = "") Экспорт
    Ссылка = Справочники.РабочиеБригады.ПолучитьСсылку(РазобратьИдентификатор(Идентификатор));
    Предварительно = Ссылка.ПолучитьОбъект(); Если Предварительно = Неопределено Тогда ВызватьИсключение "кабинет_наряд_не_найдено"; КонецЕсли;
    Контекст = НачатьОперациюВОбласти(УчетнаяЗапись, Строка(Предварительно.РабочееПространство.УникальныйИдентификатор()), Строка(Предварительно.Область.УникальныйИдентификатор()), "Dispatcher");
    Попытка
        Объект = ОбъектБригады(РазобратьИдентификатор(Идентификатор), Контекст);
        Если История Тогда
            Результат = ИсторияПрофиляБригады(УчетнаяЗапись, Объект, Контекст, Лимит, Курсор);
        Иначе
            Результат = ДанныеПрофиляБригады(Объект);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение ОтменитьСобственнуюТранзакцию(); ВызватьИсключение; КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ИсторияПрофиляБригады(УчетнаяЗапись, Объект, Контекст, Лимит, Курсор)
    ПроверитьЛимитСтраницы(Лимит);
    Идентификатор = Строка(Объект.Ссылка.УникальныйИдентификатор());
    Префикс = ПрефиксКурсораСтраницы("crew-profile-history", УчетнаяЗапись,
        Строка(Контекст.РабочееПространство.УникальныйИдентификатор()), Строка(Контекст.Область.УникальныйИдентификатор()), Идентификатор);
    Позиция = ПозицияСтраницы(Курсор, Префикс, Истина);
    ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит + 1, "ЧГ=0") + " Вид, Ревизия, Операция, Причина, ДатаИзменения,
        |ДействующееЛицо, СнимокДоJSON, СнимокПослеJSON ИЗ РегистрСведений.ИсторияНарядов
        |ГДЕ Вид В (&Создание, &Профиль) И ИдентификаторСущности = &Идентификатор
        |И РабочееПространство = &РабочееПространство И Область = &Область";
    Если Позиция.ЕстьПозиция Тогда ТекстЗапроса = ТекстЗапроса + " И Ревизия < &ПослеРевизии"; КонецЕсли;
    Запрос = Новый Запрос(ТекстЗапроса + " УПОРЯДОЧИТЬ ПО Ревизия УБЫВ");
    УстановитьКонтекстОбласти(Запрос, Контекст);
    Запрос.УстановитьПараметр("Создание", "Crew");
    Запрос.УстановитьПараметр("Профиль", "CrewProfile");
    Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
    Если Позиция.ЕстьПозиция Тогда Запрос.УстановитьПараметр("ПослеРевизии", Позиция.Ревизия); КонецЕсли;
    Выборка = Запрос.Выполнить().Выбрать();
    Элементы = Новый Массив; ЕстьЕще = Ложь; Следующий = "";
    Пока Выборка.Следующий() Цикл
        Если Элементы.Количество() = Лимит Тогда ЕстьЕще = Истина; Прервать; КонецЕсли;
        Элементы.Добавить(Новый Структура("revision,operation,reason,changedAt,actorAccountId,before,after",
            Выборка.Ревизия, Выборка.Операция, Выборка.Причина, XMLСтрока(Выборка.ДатаИзменения) + "Z",
            Строка(Выборка.ДействующееЛицо.УникальныйИдентификатор()),
            БезопасныйСнимокОбъекта(ДекодироватьЗначение(Выборка.СнимокДоJSON), Выборка.Вид, Истина),
            БезопасныйСнимокОбъекта(ДекодироватьЗначение(Выборка.СнимокПослеJSON), Выборка.Вид)));
        Следующий = Префикс + Формат(Выборка.Ревизия, "ЧГ=0") + "|-";
    КонецЦикла;
    Возврат Новый Структура("items,limit,hasMore,nextCursor", Элементы, Лимит, ЕстьЕще, ?(ЕстьЕще, Следующий, ""));
КонецФункции

Функция ЗаписатьПрофильБригады(УчетнаяЗапись, Идентификатор, Тело, Ключ) Экспорт
    ПроверитьПоляТелаЗапроса(Тело, "expectedRevision,skills,shiftFrom,shiftTo,reason");
    Компетенции = МассивТекстовыхЗначений(Тело, "skills", 20, 100); Начало = ПолеДаты(Тело, "shiftFrom"); Конец = ПолеДаты(Тело, "shiftTo");
    Если Начало >= Конец Или Конец - Начало > 86400 Тогда ВызватьИсключение "кабинет_наряд_некорректно_даты"; КонецЕсли;
    Причина = ТекстовоеПоле(Тело, "reason", 250);
    Предварительно = Справочники.РабочиеБригады.ПолучитьСсылку(РазобратьИдентификатор(Идентификатор)).ПолучитьОбъект();
    Если Предварительно = Неопределено Тогда ВызватьИсключение "кабинет_наряд_не_найдено"; КонецЕсли;
    Контекст = НачатьОперациюВОбласти(УчетнаяЗапись, Строка(Предварительно.РабочееПространство.УникальныйИдентификатор()), Строка(Предварительно.Область.УникальныйИдентификатор()), "Dispatcher");
    Попытка
        Объект = ОбъектБригады(РазобратьИдентификатор(Идентификатор), Контекст);
        Команда = ОткрытьПривязкуКоманды(УчетнаяЗапись, Ключ, "crew.profile", Контекст, Идентификатор, КодироватьЗначение(Тело, 16000));
        Если Команда.Выбран() Тогда
            Если Команда.ВидСущности <> "CrewProfile" Или Команда.ИдентификаторСущности <> Идентификатор Тогда ВызватьИсключение "кабинет_наряд_привязка_конфликт"; КонецЕсли;
            Результат = БезопасныйСнимокОбъекта(ДекодироватьЗначение(Команда.РезультатJSON), "CrewProfile");
        Иначе
            ПроверитьТекущуюРевизию(Объект, ПолеРевизии(Тело, "expectedRevision"));
            Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Наряды ГДЕ Бригада = &Бригада И НЕ ПометкаУдаления
                |И Состояние В (""Assigned"", ""Accepted"", ""InProgress"", ""Paused"", ""Reported"", ""Verified"")
                |И (ПлановоеНачало < &Начало ИЛИ ПлановоеОкончание > &Конец)");
            Запрос.УстановитьПараметр("Бригада", Объект.Ссылка); Запрос.УстановитьПараметр("Начало", Начало); Запрос.УстановитьПараметр("Конец", Конец);
            Если Не Запрос.Выполнить().Пустой() Тогда ВызватьИсключение "кабинет_наряд_смена_конфликт"; КонецЕсли;
            Перед = ДанныеПрофиляБригады(Объект); Объект.КомпетенцииJSON = КодироватьЗначение(Компетенции, 8192);
            Объект.НачалоСмены = Начало; Объект.КонецСмены = Конец; УвеличитьРевизиюОбъекта(Объект); Объект.Записать();
            Результат = ДанныеПрофиляБригады(Объект);
            ЗавершитьОперацию(Команда, "CrewProfile", Объект, "crew.profile", Причина, Перед, Результат, УчетнаяЗапись, Ключ);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение ОтменитьСобственнуюТранзакцию(); ВызватьИсключение; КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СоздатьЗаказУслуги(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, "workspaceId,areaId,expectedRevision,title,objectDescription,requestedWork");
    ПроверитьНулевоеЗначение(ТелоЗапроса);
    Имя = ТекстовоеПоле(ТелоЗапроса, "title", 150);
    ОбъектРабот = ТекстовоеПоле(ТелоЗапроса, "objectDescription", 250);
    Содержание = ТекстовоеПоле(ТелоЗапроса, "requestedWork", 2000, Истина);
    Намерение = КодироватьЗначение(ТелоЗапроса, 16000);
    КонтекстДоступа = НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, ТекстовоеПоле(ТелоЗапроса, "workspaceId", 36), ТекстовоеПоле(ТелоЗапроса, "areaId", 36), "Dispatcher");
    Попытка
        Команда = ОткрытьПривязкуКоманды(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, "service-order.create", КонтекстДоступа, "", Намерение);
        Если Команда.Выбран() Тогда
            Если Команда.ВидСущности <> "ServiceOrder" Тогда ВызватьИсключение "кабинет_наряд_привязка_конфликт"; КонецЕсли;
            Ссылка = Справочники.ЗаказыУслуг.ПолучитьСсылку(РазобратьИдентификатор(Команда.ИдентификаторСущности));
            Объект = ЗаблокированныйЗаказУслуги(Ссылка, КонтекстДоступа);
            Результат = ПовторитьСохраненныйРезультат(Команда);
            Если Объект.КемСоздано <> СсылкаУчетнойЗаписи Или Результат.createdBy <> Строка(СсылкаУчетнойЗаписи.УникальныйИдентификатор())
                Или КодироватьЗначение(ДанныеЗаказаУслуги(Объект), 24000) <> КодироватьЗначение(Результат, 24000) Тогда
                ВызватьИсключение "кабинет_наряд_привязка_конфликт";
            КонецЕсли;
        Иначе
            УвеличитьРасходКвоты(СсылкаУчетнойЗаписи, КонтекстДоступа, "ServiceOrder", 5000);
            Объект = Справочники.ЗаказыУслуг.СоздатьЭлемент();
            Объект.SetNewObjectRef(Справочники.ЗаказыУслуг.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
            ЗаполнитьСлужебныеОтметки(Объект, СсылкаУчетнойЗаписи, КонтекстДоступа, "Registered");
            Объект.Наименование = Имя;
            Объект.ОбъектРабот = ОбъектРабот;
            Объект.СодержаниеЗаказа = Содержание;
            Объект.Записать();
            Результат = ДанныеЗаказаУслуги(Объект);
            ЗавершитьОперацию(Команда, "ServiceOrder", Объект, "service-order.create", "Registered", Новый Структура, Результат, СсылкаУчетнойЗаписи, ИдентификаторЗапроса);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПолучитьЗаказУслуги(СсылкаУчетнойЗаписи, Идентификатор) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    Ссылка = Справочники.ЗаказыУслуг.ПолучитьСсылку(РазобратьИдентификатор(Идентификатор));
    Предварительный = Ссылка.ПолучитьОбъект();
    Если Предварительный = Неопределено Тогда ВызватьИсключение "кабинет_наряд_не_найдено"; КонецЕсли;
    КонтекстДоступа = НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, Строка(Предварительный.РабочееПространство.УникальныйИдентификатор()), Строка(Предварительный.Область.УникальныйИдентификатор()), "");
    Попытка
        Если Не ЕстьРоль(СсылкаУчетнойЗаписи, КонтекстДоступа, "Dispatcher") Тогда ВызватьИсключение "кабинет_наряд_не_найдено"; КонецЕсли;
        Объект = ЗаблокированныйЗаказУслуги(Ссылка, КонтекстДоступа);
        Результат = ДанныеЗаказаУслуги(Объект);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СписокЗаказовУслуг(СсылкаУчетнойЗаписи, РабочееПространствоId, ОбластьId, Лимит = 25, Курсор = "") Экспорт
    КонтекстДоступа = НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, РабочееПространствоId, ОбластьId, "Dispatcher");
    Попытка
        ПроверитьЛимитСтраницы(Лимит);
        Префикс = ПрефиксКурсораСтраницы("service-orders", СсылкаУчетнойЗаписи,
            Строка(КонтекстДоступа.РабочееПространство.УникальныйИдентификатор()), Строка(КонтекстДоступа.Область.УникальныйИдентификатор()));
        Позиция = ПозицияСтраницы(Курсор, Префикс);
        ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит + 1, "ЧГ=0") + " Ссылка ИЗ Справочник.ЗаказыУслуг
            |ГДЕ РабочееПространство = &РабочееПространство И Область = &Область И НЕ ПометкаУдаления И Состояние = &Состояние";
        Если Позиция.ЕстьПозиция Тогда
            ТекстЗапроса = ТекстЗапроса + " И (ДатаСоздания < &ПослеДаты ИЛИ (ДатаСоздания = &ПослеДаты И Ссылка > &ПослеСсылки))";
        КонецЕсли;
        Запрос = Новый Запрос(ТекстЗапроса + " УПОРЯДОЧИТЬ ПО ДатаСоздания УБЫВ, Ссылка");
        УстановитьКонтекстОбласти(Запрос, КонтекстДоступа);
        Запрос.УстановитьПараметр("Состояние", "Registered");
        Если Позиция.ЕстьПозиция Тогда
            Запрос.УстановитьПараметр("ПослеДаты", Позиция.Дата);
            Запрос.УстановитьПараметр("ПослеСсылки", Справочники.ЗаказыУслуг.ПолучитьСсылку(РазобратьИдентификатор(Позиция.Ид)));
        КонецЕсли;
        Выборка = Запрос.Выполнить().Выбрать();
        Элементы = Новый Массив; ЕстьЕще = Ложь; Следующий = "";
        Пока Выборка.Следующий() Цикл
            Если Элементы.Количество() = Лимит Тогда ЕстьЕще = Истина; Прервать; КонецЕсли;
            Объект = Выборка.Ссылка.ПолучитьОбъект();
            ПроверитьЗаказУслуги(Объект, КонтекстДоступа);
            Элементы.Добавить(ДанныеЗаказаУслуги(Объект));
            Следующий = Префикс + XMLСтрока(Объект.ДатаСоздания) + "Z|" + Строка(Объект.Ссылка.УникальныйИдентификатор());
        КонецЦикла;
        Результат = Новый Структура("items,limit,hasMore,nextCursor", Элементы, Лимит, ЕстьЕще, ?(ЕстьЕще, Следующий, ""));
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ДанныеЗаказаУслуги(Объект)
    Данные = БазовыеДанныеОбъекта(Объект);
    Данные.Вставить("objectDescription", Объект.ОбъектРабот);
    Данные.Вставить("requestedWork", Объект.СодержаниеЗаказа);
    Возврат Данные;
КонецФункции

Процедура ПроверитьЗаказУслуги(Объект, КонтекстДоступа)
    ПроверитьДанныеЭлемента(Объект, КонтекстДоступа);
    Если ТипЗнч(Объект) <> Тип("СправочникОбъект.ЗаказыУслуг") Или Объект.Состояние <> "Registered" Или Объект.Ревизия <> 1
        Или Объект.ДатаСоздания <> Объект.ДатаОбновления Или ПустаяСтрока(Объект.Наименование) Или СтрДлина(Объект.Наименование) > 150
        Или ПустаяСтрока(Объект.ОбъектРабот) Или СтрДлина(Объект.ОбъектРабот) > 250
        Или ПустаяСтрока(Объект.СодержаниеЗаказа) Или СтрДлина(Объект.СодержаниеЗаказа) > 2000 Тогда
        ВызватьИсключение "кабинет_наряд_привязка_конфликт";
    КонецЕсли;
КонецПроцедуры

Функция ЗаблокированныйЗаказУслуги(Ссылка, КонтекстДоступа)
    Если ТипЗнч(Ссылка) <> Тип("СправочникСсылка.ЗаказыУслуг") Или Не ЗначениеЗаполнено(Ссылка) Тогда
        ВызватьИсключение "кабинет_наряд_не_найдено";
    КонецЕсли;
    ЗаблокироватьОбъектПоСсылке("Справочник.ЗаказыУслуг", Ссылка);
    Объект = Ссылка.ПолучитьОбъект();
    ПроверитьЗаказУслуги(Объект, КонтекстДоступа);
    Возврат Объект;
КонецФункции

Функция СоздатьБригаду(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, "workspaceId,areaId,expectedRevision,name,leaderAccountId");
    ПроверитьНулевоеЗначение(ТелоЗапроса);
    Руководитель = Справочники.УчетныеЗаписи.ПолучитьСсылку(РазобратьИдентификатор(ТекстовоеПоле(ТелоЗапроса, "leaderAccountId", 36)));
    Имя = ТекстовоеПоле(ТелоЗапроса, "name", 150);
    КонтекстДоступа = НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, ТекстовоеПоле(ТелоЗапроса, "workspaceId", 36), ТекстовоеПоле(ТелоЗапроса, "areaId", 36), "Dispatcher", Руководитель);
    Попытка
        Намерение = КодироватьЗначение(ТелоЗапроса, 16000);
        Команда = ОткрытьПривязкуКоманды(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, "crew.create", КонтекстДоступа, "", Намерение);
        Если Команда.Выбран() Тогда
            Результат = ПовторитьСохраненныйРезультат(Команда);
        Иначе
            ПроверитьЦелевойОбъект(Руководитель, КонтекстДоступа, "CrewLeader");
            УвеличитьРасходКвоты(СсылкаУчетнойЗаписи, КонтекстДоступа, "Crew", 200);
            УвеличитьРасходКвоты(СсылкаУчетнойЗаписи, КонтекстДоступа, "Member", 2000);
            Объект = Справочники.РабочиеБригады.СоздатьЭлемент();
            Объект.SetNewObjectRef(Справочники.РабочиеБригады.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
            ЗаполнитьСлужебныеОтметки(Объект, СсылкаУчетнойЗаписи, КонтекстДоступа, "Active");
            Объект.Наименование = Имя;
            Объект.УчетнаяЗаписьРуководителя = Руководитель;
            Объект.Записать();
            Участник = Справочники.УчастникиРабочихБригад.СоздатьЭлемент();
            Участник.SetNewObjectRef(Справочники.УчастникиРабочихБригад.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
            ЗаполнитьСлужебныеОтметки(Участник, СсылкаУчетнойЗаписи, КонтекстДоступа, "Active");
            Участник.Наименование = "Crew leader roster";
            Участник.Бригада = Объект.Ссылка;
            Участник.УчетнаяЗапись = Руководитель;
            Участник.Записать();
            ДобавитьЗаписьИстории("Member", Участник, "crew.leader.roster", "Created", КодироватьЗначение(Новый Структура, 24000), КодироватьЗначение(ДанныеУчастникаБригады(Участник), 24000), СсылкаУчетнойЗаписи, ИдентификаторЗапроса);
            Результат = ДанныеБригады(Объект);
            ЗавершитьОперацию(Команда, "Crew", Объект, "crew.create", "Created", Новый Структура, Результат, СсылкаУчетнойЗаписи, ИдентификаторЗапроса);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СтрокиРесурсов(ТелоЗапроса)
    Значения = Неопределено;
    Если Не ТелоЗапроса.Свойство("resources", Значения) Тогда
        ВызватьИсключение "кабинет_наряд_некорректно_поле";
    КонецЕсли;
    Если ТипЗнч(Значения) <> Тип("Массив") Тогда
        ВызватьИсключение "кабинет_наряд_некорректно_поле";
    КонецЕсли;
    Если Значения.Количество() > 16 Тогда
        ВызватьИсключение "кабинет_наряд_ресурс_лимит";
    КонецЕсли;
    Результат = Новый Массив;
    Активность = Новый Соответствие;
    Для Каждого Значение Из Значения Цикл
        ПроверитьПоляТелаЗапроса(Значение, "resourceId,quantity");
        ИдентификаторСсылки = Справочники.РесурсыНарядов.ПолучитьСсылку(РазобратьИдентификатор(ТекстовоеПоле(Значение, "resourceId", 36)));
        Идентификатор = Строка(ИдентификаторСсылки.УникальныйИдентификатор());
        Если Активность.Получить(Идентификатор) <> Неопределено Тогда
            ВызватьИсключение "кабинет_наряд_некорректно_поле";
        КонецЕсли;
        Активность.Вставить(Идентификатор, Истина);
        Результат.Добавить(Новый Структура("Ссылка,Объем", ИдентификаторСсылки, ЧисловоеПолеТела(Значение, "quantity", 0.001, 1000, 3)));
    КонецЦикла;
    Возврат Результат;
КонецФункции

Процедура ЗаблокироватьРесурсы(Строки, НарядСсылка, КонтекстДоступа)
    Отсортированный = Новый ТаблицаЗначений;
    Отсортированный.Колонки.Добавить("Идентификатор");
    Отсортированный.Колонки.Добавить("ИдентификаторСсылки");
    Активность = Новый Соответствие;
    Для Каждого Строка Из Строки Цикл
        ДобавитьБлокировкуРесурса(Отсортированный, Активность, Строка.Ссылка);
    КонецЦикла;
    Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 33 Ресурс ИЗ Справочник.БронированияРесурсовНарядов ГДЕ Наряд = &Наряд И Состояние = &Действующий");
    Запрос.УстановитьПараметр("Наряд", НарядСсылка);
    Запрос.УстановитьПараметр("Действующий", "Active");
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Если Не ЗначениеЗаполнено(Выборка.Ресурс) Тогда
            ВызватьИсключение "кабинет_наряд_привязка_конфликт";
        КонецЕсли;
        ДобавитьБлокировкуРесурса(Отсортированный, Активность, Выборка.Ресурс);
    КонецЦикла;
    Если Отсортированный.Количество() > 32 Тогда
        ВызватьИсключение "кабинет_наряд_привязка_конфликт";
    КонецЕсли;
    Отсортированный.Сортировать("Идентификатор");
    Для Каждого СтрокаВыборки Из Отсортированный Цикл
        ЗаблокироватьОбъектПоСсылке("Справочник.РесурсыНарядов", СтрокаВыборки.ИдентификаторСсылки);
    КонецЦикла;
КонецПроцедуры

Процедура ДобавитьБлокировкуРесурса(Отсортированный, Активность, ИдентификаторСсылки)
    Идентификатор = Строка(ИдентификаторСсылки.УникальныйИдентификатор());
    Если Активность.Получить(Идентификатор) = Неопределено Тогда
        Активность.Вставить(Идентификатор, Истина);
        СтрокаВыборки = Отсортированный.Добавить();
        СтрокаВыборки.Идентификатор = Идентификатор;
        СтрокаВыборки.ИдентификаторСсылки = ИдентификаторСсылки;
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьИнтервалБригады(БригадаСсылка, НарядСсылка, ДатаНачала, ДатаОкончания)
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Наряды ГДЕ Бригада = &Бригада И Ссылка <> &Наряд
        |И Состояние <> &Черновик И Состояние <> &Завершенный И Состояние <> &Закрытый И Состояние <> &Проверенный И Состояние <> &Отмененный
        |И ПлановоеНачало < &ДатаОкончания И ПлановоеОкончание > &ДатаНачала");
    Запрос.УстановитьПараметр("Бригада", БригадаСсылка);
    Запрос.УстановитьПараметр("Наряд", НарядСсылка);
    Запрос.УстановитьПараметр("Черновик", "Draft");
    Запрос.УстановитьПараметр("Завершенный", "Completed");
    Запрос.УстановитьПараметр("Закрытый", "Closed");
    Запрос.УстановитьПараметр("Проверенный", "Verified");
    Запрос.УстановитьПараметр("Отмененный", "Cancelled");
    Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
    Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
    Если Не Запрос.Выполнить().Пустой() Тогда
        ВызватьИсключение "кабинет_наряд_бригада_конфликт";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьВместимостьДляДоставки(Ресурс, ДатаНачала, ДатаОкончания, ИсключениеДоставки = Неопределено) Экспорт
    Если Не ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_наряд_транзакция_требуется"; КонецЕсли;
    ЗаблокироватьОбъектПоСсылке("Справочник.РесурсыНарядов", Ресурс.Ссылка);
    ПроверитьВместимость(Ресурс, Справочники.Наряды.ПустаяСсылка(), ДатаНачала, ДатаОкончания, 1, ИсключениеДоставки);
КонецПроцедуры

Процедура ПроверитьВместимость(Ресурс, НарядСсылка, ДатаНачала, ДатаОкончания, Объем, ИсключениеДоставки = Неопределено)
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 501 ДатаНачала, ДатаОкончания, Объем, РабочееПространство, Область, ПометкаУдаления ИЗ Справочник.БронированияРесурсовНарядов
        |ГДЕ Ресурс = &Ресурс И Наряд <> &Наряд И Состояние = &Действующий
        |И ДатаНачала < &ДатаОкончания И ДатаОкончания > &ДатаНачала УПОРЯДОЧИТЬ ПО ДатаНачала, Ссылка");
    Запрос.УстановитьПараметр("Ресурс", Ресурс.Ссылка);
    Запрос.УстановитьПараметр("Наряд", НарядСсылка);
    Запрос.УстановитьПараметр("Действующий", "Active");
    Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
    Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
    Выборка = Запрос.Выполнить().Выбрать();
    События = Новый ТаблицаЗначений;
    События.Колонки.Добавить("МоментВремя");
    События.Колонки.Добавить("ИзменениеВеличины");
    ДобавитьСобытие(События, ДатаНачала, Объем);
    ДобавитьСобытие(События, ДатаОкончания, -Объем);
    Количество = 0;
    Пока Выборка.Следующий() Цикл
        Количество = Количество + 1;
        Если Количество > 500 Тогда
            ВызватьИсключение "кабинет_наряд_пересечение_лимит";
        КонецЕсли;
        Если Выборка.ПометкаУдаления Или Выборка.РабочееПространство <> Ресурс.РабочееПространство Или Выборка.Область <> Ресурс.Область
            Или Выборка.ДатаНачала >= Выборка.ДатаОкончания Или Выборка.Объем <= 0 Или Выборка.Объем > 1000 Или Окр(Выборка.Объем, 3) <> Выборка.Объем Тогда
            ВызватьИсключение "кабинет_наряд_привязка_конфликт";
        КонецЕсли;
        ОграничитьНачатьВыполнение = Выборка.ДатаНачала;
        ОграничитьКонец = Выборка.ДатаОкончания;
        Если ОграничитьНачатьВыполнение < ДатаНачала Тогда
            ОграничитьНачатьВыполнение = ДатаНачала;
        КонецЕсли;
        Если ОграничитьКонец > ДатаОкончания Тогда
            ОграничитьКонец = ДатаОкончания;
        КонецЕсли;
        ДобавитьСобытие(События, ОграничитьНачатьВыполнение, Выборка.Объем);
        ДобавитьСобытие(События, ОграничитьКонец, -Выборка.Объем);
    КонецЦикла;
    Для Каждого Доставка Из СервисВодоснабжения.СобытияЗанятостиДоставки(Ресурс.Ссылка, ДатаНачала, ДатаОкончания, ИсключениеДоставки) Цикл
        НачалоДоставки = Макс(ДатаНачала, Доставка.ДатаНачала);
        КонецДоставки = Мин(ДатаОкончания, Доставка.ДатаОкончания);
        Если НачалоДоставки >= КонецДоставки Или Доставка.Объем <= 0 Тогда ВызватьИсключение "кабинет_наряд_привязка_конфликт"; КонецЕсли;
        ДобавитьСобытие(События, НачалоДоставки, Доставка.Объем);
        ДобавитьСобытие(События, КонецДоставки, -Доставка.Объем);
    КонецЦикла;
    События.Сортировать("МоментВремя, ИзменениеВеличины");
    Использованный = 0;
    Для Каждого Событие Из События Цикл
        Использованный = Использованный + Событие.ИзменениеВеличины;
        Если Использованный > Ресурс.Вместимость Тогда
            ВызватьИсключение "кабинет_наряд_вместимость_конфликт";
        КонецЕсли;
    КонецЦикла;
    Если Использованный <> 0 Тогда
        ВызватьИсключение "кабинет_наряд_привязка_конфликт";
    КонецЕсли;
КонецПроцедуры

Процедура ДобавитьСобытие(События, МоментВремя, ИзменениеВеличины)
    СтрокаВыборки = События.Добавить();
    СтрокаВыборки.МоментВремя = МоментВремя;
    СтрокаВыборки.ИзменениеВеличины = ИзменениеВеличины;
КонецПроцедуры

Процедура ОсвободитьБронирования(НарядСсылка)
    Наряд = НарядСсылка.ПолучитьОбъект();
    КонтекстДоступа = Новый Структура("РабочееПространство,Область", Наряд.РабочееПространство, Наряд.Область);
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 17 Ссылка ИЗ Справочник.БронированияРесурсовНарядов ГДЕ Наряд = &Наряд И Состояние = &Действующий УПОРЯДОЧИТЬ ПО Ресурс, Ссылка");
    Запрос.УстановитьПараметр("Наряд", НарядСсылка);
    Запрос.УстановитьПараметр("Действующий", "Active");
    Выборка = Запрос.Выполнить().Выбрать();
    Количество = 0;
    Пока Выборка.Следующий() Цикл
        Количество = Количество + 1;
        Если Количество > 16 Тогда
            ВызватьИсключение "кабинет_наряд_привязка_конфликт";
        КонецЕсли;
        Бронирование = Выборка.Ссылка.ПолучитьОбъект();
        ПроверитьДанныеЭлемента(Бронирование, КонтекстДоступа);
        Бронирование.Состояние = "Released";
        УвеличитьРевизиюОбъекта(Бронирование);
        Бронирование.Записать();
    КонецЦикла;
КонецПроцедуры

Функция МаршрутКоманды(СсылкаУчетнойЗаписи, ИдентификаторЗапроса)
    ЗаписьДанных = РегистрыСведений.ПривязкиКомандНарядов.СоздатьМенеджерЗаписи();
    ЗаписьДанных.УчетнаяЗапись = СсылкаУчетнойЗаписи;
    ЗаписьДанных.ИдентификаторЗапроса = Строка(РазобратьИдентификатор(ИдентификаторЗапроса));
    ЗаписьДанных.Прочитать();
    Если Не ЗаписьДанных.Выбран() Тогда
        Возврат Неопределено;
    КонецЕсли;
    Возврат Новый Структура("Операция,ВидСущности,ИдентификаторСущности,ИдентификаторЦели,РабочееПространство,Область,РевизияРезультата,ИдентификаторЗапроса,УчетнаяЗапись",
        ЗаписьДанных.Операция, ЗаписьДанных.ВидСущности, ЗаписьДанных.ИдентификаторСущности, ЗаписьДанных.ИдентификаторЦели, ЗаписьДанных.РабочееПространство, ЗаписьДанных.Область,
        ЗаписьДанных.РевизияРезультата, ЗаписьДанных.ИдентификаторЗапроса, ЗаписьДанных.УчетнаяЗапись);
КонецФункции

Функция ОткрытьПривязкуКоманды(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, Операция, КонтекстДоступа, ИдентификаторЦели, Намерение)
    ЗапросКлиентаКлюч = Строка(РазобратьИдентификатор(ИдентификаторЗапроса));
    Если ИдентификаторЦели <> "" Тогда
        ИдентификаторЦели = Строка(РазобратьИдентификатор(ИдентификаторЦели));
    КонецЕсли;
    Блокировка = Новый БлокировкаДанных;
    БлокировкаЗапись = Блокировка.Добавить("РегистрСведений.ПривязкиКомандНарядов");
    БлокировкаЗапись.УстановитьЗначение("УчетнаяЗапись", СсылкаУчетнойЗаписи);
    БлокировкаЗапись.УстановитьЗначение("ИдентификаторЗапроса", ЗапросКлиентаКлюч);
    БлокировкаЗапись.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
    ЗаписьДанных = РегистрыСведений.ПривязкиКомандНарядов.СоздатьМенеджерЗаписи();
    ЗаписьДанных.УчетнаяЗапись = СсылкаУчетнойЗаписи;
    ЗаписьДанных.ИдентификаторЗапроса = ЗапросКлиентаКлюч;
    ЗаписьДанных.Прочитать();
    Если ЗаписьДанных.Выбран() Тогда
        Если ЗаписьДанных.Операция <> Операция Или ЗаписьДанных.ИдентификаторЦели <> ИдентификаторЦели Или ЗаписьДанных.НамерениеJSON <> Намерение
            Или ЗаписьДанных.РабочееПространство <> КонтекстДоступа.РабочееПространство Или ЗаписьДанных.Область <> КонтекстДоступа.Область Тогда
            ВызватьИсключение "кабинет_наряд_запрос_конфликт";
        КонецЕсли;
    Иначе
        ЗаписьДанных.УчетнаяЗапись = СсылкаУчетнойЗаписи;
        ЗаписьДанных.ИдентификаторЗапроса = ЗапросКлиентаКлюч;
        ЗаписьДанных.Операция = Операция;
        ЗаписьДанных.ИдентификаторЦели = ИдентификаторЦели;
        ЗаписьДанных.НамерениеJSON = Намерение;
        ЗаписьДанных.РабочееПространство = КонтекстДоступа.РабочееПространство;
        ЗаписьДанных.Область = КонтекстДоступа.Область;
    КонецЕсли;
    Возврат ЗаписьДанных;
КонецФункции

Функция ПовторитьКомандуНаряда(СсылкаУчетнойЗаписи, Маршрут, ИдентификаторЗапроса, Операция, ИдентификаторЦели, Намерение)
    Если Маршрут.Операция <> Операция Или Маршрут.ВидСущности <> "Order" Или Маршрут.ИдентификаторЦели <> КаноническийИдентификаторИлиПустоеЗначение(ИдентификаторЦели) Тогда
        ВызватьИсключение "кабинет_наряд_запрос_конфликт";
    КонецЕсли;
    КонтекстДоступа = НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, Строка(Маршрут.РабочееПространство.УникальныйИдентификатор()), Строка(Маршрут.Область.УникальныйИдентификатор()), "Dispatcher");
    Попытка
        Результат = ПовторитьКомандуНарядаВОбласти(СсылкаУчетнойЗаписи, Маршрут, ИдентификаторЗапроса, Операция, ИдентификаторЦели, Намерение, КонтекстДоступа);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПовторитьКомандуНарядаВОбласти(СсылкаУчетнойЗаписи, Маршрут, ИдентификаторЗапроса, Операция, ИдентификаторЦели, Намерение, КонтекстДоступа)
    Если Маршрут.Операция <> Операция Или Маршрут.ВидСущности <> "Order" Или Маршрут.ИдентификаторЦели <> КаноническийИдентификаторИлиПустоеЗначение(ИдентификаторЦели)
        Или Маршрут.РабочееПространство <> КонтекстДоступа.РабочееПространство Или Маршрут.Область <> КонтекстДоступа.Область Тогда
        ВызватьИсключение "кабинет_наряд_запрос_конфликт";
    КонецЕсли;
    ПредварительныйСнимок = ПредставлениеЗаказа(РазобратьИдентификатор(Маршрут.ИдентификаторСущности));
    ЗаблокироватьСвязиНаряда(ПредварительныйСнимок, КонтекстДоступа);
    Объект = ОбъектНаряда(ПредварительныйСнимок.Ссылка, КонтекстДоступа);
    ПроверитьПредставлениеНаряда(Объект, ПредварительныйСнимок);
    Команда = ОткрытьПривязкуКоманды(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, Операция, КонтекстДоступа, ИдентификаторЦели, Намерение);
    Если Не Команда.Выбран() Или Команда.ИдентификаторСущности <> Строка(Объект.Ссылка.УникальныйИдентификатор()) Тогда
        ВызватьИсключение "кабинет_наряд_привязка_конфликт";
    КонецЕсли;
    Возврат ПовторитьСохраненныйРезультат(Команда);
КонецФункции

Функция ПовторитьКомандуБригадира(СсылкаУчетнойЗаписи, Идентификатор, Действие, ТелоЗапроса, ИдентификаторЗапроса, Маршрут)
    Если Маршрут.Операция <> "leader." + Действие Или Маршрут.ВидСущности <> "Order" Или Маршрут.ИдентификаторСущности <> Строка(РазобратьИдентификатор(Идентификатор)) Тогда
        ВызватьИсключение "кабинет_наряд_запрос_конфликт";
    КонецЕсли;
    КонтекстДоступа = НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, Строка(Маршрут.РабочееПространство.УникальныйИдентификатор()), Строка(Маршрут.Область.УникальныйИдентификатор()), "CrewLeader");
    Попытка
        История = ПрочитатьИсториюКоманды(Маршрут);
        Исходный = БезопасныйСнимокОбъекта(ДекодироватьЗначение(История.СнимокДоJSON), "Order");
        Если Исходный.leaderAccountId <> Строка(СсылкаУчетнойЗаписи.УникальныйИдентификатор()) Или ПустаяСтрока(Исходный.crewId) Тогда
            ВызватьИсключение "кабинет_наряд_не_найдено";
        КонецЕсли;
        ПредварительныйСнимок = ПредставлениеЗаказа(РазобратьИдентификатор(Идентификатор));
        ЗаблокироватьИсточник(ПредварительныйСнимок.ИсходныйИнцидент, ПредварительныйСнимок.ИсходноеОбращение, ПредварительныйСнимок.ИсходныйЗаказУслуги);
        Бригада = ОбъектБригады(РазобратьИдентификатор(Исходный.crewId), КонтекстДоступа);
        Если Бригада.УчетнаяЗаписьРуководителя <> СсылкаУчетнойЗаписи Тогда
            ВызватьИсключение "кабинет_наряд_не_найдено";
        КонецЕсли;
        ПроверитьСоставБригады(Бригада.Ссылка, СсылкаУчетнойЗаписи, КонтекстДоступа);
        Объект = ОбъектНаряда(ПредварительныйСнимок.Ссылка, КонтекстДоступа);
        ПроверитьПредставлениеНаряда(Объект, ПредварительныйСнимок);
        Команда = ОткрытьПривязкуКоманды(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, "leader." + Действие, КонтекстДоступа, Идентификатор, КодироватьЗначение(ТелоЗапроса, 16000));
        Если Не Команда.Выбран() Тогда
            ВызватьИсключение "кабинет_наряд_привязка_конфликт";
        КонецЕсли;
        Результат = ПовторитьСохраненныйРезультат(Команда);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПрочитатьИсториюКоманды(Команда)
    ЗаписьДанных = РегистрыСведений.ИсторияНарядов.СоздатьМенеджерЗаписи();
    ЗаписьДанных.Вид = Команда.ВидСущности;
    ЗаписьДанных.ИдентификаторСущности = Команда.ИдентификаторСущности;
    ЗаписьДанных.Ревизия = Команда.РевизияРезультата;
    ЗаписьДанных.Прочитать();
    Если Не ЗаписьДанных.Выбран() Тогда
        ВызватьИсключение "кабинет_наряд_привязка_конфликт";
    КонецЕсли;
    Если ЗаписьДанных.РабочееПространство <> Команда.РабочееПространство Или ЗаписьДанных.Область <> Команда.Область Или ЗаписьДанных.ДействующееЛицо <> Команда.УчетнаяЗапись
        Или ЗаписьДанных.ИдентификаторЗапроса <> Команда.ИдентификаторЗапроса Или ЗаписьДанных.Операция <> Команда.Операция Тогда
        ВызватьИсключение "кабинет_наряд_привязка_конфликт";
    КонецЕсли;
    Возврат ЗаписьДанных;
КонецФункции

Функция ПовторитьСохраненныйРезультат(Команда)
    История = ПрочитатьИсториюКоманды(Команда);
    Если История.СнимокПослеJSON <> Команда.РезультатJSON Тогда
        ВызватьИсключение "кабинет_наряд_привязка_конфликт";
    КонецЕсли;
    Результат = БезопасныйСнимокОбъекта(ДекодироватьЗначение(Команда.РезультатJSON), Команда.ВидСущности);
    Если Результат.id <> Команда.ИдентификаторСущности Или Результат.revision <> Команда.РевизияРезультата
        Или Результат.workspaceId <> Строка(Команда.РабочееПространство.УникальныйИдентификатор()) Или Результат.areaId <> Строка(Команда.Область.УникальныйИдентификатор()) Тогда
        ВызватьИсключение "кабинет_наряд_привязка_конфликт";
    КонецЕсли;
    Возврат Результат;
КонецФункции

Процедура ЗавершитьОперацию(Команда, Вид, Объект, Операция, Причина, Перед, После, СсылкаУчетнойЗаписи, ИдентификаторЗапроса)
    КонтекстДоступа = Новый Структура("РабочееПространство,Область", Объект.РабочееПространство, Объект.Область);
    УвеличитьРасходКвоты(СсылкаУчетнойЗаписи, КонтекстДоступа, "Command", 100000);
    СнимокПослеJSON = КодироватьЗначение(БезопасныйСнимокОбъекта(После, Вид), 24000);
    ДобавитьЗаписьИстории(Вид, Объект, Операция, Причина, КодироватьЗначение(БезопасныйСнимокОбъекта(Перед, Вид, Истина), 24000), СнимокПослеJSON, СсылкаУчетнойЗаписи, ИдентификаторЗапроса);
    Команда.ВидСущности = Вид;
    Команда.ИдентификаторСущности = Строка(Объект.Ссылка.УникальныйИдентификатор());
    Команда.РевизияРезультата = Объект.Ревизия;
    Команда.РезультатJSON = СнимокПослеJSON;
    Команда.Записать();
    Если Вид = "Order" И ЗначениеЗаполнено(Объект.УчетнаяЗаписьРуководителя) Тогда
        ИдСобытия = Строка(Объект.Ссылка.УникальныйИдентификатор());
        СервисУведомлений.СоздатьСобытие(Объект.УчетнаяЗаписьРуководителя, "assignment", "work:" + ИдСобытия + ":" + Формат(Объект.Ревизия, "ЧГ=0"), ИдСобытия, Объект.Состояние, Объект.РабочееПространство);
    КонецЕсли;
    ПолитикаДоступа.ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, Объект.РабочееПространство, "work." + Операция, Строка(Объект.Ссылка.УникальныйИдентификатор()));
КонецПроцедуры

Процедура ДобавитьЗаписьИстории(Вид, Объект, Операция, Причина, СнимокДоJSON, СнимокПослеJSON, СсылкаУчетнойЗаписи, ИдентификаторЗапроса)
    ИдентификаторСущности = Строка(Объект.Ссылка.УникальныйИдентификатор());
    Блокировка = Новый БлокировкаДанных;
    БлокировкаЗапись = Блокировка.Добавить("РегистрСведений.ИсторияНарядов");
    БлокировкаЗапись.УстановитьЗначение("Вид", Вид);
    БлокировкаЗапись.УстановитьЗначение("ИдентификаторСущности", ИдентификаторСущности);
    БлокировкаЗапись.УстановитьЗначение("Ревизия", Объект.Ревизия);
    БлокировкаЗапись.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
    История = РегистрыСведений.ИсторияНарядов.СоздатьМенеджерЗаписи();
    История.Вид = Вид;
    История.ИдентификаторСущности = ИдентификаторСущности;
    История.Ревизия = Объект.Ревизия;
    История.Прочитать();
    Если История.Выбран() Тогда
        ВызватьИсключение "кабинет_наряд_привязка_конфликт";
    КонецЕсли;
    История.Вид = Вид;
    История.ИдентификаторСущности = ИдентификаторСущности;
    История.Ревизия = Объект.Ревизия;
    История.РабочееПространство = Объект.РабочееПространство;
    История.Область = Объект.Область;
    История.ДействующееЛицо = СсылкаУчетнойЗаписи;
    История.ДатаИзменения = Объект.ДатаОбновления;
    История.Операция = Операция;
    История.Причина = Причина;
    История.СнимокДоJSON = СнимокДоJSON;
    История.СнимокПослеJSON = СнимокПослеJSON;
    История.ИдентификаторЗапроса = Строка(РазобратьИдентификатор(ИдентификаторЗапроса));
    История.Записать();
КонецПроцедуры

Процедура УвеличитьРасходКвоты(СсылкаУчетнойЗаписи, КонтекстДоступа, ВидСущности, Максимум)
    УвеличитьСчетчик("Account", Строка(СсылкаУчетнойЗаписи.УникальныйИдентификатор()), ВидСущности, Максимум);
    УвеличитьСчетчик("Workspace", Строка(КонтекстДоступа.РабочееПространство.УникальныйИдентификатор()), ВидСущности, Максимум * 10);
КонецПроцедуры

Процедура УвеличитьСчетчик(ВидОбластиДействия, ИдентификаторОбластиДействия, ВидСущности, Максимум)
    Блокировка = Новый БлокировкаДанных;
    БлокировкаЗапись = Блокировка.Добавить("РегистрСведений.КвотыОбластейДействияНарядов");
    БлокировкаЗапись.УстановитьЗначение("ВидОбластиДействия", ВидОбластиДействия);
    БлокировкаЗапись.УстановитьЗначение("ИдентификаторОбластиДействия", ИдентификаторОбластиДействия);
    БлокировкаЗапись.УстановитьЗначение("ВидСущности", ВидСущности);
    БлокировкаЗапись.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
    Счетчик = РегистрыСведений.КвотыОбластейДействияНарядов.СоздатьМенеджерЗаписи();
    Счетчик.ВидОбластиДействия = ВидОбластиДействия;
    Счетчик.ИдентификаторОбластиДействия = ИдентификаторОбластиДействия;
    Счетчик.ВидСущности = ВидСущности;
    Счетчик.Прочитать();
    Количество = 0;
    Если Счетчик.Выбран() Тогда
        Количество = Счетчик.Количество;
    КонецЕсли;
    Если Количество < 0 Или Количество <> Цел(Количество) Или Количество >= Максимум Тогда
        ВызватьИсключение "кабинет_наряд_квота_превышено";
    КонецЕсли;
    Счетчик.ВидОбластиДействия = ВидОбластиДействия;
    Счетчик.ИдентификаторОбластиДействия = ИдентификаторОбластиДействия;
    Счетчик.ВидСущности = ВидСущности;
    Счетчик.Количество = Количество + 1;
    Счетчик.Записать();
КонецПроцедуры

Функция ПривязкаДопуска(НарядСсылка, Адресат)
    Блокировка = Новый БлокировкаДанных;
    БлокировкаЗапись = Блокировка.Добавить("РегистрСведений.ПривязкиРазрешенийНарядов");
    БлокировкаЗапись.УстановитьЗначение("Наряд", НарядСсылка);
    БлокировкаЗапись.УстановитьЗначение("УчетнаяЗапись", Адресат);
    БлокировкаЗапись.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
    ЗаписьДанных = РегистрыСведений.ПривязкиРазрешенийНарядов.СоздатьМенеджерЗаписи();
    ЗаписьДанных.Наряд = НарядСсылка;
    ЗаписьДанных.УчетнаяЗапись = Адресат;
    ЗаписьДанных.Прочитать();
    Возврат ЗаписьДанных;
КонецФункции

Функция ОбъектДопускаКНаряду(ИдентификаторСсылки, Объект, КонтекстДоступа)
    ЗаблокироватьОбъектПоСсылке("Справочник.РазрешенияНарядов", ИдентификаторСсылки);
    Разрешение = ИдентификаторСсылки.ПолучитьОбъект();
    ПроверитьДанныеЭлемента(Разрешение, КонтекстДоступа);
    Если Разрешение.Наряд <> Объект.Ссылка Или Разрешение.Выдавший <> Объект.ДиспетчерАвтор Или Разрешение.Полномочие <> "AppendixRead"
        Или Разрешение.Поколение < 1 Или Разрешение.Поколение <> Цел(Разрешение.Поколение)
        Или СтрРазделить("Pending,Accepted,Declined,Revoked", ",").Найти(Разрешение.Состояние) = Неопределено Тогда
        ВызватьИсключение "кабинет_наряд_привязка_конфликт";
    КонецЕсли;
    Возврат Разрешение;
КонецФункции

Процедура ПроверитьДействующийДопуск(Привязка, Разрешение, Получатель)
    Если Разрешение.Получатель <> Получатель Тогда
        ВызватьИсключение "кабинет_наряд_не_найдено";
    КонецЕсли;
    Если Не Привязка.Выбран() Тогда
        ВызватьИсключение "кабинет_наряд_поколение_конфликт";
    КонецЕсли;
    Если Привязка.Разрешение <> Разрешение.Ссылка Или Привязка.Поколение <> Разрешение.Поколение Тогда
        ВызватьИсключение "кабинет_наряд_поколение_конфликт";
    КонецЕсли;
КонецПроцедуры

Функция ТекущаяВерсияПриложенияНаряда(НарядСсылка)
    Блокировка = Новый БлокировкаДанных;
    БлокировкаЗапись = Блокировка.Добавить("РегистрСведений.ТекущиеВерсииПриложенийНарядов");
    БлокировкаЗапись.УстановитьЗначение("Наряд", НарядСсылка);
    БлокировкаЗапись.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
    ЗаписьДанных = РегистрыСведений.ТекущиеВерсииПриложенийНарядов.СоздатьМенеджерЗаписи();
    ЗаписьДанных.Наряд = НарядСсылка;
    ЗаписьДанных.Прочитать();
    Возврат ЗаписьДанных;
КонецФункции

Функция БазовыеДанныеОбъекта(Объект)
    Возврат Новый Структура("id,workspaceId,areaId,name,state,revision,createdBy,createdAt,updatedAt",
        Строка(Объект.Ссылка.УникальныйИдентификатор()), Строка(Объект.РабочееПространство.УникальныйИдентификатор()), Строка(Объект.Область.УникальныйИдентификатор()), Объект.Наименование,
        Объект.Состояние, Объект.Ревизия, Строка(Объект.КемСоздано.УникальныйИдентификатор()), XMLСтрока(Объект.ДатаСоздания) + "Z", XMLСтрока(Объект.ДатаОбновления) + "Z");
КонецФункции

Функция ДанныеБригады(Объект)
    Данные = БазовыеДанныеОбъекта(Объект);
    Данные.Вставить("leaderAccountId", Строка(Объект.УчетнаяЗаписьРуководителя.УникальныйИдентификатор()));
    Возврат Данные;
КонецФункции

Функция ДанныеУчастникаБригады(Объект)
    Данные = БазовыеДанныеОбъекта(Объект);
    Данные.Вставить("crewId", Строка(Объект.Бригада.УникальныйИдентификатор()));
    Данные.Вставить("accountId", Строка(Объект.УчетнаяЗапись.УникальныйИдентификатор()));
    Возврат Данные;
КонецФункции

Функция ДанныеРесурса(Объект)
    Данные = БазовыеДанныеОбъекта(Объект);
    Данные.Вставить("capacity", Объект.Вместимость);
    Возврат Данные;
КонецФункции

Функция ДанныеЗаказа(Объект)
    Данные = БазовыеДанныеОбъекта(Объект);
    Данные.Вставить("authorDispatcherAccountId", Строка(Объект.ДиспетчерАвтор.УникальныйИдентификатор()));
    Данные.Вставить("sourceKind", Объект.ВидИсточника);
    Данные.Вставить("sourceRequestId", НеобязательныйИдентификатор(Объект.ИсходноеОбращение));
    Данные.Вставить("sourceIncidentId", НеобязательныйИдентификатор(Объект.ИсходныйИнцидент));
    Если Объект.ВидИсточника = "ServiceOrder" Тогда
        Если Не ЗначениеЗаполнено(Объект.ИсходныйЗаказУслуги) Или ЗначениеЗаполнено(Объект.ИсходноеОбращение)
            Или ЗначениеЗаполнено(Объект.ИсходныйИнцидент) Или Объект.ОбязателенДляИнцидента Тогда
            ВызватьИсключение "кабинет_наряд_привязка_конфликт";
        КонецЕсли;
        ПроверитьЗаказУслуги(Объект.ИсходныйЗаказУслуги.ПолучитьОбъект(), Новый Структура("РабочееПространство,Область", Объект.РабочееПространство, Объект.Область));
        Данные.Вставить("sourceServiceOrderId", НеобязательныйИдентификатор(Объект.ИсходныйЗаказУслуги));
    ИначеЕсли ЗначениеЗаполнено(Объект.ИсходныйЗаказУслуги) Тогда
        ВызватьИсключение "кабинет_наряд_привязка_конфликт";
    КонецЕсли;
    Данные.Вставить("requiredForIncident", Объект.ОбязателенДляИнцидента);
    Данные.Вставить("task", Объект.ТекстЗадания);
    Данные.Вставить("checklist", ДекодироватьЗначение(Объект.КонтрольныйСписокJSON));
    Данные.Вставить("priority", Объект.Приоритет);
    Данные.Вставить("plannedFrom", XMLСтрока(Объект.ПлановоеНачало) + "Z");
    Данные.Вставить("plannedTo", XMLСтрока(Объект.ПлановоеОкончание) + "Z");
    Данные.Вставить("crewId", НеобязательныйИдентификатор(Объект.Бригада));
    Данные.Вставить("leaderAccountId", НеобязательныйИдентификатор(Объект.УчетнаяЗаписьРуководителя));
    Данные.Вставить("result", Объект.ТекстРезультата);
    Данные.Вставить("startedAt", XMLСтрока(Объект.ДатаФактическогоНачала) + "Z");
    Данные.Вставить("pausedAt", XMLСтрока(Объект.ДатаПриостановки) + "Z");
    Данные.Вставить("submittedAt", XMLСтрока(Объект.ДатаПодачи) + "Z");
    Данные.Вставить("completedAt", XMLСтрока(Объект.ДатаВыполнения) + "Z");
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 17 Ресурс, Объем ИЗ Справочник.БронированияРесурсовНарядов ГДЕ Наряд = &Наряд И Состояние = &Действующий И НЕ ПометкаУдаления УПОРЯДОЧИТЬ ПО Ресурс");
    Запрос.УстановитьПараметр("Наряд", Объект.Ссылка);
    Запрос.УстановитьПараметр("Действующий", "Active");
    Выборка = Запрос.Выполнить().Выбрать();
    Строки = Новый Массив;
    Пока Выборка.Следующий() Цикл
        Если Строки.Количество() >= 16 Тогда
            ВызватьИсключение "кабинет_наряд_привязка_конфликт";
        КонецЕсли;
        Строки.Добавить(Новый Структура("resourceId,quantity", Строка(Выборка.Ресурс.УникальныйИдентификатор()), Выборка.Объем));
    КонецЦикла;
    Данные.Вставить("resources", Строки);
    Возврат Данные;
КонецФункции

Функция ДанныеДопускаКНаряду(Объект)
    Данные = БазовыеДанныеОбъекта(Объект);
    Данные.Вставить("workOrderId", Строка(Объект.Наряд.УникальныйИдентификатор()));
    Данные.Вставить("recipientAccountId", Строка(Объект.Получатель.УникальныйИдентификатор()));
    Данные.Вставить("issuerAccountId", Строка(Объект.Выдавший.УникальныйИдентификатор()));
    Данные.Вставить("capability", Объект.Полномочие);
    Данные.Вставить("expiresAt", XMLСтрока(Объект.СрокИстечения) + "Z");
    Данные.Вставить("generation", Объект.Поколение);
    Данные.Вставить("decidedAt", XMLСтрока(Объект.ДатаРешения) + "Z");
    Данные.Вставить("reason", Объект.ОснованиеРешения);
    Данные.Вставить("stateFromRevision", Объект.РевизияДоИзмененияСостояния);
    Возврат Данные;
КонецФункции

Функция ДанныеПриложенияНаряда(Объект)
    Данные = БазовыеДанныеОбъекта(Объект);
    Данные.Вставить("workOrderId", Строка(Объект.Наряд.УникальныйИдентификатор()));
    Данные.Вставить("authorAccountId", Строка(Объект.Автор.УникальныйИдентификатор()));
    Данные.Вставить("version", Объект.Версия);
    Возврат Данные;
КонецФункции

Функция БезопасныйСнимокОбъекта(Данные, Вид, ПустойРазрешенные = Ложь)
    Если ТипЗнч(Данные) <> Тип("Структура") Тогда
        ВызватьИсключение "кабинет_наряд_привязка_конфликт";
    КонецЕсли;
    Если ПустойРазрешенные И Данные.Количество() = 0 Тогда
        Возврат Новый Структура;
    КонецЕсли;
    Поля = "id,workspaceId,areaId,name,state,revision,createdBy,createdAt,updatedAt";
    Если Вид = "Crew" Тогда
        Поля = Поля + ",leaderAccountId";
    ИначеЕсли Вид = "CrewProfile" Тогда
        Поля = Поля + ",leaderAccountId,skills,shiftFrom,shiftTo";
    ИначеЕсли Вид = "Member" Тогда
        Поля = Поля + ",crewId,accountId";
    ИначеЕсли Вид = "Resource" Тогда
        Поля = Поля + ",capacity";
    ИначеЕсли Вид = "ServiceOrder" Тогда
        Поля = Поля + ",objectDescription,requestedWork";
    ИначеЕсли Вид = "Order" Тогда
        Поля = Поля + ",authorDispatcherAccountId,sourceKind,sourceRequestId,sourceIncidentId,requiredForIncident,task,checklist,priority,plannedFrom,plannedTo,crewId,leaderAccountId,result,startedAt,pausedAt,submittedAt,completedAt,resources";
        ВидИсточникаСнимка = "";
        Если Не Данные.Свойство("sourceKind", ВидИсточникаСнимка) Тогда ВызватьИсключение "кабинет_наряд_привязка_конфликт"; КонецЕсли;
        Если ВидИсточникаСнимка = "ServiceOrder" Тогда Поля = Поля + ",sourceServiceOrderId"; КонецЕсли;
    ИначеЕсли Вид = "Permit" Тогда
        Поля = Поля + ",workOrderId,recipientAccountId,issuerAccountId,capability,expiresAt,generation,decidedAt,reason,stateFromRevision";
    ИначеЕсли Вид = "Appendix" Тогда
        Поля = Поля + ",workOrderId,authorAccountId,version";
    ИначеЕсли Вид = "Photo" Тогда
        Поля = Поля + ",workOrderId,filename,mime,byteLength,sha256,authorAccountId";
    Иначе
        ВызватьИсключение "кабинет_наряд_привязка_конфликт";
    КонецЕсли;
    Разрешенные = СтрРазделить(Поля, ",");
    Если Данные.Количество() <> Разрешенные.Количество() Тогда
        ВызватьИсключение "кабинет_наряд_привязка_конфликт";
    КонецЕсли;
    Результат = Новый Структура;
    Для Каждого ПолеИмя Из Разрешенные Цикл
        Значение = Неопределено;
        Если Не Данные.Свойство(ПолеИмя, Значение) Тогда
            ВызватьИсключение "кабинет_наряд_привязка_конфликт";
        КонецЕсли;
        Если ПолеИмя = "skills" Тогда
            Значение = МассивТекстовыхЗначений(Данные, ПолеИмя, 20, 100);
        ИначеЕсли ПолеИмя = "checklist" Тогда
            Значение = МассивТекстовыхЗначений(Данные, ПолеИмя, 20, 250);
        ИначеЕсли ПолеИмя = "resources" Тогда
            Строки = СтрокиРесурсов(Данные);
            Значение = Новый Массив;
            Для Каждого Строка Из Строки Цикл
                Значение.Добавить(Новый Структура("resourceId,quantity", Строка(Строка.Ссылка.УникальныйИдентификатор()), Строка.Объем));
            КонецЦикла;
        ИначеЕсли ПолеИмя = "requiredForIncident" Тогда
            Значение = ЛогическоеПоле(Данные, ПолеИмя);
        ИначеЕсли СтрРазделить("revision,capacity,generation,stateFromRevision,version,byteLength", ",").Найти(ПолеИмя) <> Неопределено Тогда
            Минимум = 1;
            Максимум = 999999999999997;
            Если ПолеИмя = "stateFromRevision" Тогда
                Минимум = 0;
            ИначеЕсли ПолеИмя = "capacity" Или ПолеИмя = "version" Тогда
                Максимум = 1000;
            ИначеЕсли ПолеИмя = "byteLength" Тогда
                Максимум = 5242880;
            КонецЕсли;
            Значение = ЧисловоеПолеТела(Данные, ПолеИмя, Минимум, Максимум, 0);
        Иначе
            Если ТипЗнч(Значение) <> Тип("Строка") Тогда
                ВызватьИсключение "кабинет_наряд_привязка_конфликт";
            КонецЕсли;
            Если СтрДлина(Значение) > 4000 Тогда
                ВызватьИсключение "кабинет_наряд_привязка_конфликт";
            КонецЕсли;
            Если ПолеИмя = "id" Или ПолеИмя = "createdBy" Или Прав(ПолеИмя, 2) = "Id" Тогда
                Если Значение <> "" Тогда
                    Значение = Строка(РазобратьИдентификатор(Значение));
                ИначеЕсли СтрРазделить("sourceRequestId,sourceIncidentId,crewId,leaderAccountId", ",").Найти(ПолеИмя) = Неопределено Тогда
                    ВызватьИсключение "кабинет_наряд_привязка_конфликт";
                КонецЕсли;
            КонецЕсли;
        КонецЕсли;
        Результат.Вставить(ПолеИмя, Значение);
    КонецЦикла;
    Для Каждого Запись Из Данные Цикл
        Если Разрешенные.Найти(Запись.Ключ) = Неопределено Тогда
            ВызватьИсключение "кабинет_наряд_привязка_конфликт";
        КонецЕсли;
    КонецЦикла;
    Если Вид = "ServiceOrder" Тогда
        Если Результат.state <> "Registered" Или Результат.revision <> 1 Или Результат.createdAt <> Результат.updatedAt
            Или ПустаяСтрока(Результат.name) Или СтрДлина(Результат.name) > 150
            Или ПустаяСтрока(Результат.objectDescription) Или СтрДлина(Результат.objectDescription) > 250
            Или ПустаяСтрока(Результат.requestedWork) Или СтрДлина(Результат.requestedWork) > 2000 Тогда
            ВызватьИсключение "кабинет_наряд_привязка_конфликт";
        КонецЕсли;
    ИначеЕсли Вид = "Order" Тогда
        Если Результат.sourceKind = "ServiceOrder" Тогда
            Если Результат.sourceRequestId <> "" Или Результат.sourceIncidentId <> "" Или Результат.requiredForIncident Тогда
                ВызватьИсключение "кабинет_наряд_привязка_конфликт";
            КонецЕсли;
        КонецЕсли;
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция НеобязательныйИдентификатор(ИдентификаторСсылки)
    Если ЗначениеЗаполнено(ИдентификаторСсылки) Тогда
        Возврат Строка(ИдентификаторСсылки.УникальныйИдентификатор());
    КонецЕсли;
    Возврат "";
КонецФункции

Функция КаноническийИдентификаторИлиПустоеЗначение(Идентификатор)
    Если Идентификатор = "" Тогда
        Возврат "";
    КонецЕсли;
    Возврат Строка(РазобратьИдентификатор(Идентификатор));
КонецФункции

Процедура ЗаполнитьСлужебныеОтметки(Объект, СсылкаУчетнойЗаписи, КонтекстДоступа, Состояние)
    Объект.РабочееПространство = КонтекстДоступа.РабочееПространство;
    Объект.Область = КонтекстДоступа.Область;
    Объект.КемСоздано = СсылкаУчетнойЗаписи;
    Объект.ДатаСоздания = ТекущаяУниверсальнаяДата();
    Объект.ДатаОбновления = Объект.ДатаСоздания;
    Объект.Ревизия = 1;
    Объект.Состояние = Состояние;
КонецПроцедуры

Процедура УвеличитьРевизиюОбъекта(Объект)
    Если Объект.Ревизия >= 999999999999997 Тогда
        ВызватьИсключение "кабинет_наряд_редакция_конфликт";
    КонецЕсли;
    Объект.Ревизия = Объект.Ревизия + 1;
    Объект.ДатаОбновления = ТекущаяУниверсальнаяДата();
КонецПроцедуры

Процедура ПроверитьТекущуюРевизию(Объект, Ревизия)
    Если Объект.Ревизия <> Ревизия Или Объект.Ревизия >= 999999999999997 Тогда
        ВызватьИсключение "кабинет_наряд_редакция_конфликт";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьПоляТелаЗапроса(ТелоЗапроса, Поля)
    Если ТипЗнч(ТелоЗапроса) <> Тип("Структура") Тогда
        ВызватьИсключение "кабинет_наряд_некорректно_тело";
    КонецЕсли;
    Разрешенные = СтрРазделить(Поля, ",");
    Для Каждого Запись Из ТелоЗапроса Цикл
        Если Разрешенные.Найти(Запись.Ключ) = Неопределено Тогда
            ВызватьИсключение "кабинет_наряд_некорректно_поле";
        КонецЕсли;
    КонецЦикла;
    Для Каждого ПолеИмя Из Разрешенные Цикл
        Если Не ТелоЗапроса.Свойство(ПолеИмя) Тогда
            ВызватьИсключение "кабинет_наряд_некорректно_поле";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ПроверенныйТекст(Значение, Максимум, Строки = Ложь)
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_наряд_некорректно_поле";
    КонецЕсли;
    Если СтрДлина(Значение) > Максимум Тогда
        ВызватьИсключение "кабинет_наряд_некорректно_поле";
    КонецЕсли;
    Для Позиция = 1 По СтрДлина(Значение) Цикл
        Код = КодСимвола(Значение, Позиция);
        Если (Код < 32 И Не (Строки И (Код = 10 Или Код = 13))) Или (Код >= 127 И Код <= 159)
            Или (Код >= 8203 И Код <= 8207) Или (Код >= 8234 И Код <= 8238)
            Или (Код >= 8288 И Код <= 8297) Или Код = 65279 Или (Код >= 55296 И Код <= 57343) Тогда
            ВызватьИсключение "кабинет_наряд_некорректно_поле";
        КонецЕсли;
    КонецЦикла;
    Если Строки Тогда
        Значение = СтрЗаменить(Значение, Символ(13) + Символ(10), Символ(10));
        Значение = СтрЗаменить(Значение, Символ(13), Символ(10));
    КонецЕсли;
    Значение = СокрЛП(Значение);
    Если ПустаяСтрока(Значение) Тогда
        ВызватьИсключение "кабинет_наряд_некорректно_поле";
    КонецЕсли;
    Возврат Значение;
КонецФункции

Функция ТекстовоеПоле(ТелоЗапроса, Имя, Максимум, Строки = Ложь)
    Значение = Неопределено;
    Если Не ТелоЗапроса.Свойство(Имя, Значение) Тогда
        ВызватьИсключение "кабинет_наряд_некорректно_поле";
    КонецЕсли;
    Возврат ПроверенныйТекст(Значение, Максимум, Строки);
КонецФункции

Функция ЗначениеИзПеречня(ТелоЗапроса, Имя, Варианты)
    Значение = ТекстовоеПоле(ТелоЗапроса, Имя, 32);
    Если СтрРазделить(Варианты, ",").Найти(Значение) = Неопределено Тогда
        ВызватьИсключение "кабинет_наряд_некорректно_поле";
    КонецЕсли;
    Возврат Значение;
КонецФункции

Функция ЧисловоеПолеТела(ТелоЗапроса, Имя, Минимум, Максимум, ДесятичныеЗнаки)
    Значение = Неопределено;
    Если Не ТелоЗапроса.Свойство(Имя, Значение) Тогда
        ВызватьИсключение "кабинет_наряд_некорректно_поле";
    КонецЕсли;
    Если ТипЗнч(Значение) <> Тип("Число") Тогда
        ВызватьИсключение "кабинет_наряд_некорректно_поле";
    КонецЕсли;
    Если Значение < Минимум Или Значение > Максимум Или Окр(Значение, ДесятичныеЗнаки) <> Значение Тогда
        ВызватьИсключение "кабинет_наряд_некорректно_поле";
    КонецЕсли;
    Возврат Значение;
КонецФункции

Функция ПолеРевизии(ТелоЗапроса, Имя, НольРазрешенные = Ложь)
    Минимум = 1;
    Если НольРазрешенные Тогда
        Минимум = 0;
    КонецЕсли;
    Возврат ЧисловоеПолеТела(ТелоЗапроса, Имя, Минимум, 999999999999997, 0);
КонецФункции

Процедура ПроверитьНулевоеЗначение(ТелоЗапроса)
    Если ПолеРевизии(ТелоЗапроса, "expectedRevision", Истина) <> 0 Тогда
        ВызватьИсключение "кабинет_наряд_редакция_конфликт";
    КонецЕсли;
КонецПроцедуры

Функция ЛогическоеПоле(ТелоЗапроса, Имя)
    Значение = Неопределено;
    Если Не ТелоЗапроса.Свойство(Имя, Значение) Тогда
        ВызватьИсключение "кабинет_наряд_некорректно_поле";
    КонецЕсли;
    Если ТипЗнч(Значение) <> Тип("Булево") Тогда
        ВызватьИсключение "кабинет_наряд_некорректно_поле";
    КонецЕсли;
    Возврат Значение;
КонецФункции

Функция МассивТекстовыхЗначений(ТелоЗапроса, Имя, Максимум, ТекстМаксимум)
    Значения = Неопределено;
    Если Не ТелоЗапроса.Свойство(Имя, Значения) Тогда
        ВызватьИсключение "кабинет_наряд_некорректно_поле";
    КонецЕсли;
    Если ТипЗнч(Значения) <> Тип("Массив") Тогда
        ВызватьИсключение "кабинет_наряд_некорректно_поле";
    КонецЕсли;
    Если Значения.Количество() > Максимум Тогда
        ВызватьИсключение "кабинет_наряд_некорректно_поле";
    КонецЕсли;
    Результат = Новый Массив;
    Для Каждого Значение Из Значения Цикл
        Результат.Добавить(ПроверенныйТекст(Значение, ТекстМаксимум));
    КонецЦикла;
    Возврат Результат;
КонецФункции

Процедура ПроверитьВыполнениеВсехПунктов(ТелоЗапроса, Объект)
    Значения = Неопределено;
    Если Не ТелоЗапроса.Свойство("completedItems", Значения) Тогда
        ВызватьИсключение "кабинет_наряд_некорректно_поле";
    КонецЕсли;
    КонтрольныйСписок = ДекодироватьЗначение(Объект.КонтрольныйСписокJSON);
    Если ТипЗнч(Значения) <> Тип("Массив") Тогда
        ВызватьИсключение "кабинет_наряд_некорректно_поле";
    КонецЕсли;
    Если Значения.Количество() <> КонтрольныйСписок.Количество() Тогда
        ВызватьИсключение "кабинет_наряд_чеклист_незавершено";
    КонецЕсли;
    Для Каждого Значение Из Значения Цикл
        Если ТипЗнч(Значение) <> Тип("Булево") Тогда
            ВызватьИсключение "кабинет_наряд_некорректно_поле";
        КонецЕсли;
        Если Не Значение Тогда
            ВызватьИсключение "кабинет_наряд_чеклист_незавершено";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ПолеДаты(ТелоЗапроса, Имя)
    Значение = ТекстовоеПоле(ТелоЗапроса, Имя, 20);
    Если СтрДлина(Значение) <> 20 Или Сред(Значение, 5, 1) <> "-" Или Сред(Значение, 8, 1) <> "-"
        Или Сред(Значение, 11, 1) <> "T" Или Сред(Значение, 14, 1) <> ":" Или Сред(Значение, 17, 1) <> ":" Или Прав(Значение, 1) <> "Z" Тогда
        ВызватьИсключение "кабинет_наряд_некорректно_даты";
    КонецЕсли;
    Цифры = Лев(Значение, 4) + Сред(Значение, 6, 2) + Сред(Значение, 9, 2) + Сред(Значение, 12, 2) + Сред(Значение, 15, 2) + Сред(Значение, 18, 2);
    Для Позиция = 1 По СтрДлина(Цифры) Цикл
        Если СтрНайти("0123456789", Сред(Цифры, Позиция, 1)) = 0 Тогда
            ВызватьИсключение "кабинет_наряд_некорректно_даты";
        КонецЕсли;
    КонецЦикла;
    Попытка
        Разобранный = XMLЗначение(Тип("Дата"), Лев(Значение, 19));
    Исключение
        ВызватьИсключение "кабинет_наряд_некорректно_даты";
    КонецПопытки;
    Если Разобранный = Дата(1, 1, 1) Или XMLСтрока(Разобранный) <> Лев(Значение, 19) Тогда
        ВызватьИсключение "кабинет_наряд_некорректно_даты";
    КонецЕсли;
    Возврат Разобранный;
КонецФункции

Процедура ПроверитьВременнойИнтервал(ДатаНачала, ДатаОкончания)
    ТекущееВремя = ТекущаяУниверсальнаяДата();
    Если ДатаНачала < ТекущееВремя Или ДатаОкончания > ТекущееВремя + 7776000 Или ДатаОкончания <= ДатаНачала Или ДатаОкончания - ДатаНачала > 604800 Тогда
        ВызватьИсключение "кабинет_наряд_некорректно_даты";
    КонецЕсли;
КонецПроцедуры

Функция РазобратьИдентификатор(Идентификатор)
    Если ТипЗнч(Идентификатор) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецЕсли;
    Если СтрДлина(Идентификатор) <> 36 Тогда
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецЕсли;
    Попытка
        Разобранный = Новый УникальныйИдентификатор(Идентификатор);
    Исключение
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецПопытки;
    Если Строка(Разобранный) = "00000000-0000-0000-0000-000000000000" Тогда
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецЕсли;
    Возврат Разобранный;
КонецФункции

Функция КаноническоеПредставление(Значение, ПолеИмя = "", Глубина = 0)
    Если Глубина > 8 Тогда
        ВызватьИсключение "кабинет_наряд_некорректно_поле";
    КонецЕсли;
    Если ТипЗнч(Значение) = Тип("Структура") Тогда
        Отсортированный = Новый ТаблицаЗначений;
        Отсортированный.Колонки.Добавить("Имя");
        Отсортированный.Колонки.Добавить("Значение");
        Для Каждого Запись Из Значение Цикл
            СтрокаВыборки = Отсортированный.Добавить();
            СтрокаВыборки.Имя = Запись.Ключ;
            СтрокаВыборки.Значение = Запись.Значение;
        КонецЦикла;
        Отсортированный.Сортировать("Имя");
        Результат = Новый Структура;
        Для Каждого СтрокаВыборки Из Отсортированный Цикл
            Результат.Вставить(СтрокаВыборки.Имя, КаноническоеПредставление(СтрокаВыборки.Значение, СтрокаВыборки.Имя, Глубина + 1));
        КонецЦикла;
        Возврат Результат;
    ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
        Результат = Новый Массив;
        Для Каждого Запись Из Значение Цикл
            Результат.Добавить(КаноническоеПредставление(Запись, ПолеИмя, Глубина + 1));
        КонецЦикла;
        Возврат Результат;
    ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
        Если Прав(ПолеИмя, 2) = "Id" И Значение <> "" Тогда
            Возврат Строка(РазобратьИдентификатор(СокрЛП(Значение)));
        КонецЕсли;
        Значение = СтрЗаменить(Значение, Символ(13) + Символ(10), Символ(10));
        Значение = СтрЗаменить(Значение, Символ(13), Символ(10));
        Возврат СокрЛП(Значение);
    ИначеЕсли ТипЗнч(Значение) = Тип("Число") Или ТипЗнч(Значение) = Тип("Булево") Тогда
        Возврат Значение;
    КонецЕсли;
    ВызватьИсключение "кабинет_наряд_некорректно_поле";
КонецФункции

Функция КодироватьЗначение(Значение, Максимум)
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, КаноническоеПредставление(Значение));
    Результат = Запись.Закрыть();
    Если СтрДлина(Результат) > Максимум Тогда
        ВызватьИсключение "кабинет_наряд_некорректно_поле";
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ДекодироватьЗначение(Текст)
    Если ТипЗнч(Текст) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_наряд_привязка_конфликт";
    КонецЕсли;
    Если СтрДлина(Текст) > 24000 Тогда
        ВызватьИсключение "кабинет_наряд_привязка_конфликт";
    КонецЕсли;
    Чтение = Новый ЧтениеJSON;
    Попытка
        Чтение.УстановитьСтроку(Текст);
        Результат = ПрочитатьJSON(Чтение);
        Чтение.Закрыть();
    Исключение
        Чтение.Закрыть();
        ВызватьИсключение "кабинет_наряд_привязка_конфликт";
    КонецПопытки;
    Возврат Результат;
КонецФункции

Процедура ЗаблокироватьУчетныеЗаписи(СсылкаУчетнойЗаписи, ДругойУчетнаяЗапись = Неопределено)
    Если ДругойУчетнаяЗапись = Неопределено Или ДругойУчетнаяЗапись = СсылкаУчетнойЗаписи Или Не ЗначениеЗаполнено(ДругойУчетнаяЗапись) Тогда
        ЗаблокироватьОбъектПоСсылке("Справочник.УчетныеЗаписи", СсылкаУчетнойЗаписи);
        Возврат;
    КонецЕсли;
    Отсортированный = Новый ТаблицаЗначений;
    Отсортированный.Колонки.Добавить("Идентификатор");
    Отсортированный.Колонки.Добавить("ИдентификаторСсылки");
    СтрокаВыборки = Отсортированный.Добавить();
    СтрокаВыборки.Идентификатор = Строка(СсылкаУчетнойЗаписи.УникальныйИдентификатор());
    СтрокаВыборки.ИдентификаторСсылки = СсылкаУчетнойЗаписи;
    СтрокаВыборки = Отсортированный.Добавить();
    СтрокаВыборки.Идентификатор = Строка(ДругойУчетнаяЗапись.УникальныйИдентификатор());
    СтрокаВыборки.ИдентификаторСсылки = ДругойУчетнаяЗапись;
    Отсортированный.Сортировать("Идентификатор");
    Для Каждого СтрокаВыборки Из Отсортированный Цикл
        ЗаблокироватьОбъектПоСсылке("Справочник.УчетныеЗаписи", СтрокаВыборки.ИдентификаторСсылки);
    КонецЦикла;
КонецПроцедуры

Процедура ЗаблокироватьОбъектПоСсылке(ПространствоИмен, ИдентификаторСсылки)
    Блокировка = Новый БлокировкаДанных;
    БлокировкаЗапись = Блокировка.Добавить(ПространствоИмен);
    БлокировкаЗапись.УстановитьЗначение("Ссылка", ИдентификаторСсылки);
    БлокировкаЗапись.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
КонецПроцедуры

Процедура УстановитьКонтекстОбласти(Запрос, КонтекстДоступа)
    Запрос.УстановитьПараметр("РабочееПространство", КонтекстДоступа.РабочееПространство);
    Запрос.УстановитьПараметр("Область", КонтекстДоступа.Область);
КонецПроцедуры

Процедура ПроверитьОтсутствиеТранзакции()
    Если ТранзакцияАктивна() Тогда
        ВызватьИсключение "кабинет_наряд_вложенная_транзакция";
    КонецЕсли;
КонецПроцедуры

Процедура ОтменитьСобственнуюТранзакцию()
    Если ТранзакцияАктивна() Тогда
        ОтменитьТранзакцию();
    КонецЕсли;
КонецПроцедуры

Функция НазначитьУчастникаБригады(СсылкаУчетнойЗаписи, БригадаИдентификатор, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, "workspaceId,areaId,accountId,expectedRevision,state,reason");
    Адресат = Справочники.УчетныеЗаписи.ПолучитьСсылку(РазобратьИдентификатор(ТекстовоеПоле(ТелоЗапроса, "accountId", 36)));
    Состояние = ЗначениеИзПеречня(ТелоЗапроса, "state", "Active,Inactive");
    Причина = ТекстовоеПоле(ТелоЗапроса, "reason", 250);
    Ревизия = ПолеРевизии(ТелоЗапроса, "expectedRevision", Истина);
    КонтекстДоступа = НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, ТекстовоеПоле(ТелоЗапроса, "workspaceId", 36), ТекстовоеПоле(ТелоЗапроса, "areaId", 36), "Dispatcher", Адресат);
    Попытка
        Бригада = ОбъектБригады(РазобратьИдентификатор(БригадаИдентификатор), КонтекстДоступа);
        Команда = ОткрытьПривязкуКоманды(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, "crew.member", КонтекстДоступа, БригадаИдентификатор, КодироватьЗначение(ТелоЗапроса, 16000));
        Если Команда.Выбран() Тогда
            Результат = ПовторитьСохраненныйРезультат(Команда);
        Иначе
            Если Состояние = "Active" Тогда
                ПроверитьЦелевойОбъект(Адресат, КонтекстДоступа, "");
            КонецЕсли;
            Объект = НайтиСоставБригады(Бригада.Ссылка, Адресат);
            Перед = Новый Структура;
            Если Объект = Неопределено Тогда
                Если Ревизия <> 0 Тогда
                    ВызватьИсключение "кабинет_наряд_редакция_конфликт";
                КонецЕсли;
                УвеличитьРасходКвоты(СсылкаУчетнойЗаписи, КонтекстДоступа, "Member", 2000);
                Объект = Справочники.УчастникиРабочихБригад.СоздатьЭлемент();
                Объект.SetNewObjectRef(Справочники.УчастникиРабочихБригад.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
                ЗаполнитьСлужебныеОтметки(Объект, СсылкаУчетнойЗаписи, КонтекстДоступа, Состояние);
                Объект.Наименование = "Explicit crew roster";
                Объект.Бригада = Бригада.Ссылка;
                Объект.УчетнаяЗапись = Адресат;
            Иначе
                ПроверитьДанныеЭлемента(Объект, КонтекстДоступа);
                ПроверитьТекущуюРевизию(Объект, Ревизия);
                Перед = ДанныеУчастникаБригады(Объект);
                УвеличитьРевизиюОбъекта(Объект);
                Объект.Состояние = Состояние;
            КонецЕсли;
            Объект.Записать();
            Результат = ДанныеУчастникаБригады(Объект);
            ЗавершитьОперацию(Команда, "Member", Объект, "crew.member", Причина, Перед, Результат, СсылкаУчетнойЗаписи, ИдентификаторЗапроса);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СоздатьРесурс(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, "workspaceId,areaId,expectedRevision,name,capacity");
    ПроверитьНулевоеЗначение(ТелоЗапроса);
    Имя = ТекстовоеПоле(ТелоЗапроса, "name", 150);
    Вместимость = ЧисловоеПолеТела(ТелоЗапроса, "capacity", 1, 1000, 0);
    КонтекстДоступа = НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, ТекстовоеПоле(ТелоЗапроса, "workspaceId", 36), ТекстовоеПоле(ТелоЗапроса, "areaId", 36), "Dispatcher");
    Попытка
        Команда = ОткрытьПривязкуКоманды(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, "resource.create", КонтекстДоступа, "", КодироватьЗначение(ТелоЗапроса, 16000));
        Если Команда.Выбран() Тогда
            Результат = ПовторитьСохраненныйРезультат(Команда);
        Иначе
            УвеличитьРасходКвоты(СсылкаУчетнойЗаписи, КонтекстДоступа, "Resource", 200);
            Объект = Справочники.РесурсыНарядов.СоздатьЭлемент();
            Объект.SetNewObjectRef(Справочники.РесурсыНарядов.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
            ЗаполнитьСлужебныеОтметки(Объект, СсылкаУчетнойЗаписи, КонтекстДоступа, "Active");
            Объект.Наименование = Имя;
            Объект.Вместимость = Вместимость;
            Объект.Записать();
            Результат = ДанныеРесурса(Объект);
            ЗавершитьОперацию(Команда, "Resource", Объект, "resource.create", "Created", Новый Структура, Результат, СсылкаУчетнойЗаписи, ИдентификаторЗапроса);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ИсторияСправочникаРабот(УчетнаяЗапись, ПространствоИд, ОбластьИд, Вид, Идентификатор, Лимит = 25, Курсор = "") Экспорт
    Если Вид = "Resource" Тогда Каталог = "РесурсыНарядов";
    ИначеЕсли Вид = "Member" Тогда Каталог = "УчастникиРабочихБригад";
    Иначе ВызватьИсключение "кабинет_наряд_некорректно_поле"; КонецЕсли;
    Контекст = НачатьОперациюВОбласти(УчетнаяЗапись, ПространствоИд, ОбластьИд, "Dispatcher");
    Попытка
        Ссылка = Справочники[Каталог].ПолучитьСсылку(РазобратьИдентификатор(Идентификатор));
        Если Вид = "Member" Тогда
            Предварительно = Ссылка.ПолучитьОбъект(); ПроверитьДанныеЭлемента(Предварительно, Контекст);
            ЗаблокироватьОбъектПоСсылке("Справочник.РабочиеБригады", Предварительно.Бригада);
            ПроверитьДанныеЭлемента(Предварительно.Бригада.ПолучитьОбъект(), Контекст);
        КонецЕсли;
        ЗаблокироватьОбъектПоСсылке("Справочник." + Каталог, Ссылка);
        Объект = Ссылка.ПолучитьОбъект(); ПроверитьДанныеЭлемента(Объект, Контекст);
        Если Вид = "Member" И Объект.Бригада <> Предварительно.Бригада Тогда ВызватьИсключение "кабинет_наряд_привязка_конфликт"; КонецЕсли;
        ПроверитьЛимитСтраницы(Лимит);
        Префикс = ПрефиксКурсораСтраницы("dictionary-" + Вид, УчетнаяЗапись, ПространствоИд, ОбластьИд, Идентификатор);
        Позиция = ПозицияСтраницы(Курсор, Префикс, Истина);
        ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит + 1, "ЧГ=0") + " Ревизия, Операция, ДатаИзменения, ДействующееЛицо
            |ИЗ РегистрСведений.ИсторияНарядов ГДЕ Вид = &Вид И ИдентификаторСущности = &Идентификатор
            |И РабочееПространство = &РабочееПространство И Область = &Область";
        Если Позиция.ЕстьПозиция Тогда ТекстЗапроса = ТекстЗапроса + " И Ревизия < &ПослеРевизии"; КонецЕсли;
        Запрос = Новый Запрос(ТекстЗапроса + " УПОРЯДОЧИТЬ ПО Ревизия УБЫВ"); УстановитьКонтекстОбласти(Запрос, Контекст);
        Запрос.УстановитьПараметр("Вид", Вид); Запрос.УстановитьПараметр("Идентификатор", Строка(Ссылка.УникальныйИдентификатор()));
        Если Позиция.ЕстьПозиция Тогда Запрос.УстановитьПараметр("ПослеРевизии", Позиция.Ревизия); КонецЕсли;
        Выборка = Запрос.Выполнить().Выбрать(); Элементы = Новый Массив; ЕстьЕще = Ложь; Следующий = "";
        Пока Выборка.Следующий() Цикл
            Если Элементы.Количество() = Лимит Тогда ЕстьЕще = Истина; Прервать; КонецЕсли;
            Элементы.Добавить(Новый Структура("revision,operation,changedAt,actorAccountId", Выборка.Ревизия, Выборка.Операция,
                XMLСтрока(Выборка.ДатаИзменения) + "Z", Строка(Выборка.ДействующееЛицо.УникальныйИдентификатор())));
            Следующий = Префикс + Формат(Выборка.Ревизия, "ЧГ=0") + "|-";
        КонецЦикла;
        Результат = Новый Структура("kind,objectId,workspaceId,areaId,createdBy,currentRevision,items,limit,hasMore,nextCursor", Вид,
            Строка(Ссылка.УникальныйИдентификатор()), ПространствоИд, ОбластьИд, Строка(Объект.КемСоздано.УникальныйИдентификатор()),
            Объект.Ревизия, Элементы, Лимит, ЕстьЕще, ?(ЕстьЕще, Следующий, ""));
        ЗафиксироватьТранзакцию();
    Исключение ОтменитьСобственнуюТранзакцию(); ВызватьИсключение; КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СписокНастроекРаздела(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор) Экспорт
    КонтекстДоступа = НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, "Dispatcher");
    Попытка
        Бригады = Новый Массив;
        Ресурсы = Новый Массив;
        Участники = Новый Массив;
        Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 100 Ссылка ИЗ Справочник.РабочиеБригады ГДЕ РабочееПространство = &РабочееПространство И Область = &Область И НЕ ПометкаУдаления УПОРЯДОЧИТЬ ПО ДатаСоздания, Ссылка");
        УстановитьКонтекстОбласти(Запрос, КонтекстДоступа);
        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            Бригады.Добавить(ДанныеБригады(Выборка.Ссылка.ПолучитьОбъект()));
        КонецЦикла;
        Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 100 Ссылка ИЗ Справочник.РесурсыНарядов ГДЕ РабочееПространство = &РабочееПространство И Область = &Область И НЕ ПометкаУдаления УПОРЯДОЧИТЬ ПО ДатаСоздания, Ссылка");
        УстановитьКонтекстОбласти(Запрос, КонтекстДоступа);
        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            Ресурсы.Добавить(ДанныеРесурса(Выборка.Ссылка.ПолучитьОбъект()));
        КонецЦикла;
        Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 100 Ссылка ИЗ Справочник.УчастникиРабочихБригад ГДЕ РабочееПространство = &РабочееПространство И Область = &Область И НЕ ПометкаУдаления УПОРЯДОЧИТЬ ПО ДатаСоздания, Ссылка");
        УстановитьКонтекстОбласти(Запрос, КонтекстДоступа);
        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            Участники.Добавить(ДанныеУчастникаБригады(Выборка.Ссылка.ПолучитьОбъект()));
        КонецЦикла;
        Результат = Новый Структура("crews,resources,members", Бригады, Ресурсы, Участники);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СоздатьНаряд(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, "workspaceId,areaId,expectedRevision,sourceKind,sourceId,requiredForIncident,title,task,checklist,priority,plannedFrom,plannedTo");
    ПроверитьНулевоеЗначение(ТелоЗапроса);
    ВидИсточника = ЗначениеИзПеречня(ТелоЗапроса, "sourceKind", "Request,Incident,ServiceOrder");
    ИсточникИдентификатор = РазобратьИдентификатор(ТекстовоеПоле(ТелоЗапроса, "sourceId", 36));
    Требуемый = ЛогическоеПоле(ТелоЗапроса, "requiredForIncident");
    Имя = ТекстовоеПоле(ТелоЗапроса, "title", 150);
    Задача = ТекстовоеПоле(ТелоЗапроса, "task", 2000);
    КонтрольныйСписок = МассивТекстовыхЗначений(ТелоЗапроса, "checklist", 20, 250);
    Приоритет = ЗначениеИзПеречня(ТелоЗапроса, "priority", "Low,Normal,High,Critical");
    ДатаНачала = ПолеДаты(ТелоЗапроса, "plannedFrom");
    ДатаОкончания = ПолеДаты(ТелоЗапроса, "plannedTo");
    Намерение = КодироватьЗначение(ТелоЗапроса, 16000);
    Маршрут = МаршрутКоманды(СсылкаУчетнойЗаписи, ИдентификаторЗапроса);
    Если Маршрут <> Неопределено Тогда
        Возврат ПовторитьКомандуНаряда(СсылкаУчетнойЗаписи, Маршрут, ИдентификаторЗапроса, "order.create", "", Намерение);
    КонецЕсли;
    КонтекстДоступа = НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, ТекстовоеПоле(ТелоЗапроса, "workspaceId", 36), ТекстовоеПоле(ТелоЗапроса, "areaId", 36), "Dispatcher");
    Попытка
        Маршрут = МаршрутКоманды(СсылкаУчетнойЗаписи, ИдентификаторЗапроса);
        Если Маршрут <> Неопределено Тогда
            Результат = ПовторитьКомандуНарядаВОбласти(СсылкаУчетнойЗаписи, Маршрут, ИдентификаторЗапроса, "order.create", "", Намерение, КонтекстДоступа);
            ЗафиксироватьТранзакцию();
            Возврат Результат;
        КонецЕсли;
        Источник = ПолучитьЗаблокированныйИсточник(ВидИсточника, ИсточникИдентификатор, КонтекстДоступа);
        Команда = ОткрытьПривязкуКоманды(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, "order.create", КонтекстДоступа, "", Намерение);
        Если Команда.Выбран() Тогда
            Результат = ПовторитьСохраненныйРезультат(Команда);
        Иначе
            ПроверитьВременнойИнтервал(ДатаНачала, ДатаОкончания);
            Если Требуемый И Не ЗначениеЗаполнено(Источник.Инцидент) Тогда
                ВызватьИсключение "кабинет_наряд_связь_конфликт";
            КонецЕсли;
            УвеличитьРасходКвоты(СсылкаУчетнойЗаписи, КонтекстДоступа, "Order", 5000);
            Объект = Справочники.Наряды.СоздатьЭлемент();
            Объект.SetNewObjectRef(Справочники.Наряды.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
            ЗаполнитьСлужебныеОтметки(Объект, СсылкаУчетнойЗаписи, КонтекстДоступа, "Draft");
            Объект.Наименование = Имя;
            Объект.ДиспетчерАвтор = СсылкаУчетнойЗаписи;
            Объект.ВидИсточника = ВидИсточника;
            Объект.ИсходноеОбращение = Источник.Запрос;
            Объект.ИсходныйИнцидент = Источник.Инцидент;
            Объект.ИсходныйЗаказУслуги = Источник.ЗаказУслуги;
            Объект.ОбязателенДляИнцидента = Требуемый;
            Объект.ТекстЗадания = Задача;
            Объект.КонтрольныйСписокJSON = КодироватьЗначение(КонтрольныйСписок, 8192);
            Объект.Приоритет = Приоритет;
            Объект.ПлановоеНачало = ДатаНачала;
            Объект.ПлановоеОкончание = ДатаОкончания;
            Объект.Записать();
            Результат = ДанныеЗаказа(Объект);
            ЗавершитьОперацию(Команда, "Order", Объект, "order.create", "Created", Новый Структура, Результат, СсылкаУчетнойЗаписи, ИдентификаторЗапроса);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция НазначитьНаряд(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, "expectedRevision,crewId,plannedFrom,plannedTo,resources,reason");
    Ревизия = ПолеРевизии(ТелоЗапроса, "expectedRevision");
    БригадаИдентификатор = РазобратьИдентификатор(ТекстовоеПоле(ТелоЗапроса, "crewId", 36));
    ДатаНачала = ПолеДаты(ТелоЗапроса, "plannedFrom");
    ДатаОкончания = ПолеДаты(ТелоЗапроса, "plannedTo");
    Строки = СтрокиРесурсов(ТелоЗапроса);
    Причина = ТекстовоеПоле(ТелоЗапроса, "reason", 250);
    Намерение = КодироватьЗначение(ТелоЗапроса, 16000);
    Маршрут = МаршрутКоманды(СсылкаУчетнойЗаписи, ИдентификаторЗапроса);
    Если Маршрут <> Неопределено Тогда
        Возврат ПовторитьКомандуНаряда(СсылкаУчетнойЗаписи, Маршрут, ИдентификаторЗапроса, "order.assign", Идентификатор, Намерение);
    КонецЕсли;
    ПредварительныйСнимок = ПредставлениеЗаказа(РазобратьИдентификатор(Идентификатор));
    БригадаПредварительныйСнимок = Справочники.РабочиеБригады.ПолучитьСсылку(БригадаИдентификатор).ПолучитьОбъект();
    Если БригадаПредварительныйСнимок = Неопределено Тогда
        ВызватьИсключение "кабинет_наряд_не_найдено";
    КонецЕсли;
    КонтекстДоступа = НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, Строка(ПредварительныйСнимок.РабочееПространство.УникальныйИдентификатор()), Строка(ПредварительныйСнимок.Область.УникальныйИдентификатор()), "Dispatcher", БригадаПредварительныйСнимок.УчетнаяЗаписьРуководителя);
    Попытка
        Маршрут = МаршрутКоманды(СсылкаУчетнойЗаписи, ИдентификаторЗапроса);
        Если Маршрут <> Неопределено Тогда
            Результат = ПовторитьКомандуНарядаВОбласти(СсылкаУчетнойЗаписи, Маршрут, ИдентификаторЗапроса, "order.assign", Идентификатор, Намерение, КонтекстДоступа);
            ЗафиксироватьТранзакцию();
            Возврат Результат;
        КонецЕсли;
        ЗаблокироватьИсточник(ПредварительныйСнимок.ИсходныйИнцидент, ПредварительныйСнимок.ИсходноеОбращение, ПредварительныйСнимок.ИсходныйЗаказУслуги);
        Бригада = ОбъектБригады(БригадаИдентификатор, КонтекстДоступа);
        Если Бригада.НачалоСмены <> Дата(1, 1, 1) И (ДатаНачала < Бригада.НачалоСмены Или ДатаОкончания > Бригада.КонецСмены) Тогда
            ВызватьИсключение "кабинет_наряд_смена_конфликт";
        КонецЕсли;
        Если Бригада.УчетнаяЗаписьРуководителя <> БригадаПредварительныйСнимок.УчетнаяЗаписьРуководителя Тогда
            ВызватьИсключение "кабинет_наряд_привязка_конфликт";
        КонецЕсли;
        ПроверитьЦелевойОбъект(Бригада.УчетнаяЗаписьРуководителя, КонтекстДоступа, "CrewLeader");
        ПроверитьСоставБригады(Бригада.Ссылка, Бригада.УчетнаяЗаписьРуководителя, КонтекстДоступа);
        ЗаблокироватьРесурсы(Строки, ПредварительныйСнимок.Ссылка, КонтекстДоступа);
        Объект = ОбъектНаряда(ПредварительныйСнимок.Ссылка, КонтекстДоступа);
        ПроверитьПредставлениеНаряда(Объект, ПредварительныйСнимок);
        Команда = ОткрытьПривязкуКоманды(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, "order.assign", КонтекстДоступа, Идентификатор, КодироватьЗначение(ТелоЗапроса, 16000));
        Если Команда.Выбран() Тогда
            Результат = ПовторитьСохраненныйРезультат(Команда);
        Иначе
            ПроверитьВременнойИнтервал(ДатаНачала, ДатаОкончания);
            ПроверитьТекущуюРевизию(Объект, Ревизия);
            Если Объект.Состояние <> "Draft" И Объект.Состояние <> "Assigned" И Объект.Состояние <> "Accepted" И Объект.Состояние <> "Paused" И Объект.Состояние <> "Rework" Тогда
                ВызватьИсключение "кабинет_наряд_состояние_конфликт";
            КонецЕсли;
            Если Объект.Состояние <> "Draft" И Объект.Состояние <> "Assigned" Тогда
                Если Объект.Бригада <> Бригада.Ссылка Или Объект.УчетнаяЗаписьРуководителя <> Бригада.УчетнаяЗаписьРуководителя Тогда
                    ВызватьИсключение "кабинет_наряд_состояние_конфликт";
                КонецЕсли;
            КонецЕсли;
            ПроверитьИнтервалБригады(Бригада.Ссылка, Объект.Ссылка, ДатаНачала, ДатаОкончания);
            Для Каждого Строка Из Строки Цикл
                Ресурс = ОбъектРесурса(Строка.Ссылка, КонтекстДоступа);
                ПроверитьВместимость(Ресурс, Объект.Ссылка, ДатаНачала, ДатаОкончания, Строка.Объем);
            КонецЦикла;
            Перед = ДанныеЗаказа(Объект);
            ОсвободитьБронирования(Объект.Ссылка);
            Для Каждого Строка Из Строки Цикл
                Бронирование = Справочники.БронированияРесурсовНарядов.СоздатьЭлемент();
                Бронирование.SetNewObjectRef(Справочники.БронированияРесурсовНарядов.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
                ЗаполнитьСлужебныеОтметки(Бронирование, СсылкаУчетнойЗаписи, КонтекстДоступа, "Active");
                Бронирование.Наименование = "Explicit planned resource booking";
                Бронирование.Наряд = Объект.Ссылка;
                Бронирование.Ресурс = Строка.Ссылка;
                Бронирование.ДатаНачала = ДатаНачала;
                Бронирование.ДатаОкончания = ДатаОкончания;
                Бронирование.Объем = Строка.Объем;
                Бронирование.Записать();
            КонецЦикла;
            Объект.Бригада = Бригада.Ссылка;
            Объект.УчетнаяЗаписьРуководителя = Бригада.УчетнаяЗаписьРуководителя;
            Объект.ПлановоеНачало = ДатаНачала;
            Объект.ПлановоеОкончание = ДатаОкончания;
            Если Объект.Состояние = "Draft" Тогда
                Объект.Состояние = "Assigned";
            КонецЕсли;
            УвеличитьРевизиюОбъекта(Объект);
            Объект.Записать();
            Результат = ДанныеЗаказа(Объект);
            ЗавершитьОперацию(Команда, "Order", Объект, "order.assign", Причина, Перед, Результат, СсылкаУчетнойЗаписи, ИдентификаторЗапроса);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ИзменитьСостояниеОтИмениБригадира(СсылкаУчетнойЗаписи, Идентификатор, Действие, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    Если ТипЗнч(Действие) <> Тип("Строка") Или СтрРазделить("accept,decline,start,pause,resume,submit", ",").Найти(Действие) = Неопределено Тогда
        ВызватьИсключение "кабинет_наряд_некорректно_действие";
    КонецЕсли;
    Поля = "expectedRevision,reason";
    Маршрут = МаршрутКоманды(СсылкаУчетнойЗаписи, ИдентификаторЗапроса);
    Если Действие = "submit" Тогда
        Поля = Поля + ",result,completedItems,actualFrom,actualTo,measurement,photoIds";
        Если Маршрут <> Неопределено И ТипЗнч(ТелоЗапроса) = Тип("Структура") Тогда
            Если ТелоЗапроса.Количество() = 4 Тогда Поля = "expectedRevision,reason,result,completedItems"; КонецЕсли;
        КонецЕсли;
    КонецЕсли;
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, Поля);
    Ревизия = ПолеРевизии(ТелоЗапроса, "expectedRevision");
    Причина = ТекстовоеПоле(ТелоЗапроса, "reason", 250);
    Если Маршрут <> Неопределено Тогда
        Возврат ПовторитьКомандуБригадира(СсылкаУчетнойЗаписи, Идентификатор, Действие, ТелоЗапроса, ИдентификаторЗапроса, Маршрут);
    КонецЕсли;
    КонтекстДоступа = НачатьОперациюСНарядом(СсылкаУчетнойЗаписи, Идентификатор, "CrewLeader", Истина);
    Попытка
        Объект = КонтекстДоступа.Объект;
        Команда = ОткрытьПривязкуКоманды(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, "leader." + Действие, КонтекстДоступа, Идентификатор, КодироватьЗначение(ТелоЗапроса, 16000));
        Если Команда.Выбран() Тогда
            Результат = ПовторитьСохраненныйРезультат(Команда);
        Иначе
            ПроверитьТекущуюРевизию(Объект, Ревизия);
            Перед = ДанныеЗаказа(Объект);
            Если Действие = "accept" И Объект.Состояние = "Assigned" Тогда
                Объект.Состояние = "Accepted";
            ИначеЕсли Действие = "decline" И Объект.Состояние = "Assigned" Тогда
                Объект.Состояние = "Draft";
                ОсвободитьБронирования(Объект.Ссылка);
                Объект.Бригада = Справочники.РабочиеБригады.ПустаяСсылка();
                Объект.УчетнаяЗаписьРуководителя = Справочники.УчетныеЗаписи.ПустаяСсылка();
            ИначеЕсли Действие = "start" И (Объект.Состояние = "Accepted" Или Объект.Состояние = "Rework") Тогда
                Объект.Состояние = "InProgress";
                Если Объект.ДатаФактическогоНачала = Дата(1, 1, 1) Тогда
                    Объект.ДатаФактическогоНачала = ТекущаяУниверсальнаяДата();
                КонецЕсли;
            ИначеЕсли Действие = "pause" И Объект.Состояние = "InProgress" Тогда
                Объект.Состояние = "Paused";
                Объект.ДатаПриостановки = ТекущаяУниверсальнаяДата();
            ИначеЕсли Действие = "resume" И Объект.Состояние = "Paused" Тогда
                Объект.Состояние = "InProgress";
            ИначеЕсли Действие = "submit" И Объект.Состояние = "InProgress" Тогда
                СервисСклада.ПроверитьЗавершениеМатериалов(СсылкаУчетнойЗаписи, Объект.Ссылка);
                Объект.ТекстРезультата = ТекстовоеПоле(ТелоЗапроса, "result", 4000, Истина);
                ПроверитьВыполнениеВсехПунктов(ТелоЗапроса, Объект);
                СохранитьОтчетВыполнения(СсылкаУчетнойЗаписи, Объект, КонтекстДоступа, ТелоЗапроса);
                Объект.Состояние = "Reported";
                Объект.ДатаПодачи = ТекущаяУниверсальнаяДата();
            Иначе
                ВызватьИсключение "кабинет_наряд_состояние_конфликт";
            КонецЕсли;
            УвеличитьРевизиюОбъекта(Объект);
            Объект.Записать();
            Результат = ДанныеЗаказа(Объект);
            ЗавершитьОперацию(Команда, "Order", Объект, "leader." + Действие, Причина, Перед, Результат, СсылкаУчетнойЗаписи, ИдентификаторЗапроса);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПроверитьНаряд(СсылкаУчетнойЗаписи, Идентификатор, Действие, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    Если СтрРазделить("approve,rework,close,cancel,restore", ",").Найти(Действие) = Неопределено Тогда
        ВызватьИсключение "кабинет_наряд_некорректно_действие";
    КонецЕсли;
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, "expectedRevision,reason");
    Ревизия = ПолеРевизии(ТелоЗапроса, "expectedRevision");
    Причина = ТекстовоеПоле(ТелоЗапроса, "reason", 250);
    КонтекстДоступа = НачатьОперациюСНарядом(СсылкаУчетнойЗаписи, Идентификатор, "Dispatcher");
    Попытка
        Объект = КонтекстДоступа.Объект;
        Команда = ОткрытьПривязкуКоманды(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, "review." + Действие, КонтекстДоступа, Идентификатор, КодироватьЗначение(ТелоЗапроса, 16000));
        Если Команда.Выбран() Тогда
            Результат = ПовторитьСохраненныйРезультат(Команда);
        Иначе
            ПроверитьТекущуюРевизию(Объект, Ревизия);
            Если (Действие = "close" И Объект.Состояние <> "Verified")
                Или (Действие = "approve" И Объект.Состояние <> "Reported")
                Или (Действие = "rework" И Объект.Состояние <> "Reported" И Объект.Состояние <> "Submitted")
                Или (Действие = "restore" И Объект.Состояние <> "Cancelled")
                Или (Действие = "cancel" И СтрРазделить("Draft,Assigned,Accepted,InProgress,Paused,Reported,Submitted,Rework", ",").Найти(Объект.Состояние) = Неопределено) Тогда
                ВызватьИсключение "кабинет_наряд_состояние_конфликт";
            КонецЕсли;
            Если Действие = "approve" Или Действие = "close" Тогда
                СервисСклада.ПроверитьЗавершениеМатериалов(СсылкаУчетнойЗаписи, Объект.Ссылка);
            ИначеЕсли Действие = "cancel" Тогда
                СервисСклада.ПроверитьЗавершениеМатериалов(СсылкаУчетнойЗаписи, Объект.Ссылка, Истина);
            КонецЕсли;
            Перед = ДанныеЗаказа(Объект);
            Объект.Состояние = "InProgress";
            Если Действие = "approve" Тогда
                Объект.Состояние = "Verified";
                ОсвободитьБронирования(Объект.Ссылка);
            ИначеЕсли Действие = "close" Тогда
                Объект.Состояние = "Closed";
                Объект.ДатаВыполнения = ТекущаяУниверсальнаяДата();
                ОсвободитьБронирования(Объект.Ссылка);
            ИначеЕсли Действие = "cancel" Тогда
                Объект.Состояние = "Cancelled";
                ОсвободитьБронирования(Объект.Ссылка);
            ИначеЕсли Действие = "restore" Тогда
                Объект.Состояние = "Draft";
                Объект.Бригада = Справочники.РабочиеБригады.ПустаяСсылка();
                Объект.УчетнаяЗаписьРуководителя = Справочники.УчетныеЗаписи.ПустаяСсылка();
            КонецЕсли;
            УвеличитьРевизиюОбъекта(Объект);
            Объект.Записать();
            Результат = ДанныеЗаказа(Объект);
            ЗавершитьОперацию(Команда, "Order", Объект, "review." + Действие, Причина, Перед, Результат, СсылкаУчетнойЗаписи, ИдентификаторЗапроса);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПолучитьНаряд(СсылкаУчетнойЗаписи, Идентификатор) Экспорт
    КонтекстДоступа = НачатьОперациюСНарядом(СсылкаУчетнойЗаписи, Идентификатор, "");
    Попытка
        ПроверитьЧтениеНаряда(СсылкаУчетнойЗаписи, КонтекстДоступа.Объект, КонтекстДоступа);
        Результат = ДанныеЗаказа(КонтекстДоступа.Объект);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Процедура ПроверитьЛимитСтраницы(Лимит)
    Если ТипЗнч(Лимит) <> Тип("Число") Или Лимит < 1 Или Лимит > 100 Или Лимит <> Цел(Лимит) Тогда
        ВызватьИсключение "кабинет_наряд_некорректно_поле";
    КонецЕсли;
КонецПроцедуры

Функция ПрефиксКурсораСтраницы(Вид, УчетнаяЗапись, ПространствоИд = "-", ОбластьИд = "-", НарядИд = "-")
    Возврат "w1|" + Вид + "|" + Строка(УчетнаяЗапись.УникальныйИдентификатор()) + "|"
        + ПространствоИд + "|" + ОбластьИд + "|" + НарядИд + "|";
КонецФункции

Функция ПозицияСтраницы(Курсор, Префикс, История = Ложь)
    Результат = Новый Структура("ЕстьПозиция,Дата,Ид,Ревизия", Ложь, Дата(1, 1, 1), "", 0);
    Если ТипЗнч(Курсор) <> Тип("Строка") Или СтрДлина(Курсор) > 256 Тогда ВызватьИсключение "кабинет_наряд_некорректно_поле"; КонецЕсли;
    Если Курсор = "" Тогда Возврат Результат; КонецЕсли;
    Если Лев(Курсор, СтрДлина(Префикс)) <> Префикс Тогда ВызватьИсключение "кабинет_наряд_некорректно_поле"; КонецЕсли;
    Части = СтрРазделить(Сред(Курсор, СтрДлина(Префикс) + 1), "|", Истина);
    Если Части.Количество() <> 2 Тогда ВызватьИсключение "кабинет_наряд_некорректно_поле"; КонецЕсли;
    Попытка
        Если История Тогда
            Если Части[1] <> "-" Или СтрДлина(Части[0]) < 1 Или СтрДлина(Части[0]) > 15 Или Лев(Части[0], 1) = "0" Тогда
                ВызватьИсключение "кабинет_наряд_некорректно_поле";
            КонецЕсли;
            Для Позиция = 1 По СтрДлина(Части[0]) Цикл
                Если СтрНайти("0123456789", Сред(Части[0], Позиция, 1)) = 0 Тогда ВызватьИсключение "кабинет_наряд_некорректно_поле"; КонецЕсли;
            КонецЦикла;
            Результат.Ревизия = Число(Части[0]);
        Иначе
            Результат.Дата = ПолеДаты(Новый Структура("afterTime", Части[0]), "afterTime");
            Результат.Ид = Строка(РазобратьИдентификатор(Части[1]));
            Если Результат.Ид <> Части[1] Тогда ВызватьИсключение "кабинет_наряд_некорректно_поле"; КонецЕсли;
        КонецЕсли;
    Исключение
        ВызватьИсключение "кабинет_наряд_некорректно_поле";
    КонецПопытки;
    Результат.ЕстьПозиция = Истина;
    Возврат Результат;
КонецФункции

Функция ПолучитьСписокНарядов(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, Лимит = 25, Курсор = "") Экспорт
    КонтекстДоступа = НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, "");
    Попытка
        Диспетчер = ЕстьРоль(СсылкаУчетнойЗаписи, КонтекстДоступа, "Dispatcher");
        Если Не Диспетчер И Не ЕстьРоль(СсылкаУчетнойЗаписи, КонтекстДоступа, "CrewLeader") Тогда
            ВызватьИсключение "кабинет_область_запрещено";
        КонецЕсли;
        ПроверитьЛимитСтраницы(Лимит);
        Префикс = ПрефиксКурсораСтраницы("orders", СсылкаУчетнойЗаписи,
            Строка(КонтекстДоступа.РабочееПространство.УникальныйИдентификатор()), Строка(КонтекстДоступа.Область.УникальныйИдентификатор()));
        Позиция = ПозицияСтраницы(Курсор, Префикс);
        ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит + 1, "ЧГ=0") + " Ссылка ИЗ Справочник.Наряды
            |ГДЕ РабочееПространство = &РабочееПространство И Область = &Область И НЕ ПометкаУдаления
            |И (&Диспетчер ИЛИ УчетнаяЗаписьРуководителя = &УчетнаяЗапись)";
        Если Позиция.ЕстьПозиция Тогда
            ТекстЗапроса = ТекстЗапроса + " И (ДатаСоздания < &ПослеДаты ИЛИ (ДатаСоздания = &ПослеДаты И Ссылка > &ПослеСсылки))";
        КонецЕсли;
        Запрос = Новый Запрос(ТекстЗапроса + " УПОРЯДОЧИТЬ ПО ДатаСоздания УБЫВ, Ссылка");
        УстановитьКонтекстОбласти(Запрос, КонтекстДоступа);
        Запрос.УстановитьПараметр("Диспетчер", Диспетчер);
        Запрос.УстановитьПараметр("УчетнаяЗапись", СсылкаУчетнойЗаписи);
        Если Позиция.ЕстьПозиция Тогда
            Запрос.УстановитьПараметр("ПослеДаты", Позиция.Дата);
            Запрос.УстановитьПараметр("ПослеСсылки", Справочники.Наряды.ПолучитьСсылку(РазобратьИдентификатор(Позиция.Ид)));
        КонецЕсли;
        Выборка = Запрос.Выполнить().Выбрать();
        Элементы = Новый Массив; ЕстьЕще = Ложь; Следующий = "";
        Пока Выборка.Следующий() Цикл
            Если Элементы.Количество() = Лимит Тогда ЕстьЕще = Истина; Прервать; КонецЕсли;
            Объект = Выборка.Ссылка.ПолучитьОбъект();
            ПроверитьЧтениеНаряда(СсылкаУчетнойЗаписи, Объект, КонтекстДоступа);
            Элементы.Добавить(ДанныеЗаказа(Объект));
            Следующий = Префикс + XMLСтрока(Объект.ДатаСоздания) + "Z|" + Строка(Объект.Ссылка.УникальныйИдентификатор());
        КонецЦикла;
        Результат = Новый Структура("items,limit,hasMore,nextCursor", Элементы, Лимит, ЕстьЕще, ?(ЕстьЕще, Следующий, ""));
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СнимокФотографии(Объект)
    Данные = БазовыеДанныеОбъекта(Объект);
    Данные.Вставить("workOrderId", Строка(Объект.Наряд.УникальныйИдентификатор()));
    Данные.Вставить("filename", Объект.ИмяФайла);
    Данные.Вставить("mime", Объект.ТипMIME);
    Данные.Вставить("byteLength", Объект.КоличествоБайт);
    Данные.Вставить("sha256", Объект.ХешSHA256);
    Данные.Вставить("authorAccountId", Строка(Объект.КемСоздано.УникальныйИдентификатор()));
    Возврат Данные;
КонецФункции

Функция ПроекцияФотографии(Снимок)
    Возврат Новый Структура("id,workOrderId,filename,mime,byteLength,sha256,authorAccountId,createdAt",
        Снимок.id, Снимок.workOrderId, Снимок.filename, Снимок.mime, Снимок.byteLength,
        Снимок.sha256, Снимок.authorAccountId, Снимок.createdAt);
КонецФункции

Функция ФотографияНаряда(Ссылка, Наряд, КонтекстДоступа)
    Объект = Ссылка.ПолучитьОбъект();
    ПроверитьДанныеЭлемента(Объект, КонтекстДоступа);
    Если Объект.Наряд <> Наряд.Ссылка Или Объект.Состояние <> "Active" Или Объект.Ревизия <> 1
        Или Объект.КоличествоБайт < 1 Или Объект.КоличествоБайт > 5242880
        Или (Объект.ТипMIME <> "image/jpeg" И Объект.ТипMIME <> "image/png") Тогда
        ВызватьИсключение "кабинет_наряд_не_найдено";
    КонецЕсли;
    Возврат Объект;
КонецФункции

Функция ФотографииВКонтексте(Наряд, КонтекстДоступа)
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 21 Ссылка ИЗ Справочник.ФотографииНарядов ГДЕ Наряд = &Наряд И НЕ ПометкаУдаления УПОРЯДОЧИТЬ ПО ДатаСоздания, Ссылка");
    Запрос.УстановитьПараметр("Наряд", Наряд.Ссылка);
    Выборка = Запрос.Выполнить().Выбрать();
    Результат = Новый Массив;
    Пока Выборка.Следующий() Цикл
        Если Результат.Количество() >= 20 Тогда ВызватьИсключение "кабинет_наряд_привязка_конфликт"; КонецЕсли;
        Результат.Добавить(ПроекцияФотографии(СнимокФотографии(ФотографияНаряда(Выборка.Ссылка, Наряд, КонтекстДоступа))));
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция ЗагрузитьФотографиюНаряда(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    КонтекстДоступа = НачатьОперациюСНарядом(СсылкаУчетнойЗаписи, Идентификатор, "CrewLeader", Истина);
    Попытка
        Наряд = КонтекстДоступа.Объект;
        Вход = СервисФайлов.ПроверитьБайтыФотографии(ТелоЗапроса);
        Намерение = КодироватьЗначение(Новый Структура("filename,mime,byteLength,sha256",
            Вход.ИмяФайла, Вход.ТипMIME, Вход.Содержимое.КоличествоБайт, Вход.Содержимое.ХешSHA256), 1000);
        Команда = ОткрытьПривязкуКоманды(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, "photo.upload", КонтекстДоступа, Идентификатор, Намерение);
        Если Команда.Выбран() Тогда
            Снимок = ПовторитьСохраненныйРезультат(Команда);
            Если Снимок.workOrderId <> Идентификатор Тогда ВызватьИсключение "кабинет_наряд_привязка_конфликт"; КонецЕсли;
        Иначе
            Если Наряд.Состояние <> "InProgress" И Наряд.Состояние <> "Paused" Тогда ВызватьИсключение "кабинет_наряд_состояние_конфликт"; КонецЕсли;
            Если ФотографииВКонтексте(Наряд, КонтекстДоступа).Количество() >= 20 Тогда ВызватьИсключение "кабинет_наряд_квота_превышено"; КонецЕсли;
            ЗапросКвоты = Новый Запрос("ВЫБРАТЬ ЕСТЬNULL(СУММА(КоличествоБайт), 0) КАК КоличествоБайт ИЗ Справочник.ФотографииНарядов ГДЕ Наряд = &Наряд");
            ЗапросКвоты.УстановитьПараметр("Наряд", Наряд.Ссылка);
            Размеры = ЗапросКвоты.Выполнить().Выбрать();
            Если Не Размеры.Следующий() Или Размеры.КоличествоБайт < 0 Тогда ВызватьИсключение "кабинет_наряд_привязка_конфликт"; КонецЕсли;
            Если Размеры.КоличествоБайт + Вход.Содержимое.КоличествоБайт > 20971520 Тогда ВызватьИсключение "кабинет_наряд_квота_превышено"; КонецЕсли;
            СервисФайлов.ПроверитьОбщуюКвотуВложений(КонтекстДоступа, Вход.Содержимое.КоличествоБайт);
            УвеличитьРасходКвоты(СсылкаУчетнойЗаписи, КонтекстДоступа, "Photo", 200);
            Объект = Справочники.ФотографииНарядов.СоздатьЭлемент();
            Объект.SetNewObjectRef(Справочники.ФотографииНарядов.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
            ЗаполнитьСлужебныеОтметки(Объект, СсылкаУчетнойЗаписи, КонтекстДоступа, "Active");
            Объект.Наименование = Вход.ИмяФайла;
            Объект.Наряд = Наряд.Ссылка;
            Объект.ИмяФайла = Вход.ИмяФайла;
            Объект.ТипMIME = Вход.ТипMIME;
            Объект.КоличествоБайт = Вход.Содержимое.КоличествоБайт;
            Объект.ХешSHA256 = Вход.Содержимое.ХешSHA256;
            Объект.ДвоичныеДанные = Новый ХранилищеЗначения(Вход.Содержимое.Данные);
            Объект.Записать();
            Снимок = СнимокФотографии(Объект);
            ЗавершитьОперацию(Команда, "Photo", Объект, "photo.upload", "Фотография выполненных работ", Новый Структура, Снимок, СсылкаУчетнойЗаписи, ИдентификаторЗапроса);
        КонецЕсли;
        Результат = ПроекцияФотографии(Снимок);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СписокФотографийНаряда(СсылкаУчетнойЗаписи, Идентификатор) Экспорт
    КонтекстДоступа = НачатьОперациюСНарядом(СсылкаУчетнойЗаписи, Идентификатор, "");
    Попытка
        ПроверитьЧтениеНаряда(СсылкаУчетнойЗаписи, КонтекстДоступа.Объект, КонтекстДоступа);
        Результат = Новый Структура("workOrderId,items,hasMore", Идентификатор,
            ФотографииВКонтексте(КонтекстДоступа.Объект, КонтекстДоступа), Ложь);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СкачатьФотографиюНаряда(СсылкаУчетнойЗаписи, Идентификатор) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    Ссылка = Справочники.ФотографииНарядов.ПолучитьСсылку(РазобратьИдентификатор(Идентификатор));
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Наряд ИЗ Справочник.ФотографииНарядов ГДЕ Ссылка = &Ссылка И НЕ ПометкаУдаления");
    Запрос.УстановитьПараметр("Ссылка", Ссылка);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Тогда ВызватьИсключение "кабинет_наряд_не_найдено"; КонецЕсли;
    КонтекстДоступа = НачатьОперациюСНарядом(СсылкаУчетнойЗаписи, Строка(Выборка.Наряд.УникальныйИдентификатор()), "");
    Попытка
        ПроверитьЧтениеНаряда(СсылкаУчетнойЗаписи, КонтекстДоступа.Объект, КонтекстДоступа);
        Фото = ФотографияНаряда(Ссылка, КонтекстДоступа.Объект, КонтекстДоступа);
        Байты = Фото.ДвоичныеДанные.Получить();
        Если ТипЗнч(Байты) <> Тип("ДвоичныеДанные") Тогда ВызватьИсключение "кабинет_наряд_привязка_конфликт"; КонецЕсли;
        Если Байты.Размер() <> Фото.КоличествоБайт Тогда ВызватьИсключение "кабинет_наряд_привязка_конфликт"; КонецЕсли;
        Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
        Хеширование.Добавить(Байты);
        Хеш = СтрЗаменить(СтрЗаменить(Base64Строка(Хеширование.ХешСумма), Символ(13), ""), Символ(10), "");
        Если Хеш <> Фото.ХешSHA256 Тогда ВызватьИсключение "кабинет_наряд_привязка_конфликт"; КонецЕсли;
        Результат = Новый Структура("binary,filename,mime", Байты, Фото.ИмяФайла, Фото.ТипMIME);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПроверенныеДанныеОтчета(Тело, Наряд, КонтекстДоступа)
    Начало = ПолеДаты(Тело, "actualFrom");
    Окончание = ПолеДаты(Тело, "actualTo");
    Если Наряд.ДатаФактическогоНачала = Дата(1, 1, 1) Или Начало < Наряд.ДатаФактическогоНачала
        Или Окончание < Начало Или Окончание > ТекущаяУниверсальнаяДата() Или Окончание - Начало > 2678400 Тогда
        ВызватьИсключение "кабинет_наряд_некорректно_поле";
    КонецЕсли;
    Измерение = Неопределено;
    Если Не Тело.Свойство("measurement", Измерение) Тогда ВызватьИсключение "кабинет_наряд_некорректно_поле"; КонецЕсли;
    ПроверитьПоляТелаЗапроса(Измерение, "name,value,unit,measuredAt");
    Момент = ПолеДаты(Измерение, "measuredAt");
    Если Момент < Начало Или Момент > Окончание Тогда ВызватьИсключение "кабинет_наряд_некорректно_поле"; КонецЕсли;
    Показатель = Новый Структура("name,value,unit,measuredAt", ТекстовоеПоле(Измерение, "name", 120),
        ЧисловоеПолеТела(Измерение, "value", -1000000000, 1000000000, 6), ТекстовоеПоле(Измерение, "unit", 32), XMLСтрока(Момент) + "Z");
    ИдентификаторыФото = МассивТекстовыхЗначений(Тело, "photoIds", 5, 36);
    Уникальные = Новый Соответствие;
    Фото = Новый Массив;
    Для Каждого Ид Из ИдентификаторыФото Цикл
        Ссылка = Справочники.ФотографииНарядов.ПолучитьСсылку(РазобратьИдентификатор(Ид));
        Если Уникальные.Получить(Ид) <> Неопределено Тогда ВызватьИсключение "кабинет_наряд_некорректно_поле"; КонецЕсли;
        Уникальные.Вставить(Ид, Истина);
        Фото.Добавить(ПроекцияФотографии(СнимокФотографии(ФотографияНаряда(Ссылка, Наряд, КонтекстДоступа))));
    КонецЦикла;
    ПроверитьВыполнениеВсехПунктов(Тело, Наряд);
    Выполненные = Новый Массив;
    Для Каждого Пункт Из Тело.completedItems Цикл Выполненные.Добавить(Пункт); КонецЦикла;
    Возврат Новый Структура("actualFrom,actualTo,result,completedItems,measurement,photos", XMLСтрока(Начало) + "Z", XMLСтрока(Окончание) + "Z",
        ТекстовоеПоле(Тело, "result", 4000, Истина), Выполненные, Показатель, Фото);
КонецФункции

Процедура СохранитьОтчетВыполнения(СсылкаУчетнойЗаписи, Наряд, КонтекстДоступа, Тело)
    Данные = ПроверенныеДанныеОтчета(Тело, Наряд, КонтекстДоступа);
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Версия ИЗ Справочник.ОтчетыВыполненияНарядов ГДЕ Наряд = &Наряд И НЕ ПометкаУдаления УПОРЯДОЧИТЬ ПО Версия УБЫВ");
    Запрос.УстановитьПараметр("Наряд", Наряд.Ссылка);
    Выборка = Запрос.Выполнить().Выбрать();
    Версия = 1;
    Если Выборка.Следующий() Тогда Версия = Выборка.Версия + 1; КонецЕсли;
    Если Версия > 100 Тогда ВызватьИсключение "кабинет_наряд_квота_превышено"; КонецЕсли;
    Объект = Справочники.ОтчетыВыполненияНарядов.СоздатьЭлемент();
    Объект.SetNewObjectRef(Справочники.ОтчетыВыполненияНарядов.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
    ЗаполнитьСлужебныеОтметки(Объект, СсылкаУчетнойЗаписи, КонтекстДоступа, "Issued");
    Объект.Наименование = "Отчет о выполнении работ, редакция " + Строка(Версия);
    Объект.Наряд = Наряд.Ссылка;
    Объект.Версия = Версия;
    Объект.ДанныеОтчетаJSON = КодироватьЗначение(Данные, 32000);
    Объект.Записать();
КонецПроцедуры

Функция ИсполнениеВКонтексте(Наряд, КонтекстДоступа)
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 101 Ссылка ИЗ Справочник.ОтчетыВыполненияНарядов ГДЕ Наряд = &Наряд И НЕ ПометкаУдаления УПОРЯДОЧИТЬ ПО Версия УБЫВ");
    Запрос.УстановитьПараметр("Наряд", Наряд.Ссылка);
    Выборка = Запрос.Выполнить().Выбрать();
    История = Новый Массив;
    Последний = Неопределено;
    ПредыдущаяВерсия = 101;
    Пока Выборка.Следующий() Цикл
        Если История.Количество() >= 100 Тогда ВызватьИсключение "кабинет_наряд_привязка_конфликт"; КонецЕсли;
        Объект = Выборка.Ссылка.ПолучитьОбъект();
        ПроверитьДанныеЭлемента(Объект, КонтекстДоступа);
        Если Объект.Наряд <> Наряд.Ссылка Или Объект.Состояние <> "Issued" Или Объект.Ревизия <> 1
            Или Объект.Версия < 1 Или Объект.Версия >= ПредыдущаяВерсия Или Объект.Версия <> Цел(Объект.Версия) Тогда
            ВызватьИсключение "кабинет_наряд_привязка_конфликт";
        КонецЕсли;
        ПредыдущаяВерсия = Объект.Версия;
        Мета = Новый Структура("id,version,createdAt", Строка(Объект.Ссылка.УникальныйИдентификатор()), Объект.Версия, XMLСтрока(Объект.ДатаСоздания) + "Z");
        История.Добавить(Мета);
        Если Последний = Неопределено Тогда
            Снимок = ПроверенныйСнимокОтчета(Объект, Наряд, КонтекстДоступа);
            Последний = Новый Структура("id,version,actualFrom,actualTo,result,completedItems,measurement,photos,authorAccountId,createdAt",
                Мета.id, Мета.version, Снимок.actualFrom, Снимок.actualTo, Снимок.result, Снимок.completedItems,
                Снимок.measurement, Снимок.photos, Строка(Объект.КемСоздано.УникальныйИдентификатор()), Мета.createdAt);
        КонецЕсли;
    КонецЦикла;
    Возврат Новый Структура("workOrderId,latest,history", Строка(Наряд.Ссылка.УникальныйИдентификатор()), Последний, История);
КонецФункции

Функция ПроверенныйСнимокОтчета(Объект, Наряд, КонтекстДоступа)
    Попытка
        Снимок = ДекодироватьЗначение(Объект.ДанныеОтчетаJSON);
        ПроверитьПоляТелаЗапроса(Снимок, "actualFrom,actualTo,result,completedItems,measurement,photos");
        Если ТипЗнч(Снимок.photos) <> Тип("Массив") Тогда ВызватьИсключение "кабинет_наряд_привязка_конфликт"; КонецЕсли;
        Идентификаторы = Новый Массив;
        Для Каждого Фото Из Снимок.photos Цикл
            ПроверитьПоляТелаЗапроса(Фото, "id,workOrderId,filename,mime,byteLength,sha256,authorAccountId,createdAt");
            Если Фото.workOrderId <> Строка(Наряд.Ссылка.УникальныйИдентификатор()) Тогда ВызватьИсключение "кабинет_наряд_привязка_конфликт"; КонецЕсли;
            Идентификаторы.Добавить(ТекстовоеПоле(Фото, "id", 36));
        КонецЦикла;
        Вход = Новый Структура("actualFrom,actualTo,result,completedItems,measurement,photoIds", Снимок.actualFrom,
            Снимок.actualTo, Снимок.result, Снимок.completedItems, Снимок.measurement, Идентификаторы);
        Результат = ПроверенныеДанныеОтчета(Вход, Наряд, КонтекстДоступа);
        Если ПолеДаты(Результат, "actualTo") > Объект.ДатаСоздания Тогда ВызватьИсключение "кабинет_наряд_привязка_конфликт"; КонецЕсли;
        Для Индекс = 0 По Результат.photos.Количество() - 1 Цикл
            Для Каждого Поле Из Результат.photos[Индекс] Цикл
                Если Снимок.photos[Индекс][Поле.Ключ] <> Поле.Значение Тогда ВызватьИсключение "кабинет_наряд_привязка_конфликт"; КонецЕсли;
            КонецЦикла;
        КонецЦикла;
        Возврат Результат;
    Исключение
        ВызватьИсключение "кабинет_наряд_привязка_конфликт";
    КонецПопытки;
КонецФункции

Функция ПолучитьИсполнениеНаряда(СсылкаУчетнойЗаписи, Идентификатор) Экспорт
    КонтекстДоступа = НачатьОперациюСНарядом(СсылкаУчетнойЗаписи, Идентификатор, "");
    Попытка
        ПроверитьЧтениеНаряда(СсылкаУчетнойЗаписи, КонтекстДоступа.Объект, КонтекстДоступа);
        Результат = ИсполнениеВКонтексте(КонтекстДоступа.Объект, КонтекстДоступа);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПолучитьРедакциюИсполненияНаряда(СсылкаУчетнойЗаписи, Идентификатор, Версия) Экспорт
    КонтекстДоступа = НачатьОперациюСНарядом(СсылкаУчетнойЗаписи, Идентификатор, "");
    Попытка
        Наряд = КонтекстДоступа.Объект;
        ПроверитьЧтениеНаряда(СсылкаУчетнойЗаписи, Наряд, КонтекстДоступа);
        Если ТипЗнч(Версия) <> Тип("Число") Или Версия < 1 Или Версия > 100 Или Версия <> Цел(Версия) Тогда
            ВызватьИсключение "кабинет_наряд_некорректно_поле";
        КонецЕсли;
        Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2 Ссылка ИЗ Справочник.ОтчетыВыполненияНарядов
            |ГДЕ Наряд = &Наряд И Версия = &Версия И НЕ ПометкаУдаления");
        Запрос.УстановитьПараметр("Наряд", Наряд.Ссылка);
        Запрос.УстановитьПараметр("Версия", Версия);
        Выборка = Запрос.Выполнить().Выбрать();
        Если Не Выборка.Следующий() Тогда ВызватьИсключение "кабинет_наряд_не_найдено"; КонецЕсли;
        СсылкаОтчета = Выборка.Ссылка;
        Если Выборка.Следующий() Тогда ВызватьИсключение "кабинет_наряд_привязка_конфликт"; КонецЕсли;
        Объект = СсылкаОтчета.ПолучитьОбъект();
        ПроверитьДанныеЭлемента(Объект, КонтекстДоступа);
        Если Объект.Наряд <> Наряд.Ссылка Или Объект.Состояние <> "Issued" Или Объект.Ревизия <> 1
            Или Объект.Версия <> Версия Тогда ВызватьИсключение "кабинет_наряд_привязка_конфликт"; КонецЕсли;
        Снимок = ПроверенныйСнимокОтчета(Объект, Наряд, КонтекстДоступа);
        Отчет = Новый Структура("id,version,actualFrom,actualTo,result,completedItems,measurement,photos,authorAccountId,createdAt",
            Строка(Объект.Ссылка.УникальныйИдентификатор()), Объект.Версия, Снимок.actualFrom, Снимок.actualTo,
            Снимок.result, Снимок.completedItems, Снимок.measurement, Снимок.photos,
            Строка(Объект.КемСоздано.УникальныйИдентификатор()), XMLСтрока(Объект.ДатаСоздания) + "Z");
        Результат = Новый Структура("workOrderId,report", Строка(Наряд.Ссылка.УникальныйИдентификатор()), Отчет);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПечатныйНаряд(СсылкаУчетнойЗаписи, Идентификатор, Вид, ВложенныйДопуск = Неопределено) Экспорт
    Если Вид <> "order" И Вид <> "act" Тогда ВызватьИсключение "кабинет_наряд_некорректно_поле"; КонецЕсли;
    ПолучитьНаряд(СсылкаУчетнойЗаписи, Идентификатор);
    Источник = Справочники.Наряды.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
    ОбластиЭкспорта = ОграниченияТяжелыхЗаданий.ОднаОбласть(Источник.РабочееПространство, Источник.Область);
    СобственныйДопуск = ВложенныйДопуск = Неопределено;
    ДопускТяжелогоЗадания = ОграниченияТяжелыхЗаданий.Начать(СсылкаУчетнойЗаписи, "workPrint", ОбластиЭкспорта, ВложенныйДопуск);
    Попытка
        Результат = ПечатныйНарядБезЛимита(СсылкаУчетнойЗаписи, Идентификатор, Вид);
    Исключение
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
        Если СобственныйДопуск Тогда ОграниченияТяжелыхЗаданий.Завершить(СсылкаУчетнойЗаписи, ДопускТяжелогоЗадания); КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
    Если СобственныйДопуск Тогда ОграниченияТяжелыхЗаданий.Завершить(СсылкаУчетнойЗаписи, ДопускТяжелогоЗадания); КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ПечатныйНарядБезЛимита(СсылкаУчетнойЗаписи, Идентификатор, Вид)
    Если Вид <> "order" И Вид <> "act" Тогда ВызватьИсключение "кабинет_наряд_некорректно_поле"; КонецЕсли;
    КонтекстДоступа = НачатьОперациюСНарядом(СсылкаУчетнойЗаписи, Идентификатор, "");
    Попытка
        Объект = КонтекстДоступа.Объект;
        ПроверитьЧтениеНаряда(СсылкаУчетнойЗаписи, Объект, КонтекстДоступа);
        Строки = Новый Массив;
        Заголовок = "Наряд на выполнение работ";
        Если Вид = "act" Тогда Заголовок = "Акт результата работ"; КонецЕсли;
        Строки.Добавить(Заголовок + " " + Идентификатор);
        Строки.Добавить("Наименование: " + Объект.Наименование);
        Строки.Добавить("Редакция наряда: " + Строка(Объект.Ревизия) + "; состояние: " + ПредставлениеСостоянияНаряда(Объект.Состояние));
        Строки.Добавить("Задание: " + Объект.ТекстЗадания);
        Строки.Добавить("Плановый интервал UTC: " + XMLСтрока(Объект.ПлановоеНачало) + " - " + XMLСтрока(Объект.ПлановоеОкончание));
        Если ЗначениеЗаполнено(Объект.Бригада) Тогда Строки.Добавить("Бригада: " + Объект.Бригада.Наименование); КонецЕсли;
        Если Вид = "act" Тогда
            Если Объект.Состояние <> "Verified" И Объект.Состояние <> "Closed" Тогда ВызватьИсключение "кабинет_наряд_состояние_конфликт"; КонецЕсли;
            Исполнение = ИсполнениеВКонтексте(Объект, КонтекстДоступа);
            Если Исполнение.latest = Неопределено Тогда ВызватьИсключение "кабинет_наряд_состояние_конфликт"; КонецЕсли;
            Отчет = Исполнение.latest;
            Строки.Добавить("Редакция отчета: " + Строка(Отчет.version));
            Строки.Добавить("Фактический интервал UTC: " + Отчет.actualFrom + " - " + Отчет.actualTo);
            Строки.Добавить("Выполненные работы: " + Отчет.result);
            Строки.Добавить("Контрольное измерение: " + Отчет.measurement.name + " = " + Строка(Отчет.measurement.value) + " " + Отчет.measurement.unit);
            Строки.Добавить("Измерено UTC: " + Отчет.measurement.measuredAt);
            Строки.Добавить("Фотографий в отчете: " + Строка(Отчет.photos.Количество()));
        Иначе
            Для Каждого Пункт Из ДекодироватьЗначение(Объект.КонтрольныйСписокJSON) Цикл Строки.Добавить("Проверить: " + Пункт); КонецЦикла;
        КонецЕсли;
        Результат = СформироватьУчебныйPDF(Строки, "training-work-" + Идентификатор + "-" + Вид + ".pdf");
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПредставлениеСостоянияНаряда(Состояние)
    Названия = Новый Структура("Draft,Assigned,Accepted,InProgress,Paused,Reported,Verified,Closed,Cancelled,Submitted,Rework,Completed",
        "Черновик", "Назначен", "Принят бригадой", "В работе", "Приостановлен", "Отчет представлен", "Работы приняты", "Закрыт",
        "Отменен", "Старый отчет: требуется доработка", "На доработке (прежний порядок)", "Завершен (прежний порядок)");
    Представление = "";
    Если Не Названия.Свойство(Состояние, Представление) Тогда ВызватьИсключение "кабинет_наряд_привязка_конфликт"; КонецЕсли;
    Возврат Представление;
КонецФункции

Функция ЭкспортПриложенияНаряда(СсылкаУчетнойЗаписи, Идентификатор, Версия = 0, ВложенныйДопуск = Неопределено) Экспорт
    ПолучитьПриложениеНаряда(СсылкаУчетнойЗаписи, Идентификатор, Версия);
    Источник = Справочники.Наряды.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
    ОбластиЭкспорта = ОграниченияТяжелыхЗаданий.ОднаОбласть(Источник.РабочееПространство, Источник.Область);
    СобственныйДопуск = ВложенныйДопуск = Неопределено;
    ДопускТяжелогоЗадания = ОграниченияТяжелыхЗаданий.Начать(СсылкаУчетнойЗаписи, "workAppendix", ОбластиЭкспорта, ВложенныйДопуск);
    Попытка
        Результат = ЭкспортПриложенияНарядаБезЛимита(СсылкаУчетнойЗаписи, Идентификатор, Версия);
    Исключение
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
        Если СобственныйДопуск Тогда ОграниченияТяжелыхЗаданий.Завершить(СсылкаУчетнойЗаписи, ДопускТяжелогоЗадания); КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
    Если СобственныйДопуск Тогда ОграниченияТяжелыхЗаданий.Завершить(СсылкаУчетнойЗаписи, ДопускТяжелогоЗадания); КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ЭкспортПриложенияНарядаБезЛимита(СсылкаУчетнойЗаписи, Идентификатор, Версия = 0)
    Приложение = ПолучитьПриложениеНаряда(СсылкаУчетнойЗаписи, Идентификатор, Версия);
    Строки = Новый Массив;
    Строки.Добавить("Закрытое техническое приложение к наряду " + Идентификатор);
    Строки.Добавить("Редакция: " + Строка(Приложение.version));
    Строки.Добавить(Приложение.privateText);
    Возврат СформироватьУчебныйPDF(Строки, "training-work-" + Идентификатор + "-appendix-v" + Строка(Приложение.version) + ".pdf");
КонецФункции

Функция СформироватьУчебныйPDF(Строки, ИмяФайла)
    Таблица = Новый ТабличныйДокумент;
    Таблица.АвтоМасштаб = Истина;
    Таблица.Вывод = ИспользованиеВывода.Разрешить;
    Выдан = ТекущаяУниверсальнаяДата();
    ТекстСтрок = Новый Массив;
    ТекстСтрок.Добавить("УЧЕБНЫЙ ДОКУМЕНТ. Не является документом настоящего водоканала.");
    ТекстСтрок.Добавить("Сформирован UTC: " + XMLСтрока(Выдан));
    ТекстСтрок.Добавить("Срок действия учебной копии до UTC: " + XMLСтрока(Выдан + 86400));
    Для Каждого Текст Из Строки Цикл
        Для Каждого СтрокаТекста Из СтрРазделить(СтрЗаменить(Текст, Символ(13), ""), Символ(10), Истина) Цикл
            Для Смещение = 1 По СтрДлина(СтрокаТекста) Цикл
                Если (Смещение - 1) % 80 = 0 Тогда ТекстСтрок.Добавить(Сред(СтрокаТекста, Смещение, 80)); КонецЕсли;
            КонецЦикла;
        КонецЦикла;
    КонецЦикла;
    Если ТекстСтрок.Количество() > 250 Тогда ВызватьИсключение "кабинет_наряд_выбор_лимит"; КонецЕсли;
    Таблица.Область(1, 1, ТекстСтрок.Количество(), 1).ШиринаКолонки = 100;
    Таблица.Область(1, 1, ТекстСтрок.Количество(), 1).Шрифт = Новый Шрифт("DejaVu Sans", 10);
    НомерСтроки = 1;
    Для Каждого Текст Из ТекстСтрок Цикл
        Таблица.Область(НомерСтроки, 1).Текст = Текст;
        НомерСтроки = НомерСтроки + 1;
    КонецЦикла;
    Путь = ПолучитьИмяВременногоФайла("pdf");
    Попытка
        Таблица.Записать(Путь, ТипФайлаТабличногоДокумента.PDF);
        Байты = Новый ДвоичныеДанные(Путь);
        Если Байты.Размер() < 500 Или Байты.Размер() > 1048576 Тогда ВызватьИсключение "кабинет_наряд_привязка_конфликт"; КонецЕсли;
        УдалитьФайлы(Путь);
    Исключение
        Попытка УдалитьФайлы(Путь); Исключение КонецПопытки;
        ВызватьИсключение;
    КонецПопытки;
    Возврат Новый Структура("binary,filename,mime", Байты, ИмяФайла, "application/pdf");
КонецФункции

Функция ВариантыДопусковНаряда(СсылкаУчетнойЗаписи, Идентификатор) Экспорт
    КонтекстДоступа = НачатьОперациюСНарядом(СсылкаУчетнойЗаписи, Идентификатор, "Dispatcher");
    Попытка
        Объект = КонтекстДоступа.Объект;
        ПроверитьАвторство(СсылкаУчетнойЗаписи, Объект);
        Участники = УчастникиДляВыбора(КонтекстДоступа);
        Адресаты = Новый Массив;
        Для Каждого Участник Из Участники Цикл
            Привязка = ПривязкаДопуска(Объект.Ссылка, Участник.Ссылка);
            Поколение = 0;
            Допуск = Неопределено;
            Если Привязка.Выбран() Тогда
                Разрешение = ОбъектДопускаКНаряду(Привязка.Разрешение, Объект, КонтекстДоступа);
                ПроверитьДействующийДопуск(Привязка, Разрешение, Участник.Ссылка);
                Поколение = Привязка.Поколение;
                Допуск = ДанныеДопускаКНаряду(Разрешение);
            КонецЕсли;
            Адресаты.Добавить(Новый Структура("accountId,name,generation,permit",
                Строка(Участник.Ссылка.УникальныйИдентификатор()), Участник.Наименование, Поколение, Допуск));
        КонецЦикла;
        Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1001 Ссылка ИЗ Справочник.РазрешенияНарядов ГДЕ Наряд = &Наряд И НЕ ПометкаУдаления УПОРЯДОЧИТЬ ПО ДатаСоздания УБЫВ, Ссылка");
        Запрос.УстановитьПараметр("Наряд", Объект.Ссылка);
        Выборка = Запрос.Выполнить().Выбрать();
        Допуски = Новый Массив;
        Пока Выборка.Следующий() Цикл
            Если Допуски.Количество() >= 1000 Тогда ВызватьИсключение "кабинет_наряд_выбор_лимит"; КонецЕсли;
            Допуски.Добавить(ДанныеДопускаКНаряду(ОбъектДопускаКНаряду(Выборка.Ссылка, Объект, КонтекстДоступа)));
        КонецЦикла;
        Результат = Новый Структура("workOrderId,revision,recipients,permits,hasMore",
            Строка(Объект.Ссылка.УникальныйИдентификатор()), Объект.Ревизия, Адресаты, Допуски, Ложь);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция УчастникиДляВыбора(КонтекстДоступа)
    Запрос = Новый Запрос(
        "ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 101 Участие.УчетнаяЗапись КАК Ссылка, Участие.УчетнаяЗапись.Наименование КАК Наименование
        |ИЗ Справочник.Участия КАК Участие
        |ГДЕ Участие.РабочееПространство = &РабочееПространство И НЕ Участие.ПометкаУдаления
        |И Участие.Состояние = &Действующий И Участие.УчетнаяЗапись.Состояние = &Действующий
        |И НЕ Участие.УчетнаяЗапись.ПометкаУдаления
        |И (Участие.СрокИстечения = &НольДата ИЛИ Участие.СрокИстечения > &Сейчас)
        |УПОРЯДОЧИТЬ ПО Наименование, Ссылка");
    Запрос.УстановитьПараметр("РабочееПространство", КонтекстДоступа.РабочееПространство);
    Запрос.УстановитьПараметр("Действующий", "Active");
    Запрос.УстановитьПараметр("НольДата", Дата(1, 1, 1));
    Запрос.УстановитьПараметр("Сейчас", ТекущаяУниверсальнаяДата());
    Выборка = Запрос.Выполнить().Выбрать();
    Результат = Новый Массив;
    Найдено = 0;
    Пока Выборка.Следующий() Цикл
        Найдено = Найдено + 1;
        Если Найдено > 100 Тогда ВызватьИсключение "кабинет_наряд_выбор_лимит"; КонецЕсли;
        Если ЕстьРоль(Выборка.Ссылка, КонтекстДоступа, "") Тогда
            Если Результат.Количество() >= 100 Тогда ВызватьИсключение "кабинет_наряд_выбор_лимит"; КонецЕсли;
            Результат.Добавить(Новый Структура("Ссылка,Наименование", Выборка.Ссылка, Выборка.Наименование));
        КонецЕсли;
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция УчастникиНарядов(СсылкаУчетнойЗаписи, РабочееПространствоИд, ОбластьИд) Экспорт
    КонтекстДоступа = НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, РабочееПространствоИд, ОбластьИд, "Dispatcher");
    Попытка
        Результат = Новый Массив;
        Для Каждого Участник Из УчастникиДляВыбора(КонтекстДоступа) Цикл
            Результат.Добавить(Новый Структура("accountId,name,canLead",
                Строка(Участник.Ссылка.УникальныйИдентификатор()), Участник.Наименование,
                ЕстьРоль(Участник.Ссылка, КонтекстДоступа, "CrewLeader")));
        КонецЦикла;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ВыдатьПриглашениеКНаряду(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, "recipientAccountId,expectedRevision,expectedGeneration,ttlSeconds,reason");
    Адресат = Справочники.УчетныеЗаписи.ПолучитьСсылку(РазобратьИдентификатор(ТекстовоеПоле(ТелоЗапроса, "recipientAccountId", 36)));
    Ревизия = ПолеРевизии(ТелоЗапроса, "expectedRevision");
    Поколение = ПолеРевизии(ТелоЗапроса, "expectedGeneration", Истина);
    СрокДействия = ЧисловоеПолеТела(ТелоЗапроса, "ttlSeconds", 300, 604800, 0);
    Причина = ТекстовоеПоле(ТелоЗапроса, "reason", 250);
    КонтекстДоступа = НачатьОперациюСНарядом(СсылкаУчетнойЗаписи, Идентификатор, "Dispatcher", Ложь, Адресат);
    Попытка
        Объект = КонтекстДоступа.Объект;
        ПроверитьАвторство(СсылкаУчетнойЗаписи, Объект);
        Привязка = ПривязкаДопуска(Объект.Ссылка, Адресат);
        Команда = ОткрытьПривязкуКоманды(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, "permit.invite", КонтекстДоступа, Идентификатор, КодироватьЗначение(ТелоЗапроса, 16000));
        Если Команда.Выбран() Тогда
            Результат = ПовторитьСохраненныйРезультат(Команда);
            Если Не Привязка.Выбран() Или Строка(Привязка.Разрешение.УникальныйИдентификатор()) <> Результат.id Или Привязка.Поколение <> Результат.generation Тогда
                ВызватьИсключение "кабинет_наряд_поколение_конфликт";
            КонецЕсли;
        Иначе
            ПроверитьЦелевойОбъект(Адресат, КонтекстДоступа, "");
            ПроверитьТекущуюРевизию(Объект, Ревизия);
            ТекущийПоколение = 0;
            Если Привязка.Выбран() Тогда
                ТекущийПоколение = Привязка.Поколение;
                Предыдущий = ОбъектДопускаКНаряду(Привязка.Разрешение, Объект, КонтекстДоступа);
                Если Предыдущий.Состояние = "Accepted" И Предыдущий.СрокИстечения > ТекущаяУниверсальнаяДата() Тогда
                    ВызватьИсключение "кабинет_наряд_допуск_активно_конфликт";
                КонецЕсли;
            КонецЕсли;
            Если Поколение <> ТекущийПоколение Или Поколение >= 999999999999998 Тогда
                ВызватьИсключение "кабинет_наряд_поколение_конфликт";
            КонецЕсли;
            УвеличитьРасходКвоты(СсылкаУчетнойЗаписи, КонтекстДоступа, "Permit", 20000);
            Разрешение = Справочники.РазрешенияНарядов.СоздатьЭлемент();
            Разрешение.SetNewObjectRef(Справочники.РазрешенияНарядов.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
            ЗаполнитьСлужебныеОтметки(Разрешение, СсылкаУчетнойЗаписи, КонтекстДоступа, "Pending");
            Разрешение.Наименование = "Recipient-bound appendix read invitation";
            Разрешение.Наряд = Объект.Ссылка;
            Разрешение.Получатель = Адресат;
            Разрешение.Выдавший = СсылкаУчетнойЗаписи;
            Разрешение.Полномочие = "AppendixRead";
            Разрешение.СрокИстечения = ТекущаяУниверсальнаяДата() + СрокДействия;
            Разрешение.Поколение = ТекущийПоколение + 1;
            Разрешение.РевизияДоИзмененияСостояния = 0;
            Разрешение.ОснованиеРешения = Причина;
            Разрешение.Записать();
            Привязка.Наряд = Объект.Ссылка;
            Привязка.УчетнаяЗапись = Адресат;
            Привязка.Разрешение = Разрешение.Ссылка;
            Привязка.Поколение = Разрешение.Поколение;
            Привязка.Записать();
            Результат = ДанныеДопускаКНаряду(Разрешение);
            ЗавершитьОперацию(Команда, "Permit", Разрешение, "permit.invite", Причина, Новый Структура, Результат, СсылкаУчетнойЗаписи, ИдентификаторЗапроса);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ОтветитьНаПриглашениеКНаряду(СсылкаУчетнойЗаписи, ДопускИдентификатор, Действие, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    Если Действие <> "accept" И Действие <> "decline" Тогда
        ВызватьИсключение "кабинет_наряд_некорректно_действие";
    КонецЕсли;
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, "expectedRevision,reason");
    Ревизия = ПолеРевизии(ТелоЗапроса, "expectedRevision");
    Причина = ТекстовоеПоле(ТелоЗапроса, "reason", 250);
    ПредварительныйСнимок = Справочники.РазрешенияНарядов.ПолучитьСсылку(РазобратьИдентификатор(ДопускИдентификатор)).ПолучитьОбъект();
    Если ПредварительныйСнимок = Неопределено Тогда
        ВызватьИсключение "кабинет_наряд_не_найдено";
    КонецЕсли;
    КонтекстДоступа = НачатьОперациюСНарядом(СсылкаУчетнойЗаписи, Строка(ПредварительныйСнимок.Наряд.УникальныйИдентификатор()), "", Ложь, ПредварительныйСнимок.Выдавший);
    Попытка
        Объект = КонтекстДоступа.Объект;
        Привязка = ПривязкаДопуска(Объект.Ссылка, СсылкаУчетнойЗаписи);
        Разрешение = ОбъектДопускаКНаряду(ПредварительныйСнимок.Ссылка, Объект, КонтекстДоступа);
        ПроверитьДействующийДопуск(Привязка, Разрешение, СсылкаУчетнойЗаписи);
        Если Разрешение.СрокИстечения <= ТекущаяУниверсальнаяДата() Тогда
            ВызватьИсключение "кабинет_наряд_допуск_истекло";
        КонецЕсли;
        Если Разрешение.Состояние = "Pending" Тогда
            ПроверитьЦелевойОбъект(Разрешение.Выдавший, КонтекстДоступа, "Dispatcher");
            ПроверитьЦелевойОбъект(СсылкаУчетнойЗаписи, КонтекстДоступа, "");
        КонецЕсли;
        Команда = ОткрытьПривязкуКоманды(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, "permit." + Действие, КонтекстДоступа, ДопускИдентификатор, КодироватьЗначение(ТелоЗапроса, 16000));
        Если Команда.Выбран() Тогда
            Результат = ПовторитьСохраненныйРезультат(Команда);
        Иначе
            ПроверитьТекущуюРевизию(Разрешение, Ревизия);
            Если Разрешение.Состояние <> "Pending" Тогда
                ВызватьИсключение "кабинет_наряд_состояние_конфликт";
            КонецЕсли;
            Перед = ДанныеДопускаКНаряду(Разрешение);
            Разрешение.РевизияДоИзмененияСостояния = Разрешение.Ревизия;
            Разрешение.Состояние = "Accepted";
            Если Действие = "decline" Тогда
                Разрешение.Состояние = "Declined";
            КонецЕсли;
            Разрешение.ДатаРешения = ТекущаяУниверсальнаяДата();
            Разрешение.ОснованиеРешения = Причина;
            УвеличитьРевизиюОбъекта(Разрешение);
            Разрешение.Записать();
            Результат = ДанныеДопускаКНаряду(Разрешение);
            ЗавершитьОперацию(Команда, "Permit", Разрешение, "permit." + Действие, Причина, Перед, Результат, СсылкаУчетнойЗаписи, ИдентификаторЗапроса);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ОтозватьДопускКНаряду(СсылкаУчетнойЗаписи, ДопускИдентификатор, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, "expectedRevision,reason");
    Ревизия = ПолеРевизии(ТелоЗапроса, "expectedRevision");
    Причина = ТекстовоеПоле(ТелоЗапроса, "reason", 250);
    ПредварительныйСнимок = Справочники.РазрешенияНарядов.ПолучитьСсылку(РазобратьИдентификатор(ДопускИдентификатор)).ПолучитьОбъект();
    Если ПредварительныйСнимок = Неопределено Тогда
        ВызватьИсключение "кабинет_наряд_не_найдено";
    КонецЕсли;
    КонтекстДоступа = НачатьОперациюСНарядом(СсылкаУчетнойЗаписи, Строка(ПредварительныйСнимок.Наряд.УникальныйИдентификатор()), "Dispatcher", Ложь, ПредварительныйСнимок.Получатель);
    Попытка
        Объект = КонтекстДоступа.Объект;
        ПроверитьАвторство(СсылкаУчетнойЗаписи, Объект);
        Привязка = ПривязкаДопуска(Объект.Ссылка, ПредварительныйСнимок.Получатель);
        Разрешение = ОбъектДопускаКНаряду(ПредварительныйСнимок.Ссылка, Объект, КонтекстДоступа);
        ПроверитьДействующийДопуск(Привязка, Разрешение, ПредварительныйСнимок.Получатель);
        Команда = ОткрытьПривязкуКоманды(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, "permit.revoke", КонтекстДоступа, ДопускИдентификатор, КодироватьЗначение(ТелоЗапроса, 16000));
        Если Команда.Выбран() Тогда
            Результат = ПовторитьСохраненныйРезультат(Команда);
        Иначе
            ПроверитьТекущуюРевизию(Разрешение, Ревизия);
            Если Разрешение.Состояние <> "Pending" И Разрешение.Состояние <> "Accepted" Тогда
                ВызватьИсключение "кабинет_наряд_состояние_конфликт";
            КонецЕсли;
            Перед = ДанныеДопускаКНаряду(Разрешение);
            Разрешение.РевизияДоИзмененияСостояния = Разрешение.Ревизия;
            Разрешение.Состояние = "Revoked";
            Разрешение.ДатаРешения = ТекущаяУниверсальнаяДата();
            Разрешение.ОснованиеРешения = Причина;
            УвеличитьРевизиюОбъекта(Разрешение);
            Разрешение.Записать();
            Результат = ДанныеДопускаКНаряду(Разрешение);
            ЗавершитьОперацию(Команда, "Permit", Разрешение, "permit.revoke", Причина, Перед, Результат, СсылкаУчетнойЗаписи, ИдентификаторЗапроса);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СписокМоихДопусков(СсылкаУчетнойЗаписи, Лимит = 25, Курсор = "") Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьОтсутствиеТранзакции();
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьУчетныеЗаписи(СсылкаУчетнойЗаписи);
        ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
        ПроверитьЛимитСтраницы(Лимит);
        Префикс = ПрефиксКурсораСтраницы("permits", СсылкаУчетнойЗаписи);
        Позиция = ПозицияСтраницы(Курсор, Префикс);
        ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит + 1, "ЧГ=0") + " Ссылка ИЗ Справочник.РазрешенияНарядов
            |ГДЕ Получатель = &УчетнаяЗапись И НЕ ПометкаУдаления И РабочееПространство.Состояние = &Действующий
            |И НЕ РабочееПространство.ПометкаУдаления И Область.РабочееПространство = РабочееПространство
            |И Область.Состояние = &Действующий И НЕ Область.ПометкаУдаления";
        Если Позиция.ЕстьПозиция Тогда
            ТекстЗапроса = ТекстЗапроса + " И (ДатаСоздания < &ПослеДаты ИЛИ (ДатаСоздания = &ПослеДаты И Ссылка > &ПослеСсылки))";
        КонецЕсли;
        Запрос = Новый Запрос(ТекстЗапроса + " УПОРЯДОЧИТЬ ПО ДатаСоздания УБЫВ, Ссылка");
        Запрос.УстановитьПараметр("УчетнаяЗапись", СсылкаУчетнойЗаписи);
        Запрос.УстановитьПараметр("Действующий", "Active");
        Если Позиция.ЕстьПозиция Тогда
            Запрос.УстановитьПараметр("ПослеДаты", Позиция.Дата);
            Запрос.УстановитьПараметр("ПослеСсылки", Справочники.РазрешенияНарядов.ПолучитьСсылку(РазобратьИдентификатор(Позиция.Ид)));
        КонецЕсли;
        Выборка = Запрос.Выполнить().Выбрать();
        Элементы = Новый Массив; ЕстьЕще = Ложь; Следующий = "";
        Пока Выборка.Следующий() Цикл
            Если Элементы.Количество() = Лимит Тогда ЕстьЕще = Истина; Прервать; КонецЕсли;
            Объект = Выборка.Ссылка.ПолучитьОбъект();
            Элементы.Добавить(ДанныеДопускаКНаряду(Объект));
            Следующий = Префикс + XMLСтрока(Объект.ДатаСоздания) + "Z|" + Строка(Объект.Ссылка.УникальныйИдентификатор());
        КонецЦикла;
        Результат = Новый Структура("items,limit,hasMore,nextCursor", Элементы, Лимит, ЕстьЕще, ?(ЕстьЕще, Следующий, ""));
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СоздатьВерсиюПриложенияНаряда(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, "expectedRevision,expectedVersion,privateText,reason");
    Ревизия = ПолеРевизии(ТелоЗапроса, "expectedRevision");
    Версия = ПолеРевизии(ТелоЗапроса, "expectedVersion", Истина);
    ЗакрытыйТекст = ТекстовоеПоле(ТелоЗапроса, "privateText", 4000, Истина);
    Причина = ТекстовоеПоле(ТелоЗапроса, "reason", 250);
    КонтекстДоступа = НачатьОперациюСНарядом(СсылкаУчетнойЗаписи, Идентификатор, "Dispatcher");
    Попытка
        Объект = КонтекстДоступа.Объект;
        ПроверитьАвторство(СсылкаУчетнойЗаписи, Объект);
        ТекущаяВерсия = ТекущаяВерсияПриложенияНаряда(Объект.Ссылка);
        Команда = ОткрытьПривязкуКоманды(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, "appendix.create", КонтекстДоступа, Идентификатор, КодироватьЗначение(ТелоЗапроса, 16000));
        Если Команда.Выбран() Тогда
            Результат = ПовторитьСохраненныйРезультат(Команда);
        Иначе
            ПроверитьТекущуюРевизию(Объект, Ревизия);
            ТекущийВерсия = 0;
            Если ТекущаяВерсия.Выбран() Тогда
                ТекущийВерсия = ТекущаяВерсия.Версия;
            КонецЕсли;
            Если Версия <> ТекущийВерсия Или Версия >= 1000 Тогда
                ВызватьИсключение "кабинет_наряд_редакция_конфликт";
            КонецЕсли;
            УвеличитьРасходКвоты(СсылкаУчетнойЗаписи, КонтекстДоступа, "Appendix", 20000);
            Приложение = Справочники.ВерсииПриложенийНарядов.СоздатьЭлемент();
            Приложение.SetNewObjectRef(Справочники.ВерсииПриложенийНарядов.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
            ЗаполнитьСлужебныеОтметки(Приложение, СсылкаУчетнойЗаписи, КонтекстДоступа, "Active");
            Приложение.Наименование = "Immutable private technical appendix version";
            Приложение.Наряд = Объект.Ссылка;
            Приложение.Автор = Объект.ДиспетчерАвтор;
            Приложение.Версия = Версия + 1;
            Приложение.ЗакрытыйТекст = ЗакрытыйТекст;
            Приложение.Записать();
            ТекущаяВерсия.Наряд = Объект.Ссылка;
            ТекущаяВерсия.Версия = Приложение.Версия;
            ТекущаяВерсия.Приложение = Приложение.Ссылка;
            ТекущаяВерсия.Записать();
            Результат = ДанныеПриложенияНаряда(Приложение);
            ЗавершитьОперацию(Команда, "Appendix", Приложение, "appendix.create", Причина, Новый Структура, Результат, СсылкаУчетнойЗаписи, ИдентификаторЗапроса);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПолучитьПриложениеНаряда(СсылкаУчетнойЗаписи, Идентификатор, Версия = 0) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьОтсутствиеТранзакции();
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        Полномочие = ПроверитьДоступКПриложениюНаряда(СсылкаУчетнойЗаписи, Идентификатор, "Read", Версия);
        Приложение = Полномочие.Приложение.ПолучитьОбъект();
        Результат = ДанныеПриложенияНаряда(Приложение);
        Результат.Вставить("privateText", Приложение.ЗакрытыйТекст);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПроверитьДоступКПриложениюНаряда(СсылкаУчетнойЗаписи, Идентификатор, Полномочие = "Read", Версия = 0) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    Если Не ТранзакцияАктивна() Тогда
        ВызватьИсключение "кабинет_наряд_транзакция_требуется";
    КонецЕсли;
    Если Полномочие <> "Read" Или ТипЗнч(Версия) <> Тип("Число") Или Версия < 0 Или Версия > 1000 Или Версия <> Цел(Версия) Тогда
        ВызватьИсключение "кабинет_наряд_некорректно_право";
    КонецЕсли;
    ПредварительныйСнимок = ПредставлениеЗаказа(РазобратьИдентификатор(Идентификатор));
    ЗаблокироватьУчетныеЗаписи(СсылкаУчетнойЗаписи, ПредварительныйСнимок.ДиспетчерАвтор);
    ЗаблокироватьОбъектПоСсылке("Справочник.РабочиеПространства", ПредварительныйСнимок.РабочееПространство);
    ЗаблокироватьОбъектПоСсылке("Справочник.Области", ПредварительныйСнимок.Область);
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    КонтекстДоступа = Новый Структура("РабочееПространство,Область", ПредварительныйСнимок.РабочееПространство, ПредварительныйСнимок.Область);
    ПроверитьАктивностьОбласти(КонтекстДоступа);
    Объект = ОбъектНаряда(ПредварительныйСнимок.Ссылка, КонтекстДоступа);
    ПроверитьПредставлениеНаряда(Объект, ПредварительныйСнимок);
    Разрешение = Неопределено;
    СрокИстечения = Дата(1, 1, 1);
    Если Объект.ДиспетчерАвтор <> СсылкаУчетнойЗаписи Тогда
        Привязка = ПривязкаДопуска(Объект.Ссылка, СсылкаУчетнойЗаписи);
        Если Не Привязка.Выбран() Тогда
            ВызватьИсключение "кабинет_наряд_приложение_запрещено";
        КонецЕсли;
        Разрешение = ОбъектДопускаКНаряду(Привязка.Разрешение, Объект, КонтекстДоступа);
        ПроверитьДействующийДопуск(Привязка, Разрешение, СсылкаУчетнойЗаписи);
        Если Разрешение.Состояние <> "Accepted" Или Разрешение.СрокИстечения <= ТекущаяУниверсальнаяДата() Или Разрешение.Полномочие <> "AppendixRead" Тогда
            ВызватьИсключение "кабинет_наряд_приложение_запрещено";
        КонецЕсли;
        СрокИстечения = Разрешение.СрокИстечения;
    КонецЕсли;
    ТекущаяВерсия = ТекущаяВерсияПриложенияНаряда(Объект.Ссылка);
    Если Не ТекущаяВерсия.Выбран() Тогда
        ВызватьИсключение "кабинет_наряд_не_найдено";
    КонецЕсли;
    Если ТекущаяВерсия.Версия < 1 Или ТекущаяВерсия.Версия > 1000 Или ТекущаяВерсия.Версия <> Цел(ТекущаяВерсия.Версия) Или Не ЗначениеЗаполнено(ТекущаяВерсия.Приложение) Тогда
        ВызватьИсключение "кабинет_наряд_привязка_конфликт";
    КонецЕсли;
    Если Версия = 0 Тогда
        Версия = ТекущаяВерсия.Версия;
    КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2 Ссылка ИЗ Справочник.ВерсииПриложенийНарядов ГДЕ Наряд = &Наряд И Версия = &Версия И РабочееПространство = &РабочееПространство И Область = &Область И Автор = &Автор И НЕ ПометкаУдаления");
    УстановитьКонтекстОбласти(Запрос, КонтекстДоступа);
    Запрос.УстановитьПараметр("Наряд", Объект.Ссылка);
    Запрос.УстановитьПараметр("Версия", Версия);
    Запрос.УстановитьПараметр("Автор", Объект.ДиспетчерАвтор);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Тогда
        ВызватьИсключение "кабинет_наряд_не_найдено";
    КонецЕсли;
    ПриложениеСсылка = Выборка.Ссылка;
    Если Выборка.Следующий() Тогда
        ВызватьИсключение "кабинет_наряд_привязка_конфликт";
    КонецЕсли;
    Если Версия = ТекущаяВерсия.Версия И ПриложениеСсылка <> ТекущаяВерсия.Приложение Тогда
        ВызватьИсключение "кабинет_наряд_привязка_конфликт";
    КонецЕсли;
    Возврат Новый Структура("Наряд,Приложение,РабочееПространство,Область,Версия,Автор,СрокИстечения", Объект.Ссылка, ПриложениеСсылка, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область, Версия, Объект.ДиспетчерАвтор, СрокИстечения);
КонецФункции

Процедура ПроверитьГотовностьИнцидента(СсылкаУчетнойЗаписи, ИнцидентСсылка) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    Если Не ТранзакцияАктивна() Тогда
        ВызватьИсключение "кабинет_наряд_транзакция_требуется";
    КонецЕсли;
    Если ТипЗнч(ИнцидентСсылка) <> Тип("СправочникСсылка.ИнцидентыДиспетчерской") Тогда
        ВызватьИсключение "кабинет_наряд_связь_конфликт";
    КонецЕсли;
    Инцидент = ИнцидентСсылка.ПолучитьОбъект();
    Если Инцидент = Неопределено Тогда
        ВызватьИсключение "кабинет_наряд_не_найдено";
    КонецЕсли;
    КонтекстДоступа = Новый Структура("РабочееПространство,Область", Инцидент.РабочееПространство, Инцидент.Область);
    ПроверитьАктивностьОбласти(КонтекстДоступа);
    ПроверитьДанныеЭлемента(Инцидент, КонтекстДоступа);
    ПолитикаДоступа.ПроверитьДоступКОбласти(СсылкаУчетнойЗаписи, Строка(Инцидент.РабочееПространство.УникальныйИдентификатор()), Строка(Инцидент.Область.УникальныйИдентификатор()), "Dispatcher");
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Наряды ГДЕ ИсходныйИнцидент = &Инцидент И ОбязателенДляИнцидента И Состояние <> &Завершенный И Состояние <> &Закрытый");
    Запрос.УстановитьПараметр("Инцидент", ИнцидентСсылка);
    Запрос.УстановитьПараметр("Завершенный", "Completed");
    Запрос.УстановитьПараметр("Закрытый", "Closed");
    Если Не Запрос.Выполнить().Пустой() Тогда
        ВызватьИсключение "кабинет_наряд_незавершено_требуется";
    КонецЕсли;
КонецПроцедуры

Функция СписокЗаписейИстории(СсылкаУчетнойЗаписи, Идентификатор, Лимит = 25, Курсор = "") Экспорт
    КонтекстДоступа = НачатьОперациюСНарядом(СсылкаУчетнойЗаписи, Идентификатор, "");
    Попытка
        ПроверитьЧтениеНаряда(СсылкаУчетнойЗаписи, КонтекстДоступа.Объект, КонтекстДоступа);
        ПроверитьЛимитСтраницы(Лимит);
        Префикс = ПрефиксКурсораСтраницы("history", СсылкаУчетнойЗаписи,
            Строка(КонтекстДоступа.РабочееПространство.УникальныйИдентификатор()), Строка(КонтекстДоступа.Область.УникальныйИдентификатор()),
            Строка(КонтекстДоступа.Объект.Ссылка.УникальныйИдентификатор()));
        Позиция = ПозицияСтраницы(Курсор, Префикс, Истина);
        ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит + 1, "ЧГ=0") + " Ревизия, Операция, Причина, ДатаИзменения,
            |ДействующееЛицо, СнимокДоJSON, СнимокПослеJSON ИЗ РегистрСведений.ИсторияНарядов
            |ГДЕ Вид = &Вид И ИдентификаторСущности = &Идентификатор И РабочееПространство = &РабочееПространство И Область = &Область";
        Если Позиция.ЕстьПозиция Тогда ТекстЗапроса = ТекстЗапроса + " И Ревизия < &ПослеРевизии"; КонецЕсли;
        Запрос = Новый Запрос(ТекстЗапроса + " УПОРЯДОЧИТЬ ПО Ревизия УБЫВ");
        УстановитьКонтекстОбласти(Запрос, КонтекстДоступа);
        Запрос.УстановитьПараметр("Вид", "Order");
        Запрос.УстановитьПараметр("Идентификатор", Строка(КонтекстДоступа.Объект.Ссылка.УникальныйИдентификатор()));
        Если Позиция.ЕстьПозиция Тогда Запрос.УстановитьПараметр("ПослеРевизии", Позиция.Ревизия); КонецЕсли;
        Выборка = Запрос.Выполнить().Выбрать();
        Элементы = Новый Массив; ЕстьЕще = Ложь; Следующий = "";
        Пока Выборка.Следующий() Цикл
            Если Элементы.Количество() = Лимит Тогда ЕстьЕще = Истина; Прервать; КонецЕсли;
            Элементы.Добавить(Новый Структура("revision,operation,reason,changedAt,actorAccountId,before,after",
                Выборка.Ревизия, Выборка.Операция, Выборка.Причина, XMLСтрока(Выборка.ДатаИзменения) + "Z", Строка(Выборка.ДействующееЛицо.УникальныйИдентификатор()), БезопасныйСнимокОбъекта(ДекодироватьЗначение(Выборка.СнимокДоJSON), "Order", Истина), БезопасныйСнимокОбъекта(ДекодироватьЗначение(Выборка.СнимокПослеJSON), "Order")));
            Следующий = Префикс + Формат(Выборка.Ревизия, "ЧГ=0") + "|-";
        КонецЦикла;
        Результат = Новый Структура("items,limit,hasMore,nextCursor", Элементы, Лимит, ЕстьЕще, ?(ЕстьЕще, Следующий, ""));
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПроверитьПолномочияМатериалов(СсылкаУчетнойЗаписи, РабочееПространство, Область, НарядСсылка = Неопределено, Операция = "Read") Экспорт
    Если Не ТранзакцияАктивна() Или ПривилегированныйРежим() Тогда
        ВызватьИсключение "кабинет_наряд_транзакция_требуется";
    КонецЕсли;
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    Если ТипЗнч(РабочееПространство) <> Тип("СправочникСсылка.РабочиеПространства")
        Или ТипЗнч(Область) <> Тип("СправочникСсылка.Области")
        Или СтрРазделить("Read,Request,Consume,Correct", ",").Найти(Операция) = Неопределено Тогда
        ВызватьИсключение "кабинет_наряд_связь_конфликт";
    КонецЕсли;
    ЗаблокироватьУчетныеЗаписи(СсылкаУчетнойЗаписи);
    ЗаблокироватьОбъектПоСсылке("Справочник.РабочиеПространства", РабочееПространство);
    ЗаблокироватьОбъектПоСсылке("Справочник.Области", Область);
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    Контекст = Новый Структура("РабочееПространство,Область", РабочееПространство, Область);
    ПроверитьАктивностьОбласти(Контекст);
    Диспетчер = ЕстьРоль(СсылкаУчетнойЗаписи, Контекст, "Dispatcher");
    РольРуководителя = ЕстьРоль(СсылкаУчетнойЗаписи, Контекст, "CrewLeader");
    Если Не Диспетчер И Не РольРуководителя Тогда ВызватьИсключение "кабинет_область_запрещено"; КонецЕсли;
    Объект = Неопределено; Руководитель = Ложь;
    Если НарядСсылка <> Неопределено Тогда
        Если ТипЗнч(НарядСсылка) <> Тип("СправочникСсылка.Наряды") Или Не ЗначениеЗаполнено(НарядСсылка) Тогда
            ВызватьИсключение "кабинет_наряд_не_найдено";
        КонецЕсли;
        Снимок = ПредставлениеЗаказа(НарядСсылка.УникальныйИдентификатор());
        Если Снимок.РабочееПространство <> РабочееПространство Или Снимок.Область <> Область Тогда
            ВызватьИсключение "кабинет_наряд_не_найдено";
        КонецЕсли;
        ЗаблокироватьСвязиНаряда(Снимок, Контекст);
        Объект = ОбъектНаряда(НарядСсылка, Контекст);
        ПроверитьПредставлениеНаряда(Объект, Снимок);
        Если РольРуководителя И Объект.УчетнаяЗаписьРуководителя = СсылкаУчетнойЗаписи И ЗначениеЗаполнено(Объект.Бригада) Тогда
            Бригада = Объект.Бригада.ПолучитьОбъект();
            ПроверитьДанныеЭлемента(Бригада, Контекст);
            Если Бригада.Состояние = "Active" И Бригада.УчетнаяЗаписьРуководителя = СсылкаУчетнойЗаписи Тогда
                Участник = НайтиСоставБригады(Бригада.Ссылка, СсылкаУчетнойЗаписи);
                Если Участник <> Неопределено Тогда
                    ПроверитьДанныеЭлемента(Участник, Контекст);
                    Руководитель = Участник.Состояние = "Active";
                КонецЕсли;
            КонецЕсли;
        КонецЕсли;
        Если Операция = "Consume" Тогда
            Если Не Руководитель Тогда ВызватьИсключение "кабинет_наряд_не_найдено"; КонецЕсли;
        ИначеЕсли Не Диспетчер И Не Руководитель Тогда
            ВызватьИсключение "кабинет_наряд_не_найдено";
        КонецЕсли;
    ИначеЕсли Операция <> "Read" Тогда
        ВызватьИсключение "кабинет_наряд_не_найдено";
    КонецЕсли;
    Возврат Новый Структура("Объект,Диспетчер,Руководитель,РольРуководителя", Объект, Диспетчер, Руководитель, РольРуководителя);
КонецФункции

Процедура ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи)
    Текущий = ПолитикаДоступа.ПроверитьУчетнуюЗапись();
    Если ТипЗнч(СсылкаУчетнойЗаписи) <> Тип("СправочникСсылка.УчетныеЗаписи") Тогда
        ВызватьИсключение "кабинет_участник_несовпадение";
    КонецЕсли;
    Если Текущий.Ссылка <> СсылкаУчетнойЗаписи Тогда
        ВызватьИсключение "кабинет_участник_несовпадение";
    КонецЕсли;
КонецПроцедуры

Функция НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, Роль, ДругойУчетнаяЗапись = Неопределено)
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьОтсутствиеТранзакции();
    КонтекстДоступа = Новый Структура("РабочееПространство,Область", Справочники.РабочиеПространства.ПолучитьСсылку(РазобратьИдентификатор(РабочаяОбластьИдентификатор)), Справочники.Области.ПолучитьСсылку(РазобратьИдентификатор(ОбластьИдентификатор)));
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьУчетныеЗаписи(СсылкаУчетнойЗаписи, ДругойУчетнаяЗапись);
        ЗаблокироватьОбъектПоСсылке("Справочник.РабочиеПространства", КонтекстДоступа.РабочееПространство);
        ЗаблокироватьОбъектПоСсылке("Справочник.Области", КонтекстДоступа.Область);
        ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
        ПроверитьАктивностьОбласти(КонтекстДоступа);
        Если Роль <> "" Тогда
            ПолитикаДоступа.ПроверитьДоступКОбласти(СсылкаУчетнойЗаписи, Строка(КонтекстДоступа.РабочееПространство.УникальныйИдентификатор()), Строка(КонтекстДоступа.Область.УникальныйИдентификатор()), Роль);
        КонецЕсли;
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат КонтекстДоступа;
КонецФункции

Функция НачатьОперациюСНарядом(СсылкаУчетнойЗаписи, Идентификатор, Роль, РуководительТолько = Ложь, ДругойУчетнаяЗапись = Неопределено)
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПредварительныйСнимок = ПредставлениеЗаказа(РазобратьИдентификатор(Идентификатор));
    КонтекстДоступа = НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, Строка(ПредварительныйСнимок.РабочееПространство.УникальныйИдентификатор()), Строка(ПредварительныйСнимок.Область.УникальныйИдентификатор()), Роль, ДругойУчетнаяЗапись);
    Попытка
        ЗаблокироватьСвязиНаряда(ПредварительныйСнимок, КонтекстДоступа);
        Объект = ОбъектНаряда(ПредварительныйСнимок.Ссылка, КонтекстДоступа);
        ПроверитьПредставлениеНаряда(Объект, ПредварительныйСнимок);
        Если РуководительТолько Тогда
            Если Объект.УчетнаяЗаписьРуководителя <> СсылкаУчетнойЗаписи Или Не ЗначениеЗаполнено(Объект.Бригада) Тогда
                ВызватьИсключение "кабинет_наряд_не_найдено";
            КонецЕсли;
            Бригада = ОбъектБригады(Объект.Бригада.УникальныйИдентификатор(), КонтекстДоступа);
            Если Бригада.УчетнаяЗаписьРуководителя <> СсылкаУчетнойЗаписи Тогда
                ВызватьИсключение "кабинет_наряд_не_найдено";
            КонецЕсли;
            ПроверитьСоставБригады(Бригада.Ссылка, СсылкаУчетнойЗаписи, КонтекстДоступа);
        КонецЕсли;
        КонтекстДоступа.Вставить("Объект", Объект);
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат КонтекстДоступа;
КонецФункции

Процедура ПроверитьАктивностьОбласти(КонтекстДоступа)
    РабочееПространство = КонтекстДоступа.РабочееПространство.ПолучитьОбъект();
    Область = КонтекстДоступа.Область.ПолучитьОбъект();
    Если РабочееПространство = Неопределено Или Область = Неопределено Тогда
        ВызватьИсключение "кабинет_наряд_не_найдено";
    КонецЕсли;
    Если РабочееПространство.ПометкаУдаления Или РабочееПространство.Состояние <> "Active" Или Область.ПометкаУдаления Или Область.Состояние <> "Active" Или Область.РабочееПространство <> КонтекстДоступа.РабочееПространство Тогда
        ВызватьИсключение "кабинет_наряд_не_найдено";
    КонецЕсли;
КонецПроцедуры

Функция ЕстьРоль(Адресат, КонтекстДоступа, Роль)
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 1 ВыборкаМ.Ссылка ИЗ Справочник.Участия КАК ВыборкаМ
        |ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПривязкиПользователей1С КАК ВыборкаН ПО ВыборкаН.УчетнаяЗапись = ВыборкаМ.УчетнаяЗапись И ВыборкаН.ИдентификаторПользователя1С = ВыборкаМ.УчетнаяЗапись.ИдентификаторПользователя1С
        |ГДЕ ВыборкаМ.УчетнаяЗапись = &УчетнаяЗапись И ВыборкаМ.РабочееПространство = &РабочееПространство И ВыборкаМ.Состояние = &Действующий И НЕ ВыборкаМ.ПометкаУдаления
        |И ВыборкаМ.УчетнаяЗапись.Состояние = &Действующий И НЕ ВыборкаМ.УчетнаяЗапись.ПометкаУдаления
        |И (ВыборкаМ.СрокИстечения = &НольДата ИЛИ ВыборкаМ.СрокИстечения > &ТекущееВремя) И (&ЛюбойРоль ИЛИ ВыборкаМ.Роль = &Роль)
        |И ((ВыборкаМ.ОхватОбластей = &ВсеКонтекстДоступа И ВыборкаМ.Область = &ПустойОбласть) ИЛИ
        |(ВыборкаМ.ОхватОбластей = &ОхватОбластей И (&ЛюбойРоль ИЛИ ВыборкаМ.Область = &Область) И ВыборкаМ.Область.РабочееПространство = &РабочееПространство И ВыборкаМ.Область.Состояние = &Действующий И НЕ ВыборкаМ.Область.ПометкаУдаления))");
    УстановитьКонтекстОбласти(Запрос, КонтекстДоступа);
    Запрос.УстановитьПараметр("УчетнаяЗапись", Адресат);
    Запрос.УстановитьПараметр("Роль", Роль);
    Запрос.УстановитьПараметр("ЛюбойРоль", Роль = "");
    Запрос.УстановитьПараметр("Действующий", "Active");
    Запрос.УстановитьПараметр("НольДата", Дата(1, 1, 1));
    Запрос.УстановитьПараметр("ТекущееВремя", ТекущаяУниверсальнаяДата());
    Запрос.УстановитьПараметр("ВсеКонтекстДоступа", "All");
    Запрос.УстановитьПараметр("ОхватОбластей", "Area");
    Запрос.УстановитьПараметр("ПустойОбласть", Справочники.Области.ПустаяСсылка());
    Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

Процедура ПроверитьЦелевойОбъект(Адресат, КонтекстДоступа, Роль)
    Если ТипЗнч(Адресат) <> Тип("СправочникСсылка.УчетныеЗаписи") Или Не ЗначениеЗаполнено(Адресат) Тогда
        ВызватьИсключение "кабинет_наряд_цель_запрещено";
    КонецЕсли;
    Если Не ЕстьРоль(Адресат, КонтекстДоступа, Роль) Тогда
        ВызватьИсключение "кабинет_наряд_цель_запрещено";
    КонецЕсли;
КонецПроцедуры

Функция ПредставлениеЗаказа(Разобранный)
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка, РабочееПространство, Область, ДиспетчерАвтор, ВидИсточника, ИсходныйИнцидент, ИсходноеОбращение, ИсходныйЗаказУслуги, Бригада, УчетнаяЗаписьРуководителя ИЗ Справочник.Наряды ГДЕ Ссылка = &ИдентификаторСсылки И НЕ ПометкаУдаления");
    Запрос.УстановитьПараметр("ИдентификаторСсылки", Справочники.Наряды.ПолучитьСсылку(Разобранный));
    Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Тогда
        ВызватьИсключение "кабинет_наряд_не_найдено";
    КонецЕсли;
    Возврат Новый Структура("Ссылка,РабочееПространство,Область,ДиспетчерАвтор,ВидИсточника,ИсходныйИнцидент,ИсходноеОбращение,ИсходныйЗаказУслуги,Бригада,УчетнаяЗаписьРуководителя",
        Выборка.Ссылка, Выборка.РабочееПространство, Выборка.Область, Выборка.ДиспетчерАвтор, Выборка.ВидИсточника, Выборка.ИсходныйИнцидент, Выборка.ИсходноеОбращение, Выборка.ИсходныйЗаказУслуги, Выборка.Бригада, Выборка.УчетнаяЗаписьРуководителя);
КонецФункции

Процедура ПроверитьПредставлениеНаряда(Объект, ПредварительныйСнимок)
    Если Объект.РабочееПространство <> ПредварительныйСнимок.РабочееПространство Или Объект.Область <> ПредварительныйСнимок.Область Или Объект.ДиспетчерАвтор <> ПредварительныйСнимок.ДиспетчерАвтор
        Или Объект.ИсходныйИнцидент <> ПредварительныйСнимок.ИсходныйИнцидент Или Объект.ИсходноеОбращение <> ПредварительныйСнимок.ИсходноеОбращение
        Или Объект.ВидИсточника <> ПредварительныйСнимок.ВидИсточника Или Объект.ИсходныйЗаказУслуги <> ПредварительныйСнимок.ИсходныйЗаказУслуги
        Или Объект.Бригада <> ПредварительныйСнимок.Бригада Или Объект.УчетнаяЗаписьРуководителя <> ПредварительныйСнимок.УчетнаяЗаписьРуководителя Тогда
        ВызватьИсключение "кабинет_наряд_привязка_конфликт";
    КонецЕсли;
КонецПроцедуры

Процедура ЗаблокироватьСвязиНаряда(ПредварительныйСнимок, КонтекстДоступа)
    ЗаблокироватьИсточник(ПредварительныйСнимок.ИсходныйИнцидент, ПредварительныйСнимок.ИсходноеОбращение, ПредварительныйСнимок.ИсходныйЗаказУслуги);
    Если ЗначениеЗаполнено(ПредварительныйСнимок.Бригада) Тогда
        ЗаблокироватьОбъектПоСсылке("Справочник.РабочиеБригады", ПредварительныйСнимок.Бригада);
    КонецЕсли;
    ЗаблокироватьРесурсы(Новый Массив, ПредварительныйСнимок.Ссылка, КонтекстДоступа);
    ЗаблокироватьОбъектПоСсылке("Справочник.Наряды", ПредварительныйСнимок.Ссылка);
КонецПроцедуры

Функция ОбъектНаряда(ИдентификаторСсылки, КонтекстДоступа)
    ЗаблокироватьОбъектПоСсылке("Справочник.Наряды", ИдентификаторСсылки);
    Объект = ИдентификаторСсылки.ПолучитьОбъект();
    ПроверитьДанныеЭлемента(Объект, КонтекстДоступа);
    Если Объект.ДиспетчерАвтор <> Объект.КемСоздано Или Не ЗначениеЗаполнено(Объект.ДиспетчерАвтор)
        Или СтрРазделить("Draft,Assigned,Accepted,InProgress,Paused,Reported,Verified,Closed,Cancelled,Submitted,Rework,Completed", ",").Найти(Объект.Состояние) = Неопределено Тогда
        ВызватьИсключение "кабинет_наряд_привязка_конфликт";
    КонецЕсли;
    Если Объект.ВидИсточника = "Request" Тогда
        Если Не ЗначениеЗаполнено(Объект.ИсходноеОбращение) Или ЗначениеЗаполнено(Объект.ИсходныйЗаказУслуги) Тогда
            ВызватьИсключение "кабинет_наряд_привязка_конфликт";
        КонецЕсли;
    ИначеЕсли Объект.ВидИсточника = "Incident" Тогда
        Если Не ЗначениеЗаполнено(Объект.ИсходныйИнцидент) Или ЗначениеЗаполнено(Объект.ИсходноеОбращение) Или ЗначениеЗаполнено(Объект.ИсходныйЗаказУслуги) Тогда
            ВызватьИсключение "кабинет_наряд_привязка_конфликт";
        КонецЕсли;
    ИначеЕсли Объект.ВидИсточника = "ServiceOrder" Тогда
        Если Не ЗначениеЗаполнено(Объект.ИсходныйЗаказУслуги) Или ЗначениеЗаполнено(Объект.ИсходноеОбращение)
            Или ЗначениеЗаполнено(Объект.ИсходныйИнцидент) Или Объект.ОбязателенДляИнцидента Тогда
            ВызватьИсключение "кабинет_наряд_привязка_конфликт";
        КонецЕсли;
        ПроверитьЗаказУслуги(Объект.ИсходныйЗаказУслуги.ПолучитьОбъект(), КонтекстДоступа);
    Иначе
        ВызватьИсключение "кабинет_наряд_привязка_конфликт";
    КонецЕсли;
    Если Объект.ОбязателенДляИнцидента И Не ЗначениеЗаполнено(Объект.ИсходныйИнцидент) Тогда
        ВызватьИсключение "кабинет_наряд_привязка_конфликт";
    КонецЕсли;
    Возврат Объект;
КонецФункции

Функция ОбъектБригады(Разобранный, КонтекстДоступа)
    ИдентификаторСсылки = Справочники.РабочиеБригады.ПолучитьСсылку(Разобранный);
    ЗаблокироватьОбъектПоСсылке("Справочник.РабочиеБригады", ИдентификаторСсылки);
    Объект = ИдентификаторСсылки.ПолучитьОбъект();
    ПроверитьДанныеЭлемента(Объект, КонтекстДоступа);
    Если Объект.Состояние <> "Active" Или Не ЗначениеЗаполнено(Объект.УчетнаяЗаписьРуководителя) Тогда
        ВызватьИсключение "кабинет_наряд_связь_конфликт";
    КонецЕсли;
    Возврат Объект;
КонецФункции

Функция ОбъектРесурса(ИдентификаторСсылки, КонтекстДоступа)
    ЗаблокироватьОбъектПоСсылке("Справочник.РесурсыНарядов", ИдентификаторСсылки);
    Объект = ИдентификаторСсылки.ПолучитьОбъект();
    ПроверитьДанныеЭлемента(Объект, КонтекстДоступа);
    Если Объект.Состояние <> "Active" Или Объект.Вместимость < 1 Или Объект.Вместимость > 1000 Или Объект.Вместимость <> Цел(Объект.Вместимость) Тогда
        ВызватьИсключение "кабинет_наряд_связь_конфликт";
    КонецЕсли;
    Возврат Объект;
КонецФункции

Процедура ПроверитьДанныеЭлемента(Объект, КонтекстДоступа)
    Если Объект = Неопределено Тогда
        ВызватьИсключение "кабинет_наряд_не_найдено";
    КонецЕсли;
    Гостевой = Ложь;
    Если ТипЗнч(Объект) = Тип("СправочникОбъект.ОбращенияДиспетчерской") Тогда
        Гостевой = Объект.Источник = "GuestReceipt";
        Если Гостевой Тогда СервисДиспетчерской.ПроверитьПривязкуГостевогоОбращения(Объект); КонецЕсли;
    КонецЕсли;
    Если Объект.ПометкаУдаления Или Объект.РабочееПространство <> КонтекстДоступа.РабочееПространство Или Объект.Область <> КонтекстДоступа.Область
        Или (Не Гостевой И Не ЗначениеЗаполнено(Объект.КемСоздано)) Или Объект.ДатаСоздания = Дата(1, 1, 1)
        Или Объект.Ревизия < 1 Или Объект.Ревизия <> Цел(Объект.Ревизия) Тогда
        ВызватьИсключение "кабинет_наряд_не_найдено";
    КонецЕсли;
КонецПроцедуры

Функция НайтиСоставБригады(БригадаСсылка, Адресат)
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2 Ссылка ИЗ Справочник.УчастникиРабочихБригад ГДЕ Бригада = &Бригада И УчетнаяЗапись = &УчетнаяЗапись");
    Запрос.УстановитьПараметр("Бригада", БригадаСсылка);
    Запрос.УстановитьПараметр("УчетнаяЗапись", Адресат);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Тогда
        Возврат Неопределено;
    КонецЕсли;
    ИдентификаторСсылки = Выборка.Ссылка;
    Если Выборка.Следующий() Тогда
        ВызватьИсключение "кабинет_наряд_привязка_конфликт";
    КонецЕсли;
    Возврат ИдентификаторСсылки.ПолучитьОбъект();
КонецФункции

Процедура ПроверитьСоставБригады(БригадаСсылка, Адресат, КонтекстДоступа)
    Участник = НайтиСоставБригады(БригадаСсылка, Адресат);
    ПроверитьДанныеЭлемента(Участник, КонтекстДоступа);
    Если Участник.Состояние <> "Active" Тогда
        ВызватьИсключение "кабинет_наряд_не_найдено";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьЧтениеНаряда(СсылкаУчетнойЗаписи, Объект, КонтекстДоступа)
    Если ЕстьРоль(СсылкаУчетнойЗаписи, КонтекстДоступа, "Dispatcher") Тогда
        Возврат;
    КонецЕсли;
    Если Объект.УчетнаяЗаписьРуководителя = СсылкаУчетнойЗаписи И ЗначениеЗаполнено(Объект.Бригада) И ЕстьРоль(СсылкаУчетнойЗаписи, КонтекстДоступа, "CrewLeader") Тогда
        Бригада = Объект.Бригада.ПолучитьОбъект();
        ПроверитьДанныеЭлемента(Бригада, КонтекстДоступа);
        Если Бригада.Состояние = "Active" И Бригада.УчетнаяЗаписьРуководителя = СсылкаУчетнойЗаписи Тогда
            ПроверитьСоставБригады(Бригада.Ссылка, СсылкаУчетнойЗаписи, КонтекстДоступа);
            Возврат;
        КонецЕсли;
    КонецЕсли;
    ВызватьИсключение "кабинет_наряд_не_найдено";
КонецПроцедуры

Процедура ПроверитьАвторство(СсылкаУчетнойЗаписи, Объект)
    Если Объект.ДиспетчерАвтор <> СсылкаУчетнойЗаписи Тогда
        ВызватьИсключение "кабинет_наряд_приложение_запрещено";
    КонецЕсли;
КонецПроцедуры

Процедура ЗаблокироватьИсточник(ИнцидентСсылка, ЗапросКлиентаСсылка, ЗаказУслугиСсылка = Неопределено)
    Если ЗначениеЗаполнено(ИнцидентСсылка) Тогда
        ЗаблокироватьОбъектПоСсылке("Справочник.ИнцидентыДиспетчерской", ИнцидентСсылка);
    КонецЕсли;
    Если ЗначениеЗаполнено(ЗапросКлиентаСсылка) Тогда
        ЗаблокироватьОбъектПоСсылке("Справочник.ОбращенияДиспетчерской", ЗапросКлиентаСсылка);
    КонецЕсли;
    Если ЗначениеЗаполнено(ЗаказУслугиСсылка) Тогда
        ЗаблокироватьОбъектПоСсылке("Справочник.ЗаказыУслуг", ЗаказУслугиСсылка);
    КонецЕсли;
КонецПроцедуры

Функция ПолучитьЗаблокированныйИсточник(Вид, Разобранный, КонтекстДоступа)
    ЗапросКлиентаСсылка = Справочники.ОбращенияДиспетчерской.ПустаяСсылка();
    ИнцидентСсылка = Справочники.ИнцидентыДиспетчерской.ПустаяСсылка();
    ЗаказУслугиСсылка = Справочники.ЗаказыУслуг.ПустаяСсылка();
    Если Вид = "Request" Тогда
        ЗапросКлиентаСсылка = Справочники.ОбращенияДиспетчерской.ПолучитьСсылку(Разобранный);
        ПредварительныйСнимок = ЗапросКлиентаСсылка.ПолучитьОбъект();
        ПроверитьДанныеЭлемента(ПредварительныйСнимок, КонтекстДоступа);
        ИнцидентСсылка = ПредварительныйСнимок.Инцидент;
        ЗаблокироватьИсточник(ИнцидентСсылка, ЗапросКлиентаСсылка);
        Объект = ЗапросКлиентаСсылка.ПолучитьОбъект();
        ПроверитьДанныеЭлемента(Объект, КонтекстДоступа);
        Если Объект.Инцидент <> ИнцидентСсылка Тогда
            ВызватьИсключение "кабинет_наряд_привязка_конфликт";
        КонецЕсли;
        Если Объект.Состояние = "Rejected" Или Объект.Состояние = "Resolved" Тогда
            ВызватьИсключение "кабинет_наряд_состояние_конфликт";
        КонецЕсли;
    ИначеЕсли Вид = "Incident" Тогда
        ИнцидентСсылка = Справочники.ИнцидентыДиспетчерской.ПолучитьСсылку(Разобранный);
        ЗаблокироватьИсточник(ИнцидентСсылка, ЗапросКлиентаСсылка);
    ИначеЕсли Вид = "ServiceOrder" Тогда
        ЗаказУслугиСсылка = Справочники.ЗаказыУслуг.ПолучитьСсылку(Разобранный);
        ЗаказУслуги = ЗаблокированныйЗаказУслуги(ЗаказУслугиСсылка, КонтекстДоступа);
    Иначе
        ВызватьИсключение "кабинет_наряд_некорректно_поле";
    КонецЕсли;
    Если ЗначениеЗаполнено(ИнцидентСсылка) Тогда
        Инцидент = ИнцидентСсылка.ПолучитьОбъект();
        ПроверитьДанныеЭлемента(Инцидент, КонтекстДоступа);
        Если Инцидент.Состояние <> "Open" Тогда
            ВызватьИсключение "кабинет_наряд_состояние_конфликт";
        КонецЕсли;
    КонецЕсли;
    Возврат Новый Структура("Запрос,Инцидент,ЗаказУслуги", ЗапросКлиентаСсылка, ИнцидентСсылка, ЗаказУслугиСсылка);
КонецФункции

