Функция СоздатьПервогоАдминистратора() Экспорт
    Если ПривилегированныйРежим() Или ТранзакцияАктивна() Тогда ВызватьИсключение "первичная_оператор_некорректно_контекст"; КонецЕсли;
    Если ПользователиИнформационнойБазы.ПолучитьПользователей().Количество() <> 0 Тогда ВызватьИсключение "первичная_оператор_уже_инициализировано"; КонецЕсли;
    ФайлПароля = Новый Файл("/run/secrets/operator_password");
    Если Не ФайлПароля.Существует() Или ФайлПароля.Размер() <> 43 Тогда ВызватьИсключение "первичная_оператор_секрет_отсутствует"; КонецЕсли;
    Чтение = Новый ЧтениеТекста(ФайлПароля.ПолноеИмя, КодировкаТекста.UTF8);
    Пароль = Чтение.ПрочитатьСтроку(); Чтение.Закрыть();
    Если СтрДлина(Пароль) <> 43 Тогда ВызватьИсключение "первичная_оператор_секрет_некорректно"; КонецЕсли;
    Для Номер = 1 По 43 Цикл
        Если СтрНайти("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-", Сред(Пароль, Номер, 1)) = 0 Тогда
            ВызватьИсключение "первичная_оператор_секрет_некорректно";
        КонецЕсли;
    КонецЦикла;
    Пользователь = ПользователиИнформационнойБазы.СоздатьПользователя();
    Пользователь.Имя = "administrator"; Пользователь.ПолноеИмя = "Оператор установки";
    Пользователь.АутентификацияСтандартная = Истина; Пользователь.АутентификацияОС = Ложь;
    Пользователь.ПоказыватьВСпискеВыбора = Ложь; Пользователь.Пароль = Пароль;
    Пользователь.Роли.Добавить(Метаданные.Роли.Администратор); Пользователь.Язык = Метаданные.Языки.Русский;
    Пользователь.Записать(); Пароль = "";
    Возврат "first_operator_created";
КонецФункции

Функция НастроитьИзФайлаОператора() Экспорт
    Если ПривилегированныйРежим() Тогда ВызватьИсключение "идентификация_оператор_требуется"; КонецЕсли;
    Текущий = ПользователиИнформационнойБазы.ТекущийПользователь();
    Если Текущий = Неопределено Тогда ВызватьИсключение "идентификация_оператор_требуется"; КонецЕсли;
    Свежий = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Текущий.УникальныйИдентификатор);
    Если Свежий = Неопределено Тогда ВызватьИсключение "идентификация_оператор_требуется"; КонецЕсли;
    Администратор = Ложь;
    Для Каждого Роль Из Свежий.Роли Цикл
        Если Роль = Метаданные.Роли.Администратор Тогда Администратор = Истина; КонецЕсли;
    КонецЦикла;
    Если Не Администратор Тогда ВызватьИсключение "идентификация_оператор_требуется"; КонецЕсли;
    Результат = УзкийКонтурИдентичности1С.НастроитьШлюзИзФайлаОператора();
    Писатель = Новый ЗаписьJSON; Писатель.УстановитьСтроку();
    ЗаписатьJSON(Писатель, Результат);
    Возврат Писатель.Закрыть();
КонецФункции
