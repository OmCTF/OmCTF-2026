Функция Обработать(Действие, Запрос, Корреляция) Экспорт
    НативныйИд = ПроверитьСвежегоПользователя();
    Если СтрРазделить("publicDispatchIntakes,publicDispatchAddresses,publicDispatchOutages,publicDispatchHazard,publicDispatchReceipt", ",").Найти(Действие) = Неопределено Тогда ВызватьИсключение "гость_шлюз_не_найдено"; КонецЕсли;
    ЭтоЗапись = Действие = "publicDispatchHazard";
    Если Запрос.HTTPМетод <> ?(ЭтоЗапись, "POST", "GET") Тогда ВызватьИсключение "гость_шлюз_некорректно_ввод"; КонецЕсли;
    Если ТранзакцияАктивна() Тогда ВызватьИсключение "гость_шлюз_недоступно"; КонецЕсли;
    Настройки = РегистрыСведений.СекретГостевогоШлюза.СоздатьМенеджерЗаписи(); Настройки.Назначение = "dispatch-v1"; Настройки.Прочитать();
    Если Не Настройки.Выбран() Или Настройки.НативныйПользователь <> НативныйИд Или СтрДлина(Настройки.КлючИсточника) <> 64 Тогда ВызватьИсключение "гость_шлюз_недоступно"; КонецЕсли;
    Для Н = 1 По 64 Цикл
        Если СтрНайти("0123456789abcdef", Сред(Настройки.КлючИсточника, Н, 1)) = 0 Тогда ВызватьИсключение "гость_шлюз_недоступно"; КонецЕсли;
    КонецЦикла;
    Источник = APIКабинета.ЗаголовокЗапроса(Запрос, "X-Vodokanal-Remote-Addr");
    Если Источник = "" Или СтрДлина(Источник) > 64 Тогда ВызватьИсключение "гость_шлюз_запрещено"; КонецЕсли;
    Для Н = 1 По СтрДлина(Источник) Цикл
        Если СтрНайти("0123456789abcdefABCDEF:.", Сред(Источник, Н, 1)) = 0 Тогда ВызватьИсключение "гость_шлюз_запрещено"; КонецЕсли;
    КонецЦикла;
    ИсточникХеш = Хеш("dispatch-source-v1|" + НРег(Источник) + "|" + Настройки.КлючИсточника);
    Если ЭтоЗапись Тогда
        Если APIКабинета.ЗаголовокЗапроса(Запрос, "X-Vodokanal-Request") <> "1" Тогда ВызватьИсключение "гость_шлюз_источник_запрещено"; КонецЕсли;
        ИсточникЗапроса = APIКабинета.ЗаголовокЗапроса(Запрос, "Origin");
        Если ИсточникЗапроса <> Настройки.ПубличныйАдрес
            И Не APIКабинета.РазрешенныйВнутрисетевойИсточник(НРег(ИсточникЗапроса), APIКабинета.ЗаголовокЗапроса(Запрос, "Host")) Тогда
            ВызватьИсключение "гость_шлюз_источник_запрещено";
        КонецЕсли;
        МетаданныеИсточника = НРег(APIКабинета.ЗаголовокЗапроса(Запрос, "Sec-Fetch-Site"));
        Если МетаданныеИсточника <> "" И МетаданныеИсточника <> "same-origin" Тогда ВызватьИсключение "гость_шлюз_источник_запрещено"; КонецЕсли;
        Разрешенные = "";
    ИначеЕсли Действие = "publicDispatchIntakes" Тогда Разрешенные = "limit,cursor";
    ИначеЕсли Действие = "publicDispatchAddresses" Тогда Разрешенные = "q,limit,cursor";
    ИначеЕсли Действие = "publicDispatchOutages" Тогда Разрешенные = "address,from,to,status,limit,cursor";
    Иначе Разрешенные = ""; КонецЕсли;
    ПроверитьПараметры(Запрос, Разрешенные);
    Если Действие <> "publicDispatchReceipt" И APIКабинета.ЗаголовокЗапроса(Запрос, "X-Receipt-Secret") <> "" Тогда ВызватьИсключение "гость_шлюз_некорректно_ввод"; КонецЕсли;
    ПроверитьЛимит(ЭтоЗапись);
    Если ЭтоЗапись Тогда
        Тело = Запрос.ПолучитьТелоКакДвоичныеДанные();
        Если Тело = Неопределено Тогда ВызватьИсключение "гость_шлюз_некорректно_ввод"; КонецЕсли;
        Если Тело.Размер() < 2 Или Тело.Размер() > 7340032 Тогда ВызватьИсключение "гость_шлюз_тело_слишком_большое"; КонецЕсли;
    КонецЕсли;
    Если Действие = "publicDispatchIntakes" Тогда
        Результат = СервисДиспетчерской.ПубличныеПриемные(Запрос.ПараметрыЗапроса);
    ИначеЕсли Действие = "publicDispatchAddresses" Тогда
        Результат = СервисДиспетчерской.ПубличныеАдреса(Запрос.ПараметрыЗапроса);
    ИначеЕсли Действие = "publicDispatchOutages" Тогда
        Результат = СервисДиспетчерской.ПубличныеОтключения(Запрос.ПараметрыЗапроса);
    ИначеЕсли Действие = "publicDispatchReceipt" Тогда
        Результат = СервисДиспетчерской.СтатусГостевойКвитанции(Запрос.ПараметрыURL.Получить("id"), APIКабинета.ЗаголовокЗапроса(Запрос, "X-Receipt-Secret"));
    ИначеЕсли Действие = "publicDispatchHazard" Тогда
        Результат = СервисДиспетчерской.СоздатьГостевоеОбращение(APIКабинета.РазобратьТелоЗапроса(Запрос, 7340032),
            APIКабинета.ЗаголовокЗапроса(Запрос, "Idempotency-Key"), ИсточникХеш);
    КонецЕсли;
    Возврат APIКабинета.СформироватьОтветHTTP(?(Действие = "publicDispatchHazard", 201, 200), Результат, Корреляция);
КонецФункции

Функция ПроверитьСвежегоПользователя()
    Текущий = ПользователиИнформационнойБазы.ТекущийПользователь();
    Если Текущий = Неопределено Тогда ВызватьИсключение "гость_шлюз_запрещено"; КонецЕсли;
    Если Текущий.Имя <> "vodokanal_intake_gateway" Тогда ВызватьИсключение "гость_шлюз_запрещено"; КонецЕсли;
    Свежий = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Текущий.УникальныйИдентификатор);
    Если Свежий = Неопределено Тогда ВызватьИсключение "гость_шлюз_запрещено"; КонецЕсли;
    РольШлюза = Метаданные.Роли.Найти("ШлюзГостевыхОбращений");
    Если РольШлюза = Неопределено Тогда ВызватьИсключение "гость_шлюз_запрещено"; КонецЕсли;
    Если РольШлюза.РасширениеКонфигурации() <> Неопределено Или РольШлюза.ЕстьИзмененияРасширениямиКонфигурации() Тогда ВызватьИсключение "гость_шлюз_запрещено"; КонецЕсли;
    Если Свежий.Имя <> "vodokanal_intake_gateway" Или Не Свежий.АутентификацияСтандартная Или Свежий.АутентификацияОС Или Свежий.ПоказыватьВСпискеВыбора Тогда ВызватьИсключение "гость_шлюз_запрещено"; КонецЕсли;
    Количество = 0;
    Для Каждого Роль Из Свежий.Роли Цикл
        Количество = Количество + 1; Если Роль <> РольШлюза Тогда ВызватьИсключение "гость_шлюз_запрещено"; КонецЕсли;
    КонецЦикла;
    Если Количество <> 1 Тогда ВызватьИсключение "гость_шлюз_запрещено"; КонецЕсли;
    Возврат Строка(Свежий.УникальныйИдентификатор);
КонецФункции

Процедура ПроверитьПараметры(Запрос, Поля)
    Допустимые = СтрРазделить(Поля, ",", Ложь);
    Для Каждого Пара Из Запрос.ПараметрыЗапроса Цикл
        Если Допустимые.Найти(Пара.Ключ) = Неопределено Или ТипЗнч(Пара.Значение) <> Тип("Строка") Или СтрДлина(Пара.Значение) > 2000 Тогда ВызватьИсключение "гость_шлюз_некорректно_ввод"; КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция Хеш(Значение)
    Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
    Хеширование.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Значение, КодировкаТекста.UTF8, Ложь));
    Возврат Base64Строка(Хеширование.ХешСумма);
КонецФункции

Процедура ПроверитьЛимит(Запись)
    Вид = ?(Запись, "write", "read"); ОбщийКлюч = "dispatch:" + Вид;
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьКлюч(ОбщийКлюч);
        ПроверитьСчетчик(ОбщийКлюч, ?(Запись, 100, 3000));
        ЗафиксироватьТранзакцию();
    Исключение
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли; ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

Процедура ЗаблокироватьКлюч(Ключ)
    Блокировка = Новый БлокировкаДанных; Элемент = Блокировка.Добавить("РегистрСведений.ЛимитыПубличногоШлюза");
    Элемент.Режим = РежимБлокировкиДанных.Исключительный; Элемент.УстановитьЗначение("Ключ", Ключ); Блокировка.Заблокировать();
КонецПроцедуры

Процедура ПроверитьСчетчик(Ключ, Предел)
    Счетчик = РегистрыСведений.ЛимитыПубличногоШлюза.СоздатьМенеджерЗаписи(); Счетчик.Ключ = Ключ; Счетчик.Прочитать(); Счетчик.Ключ = Ключ;
    Сейчас = ТекущаяУниверсальнаяДата(); Если Сейчас < Счетчик.ПоследнийМомент Тогда Сейчас = Счетчик.ПоследнийМомент; КонецЕсли;
    Если Не Счетчик.Выбран() Или Сейчас >= Счетчик.НачалоОкна + 60 Тогда Счетчик.НачалоОкна = Сейчас; Счетчик.Количество = 0; КонецЕсли;
    Если Счетчик.Количество >= Предел Тогда ВызватьИсключение "гость_шлюз_частота_ограничено"; КонецЕсли;
    Счетчик.ПоследнийМомент = Сейчас; Счетчик.Количество = Счетчик.Количество + 1; Счетчик.Записать();
КонецПроцедуры
