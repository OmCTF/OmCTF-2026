
Функция НативнаяИдентичность() Экспорт
    Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
    Если Пользователь = Неопределено Тогда
        ВызватьИсключение "кабинет_аутентификация_требуется";
    КонецЕсли;
    Если ПустаяСтрока(Пользователь.Имя) Тогда
        ВызватьИсключение "кабинет_аутентификация_требуется";
    КонецЕсли;
    Возврат Новый Структура("nativeUserId,nativeName", Строка(Пользователь.УникальныйИдентификатор), Пользователь.Имя);
КонецФункции

Функция НайтиУчетнуюЗапись() Экспорт
    Личность = НативнаяИдентичность();
    Запрос = Новый Запрос(
        "ВЫБРАТЬ УчетнаяЗапись ИЗ РегистрСведений.ПривязкиПользователей1С
        |ГДЕ ИдентификаторПользователя1С = &ИдентификаторПользователя1С");
    Запрос.УстановитьПараметр("ИдентификаторПользователя1С", Личность.nativeUserId);
    ВыборкаДанных = Запрос.Выполнить().Выбрать();
    Если Не ВыборкаДанных.Следующий() Тогда
        Возврат Неопределено;
    КонецЕсли;
    Если Не ЗначениеЗаполнено(ВыборкаДанных.УчетнаяЗапись) Тогда
        Возврат Неопределено;
    КонецЕсли;
    Возврат ВыборкаДанных.УчетнаяЗапись;
КонецФункции

Функция ПроверитьУчетнуюЗапись() Экспорт
    СсылкаУчетнойЗаписи = НайтиУчетнуюЗапись();
    Если СсылкаУчетнойЗаписи = Неопределено Тогда
        ВызватьИсключение "кабинет_учетная_запись_требуется";
    КонецЕсли;
    УчетнаяЗапись = СсылкаУчетнойЗаписи.ПолучитьОбъект();
    Если УчетнаяЗапись = Неопределено Тогда
        ВызватьИсключение "кабинет_учетная_запись_требуется";
    КонецЕсли;
    Если УчетнаяЗапись.ПометкаУдаления Или УчетнаяЗапись.Состояние <> "Active" Тогда
        ВызватьИсключение "кабинет_учетная_запись_отключено";
    КонецЕсли;
    Личность = НативнаяИдентичность();
    Если УчетнаяЗапись.ИдентификаторПользователя1С <> Личность.nativeUserId Тогда
        ВызватьИсключение "кабинет_идентификация_привязка_конфликт";
    КонецЕсли;
    Возврат УчетнаяЗапись;
КонецФункции

Функция ПроверитьДоступКРабочемуПространству(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ТребуемыйРоль = "") Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    Если ТипЗнч(ТребуемыйРоль) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_некорректно_роль";
    КонецЕсли;
    Если Не ПустаяСтрока(ТребуемыйРоль) Тогда
        Если ТребуемыйРоль <> "WorkspaceOwner" И Не РольРазрешенаКНазначению(ТребуемыйРоль) Тогда
            ВызватьИсключение "кабинет_некорректно_роль";
        КонецЕсли;
    КонецЕсли;
    РабочееПространство = ОпределитьРабочееПространство(РабочаяОбластьИдентификатор);
    Если РабочееПространство.ПометкаУдаления Или РабочееПространство.Состояние <> "Active" Тогда
        ВызватьИсключение "кабинет_пространство_неактивно";
    КонецЕсли;
    Если Не ЕстьДействующееУчастие(СсылкаУчетнойЗаписи, РабочееПространство.Ссылка, ТребуемыйРоль, ТекущаяУниверсальнаяДата()) Тогда
        ВызватьИсключение "кабинет_пространство_запрещено";
    КонецЕсли;
    Если ТребуемыйРоль = "WorkspaceOwner" И РабочееПространство.УчетнаяЗаписьВладельца <> СсылкаУчетнойЗаписи Тогда
        ВызватьИсключение "кабинет_пространство_запрещено";
    КонецЕсли;
    Возврат РабочееПространство.Ссылка;
КонецФункции

Функция ЕстьЛичноеРабочееПространство(СсылкаУчетнойЗаписи) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.РабочиеПространства
        |ГДЕ УчетнаяЗаписьВладельца = &УчетнаяЗапись И Профиль = &Профиль");
    Запрос.УстановитьПараметр("УчетнаяЗапись", СсылкаУчетнойЗаписи);
    Запрос.УстановитьПараметр("Профиль", "AD");
    Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

Функция СоздатьРабочееПространство(СсылкаУчетнойЗаписи, Имя, ИдентификаторЗапроса = Неопределено) Экспорт
    Если ТипЗнч(Имя) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_некорректно_пространство_имя";
    КонецЕсли;
    ИсходноеТелоКоманды = Новый Структура("name", Имя);
    Если ИдентификаторЗапроса <> Неопределено Тогда ИдентификаторЗапроса = Строка(РазобратьИдентификатор(ИдентификаторЗапроса)); КонецЕсли;
    Имя = СокрЛП(Имя);
    Если ПустаяСтрока(Имя) Или СтрДлина(Имя) > 150 Тогда
        ВызватьИсключение "кабинет_некорректно_пространство_имя";
    КонецЕсли;
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьУчетныеЗаписи(СсылкаУчетнойЗаписи);
        ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
        Если ИдентификаторЗапроса <> Неопределено Тогда
            СтараяКоманда = РегистрыСведений.ПривязкиКомандЖизненногоЦиклаРеестра.СоздатьМенеджерЗаписи();
            СтараяКоманда.УчетнаяЗапись = СсылкаУчетнойЗаписи; СтараяКоманда.ИдентификаторЗапроса = ИдентификаторЗапроса; СтараяКоманда.Прочитать();
            Если СтараяКоманда.Выбран() И СтараяКоманда.Вид = "workspaces" И СтараяКоманда.Операция = "create.workspaces" Тогда
                ИсходноеПространство = СтараяКоманда.РабочееПространство;
                ЗаблокироватьОбъектПоСсылке("Справочник.РабочиеПространства", ИсходноеПространство);
                ПроверитьДоступКРабочемуПространству(СсылкаУчетнойЗаписи, Строка(ИсходноеПространство.УникальныйИдентификатор()), "WorkspaceOwner");
                ПривязатьСозданиеПространства(СсылкаУчетнойЗаписи, ИсходноеПространство, ИдентификаторЗапроса, ИсходноеТелоКоманды);
                ЗафиксироватьТранзакцию(); Возврат ИсходноеПространство;
            КонецЕсли;
        КонецЕсли;
        Запрос = Новый Запрос(
            "ВЫБРАТЬ ПЕРВЫЕ 2 Ссылка, Состояние, ПометкаУдаления ИЗ Справочник.РабочиеПространства
            |ГДЕ УчетнаяЗаписьВладельца = &УчетнаяЗапись И Профиль = &Профиль
            |УПОРЯДОЧИТЬ ПО ДатаСоздания, Ссылка");
        Запрос.УстановитьПараметр("УчетнаяЗапись", СсылкаУчетнойЗаписи);
        Запрос.УстановитьПараметр("Профиль", "AD");
        ВыборкаДанных = Запрос.Выполнить().Выбрать();
        Если ВыборкаДанных.Следующий() Тогда
            Существующий = ВыборкаДанных.Ссылка;
            Если ВыборкаДанных.Следующий() Тогда
                ВызватьИсключение "кабинет_пространство_конфликт";
            КонецЕсли;
            ЗаблокироватьОбъектПоСсылке("Справочник.РабочиеПространства", Существующий);
            Существующий = ПроверитьДоступКРабочемуПространству(СсылкаУчетнойЗаписи, Строка(Существующий.УникальныйИдентификатор()), "WorkspaceOwner");
            ПривязатьСозданиеПространства(СсылкаУчетнойЗаписи, Существующий, ИдентификаторЗапроса, ИсходноеТелоКоманды);
            ЗафиксироватьТранзакцию();
            Возврат Существующий;
        КонецЕсли;

        РабочееПространство = Справочники.РабочиеПространства.СоздатьЭлемент();
        РабочееПространство.SetNewObjectRef(Справочники.РабочиеПространства.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
        РабочееПространство.Наименование = Имя;
        РабочееПространство.УчетнаяЗаписьВладельца = СсылкаУчетнойЗаписи;
        РабочееПространство.Состояние = "Active";
        РабочееПространство.Профиль = "AD";
        РабочееПространство.ДатаСоздания = ТекущаяУниверсальнаяДата();
        РабочееПространство.Записать();

        Область = Справочники.Области.СоздатьЭлемент();
        Область.SetNewObjectRef(Справочники.Области.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
        Область.Наименование = "Default area";
        Область.РабочееПространство = РабочееПространство.Ссылка;
        Область.Состояние = "Active";
        Область.КемСоздано = СсылкаУчетнойЗаписи;
        Область.ДатаСоздания = ТекущаяУниверсальнаяДата();
        Область.Ревизия = 1;
        Область.Записать();
        ИдентификаторКорреляции = Строка(СервисДокументов.НовыйUUIDv4());
        ПустойОбласть = Справочники.Области.ПустаяСсылка();
        Владелец = СохранитьУчастие(РабочееПространство.Ссылка, СсылкаУчетнойЗаписи, "WorkspaceOwner", "All", ПустойОбласть, 0);
        Житель = СохранитьУчастие(РабочееПространство.Ссылка, СсылкаУчетнойЗаписи, "Resident", "All", ПустойОбласть, 0);
        ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, РабочееПространство.Ссылка, "workspace.create", Строка(РабочееПространство.Ссылка.УникальныйИдентификатор()), "success", ИдентификаторКорреляции);
        ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, РабочееПространство.Ссылка, "area.create", Строка(Область.Ссылка.УникальныйИдентификатор()), "success", ИдентификаторКорреляции);
        ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, РабочееПространство.Ссылка, "membership.create", Строка(Владелец.УникальныйИдентификатор()), "success", ИдентификаторКорреляции);
        ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, РабочееПространство.Ссылка, "membership.create", Строка(Житель.УникальныйИдентификатор()), "success", ИдентификаторКорреляции);
        ПривязатьСозданиеПространства(СсылкаУчетнойЗаписи, РабочееПространство.Ссылка, ИдентификаторЗапроса, ИсходноеТелоКоманды);
        ЗафиксироватьТранзакцию();
        Возврат РабочееПространство.Ссылка;
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецФункции

Процедура ПривязатьСозданиеПространства(УчетнаяЗапись, Пространство, Ключ, Тело)
    Если Ключ = Неопределено Тогда Возврат; КонецЕсли;
    Контекст = Новый Структура("УчетнаяЗапись,РабочееПространство,Область", УчетнаяЗапись, Пространство, Справочники.Области.ПустаяСсылка());
    Команда = ЖизненныйЦиклАбонентов.ОткрытьКомандуСоздания(Контекст, Ключ, "workspaces", Тело);
    Если Команда.Выбран() Тогда
        ЖизненныйЦиклАбонентов.ПрочитатьРезультатСоздания(Команда, Контекст, "workspaces");
    Иначе
        ЖизненныйЦиклАбонентов.СохранитьРезультатСоздания(Команда, Новый Структура("id", Строка(Пространство.УникальныйИдентификатор())));
    КонецЕсли;
КонецПроцедуры

Функция НазначитьЛокальнуюРоль(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, АдресатУчетнаяЗаписьИдентификатор, Роль,
    ОхватОбластей = "All", ОбластьИдентификатор = "", ОжидаемаяРевизия = 0) Экспорт
    Если Не РольРазрешенаКНазначению(Роль) Тогда
        ВызватьИсключение "кабинет_некорректно_роль";
    КонецЕсли;
    Если ТипЗнч(ОхватОбластей) <> Тип("Строка") Или (ОхватОбластей <> "All" И ОхватОбластей <> "Area") Тогда
        ВызватьИсключение "кабинет_некорректно_область_граница";
    КонецЕсли;
    Если ТипЗнч(ОбластьИдентификатор) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_некорректно_область_граница";
    КонецЕсли;
    Если ОхватОбластей = "All" И Не ПустаяСтрока(ОбластьИдентификатор) Тогда
        ВызватьИсключение "кабинет_некорректно_область_граница";
    КонецЕсли;
    ПроверитьНомерРевизии(ОжидаемаяРевизия);
    АдресатСсылка = Справочники.УчетныеЗаписи.ПолучитьСсылку(РазобратьИдентификатор(АдресатУчетнаяЗаписьИдентификатор));
    Если Не ЗначениеЗаполнено(АдресатСсылка) Тогда
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецЕсли;
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьУчетныеЗаписи(СсылкаУчетнойЗаписи, АдресатСсылка);
        ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
        РабочееПространство = ОпределитьРабочееПространство(РабочаяОбластьИдентификатор);
        ЗаблокироватьОбъектПоСсылке("Справочник.РабочиеПространства", РабочееПространство.Ссылка);
        СсылкаРабочейОбласти = ПроверитьДоступКРабочемуПространству(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, "WorkspaceOwner");
        Адресат = АдресатСсылка.ПолучитьОбъект();
        Если Адресат = Неопределено Тогда
            ВызватьИсключение "кабинет_цель_учетная_запись_не_найдено";
        КонецЕсли;
        Если Адресат.ПометкаУдаления Или Адресат.Состояние <> "Active" Тогда
            ВызватьИсключение "кабинет_цель_учетная_запись_отключено";
        КонецЕсли;
        Если АдресатСсылка <> СсылкаУчетнойЗаписи Тогда
            Если Не ЕстьДействующееУчастие(АдресатСсылка, СсылкаРабочейОбласти, "", ТекущаяУниверсальнаяДата()) Тогда
                ВызватьИсключение "кабинет_цель_не_участник";
            КонецЕсли;
        КонецЕсли;

        СсылкаОбласти = Справочники.Области.ПустаяСсылка();
        Если ОхватОбластей = "Area" Тогда
            СсылкаОбласти = Справочники.Области.ПолучитьСсылку(РазобратьИдентификатор(ОбластьИдентификатор));
            Если Не ЗначениеЗаполнено(СсылкаОбласти) Тогда
                ВызватьИсключение "кабинет_некорректно_идентификатор";
            КонецЕсли;
            ЗаблокироватьОбъектПоСсылке("Справочник.Области", СсылкаОбласти);
            Область = СсылкаОбласти.ПолучитьОбъект();
            Если Область = Неопределено Тогда
                ВызватьИсключение "кабинет_область_не_найдено";
            КонецЕсли;
            Если Область.ПометкаУдаления Или Область.Состояние <> "Active" Или Область.РабочееПространство <> СсылкаРабочейОбласти Тогда
                ВызватьИсключение "кабинет_область_не_найдено";
            КонецЕсли;
        КонецЕсли;

        Участие = СохранитьУчастие(СсылкаРабочейОбласти, АдресатСсылка, Роль, ОхватОбластей, СсылкаОбласти, ОжидаемаяРевизия);
        ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, СсылкаРабочейОбласти, "membership.assign", Строка(Участие.УникальныйИдентификатор()));
        ЗафиксироватьТранзакцию();
        Возврат Участие;
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецФункции

Функция ЛимитСтраницыIAM(Значение) Экспорт
    Если Значение = Неопределено Тогда Возврат 25; КонецЕсли;
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда ВызватьИсключение "кабинет_некорректно_лимит"; КонецЕсли;
    Если СтрДлина(Значение) < 1 Или СтрДлина(Значение) > 3 Тогда ВызватьИсключение "кабинет_некорректно_лимит"; КонецЕсли;
    Для Индекс = 1 По СтрДлина(Значение) Цикл
        Если СтрНайти("0123456789", Сред(Значение, Индекс, 1)) = 0 Тогда ВызватьИсключение "кабинет_некорректно_лимит"; КонецЕсли;
    КонецЦикла;
    Лимит = Число(Значение);
    Если Лимит < 1 Или Лимит > 100 Тогда ВызватьИсключение "кабинет_некорректно_лимит"; КонецЕсли;
    Возврат Лимит;
КонецФункции

Функция ПараметрыСтраницыIAM(УчетнаяЗапись, Лимит, Курсор, Вид, Контекст = "") Экспорт
    Если ТипЗнч(Курсор) <> Тип("Строка") Или СтрДлина(Курсор) > 256 Тогда ВызватьИсключение "кабинет_некорректно_курсор"; КонецЕсли;
    Если Лимит = Неопределено Тогда
        Если Курсор <> "" Тогда ВызватьИсключение "кабинет_некорректно_лимит"; КонецЕсли;
        Возврат Неопределено;
    КонецЕсли;
    Если ТипЗнч(Лимит) <> Тип("Число") Тогда ВызватьИсключение "кабинет_некорректно_лимит"; КонецЕсли;
    Если Лимит <> Цел(Лимит) Или Лимит < 1 Или Лимит > 100 Тогда ВызватьИсключение "кабинет_некорректно_лимит"; КонецЕсли;
    Если СтрРазделить("workspaces,memberships,areas,invitations,sessions,myAccountLinks,pendingAccountLinks,personalAccounts", ",").Найти(Вид) = Неопределено Тогда
        ВызватьИсключение "кабинет_некорректно_курсор";
    КонецЕсли;
    Если ТипЗнч(Контекст) <> Тип("Строка") Или СтрДлина(Контекст) > 150 Или СтрНайти(Контекст, "|") > 0 Тогда
        ВызватьИсключение "кабинет_некорректно_курсор";
    КонецЕсли;
    Префикс = "iam1|" + Вид + "|" + Строка(УчетнаяЗапись.УникальныйИдентификатор()) + "|" + Контекст + "|";
    Последний = "00000000-0000-0000-0000-000000000000";
    Если Курсор <> "" Тогда
        Если Лев(Курсор, СтрДлина(Префикс)) <> Префикс Тогда ВызватьИсключение "кабинет_некорректно_курсор"; КонецЕсли;
        Последний = Сред(Курсор, СтрДлина(Префикс) + 1);
        Попытка
            Последний = Строка(РазобратьИдентификатор(Последний));
        Исключение
            ВызватьИсключение "кабинет_некорректно_курсор";
        КонецПопытки;
        Если Курсор <> Префикс + Последний Тогда ВызватьИсключение "кабинет_некорректно_курсор"; КонецЕсли;
    КонецЕсли;
    UUIDПосле = РазобратьИдентификатор(Последний);
    Если Вид = "workspaces" Тогда После = Справочники.РабочиеПространства.ПолучитьСсылку(UUIDПосле);
    ИначеЕсли Вид = "memberships" Тогда После = Справочники.Участия.ПолучитьСсылку(UUIDПосле);
    ИначеЕсли Вид = "areas" Тогда После = Справочники.Области.ПолучитьСсылку(UUIDПосле);
    ИначеЕсли Вид = "invitations" Тогда После = Справочники.ПриглашенияВПространства.ПолучитьСсылку(UUIDПосле);
    ИначеЕсли Вид = "sessions" Тогда После = ?(Курсор = "", "", Последний);
    ИначеЕсли Вид = "personalAccounts" Тогда После = Справочники.ЛицевыеСчета.ПолучитьСсылку(UUIDПосле);
    Иначе После = Справочники.ЗаявкиДоступаКСчетам.ПолучитьСсылку(UUIDПосле);
    КонецЕсли;
    Возврат Новый Структура("limit,prefix,after", Лимит, Префикс, После);
КонецФункции

Процедура НастроитьЗапросСтраницыIAM(Запрос, Страница, СтароеНачало, ПолеПозиции) Экспорт
    Если Страница = Неопределено Тогда Возврат; КонецЕсли;
    Если Лев(Запрос.Текст, СтрДлина(СтароеНачало)) <> СтароеНачало Тогда ВызватьИсключение "кабинет_страницы_запрос_некорректно"; КонецЕсли;
    ПозицияПорядка = СтрНайти(Запрос.Текст, "УПОРЯДОЧИТЬ ПО");
    Если ПозицияПорядка = 0 Тогда ВызватьИсключение "кабинет_страницы_запрос_некорректно"; КонецЕсли;
    Начало = ?(СтрНайти(СтароеНачало, "РАЗЛИЧНЫЕ") > 0, "ВЫБРАТЬ РАЗЛИЧНЫЕ", "ВЫБРАТЬ");
    Остаток = Сред(Лев(Запрос.Текст, ПозицияПорядка - 1), СтрДлина(СтароеНачало) + 1);
    Запрос.Текст = Начало + " ПЕРВЫЕ " + Формат(Страница.limit + 1, "ЧГ=0") + Остаток
        + " И " + ПолеПозиции + " > &ПозицияСтраницы УПОРЯДОЧИТЬ ПО " + ПолеПозиции;
    Запрос.УстановитьПараметр("ПозицияСтраницы", Страница.after);
КонецПроцедуры

Функция РезультатСтраницыIAM(Элементы, Страница) Экспорт
    Если Страница = Неопределено Тогда Возврат Элементы; КонецЕсли;
    Если Элементы.Количество() > Страница.limit + 1 Тогда ВызватьИсключение "кабинет_страницы_запрос_некорректно"; КонецЕсли;
    Еще = Элементы.Количество() > Страница.limit;
    Если Еще Тогда Элементы.Удалить(Элементы.Количество() - 1); КонецЕсли;
    Следующий = "";
    Если Еще Тогда Следующий = Страница.prefix + Элементы[Элементы.Количество() - 1].id; КонецЕсли;
    Возврат Новый Структура("items,limit,hasMore,nextCursor", Элементы, Страница.limit, Еще, Следующий);
КонецФункции

Функция ПолучитьСписокРабочихПространств(СсылкаУчетнойЗаписи, Лимит = Неопределено, Курсор = "") Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    Запрос = Новый Запрос(
        "ВЫБРАТЬ РАЗЛИЧНЫЕ РабочаяОбластьСтрокаВыборки.Ссылка КАК Ссылка, РабочаяОбластьСтрокаВыборки.Наименование КАК Имя,
        |РабочаяОбластьСтрокаВыборки.УчетнаяЗаписьВладельца КАК УчетнаяЗаписьВладельца, РабочаяОбластьСтрокаВыборки.Состояние КАК Состояние,
        |РабочаяОбластьСтрокаВыборки.Профиль КАК Профиль, РабочаяОбластьСтрокаВыборки.ДатаСоздания КАК ДатаСоздания
        |ИЗ Справочник.Участия КАК ЧленствоСтрокаВыборки
        |ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РабочиеПространства КАК РабочаяОбластьСтрокаВыборки ПО ЧленствоСтрокаВыборки.РабочееПространство = РабочаяОбластьСтрокаВыборки.Ссылка
        |ГДЕ ЧленствоСтрокаВыборки.УчетнаяЗапись = &УчетнаяЗапись И ЧленствоСтрокаВыборки.Состояние = &Действующий
        |И НЕ ЧленствоСтрокаВыборки.ПометкаУдаления И НЕ РабочаяОбластьСтрокаВыборки.ПометкаУдаления
        |И РабочаяОбластьСтрокаВыборки.Состояние = &Действующий
        |И (ЧленствоСтрокаВыборки.СрокИстечения = &НетИстечениеСрока ИЛИ ЧленствоСтрокаВыборки.СрокИстечения > &ТекущееВремя)
        |И ((ЧленствоСтрокаВыборки.ОхватОбластей = &ВсеКонтекстДоступа И ЧленствоСтрокаВыборки.Область = &ПустойОбласть)
        |ИЛИ (ЧленствоСтрокаВыборки.ОхватОбластей = &ОхватОбластей И НЕ ЧленствоСтрокаВыборки.Область.ПометкаУдаления
        |И ЧленствоСтрокаВыборки.Область.Состояние = &Действующий И ЧленствоСтрокаВыборки.Область.РабочееПространство = РабочаяОбластьСтрокаВыборки.Ссылка))
        |УПОРЯДОЧИТЬ ПО РабочаяОбластьСтрокаВыборки.ДатаСоздания, РабочаяОбластьСтрокаВыборки.Ссылка");
    Страница = ПараметрыСтраницыIAM(СсылкаУчетнойЗаписи, Лимит, Курсор, "workspaces");
    НастроитьЗапросСтраницыIAM(Запрос, Страница, "ВЫБРАТЬ РАЗЛИЧНЫЕ", "РабочаяОбластьСтрокаВыборки.Ссылка");
    УстановитьПараметрыУчастия(Запрос, СсылкаУчетнойЗаписи, ТекущаяУниверсальнаяДата());
    ВыборкаДанных = Запрос.Выполнить().Выбрать();
    Результат = Новый Массив;
    Пока ВыборкаДанных.Следующий() Цикл
        Объект = Новый Структура;
        Объект.Вставить("id", Строка(ВыборкаДанных.Ссылка.УникальныйИдентификатор()));
        Объект.Вставить("name", ВыборкаДанных.Имя);
        Объект.Вставить("ownerAccountId", Строка(ВыборкаДанных.УчетнаяЗаписьВладельца.УникальныйИдентификатор()));
        Объект.Вставить("state", ВыборкаДанных.Состояние);
        Объект.Вставить("profile", ВыборкаДанных.Профиль);
        Объект.Вставить("createdAt", XMLСтрока(ВыборкаДанных.ДатаСоздания) + "Z");
        Результат.Добавить(Объект);
    КонецЦикла;
    Возврат РезультатСтраницыIAM(Результат, Страница);
КонецФункции

Функция ПолучитьСписокУчастий(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, Лимит = Неопределено, Курсор = "", ТолькоСвои = Ложь) Экспорт
    СсылкаРабочейОбласти = ПроверитьДоступКРабочемуПространству(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор);
    Если ТипЗнч(ТолькоСвои) <> Тип("Булево") Тогда ВызватьИсключение "кабинет_некорректно_фильтр"; КонецЕсли;
    РабочееПространство = СсылкаРабочейОбласти.ПолучитьОбъект();
    Владелец = РабочееПространство.УчетнаяЗаписьВладельца = СсылкаУчетнойЗаписи
        И ЕстьДействующееУчастие(СсылкаУчетнойЗаписи, СсылкаРабочейОбласти, "WorkspaceOwner", ТекущаяУниверсальнаяДата());
    Запрос = Новый Запрос(
        "ВЫБРАТЬ Ссылка, УчетнаяЗапись, Роль, ОхватОбластей, Область, Состояние, СрокИстечения, Ревизия
        |ИЗ Справочник.Участия
        |ГДЕ РабочееПространство = &РабочееПространство И НЕ ПометкаУдаления
        |И (&ЭтоВладелец ИЛИ (УчетнаяЗапись = &УчетнаяЗапись И Состояние = &Действующий
        |И (СрокИстечения = &НетИстечениеСрока ИЛИ СрокИстечения > &ТекущееВремя)
        |И ((ОхватОбластей = &ВсеКонтекстДоступа И Область = &ПустойОбласть)
        |ИЛИ (ОхватОбластей = &ОхватОбластей И НЕ Область.ПометкаУдаления
        |И Область.Состояние = &Действующий И Область.РабочееПространство = &РабочееПространство))))
        |УПОРЯДОЧИТЬ ПО УчетнаяЗапись, Роль, Область, Ссылка");
    Страница = ПараметрыСтраницыIAM(СсылкаУчетнойЗаписи, Лимит, Курсор, "memberships",
        Строка(СсылкаРабочейОбласти.УникальныйИдентификатор()) + "/" + ?(Владелец И Не ТолькоСвои, "owner", "self") + "/" + ?(ТолькоСвои, "own", "visible"));
    НастроитьЗапросСтраницыIAM(Запрос, Страница, "ВЫБРАТЬ", "Ссылка");
    УстановитьПараметрыУчастия(Запрос, СсылкаУчетнойЗаписи, ТекущаяУниверсальнаяДата());
    Запрос.УстановитьПараметр("РабочееПространство", СсылкаРабочейОбласти);
    Запрос.УстановитьПараметр("ЭтоВладелец", Владелец И Не ТолькоСвои);
    ВыборкаДанных = Запрос.Выполнить().Выбрать();
    Результат = Новый Массив;
    Пока ВыборкаДанных.Следующий() Цикл
        Объект = Новый Структура;
        Объект.Вставить("id", Строка(ВыборкаДанных.Ссылка.УникальныйИдентификатор()));
        Объект.Вставить("workspaceId", Строка(СсылкаРабочейОбласти.УникальныйИдентификатор()));
        Объект.Вставить("accountId", Строка(ВыборкаДанных.УчетнаяЗапись.УникальныйИдентификатор()));
        Объект.Вставить("role", ВыборкаДанных.Роль);
        Объект.Вставить("areaScope", ВыборкаДанных.ОхватОбластей);
        ОбластьИдентификатор = "";
        Если ЗначениеЗаполнено(ВыборкаДанных.Область) Тогда
            ОбластьИдентификатор = Строка(ВыборкаДанных.Область.УникальныйИдентификатор());
        КонецЕсли;
        Объект.Вставить("areaId", ОбластьИдентификатор);
        Объект.Вставить("state", ВыборкаДанных.Состояние);
        Объект.Вставить("expiresAt", XMLСтрока(ВыборкаДанных.СрокИстечения) + "Z");
        Объект.Вставить("revision", ВыборкаДанных.Ревизия);
        Результат.Добавить(Объект);
    КонецЦикла;
    Возврат РезультатСтраницыIAM(Результат, Страница);
КонецФункции

Функция ПолучитьКонтекстПолномочий(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ИдентификаторыОбластей = Неопределено) Экспорт
    СсылкаРабочейОбласти = ПроверитьДоступКРабочемуПространству(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор);
    РабочееПространство = СсылкаРабочейОбласти.ПолучитьОбъект();
    Если ИдентификаторыОбластей = Неопределено Тогда ИдентификаторыОбластей = Новый Массив; КонецЕсли;
    Если ТипЗнч(ИдентификаторыОбластей) <> Тип("Массив") Тогда ВызватьИсключение "кабинет_некорректно_фильтр"; КонецЕсли;
    Если ИдентификаторыОбластей.Количество() > 100 Тогда ВызватьИсключение "кабинет_некорректно_фильтр"; КонецЕсли;
    Области = Новый Массив;
    Для Каждого Идентификатор Из ИдентификаторыОбластей Цикл
        СсылкаОбласти = Справочники.Области.ПолучитьСсылку(РазобратьИдентификатор(Идентификатор));
        Если Не ЗначениеЗаполнено(СсылкаОбласти) Или Области.Найти(СсылкаОбласти) <> Неопределено Тогда
            ВызватьИсключение "кабинет_некорректно_фильтр";
        КонецЕсли;
        Области.Добавить(СсылкаОбласти);
    КонецЦикла;

    Момент = ТекущаяУниверсальнаяДата();
    ПроверитьОбластиПодсказкиПолномочий(СсылкаУчетнойЗаписи, СсылкаРабочейОбласти, Области, Момент);
    РолиПодсказки = СтрРазделить("WorkspaceOwner,Dispatcher,LabTechnician,LabApprover,WaterOperator,Storekeeper,BillingSpecialist,ConnectionEngineer,SupportOperator,CrewLeader,CrewMember,Resident", ",");
    ЭтоВладелец = РабочееПространство.УчетнаяЗаписьВладельца = СсылкаУчетнойЗаписи;
    Граница = Неопределено;
    ВсеРоли = Новый Массив;
    РолиПространства = Новый Массив;
    ДанныеОбластей = Новый Массив;
    ПоОбластям = Новый Соответствие;
    Для Каждого СсылкаОбласти Из Области Цикл
        Подсказка = Новый Структура("id,roles", Строка(СсылкаОбласти.УникальныйИдентификатор()), Новый Массив);
        ДанныеОбластей.Добавить(Подсказка);
        ПоОбластям.Вставить(СсылкаОбласти, Подсказка);
    КонецЦикла;

    Запрос = Новый Запрос(
        "ВЫБРАТЬ Роль, МИНИМУМ(ВЫБОР КОГДА СрокИстечения = &НетИстечениеСрока
        |ТОГДА NULL ИНАЧЕ СрокИстечения КОНЕЦ) КАК Граница
        |ИЗ Справочник.Участия
        |ГДЕ РабочееПространство = &РабочееПространство И УчетнаяЗапись = &УчетнаяЗапись
        |И Состояние = &Действующий И НЕ ПометкаУдаления И Роль В (&Роли)
        |И (СрокИстечения = &НетИстечениеСрока ИЛИ СрокИстечения > &ТекущееВремя)
        |И ((ОхватОбластей = &ВсеКонтекстДоступа И Область = &ПустойОбласть)
        |ИЛИ (ОхватОбластей = &ОхватОбластей И НЕ Область.ПометкаУдаления
        |И Область.Состояние = &Действующий И Область.РабочееПространство = &РабочееПространство))
        |И (Роль <> &ВладелецРоль ИЛИ (&ЭтоВладелец И ОхватОбластей = &ВсеКонтекстДоступа И Область = &ПустойОбласть))
        |СГРУППИРОВАТЬ ПО Роль УПОРЯДОЧИТЬ ПО Роль");
    УстановитьПараметрыПодсказкиПолномочий(Запрос, СсылкаУчетнойЗаписи, СсылкаРабочейОбласти, Момент, РолиПодсказки, ЭтоВладелец);
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        ВсеРоли.Добавить(Выборка.Роль);
        Если ТипЗнч(Выборка.Граница) = Тип("Дата") Тогда
            Если Граница = Неопределено Или Выборка.Граница < Граница Тогда Граница = Выборка.Граница; КонецЕсли;
        КонецЕсли;
    КонецЦикла;

    ОбластиЗапроса = Новый Массив;
    Для Каждого СсылкаОбласти Из Области Цикл ОбластиЗапроса.Добавить(СсылкаОбласти); КонецЦикла;
    Если ОбластиЗапроса.Количество() = 0 Тогда ОбластиЗапроса.Добавить(Справочники.Области.ПустаяСсылка()); КонецЕсли;
    Запрос = Новый Запрос(
        "ВЫБРАТЬ РАЗЛИЧНЫЕ Роль, ОхватОбластей, Область
        |ИЗ Справочник.Участия
        |ГДЕ РабочееПространство = &РабочееПространство И УчетнаяЗапись = &УчетнаяЗапись
        |И Состояние = &Действующий И НЕ ПометкаУдаления И Роль В (&Роли)
        |И (СрокИстечения = &НетИстечениеСрока ИЛИ СрокИстечения > &ТекущееВремя)
        |И ((ОхватОбластей = &ВсеКонтекстДоступа И Область = &ПустойОбласть)
        |ИЛИ (ОхватОбластей = &ОхватОбластей И Область В (&Области)
        |И НЕ Область.ПометкаУдаления И Область.Состояние = &Действующий
        |И Область.РабочееПространство = &РабочееПространство))
        |И (Роль <> &ВладелецРоль ИЛИ (&ЭтоВладелец И ОхватОбластей = &ВсеКонтекстДоступа И Область = &ПустойОбласть))
        |УПОРЯДОЧИТЬ ПО Роль, ОхватОбластей, Область");
    УстановитьПараметрыПодсказкиПолномочий(Запрос, СсылкаУчетнойЗаписи, СсылкаРабочейОбласти, Момент, РолиПодсказки, ЭтоВладелец);
    Запрос.УстановитьПараметр("Области", ОбластиЗапроса);
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Если Выборка.ОхватОбластей = "All" Тогда
            Если РолиПространства.Найти(Выборка.Роль) = Неопределено Тогда РолиПространства.Добавить(Выборка.Роль); КонецЕсли;
            Для Каждого Подсказка Из ДанныеОбластей Цикл
                Если Подсказка.roles.Найти(Выборка.Роль) = Неопределено Тогда Подсказка.roles.Добавить(Выборка.Роль); КонецЕсли;
            КонецЦикла;
        Иначе
            Подсказка = ПоОбластям.Получить(Выборка.Область);
            Если Подсказка <> Неопределено И Подсказка.roles.Найти(Выборка.Роль) = Неопределено Тогда Подсказка.roles.Добавить(Выборка.Роль); КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    ДанныеПространства = Новый Структура("id,name,state,ownerAccountId,profile,createdAt",
        Строка(СсылкаРабочейОбласти.УникальныйИдентификатор()), РабочееПространство.Наименование, РабочееПространство.Состояние,
        Строка(РабочееПространство.УчетнаяЗаписьВладельца.УникальныйИдентификатор()), РабочееПространство.Профиль, XMLСтрока(РабочееПространство.ДатаСоздания) + "Z");
    Возврат Новый Структура("accountId,workspaceId,owner,roles,workspaceRoles,areas,capturedAt,expiresAt,workspace",
        Строка(СсылкаУчетнойЗаписи.УникальныйИдентификатор()), Строка(СсылкаРабочейОбласти.УникальныйИдентификатор()),
        ЭтоВладелец И РолиПространства.Найти("WorkspaceOwner") <> Неопределено,
        ВсеРоли, РолиПространства, ДанныеОбластей, XMLСтрока(Момент) + "Z", ?(Граница = Неопределено, "", XMLСтрока(Граница) + "Z"), ДанныеПространства);
КонецФункции

Процедура УстановитьПараметрыПодсказкиПолномочий(Запрос, УчетнаяЗапись, РабочееПространство, Момент, Роли, ЭтоВладелец)
    УстановитьПараметрыУчастия(Запрос, УчетнаяЗапись, Момент);
    Запрос.УстановитьПараметр("РабочееПространство", РабочееПространство);
    Запрос.УстановитьПараметр("Роли", Роли);
    Запрос.УстановитьПараметр("ЭтоВладелец", ЭтоВладелец);
    Запрос.УстановитьПараметр("ВладелецРоль", "WorkspaceOwner");
КонецПроцедуры

Процедура ПроверитьОбластиПодсказкиПолномочий(УчетнаяЗапись, РабочееПространство, Области, Момент)
    Если Области.Количество() = 0 Тогда Возврат; КонецЕсли;
    Запрос = Новый Запрос(
        "ВЫБРАТЬ РАЗЛИЧНЫЕ Области.Ссылка КАК Ссылка
        |ИЗ Справочник.Области КАК Области
        |ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Участия КАК Участия ПО Участия.РабочееПространство = Области.РабочееПространство
        |ГДЕ Области.Ссылка В (&Области) И Области.РабочееПространство = &РабочееПространство
        |И Области.Состояние = &Действующий И НЕ Области.ПометкаУдаления
        |И Участия.УчетнаяЗапись = &УчетнаяЗапись И Участия.Состояние = &Действующий И НЕ Участия.ПометкаУдаления
        |И (Участия.СрокИстечения = &НетИстечениеСрока ИЛИ Участия.СрокИстечения > &ТекущееВремя)
        |И ((Участия.ОхватОбластей = &ВсеКонтекстДоступа И Участия.Область = &ПустойОбласть)
        |ИЛИ (Участия.ОхватОбластей = &ОхватОбластей И Участия.Область = Области.Ссылка))");
    УстановитьПараметрыУчастия(Запрос, УчетнаяЗапись, Момент);
    Запрос.УстановитьПараметр("РабочееПространство", РабочееПространство);
    Запрос.УстановитьПараметр("Области", Области);
    Если Запрос.Выполнить().Выгрузить().Количество() <> Области.Количество() Тогда ВызватьИсключение "кабинет_область_запрещено"; КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьСобытиеАудита(УчетнаяЗаписьДействующегоЛица, РабочееПространство, Действие, ИдентификаторОбъекта, Результат = "success", ИдентификаторКорреляции = "") Экспорт
    Если ТипЗнч(Действие) <> Тип("Строка") Или ТипЗнч(ИдентификаторОбъекта) <> Тип("Строка")
        Или ТипЗнч(Результат) <> Тип("Строка") Или ТипЗнч(ИдентификаторКорреляции) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_некорректно_аудит_событие";
    КонецЕсли;
    Если ПустаяСтрока(Действие) Или СтрДлина(Действие) > 64 Или СтрДлина(ИдентификаторОбъекта) > 64
        Или ПустаяСтрока(Результат) Или СтрДлина(Результат) > 32 Тогда
        ВызватьИсключение "кабинет_некорректно_аудит_событие";
    КонецЕсли;
    ДействующееЛицо = УчетнаяЗаписьДействующегоЛица;
    СобытиеРабочаяОбласть = РабочееПространство;
    ТрассировкаИдентификатор = ИдентификаторКорреляции;
    Если ЗначениеЗаполнено(ДействующееЛицо) Тогда
        Текущий = НайтиУчетнуюЗапись();
        Если Текущий = Неопределено Или Текущий <> ДействующееЛицо Тогда
            ВызватьИсключение "кабинет_участник_несовпадение";
        КонецЕсли;
    Иначе
        ДействующееЛицо = Справочники.УчетныеЗаписи.ПустаяСсылка();
    КонецЕсли;
    Если Не ЗначениеЗаполнено(СобытиеРабочаяОбласть) Тогда
        СобытиеРабочаяОбласть = Справочники.РабочиеПространства.ПустаяСсылка();
    КонецЕсли;
    Если ПустаяСтрока(ТрассировкаИдентификатор) Тогда
        ТрассировкаИдентификатор = Строка(СервисДокументов.НовыйUUIDv4());
    Иначе
        ТрассировкаИдентификатор = Строка(РазобратьИдентификатор(ТрассировкаИдентификатор));
    КонецЕсли;
    Событие = Справочники.СобытияАудита.СоздатьЭлемент();
    Событие.SetNewObjectRef(Справочники.СобытияАудита.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
    Событие.Наименование = Действие;
    Событие.ДействующееЛицо = ДействующееЛицо;
    Событие.РабочееПространство = СобытиеРабочаяОбласть;
    Событие.Действие = Действие;
    Событие.ИдентификаторОбъекта = ИдентификаторОбъекта;
    Событие.Результат = Результат;
    Событие.ИдентификаторКорреляции = ТрассировкаИдентификатор;
    Событие.ФактическаяДата = ТекущаяУниверсальнаяДата();
    Событие.Записать();
КонецПроцедуры

Функция ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи)
    УчетнаяЗапись = ПроверитьУчетнуюЗапись();
    Если ТипЗнч(СсылкаУчетнойЗаписи) <> Тип("СправочникСсылка.УчетныеЗаписи") Тогда
        ВызватьИсключение "кабинет_участник_несовпадение";
    КонецЕсли;
    Если УчетнаяЗапись.Ссылка <> СсылкаУчетнойЗаписи Тогда
        ВызватьИсключение "кабинет_участник_несовпадение";
    КонецЕсли;
    Возврат УчетнаяЗапись;
КонецФункции

Функция РазобратьИдентификатор(Идентификатор)
    Если ТипЗнч(Идентификатор) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецЕсли;
    Если СтрДлина(Идентификатор) <> 36 Тогда
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецЕсли;
    Попытка
        Возврат Новый УникальныйИдентификатор(Идентификатор);
    Исключение
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецПопытки;
КонецФункции

Функция ОпределитьРабочееПространство(Идентификатор)
    Ссылка = Справочники.РабочиеПространства.ПолучитьСсылку(РазобратьИдентификатор(Идентификатор));
    Если Не ЗначениеЗаполнено(Ссылка) Тогда
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецЕсли;
    РабочееПространство = Ссылка.ПолучитьОбъект();
    Если РабочееПространство = Неопределено Тогда
        ВызватьИсключение "кабинет_пространство_не_найдено";
    КонецЕсли;
    Возврат РабочееПространство;
КонецФункции

Функция РольРазрешенаКНазначению(Роль)
    Если ТипЗнч(Роль) <> Тип("Строка") Тогда
        Возврат Ложь;
    КонецЕсли;
    Роли = Новый Массив;
    Роли.Добавить("Dispatcher");
    Роли.Добавить("LabTechnician");
    Роли.Добавить("LabApprover");
    Роли.Добавить("WaterOperator");
    Роли.Добавить("Storekeeper");
    Роли.Добавить("BillingSpecialist");
    Роли.Добавить("ConnectionEngineer");
    Роли.Добавить("SupportOperator");
    Роли.Добавить("CrewLeader");
    Роли.Добавить("CrewMember");
    Роли.Добавить("Resident");
    Возврат Роли.Найти(Роль) <> Неопределено;
КонецФункции

Процедура ПроверитьНомерРевизии(Ревизия)
    Если ТипЗнч(Ревизия) <> Тип("Число") Тогда
        ВызватьИсключение "кабинет_некорректно_редакция";
    КонецЕсли;
    Если Ревизия < 0 Или Ревизия >= 999999999999999 Или Окр(Ревизия, 0) <> Ревизия Тогда
        ВызватьИсключение "кабинет_некорректно_редакция";
    КонецЕсли;
КонецПроцедуры

Процедура УстановитьПараметрыУчастия(Запрос, СсылкаУчетнойЗаписи, ТекущееВремя)
    Запрос.УстановитьПараметр("УчетнаяЗапись", СсылкаУчетнойЗаписи);
    Запрос.УстановитьПараметр("ТекущееВремя", ТекущееВремя);
    Запрос.УстановитьПараметр("Действующий", "Active");
    Запрос.УстановитьПараметр("НетИстечениеСрока", Дата(1, 1, 1));
    Запрос.УстановитьПараметр("ВсеКонтекстДоступа", "All");
    Запрос.УстановитьПараметр("ОхватОбластей", "Area");
    Запрос.УстановитьПараметр("ПустойОбласть", Справочники.Области.ПустаяСсылка());
КонецПроцедуры

Функция ЕстьДействующееУчастие(СсылкаУчетнойЗаписи, СсылкаРабочейОбласти, ТребуемыйРоль, ТекущееВремя, ТребуемыйОбласть = Неопределено)
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Участия
        |ГДЕ РабочееПространство = &РабочееПространство И УчетнаяЗапись = &УчетнаяЗапись
        |И Состояние = &Действующий И НЕ ПометкаУдаления
        |И (СрокИстечения = &НетИстечениеСрока ИЛИ СрокИстечения > &ТекущееВремя)
        |И (&ЛюбойРоль ИЛИ Роль = &Роль)
        |И (&ЛюбойОбласть ИЛИ ОхватОбластей = &ВсеКонтекстДоступа ИЛИ Область = &ТребуемыйОбласть)
        |И ((ОхватОбластей = &ВсеКонтекстДоступа И Область = &ПустойОбласть)
        |ИЛИ (ОхватОбластей = &ОхватОбластей И НЕ Область.ПометкаУдаления
        |И Область.Состояние = &Действующий И Область.РабочееПространство = &РабочееПространство))
        |И (&НеВладелецРоль ИЛИ (ОхватОбластей = &ВсеКонтекстДоступа И Область = &ПустойОбласть))");
    УстановитьПараметрыУчастия(Запрос, СсылкаУчетнойЗаписи, ТекущееВремя);
    Запрос.УстановитьПараметр("РабочееПространство", СсылкаРабочейОбласти);
    Запрос.УстановитьПараметр("ЛюбойРоль", ПустаяСтрока(ТребуемыйРоль));
    Запрос.УстановитьПараметр("Роль", ТребуемыйРоль);
    Запрос.УстановитьПараметр("НеВладелецРоль", ТребуемыйРоль <> "WorkspaceOwner");
    Запрос.УстановитьПараметр("ЛюбойОбласть", ТребуемыйОбласть = Неопределено);
    Запрос.УстановитьПараметр("ТребуемыйОбласть", ?(ТребуемыйОбласть = Неопределено, Справочники.Области.ПустаяСсылка(), ТребуемыйОбласть));
    Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

Функция ПроверитьДоступКОбласти(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, ТребуемыйРоль = "") Экспорт
    СсылкаРабочейОбласти = ПроверитьДоступКРабочемуПространству(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ТребуемыйРоль);
    СсылкаОбласти = Справочники.Области.ПолучитьСсылку(РазобратьИдентификатор(ОбластьИдентификатор));
    Область = СсылкаОбласти.ПолучитьОбъект();
    Если Область = Неопределено Тогда
        ВызватьИсключение "кабинет_область_не_найдено";
    КонецЕсли;
    Если Область.ПометкаУдаления Или Область.Состояние <> "Active" Или Область.РабочееПространство <> СсылкаРабочейОбласти Тогда
        ВызватьИсключение "кабинет_область_не_найдено";
    КонецЕсли;
    Если Не ЕстьДействующееУчастие(СсылкаУчетнойЗаписи, СсылкаРабочейОбласти, ТребуемыйРоль, ТекущаяУниверсальнаяДата(), СсылкаОбласти) Тогда
        ВызватьИсключение "кабинет_область_запрещено";
    КонецЕсли;
    Возврат СсылкаОбласти;
КонецФункции

Функция ПолучитьСписокОбластей(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, Лимит = Неопределено, Курсор = "") Экспорт
    СсылкаРабочейОбласти = ПроверитьДоступКРабочемуПространству(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор);
    Запрос = Новый Запрос(
        "ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 100 ОбластьСтрокаВыборки.Ссылка КАК Ссылка, ОбластьСтрокаВыборки.Наименование КАК Имя,
        |ОбластьСтрокаВыборки.Состояние КАК Состояние, ОбластьСтрокаВыборки.Ревизия КАК Ревизия, ОбластьСтрокаВыборки.ДатаСоздания КАК ДатаСоздания
        |ИЗ Справочник.Области КАК ОбластьСтрокаВыборки
        |ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Участия КАК ЧленствоСтрокаВыборки ПО ЧленствоСтрокаВыборки.РабочееПространство = ОбластьСтрокаВыборки.РабочееПространство
        |ГДЕ ОбластьСтрокаВыборки.РабочееПространство = &РабочееПространство И ОбластьСтрокаВыборки.Состояние = &Действующий И НЕ ОбластьСтрокаВыборки.ПометкаУдаления
        |И ЧленствоСтрокаВыборки.УчетнаяЗапись = &УчетнаяЗапись И ЧленствоСтрокаВыборки.Состояние = &Действующий И НЕ ЧленствоСтрокаВыборки.ПометкаУдаления
        |И (ЧленствоСтрокаВыборки.СрокИстечения = &НетИстечениеСрока ИЛИ ЧленствоСтрокаВыборки.СрокИстечения > &ТекущееВремя)
        |И ((ЧленствоСтрокаВыборки.ОхватОбластей = &ВсеКонтекстДоступа И ЧленствоСтрокаВыборки.Область = &ПустойОбласть)
        |ИЛИ (ЧленствоСтрокаВыборки.ОхватОбластей = &ОхватОбластей И ЧленствоСтрокаВыборки.Область = ОбластьСтрокаВыборки.Ссылка))
        |УПОРЯДОЧИТЬ ПО ОбластьСтрокаВыборки.Наименование, ОбластьСтрокаВыборки.Ссылка");
    Страница = ПараметрыСтраницыIAM(СсылкаУчетнойЗаписи, Лимит, Курсор, "areas", Строка(СсылкаРабочейОбласти.УникальныйИдентификатор()));
    НастроитьЗапросСтраницыIAM(Запрос, Страница, "ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 100", "ОбластьСтрокаВыборки.Ссылка");
    УстановитьПараметрыУчастия(Запрос, СсылкаУчетнойЗаписи, ТекущаяУниверсальнаяДата());
    Запрос.УстановитьПараметр("РабочееПространство", СсылкаРабочейОбласти);
    ВыборкаДанных = Запрос.Выполнить().Выбрать();
    Результат = Новый Массив;
    Пока ВыборкаДанных.Следующий() Цикл
        Результат.Добавить(Новый Структура("id,workspaceId,name,state,revision,createdAt",
            Строка(ВыборкаДанных.Ссылка.УникальныйИдентификатор()), Строка(СсылкаРабочейОбласти.УникальныйИдентификатор()), ВыборкаДанных.Имя,
            ВыборкаДанных.Состояние, ВыборкаДанных.Ревизия, XMLСтрока(ВыборкаДанных.ДатаСоздания) + "Z"));
    КонецЦикла;
    Возврат РезультатСтраницыIAM(Результат, Страница);
КонецФункции

Функция ПолучитьОбласть(СсылкаУчетнойЗаписи, ОбластьИдентификатор) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    СсылкаОбласти = Справочники.Области.ПолучитьСсылку(РазобратьИдентификатор(ОбластьИдентификатор));
    Область = СсылкаОбласти.ПолучитьОбъект();
    Если Область = Неопределено Тогда
        ВызватьИсключение "кабинет_область_не_найдено";
    КонецЕсли;
    ПроверитьДоступКОбласти(СсылкаУчетнойЗаписи, Строка(Область.РабочееПространство.УникальныйИдентификатор()), ОбластьИдентификатор);
    Возврат Новый Структура("id,workspaceId,name,state,revision,createdAt", Строка(Область.Ссылка.УникальныйИдентификатор()),
        Строка(Область.РабочееПространство.УникальныйИдентификатор()), Область.Наименование, Область.Состояние, Область.Ревизия, XMLСтрока(Область.ДатаСоздания) + "Z");
КонецФункции

Функция СоздатьОбласть(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, Имя, ИдентификаторЗапроса) Экспорт
    Если ТипЗнч(Имя) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_некорректно_область_имя";
    КонецЕсли;
    Имя = СокрЛП(Имя);
    Если ПустаяСтрока(Имя) Или СтрДлина(Имя) > 150 Тогда
        ВызватьИсключение "кабинет_некорректно_область_имя";
    КонецЕсли;
    ИдентификаторЗапроса = Строка(РазобратьИдентификатор(ИдентификаторЗапроса));
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьУчетныеЗаписи(СсылкаУчетнойЗаписи);
        ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
        РабочееПространство = ОпределитьРабочееПространство(РабочаяОбластьИдентификатор);
        ЗаблокироватьОбъектПоСсылке("Справочник.РабочиеПространства", РабочееПространство.Ссылка);
        СсылкаРабочейОбласти = ПроверитьДоступКРабочемуПространству(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, "WorkspaceOwner");
        Запрос = Новый Запрос(
            "ВЫБРАТЬ ПЕРВЫЕ 2 Ссылка, Наименование, Состояние, ПометкаУдаления ИЗ Справочник.Области
            |ГДЕ РабочееПространство = &РабочееПространство И КемСоздано = &УчетнаяЗапись И ИдентификаторЗапроса = &ИдентификаторЗапроса");
        Запрос.УстановитьПараметр("РабочееПространство", СсылкаРабочейОбласти);
        Запрос.УстановитьПараметр("УчетнаяЗапись", СсылкаУчетнойЗаписи);
        Запрос.УстановитьПараметр("ИдентификаторЗапроса", ИдентификаторЗапроса);
        ВыборкаДанных = Запрос.Выполнить().Выбрать();
        Если ВыборкаДанных.Следующий() Тогда
            Существующий = ВыборкаДанных.Ссылка;
            Если ВыборкаДанных.Наименование <> Имя Или ВыборкаДанных.ПометкаУдаления Или ВыборкаДанных.Состояние <> "Active" Тогда
                ВызватьИсключение "кабинет_область_запрос_конфликт";
            КонецЕсли;
            Если ВыборкаДанных.Следующий() Тогда
                ВызватьИсключение "кабинет_область_запрос_конфликт";
            КонецЕсли;
            ЗафиксироватьТранзакцию();
            Возврат Существующий;
        КонецЕсли;
        Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Итого ИЗ Справочник.Области ГДЕ РабочееПространство = &РабочееПространство");
        Запрос.УстановитьПараметр("РабочееПространство", СсылкаРабочейОбласти);
        ВыборкаДанных = Запрос.Выполнить().Выбрать();
        ВыборкаДанных.Следующий();
        Если ВыборкаДанных.Итого >= 100 Тогда
            ВызватьИсключение "кабинет_область_квота_превышено";
        КонецЕсли;
        Область = Справочники.Области.СоздатьЭлемент();
        Область.SetNewObjectRef(Справочники.Области.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
        Область.Наименование = Имя;
        Область.РабочееПространство = СсылкаРабочейОбласти;
        Область.Состояние = "Active";
        Область.КемСоздано = СсылкаУчетнойЗаписи;
        Область.ДатаСоздания = ТекущаяУниверсальнаяДата();
        Область.ИдентификаторЗапроса = ИдентификаторЗапроса;
        Область.Ревизия = 1;
        Область.Записать();
        ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, СсылкаРабочейОбласти, "area.create", Строка(Область.Ссылка.УникальныйИдентификатор()));
        ЗафиксироватьТранзакцию();
        Возврат Область.Ссылка;
    Исключение
        Если ТранзакцияАктивна() Тогда
            ОтменитьТранзакцию();
        КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
КонецФункции

Процедура ЗаблокироватьОбъектПоСсылке(ПространствоИмен, Ссылка)
    Блокировка = Новый БлокировкаДанных;
    Объект = Блокировка.Добавить(ПространствоИмен);
    Объект.УстановитьЗначение("Ссылка", Ссылка);
    Объект.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
КонецПроцедуры

Процедура ЗаблокироватьУчетныеЗаписи(СсылкаУчетнойЗаписи, ДругойУчетнаяЗапись = Неопределено)
    Если ТипЗнч(СсылкаУчетнойЗаписи) <> Тип("СправочникСсылка.УчетныеЗаписи") Тогда
        ВызватьИсключение "кабинет_участник_несовпадение";
    КонецЕсли;
    Блокировка = Новый БлокировкаДанных;
    Первый = СсылкаУчетнойЗаписи;
    Второй = ДругойУчетнаяЗапись;
    Если ДругойУчетнаяЗапись <> Неопределено И ДругойУчетнаяЗапись <> СсылкаУчетнойЗаписи Тогда
        Если Строка(ДругойУчетнаяЗапись.УникальныйИдентификатор()) < Строка(СсылкаУчетнойЗаписи.УникальныйИдентификатор()) Тогда
            Первый = ДругойУчетнаяЗапись;
            Второй = СсылкаУчетнойЗаписи;
        КонецЕсли;
    Иначе
        Второй = Неопределено;
    КонецЕсли;
    Объект = Блокировка.Добавить("Справочник.УчетныеЗаписи");
    Объект.УстановитьЗначение("Ссылка", Первый);
    Объект.Режим = РежимБлокировкиДанных.Исключительный;
    Если Второй <> Неопределено Тогда
        Объект = Блокировка.Добавить("Справочник.УчетныеЗаписи");
        Объект.УстановитьЗначение("Ссылка", Второй);
        Объект.Режим = РежимБлокировкиДанных.Исключительный;
    КонецЕсли;
    Блокировка.Заблокировать();
КонецПроцедуры

Функция СохранитьУчастие(СсылкаРабочейОбласти, СсылкаУчетнойЗаписи, Роль, ОхватОбластей, СсылкаОбласти, ОжидаемаяРевизия)
    Блокировка = Новый БлокировкаДанных;
    БлокировкаЗапись = Блокировка.Добавить("РегистрСведений.ПривязкиУчастий");
    БлокировкаЗапись.УстановитьЗначение("РабочееПространство", СсылкаРабочейОбласти);
    БлокировкаЗапись.УстановитьЗначение("УчетнаяЗапись", СсылкаУчетнойЗаписи);
    БлокировкаЗапись.УстановитьЗначение("Роль", Роль);
    БлокировкаЗапись.УстановитьЗначение("Область", СсылкаОбласти);
    БлокировкаЗапись.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
    Привязка = РегистрыСведений.ПривязкиУчастий.СоздатьМенеджерЗаписи();
    Привязка.РабочееПространство = СсылкаРабочейОбласти;
    Привязка.УчетнаяЗапись = СсылкаУчетнойЗаписи;
    Привязка.Роль = Роль;
    Привязка.Область = СсылкаОбласти;
    Привязка.Прочитать();
    Если Привязка.Выбран() Тогда
        Участие = Привязка.Участие.ПолучитьОбъект();
        Если Участие = Неопределено Тогда
            ВызватьИсключение "кабинет_участие_привязка_конфликт";
        КонецЕсли;
        Если Участие.ПометкаУдаления Или Участие.РабочееПространство <> СсылкаРабочейОбласти
            Или Участие.УчетнаяЗапись <> СсылкаУчетнойЗаписи Или Участие.Роль <> Роль Или Участие.Область <> СсылкаОбласти Тогда
            ВызватьИсключение "кабинет_участие_привязка_конфликт";
        КонецЕсли;
        Если Участие.Ревизия <> ОжидаемаяРевизия Тогда
            ВызватьИсключение "кабинет_редакция_конфликт";
        КонецЕсли;
    Иначе
        Если ОжидаемаяРевизия <> 0 Тогда
            ВызватьИсключение "кабинет_редакция_конфликт";
        КонецЕсли;
        Участие = Справочники.Участия.СоздатьЭлемент();
        Участие.SetNewObjectRef(Справочники.Участия.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
        Участие.Наименование = Роль;
        Участие.РабочееПространство = СсылкаРабочейОбласти;
        Участие.УчетнаяЗапись = СсылкаУчетнойЗаписи;
        Участие.Роль = Роль;
        Участие.Область = СсылкаОбласти;
    КонецЕсли;
    Участие.ОхватОбластей = ОхватОбластей;
    Участие.Состояние = "Active";
    Участие.СрокИстечения = Дата(1, 1, 1);
    Участие.Ревизия = ОжидаемаяРевизия + 1;
    Участие.ИсточникПолномочия = Справочники.ПриглашенияВПространства.ПустаяСсылка();
    Участие.КемОтключено = Справочники.УчетныеЗаписи.ПустаяСсылка();
    Участие.РевизияДоОтключения = 0;
    Участие.Записать();
    Привязка.РабочееПространство = СсылкаРабочейОбласти;
    Привязка.УчетнаяЗапись = СсылкаУчетнойЗаписи;
    Привязка.Роль = Роль;
    Привязка.Область = СсылкаОбласти;
    Привязка.Участие = Участие.Ссылка;
    Привязка.Записать();
    Возврат Участие.Ссылка;
КонецФункции
