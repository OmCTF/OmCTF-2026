Функция НастроитьШлюзИзФайлаОператора() Экспорт
    ПроверитьНезависимость();
    Текущий = ПользователиИнформационнойБазы.ТекущийПользователь();
    Если Текущий = Неопределено Тогда ВызватьИсключение "идентификация_оператор_требуется"; КонецЕсли;
    Свежий = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Текущий.УникальныйИдентификатор);
    Если Свежий = Неопределено Тогда ВызватьИсключение "идентификация_оператор_требуется"; КонецЕсли;
    Администратор = Ложь;
    Для Каждого Роль Из Свежий.Роли Цикл Если Роль = Метаданные.Роли.Администратор Тогда Администратор = Истина; КонецЕсли; КонецЦикла;
    Если Не Администратор Тогда ВызватьИсключение "идентификация_оператор_требуется"; КонецЕсли;
    Чтение = Новый ЧтениеJSON;
    Попытка
        Чтение.ОткрытьФайл("/run/vodokanal-identity-gateway.json"); Вход = ПрочитатьJSON(Чтение); Чтение.Закрыть();
    Исключение Чтение.Закрыть(); ВызватьИсключение "идентификация_оператор_ввод_недоступно"; КонецПопытки;
    ПроверитьСхему(Вход, "schema,mode,operationId,password,expectedNativeId");
    Если ТипЗнч(Вход.schema) <> Тип("Число") Или Вход.schema <> 1 Тогда ВызватьИсключение "идентификация_некорректно_ввод"; КонецЕсли;
    Операция = Идентификатор(Вход.operationId);
    Если Вход.mode = "create" Тогда
        Если Вход.expectedNativeId <> "" Тогда ВызватьИсключение "идентификация_некорректно_ввод"; КонецЕсли;
        Текст(Вход.password, 32, 128);
        Для Каждого Существующий Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
            Если НРег(Существующий.Имя) = "vodokanal_identity_gateway" Тогда ВызватьИсключение "идентификация_шлюз_уже_существует"; КонецЕсли;
        КонецЦикла;
        Пользователь = ПользователиИнформационнойБазы.СоздатьПользователя();
        Для Каждого Роль Из Пользователь.Роли Цикл ВызватьИсключение "идентификация_платформа_роль_конфликт"; КонецЦикла;
        Пользователь.Имя = "vodokanal_identity_gateway"; Пользователь.ПолноеИмя = "Изолированный шлюз саморегистрации";
        Пользователь.АутентификацияСтандартная = Истина; Пользователь.АутентификацияОС = Ложь;
        Пользователь.ПоказыватьВСпискеВыбора = Ложь; Пользователь.Пароль = Вход.password;
        Пользователь.Роли.Добавить(Метаданные.Роли.ШлюзРегистрации); Пользователь.Язык = Метаданные.Языки.Русский;
        Пользователь.Записать();
        НативныйИд = Пользователь.УникальныйИдентификатор;
    ИначеЕсли Вход.mode = "verify" Тогда
        Если Вход.password <> "" Тогда ВызватьИсключение "идентификация_некорректно_ввод"; КонецЕсли;
        НативныйИд = Новый УникальныйИдентификатор(Идентификатор(Вход.expectedNativeId));
    Иначе ВызватьИсключение "идентификация_некорректно_ввод"; КонецЕсли;
    Пользователь = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(НативныйИд);
    Если Пользователь = Неопределено Тогда ВызватьИсключение "идентификация_шлюз_не_найдено"; КонецЕсли;
    ПроверитьРовноРоль(Пользователь, Метаданные.Роли.ШлюзРегистрации);
    Если Пользователь.Имя <> "vodokanal_identity_gateway" Или Не Пользователь.АутентификацияСтандартная
        Или Пользователь.АутентификацияОС Или Пользователь.ПоказыватьВСпискеВыбора Тогда ВызватьИсключение "идентификация_платформа_роль_конфликт"; КонецЕсли;
    Возврат Новый Структура("schema,operationId,mode,nativeUserId,name,roleName,standardAuth,osAuth,showInList", 1,
        Операция, Вход.mode, Строка(НативныйИд), "vodokanal_identity_gateway", "ШлюзРегистрации", Истина, Ложь, Ложь);
КонецФункции

Функция Зарегистрировать(Данные, Источник) Экспорт
    ПроверитьШлюз(); ПроверитьНезависимость();
    ПроверитьСхему(Данные, "login,displayName,password,mailboxKey,requestId");
    Логин = НормализоватьЛогин(Данные.login); ПроверитьПароль(Данные.password);
    Имя = СокрЛП(Текст(Данные.displayName, 1, 150)); Ключ = КлючЯщика(Данные.mailboxKey);
    Если ПустаяСтрока(Имя) Тогда ВызватьИсключение "идентификация_некорректно_ввод"; КонецЕсли;
    ЗапросИд = Идентификатор(Данные.requestId);
    ПрименитьЛимит(Логин, "register", 5);
    Отпечаток = Хеш(Логин + Символы.ПС + Имя + Символы.ПС + Данные.password + Символы.ПС + Ключ);
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        Заблокировать("РегистрСведений.РегистрацииКабинета", "НормализованныйЛогин", Логин);
        Запись = РегистрыСведений.РегистрацииКабинета.СоздатьМенеджерЗаписи();
        Запись.НормализованныйЛогин = Логин; Запись.Прочитать();
        Если Запись.Выбран() Тогда
            Если Запись.ИдентификаторЗапроса <> ЗапросИд Или Запись.ОтпечатокЗапроса <> Отпечаток Тогда
                ВызватьИсключение "идентификация_регистрация_конфликт";
            КонецЕсли;
            Результат = РегистрацияДТО(Запись.УчетнаяЗапись, Логин);
        Иначе
            Заблокировать("РегистрСведений.ПривязкиЛогинов", "НормализованныйЛогин", Логин);
            ПроверитьСвободныйЛогин(Логин);
            Пользователь = ПользователиИнформационнойБазы.СоздатьПользователя();
            Для Каждого Роль Из Пользователь.Роли Цикл ВызватьИсключение "идентификация_платформа_роль_конфликт"; КонецЦикла;
            Пользователь.Имя = Логин; Пользователь.ПолноеИмя = Имя;
            Пользователь.АутентификацияСтандартная = Истина; Пользователь.АутентификацияОС = Ложь;
            Пользователь.ПоказыватьВСпискеВыбора = Ложь; Пользователь.Язык = Метаданные.Языки.Русский;
            Пользователь.Роли.Добавить(Метаданные.Роли.APIКабинета); Пользователь.Пароль = Данные.password;
            Пользователь.Записать();
            УчетнаяЗапись = Справочники.УчетныеЗаписи.СоздатьЭлемент();
            УчетнаяЗапись.SetNewObjectRef(Справочники.УчетныеЗаписи.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
            УчетнаяЗапись.Наименование = Имя; УчетнаяЗапись.НормализованныйЛогин = Логин;
            УчетнаяЗапись.ИдентификаторПользователя1С = Строка(Пользователь.УникальныйИдентификатор);
            УчетнаяЗапись.Состояние = "Active"; УчетнаяЗапись.ПоколениеАвторизации = 1;
            УчетнаяЗапись.ДатаСоздания = ТекущаяУниверсальнаяДата(); УчетнаяЗапись.Записать();
            Привязка = РегистрыСведений.ПривязкиПользователей1С.СоздатьМенеджерЗаписи();
            Привязка.ИдентификаторПользователя1С = УчетнаяЗапись.ИдентификаторПользователя1С;
            Привязка.УчетнаяЗапись = УчетнаяЗапись.Ссылка; Привязка.Записать();
            ПривязкаЛогина = РегистрыСведений.ПривязкиЛогинов.СоздатьМенеджерЗаписи();
            ПривязкаЛогина.НормализованныйЛогин = Логин; ПривязкаЛогина.УчетнаяЗапись = УчетнаяЗапись.Ссылка; ПривязкаЛогина.Записать();
            Ящик = ЗаписатьНовыйЯщик(УчетнаяЗапись.Ссылка, Логин, Ключ, ЗапросИд);
            СоздатьПисьмо(УчетнаяЗапись.Ссылка, Ящик, "contact", ЗапросИд);
            Запись.НормализованныйЛогин = Логин; Запись.ИдентификаторЗапроса = ЗапросИд;
            Запись.ОтпечатокЗапроса = Отпечаток; Запись.УчетнаяЗапись = УчетнаяЗапись.Ссылка;
            Запись.ДатаСоздания = ТекущаяУниверсальнаяДата(); Запись.Записать();
            Аудит(УчетнаяЗапись.Ссылка, "account.register");
            Результат = РегистрацияДТО(УчетнаяЗапись.Ссылка, Логин);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ОткрытьЯщик(Данные, Источник) Экспорт
    ПроверитьШлюз(); ПроверитьНезависимость(); ПроверитьСхему(Данные, "login,mailboxKey");
    НормализованныйЛогин = НормализоватьЛогин(Данные.login); Ключ = КлючЯщика(Данные.mailboxKey);
    ПрименитьЛимит(НормализованныйЛогин, "mailbox", 20);
    Предварительно = ПолучитьВладельцаЯщика(НормализованныйЛогин, Ключ);
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьУчетнуюЗапись(Предварительно.Ссылка);
        УчетнаяЗапись = ПолучитьВладельцаЯщика(НормализованныйЛогин, Ключ);
        Результат = ПисьмаДТО(УчетнаяЗапись.Ссылка);
        ЗафиксироватьТранзакцию();
    Исключение
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли; ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ЗапроситьВосстановление(Данные, Источник) Экспорт
    ПроверитьШлюз(); ПроверитьНезависимость(); ПроверитьСхему(Данные, "login,mailboxKey,requestId");
    НормализованныйЛогин = НормализоватьЛогин(Данные.login); Ключ = КлючЯщика(Данные.mailboxKey); ЗапросИд = Идентификатор(Данные.requestId);
    ПрименитьЛимит(НормализованныйЛогин, "recovery", 5);
    Предварительно = ПолучитьВладельцаЯщика(НормализованныйЛогин, Ключ);
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьУчетнуюЗапись(Предварительно.Ссылка);
        УчетнаяЗапись = ПолучитьВладельцаЯщика(НормализованныйЛогин, Ключ);
        Ящик = ПрочитатьЯщик(УчетнаяЗапись.Ссылка);
        Если Не Ящик.Подтвержден Тогда ВызватьИсключение "идентификация_контакт_не_подтверждено"; КонецЕсли;
        Письмо = ПрочитатьПисьмо(УчетнаяЗапись.Ссылка, "recovery");
        Если Письмо.Выбран() И Письмо.ИдентификаторЗапроса = ЗапросИд Тогда
        Иначе
            Если ТекущаяУниверсальнаяДата() - Ящик.ПоследнееВосстановление < 60 Тогда ВызватьИсключение "идентификация_частота_ограничено"; КонецЕсли;
            СоздатьПисьмо(УчетнаяЗапись.Ссылка, Ящик, "recovery", ЗапросИд);
            Ящик.ПоследнееВосстановление = ТекущаяУниверсальнаяДата(); Ящик.Записать();
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли; ВызватьИсключение;
    КонецПопытки;
    Возврат Новый Структура("accepted,expiresIn", Истина, 600);
КонецФункции

Функция ЗавершитьВосстановление(Данные, Источник) Экспорт
    ПроверитьШлюз(); ПроверитьНезависимость();
    ПроверитьСхему(Данные, "login,mailboxKey,messageId,code,newPassword,requestId");
    НормализованныйЛогин = НормализоватьЛогин(Данные.login); Ключ = КлючЯщика(Данные.mailboxKey);
    СообщениеИд = Идентификатор(Данные.messageId); ЗапросИд = Идентификатор(Данные.requestId);
    Код = Текст(Данные.code, 44, 44); ПроверитьПароль(Данные.newPassword);
    ПрименитьЛимит(НормализованныйЛогин, "complete", 10);
    Предварительно = ПолучитьВладельцаЯщика(НормализованныйЛогин, Ключ);
    Отпечаток = Хеш(Ключ + Символы.ПС + Данные.newPassword + Символы.ПС + ЗапросИд);
    Сбой = "";
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьУчетнуюЗапись(Предварительно.Ссылка);
        УчетнаяЗапись = ПолучитьВладельцаЯщика(НормализованныйЛогин, Ключ);
        Ящик = ПрочитатьЯщик(УчетнаяЗапись.Ссылка); Письмо = ПрочитатьПисьмо(УчетнаяЗапись.Ссылка, "recovery");
        Если Не Письмо.Выбран() Или Письмо.Идентификатор <> СообщениеИд Или Письмо.ПоколениеЯщика <> Ящик.Поколение Тогда
            Сбой = "идентификация_код_некорректно";
        ИначеЕсли Письмо.Состояние = "Processing" Или Письмо.Состояние = "Consumed" Тогда
            Если Письмо.ОтпечатокСброса <> Отпечаток Или Не РавныХеши(Письмо.ХешКода, Хеш(Код)) Тогда Сбой = "идентификация_код_некорректно"; КонецЕсли;
        ИначеЕсли Письмо.Состояние <> "Pending" Или Письмо.Истекает <= ТекущаяУниверсальнаяДата() Или Письмо.Попытки >= 5 Тогда
            Сбой = "идентификация_код_некорректно";
        ИначеЕсли Не РавныХеши(Письмо.ХешКода, Хеш(Код)) Тогда
            Письмо.Попытки = Письмо.Попытки + 1; Письмо.Записать(); Сбой = "идентификация_код_некорректно";
        Иначе
            Если Не Ящик.Подтвержден Или (УчетнаяЗапись.Состояние <> "Active" И УчетнаяЗапись.Состояние <> "RecoveryPending") Тогда ВызватьИсключение "идентификация_почтовый_ящик_не_найдено"; КонецЕсли;
            ПроверитьНативногоЗаявителя(УчетнаяЗапись);
            Если УчетнаяЗапись.ПоколениеАвторизации >= 999999999999998 Тогда ВызватьИсключение "идентификация_поколение_исчерпано"; КонецЕсли;
            УчетнаяЗапись.ПоколениеАвторизации = УчетнаяЗапись.ПоколениеАвторизации + 1;
            УчетнаяЗапись.Состояние = "RecoveryPending"; УчетнаяЗапись.Записать();
            Письмо.Состояние = "Processing"; Письмо.ОтпечатокСброса = Отпечаток;
            Письмо.ИдентификаторЗавершения = ЗапросИд; Письмо.Записать();
            Аудит(УчетнаяЗапись.Ссылка, "account.recovery.begin");
        КонецЕсли;
        УжеЗавершено = Письмо.Выбран() И Письмо.Состояние = "Consumed";
        ЗафиксироватьТранзакцию();
    Исключение
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли; ВызватьИсключение;
    КонецПопытки;
    Если Сбой <> "" Тогда ВызватьИсключение Сбой; КонецЕсли;
    Если УжеЗавершено Тогда Возврат Новый Структура("completed,loginRequired", Истина, Истина); КонецЕсли;

    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьУчетнуюЗапись(Предварительно.Ссылка);
        УчетнаяЗапись = ПолучитьВладельцаЯщика(НормализованныйЛогин, Ключ);
        Письмо = ПрочитатьПисьмо(УчетнаяЗапись.Ссылка, "recovery");
        Если Письмо.Состояние <> "Processing" Или Письмо.Идентификатор <> СообщениеИд Или Письмо.ОтпечатокСброса <> Отпечаток
            Или УчетнаяЗапись.Состояние <> "RecoveryPending" Тогда ВызватьИсключение "идентификация_восстановление_ожидание"; КонецЕсли;
        Пользователь = ПроверитьНативногоЗаявителя(УчетнаяЗапись);
        Пользователь.Пароль = Данные.newPassword; Пользователь.Записать();
        УчетнаяЗапись.Состояние = "Active"; УчетнаяЗапись.Записать();
        Письмо.Состояние = "Consumed"; Письмо.Код = ""; Письмо.Записать();
        Аудит(УчетнаяЗапись.Ссылка, "account.recovery.complete");
        ЗафиксироватьТранзакцию();
    Исключение
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
        ВызватьИсключение "идентификация_восстановление_ожидание";
    КонецПопытки;
    Возврат Новый Структура("completed,loginRequired", Истина, Истина);
КонецФункции

Функция ПрофильКонтакта(УчетнаяЗаписьСсылка) Экспорт
    ПроверитьВладельца(УчетнаяЗаписьСсылка);
    Ящик = ПрочитатьЯщик(УчетнаяЗаписьСсылка);
    Возврат Новый Структура("configured,address,confirmed,version", Ящик.Выбран(), Ящик.Адрес, Ящик.Подтвержден, Ящик.Поколение);
КонецФункции

Функция СобственныеПисьма(УчетнаяЗаписьСсылка) Экспорт
    ПроверитьВладельца(УчетнаяЗаписьСсылка); Возврат ПисьмаДТО(УчетнаяЗаписьСсылка);
КонецФункции

Функция НастроитьЯщик(УчетнаяЗаписьСсылка, Данные, СозданоСеанс) Экспорт
    ПроверитьНезависимость(); УчетнаяЗапись = ПроверитьВладельца(УчетнаяЗаписьСсылка);
    ПроверитьСхему(Данные, "mailboxKey,requestId,expectedVersion");
    Ключ = КлючЯщика(Данные.mailboxKey); ЗапросИд = Идентификатор(Данные.requestId);
    Если ТипЗнч(СозданоСеанс) <> Тип("Дата") Тогда ВызватьИсключение "кабинет_повторная_авторизация_требуется"; КонецЕсли;
    Возраст = ТекущаяУниверсальнаяДата() - СозданоСеанс;
    Если Возраст < 0 Или Возраст > 60 Тогда ВызватьИсключение "кабинет_повторная_авторизация_требуется"; КонецЕсли;
    Если ТипЗнч(Данные.expectedVersion) <> Тип("Число") Тогда ВызватьИсключение "идентификация_некорректно_ввод"; КонецЕсли;
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьУчетнуюЗапись(УчетнаяЗаписьСсылка); УчетнаяЗапись = ПроверитьВладельца(УчетнаяЗаписьСсылка);
        ПроверитьНативногоЗаявителя(УчетнаяЗапись);
        Ящик = ПрочитатьЯщик(УчетнаяЗаписьСсылка);
        Если Ящик.Выбран() И Ящик.ИдентификаторЗапроса = ЗапросИд Тогда
            Если Не РавныХеши(Ящик.ХешКлюча, Хеш("mailbox:" + Ключ)) Тогда ВызватьИсключение "идентификация_регистрация_конфликт"; КонецЕсли;
        Иначе
            Если Ящик.Поколение <> Данные.expectedVersion Тогда ВызватьИсключение "идентификация_версия_конфликт"; КонецЕсли;
            Ящик = ЗаписатьНовыйЯщик(УчетнаяЗаписьСсылка, УчетнаяЗапись.НормализованныйЛогин, Ключ, ЗапросИд);
            СоздатьПисьмо(УчетнаяЗаписьСсылка, Ящик, "contact", ЗапросИд);
            Аудит(УчетнаяЗаписьСсылка, "account.mailbox.rotate");
        КонецЕсли;
        Результат = Новый Структура("configured,address,confirmed,version", Истина, Ящик.Адрес, Ящик.Подтвержден, Ящик.Поколение);
        ЗафиксироватьТранзакцию();
    Исключение
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли; ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ЗапроситьПодтверждение(УчетнаяЗаписьСсылка, Данные) Экспорт
    ПроверитьНезависимость(); ПроверитьВладельца(УчетнаяЗаписьСсылка); ПроверитьСхему(Данные, "requestId");
    ЗапросИд = Идентификатор(Данные.requestId);
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьУчетнуюЗапись(УчетнаяЗаписьСсылка); ПроверитьВладельца(УчетнаяЗаписьСсылка);
        Ящик = ПрочитатьЯщик(УчетнаяЗаписьСсылка);
        Если Не Ящик.Выбран() Тогда ВызватьИсключение "идентификация_почтовый_ящик_не_найдено"; КонецЕсли;
        Письмо = ПрочитатьПисьмо(УчетнаяЗаписьСсылка, "contact");
        Если Письмо.Выбран() И Письмо.ИдентификаторЗапроса = ЗапросИд Тогда
        Иначе
            Если ТекущаяУниверсальнаяДата() - Ящик.ПоследнееПодтверждение < 60 Тогда ВызватьИсключение "идентификация_частота_ограничено"; КонецЕсли;
            СоздатьПисьмо(УчетнаяЗаписьСсылка, Ящик, "contact", ЗапросИд);
            Ящик.ПоследнееПодтверждение = ТекущаяУниверсальнаяДата(); Ящик.Записать();
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли; ВызватьИсключение;
    КонецПопытки;
    Возврат Новый Структура("accepted,expiresIn", Истина, 600);
КонецФункции

Функция ПодтвердитьКонтакт(УчетнаяЗаписьСсылка, Данные) Экспорт
    ПроверитьНезависимость(); ПроверитьВладельца(УчетнаяЗаписьСсылка); ПроверитьСхему(Данные, "messageId,code");
    СообщениеИд = Идентификатор(Данные.messageId); Код = Текст(Данные.code, 44, 44); Сбой = "";
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьУчетнуюЗапись(УчетнаяЗаписьСсылка); ПроверитьВладельца(УчетнаяЗаписьСсылка);
        Ящик = ПрочитатьЯщик(УчетнаяЗаписьСсылка); Письмо = ПрочитатьПисьмо(УчетнаяЗаписьСсылка, "contact");
        Если Не Ящик.Выбран() Или Не Письмо.Выбран() Или Письмо.Идентификатор <> СообщениеИд
            Или Письмо.ПоколениеЯщика <> Ящик.Поколение Тогда Сбой = "идентификация_код_некорректно";
        ИначеЕсли Письмо.Состояние = "Consumed" И РавныХеши(Письмо.ХешКода, Хеш(Код)) Тогда
        ИначеЕсли Письмо.Состояние <> "Pending" Или Письмо.Истекает <= ТекущаяУниверсальнаяДата() Или Письмо.Попытки >= 5 Тогда
            Сбой = "идентификация_код_некорректно";
        ИначеЕсли Не РавныХеши(Письмо.ХешКода, Хеш(Код)) Тогда
            Письмо.Попытки = Письмо.Попытки + 1; Письмо.Записать(); Сбой = "идентификация_код_некорректно";
        Иначе
            Ящик.Подтвержден = Истина; Ящик.Записать(); Письмо.Состояние = "Consumed"; Письмо.Код = ""; Письмо.Записать();
            Аудит(УчетнаяЗаписьСсылка, "account.contact.confirm");
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли; ВызватьИсключение;
    КонецПопытки;
    Если Сбой <> "" Тогда ВызватьИсключение Сбой; КонецЕсли;
    Возврат Новый Структура("confirmed", Истина);
КонецФункции

Процедура ПроверитьШлюз() Экспорт
    Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
    Если Пользователь = Неопределено Тогда ВызватьИсключение "идентификация_шлюз_запрещено"; КонецЕсли;
    Если Пользователь.Имя <> "vodokanal_identity_gateway" Тогда ВызватьИсключение "идентификация_шлюз_запрещено"; КонецЕсли;
    Свежий = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Пользователь.УникальныйИдентификатор);
    Если Свежий = Неопределено Тогда ВызватьИсключение "идентификация_шлюз_запрещено"; КонецЕсли;
    ПроверитьРовноРоль(Свежий, Метаданные.Роли.ШлюзРегистрации);
    Если Свежий.Имя <> "vodokanal_identity_gateway" Или Не Свежий.АутентификацияСтандартная
        Или Свежий.АутентификацияОС Или Свежий.ПоказыватьВСпискеВыбора Тогда ВызватьИсключение "идентификация_шлюз_запрещено"; КонецЕсли;
КонецПроцедуры

Функция ПроверитьВладельца(УчетнаяЗаписьСсылка)
    УчетнаяЗапись = ПолитикаДоступа.ПроверитьУчетнуюЗапись();
    Если УчетнаяЗапись.Ссылка <> УчетнаяЗаписьСсылка Тогда ВызватьИсключение "кабинет_участник_несовпадение"; КонецЕсли;
    Возврат УчетнаяЗапись;
КонецФункции

Функция ПолучитьВладельцаЯщика(НормализованныйЛогин, Ключ)
    Привязка = РегистрыСведений.ПривязкиЛогинов.СоздатьМенеджерЗаписи();
    Привязка.НормализованныйЛогин = НормализованныйЛогин; Привязка.Прочитать();
    Если Не Привязка.Выбран() Или Не ЗначениеЗаполнено(Привязка.УчетнаяЗапись) Тогда ВызватьИсключение "идентификация_почтовый_ящик_не_найдено"; КонецЕсли;
    УчетнаяЗапись = Привязка.УчетнаяЗапись.ПолучитьОбъект();
    Если УчетнаяЗапись = Неопределено Тогда ВызватьИсключение "идентификация_почтовый_ящик_не_найдено"; КонецЕсли;
    Если УчетнаяЗапись.ПометкаУдаления Или УчетнаяЗапись.НормализованныйЛогин <> НормализованныйЛогин
        Или (УчетнаяЗапись.Состояние <> "Active" И УчетнаяЗапись.Состояние <> "RecoveryPending") Тогда ВызватьИсключение "идентификация_почтовый_ящик_не_найдено"; КонецЕсли;
    Ящик = ПрочитатьЯщик(УчетнаяЗапись.Ссылка);
    Если Не Ящик.Выбран() Или Не РавныХеши(Ящик.ХешКлюча, Хеш("mailbox:" + Ключ)) Тогда ВызватьИсключение "идентификация_почтовый_ящик_не_найдено"; КонецЕсли;
    Возврат УчетнаяЗапись;
КонецФункции

Функция ПроверитьНативногоЗаявителя(УчетнаяЗапись)
    Пользователь = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(УчетнаяЗапись.ИдентификаторПользователя1С));
    Если Пользователь = Неопределено Тогда ВызватьИсключение "идентификация_платформа_привязка_конфликт"; КонецЕсли;
    ПроверитьРовноРоль(Пользователь, Метаданные.Роли.APIКабинета);
    Если НРег(Пользователь.Имя) <> УчетнаяЗапись.НормализованныйЛогин Или Не Пользователь.АутентификацияСтандартная
        Или Пользователь.АутентификацияОС Или Пользователь.ПоказыватьВСпискеВыбора Тогда ВызватьИсключение "идентификация_платформа_привязка_конфликт"; КонецЕсли;
    Привязка = РегистрыСведений.ПривязкиПользователей1С.СоздатьМенеджерЗаписи();
    Привязка.ИдентификаторПользователя1С = УчетнаяЗапись.ИдентификаторПользователя1С; Привязка.Прочитать();
    Если Не Привязка.Выбран() Или Привязка.УчетнаяЗапись <> УчетнаяЗапись.Ссылка Тогда ВызватьИсключение "идентификация_платформа_привязка_конфликт"; КонецЕсли;
    Возврат Пользователь;
КонецФункции

Процедура ПроверитьРовноРоль(Пользователь, ОжидаемаяРоль)
    Количество = 0;
    Для Каждого Роль Из Пользователь.Роли Цикл
        Если Роль <> ОжидаемаяРоль Тогда ВызватьИсключение "идентификация_платформа_роль_конфликт"; КонецЕсли;
        Количество = Количество + 1;
    КонецЦикла;
    Если Количество <> 1 Тогда ВызватьИсключение "идентификация_платформа_роль_конфликт"; КонецЕсли;
КонецПроцедуры

Процедура ПроверитьСвободныйЛогин(НормализованныйЛогин)
    Привязка = РегистрыСведений.ПривязкиЛогинов.СоздатьМенеджерЗаписи();
    Привязка.НормализованныйЛогин = НормализованныйЛогин; Привязка.Прочитать();
    Если Привязка.Выбран() Тогда ВызватьИсключение "идентификация_регистрация_конфликт"; КонецЕсли;
    Для Каждого Пользователь Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
        Если НРег(Пользователь.Имя) = НормализованныйЛогин Тогда ВызватьИсключение "идентификация_регистрация_конфликт"; КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ПрочитатьЯщик(УчетнаяЗаписьСсылка)
    Запись = РегистрыСведений.ПочтовыеЯщикиКабинета.СоздатьМенеджерЗаписи();
    Запись.УчетнаяЗапись = УчетнаяЗаписьСсылка; Запись.Прочитать(); Запись.УчетнаяЗапись = УчетнаяЗаписьСсылка;
    Возврат Запись;
КонецФункции

Функция ЗаписатьНовыйЯщик(УчетнаяЗаписьСсылка, НормализованныйЛогин, Ключ, ЗапросИд)
    Ящик = ПрочитатьЯщик(УчетнаяЗаписьСсылка);
    Если Ящик.Поколение >= 999999999999998 Тогда ВызватьИсключение "идентификация_поколение_исчерпано"; КонецЕсли;
    Ящик.ХешКлюча = Хеш("mailbox:" + Ключ); Ящик.КлючДоставки = Хеш("delivery:" + Ключ);
    Ящик.Адрес = НормализованныйЛогин + "@mail.example.test";
    Ящик.Подтвержден = Ложь; Ящик.Поколение = Ящик.Поколение + 1;
    Ящик.ДатаИзменения = ТекущаяУниверсальнаяДата(); Ящик.ИдентификаторЗапроса = ЗапросИд;
    Ящик.ПоследнееПодтверждение = ТекущаяУниверсальнаяДата(); Ящик.ПоследнееВосстановление = Дата(1, 1, 1);
    Ящик.Записать(); Возврат Ящик;
КонецФункции

Функция ПрочитатьПисьмо(УчетнаяЗаписьСсылка, Назначение)
    Запись = РегистрыСведений.ПисьмаИдентичности.СоздатьМенеджерЗаписи();
    Запись.УчетнаяЗапись = УчетнаяЗаписьСсылка; Запись.Назначение = Назначение; Запись.Прочитать();
    Запись.УчетнаяЗапись = УчетнаяЗаписьСсылка; Запись.Назначение = Назначение; Возврат Запись;
КонецФункции

Процедура СоздатьПисьмо(УчетнаяЗаписьСсылка, Ящик, Назначение, ЗапросИд)
    Письмо = ПрочитатьПисьмо(УчетнаяЗаписьСсылка, Назначение);
    Письмо.Идентификатор = Строка(СервисДокументов.НовыйUUIDv4());
    Письмо.Код = Хеш(Ящик.КлючДоставки + ":" + Письмо.Идентификатор + ":" + Назначение);
    Письмо.ХешКода = Хеш(Письмо.Код); Письмо.Создано = ТекущаяУниверсальнаяДата();
    Письмо.Истекает = Письмо.Создано + 600; Письмо.ПоколениеЯщика = Ящик.Поколение;
    Письмо.Попытки = 0; Письмо.Состояние = "Pending"; Письмо.ИдентификаторЗапроса = ЗапросИд;
    Письмо.ОтпечатокСброса = ""; Письмо.ИдентификаторЗавершения = ""; Письмо.Записать();
КонецПроцедуры

Функция ПисьмаДТО(УчетнаяЗаписьСсылка)
    Ящик = ПрочитатьЯщик(УчетнаяЗаписьСсылка); Элементы = Новый Массив;
    Если Не Ящик.Выбран() Тогда ВызватьИсключение "идентификация_почтовый_ящик_не_найдено"; КонецЕсли;
    Для Каждого Назначение Из СтрРазделить("contact,recovery", ",") Цикл
        Письмо = ПрочитатьПисьмо(УчетнаяЗаписьСсылка, Назначение);
        Если Не Письмо.Выбран() Или Письмо.ПоколениеЯщика <> Ящик.Поколение Тогда Продолжить; КонецЕсли;
        Состояние = Письмо.Состояние; Код = "";
        Если Состояние = "Pending" И Письмо.Истекает <= ТекущаяУниверсальнаяДата() Тогда Состояние = "Expired"; КонецЕсли;
        Если Состояние = "Pending" И Письмо.Попытки >= 5 Тогда Состояние = "Exhausted"; КонецЕсли;
        Если Состояние = "Pending" Или Состояние = "Processing" Тогда Код = Письмо.Код; КонецЕсли;
        Элементы.Добавить(Новый Структура("id,purpose,state,createdAt,expiresAt,code,completionRequestId", Письмо.Идентификатор, Назначение,
            Состояние, XMLСтрока(Письмо.Создано) + "Z", XMLСтрока(Письмо.Истекает) + "Z", Код, Письмо.ИдентификаторЗавершения));
    КонецЦикла;
    Возврат Новый Структура("address,items,limit,hasMore,nextCursor", Ящик.Адрес, Элементы, 25, Ложь, "");
КонецФункции

Процедура ПрименитьЛимит(Субъект, Операция, Максимум)
    УчестьОкно(Хеш("subject:" + Субъект + ":" + Операция), Максимум);
КонецПроцедуры

Процедура УчестьОкно(Ключ, Максимум)
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        Заблокировать("РегистрСведений.ЛимитыИдентичности", "Ключ", Ключ);
        Запись = РегистрыСведений.ЛимитыИдентичности.СоздатьМенеджерЗаписи(); Запись.Ключ = Ключ; Запись.Прочитать();
        Запись.Ключ = Ключ; Сейчас = ТекущаяУниверсальнаяДата();
        Если Не Запись.Выбран() Или Сейчас - Запись.НачалоОкна >= 60 Тогда Запись.НачалоОкна = Сейчас; Запись.Количество = 0; КонецЕсли;
        Разрешено = Запись.Количество < Максимум;
        Если Разрешено Тогда Запись.Количество = Запись.Количество + 1; Запись.Записать(); КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли; ВызватьИсключение;
    КонецПопытки;
    Если Не Разрешено Тогда ВызватьИсключение "идентификация_частота_ограничено"; КонецЕсли;
КонецПроцедуры

Процедура ЗаблокироватьУчетнуюЗапись(Ссылка)
    Заблокировать("Справочник.УчетныеЗаписи", "Ссылка", Ссылка);
КонецПроцедуры

Процедура Заблокировать(Таблица, Поле, Значение)
    Блокировка = Новый БлокировкаДанных; Элемент = Блокировка.Добавить(Таблица);
    Элемент.УстановитьЗначение(Поле, Значение); Элемент.Режим = РежимБлокировкиДанных.Исключительный; Блокировка.Заблокировать();
КонецПроцедуры

Процедура ПроверитьНезависимость()
    Если ТранзакцияАктивна() Тогда ВызватьИсключение "идентификация_транзакция_активно"; КонецЕсли;
КонецПроцедуры

Функция РегистрацияДТО(Ссылка, НормализованныйЛогин)
    Возврат Новый Структура("id,login,applicant,loginRequired,mailboxAddress", Строка(Ссылка.УникальныйИдентификатор()),
        НормализованныйЛогин, Истина, Истина, НормализованныйЛогин + "@mail.example.test");
КонецФункции

Процедура Аудит(Ссылка, Действие)
    ДействующееЛицо = ПолитикаДоступа.НайтиУчетнуюЗапись();
    Если ДействующееЛицо = Неопределено Тогда ДействующееЛицо = Справочники.УчетныеЗаписи.ПустаяСсылка(); КонецЕсли;
    ПолитикаДоступа.ЗаписатьСобытиеАудита(ДействующееЛицо, Справочники.РабочиеПространства.ПустаяСсылка(), Действие, Строка(Ссылка.УникальныйИдентификатор()));
КонецПроцедуры

Процедура ПроверитьСхему(Данные, Поля)
    Если ТипЗнч(Данные) <> Тип("Структура") Тогда ВызватьИсключение "идентификация_некорректно_ввод"; КонецЕсли;
    Разрешенные = СтрРазделить(Поля, ",");
    Если Данные.Количество() <> Разрешенные.Количество() Тогда ВызватьИсключение "идентификация_некорректно_ввод"; КонецЕсли;
    Для Каждого Поле Из Разрешенные Цикл Если Не Данные.Свойство(Поле) Тогда ВызватьИсключение "идентификация_некорректно_ввод"; КонецЕсли; КонецЦикла;
КонецПроцедуры

Функция Текст(Значение, Минимум, Максимум)
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда ВызватьИсключение "идентификация_некорректно_ввод"; КонецЕсли;
    Если СтрДлина(Значение) < Минимум Или СтрДлина(Значение) > Максимум Тогда ВызватьИсключение "идентификация_некорректно_ввод"; КонецЕсли;
    Для Индекс = 1 По СтрДлина(Значение) Цикл
        Код = КодСимвола(Значение, Индекс);
        Если Код < 32 Или (Код >= 127 И Код <= 159) Тогда ВызватьИсключение "идентификация_некорректно_ввод"; КонецЕсли;
    КонецЦикла;
    Возврат Значение;
КонецФункции

Функция НормализоватьЛогин(Значение)
    Значение = НРег(Текст(Значение, 3, 64)); Разрешенные = "abcdefghijklmnopqrstuvwxyz0123456789._-";
    Для Индекс = 1 По СтрДлина(Значение) Цикл
        Если СтрНайти(Разрешенные, Сред(Значение, Индекс, 1)) = 0 Тогда ВызватьИсключение "идентификация_некорректно_ввод"; КонецЕсли;
    КонецЦикла;
    Если Лев(Значение, 10) = "vodokanal_" Тогда ВызватьИсключение "идентификация_некорректно_ввод"; КонецЕсли;
    Возврат Значение;
КонецФункции

Функция КлючЯщика(Значение)
    Значение = Текст(Значение, 64, 64);
    Для Индекс = 1 По 64 Цикл
        Если СтрНайти("0123456789abcdef", Сред(Значение, Индекс, 1)) = 0 Тогда ВызватьИсключение "идентификация_некорректно_ввод"; КонецЕсли;
    КонецЦикла;
    Возврат Значение;
КонецФункции

Процедура ПроверитьПароль(Пароль)
    Текст(Пароль, 12, 128);
КонецПроцедуры

Функция Идентификатор(Значение)
    Значение = Текст(Значение, 36, 36);
    Попытка Ид = Новый УникальныйИдентификатор(Значение); Исключение ВызватьИсключение "идентификация_некорректно_ввод"; КонецПопытки;
    Если НРег(Строка(Ид)) <> НРег(Значение) Или Строка(Ид) = "00000000-0000-0000-0000-000000000000" Тогда ВызватьИсключение "идентификация_некорректно_ввод"; КонецЕсли;
    Возврат Строка(Ид);
КонецФункции

Функция Хеш(Значение)
    Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
    Хеширование.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Значение, КодировкаТекста.UTF8));
    Возврат СтрЗаменить(СтрЗаменить(Base64Строка(Хеширование.ХешСумма), Символ(13), ""), Символ(10), "");
КонецФункции

Функция РавныХеши(Первый, Второй)
    Если СтрДлина(Первый) <> 44 Или СтрДлина(Второй) <> 44 Тогда Возврат Ложь; КонецЕсли;
    Различия = 0;
    Для Индекс = 1 По 44 Цикл Если Сред(Первый, Индекс, 1) <> Сред(Второй, Индекс, 1) Тогда Различия = Различия + 1; КонецЕсли; КонецЦикла;
    Возврат Различия = 0;
КонецФункции
