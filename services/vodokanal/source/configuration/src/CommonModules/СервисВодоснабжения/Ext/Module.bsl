
Функция СоздатьИсточникВоды(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    Возврат СоздатьНастройкуРаздела(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса, "Source");
КонецФункции

Функция СоздатьПунктВыдачи(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    Возврат СоздатьНастройкуРаздела(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса, "Point");
КонецФункции

Функция СоздатьПолучателяВоды(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    Возврат СоздатьНастройкуРаздела(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса, "Recipient");
КонецФункции

Функция СписокНастроекРаздела(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор) Экспорт
    КонтекстДоступа = НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор);
    Попытка
        Результат = Новый Структура("sources,points,recipients", ПрочитатьИсточникиВоды(КонтекстДоступа), ПрочитатьПунктыВыдачи(КонтекстДоступа), ПрочитатьПолучателейВоды(КонтекстДоступа));
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СписокНастроекСтраница(УчетнаяЗапись, РабочаяОбласть, Область, Вид, Лимит = "", Курсор = "") Экспорт
    Контекст = НачатьОперациюВОбласти(УчетнаяЗапись, РабочаяОбласть, Область);
    Попытка
        Если Вид = "sources" Тогда Имя = "ИсточникиВоды"; Пустая = Справочники.ИсточникиВоды.ПустаяСсылка();
        ИначеЕсли Вид = "points" Тогда Имя = "ПунктыВыдачиВоды"; Пустая = Справочники.ПунктыВыдачиВоды.ПустаяСсылка();
        ИначеЕсли Вид = "recipients" Тогда Имя = "ПолучателиВоды"; Пустая = Справочники.ПолучателиВоды.ПустаяСсылка();
        Иначе ВызватьИсключение "кабинет_вода_некорректно_поле"; КонецЕсли;
        Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 100 * ИЗ Справочник." + Имя + " ГДЕ РабочееПространство = &РабочееПространство И Область = &Область И Состояние = &Состояние И НЕ ПометкаУдаления УПОРЯДОЧИТЬ ПО Ссылка");
        УстановитьКонтекстОбласти(Запрос, Контекст.РабочееПространство, Контекст.Область);
        Запрос.УстановитьПараметр("Состояние", "Active");
        Страница = РеестрАбонентов.ПодготовитьСтраницу(Запрос, Лимит, Курсор, Новый Структура("actor,workspace,area,kind",
            Строка(УчетнаяЗапись.УникальныйИдентификатор()), РабочаяОбласть, Область, Вид), Пустая);
        Выборка = Запрос.Выполнить().Выбрать(); Строки = Новый Массив;
        Пока Выборка.Следующий() Цикл Строки.Добавить(ДанныеНастроекРаздела(Выборка)); КонецЦикла;
        Результат = РеестрАбонентов.ЗавершитьСтраницу(Строки, Страница);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СписокВариантовДоставки(УчетнаяЗапись, РабочаяОбласть, Область, Вид, Лимит = "", Курсор = "") Экспорт
    Контекст = НачатьОперациюВОбласти(УчетнаяЗапись, РабочаяОбласть, Область);
    Попытка
        Если Вид = "resources" Тогда
            Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 100 Ссылка, Наименование ИЗ Справочник.РесурсыНарядов ГДЕ РабочееПространство = &РабочееПространство И Область = &Область И Состояние = &Действует И НЕ ПометкаУдаления УПОРЯДОЧИТЬ ПО Ссылка");
            Пустая = Справочники.РесурсыНарядов.ПустаяСсылка();
        ИначеЕсли Вид = "executors" Тогда
            Запрос = ЗапросИсполнителейДоставки(Контекст);
            Пустая = Справочники.УчетныеЗаписи.ПустаяСсылка();
        Иначе ВызватьИсключение "кабинет_вода_некорректно_поле"; КонецЕсли;
        УстановитьКонтекстОбласти(Запрос, Контекст.РабочееПространство, Контекст.Область);
        Запрос.УстановитьПараметр("Действует", "Active");
        Страница = РеестрАбонентов.ПодготовитьСтраницу(Запрос, Лимит, Курсор, Новый Структура("actor,workspace,area,kind",
            Строка(УчетнаяЗапись.УникальныйИдентификатор()), РабочаяОбласть, Область, Вид), Пустая);
        Выборка = Запрос.Выполнить().Выбрать(); Строки = Новый Массив;
        Пока Выборка.Следующий() Цикл Строки.Добавить(Новый Структура("id,name", Строка(Выборка.Ссылка.УникальныйИдентификатор()), Выборка.Наименование)); КонецЦикла;
        Результат = РеестрАбонентов.ЗавершитьСтраницу(Строки, Страница); ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ЗапросИсполнителейДоставки(Контекст, Исполнитель = Неопределено)
    Если Не ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_вода_транзакция_требуется"; КонецЕсли;
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 100 Ссылка, Наименование ИЗ Справочник.УчетныеЗаписи
        |ГДЕ НЕ ПометкаУдаления И Состояние = &Действует И Ссылка В
        |(ВЫБРАТЬ Участие.УчетнаяЗапись ИЗ Справочник.Участия КАК Участие
        |ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПривязкиПользователей1С КАК Привязка
        |ПО Привязка.УчетнаяЗапись = Участие.УчетнаяЗапись
        |И Привязка.ИдентификаторПользователя1С = Участие.УчетнаяЗапись.ИдентификаторПользователя1С
        |ГДЕ Участие.РабочееПространство = &РабочееПространство И Участие.Роль = &Роль
        |И Участие.Состояние = &Действует И НЕ Участие.ПометкаУдаления
        |И (Участие.СрокИстечения = &НетДаты ИЛИ Участие.СрокИстечения > &Сейчас)
        |И ((Участие.ОхватОбластей = &Все И Участие.Область = &ПустаяОбласть)
        |ИЛИ (Участие.ОхватОбластей = &Точная И Участие.Область = &Область)))
        |И (&ВсеИсполнители ИЛИ Ссылка = &Исполнитель)
        |УПОРЯДОЧИТЬ ПО Ссылка");
    УстановитьКонтекстОбласти(Запрос, Контекст.РабочееПространство, Контекст.Область);
    Запрос.УстановитьПараметр("Действует", "Active"); Запрос.УстановитьПараметр("Роль", "CrewMember");
    Запрос.УстановитьПараметр("НетДаты", Дата(1, 1, 1)); Запрос.УстановитьПараметр("Сейчас", ТекущаяУниверсальнаяДата());
    Запрос.УстановитьПараметр("Все", "All"); Запрос.УстановитьПараметр("Точная", "Area");
    Запрос.УстановитьПараметр("ПустаяОбласть", Справочники.Области.ПустаяСсылка());
    Запрос.УстановитьПараметр("ВсеИсполнители", Исполнитель = Неопределено);
    Запрос.УстановитьПараметр("Исполнитель", ?(Исполнитель = Неопределено, Справочники.УчетныеЗаписи.ПустаяСсылка(), Исполнитель));
    Возврат Запрос;
КонецФункции

Процедура ПроверитьНазначаемогоИсполнителя(Исполнитель, Контекст)
    Если ТипЗнч(Исполнитель) <> Тип("СправочникСсылка.УчетныеЗаписи") Или Не ЗначениеЗаполнено(Исполнитель) Тогда
        ВызватьИсключение "кабинет_вода_доставка_запрещено";
    КонецЕсли;
    ЗаблокироватьОбъектПоСсылке("Справочник.УчетныеЗаписи", Исполнитель);
    Запрос = ЗапросИсполнителейДоставки(Контекст, Исполнитель);
    Если Запрос.Выполнить().Пустой() Тогда ВызватьИсключение "кабинет_вода_доставка_запрещено"; КонецЕсли;
КонецПроцедуры

Функция СоздатьДоставку(УчетнаяЗапись, Тело, Команда) Экспорт
    ПроверитьПоляТелаЗапроса(Тело, "workspaceId,areaId,orderId,resourceId,executorAccountId,address,startAt,endAt");
    РабочаяОбласть = ТекстовоеПоле(Тело, "workspaceId", 36);
    Область = ТекстовоеПоле(Тело, "areaId", 36);
    ЗаказСсылка = Справочники.ЗаказыВоды.ПолучитьСсылку(РазобратьИдентификатор(ТекстовоеПоле(Тело, "orderId", 36)));
    РесурсСсылка = Справочники.РесурсыНарядов.ПолучитьСсылку(РазобратьИдентификатор(ТекстовоеПоле(Тело, "resourceId", 36)));
    Исполнитель = Справочники.УчетныеЗаписи.ПолучитьСсылку(РазобратьИдентификатор(ТекстовоеПоле(Тело, "executorAccountId", 36)));
    Адрес = ТекстовоеПоле(Тело, "address", 250);
    Начало = ПолеДатыUTC(Тело, "startAt"); Конец = ПолеДатыUTC(Тело, "endAt");
    Если Начало >= Конец Или Конец - Начало > 86400 Тогда ВызватьИсключение "кабинет_вода_некорректно_даты"; КонецЕсли;
    Контекст = НачатьОперациюВОбласти(УчетнаяЗапись, РабочаяОбласть, Область);
    Попытка
        ЗаблокироватьОбъектПоСсылке("Справочник.РесурсыНарядов", РесурсСсылка);
        ЗаблокироватьОбъектПоСсылке("Справочник.ЗаказыВоды", ЗаказСсылка);
        Заказ = ЗаказСсылка.ПолучитьОбъект();
        Если Заказ = Неопределено Тогда ВызватьИсключение "кабинет_вода_не_найдено"; КонецЕсли;
        Если Заказ.ПометкаУдаления Или Заказ.РабочееПространство <> Контекст.РабочееПространство Или Заказ.Область <> Контекст.Область Тогда ВызватьИсключение "кабинет_вода_не_найдено"; КонецЕсли;
        Намерение = КаноническоеПредставление(Тело);
        Привязка = ОткрытьПривязкуЗапроса(УчетнаяЗапись, Команда, "delivery.create", Намерение);
        Если Привязка.Выбран() Тогда
            Доставка = Справочники.ДоставкиВоды.ПолучитьСсылку(РазобратьИдентификатор(Привязка.ИдентификаторРезультата)).ПолучитьОбъект();
            Если Доставка = Неопределено Тогда ВызватьИсключение "кабинет_вода_привязка_конфликт"; КонецЕсли;
            Если Доставка.ЗаказВоды <> ЗаказСсылка Или Доставка.РабочееПространство <> Контекст.РабочееПространство Или Доставка.Область <> Контекст.Область Тогда ВызватьИсключение "кабинет_вода_привязка_конфликт"; КонецЕсли;
        Иначе
            Если Начало < ТекущаяУниверсальнаяДата() - 300 Или Конец > ТекущаяУниверсальнаяДата() + 7776000 Тогда
                ВызватьИсключение "кабинет_вода_некорректно_даты";
            КонецЕсли;
            Если Заказ.Состояние <> "Confirmed" И Заказ.Состояние <> "Issued" Тогда ВызватьИсключение "кабинет_вода_заказ_состояние_конфликт"; КонецЕсли;
            Ресурс = РесурсСсылка.ПолучитьОбъект();
            Если Ресурс = Неопределено Тогда ВызватьИсключение "кабинет_вода_не_найдено"; КонецЕсли;
            Если Ресурс.ПометкаУдаления Или Ресурс.Состояние <> "Active" Или Ресурс.РабочееПространство <> Контекст.РабочееПространство Или Ресурс.Область <> Контекст.Область Тогда ВызватьИсключение "кабинет_вода_связь_конфликт"; КонецЕсли;
            ПроверитьНазначаемогоИсполнителя(Исполнитель, Контекст);
            Проверка = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ДоставкиВоды ГДЕ ЗаказВоды = &Заказ И Состояние <> &Отменена");
            Проверка.УстановитьПараметр("Заказ", ЗаказСсылка); Проверка.УстановитьПараметр("Отменена", "Cancelled");
            Если Не Проверка.Выполнить().Пустой() Тогда ВызватьИсключение "кабинет_вода_доставка_конфликт"; КонецЕсли;
            СервисНарядов.ПроверитьВместимостьДляДоставки(Ресурс, Начало, Конец);
            Доставка = Справочники.ДоставкиВоды.СоздатьЭлемент();
            Доставка.SetNewObjectRef(Справочники.ДоставкиВоды.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
            ЗаполнитьСлужебныеОтметки(Доставка, УчетнаяЗапись, Контекст.РабочееПространство, Контекст.Область);
            Доставка.Наименование = "Water delivery";
            Доставка.ЗаказВоды = ЗаказСсылка; Доставка.Ресурс = РесурсСсылка; Доставка.Исполнитель = Исполнитель;
            Доставка.Адрес = Адрес; Доставка.НачалоИнтервала = Начало; Доставка.КонецИнтервала = Конец;
            Доставка.Состояние = "Planned";
            Доставка.Записать();
            Привязка.СнимокРезультатаJSON = КаноническоеПредставление(ДанныеДоставки(Доставка));
            ПривязатьКомандуЗапроса(Привязка, "Delivery", Доставка.Ссылка);
            ПолитикаДоступа.ЗаписатьСобытиеАудита(УчетнаяЗапись, Контекст.РабочееПространство, "water.delivery.create", Строка(Доставка.Ссылка.УникальныйИдентификатор()));
            СервисУведомлений.СоздатьСобытие(Исполнитель, "assignment", "water.delivery." + Строка(Доставка.Ссылка.УникальныйИдентификатор()) + ".1", Строка(Доставка.Ссылка.УникальныйИдентификатор()), "Planned", Контекст.РабочееПространство);
        КонецЕсли;
        Результат = СнимокДоставки(Привязка, Доставка);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СобытияЗанятостиДоставки(Ресурс, Начало, Конец, ИсключениеДоставки = Неопределено) Экспорт
    Если Не ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_вода_вложенная_транзакция"; КонецЕсли;
    Если ИсключениеДоставки = Неопределено Тогда ИсключениеДоставки = Справочники.ДоставкиВоды.ПустаяСсылка(); КонецЕсли;
    Запрос = Новый Запрос(
        "ВЫБРАТЬ НачалоИнтервала КАК ДатаНачала, КонецИнтервала КАК ДатаОкончания
        |ИЗ Справочник.ДоставкиВоды ГДЕ Ресурс = &Ресурс И Ссылка <> &Исключение
        |И Состояние В (&Состояния) И НачалоИнтервала < &Конец И КонецИнтервала > &Начало");
    Запрос.УстановитьПараметр("Ресурс", Ресурс); Запрос.УстановитьПараметр("Исключение", ИсключениеДоставки);
    Запрос.УстановитьПараметр("Состояния", СтрРазделить("Planned,InProgress", ","));
    Запрос.УстановитьПараметр("Начало", Начало); Запрос.УстановитьПараметр("Конец", Конец);
    Выборка = Запрос.Выполнить().Выбрать();
    Результат = Новый Массив;
    Пока Выборка.Следующий() Цикл Результат.Добавить(Новый Структура("ДатаНачала,ДатаОкончания,Объем", Выборка.ДатаНачала, Выборка.ДатаОкончания, 1)); КонецЦикла;
    Возврат Результат;
КонецФункции

Функция СписокДоставок(УчетнаяЗапись, РабочаяОбласть, Область, ТолькоМои = Ложь, Лимит = "", Курсор = "") Экспорт
    Если ТолькоМои Тогда
        Контекст = НачатьОперациюИсполнителяДоставки(УчетнаяЗапись, РабочаяОбласть, Область);
    Иначе
        Контекст = НачатьОперациюВОбласти(УчетнаяЗапись, РабочаяОбласть, Область);
    КонецЕсли;
    Попытка
        Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 100 * ИЗ Справочник.ДоставкиВоды ГДЕ РабочееПространство = &РабочееПространство И Область = &Область И НЕ ПометкаУдаления И (&Все ИЛИ Исполнитель = &Исполнитель) УПОРЯДОЧИТЬ ПО Ссылка");
        УстановитьКонтекстОбласти(Запрос, Контекст.РабочееПространство, Контекст.Область);
        Запрос.УстановитьПараметр("Все", Не ТолькоМои); Запрос.УстановитьПараметр("Исполнитель", УчетнаяЗапись);
        Страница = РеестрАбонентов.ПодготовитьСтраницу(Запрос, Лимит, Курсор, Новый Структура("actor,workspace,area,mine,kind",
            Строка(УчетнаяЗапись.УникальныйИдентификатор()), РабочаяОбласть, Область, ТолькоМои, "deliveries"), Справочники.ДоставкиВоды.ПустаяСсылка());
        Выборка = Запрос.Выполнить().Выбрать(); Строки = Новый Массив;
        Пока Выборка.Следующий() Цикл Строки.Добавить(ДанныеДоставки(Выборка)); КонецЦикла;
        Результат = РеестрАбонентов.ЗавершитьСтраницу(Строки, Страница);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция НачатьОперациюИсполнителяДоставки(УчетнаяЗапись, РабочаяОбласть, Область)
    ПроверитьТекущегоУчастника(УчетнаяЗапись);
    Если ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_вода_вложенная_транзакция"; КонецЕсли;
    РП = Справочники.РабочиеПространства.ПолучитьСсылку(РазобратьИдентификатор(РабочаяОбласть));
    О = Справочники.Области.ПолучитьСсылку(РазобратьИдентификатор(Область));
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьОбъектПоСсылке("Справочник.УчетныеЗаписи", УчетнаяЗапись);
        ЗаблокироватьОбъектПоСсылке("Справочник.РабочиеПространства", РП);
        ЗаблокироватьОбъектПоСсылке("Справочник.Области", О);
        ПолитикаДоступа.ПроверитьДоступКОбласти(УчетнаяЗапись, РабочаяОбласть, Область, "CrewMember");
    Исключение
        ОтменитьСобственнуюТранзакцию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Новый Структура("РабочееПространство,Область", РП, О);
КонецФункции

Функция ИзменитьДоставку(УчетнаяЗапись, Идентификатор, Операция, Тело, Команда) Экспорт
    ПроверитьПоляТелаЗапроса(Тело, "expectedRevision,comment");
    Ревизия = ПолеРевизии(Тело); Комментарий = ТекстовоеПоле(Тело, "comment", 2000);
    Если Операция <> "start" И Операция <> "complete" И Операция <> "cancel" Тогда ВызватьИсключение "кабинет_вода_некорректно_операция"; КонецЕсли;
    Ссылка = Справочники.ДоставкиВоды.ПолучитьСсылку(РазобратьИдентификатор(Идентификатор));
    Предварительно = Ссылка.ПолучитьОбъект();
    Если Предварительно = Неопределено Тогда ВызватьИсключение "кабинет_вода_не_найдено"; КонецЕсли;
    РП = Строка(Предварительно.РабочееПространство.УникальныйИдентификатор()); О = Строка(Предварительно.Область.УникальныйИдентификатор());
    Если Операция = "cancel" Тогда Контекст = НачатьОперациюВОбласти(УчетнаяЗапись, РП, О);
    Иначе Контекст = НачатьОперациюИсполнителяДоставки(УчетнаяЗапись, РП, О); КонецЕсли;
    Попытка
        ЗаблокироватьОбъектПоСсылке("Справочник.РесурсыНарядов", Предварительно.Ресурс);
        ЗаблокироватьОбъектПоСсылке("Справочник.ЗаказыВоды", Предварительно.ЗаказВоды);
        ЗаблокироватьОбъектПоСсылке("Справочник.ДоставкиВоды", Ссылка);
        Доставка = Ссылка.ПолучитьОбъект();
        Если Доставка.ПометкаУдаления Или Доставка.Ресурс <> Предварительно.Ресурс Или Доставка.ЗаказВоды <> Предварительно.ЗаказВоды Тогда ВызватьИсключение "кабинет_вода_привязка_конфликт"; КонецЕсли;
        Если Операция <> "cancel" И Доставка.Исполнитель <> УчетнаяЗапись Тогда ВызватьИсключение "кабинет_вода_доставка_запрещено"; КонецЕсли;
        Привязка = ОткрытьПривязкуЗапроса(УчетнаяЗапись, Команда, "delivery." + Операция, КаноническоеПредставление(Новый Структура("id,body", Идентификатор, Тело)));
        Если Привязка.Выбран() Тогда
            Если Привязка.ИдентификаторРезультата <> Идентификатор Тогда ВызватьИсключение "кабинет_вода_привязка_конфликт"; КонецЕсли;
        Иначе
            Если Доставка.Ревизия <> Ревизия Или Доставка.Ревизия >= 999999999999999 Тогда ВызватьИсключение "кабинет_вода_редакция_конфликт"; КонецЕсли;
            Заказ = Доставка.ЗаказВоды.ПолучитьОбъект();
            Если Операция = "start" Тогда
                Если Доставка.Состояние <> "Planned" Или (Заказ.Состояние <> "Confirmed" И Заказ.Состояние <> "Issued") Тогда ВызватьИсключение "кабинет_вода_доставка_состояние_конфликт"; КонецЕсли;
                Ресурс = Доставка.Ресурс.ПолучитьОбъект();
                Если Ресурс = Неопределено Тогда ВызватьИсключение "кабинет_вода_не_найдено"; КонецЕсли;
                Если Ресурс.ПометкаУдаления Или Ресурс.Состояние <> "Active" Тогда ВызватьИсключение "кабинет_вода_связь_конфликт"; КонецЕсли;
                Если ТекущаяУниверсальнаяДата() < Доставка.НачалоИнтервала - 300 Или ТекущаяУниверсальнаяДата() >= Доставка.КонецИнтервала Тогда
                    ВызватьИсключение "кабинет_вода_некорректно_даты";
                КонецЕсли;
                Доставка.Состояние = "InProgress"; Доставка.ФактическоеНачало = ТекущаяУниверсальнаяДата();
            ИначеЕсли Операция = "complete" Тогда
                Если Доставка.Состояние <> "InProgress" Или Заказ.Состояние <> "Issued" Тогда ВызватьИсключение "кабинет_вода_доставка_состояние_конфликт"; КонецЕсли;
                Доставка.Состояние = "Done"; Доставка.ФактическоеОкончание = ТекущаяУниверсальнаяДата();
            Иначе
                Если Доставка.Состояние <> "Planned" Тогда ВызватьИсключение "кабинет_вода_доставка_состояние_конфликт"; КонецЕсли;
                Доставка.Состояние = "Cancelled";
            КонецЕсли;
            Доставка.Комментарий = Комментарий; Доставка.Ревизия = Доставка.Ревизия + 1;
            Доставка.ДатаОбновления = ТекущаяУниверсальнаяДата(); Доставка.Записать();
            Привязка.СнимокРезультатаJSON = КаноническоеПредставление(ДанныеДоставки(Доставка));
            ПривязатьКомандуЗапроса(Привязка, "Delivery", Ссылка);
            ПолитикаДоступа.ЗаписатьСобытиеАудита(УчетнаяЗапись, Контекст.РабочееПространство, "water.delivery." + Операция, Идентификатор);
            СервисУведомлений.СоздатьСобытие(Доставка.КемСоздано, "assignment", "water.delivery." + Идентификатор + "." + Формат(Доставка.Ревизия, "ЧГ=0"), Идентификатор, Доставка.Состояние, Контекст.РабочееПространство);
        КонецЕсли;
        Результат = СнимокДоставки(Привязка, Доставка); ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СнимокДоставки(Привязка, Доставка)
    Чтение = Новый ЧтениеJSON; Чтение.УстановитьСтроку(Привязка.СнимокРезультатаJSON);
    Снимок = ПрочитатьJSON(Чтение); Чтение.Закрыть();
    Если ТипЗнч(Снимок) <> Тип("Структура") Тогда ВызватьИсключение "кабинет_вода_привязка_конфликт"; КонецЕсли;
    Если Снимок.id <> Строка(Доставка.Ссылка.УникальныйИдентификатор()) Или Снимок.workspaceId <> Строка(Доставка.РабочееПространство.УникальныйИдентификатор())
        Или Снимок.areaId <> Строка(Доставка.Область.УникальныйИдентификатор()) Тогда ВызватьИсключение "кабинет_вода_привязка_конфликт"; КонецЕсли;
    Возврат Снимок;
КонецФункции

Функция ДанныеДоставки(Объект)
    Результат = ОбщиеДанныеОбъекта(Объект);
    Результат.Вставить("orderId", Строка(Объект.ЗаказВоды.УникальныйИдентификатор()));
    Результат.Вставить("pointId", Строка(Объект.ЗаказВоды.Точка.УникальныйИдентификатор()));
    Результат.Вставить("resourceId", Строка(Объект.Ресурс.УникальныйИдентификатор()));
    Результат.Вставить("executorAccountId", Строка(Объект.Исполнитель.УникальныйИдентификатор()));
    Результат.Вставить("address", Объект.Адрес);
    Результат.Вставить("startAt", ДатаDTOUTC(Объект.НачалоИнтервала)); Результат.Вставить("endAt", ДатаDTOUTC(Объект.КонецИнтервала));
    Результат.Вставить("actualStartAt", ?(ЗначениеЗаполнено(Объект.ФактическоеНачало), ДатаDTOUTC(Объект.ФактическоеНачало), ""));
    Результат.Вставить("actualEndAt", ?(ЗначениеЗаполнено(Объект.ФактическоеОкончание), ДатаDTOUTC(Объект.ФактическоеОкончание), ""));
    Результат.Вставить("state", Объект.Состояние); Результат.Вставить("comment", Объект.Комментарий);
    Возврат Результат;
КонецФункции

Функция СоздатьНачальныйЗапасВоды(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    Возврат СоздатьПриходВоды(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса, Истина);
КонецФункции

Функция ОприходоватьВоду(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    Возврат СоздатьПриходВоды(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса, Ложь);
КонецФункции

Функция СоздатьЗаказ(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, "workspaceId,areaId,pointId,recipientId,quantity,scheduledAt");
    РабочаяОбластьИдентификатор = ТекстовоеПоле(ТелоЗапроса, "workspaceId", 36);
    ОбластьИдентификатор = ТекстовоеПоле(ТелоЗапроса, "areaId", 36);
    ТочкаСсылка = Справочники.ПунктыВыдачиВоды.ПолучитьСсылку(РазобратьИдентификатор(ТекстовоеПоле(ТелоЗапроса, "pointId", 36)));
    ПолучательСсылка = Справочники.ПолучателиВоды.ПолучитьСсылку(РазобратьИдентификатор(ТекстовоеПоле(ТелоЗапроса, "recipientId", 36)));
    Объем = ПолеОбъема(ТелоЗапроса, "quantity");
    ПлановаяДата = ПолеДатыUTC(ТелоЗапроса, "scheduledAt");
    Намерение = КаноническоеПредставление(Новый Структура("operation,workspaceId,areaId,pointId,recipientId,quantity,scheduledAt",
        "order.create", Строка(РазобратьИдентификатор(РабочаяОбластьИдентификатор)), Строка(РазобратьИдентификатор(ОбластьИдентификатор)), Строка(ТочкаСсылка.УникальныйИдентификатор()), Строка(ПолучательСсылка.УникальныйИдентификатор()), Объем, XMLСтрока(ПлановаяДата)));
    КонтекстДоступа = НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор);
    Попытка
        ЗаблокироватьЯчейкуЗапасов(КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область, ТочкаСсылка);
        ПроверитьПунктВыдачи(ТочкаСсылка, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
        ПроверитьПолучателяВоды(ПолучательСсылка, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
        Привязка = ОткрытьПривязкуЗапроса(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, "order.create", Намерение);
        Если Привязка.Выбран() Тогда
            Результат = ДанныеСохраненногоПовтора(Привязка, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
            ЗафиксироватьТранзакцию();
            Возврат Результат;
        КонецЕсли;
        Если ПлановаяДата > ТекущаяУниверсальнаяДата() + 7776000 Тогда
            ВызватьИсключение "кабинет_вода_некорректно_даты";
        КонецЕсли;
        Объект = Справочники.ЗаказыВоды.СоздатьЭлемент();
        Объект.SetNewObjectRef(Справочники.ЗаказыВоды.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
        ЗаполнитьСлужебныеОтметки(Объект, СсылкаУчетнойЗаписи, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
        Объект.Наименование = "Pickup water order";
        Объект.Точка = ТочкаСсылка;
        Объект.Получатель = ПолучательСсылка;
        Объект.Вид = "Potable";
        Объект.Объем = Объем;
        Объект.ВозвращенныйОбъем = 0;
        Объект.ПлановаяДата = ПлановаяДата;
        Объект.Состояние = "Draft";
        Объект.ПоследнееДвижение = Документы.ДвижениеВоды.ПустаяСсылка();
        Объект.Записать();
        ПривязатьКомандуЗапроса(Привязка, "Order", Объект.Ссылка);
        ПолитикаДоступа.ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, КонтекстДоступа.РабочееПространство, "water.order.create", Строка(Объект.Ссылка.УникальныйИдентификатор()));
        Результат = ДанныеЗаказа(Объект);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПодтвердитьЗаказ(СсылкаУчетнойЗаписи, НарядИдентификатор, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    Возврат ИзменитьЗаказ(СсылкаУчетнойЗаписи, НарядИдентификатор, ТелоЗапроса, ИдентификаторЗапроса, "Reserve");
КонецФункции

Функция ВыдатьВодуПоЗаказу(СсылкаУчетнойЗаписи, НарядИдентификатор, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    Возврат ИзменитьЗаказ(СсылкаУчетнойЗаписи, НарядИдентификатор, ТелоЗапроса, ИдентификаторЗапроса, "Issue");
КонецФункции

Функция ОтменитьЗаказ(СсылкаУчетнойЗаписи, НарядИдентификатор, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    Возврат ИзменитьЗаказ(СсылкаУчетнойЗаписи, НарядИдентификатор, ТелоЗапроса, ИдентификаторЗапроса, "Cancel");
КонецФункции

Функция ОформитьВозвратПоЗаказу(СсылкаУчетнойЗаписи, НарядИдентификатор, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    Возврат ИзменитьЗаказ(СсылкаУчетнойЗаписи, НарядИдентификатор, ТелоЗапроса, ИдентификаторЗапроса, "Return");
КонецФункции

Функция СписокЗаказов(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, Лимит = Неопределено, Курсор = "") Экспорт
    КонтекстДоступа = НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор);
    Попытка
        Запрос = Новый Запрос(
            "ВЫБРАТЬ ПЕРВЫЕ 100 Ссылка, РабочееПространство, Область, Точка, Получатель, Вид, Объем, ВозвращенныйОбъем,
            |ПлановаяДата, Состояние, ПоследнееДвижение, КемСоздано, ДатаСоздания, ДатаОбновления, Ревизия
            |ИЗ Справочник.ЗаказыВоды ГДЕ РабочееПространство = &РабочееПространство И Область = &Область И НЕ ПометкаУдаления
            |И Точка.РабочееПространство = РабочееПространство И Точка.Область = Область И НЕ Точка.ПометкаУдаления
            |И Получатель.РабочееПространство = РабочееПространство И Получатель.Область = Область И НЕ Получатель.ПометкаУдаления
            |УПОРЯДОЧИТЬ ПО ДатаСоздания, Ссылка");
        УстановитьКонтекстОбласти(Запрос, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
        Страница = РеестрАбонентов.ПодготовитьСтраницу(Запрос, Лимит, Курсор, Новый Структура("actor,workspace,area,kind", Строка(СсылкаУчетнойЗаписи.УникальныйИдентификатор()), РабочаяОбластьИдентификатор, ОбластьИдентификатор, "water-orders"), Справочники.ЗаказыВоды.ПустаяСсылка());
        Выборка = Запрос.Выполнить().Выбрать();
        Результат = Новый Массив;
        Пока Выборка.Следующий() Цикл
            Результат.Добавить(ДанныеЗаказа(Выборка));
        КонецЦикла;
        Результат = РеестрАбонентов.ЗавершитьСтраницу(Результат, Страница);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПолучитьЗаказ(СсылкаУчетнойЗаписи, Идентификатор) Экспорт
    ПредварительныйСнимок = ПредставлениеЗаказа(Справочники.ЗаказыВоды.ПолучитьСсылку(РазобратьИдентификатор(Идентификатор)));
    КонтекстДоступа = НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, Строка(ПредварительныйСнимок.РабочееПространство.УникальныйИдентификатор()), Строка(ПредварительныйСнимок.Область.УникальныйИдентификатор()));
    Попытка
        ЗаблокироватьЯчейкуЗапасов(КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область, ПредварительныйСнимок.Точка);
        Объект = ПолучитьЗаблокированныйЗаказ(ПредварительныйСнимок.Ссылка, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область, ПредварительныйСнимок.Точка);
        Результат = ДанныеЗаказа(Объект);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПолучитьОстатки(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, ТочкаИдентификатор) Экспорт
    ТочкаСсылка = Справочники.ПунктыВыдачиВоды.ПолучитьСсылку(РазобратьИдентификатор(ТочкаИдентификатор));
    КонтекстДоступа = НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор);
    Попытка
        ЗаблокироватьЯчейкуЗапасов(КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область, ТочкаСсылка);
        ПроверитьПунктВыдачи(ТочкаСсылка, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
        Результат = ДанныеОстатков(КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область, ТочкаСсылка, ПрочитатьОстатки(КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область, ТочкаСсылка));
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СписокДвижений(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, ТочкаИдентификатор, Лимит = Неопределено, Курсор = "") Экспорт
    ТочкаСсылка = Справочники.ПунктыВыдачиВоды.ПолучитьСсылку(РазобратьИдентификатор(ТочкаИдентификатор));
    КонтекстДоступа = НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор);
    Попытка
        ЗаблокироватьЯчейкуЗапасов(КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область, ТочкаСсылка);
        ПроверитьПунктВыдачи(ТочкаСсылка, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
        Запрос = Новый Запрос(
            "ВЫБРАТЬ ПЕРВЫЕ 1000 Ссылка, РабочееПространство, Область, Точка, Вид, Операция, Источник, Получатель,
            |ЗаказВоды, Объем, ФактическаяДата, Основание, ОжидаемаяРевизия, СостояниеЗаказаВРезультате,
            |РевизияЗаказаВРезультате, ВозвращенныйОбъемВРезультате, ИзменениеЗапаса, ИзменениеРезерва, КемСоздано, ДатаСоздания, ДатаОбновления, Ревизия
            |ИЗ Документ.ДвижениеВоды ГДЕ РабочееПространство = &РабочееПространство И Область = &Область
            |И Точка = &Точка И Вид = &Вид И Проведен И НЕ ПометкаУдаления
            |УПОРЯДОЧИТЬ ПО ДатаСоздания, Ссылка");
        УстановитьКонтекстОбласти(Запрос, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
        Запрос.УстановитьПараметр("Точка", ТочкаСсылка);
        Запрос.УстановитьПараметр("Вид", "Potable");
        Страница = РеестрАбонентов.ПодготовитьСтраницу(Запрос, Лимит, Курсор, Новый Структура("actor,workspace,area,point,kind", Строка(СсылкаУчетнойЗаписи.УникальныйИдентификатор()), РабочаяОбластьИдентификатор, ОбластьИдентификатор, ТочкаИдентификатор, "water-movements"), Документы.ДвижениеВоды.ПустаяСсылка());
        Выборка = Запрос.Выполнить().Выбрать();
        Результат = Новый Массив;
        Пока Выборка.Следующий() Цикл
            Результат.Добавить(ДанныеДвижения(Выборка));
        КонецЦикла;
        Результат = РеестрАбонентов.ЗавершитьСтраницу(Результат, Страница);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Процедура ПровестиДвижениеВоды(Документ) Экспорт
    Если Не ТранзакцияАктивна() Или ТипЗнч(Документ) <> Тип("ДокументОбъект.ДвижениеВоды") Тогда
        ВызватьИсключение "кабинет_вода_проведение_контекст_требуется";
    КонецЕсли;
    ДействующееЛицо = ПолитикаДоступа.ПроверитьУчетнуюЗапись();
    ПроверитьТекущегоУчастника(Документ.КемСоздано);
    ЗаблокироватьОбластьДоступа(ДействующееЛицо.Ссылка, Документ.РабочееПространство, Документ.Область);
    Если Документ.Вид <> "Potable" Или Документ.Ревизия <> 1 Или Документ.ДатаСоздания <> Документ.Дата
        Или Документ.ДатаОбновления <> Документ.ДатаСоздания Или Документ.Дата > ТекущаяУниверсальнаяДата() Тогда
        ВызватьИсключение "кабинет_вода_некорректно_движение";
    КонецЕсли;
    ПроверитьОбъем(Документ.Объем);
    ПроверитьДатуОперации(Документ.ФактическаяДата);
    ЭтоПриход = Документ.Операция = "Seed" Или Документ.Операция = "Receipt";
    Если ЭтоПриход Тогда
        ЗаблокироватьКвоту(Документ.РабочееПространство);
    КонецЕсли;
    ЗаблокироватьЯчейкуЗапасов(Документ.РабочееПространство, Документ.Область, Документ.Точка);
    ПроверитьПунктВыдачи(Документ.Точка, Документ.РабочееПространство, Документ.Область);
    Привязка = ОткрытьПривязкуЗапроса(ДействующееЛицо.Ссылка, Документ.ИдентификаторЗапроса, ОперацияКомандыЗапроса(Документ.Операция), ОписаниеНамеренияДвижения(Документ));
    Если Привязка.Выбран() Тогда
        ВызватьИсключение "кабинет_вода_запрос_конфликт";
    КонецЕсли;
    Перед = ПрочитатьОстатки(Документ.РабочееПространство, Документ.Область, Документ.Точка);
    ЗапасЭффект = 0;
    РезервЭффект = 0;
    Если ЭтоПриход Тогда
        Если ЗначениеЗаполнено(Документ.ЗаказВоды) Или ЗначениеЗаполнено(Документ.Получатель) Или Документ.ОжидаемаяРевизия <> 0
            Или Документ.СостояниеЗаказаВРезультате <> "" Или Документ.РевизияЗаказаВРезультате <> 0 Или Документ.ВозвращенныйОбъемВРезультате <> 0 Тогда
            ВызватьИсключение "кабинет_вода_некорректно_движение";
        КонецЕсли;
        ПроверитьИсточникВоды(Документ.Источник, Документ.РабочееПространство, Документ.Область);
        ПроверитьДатуОперации(Документ.ФактическаяДата);
        ПроверенныйТекст(Документ.Основание, 2000);
        Квота = ПрочитатьКвоту(Документ.РабочееПространство);
        Если Документ.Операция = "Seed" Тогда
            Если Квота.НачальноеПополнениеВыполнено Или Документ.Объем <> 10 Тогда
                ВызватьИсключение "кабинет_вода_начальные_данные_конфликт";
            КонецЕсли;
            Квота.НачальноеПополнениеВыполнено = Истина;
        КонецЕсли;
        Если Квота.ВсегоПополнено + Документ.Объем > 1000 Тогда
            ВызватьИсключение "кабинет_вода_пополнение_квота";
        КонецЕсли;
        Квота.ВсегоПополнено = Квота.ВсегоПополнено + Документ.Объем;
        Квота.Записать();
        ЗапасЭффект = 1;
    Иначе
        Если ЗначениеЗаполнено(Документ.Источник) Тогда
            ВызватьИсключение "кабинет_вода_некорректно_движение";
        КонецЕсли;
        Наряд = ПолучитьЗаблокированныйЗаказ(Документ.ЗаказВоды, Документ.РабочееПространство, Документ.Область, Документ.Точка);
        ПроверитьПолучателяВоды(Наряд.Получатель, Документ.РабочееПространство, Документ.Область);
        Если Документ.Получатель <> Наряд.Получатель Тогда
            ВызватьИсключение "кабинет_вода_связь_конфликт";
        КонецЕсли;
        ПроверитьНомерРевизии(Документ.ОжидаемаяРевизия);
        Если Наряд.Ревизия <> Документ.ОжидаемаяРевизия Или Наряд.Ревизия >= 999999999999999 Тогда
            ВызватьИсключение "кабинет_вода_редакция_конфликт";
        КонецЕсли;
        ЗарезервированныйДляНаряд = ПрочитатьРезервЗаказа(Наряд);
        НовыйСостояние = Наряд.Состояние;
        Возвращенный = Наряд.ВозвращенныйОбъем;
        Если Документ.Операция = "Reserve" Тогда
            Если Наряд.Состояние <> "Draft" Или ЗарезервированныйДляНаряд <> 0 Или Документ.Объем <> Наряд.Объем Тогда
                ВызватьИсключение "кабинет_вода_заказ_состояние_конфликт";
            КонецЕсли;
            Если Перед.available < Документ.Объем Тогда
                ВызватьИсключение "кабинет_вода_недостаточно_доступно";
            КонецЕсли;
            РезервЭффект = 1;
            НовыйСостояние = "Confirmed";
        ИначеЕсли Документ.Операция = "Issue" Тогда
            Если Наряд.Состояние <> "Confirmed" Или ЗарезервированныйДляНаряд <> Наряд.Объем Или Документ.Объем <> Наряд.Объем Тогда
                ВызватьИсключение "кабинет_вода_заказ_состояние_конфликт";
            КонецЕсли;
            Если Перед.stock < Документ.Объем Или Перед.reserved < Документ.Объем Тогда
                ВызватьИсключение "кабинет_вода_привязка_конфликт";
            КонецЕсли;
            ЗапасЭффект = -1;
            РезервЭффект = -1;
            НовыйСостояние = "Issued";
        ИначеЕсли Документ.Операция = "Cancel" Тогда
            Доставки = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ДоставкиВоды ГДЕ ЗаказВоды = &Заказ И Состояние В (&Состояния)");
            Доставки.УстановитьПараметр("Заказ", Наряд.Ссылка);
            Доставки.УстановитьПараметр("Состояния", СтрРазделить("Planned,InProgress", ","));
            Если Не Доставки.Выполнить().Пустой() Тогда ВызватьИсключение "кабинет_вода_доставка_конфликт"; КонецЕсли;
            Если (Наряд.Состояние <> "Draft" И Наряд.Состояние <> "Confirmed") Или Документ.Объем <> Наряд.Объем Тогда
                ВызватьИсключение "кабинет_вода_заказ_состояние_конфликт";
            КонецЕсли;
            Если Наряд.Состояние = "Confirmed" Тогда
                Если ЗарезервированныйДляНаряд <> Наряд.Объем Тогда
                    ВызватьИсключение "кабинет_вода_привязка_конфликт";
                КонецЕсли;
                РезервЭффект = -1;
            ИначеЕсли ЗарезервированныйДляНаряд <> 0 Тогда
                ВызватьИсключение "кабинет_вода_привязка_конфликт";
            КонецЕсли;
            НовыйСостояние = "Cancelled";
        ИначеЕсли Документ.Операция = "Return" Тогда
            Если (Наряд.Состояние <> "Issued" И Наряд.Состояние <> "PartiallyReturned") Или ЗарезервированныйДляНаряд <> 0 Тогда
                ВызватьИсключение "кабинет_вода_заказ_состояние_конфликт";
            КонецЕсли;
            Если Документ.Объем > Наряд.Объем - Наряд.ВозвращенныйОбъем Тогда
                ВызватьИсключение "кабинет_вода_возврат_превышает_выдано";
            КонецЕсли;
            ПроверенныйТекст(Документ.Основание, 2000);
            Возвращенный = Возвращенный + Документ.Объем;
            НовыйСостояние = "PartiallyReturned";
            Если Возвращенный = Наряд.Объем Тогда
                НовыйСостояние = "Returned";
            КонецЕсли;
            ЗапасЭффект = 1;
        Иначе
            ВызватьИсключение "кабинет_вода_некорректно_операция";
        КонецЕсли;
        Если Документ.СостояниеЗаказаВРезультате <> НовыйСостояние Или Документ.РевизияЗаказаВРезультате <> Наряд.Ревизия + 1
            Или Документ.ВозвращенныйОбъемВРезультате <> Возвращенный Тогда
            ВызватьИсключение "кабинет_вода_некорректно_движение";
        КонецЕсли;
        Наряд.Состояние = НовыйСостояние;
        Наряд.ВозвращенныйОбъем = Возвращенный;
        Наряд.Ревизия = Наряд.Ревизия + 1;
        Наряд.ДатаОбновления = Документ.Дата;
        Наряд.ПоследнееДвижение = Документ.Ссылка;
        Наряд.Записать();
    КонецЕсли;
    Если Документ.ИзменениеЗапаса <> ЗапасЭффект * Документ.Объем Или Документ.ИзменениеРезерва <> РезервЭффект * Документ.Объем Тогда
        ВызватьИсключение "кабинет_вода_некорректно_движение";
    КонецЕсли;
    ЗаписатьЗапасВоды(Документ, ЗапасЭффект);
    ЗаписатьРезервВоды(Документ, РезервЭффект);
    После = ПрочитатьОстатки(Документ.РабочееПространство, Документ.Область, Документ.Точка);
    Если После.stock <> Перед.stock + ЗапасЭффект * Документ.Объем
        Или После.reserved <> Перед.reserved + РезервЭффект * Документ.Объем Тогда
        ВызватьИсключение "кабинет_вода_привязка_конфликт";
    КонецЕсли;
    ПривязатьКомандуЗапроса(Привязка, "Movement", Документ.Ссылка);
    ПолитикаДоступа.ЗаписатьСобытиеАудита(ДействующееЛицо.Ссылка, Документ.РабочееПространство, "water." + НРег(Документ.Операция), Строка(Документ.Ссылка.УникальныйИдентификатор()));
КонецПроцедуры

Функция СоздатьНастройкуРаздела(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса, НастройкаСправочниковВид)
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, "workspaceId,areaId,name");
    РабочаяОбластьИдентификатор = ТекстовоеПоле(ТелоЗапроса, "workspaceId", 36);
    ОбластьИдентификатор = ТекстовоеПоле(ТелоЗапроса, "areaId", 36);
    Имя = ТекстовоеПоле(ТелоЗапроса, "name", 150);
    Операция = "setup." + НРег(НастройкаСправочниковВид);
    Намерение = КаноническоеПредставление(Новый Структура("operation,workspaceId,areaId,name", Операция,
        Строка(РазобратьИдентификатор(РабочаяОбластьИдентификатор)), Строка(РазобратьИдентификатор(ОбластьИдентификатор)), Имя));
    КонтекстДоступа = НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор);
    Попытка
        Привязка = ОткрытьПривязкуЗапроса(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, Операция, Намерение);
        Если Привязка.Выбран() Тогда
            Результат = ДанныеСохраненногоПовтора(Привязка, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
            ЗафиксироватьТранзакцию();
            Возврат Результат;
        КонецЕсли;
        Если НастройкаСправочниковВид = "Source" Тогда
            Объект = Справочники.ИсточникиВоды.СоздатьЭлемент();
            Объект.SetNewObjectRef(Справочники.ИсточникиВоды.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
        ИначеЕсли НастройкаСправочниковВид = "Point" Тогда
            Объект = Справочники.ПунктыВыдачиВоды.СоздатьЭлемент();
            Объект.SetNewObjectRef(Справочники.ПунктыВыдачиВоды.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
        ИначеЕсли НастройкаСправочниковВид = "Recipient" Тогда
            Объект = Справочники.ПолучателиВоды.СоздатьЭлемент();
            Объект.SetNewObjectRef(Справочники.ПолучателиВоды.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
        Иначе
            ВызватьИсключение "кабинет_вода_некорректно_операция";
        КонецЕсли;
        ЗаполнитьСлужебныеОтметки(Объект, СсылкаУчетнойЗаписи, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
        Объект.Наименование = Имя;
        Объект.Состояние = "Active";
        Объект.Записать();
        ПривязатьКомандуЗапроса(Привязка, НастройкаСправочниковВид, Объект.Ссылка);
        ПолитикаДоступа.ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, КонтекстДоступа.РабочееПространство, "water." + Операция, Строка(Объект.Ссылка.УникальныйИдентификатор()));
        Результат = ДанныеНастроекРаздела(Объект);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СоздатьПриходВоды(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса, НачальноеЗначение)
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    Если НачальноеЗначение Тогда
        ПроверитьПоляТелаЗапроса(ТелоЗапроса, "workspaceId,areaId,sourceId,pointId,occurredAt,basis");
        Объем = 10;
    Иначе
        ПроверитьПоляТелаЗапроса(ТелоЗапроса, "workspaceId,areaId,sourceId,pointId,quantity,occurredAt,basis");
        Объем = ПолеОбъема(ТелоЗапроса, "quantity");
    КонецЕсли;
    РабочаяОбластьИдентификатор = ТекстовоеПоле(ТелоЗапроса, "workspaceId", 36);
    ОбластьИдентификатор = ТекстовоеПоле(ТелоЗапроса, "areaId", 36);
    ИсточникСсылка = Справочники.ИсточникиВоды.ПолучитьСсылку(РазобратьИдентификатор(ТекстовоеПоле(ТелоЗапроса, "sourceId", 36)));
    ТочкаСсылка = Справочники.ПунктыВыдачиВоды.ПолучитьСсылку(РазобратьИдентификатор(ТекстовоеПоле(ТелоЗапроса, "pointId", 36)));
    ФактическаяДата = ПолеДатыUTC(ТелоЗапроса, "occurredAt");
    Основание = ТекстовоеПоле(ТелоЗапроса, "basis", 2000);
    КонтекстДоступа = НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор);
    Попытка
        ЗаблокироватьКвоту(КонтекстДоступа.РабочееПространство);
        ЗаблокироватьЯчейкуЗапасов(КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область, ТочкаСсылка);
        ПроверитьПунктВыдачи(ТочкаСсылка, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
        ПроверитьИсточникВоды(ИсточникСсылка, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
        Объект = СоздатьДвижение(СсылкаУчетнойЗаписи, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область, ТочкаСсылка, ИдентификаторЗапроса);
        Объект.Источник = ИсточникСсылка;
        Объект.Объем = Объем;
        Объект.ИзменениеЗапаса = Объем;
        Объект.ФактическаяДата = ФактическаяДата;
        Объект.Основание = Основание;
        Объект.Операция = "Receipt";
        Если НачальноеЗначение Тогда
            Объект.Операция = "Seed";
        КонецЕсли;
        Привязка = ОткрытьПривязкуЗапроса(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, ОперацияКомандыЗапроса(Объект.Операция), ОписаниеНамеренияДвижения(Объект));
        Если Привязка.Выбран() Тогда
            Результат = ДанныеСохраненногоПовтора(Привязка, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
            ЗафиксироватьТранзакцию();
            Возврат Результат;
        КонецЕсли;
        Объект.Записать(РежимЗаписиДокумента.Проведение);
        Результат = ДанныеДвижения(Объект);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ИзменитьЗаказ(СсылкаУчетнойЗаписи, НарядИдентификатор, ТелоЗапроса, ИдентификаторЗапроса, Операция)
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    Если Операция = "Return" Тогда
        ПроверитьПоляТелаЗапроса(ТелоЗапроса, "expectedRevision,quantity,reason");
        Объем = ПолеОбъема(ТелоЗапроса, "quantity");
        Основание = ТекстовоеПоле(ТелоЗапроса, "reason", 2000);
    Иначе
        ПроверитьПоляТелаЗапроса(ТелоЗапроса, "expectedRevision");
        Объем = 0;
        Основание = "Lifecycle " + Операция;
    КонецЕсли;
    Ревизия = ПолеРевизии(ТелоЗапроса);
    ПредварительныйСнимок = ПредставлениеЗаказа(Справочники.ЗаказыВоды.ПолучитьСсылку(РазобратьИдентификатор(НарядИдентификатор)));
    КонтекстДоступа = НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, Строка(ПредварительныйСнимок.РабочееПространство.УникальныйИдентификатор()), Строка(ПредварительныйСнимок.Область.УникальныйИдентификатор()));
    Попытка
        ЗаблокироватьЯчейкуЗапасов(КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область, ПредварительныйСнимок.Точка);
        Наряд = ПолучитьЗаблокированныйЗаказ(ПредварительныйСнимок.Ссылка, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область, ПредварительныйСнимок.Точка);
        Объект = СоздатьДвижение(СсылкаУчетнойЗаписи, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область, Наряд.Точка, ИдентификаторЗапроса);
        Объект.Операция = Операция;
        Объект.ЗаказВоды = Наряд.Ссылка;
        Объект.Получатель = Наряд.Получатель;
        Объект.ОжидаемаяРевизия = Ревизия;
        Объект.Объем = Объем;
        Если Операция <> "Return" Тогда
            Объект.Объем = Наряд.Объем;
        КонецЕсли;
        Объект.Основание = Основание;
        Объект.ФактическаяДата = ТекущаяУниверсальнаяДата();
        Привязка = ОткрытьПривязкуЗапроса(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, ОперацияКомандыЗапроса(Операция), ОписаниеНамеренияДвижения(Объект));
        Если Привязка.Выбран() Тогда
            Результат = ДанныеСохраненногоПовтора(Привязка, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
            ЗафиксироватьТранзакцию();
            Возврат Результат;
        КонецЕсли;
        Если Ревизия >= 999999999999999 Тогда
            ВызватьИсключение "кабинет_вода_редакция_конфликт";
        КонецЕсли;
        Объект.РевизияЗаказаВРезультате = Ревизия + 1;
        Объект.ВозвращенныйОбъемВРезультате = Наряд.ВозвращенныйОбъем;
        Если Операция = "Reserve" Тогда
            Объект.СостояниеЗаказаВРезультате = "Confirmed";
            Объект.ИзменениеРезерва = Объект.Объем;
        ИначеЕсли Операция = "Issue" Тогда
            Объект.СостояниеЗаказаВРезультате = "Issued";
            Объект.ИзменениеЗапаса = -Объект.Объем;
            Объект.ИзменениеРезерва = -Объект.Объем;
        ИначеЕсли Операция = "Cancel" Тогда
            Объект.СостояниеЗаказаВРезультате = "Cancelled";
            Если Наряд.Состояние = "Confirmed" Тогда
                Объект.ИзменениеРезерва = -Объект.Объем;
            КонецЕсли;
        Иначе
            Объект.ИзменениеЗапаса = Объект.Объем;
            Объект.ВозвращенныйОбъемВРезультате = Наряд.ВозвращенныйОбъем + Объем;
            Объект.СостояниеЗаказаВРезультате = "PartiallyReturned";
            Если Объект.ВозвращенныйОбъемВРезультате = Наряд.Объем Тогда
                Объект.СостояниеЗаказаВРезультате = "Returned";
            КонецЕсли;
        КонецЕсли;
        Объект.Записать(РежимЗаписиДокумента.Проведение);
        Результат = ДанныеДвижения(Объект);
        СервисУведомлений.СоздатьСобытие(Наряд.КемСоздано, "request",
            "water.order." + Строка(Наряд.Ссылка.УникальныйИдентификатор()) + "." + Формат(Объект.РевизияЗаказаВРезультате, "ЧГ=0"),
            Строка(Наряд.Ссылка.УникальныйИдентификатор()), Объект.СостояниеЗаказаВРезультате, КонтекстДоступа.РабочееПространство);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СоздатьДвижение(СсылкаУчетнойЗаписи, СсылкаРабочейОбласти, СсылкаОбласти, ТочкаСсылка, ИдентификаторЗапроса)
    Объект = Документы.ДвижениеВоды.СоздатьДокумент();
    Объект.SetNewObjectRef(Документы.ДвижениеВоды.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
    ЗаполнитьСлужебныеОтметки(Объект, СсылкаУчетнойЗаписи, СсылкаРабочейОбласти, СсылкаОбласти);
    Объект.Дата = Объект.ДатаСоздания;
    Объект.Точка = ТочкаСсылка;
    Объект.Вид = "Potable";
    Объект.ИдентификаторЗапроса = Строка(РазобратьИдентификатор(ИдентификаторЗапроса));
    Объект.ЗаказВоды = Справочники.ЗаказыВоды.ПустаяСсылка();
    Объект.Источник = Справочники.ИсточникиВоды.ПустаяСсылка();
    Объект.Получатель = Справочники.ПолучателиВоды.ПустаяСсылка();
    Объект.ОжидаемаяРевизия = 0;
    Объект.СостояниеЗаказаВРезультате = "";
    Объект.РевизияЗаказаВРезультате = 0;
    Объект.ВозвращенныйОбъемВРезультате = 0;
    Объект.ИзменениеЗапаса = 0;
    Объект.ИзменениеРезерва = 0;
    Возврат Объект;
КонецФункции

Функция ОписаниеНамеренияДвижения(Объект)
    Произошедший = "";
    Если Объект.Операция = "Seed" Или Объект.Операция = "Receipt" Тогда
        Произошедший = XMLСтрока(Объект.ФактическаяДата);
    КонецЕсли;
    Возврат КаноническоеПредставление(Новый Структура("operation,workspaceId,areaId,pointId,kind,sourceId,recipientId,orderId,quantity,occurredAt,basis,expectedRevision",
        ОперацияКомандыЗапроса(Объект.Операция), Строка(Объект.РабочееПространство.УникальныйИдентификатор()), Строка(Объект.Область.УникальныйИдентификатор()), Строка(Объект.Точка.УникальныйИдентификатор()),
        Объект.Вид, НеобязательныйИдентификатор(Объект.Источник), НеобязательныйИдентификатор(Объект.Получатель), НеобязательныйИдентификатор(Объект.ЗаказВоды), Объект.Объем,
        Произошедший, Объект.Основание, Объект.ОжидаемаяРевизия));
КонецФункции

Функция ОперацияКомандыЗапроса(Операция)
    Если СтрРазделить("Seed,Receipt,Reserve,Issue,Cancel,Return", ",").Найти(Операция) = Неопределено Тогда
        ВызватьИсключение "кабинет_вода_некорректно_операция";
    КонецЕсли;
    Возврат "movement." + НРег(Операция);
КонецФункции

Процедура ЗаписатьЗапасВоды(Документ, Эффект)
    Если Эффект = 0 Тогда
        Возврат;
    КонецЕсли;
    Движения = РегистрыНакопления.ЗапасыВоды.СоздатьНаборЗаписей();
    Движения.Отбор.Регистратор.Установить(Документ.Ссылка);
    Движение = Движения.Добавить();
    Движение.Регистратор = Документ.Ссылка;
    Движение.Период = Документ.Дата;
    Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
    Если Эффект = -1 Тогда
        Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
    КонецЕсли;
    Движение.РабочееПространство = Документ.РабочееПространство;
    Движение.Область = Документ.Область;
    Движение.Точка = Документ.Точка;
    Движение.Вид = "Potable";
    Движение.Объем = Документ.Объем;
    Движения.Записать(Истина);
КонецПроцедуры

Процедура ЗаписатьРезервВоды(Документ, Эффект)
    Если Эффект = 0 Тогда
        Возврат;
    КонецЕсли;
    Движения = РегистрыНакопления.РезервыВоды.СоздатьНаборЗаписей();
    Движения.Отбор.Регистратор.Установить(Документ.Ссылка);
    Движение = Движения.Добавить();
    Движение.Регистратор = Документ.Ссылка;
    Движение.Период = Документ.Дата;
    Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
    Если Эффект = -1 Тогда
        Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
    КонецЕсли;
    Движение.РабочееПространство = Документ.РабочееПространство;
    Движение.Область = Документ.Область;
    Движение.Точка = Документ.Точка;
    Движение.Вид = "Potable";
    Движение.ЗаказВоды = Документ.ЗаказВоды;
    Движение.Объем = Документ.Объем;
    Движения.Записать(Истина);
КонецПроцедуры

Функция ПрочитатьОстатки(СсылкаРабочейОбласти, СсылкаОбласти, ТочкаСсылка)
    ЗапасЗапрос = Новый Запрос(
        "ВЫБРАТЬ ЕСТЬNULL(СУММА(ВыборкаБ.ОбъемОстаток), 0) КАК Объем
        |ИЗ РегистрНакопления.ЗапасыВоды.Остатки(, РабочееПространство = &РабочееПространство И Область = &Область И Точка = &Точка И Вид = &Вид) КАК ВыборкаБ");
    РезервЗапрос = Новый Запрос(
        "ВЫБРАТЬ ЕСТЬNULL(СУММА(ВыборкаБ.ОбъемОстаток), 0) КАК Объем
        |ИЗ РегистрНакопления.РезервыВоды.Остатки(, РабочееПространство = &РабочееПространство И Область = &Область И Точка = &Точка И Вид = &Вид) КАК ВыборкаБ");
    УстановитьЯчейкуЗапасов(ЗапасЗапрос, СсылкаРабочейОбласти, СсылкаОбласти, ТочкаСсылка);
    УстановитьЯчейкуЗапасов(РезервЗапрос, СсылкаРабочейОбласти, СсылкаОбласти, ТочкаСсылка);
    ЗапасСтрокиВыборки = ЗапасЗапрос.Выполнить().Выбрать();
    РезервСтрокиВыборки = РезервЗапрос.Выполнить().Выбрать();
    ЗапасСтрокиВыборки.Следующий();
    РезервСтрокиВыборки.Следующий();
    Запас = ЗапасСтрокиВыборки.Объем;
    Зарезервированный = РезервСтрокиВыборки.Объем;
    Если Запас < 0 Или Зарезервированный < 0 Или Зарезервированный > Запас Тогда
        ВызватьИсключение "кабинет_вода_привязка_конфликт";
    КонецЕсли;
    Возврат Новый Структура("stock,reserved,available", Запас, Зарезервированный, Запас - Зарезервированный);
КонецФункции

Функция ПрочитатьРезервЗаказа(Наряд)
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ЕСТЬNULL(СУММА(ВыборкаБ.ОбъемОстаток), 0) КАК Объем
        |ИЗ РегистрНакопления.РезервыВоды.Остатки(, РабочееПространство = &РабочееПространство И Область = &Область
        |И Точка = &Точка И Вид = &Вид И ЗаказВоды = &ЗаказВоды) КАК ВыборкаБ");
    УстановитьЯчейкуЗапасов(Запрос, Наряд.РабочееПространство, Наряд.Область, Наряд.Точка);
    Запрос.УстановитьПараметр("ЗаказВоды", Наряд.Ссылка);
    Выборка = Запрос.Выполнить().Выбрать();
    Выборка.Следующий();
    Если Выборка.Объем < 0 Тогда
        ВызватьИсключение "кабинет_вода_привязка_конфликт";
    КонецЕсли;
    Возврат Выборка.Объем;
КонецФункции

Функция ПрочитатьКвоту(СсылкаРабочейОбласти)
    Объект = РегистрыСведений.КвотыВодоснабженияПространств.СоздатьМенеджерЗаписи();
    Объект.РабочееПространство = СсылкаРабочейОбласти;
    Объект.Прочитать();
    Если Не Объект.Выбран() Тогда
        Объект.РабочееПространство = СсылкаРабочейОбласти;
        Объект.НачальноеПополнениеВыполнено = Ложь;
        Объект.ВсегоПополнено = 0;
    КонецЕсли;
    Если Объект.ВсегоПополнено < 0 Или Объект.ВсегоПополнено > 1000 Или Объект.ВсегоПополнено <> Окр(Объект.ВсегоПополнено, 3) Тогда
        ВызватьИсключение "кабинет_вода_привязка_конфликт";
    КонецЕсли;
    Возврат Объект;
КонецФункции

Функция НачатьОперациюВОбласти(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор)
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    Если ТранзакцияАктивна() Тогда
        ВызватьИсключение "кабинет_вода_вложенная_транзакция";
    КонецЕсли;
    СсылкаРабочейОбласти = Справочники.РабочиеПространства.ПолучитьСсылку(РазобратьИдентификатор(РабочаяОбластьИдентификатор));
    СсылкаОбласти = Справочники.Области.ПолучитьСсылку(РазобратьИдентификатор(ОбластьИдентификатор));
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьОбластьДоступа(СсылкаУчетнойЗаписи, СсылкаРабочейОбласти, СсылкаОбласти);
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Новый Структура("РабочееПространство,Область", СсылкаРабочейОбласти, СсылкаОбласти);
КонецФункции

Процедура ЗаблокироватьОбластьДоступа(СсылкаУчетнойЗаписи, СсылкаРабочейОбласти, СсылкаОбласти)
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ЗаблокироватьОбъектПоСсылке("Справочник.УчетныеЗаписи", СсылкаУчетнойЗаписи);
    ЗаблокироватьОбъектПоСсылке("Справочник.РабочиеПространства", СсылкаРабочейОбласти);
    ЗаблокироватьОбъектПоСсылке("Справочник.Области", СсылкаОбласти);
    ПолитикаДоступа.ПроверитьДоступКОбласти(СсылкаУчетнойЗаписи, Строка(СсылкаРабочейОбласти.УникальныйИдентификатор()), Строка(СсылкаОбласти.УникальныйИдентификатор()), "WaterOperator");
КонецПроцедуры

Процедура ЗаблокироватьЯчейкуЗапасов(СсылкаРабочейОбласти, СсылкаОбласти, ТочкаСсылка)
    Блокировка = Новый БлокировкаДанных;
    ЗапасЗапись = Блокировка.Добавить("РегистрНакопления.ЗапасыВоды");
    ЗапасЗапись.УстановитьЗначение("РабочееПространство", СсылкаРабочейОбласти);
    ЗапасЗапись.УстановитьЗначение("Область", СсылкаОбласти);
    ЗапасЗапись.УстановитьЗначение("Точка", ТочкаСсылка);
    ЗапасЗапись.УстановитьЗначение("Вид", "Potable");
    ЗапасЗапись.Режим = РежимБлокировкиДанных.Исключительный;
    РезервЗапись = Блокировка.Добавить("РегистрНакопления.РезервыВоды");
    РезервЗапись.УстановитьЗначение("РабочееПространство", СсылкаРабочейОбласти);
    РезервЗапись.УстановитьЗначение("Область", СсылкаОбласти);
    РезервЗапись.УстановитьЗначение("Точка", ТочкаСсылка);
    РезервЗапись.УстановитьЗначение("Вид", "Potable");
    РезервЗапись.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
КонецПроцедуры

Процедура ЗаблокироватьКвоту(СсылкаРабочейОбласти)
    Блокировка = Новый БлокировкаДанных;
    БлокировкаЗапись = Блокировка.Добавить("РегистрСведений.КвотыВодоснабженияПространств");
    БлокировкаЗапись.УстановитьЗначение("РабочееПространство", СсылкаРабочейОбласти);
    БлокировкаЗапись.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
КонецПроцедуры

Процедура ЗаблокироватьОбъектПоСсылке(ПространствоИмен, ИдентификаторСсылки)
    Блокировка = Новый БлокировкаДанных;
    БлокировкаЗапись = Блокировка.Добавить(ПространствоИмен);
    БлокировкаЗапись.УстановитьЗначение("Ссылка", ИдентификаторСсылки);
    БлокировкаЗапись.Режим = РежимБлокировкиДанных.Исключительный;
