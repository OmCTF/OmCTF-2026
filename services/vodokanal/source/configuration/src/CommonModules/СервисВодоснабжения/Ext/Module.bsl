КонецПроцедуры

Функция ПредставлениеЗаказа(ИдентификаторСсылки)
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка, РабочееПространство, Область, Точка ИЗ Справочник.ЗаказыВоды ГДЕ Ссылка = &ИдентификаторСсылки И НЕ ПометкаУдаления");
    Запрос.УстановитьПараметр("ИдентификаторСсылки", ИдентификаторСсылки);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Тогда
        ВызватьИсключение "кабинет_вода_не_найдено";
    КонецЕсли;
    Возврат Новый Структура("Ссылка,РабочееПространство,Область,Точка", Выборка.Ссылка, Выборка.РабочееПространство, Выборка.Область, Выборка.Точка);
КонецФункции

Функция ПолучитьЗаблокированныйЗаказ(ИдентификаторСсылки, СсылкаРабочейОбласти, СсылкаОбласти, ТочкаСсылка)
    ЗаблокироватьОбъектПоСсылке("Справочник.ЗаказыВоды", ИдентификаторСсылки);
    Объект = ИдентификаторСсылки.ПолучитьОбъект();
    Если Объект = Неопределено Тогда
        ВызватьИсключение "кабинет_вода_не_найдено";
    КонецЕсли;
    Если Объект.ПометкаУдаления Или Объект.РабочееПространство <> СсылкаРабочейОбласти Или Объект.Область <> СсылкаОбласти Или Объект.Точка <> ТочкаСсылка Или Объект.Вид <> "Potable" Тогда
        ВызватьИсключение "кабинет_вода_не_найдено";
    КонецЕсли;
    ПроверитьОбъем(Объект.Объем);
    ПроверитьНомерРевизии(Объект.Ревизия);
    Если Объект.ВозвращенныйОбъем < 0 Или Объект.ВозвращенныйОбъем > Объект.Объем Или Объект.ВозвращенныйОбъем <> Окр(Объект.ВозвращенныйОбъем, 3) Тогда
        ВызватьИсключение "кабинет_вода_привязка_конфликт";
    КонецЕсли;
    Возврат Объект;
КонецФункции

Процедура ПроверитьПунктВыдачи(ИдентификаторСсылки, СсылкаРабочейОбласти, СсылкаОбласти)
    Объект = ИдентификаторСсылки.ПолучитьОбъект();
    ПроверитьНастройкуРаздела(Объект, СсылкаРабочейОбласти, СсылкаОбласти);
КонецПроцедуры

Процедура ПроверитьИсточникВоды(ИдентификаторСсылки, СсылкаРабочейОбласти, СсылкаОбласти)
    Объект = ИдентификаторСсылки.ПолучитьОбъект();
    ПроверитьНастройкуРаздела(Объект, СсылкаРабочейОбласти, СсылкаОбласти);
КонецПроцедуры

Процедура ПроверитьПолучателяВоды(ИдентификаторСсылки, СсылкаРабочейОбласти, СсылкаОбласти)
    Объект = ИдентификаторСсылки.ПолучитьОбъект();
    ПроверитьНастройкуРаздела(Объект, СсылкаРабочейОбласти, СсылкаОбласти);
КонецПроцедуры

Процедура ПроверитьНастройкуРаздела(Объект, СсылкаРабочейОбласти, СсылкаОбласти)
    Если Объект = Неопределено Тогда
        ВызватьИсключение "кабинет_вода_не_найдено";
    КонецЕсли;
    Если Объект.ПометкаУдаления Или Объект.РабочееПространство <> СсылкаРабочейОбласти Или Объект.Область <> СсылкаОбласти Или Объект.Состояние <> "Active" Тогда
        ВызватьИсключение "кабинет_вода_не_найдено";
    КонецЕсли;
КонецПроцедуры

Функция ПрочитатьИсточникиВоды(КонтекстДоступа)
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 100 Ссылка, РабочееПространство, Область, Наименование, Состояние, КемСоздано, ДатаСоздания, ДатаОбновления, Ревизия ИЗ Справочник.ИсточникиВоды ГДЕ РабочееПространство = &РабочееПространство И Область = &Область И Состояние = &Действующий И НЕ ПометкаУдаления УПОРЯДОЧИТЬ ПО Наименование, Ссылка");
    Возврат ПрочитатьСтрокиНастроек(Запрос, КонтекстДоступа);
КонецФункции

Функция ПрочитатьПунктыВыдачи(КонтекстДоступа)
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 100 Ссылка, РабочееПространство, Область, Наименование, Состояние, КемСоздано, ДатаСоздания, ДатаОбновления, Ревизия ИЗ Справочник.ПунктыВыдачиВоды ГДЕ РабочееПространство = &РабочееПространство И Область = &Область И Состояние = &Действующий И НЕ ПометкаУдаления УПОРЯДОЧИТЬ ПО Наименование, Ссылка");
    Возврат ПрочитатьСтрокиНастроек(Запрос, КонтекстДоступа);
КонецФункции

Функция ПрочитатьПолучателейВоды(КонтекстДоступа)
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 100 Ссылка, РабочееПространство, Область, Наименование, Состояние, КемСоздано, ДатаСоздания, ДатаОбновления, Ревизия ИЗ Справочник.ПолучателиВоды ГДЕ РабочееПространство = &РабочееПространство И Область = &Область И Состояние = &Действующий И НЕ ПометкаУдаления УПОРЯДОЧИТЬ ПО Наименование, Ссылка");
    Возврат ПрочитатьСтрокиНастроек(Запрос, КонтекстДоступа);
КонецФункции

Функция ПрочитатьСтрокиНастроек(Запрос, КонтекстДоступа)
    УстановитьКонтекстОбласти(Запрос, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
    Запрос.УстановитьПараметр("Действующий", "Active");
    Выборка = Запрос.Выполнить().Выбрать();
    Результат = Новый Массив;
    Пока Выборка.Следующий() Цикл
        Результат.Добавить(ДанныеНастроекРаздела(Выборка));
    КонецЦикла;
    Возврат Результат;
КонецФункции

Процедура УстановитьКонтекстОбласти(Запрос, СсылкаРабочейОбласти, СсылкаОбласти)
    Запрос.УстановитьПараметр("РабочееПространство", СсылкаРабочейОбласти);
    Запрос.УстановитьПараметр("Область", СсылкаОбласти);
КонецПроцедуры

Процедура УстановитьЯчейкуЗапасов(Запрос, СсылкаРабочейОбласти, СсылкаОбласти, ТочкаСсылка)
    УстановитьКонтекстОбласти(Запрос, СсылкаРабочейОбласти, СсылкаОбласти);
    Запрос.УстановитьПараметр("Точка", ТочкаСсылка);
    Запрос.УстановитьПараметр("Вид", "Potable");
КонецПроцедуры

Функция ОткрытьПривязкуЗапроса(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, Операция, Намерение)
    ЗапросКлиентаКлюч = Строка(РазобратьИдентификатор(ИдентификаторЗапроса));
    Блокировка = Новый БлокировкаДанных;
    БлокировкаЗапись = Блокировка.Добавить("РегистрСведений.ПривязкиКомандВодоснабжения");
    БлокировкаЗапись.УстановитьЗначение("УчетнаяЗапись", СсылкаУчетнойЗаписи);
    БлокировкаЗапись.УстановитьЗначение("ИдентификаторЗапроса", ЗапросКлиентаКлюч);
    БлокировкаЗапись.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
    Привязка = РегистрыСведений.ПривязкиКомандВодоснабжения.СоздатьМенеджерЗаписи();
    Привязка.УчетнаяЗапись = СсылкаУчетнойЗаписи;
    Привязка.ИдентификаторЗапроса = ЗапросКлиентаКлюч;
    Привязка.Прочитать();
    Если Привязка.Выбран() Тогда
        Если Привязка.Операция <> Операция Или Привязка.Намерение <> Намерение Тогда
            ВызватьИсключение "кабинет_вода_запрос_конфликт";
        КонецЕсли;
    Иначе
        Привязка.УчетнаяЗапись = СсылкаУчетнойЗаписи;
        Привязка.ИдентификаторЗапроса = ЗапросКлиентаКлюч;
        Привязка.Операция = Операция;
        Привязка.Намерение = Намерение;
    КонецЕсли;
    Возврат Привязка;
КонецФункции

Процедура ПривязатьКомандуЗапроса(Привязка, ВидРезультата, ИдентификаторСсылки)
    Привязка.ВидРезультата = ВидРезультата;
    Привязка.ИдентификаторРезультата = Строка(ИдентификаторСсылки.УникальныйИдентификатор());
    Привязка.Записать();
КонецПроцедуры

Функция ДанныеСохраненногоПовтора(Привязка, СсылкаРабочейОбласти, СсылкаОбласти)
    Разобранный = РазобратьИдентификатор(Привязка.ИдентификаторРезультата);
    Если Привязка.ВидРезультата = "Source" И Привязка.Операция = "setup.source" Тогда
        Объект = Справочники.ИсточникиВоды.ПолучитьСсылку(Разобранный).ПолучитьОбъект();
    ИначеЕсли Привязка.ВидРезультата = "Point" И Привязка.Операция = "setup.point" Тогда
        Объект = Справочники.ПунктыВыдачиВоды.ПолучитьСсылку(Разобранный).ПолучитьОбъект();
    ИначеЕсли Привязка.ВидРезультата = "Recipient" И Привязка.Операция = "setup.recipient" Тогда
        Объект = Справочники.ПолучателиВоды.ПолучитьСсылку(Разобранный).ПолучитьОбъект();
    ИначеЕсли Привязка.ВидРезультата = "Order" И Привязка.Операция = "order.create" Тогда
        Объект = Справочники.ЗаказыВоды.ПолучитьСсылку(Разобранный).ПолучитьОбъект();
    ИначеЕсли Привязка.ВидРезультата = "Movement" И Лев(Привязка.Операция, 9) = "movement." Тогда
        Объект = Документы.ДвижениеВоды.ПолучитьСсылку(Разобранный).ПолучитьОбъект();
    Иначе
        ВызватьИсключение "кабинет_вода_привязка_конфликт";
    КонецЕсли;
    Если Объект = Неопределено Тогда
        ВызватьИсключение "кабинет_вода_привязка_конфликт";
    КонецЕсли;
    Если Объект.ПометкаУдаления Или Объект.РабочееПространство <> СсылкаРабочейОбласти Или Объект.Область <> СсылкаОбласти Тогда
        ВызватьИсключение "кабинет_вода_привязка_конфликт";
    КонецЕсли;
    Если Привязка.ВидРезультата = "Movement" Тогда
        Если Не Объект.Проведен Или ОперацияКомандыЗапроса(Объект.Операция) <> Привязка.Операция Или ОписаниеНамеренияДвижения(Объект) <> Привязка.Намерение Тогда
            ВызватьИсключение "кабинет_вода_привязка_конфликт";
        КонецЕсли;
        Возврат ДанныеДвижения(Объект);
    ИначеЕсли Привязка.ВидРезультата = "Order" Тогда
        Результат = ДанныеЗаказа(Объект);
        Результат.Вставить("state", "Draft");
        Результат.Вставить("revision", 1);
        Результат.Вставить("updatedAt", ДатаDTOUTC(Объект.ДатаСоздания));
        Результат.Вставить("returnedQuantity", 0);
        Результат.Вставить("lastMovementId", "");
        Возврат Результат;
    КонецЕсли;
    Возврат ДанныеНастроекРаздела(Объект);
КонецФункции

Процедура ЗаполнитьСлужебныеОтметки(Объект, СсылкаУчетнойЗаписи, СсылкаРабочейОбласти, СсылкаОбласти)
    Объект.РабочееПространство = СсылкаРабочейОбласти;
    Объект.Область = СсылкаОбласти;
    Объект.КемСоздано = СсылкаУчетнойЗаписи;
    Объект.ДатаСоздания = ТекущаяУниверсальнаяДата();
    Объект.ДатаОбновления = Объект.ДатаСоздания;
    Объект.Ревизия = 1;
КонецПроцедуры

Процедура ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи)
    Текущий = ПолитикаДоступа.ПроверитьУчетнуюЗапись();
    Если ТипЗнч(СсылкаУчетнойЗаписи) <> Тип("СправочникСсылка.УчетныеЗаписи") Тогда
        ВызватьИсключение "кабинет_участник_несовпадение";
    КонецЕсли;
    Если Текущий.Ссылка <> СсылкаУчетнойЗаписи Тогда
        ВызватьИсключение "кабинет_участник_несовпадение";
    КонецЕсли;
КонецПроцедуры

Процедура ОтменитьСобственнуюТранзакцию()
    Если ТранзакцияАктивна() Тогда
        ОтменитьТранзакцию();
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьПоляТелаЗапроса(ТелоЗапроса, Поля)
    Если ТипЗнч(ТелоЗапроса) <> Тип("Структура") Тогда
        ВызватьИсключение "кабинет_вода_некорректно_тело";
    КонецЕсли;
    Разрешенные = СтрРазделить(Поля, ",");
    Для Каждого ТелоЗапись Из ТелоЗапроса Цикл
        Если Разрешенные.Найти(ТелоЗапись.Ключ) = Неопределено Тогда
            ВызватьИсключение "кабинет_вода_некорректно_поле";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ТекстовоеПоле(ТелоЗапроса, Имя, Максимум)
    Значение = Неопределено;
    Если Не ТелоЗапроса.Свойство(Имя, Значение) Тогда
        ВызватьИсключение "кабинет_вода_некорректно_поле";
    КонецЕсли;
    Возврат ПроверенныйТекст(Значение, Максимум);
КонецФункции

Функция ПроверенныйТекст(Значение, Максимум)
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_вода_некорректно_поле";
    КонецЕсли;
    Если СтрДлина(Значение) > Максимум Тогда
        ВызватьИсключение "кабинет_вода_некорректно_поле";
    КонецЕсли;
    Для Позиция = 1 По СтрДлина(Значение) Цикл
        Код = КодСимвола(Значение, Позиция);
        Если Код < 32 Или (Код >= 127 И Код <= 159) Или (Код >= 8203 И Код <= 8207)
            Или (Код >= 8234 И Код <= 8238) Или (Код >= 8288 И Код <= 8297)
            Или Код = 65279 Или (Код >= 55296 И Код <= 57343) Тогда
            ВызватьИсключение "кабинет_вода_некорректно_поле";
        КонецЕсли;
    КонецЦикла;
    Значение = СокрЛП(Значение);
    Если ПустаяСтрока(Значение) Тогда
        ВызватьИсключение "кабинет_вода_некорректно_поле";
    КонецЕсли;
    Возврат Значение;
КонецФункции

Функция ПолеОбъема(ТелоЗапроса, Имя)
    Значение = Неопределено;
    Если Не ТелоЗапроса.Свойство(Имя, Значение) Тогда
        ВызватьИсключение "кабинет_вода_некорректно_количество";
    КонецЕсли;
    ПроверитьОбъем(Значение);
    Возврат Значение;
КонецФункции

Процедура ПроверитьОбъем(Значение)
    Если ТипЗнч(Значение) <> Тип("Число") Тогда
        ВызватьИсключение "кабинет_вода_некорректно_количество";
    КонецЕсли;
    Если Значение <= 0 Или Значение > 1000 Или Значение <> Окр(Значение, 3) Тогда
        ВызватьИсключение "кабинет_вода_некорректно_количество";
    КонецЕсли;
КонецПроцедуры

Функция ПолеРевизии(ТелоЗапроса)
    Значение = Неопределено;
    Если Не ТелоЗапроса.Свойство("expectedRevision", Значение) Тогда
        ВызватьИсключение "кабинет_вода_некорректно_редакция";
    КонецЕсли;
    ПроверитьНомерРевизии(Значение);
    Возврат Значение;
КонецФункции

Процедура ПроверитьНомерРевизии(Значение)
    Если ТипЗнч(Значение) <> Тип("Число") Тогда
        ВызватьИсключение "кабинет_вода_некорректно_редакция";
    КонецЕсли;
    Если Значение < 1 Или Значение > 999999999999999 Или Значение <> Цел(Значение) Тогда
        ВызватьИсключение "кабинет_вода_некорректно_редакция";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьДатуОперации(Значение)
    Если ТипЗнч(Значение) <> Тип("Дата") Тогда
        ВызватьИсключение "кабинет_вода_некорректно_даты";
    КонецЕсли;
    Если Значение = Дата(1, 1, 1) Или Значение > ТекущаяУниверсальнаяДата() + 300 Тогда
        ВызватьИсключение "кабинет_вода_некорректно_даты";
    КонецЕсли;
КонецПроцедуры

Функция ПолеДатыUTC(ТелоЗапроса, Имя)
    Значение = ТекстовоеПоле(ТелоЗапроса, Имя, 20);
    Если СтрДлина(Значение) <> 20 Или Сред(Значение, 5, 1) <> "-" Или Сред(Значение, 8, 1) <> "-"
        Или Сред(Значение, 11, 1) <> "T" Или Сред(Значение, 14, 1) <> ":"
        Или Сред(Значение, 17, 1) <> ":" Или Прав(Значение, 1) <> "Z" Тогда
        ВызватьИсключение "кабинет_вода_некорректно_даты";
    КонецЕсли;
    Цифры = Лев(Значение, 4) + Сред(Значение, 6, 2) + Сред(Значение, 9, 2)
        + Сред(Значение, 12, 2) + Сред(Значение, 15, 2) + Сред(Значение, 18, 2);
    Для Позиция = 1 По СтрДлина(Цифры) Цикл
        Если СтрНайти("0123456789", Сред(Цифры, Позиция, 1)) = 0 Тогда
            ВызватьИсключение "кабинет_вода_некорректно_даты";
        КонецЕсли;
    КонецЦикла;
    Попытка
        Разобранный = XMLЗначение(Тип("Дата"), Лев(Значение, 19));
    Исключение
        ВызватьИсключение "кабинет_вода_некорректно_даты";
    КонецПопытки;
    Если Разобранный = Дата(1, 1, 1) Или XMLСтрока(Разобранный) <> Лев(Значение, 19) Тогда
        ВызватьИсключение "кабинет_вода_некорректно_даты";
    КонецЕсли;
    Возврат Разобранный;
КонецФункции

Функция РазобратьИдентификатор(Идентификатор)
    Если ТипЗнч(Идентификатор) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецЕсли;
    Если СтрДлина(Идентификатор) <> 36 Тогда
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецЕсли;
    Попытка
        Разобранный = Новый УникальныйИдентификатор(Идентификатор);
    Исключение
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецПопытки;
    Если Строка(Разобранный) = "00000000-0000-0000-0000-000000000000" Тогда
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецЕсли;
    Возврат Разобранный;
КонецФункции

Функция КаноническоеПредставление(Намерение)
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Намерение);
    Результат = Запись.Закрыть();
    Если СтрДлина(Результат) > 4096 Тогда
        ВызватьИсключение "кабинет_вода_некорректно_тело";
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция НеобязательныйИдентификатор(ИдентификаторСсылки)
    Если Не ЗначениеЗаполнено(ИдентификаторСсылки) Тогда
        Возврат "";
    КонецЕсли;
    Возврат Строка(ИдентификаторСсылки.УникальныйИдентификатор());
КонецФункции

Функция ДатаDTOUTC(Значение)
    Возврат XMLСтрока(Значение) + "Z";
КонецФункции

Функция ОбщиеДанныеОбъекта(СтрокаВыборки)
    Возврат Новый Структура("id,workspaceId,areaId,createdBy,createdAt,updatedAt,revision",
        Строка(СтрокаВыборки.Ссылка.УникальныйИдентификатор()), Строка(СтрокаВыборки.РабочееПространство.УникальныйИдентификатор()), Строка(СтрокаВыборки.Область.УникальныйИдентификатор()),
        Строка(СтрокаВыборки.КемСоздано.УникальныйИдентификатор()), ДатаDTOUTC(СтрокаВыборки.ДатаСоздания), ДатаDTOUTC(СтрокаВыборки.ДатаОбновления), СтрокаВыборки.Ревизия);
КонецФункции

Функция ДанныеНастроекРаздела(СтрокаВыборки)
    Результат = ОбщиеДанныеОбъекта(СтрокаВыборки);
    Результат.Вставить("name", СтрокаВыборки.Наименование);
    Результат.Вставить("state", СтрокаВыборки.Состояние);
    Возврат Результат;
КонецФункции

Функция ДанныеЗаказа(СтрокаВыборки)
    Результат = ОбщиеДанныеОбъекта(СтрокаВыборки);
    Результат.Вставить("pointId", Строка(СтрокаВыборки.Точка.УникальныйИдентификатор()));
    Результат.Вставить("recipientId", Строка(СтрокаВыборки.Получатель.УникальныйИдентификатор()));
    Результат.Вставить("kind", СтрокаВыборки.Вид);
    Результат.Вставить("quantity", СтрокаВыборки.Объем);
    Результат.Вставить("returnedQuantity", СтрокаВыборки.ВозвращенныйОбъем);
    Результат.Вставить("scheduledAt", ДатаDTOUTC(СтрокаВыборки.ПлановаяДата));
    Результат.Вставить("state", СтрокаВыборки.Состояние);
    Результат.Вставить("lastMovementId", НеобязательныйИдентификатор(СтрокаВыборки.ПоследнееДвижение));
    Возврат Результат;
КонецФункции

Функция ДанныеДвижения(СтрокаВыборки)
    Результат = ОбщиеДанныеОбъекта(СтрокаВыборки);
    Результат.Вставить("operation", СтрокаВыборки.Операция);
    Результат.Вставить("pointId", Строка(СтрокаВыборки.Точка.УникальныйИдентификатор()));
    Результат.Вставить("kind", СтрокаВыборки.Вид);
    Результат.Вставить("sourceId", НеобязательныйИдентификатор(СтрокаВыборки.Источник));
    Результат.Вставить("recipientId", НеобязательныйИдентификатор(СтрокаВыборки.Получатель));
    Результат.Вставить("orderId", НеобязательныйИдентификатор(СтрокаВыборки.ЗаказВоды));
    Результат.Вставить("quantity", СтрокаВыборки.Объем);
    Результат.Вставить("occurredAt", ДатаDTOUTC(СтрокаВыборки.ФактическаяДата));
    Результат.Вставить("basis", СтрокаВыборки.Основание);
    Результат.Вставить("expectedRevision", СтрокаВыборки.ОжидаемаяРевизия);
    Результат.Вставить("orderState", СтрокаВыборки.СостояниеЗаказаВРезультате);
    Результат.Вставить("orderRevision", СтрокаВыборки.РевизияЗаказаВРезультате);
    Результат.Вставить("returnedQuantity", СтрокаВыборки.ВозвращенныйОбъемВРезультате);
    Результат.Вставить("stockDelta", СтрокаВыборки.ИзменениеЗапаса);
    Результат.Вставить("reservedDelta", СтрокаВыборки.ИзменениеРезерва);
    Результат.Вставить("availableDelta", СтрокаВыборки.ИзменениеЗапаса - СтрокаВыборки.ИзменениеРезерва);
    Возврат Результат;
КонецФункции

Функция ДанныеОстатков(СсылкаРабочейОбласти, СсылкаОбласти, ТочкаСсылка, Остатки)
    Возврат Новый Структура("workspaceId,areaId,pointId,kind,unit,stock,reserved,available",
        Строка(СсылкаРабочейОбласти.УникальныйИдентификатор()), Строка(СсылкаОбласти.УникальныйИдентификатор()), Строка(ТочкаСсылка.УникальныйИдентификатор()),
        "Potable", "m3", Остатки.stock, Остатки.reserved, Остатки.available);
КонецФункции
