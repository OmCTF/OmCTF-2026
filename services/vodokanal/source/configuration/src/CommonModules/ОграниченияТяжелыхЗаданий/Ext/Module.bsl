Функция Начать(УчетнаяЗапись, Вид, Области, ВложенныйДопуск = Неопределено) Экспорт
    ПроверитьРежим(); ПроверитьАктера(УчетнаяЗапись); ПроверитьВид(Вид);
    Области = ПроверитьОбласти(Области, Вид);
    Если ВложенныйДопуск <> Неопределено Тогда
        ПроверитьВложенный(УчетнаяЗапись, Вид, Области, ВложенныйДопуск);
        Возврат ВложенныйДопуск;
    КонецЕсли;
    Экземпляр = Экземпляр(); Ключ = Строка(СервисДокументов.НовыйUUIDv4());
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        Заблокировать();
        З = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ключ ИЗ РегистрСведений.АктивныеТяжелыеЗадания
            |ГДЕ УчетнаяЗапись = &Актер И Вид = &Вид");
        З.УстановитьПараметр("Актер", УчетнаяЗапись); З.УстановитьПараметр("Вид", Вид);
        Если Не З.Выполнить().Пустой() Тогда ВызватьИсключение "кабинет_тяжелый_тип_лимит"; КонецЕсли;
        З.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Ключ) КАК Количество
            |ИЗ РегистрСведений.АктивныеТяжелыеЗадания ГДЕ УчетнаяЗапись = &Актер";
        Если ЧислоЗаданий(З) >= 2 Тогда ВызватьИсключение "кабинет_тяжелый_пользователь_лимит"; КонецЕсли;
        Пространства = Новый Массив; ИдентификаторыОбластей = Новый Массив;
        Для Каждого Область Из Области Цикл
            Если Не ЗначениеЗаполнено(Область.РабочееПространство) Тогда Продолжить; КонецЕсли;
            Если Пространства.Найти(Область.РабочееПространство) = Неопределено Тогда Пространства.Добавить(Область.РабочееПространство); КонецЕсли;
            ИдентификаторыОбластей.Добавить(Область.Область);
        КонецЦикла;
        Если Пространства.Количество() > 0 Тогда
            З.Текст = "ВЫБРАТЬ РабочееПространство, КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Ключ) КАК Количество
                |ИЗ РегистрСведений.АктивныеТяжелыеЗадания ГДЕ РабочееПространство В (&Пространства)
                |СГРУППИРОВАТЬ ПО РабочееПространство";
            З.УстановитьПараметр("Пространства", Пространства); В = З.Выполнить().Выбрать();
            Пока В.Следующий() Цикл Если В.Количество >= 16 Тогда ВызватьИсключение "кабинет_тяжелый_пространство_лимит"; КонецЕсли; КонецЦикла;
            З.Текст = "ВЫБРАТЬ Область, КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Ключ) КАК Количество
                |ИЗ РегистрСведений.АктивныеТяжелыеЗадания ГДЕ Область В (&Области)
                |СГРУППИРОВАТЬ ПО Область";
            З.УстановитьПараметр("Области", ИдентификаторыОбластей); В = З.Выполнить().Выбрать();
            Пока В.Следующий() Цикл Если В.Количество >= 4 Тогда ВызватьИсключение "кабинет_тяжелый_область_лимит"; КонецЕсли; КонецЦикла;
        КонецЕсли;
        Для Каждого Область Из Области Цикл
            Р = РегистрыСведений.АктивныеТяжелыеЗадания.СоздатьМенеджерЗаписи();
            Р.УчетнаяЗапись = УчетнаяЗапись; Р.Вид = Вид;
            Р.РабочееПространство = Область.РабочееПространство; Р.Область = Область.Область;
            Р.Ключ = Ключ; Р.ЭкземплярСеанса = Экземпляр; Р.Начато = ТекущаяУниверсальнаяДата(); Р.Записать();
        КонецЦикла;
        ЗафиксироватьТранзакцию();
    Исключение
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли; ВызватьИсключение;
    КонецПопытки;
    Возврат Новый Структура("accountId,kind,key,sessionInstanceId", Строка(УчетнаяЗапись.УникальныйИдентификатор()), Вид, Ключ, Экземпляр);
КонецФункции

Процедура Завершить(УчетнаяЗапись, Допуск) Экспорт
    ПроверитьРежим(); ПроверитьДопуск(УчетнаяЗапись, Допуск);
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        Заблокировать(); Строки = СтрокиДопуска(УчетнаяЗапись, Допуск);
        Если Строки.Количество() = 0 Тогда ВызватьИсключение "кабинет_тяжелый_аренда_несовпадение"; КонецЕсли;
        Для Каждого Строка Из Строки Цикл
            Если Строка.Ключ <> Допуск.key Или Строка.ЭкземплярСеанса <> Допуск.sessionInstanceId Тогда ВызватьИсключение "кабинет_тяжелый_аренда_несовпадение"; КонецЕсли;
        КонецЦикла;
        Набор = РегистрыСведений.АктивныеТяжелыеЗадания.СоздатьНаборЗаписей();
        Набор.Отбор.УчетнаяЗапись.Установить(УчетнаяЗапись); Набор.Отбор.Вид.Установить(Допуск.kind);
        Набор.Записать(); ЗафиксироватьТранзакцию();
    Исключение
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли; ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

Процедура ПроверитьВложенный(УчетнаяЗапись, Вид, Области, Допуск)
    ПроверитьДопуск(УчетнаяЗапись, Допуск);
    Если Допуск.kind <> Вид Тогда ВызватьИсключение "кабинет_тяжелый_аренда_несовпадение"; КонецЕсли;
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        Заблокировать(); Строки = СтрокиДопуска(УчетнаяЗапись, Допуск);
        Если Строки.Количество() <> Области.Количество() Тогда ВызватьИсключение "кабинет_тяжелый_аренда_несовпадение"; КонецЕсли;
        Для Каждого Область Из Области Цикл
            Найдено = Ложь;
            Для Каждого Строка Из Строки Цикл
                Если Строка.Ключ <> Допуск.key Или Строка.ЭкземплярСеанса <> Допуск.sessionInstanceId Тогда ВызватьИсключение "кабинет_тяжелый_аренда_несовпадение"; КонецЕсли;
                Если Строка.РабочееПространство = Область.РабочееПространство И Строка.Область = Область.Область Тогда Найдено = Истина; КонецЕсли;
            КонецЦикла;
            Если Не Найдено Тогда ВызватьИсключение "кабинет_тяжелый_аренда_несовпадение"; КонецЕсли;
        КонецЦикла;
        ЗафиксироватьТранзакцию();
    Исключение
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли; ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

Функция СтрокиДопуска(УчетнаяЗапись, Допуск)
    З = Новый Запрос("ВЫБРАТЬ РабочееПространство, Область, Ключ, ЭкземплярСеанса
        |ИЗ РегистрСведений.АктивныеТяжелыеЗадания ГДЕ УчетнаяЗапись = &Актер И Вид = &Вид");
    З.УстановитьПараметр("Актер", УчетнаяЗапись); З.УстановитьПараметр("Вид", Допуск.kind);
    Возврат З.Выполнить().Выгрузить();
КонецФункции

Функция ЧислоЗаданий(З)
    В = З.Выполнить().Выбрать();
    Если Не В.Следующий() Или В.Количество < 0 Тогда ВызватьИсключение "кабинет_тяжелый_состояние_некорректно"; КонецЕсли;
    Возврат В.Количество;
КонецФункции

Процедура Заблокировать()
    Б = Новый БлокировкаДанных; Э = Б.Добавить("РегистрСведений.АктивныеТяжелыеЗадания");
    Э.Режим = РежимБлокировкиДанных.Исключительный; Б.Заблокировать();
КонецПроцедуры

Функция ОднаОбласть(Пространство, Область) Экспорт
    Р = Новый Массив; Р.Добавить(Новый Структура("РабочееПространство,Область", Пространство, Область)); Возврат Р;
КонецФункции

Функция ПроверитьОбласти(Области, Вид)
    Если ТипЗнч(Области) <> Тип("Массив") Или Области.Количество() > 1000 Тогда ВызватьИсключение "кабинет_тяжелый_контекст_некорректно"; КонецЕсли;
    Р = Новый Массив; Ключи = Новый Соответствие;
    Для Каждого О Из Области Цикл
        Если ТипЗнч(О) <> Тип("Структура") Или О.Количество() <> 2 Тогда ВызватьИсключение "кабинет_тяжелый_контекст_некорректно"; КонецЕсли;
        Если Не О.Свойство("РабочееПространство") Или Не О.Свойство("Область") Тогда ВызватьИсключение "кабинет_тяжелый_контекст_некорректно"; КонецЕсли;
        Если ТипЗнч(О.РабочееПространство) <> Тип("СправочникСсылка.РабочиеПространства") Или ТипЗнч(О.Область) <> Тип("СправочникСсылка.Области") Тогда ВызватьИсключение "кабинет_тяжелый_контекст_некорректно"; КонецЕсли;
        Если Не ЗначениеЗаполнено(О.РабочееПространство) Или Не ЗначениеЗаполнено(О.Область) Тогда ВызватьИсключение "кабинет_тяжелый_контекст_некорректно"; КонецЕсли;
        Если О.Область.РабочееПространство <> О.РабочееПространство Тогда ВызватьИсключение "кабинет_тяжелый_контекст_некорректно"; КонецЕсли;
        К = Строка(О.Область.УникальныйИдентификатор());
        Если Ключи.Получить(К) = Неопределено Тогда Ключи.Вставить(К, Истина); Р.Добавить(О); КонецЕсли;
    КонецЦикла;
    Если Р.Количество() = 0 Тогда
        Если Вид <> "documentRegistry" Тогда ВызватьИсключение "кабинет_тяжелый_контекст_некорректно"; КонецЕсли;
        Р = ОднаОбласть(Справочники.РабочиеПространства.ПустаяСсылка(), Справочники.Области.ПустаяСсылка());
    КонецЕсли;
    Возврат Р;
КонецФункции

Процедура ПроверитьДопуск(УчетнаяЗапись, Допуск)
    Если ТипЗнч(Допуск) <> Тип("Структура") Или Допуск.Количество() <> 4 Тогда ВызватьИсключение "кабинет_тяжелый_аренда_несовпадение"; КонецЕсли;
    Для Каждого Поле Из СтрРазделить("accountId,kind,key,sessionInstanceId", ",") Цикл
        Если Не Допуск.Свойство(Поле) Тогда ВызватьИсключение "кабинет_тяжелый_аренда_несовпадение"; КонецЕсли;
    КонецЦикла;
    ПроверитьВид(Допуск.kind); ПроверитьКлюч(Допуск.key);
    Если Допуск.accountId <> Строка(УчетнаяЗапись.УникальныйИдентификатор()) Или Допуск.sessionInstanceId <> Экземпляр() Тогда ВызватьИсключение "кабинет_тяжелый_аренда_несовпадение"; КонецЕсли;
КонецПроцедуры

Процедура ПроверитьВид(Вид)
    Если ТипЗнч(Вид) <> Тип("Строка") Или СтрРазделить("labProtocol,workPrint,workAppendix,subscriberRegistry,documentRegistry", ",").Найти(Вид) = Неопределено Тогда ВызватьИсключение "кабинет_тяжелый_контекст_некорректно"; КонецЕсли;
КонецПроцедуры

Процедура ПроверитьАктера(УчетнаяЗапись)
    А = ПолитикаДоступа.ПроверитьУчетнуюЗапись();
    Если А.Ссылка <> УчетнаяЗапись Тогда ВызватьИсключение "кабинет_тяжелый_контекст_некорректно"; КонецЕсли;
КонецПроцедуры

Функция Экземпляр()
    К = ПараметрыСеанса.ЭкземплярСеансаКабинета; ПроверитьКлюч(К); Возврат К;
КонецФункции

Процедура ПроверитьКлюч(Ключ)
    Если ТипЗнч(Ключ) <> Тип("Строка") Или СтрДлина(Ключ) <> 36 Тогда ВызватьИсключение "кабинет_тяжелый_контекст_некорректно"; КонецЕсли;
    Попытка ИД = Новый УникальныйИдентификатор(Ключ); Исключение ВызватьИсключение "кабинет_тяжелый_контекст_некорректно"; КонецПопытки;
    Если Строка(ИД) <> Ключ Или Ключ = "00000000-0000-0000-0000-000000000000" Тогда ВызватьИсключение "кабинет_тяжелый_контекст_некорректно"; КонецЕсли;
КонецПроцедуры

Процедура ПроверитьРежим()
    Если ПривилегированныйРежим() Или ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_тяжелый_контекст_некорректно"; КонецЕсли;
КонецПроцедуры

Процедура ОсвободитьПослеОстановки(УчетнаяЗапись, Вид, Ключ, ЭкземплярСеанса, ЧислоОбластей) Экспорт
    ПроверитьОператораВосстановления();
    Если ТипЗнч(УчетнаяЗапись) <> Тип("СправочникСсылка.УчетныеЗаписи") Или Не ЗначениеЗаполнено(УчетнаяЗапись) Тогда ВызватьИсключение "кабинет_некорректно_идентификатор"; КонецЕсли;
    ПроверитьВид(Вид); ПроверитьКлюч(Ключ); ПроверитьКлюч(ЭкземплярСеанса);
    Если ТипЗнч(ЧислоОбластей) <> Тип("Число") Тогда ВызватьИсключение "кабинет_некорректно_лимит"; КонецЕсли;
    Если ЧислоОбластей <> Цел(ЧислоОбластей) Или ЧислоОбластей < 1 Или ЧислоОбластей > 1000 Тогда ВызватьИсключение "кабинет_некорректно_лимит"; КонецЕсли;
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        Заблокировать(); Допуск = Новый Структура("kind", Вид); Строки = СтрокиДопуска(УчетнаяЗапись, Допуск);
        Если Строки.Количество() <> ЧислоОбластей Тогда ВызватьИсключение "кабинет_операции_аренда_изменено"; КонецЕсли;
        Для Каждого Строка Из Строки Цикл
            Если Строка.Ключ <> Ключ Или Строка.ЭкземплярСеанса <> ЭкземплярСеанса Тогда ВызватьИсключение "кабинет_операции_аренда_изменено"; КонецЕсли;
        КонецЦикла;
        Набор = РегистрыСведений.АктивныеТяжелыеЗадания.СоздатьНаборЗаписей();
        Набор.Отбор.УчетнаяЗапись.Установить(УчетнаяЗапись); Набор.Отбор.Вид.Установить(Вид); Набор.Записать();
        ПолитикаДоступа.ЗаписатьСобытиеАудита(Справочники.УчетныеЗаписи.ПустаяСсылка(), Справочники.РабочиеПространства.ПустаяСсылка(),
            "operations.heavy.recover", Строка(УчетнаяЗапись.УникальныйИдентификатор()));
        ЗафиксироватьТранзакцию();
    Исключение
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли; ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

Процедура ПроверитьОператораВосстановления() Экспорт
    ПроверитьРежим();
    Если Не РольДоступна("Администратор") Тогда ВызватьИсключение "кабинет_операции_запрещено"; КонецЕсли;
    Если Не МонопольныйРежим() Тогда ВызватьИсключение "кабинет_операции_монопольный_режим_требуется"; КонецЕсли;
    Текущий = ПользователиИнформационнойБазы.ТекущийПользователь();
    Если Текущий = Неопределено Тогда ВызватьИсключение "кабинет_операции_запрещено"; КонецЕсли;
    Свежий = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Текущий.УникальныйИдентификатор);
    Если Свежий = Неопределено Тогда ВызватьИсключение "кабинет_операции_запрещено"; КонецЕсли;
    Администратор = Ложь;
    Для Каждого Роль Из Свежий.Роли Цикл Если Роль = Метаданные.Роли.Администратор Тогда Администратор = Истина; КонецЕсли; КонецЦикла;
    Если Не Администратор Тогда ВызватьИсключение "кабинет_операции_запрещено"; КонецЕсли;
КонецПроцедуры
