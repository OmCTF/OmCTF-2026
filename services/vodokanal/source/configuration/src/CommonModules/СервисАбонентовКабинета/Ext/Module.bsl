Функция ОбработатьЗапросКабинета(Действие, УчетнаяЗапись, Запрос, Корреляция) Экспорт
    Идентификатор = Запрос.ПараметрыURL.Получить("id");
    Лимит = APIКабинета.ТекстПараметраЗапроса(Запрос, "limit", 3);
    Курсор = APIКабинета.ТекстПараметраЗапроса(Запрос, "cursor", 256);
    Команда = APIКабинета.ЗаголовокЗапроса(Запрос, "Idempotency-Key");
    Статус = 200;
    Если Действие = "meterPhotoUpload" Тогда
        Данные = СервисУчетаПоказаний.ЗагрузитьФотоПоказания(УчетнаяЗапись, Идентификатор, APIКабинета.РазобратьТелоЗапроса(Запрос, 7100000), Команда);
        Статус = 201;
    ИначеЕсли Действие = "meterPhoto" Или Действие = "meterPhotoDownload" Тогда
        Данные = СервисУчетаПоказаний.ПолучитьФотоПоказания(УчетнаяЗапись, Идентификатор, Действие = "meterPhotoDownload");
        Если Действие = "meterPhotoDownload" Тогда Возврат APIКабинета.СформироватьОтветФайла(Данные, Корреляция); КонецЕсли;
    ИначеЕсли Действие = "meterReview" Тогда
        Данные = СервисУчетаПоказаний.РассмотретьПоказание(УчетнаяЗапись, Идентификатор, APIКабинета.РазобратьТелоЗапроса(Запрос), Команда);
    ИначеЕсли Действие = "meterAcceptedSeries" Тогда
        Данные = СервисУчетаПоказаний.ПолучитьПринятыйРяд(УчетнаяЗапись, Идентификатор, Лимит, Курсор);
    ИначеЕсли Действие = "meterCorrectionRequests" Или Действие = "meterReviewDecisions" Тогда
        Данные = СервисУчетаПоказаний.СписокПроверокПоказаний(УчетнаяЗапись, Идентификатор, ?(Действие = "meterCorrectionRequests", "requests", "decisions"), Лимит, Курсор);
    ИначеЕсли Действие = "waterDeliveryCreate" Тогда
        Данные = СервисВодоснабжения.СоздатьДоставку(УчетнаяЗапись, APIКабинета.РазобратьТелоЗапроса(Запрос), Команда);
        Статус = 201;
    ИначеЕсли Действие = "waterDeliveryAction" Тогда
        Данные = СервисВодоснабжения.ИзменитьДоставку(УчетнаяЗапись, Идентификатор, Запрос.ПараметрыURL.Получить("action"), APIКабинета.РазобратьТелоЗапроса(Запрос), Команда);
    Иначе
        РабочаяОбласть = APIКабинета.ТекстПараметраЗапроса(Запрос, "workspaceId", 36);
        Область = APIКабинета.ТекстПараметраЗапроса(Запрос, "areaId", 36);
        Если Действие = "waterDeliveries" Или Действие = "waterMyDeliveries" Тогда
            Данные = СервисВодоснабжения.СписокДоставок(УчетнаяЗапись, РабочаяОбласть, Область, Действие = "waterMyDeliveries", Лимит, Курсор);
        ИначеЕсли Действие = "waterDeliveryOptions" Тогда
            Данные = СервисВодоснабжения.СписокВариантовДоставки(УчетнаяЗапись, РабочаяОбласть, Область, Запрос.ПараметрыURL.Получить("kind"), Лимит, Курсор);
        ИначеЕсли Действие = "waterSetupPage" Тогда
            Данные = СервисВодоснабжения.СписокНастроекСтраница(УчетнаяЗапись, РабочаяОбласть, Область, Запрос.ПараметрыURL.Получить("kind"), Лимит, Курсор);
        Иначе
            ВызватьИсключение "кабинет_неизвестно_действие";
        КонецЕсли;
    КонецЕсли;
    Возврат APIКабинета.СформироватьОтветHTTP(Статус, Данные, Корреляция);
КонецФункции
