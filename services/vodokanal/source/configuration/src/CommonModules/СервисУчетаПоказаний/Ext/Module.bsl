
Функция СоздатьПаспортПрибора(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, "workspaceId,areaId,name,meterType,manufacturer,model,serialNumber,unit,digits,coefficient,verificationUntil");
    РабочаяОбластьИдентификатор = ТекстовоеПоле(ТелоЗапроса, "workspaceId", 36);
    ОбластьИдентификатор = ТекстовоеПоле(ТелоЗапроса, "areaId", 36);
    Имя = ТекстовоеПоле(ТелоЗапроса, "name", 150);
    ТипПрибора = ТекстовоеПоле(ТелоЗапроса, "meterType", 32);
    Производитель = ВРег(ТекстовоеПоле(ТелоЗапроса, "manufacturer", 64));
    Модель = ВРег(ТекстовоеПоле(ТелоЗапроса, "model", 64));
    Серийный = ПолеЗаводскогоНомера(ТелоЗапроса);
    ЕдиницаИзмерения = ТекстовоеПоле(ТелоЗапроса, "unit", 8);
    Если ЕдиницаИзмерения <> "m3" Тогда
        ВызватьИсключение "кабинет_счетчик_некорректно_поле";
    КонецЕсли;
    Цифры = ПолеЧисловогоЗначения(ТелоЗапроса, "digits", 0, 1, 12);
    Коэффициент = ПолеЧисловогоЗначения(ТелоЗапроса, "coefficient", 3, 0.001, 1000000);
    СрокПоверки = ПолеДатыUTC(ТелоЗапроса, "verificationUntil");
    Намерение = КаноническоеПредставление(Новый Структура("workspaceId,areaId,name,meterType,manufacturer,model,serialNumber,unit,digits,coefficient,verificationUntil",
        Строка(РазобратьИдентификатор(РабочаяОбластьИдентификатор)), Строка(РазобратьИдентификатор(ОбластьИдентификатор)), Имя, ТипПрибора, Производитель, Модель, Серийный, ЕдиницаИзмерения, Цифры, Коэффициент, XMLСтрока(СрокПоверки)));
    КонтекстДоступа = НачатьОперациюСотрудника(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор);
    Попытка
        ЗаблокироватьЗаводскойНомер(КонтекстДоступа.РабочееПространство, Производитель, Модель, Серийный);
        Запрос = ОткрытьПривязкуЗапроса(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, "passport.create", Намерение);
        Если Запрос.Выбран() Тогда
            Результат = ДанныеСохраненногоПовтора(Запрос, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
            ЗафиксироватьТранзакцию();
            Возврат Результат;
        КонецЕсли;
        Если СрокПоверки <= ТекущаяУниверсальнаяДата() Тогда
            ВызватьИсключение "кабинет_счетчик_поверка_истекло";
        КонецЕсли;
        Привязка = ПроверитьСвободныйЗаводскойНомер(КонтекстДоступа.РабочееПространство, Производитель, Модель, Серийный);
        Объект = Справочники.ПаспортаПриборов.СоздатьЭлемент();
        Объект.SetNewObjectRef(Справочники.ПаспортаПриборов.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
        ЗаполнитьСлужебныеОтметки(Объект, СсылкаУчетнойЗаписи, КонтекстДоступа.РабочееПространство, КонтекстДоступа.Область);
        Объект.Наименование = Имя;
        Объект.ТипПрибора = ТипПрибора;
        Объект.НормализованныйПроизводитель = Производитель;
        Объект.НормализованнаяМодель = Модель;
        Объект.НормализованныйСерийныйНомер = Серийный;
        Объект.ЕдиницаИзмерения = ЕдиницаИзмерения;
        Объект.РазрядностьШкалы = Цифры;
        Объект.Коэффициент = Коэффициент;
        Объект.СрокПоверки = СрокПоверки;
        Объект.Состояние = "Active";
        Объект.Записать();
        Привязка.Паспорт = Объект.Ссылка;
        Привязка.Записать();
        ПривязатьКомандуЗапроса(Запрос, Объект.Ссылка);
        ПолитикаДоступа.ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, КонтекстДоступа.РабочееПространство, "meter.passport.create", Строка(Объект.Ссылка.УникальныйИдентификатор()));
        Результат = ДанныеПаспортаПрибора(Объект);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СписокПаспортовПриборов(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, Лимит = Неопределено, Курсор = "") Экспорт
    КонтекстДоступа = НачатьОперациюСотрудника(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор);
    Попытка
        Запрос = Новый Запрос(
            "ВЫБРАТЬ ПЕРВЫЕ 100 Ссылка, РабочееПространство, Область, Наименование, ТипПрибора, НормализованныйПроизводитель,
            |НормализованнаяМодель, НормализованныйСерийныйНомер, ЕдиницаИзмерения, РазрядностьШкалы, Коэффициент, СрокПоверки,
            |Состояние, КемСоздано, ДатаСоздания, ДатаОбновления, Ревизия ИЗ Справочник.ПаспортаПриборов
            |ГДЕ РабочееПространство = &РабочееПространство И Область = &Область И НЕ ПометкаУдаления
            |УПОРЯДОЧИТЬ ПО ДатаСоздания, Ссылка");
        Запрос.УстановитьПараметр("РабочееПространство", КонтекстДоступа.РабочееПространство);
        Запрос.УстановитьПараметр("Область", КонтекстДоступа.Область);
        Страница = РеестрАбонентов.ПодготовитьСтраницу(Запрос, Лимит, Курсор, Новый Структура("actor,workspace,area,kind", Строка(СсылкаУчетнойЗаписи.УникальныйИдентификатор()), РабочаяОбластьИдентификатор, ОбластьИдентификатор, "meters"), Справочники.ПаспортаПриборов.ПустаяСсылка());
        Выборка = Запрос.Выполнить().Выбрать();
        Результат = Новый Массив;
        Пока Выборка.Следующий() Цикл
            Результат.Добавить(ДанныеПаспортаПрибора(Выборка));
        КонецЦикла;
        Результат = РеестрАбонентов.ЗавершитьСтраницу(Результат, Страница);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СоздатьУстановкуПрибора(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, "passportId,personalAccountId,servicePointId,installedAt,admittedAt,initialValue");
    ПаспортСсылка = Справочники.ПаспортаПриборов.ПолучитьСсылку(РазобратьИдентификатор(ТекстовоеПоле(ТелоЗапроса, "passportId", 36)));
    ЛицевойИдентификатор = ТекстовоеПоле(ТелоЗапроса, "personalAccountId", 36);
    ТочкаСсылка = Справочники.ТочкиОбслуживания.ПолучитьСсылку(РазобратьИдентификатор(ТекстовоеПоле(ТелоЗапроса, "servicePointId", 36)));
    ДатаУстановки = ПолеДатыUTC(ТелоЗапроса, "installedAt");
    ДатаДопуска = ПолеДатыUTC(ТелоЗапроса, "admittedAt");
    НачальноеПоказание = ПолеЧисловогоЗначения(ТелоЗапроса, "initialValue", 3, 0, 999999999999.999);
    Намерение = КаноническоеПредставление(Новый Структура("passportId,personalAccountId,servicePointId,installedAt,admittedAt,initialValue",
        Строка(ПаспортСсылка.УникальныйИдентификатор()), Строка(РазобратьИдентификатор(ЛицевойИдентификатор)), Строка(ТочкаСсылка.УникальныйИдентификатор()), XMLСтрока(ДатаУстановки), XMLСтрока(ДатаДопуска), НачальноеПоказание));
    Лицевой = НачатьОперациюСЛицевымСчетом(СсылкаУчетнойЗаписи, ЛицевойИдентификатор, "SubmitReading");
    Попытка
        ПолитикаДоступа.ПроверитьДоступКОбласти(СсылкаУчетнойЗаписи, Строка(Лицевой.РабочееПространство.УникальныйИдентификатор()), Строка(Лицевой.Область.УникальныйИдентификатор()), "BillingSpecialist");
        ЗаблокироватьОбъектПоСсылке("Справочник.ПаспортаПриборов", ПаспортСсылка);
        ЗаблокироватьКлючУстановки(ПаспортСсылка);
        Паспорт = ОбъектПаспортаПрибора(ПаспортСсылка, Лицевой.РабочееПространство, Лицевой.Область);
        Запрос = ОткрытьПривязкуЗапроса(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, "installation.create", Намерение);
        Если Запрос.Выбран() Тогда
            Результат = ДанныеСохраненногоПовтора(Запрос, Лицевой.РабочееПространство, Лицевой.Область, Лицевой.Ссылка);
            ЗафиксироватьТранзакцию();
            Возврат Результат;
        КонецЕсли;
        ТекущееВремя = ТекущаяУниверсальнаяДата();
        Если ДатаУстановки > ДатаДопуска Или ДатаДопуска > ТекущееВремя + 300 Тогда
            ВызватьИсключение "кабинет_счетчик_некорректно_даты";
        КонецЕсли;
        ПроверитьДействующийПаспорт(Паспорт, ТекущееВремя);
        Если Паспорт.СрокПоверки <= ДатаДопуска Тогда
            ВызватьИсключение "кабинет_счетчик_поверка_истекло";
        КонецЕсли;
        ПроверитьЗначениеПоПаспорту(НачальноеПоказание, Паспорт);
        Если ТочкаСсылка <> Лицевой.ТочкаОбслуживания Тогда
            ВызватьИсключение "кабинет_счетчик_связь_конфликт";
        КонецЕсли;
        Привязка = ПроверитьОтсутствиеАктивнойУстановки(ПаспортСсылка);
        Объект = Справочники.УстановкиПриборов.СоздатьЭлемент();
        Объект.SetNewObjectRef(Справочники.УстановкиПриборов.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
        ЗаполнитьСлужебныеОтметки(Объект, СсылкаУчетнойЗаписи, Лицевой.РабочееПространство, Лицевой.Область);
        Объект.Наименование = "Installation " + XMLСтрока(ДатаДопуска);
        Объект.Паспорт = ПаспортСсылка;
        Объект.ЛицевойСчет = Лицевой.Ссылка;
        Объект.ТочкаОбслуживания = Лицевой.ТочкаОбслуживания;
        Объект.ДатаУстановки = ДатаУстановки;
        Объект.ДатаДопуска = ДатаДопуска;
        Объект.НачальноеПоказание = НачальноеПоказание;
        Объект.Состояние = "Active";
        Объект.Записать();
        Привязка.УстановкаПрибора = Объект.Ссылка;
        Привязка.Записать();
        ЗаблокироватьУказательТекущейВерсии(Объект.Ссылка);
        ТекущаяВерсия = РегистрыСведений.ПоследниеПринятыеПоказания.СоздатьМенеджерЗаписи();
        ТекущаяВерсия.УстановкаПрибора = Объект.Ссылка;
        ТекущаяВерсия.Показание = Документы.ИзмерениеПрибора.ПустаяСсылка();
        ТекущаяВерсия.ДатаИзмерения = ДатаДопуска;
        ТекущаяВерсия.Значение = НачальноеПоказание;
        ТекущаяВерсия.КоличествоПринятых = 0;
        ТекущаяВерсия.Записать();
        ПривязатьКомандуЗапроса(Запрос, Объект.Ссылка);
        ПолитикаДоступа.ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, Лицевой.РабочееПространство, "meter.installation.create", Строка(Объект.Ссылка.УникальныйИдентификатор()));
        Результат = ДанныеУстановкиПрибора(Объект);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СписокУстановокПриборов(СсылкаУчетнойЗаписи, ЛицевойУчетнаяЗаписьИдентификатор, Лимит = Неопределено, Курсор = "") Экспорт
    Лицевой = НачатьОперациюСЛицевымСчетом(СсылкаУчетнойЗаписи, ЛицевойУчетнаяЗаписьИдентификатор, "Read");
    Попытка
        Запрос = Новый Запрос(
            "ВЫБРАТЬ ПЕРВЫЕ 100 Ссылка, РабочееПространство, Область, Паспорт, ЛицевойСчет, ТочкаОбслуживания,
            |ДатаУстановки, ДатаДопуска, НачальноеПоказание, Состояние, КемСоздано, ДатаСоздания, ДатаОбновления, Ревизия
            |ИЗ Справочник.УстановкиПриборов
            |ГДЕ ЛицевойСчет = &ЛицевойСчет И РабочееПространство = &РабочееПространство И Область = &Область
            |И ТочкаОбслуживания = &ТочкаОбслуживания И НЕ ПометкаУдаления
            |И Паспорт.РабочееПространство = РабочееПространство И Паспорт.Область = Область И НЕ Паспорт.ПометкаУдаления
            |И (Состояние = &Действующий ИЛИ Состояние = &Закрытый) УПОРЯДОЧИТЬ ПО ДатаДопуска, Ссылка");
        Запрос.УстановитьПараметр("ЛицевойСчет", Лицевой.Ссылка);
        Запрос.УстановитьПараметр("РабочееПространство", Лицевой.РабочееПространство);
        Запрос.УстановитьПараметр("Область", Лицевой.Область);
        Запрос.УстановитьПараметр("ТочкаОбслуживания", Лицевой.ТочкаОбслуживания);
        Запрос.УстановитьПараметр("Действующий", "Active");
        Запрос.УстановитьПараметр("Закрытый", "Closed");
        Страница = РеестрАбонентов.ПодготовитьСтраницу(Запрос, Лимит, Курсор, Новый Структура("actor,account,kind", Строка(СсылкаУчетнойЗаписи.УникальныйИдентификатор()), ЛицевойУчетнаяЗаписьИдентификатор, "installations"), Справочники.УстановкиПриборов.ПустаяСсылка());
        Выборка = Запрос.Выполнить().Выбрать();
        Результат = Новый Массив;
        Пока Выборка.Следующий() Цикл
            Результат.Добавить(ДанныеУстановкиПрибора(Выборка));
        КонецЦикла;
        Результат = РеестрАбонентов.ЗавершитьСтраницу(Результат, Страница);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПолучитьУстановкуПрибора(СсылкаУчетнойЗаписи, Идентификатор) Экспорт
    КонтекстДоступа = НачатьОперациюСУстановкой(СсылкаУчетнойЗаписи, Идентификатор, "Read");
    Попытка
        Результат = ДанныеУстановкиПрибора(КонтекстДоступа.Установка);
        Результат.Вставить("passport", ДанныеПаспортаПрибора(КонтекстДоступа.Паспорт));
        ТекущаяВерсия = ПрочитатьУказательТекущейВерсии(КонтекстДоступа.Установка);
        Результат.Вставить("acceptedHead", Новый Структура("readingId,measuredAt,value,acceptedCount",
            НеобязательныйИдентификатор(ТекущаяВерсия.Показание), ДатаDTOUTC(ТекущаяВерсия.ДатаИзмерения), ТекущаяВерсия.Значение, ТекущаяВерсия.КоличествоПринятых));
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПередатьПоказание(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, "meterInstallationId,measuredAt,value");
    УстановкаИдентификатор = ТекстовоеПоле(ТелоЗапроса, "meterInstallationId", 36);
    ДатаИзмерения = ПолеДатыUTC(ТелоЗапроса, "measuredAt");
    Значение = ПолеЧисловогоЗначения(ТелоЗапроса, "value", 3, 0, 999999999999.999);
    Намерение = КаноническоеПредставление(Новый Структура("meterInstallationId,measuredAt,value",
        Строка(РазобратьИдентификатор(УстановкаИдентификатор)), XMLСтрока(ДатаИзмерения), Значение));
    КонтекстДоступа = НачатьОперациюСУстановкой(СсылкаУчетнойЗаписи, УстановкаИдентификатор, "SubmitReading");
    Попытка
        ЗаблокироватьУказательТекущейВерсии(КонтекстДоступа.Установка.Ссылка);
        Запрос = ОткрытьПривязкуЗапроса(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, "reading.submit", Намерение);
        Если Запрос.Выбран() Тогда
            Результат = ДанныеСохраненногоПовтора(Запрос, КонтекстДоступа.Лицевой.РабочееПространство, КонтекстДоступа.Лицевой.Область, КонтекстДоступа.Установка.Ссылка);
            ЗафиксироватьТранзакцию();
            Возврат Результат;
        КонецЕсли;
        ТекущееВремя = ТекущаяУниверсальнаяДата();
        ПроверитьДействующуюУстановку(КонтекстДоступа, ТекущееВремя);
        Если ДатаИзмерения < КонтекстДоступа.Установка.ДатаДопуска Или ДатаИзмерения > ТекущееВремя + 300 Тогда
            ВызватьИсключение "кабинет_счетчик_некорректно_даты";
        КонецЕсли;
        ПроверитьЗначениеПоПаспорту(Значение, КонтекстДоступа.Паспорт);
        Существующий = ДатаИзмерения(КонтекстДоступа.Установка, ДатаИзмерения);
        Если Существующий <> Неопределено Тогда
            Если Существующий.Значение <> Значение Тогда
                ВызватьИсключение "кабинет_счетчик_временная_метка_конфликт";
            КонецЕсли;
            ПривязатьКомандуЗапроса(Запрос, Существующий.Ссылка);
            ПолитикаДоступа.ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, КонтекстДоступа.Лицевой.РабочееПространство, "meter.reading.duplicate", Строка(Существующий.Ссылка.УникальныйИдентификатор()));
            Результат = ДанныеПоказания(Существующий);
            ЗафиксироватьТранзакцию();
            Возврат Результат;
        КонецЕсли;
        ТекущаяВерсия = ПрочитатьУказательТекущейВерсии(КонтекстДоступа.Установка);
        ПроверитьЗначениеПоПаспорту(ТекущаяВерсия.Значение, КонтекстДоступа.Паспорт);
        Если ДатаИзмерения = ТекущаяВерсия.ДатаИзмерения Или ДатаИзмерения = КонтекстДоступа.Установка.ДатаДопуска Тогда
            ВызватьИсключение "кабинет_счетчик_временная_метка_конфликт";
        КонецЕсли;
        ПоказаниеСостояние = "Accepted";
        Расход = 0;
        ОснованиеПроверки = "";
        Если ДатаИзмерения < ТекущаяВерсия.ДатаИзмерения Тогда
            ПоказаниеСостояние = "LateReview";
            ОснованиеПроверки = "позднее_измерение_требует_проверка";
        Иначе
            Если Значение < ТекущаяВерсия.Значение Тогда
                ВызватьИсключение "кабинет_счетчик_показание_уменьшено";
            КонецЕсли;
            Расход = (Значение - ТекущаяВерсия.Значение) * КонтекстДоступа.Паспорт.Коэффициент;
        КонецЕсли;
        Объект = Документы.ИзмерениеПрибора.СоздатьДокумент();
        Объект.SetNewObjectRef(Документы.ИзмерениеПрибора.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
        ЗаполнитьСлужебныеОтметки(Объект, СсылкаУчетнойЗаписи, КонтекстДоступа.Лицевой.РабочееПространство, КонтекстДоступа.Лицевой.Область);
        Объект.Дата = ТекущееВремя;
        Объект.ЛицевойСчет = КонтекстДоступа.Лицевой.Ссылка;
        Объект.ТочкаОбслуживания = КонтекстДоступа.Лицевой.ТочкаОбслуживания;
        Объект.УстановкаПрибора = КонтекстДоступа.Установка.Ссылка;
        Объект.ДатаИзмерения = ДатаИзмерения;
        Объект.ДатаПолучения = ТекущееВремя;
        Объект.Значение = Значение;
        Объект.Канал = "Browser";
        Объект.Состояние = ПоказаниеСостояние;
        Объект.ОснованиеПроверки = ОснованиеПроверки;
        Объект.ПредыдущееПоказание = ТекущаяВерсия.Показание;
        Объект.ДатаПредыдущегоИзмерения = ТекущаяВерсия.ДатаИзмерения;
        Объект.ПредыдущееЗначение = ТекущаяВерсия.Значение;
        Объект.Расход = Расход;
        Объект.Коэффициент = КонтекстДоступа.Паспорт.Коэффициент;
        Объект.Записать();
        Если ПоказаниеСостояние = "Accepted" Тогда
            Если ТекущаяВерсия.КоличествоПринятых >= 999999999999999 Тогда
                ВызватьИсключение "кабинет_счетчик_привязка_конфликт";
            КонецЕсли;
            ТекущаяВерсия.Показание = Объект.Ссылка;
            ТекущаяВерсия.ДатаИзмерения = ДатаИзмерения;
            ТекущаяВерсия.Значение = Значение;
            ТекущаяВерсия.КоличествоПринятых = ТекущаяВерсия.КоличествоПринятых + 1;
            ТекущаяВерсия.Записать();
        КонецЕсли;
        ПривязатьКомандуЗапроса(Запрос, Объект.Ссылка);
        ПолитикаДоступа.ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, КонтекстДоступа.Лицевой.РабочееПространство, "meter.reading.submit", Строка(Объект.Ссылка.УникальныйИдентификатор()));
        Результат = ДанныеПоказания(Объект);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПолучитьСписокПоказаний(СсылкаУчетнойЗаписи, УстановкаИдентификатор, Лимит = Неопределено, Курсор = "") Экспорт
    КонтекстДоступа = НачатьОперациюСУстановкой(СсылкаУчетнойЗаписи, УстановкаИдентификатор, "Read");
    Попытка
        Запрос = Новый Запрос(
            "ВЫБРАТЬ ПЕРВЫЕ 1000 Ссылка, РабочееПространство, Область, ЛицевойСчет, ТочкаОбслуживания, УстановкаПрибора,
            |ДатаИзмерения, ДатаПолучения, ЗНАЧЕНИЕ, Канал, Состояние, ОснованиеПроверки, ПредыдущееПоказание,
            |ДатаПредыдущегоИзмерения, ПредыдущееЗначение, Расход, Коэффициент, КемСоздано, ДатаСоздания, ДатаОбновления, Ревизия
            |ИЗ Документ.ИзмерениеПрибора
            |ГДЕ УстановкаПрибора = &Установка И ЛицевойСчет = &ЛицевойСчет
            |И РабочееПространство = &РабочееПространство И Область = &Область И ТочкаОбслуживания = &ТочкаОбслуживания
            |И НЕ ПометкаУдаления И (Состояние = &Принятый ИЛИ Состояние = &ПозднийПроверкаРезультата)
            |УПОРЯДОЧИТЬ ПО ДатаИзмерения, ДатаПолучения, Ссылка");
        Запрос.УстановитьПараметр("Установка", КонтекстДоступа.Установка.Ссылка);
        Запрос.УстановитьПараметр("ЛицевойСчет", КонтекстДоступа.Лицевой.Ссылка);
        Запрос.УстановитьПараметр("РабочееПространство", КонтекстДоступа.Лицевой.РабочееПространство);
        Запрос.УстановитьПараметр("Область", КонтекстДоступа.Лицевой.Область);
        Запрос.УстановитьПараметр("ТочкаОбслуживания", КонтекстДоступа.Лицевой.ТочкаОбслуживания);
        Запрос.УстановитьПараметр("Принятый", "Accepted");
        Запрос.УстановитьПараметр("ПозднийПроверкаРезультата", "LateReview");
        Страница = РеестрАбонентов.ПодготовитьСтраницу(Запрос, Лимит, Курсор, Новый Структура("actor,installation,kind", Строка(СсылкаУчетнойЗаписи.УникальныйИдентификатор()), УстановкаИдентификатор, "readings"), Документы.ИзмерениеПрибора.ПустаяСсылка());
        Выборка = Запрос.Выполнить().Выбрать();
        Результат = Новый Массив;
        Пока Выборка.Следующий() Цикл
            Результат.Добавить(ДанныеПоказания(Выборка));
        КонецЦикла;
        Результат = РеестрАбонентов.ЗавершитьСтраницу(Результат, Страница);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ЗапроситьКорректировкуПоказания(СсылкаУчетнойЗаписи, ПоказаниеИдентификатор, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, "reason,proposedValue,proposedMeasuredAt");
    ПоказаниеСсылка = Документы.ИзмерениеПрибора.ПолучитьСсылку(РазобратьИдентификатор(ПоказаниеИдентификатор));
    Причина = ТекстовоеПоле(ТелоЗапроса, "reason", 2000);
    ПредлагаемоеЗначение = ПолеЧисловогоЗначения(ТелоЗапроса, "proposedValue", 3, 0, 999999999999.999);
    ПредлагаемаяДатаИзмерения = ПолеДатыUTC(ТелоЗапроса, "proposedMeasuredAt");
    ПредварительныйСнимок = ПредставлениеПоказания(ПоказаниеСсылка);
    КонтекстДоступа = НачатьОперациюСУстановкой(СсылкаУчетнойЗаписи, Строка(ПредварительныйСнимок.УстановкаПрибора.УникальныйИдентификатор()), "SubmitReading");
    Попытка
        ЗаблокироватьОбъектПоСсылке("Документ.ИзмерениеПрибора", ПоказаниеСсылка);
        Исходный = ПоказаниеСсылка.ПолучитьОбъект();
        Если Исходный = Неопределено Тогда
            ВызватьИсключение "кабинет_счетчик_не_найдено";
        КонецЕсли;
        ПроверкаПринятия = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Показание ИЗ РегистрСведений.ДействующиеКорректировкиПоказаний ГДЕ Показание = &Показание");
        ПроверкаПринятия.УстановитьПараметр("Показание", ПоказаниеСсылка);
        ПринятоПослеПроверки = Не ПроверкаПринятия.Выполнить().Пустой();
        Если Исходный.ПометкаУдаления Или (Исходный.Состояние <> "Accepted" И Не ПринятоПослеПроверки)
            Или Исходный.УстановкаПрибора <> КонтекстДоступа.Установка.Ссылка
            Или Исходный.ЛицевойСчет <> КонтекстДоступа.Лицевой.Ссылка
            Или Исходный.РабочееПространство <> КонтекстДоступа.Лицевой.РабочееПространство Или Исходный.Область <> КонтекстДоступа.Лицевой.Область Тогда
            ВызватьИсключение "кабинет_счетчик_не_найдено";
        КонецЕсли;
        Намерение = КаноническоеПредставление(Новый Структура("readingId,reason,proposedValue,proposedMeasuredAt",
            Строка(ПоказаниеСсылка.УникальныйИдентификатор()), Причина, ПредлагаемоеЗначение, XMLСтрока(ПредлагаемаяДатаИзмерения)));
        Запрос = ОткрытьПривязкуЗапроса(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, "correction.request", Намерение);
        Если Запрос.Выбран() Тогда
            Результат = ДанныеСохраненногоПовтора(Запрос, КонтекстДоступа.Лицевой.РабочееПространство, КонтекстДоступа.Лицевой.Область, ПоказаниеСсылка);
            ЗафиксироватьТранзакцию();
            Возврат Результат;
        КонецЕсли;
        Если ПредлагаемаяДатаИзмерения < КонтекстДоступа.Установка.ДатаДопуска Или ПредлагаемаяДатаИзмерения > ТекущаяУниверсальнаяДата() + 300 Тогда
            ВызватьИсключение "кабинет_счетчик_некорректно_даты";
        КонецЕсли;
        ПроверитьЗначениеПоПаспорту(ПредлагаемоеЗначение, КонтекстДоступа.Паспорт);
        Объект = Справочники.ЗаявкиКорректировкиПоказаний.СоздатьЭлемент();
        Объект.SetNewObjectRef(Справочники.ЗаявкиКорректировкиПоказаний.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
        ЗаполнитьСлужебныеОтметки(Объект, СсылкаУчетнойЗаписи, КонтекстДоступа.Лицевой.РабочееПространство, КонтекстДоступа.Лицевой.Область);
        Объект.Наименование = "Pending reading correction";
        Объект.ЛицевойСчет = КонтекстДоступа.Лицевой.Ссылка;
        Объект.УстановкаПрибора = КонтекстДоступа.Установка.Ссылка;
        Объект.ЦелевоеПоказание = ПоказаниеСсылка;
        Объект.ПредлагаемоеЗначение = ПредлагаемоеЗначение;
        Объект.ПредлагаемаяДатаИзмерения = ПредлагаемаяДатаИзмерения;
        Объект.Причина = Причина;
        Объект.Состояние = "Pending";
        Объект.Записать();
        ПривязатьКомандуЗапроса(Запрос, Объект.Ссылка);
        ПолитикаДоступа.ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, КонтекстДоступа.Лицевой.РабочееПространство, "meter.correction.request", Строка(Объект.Ссылка.УникальныйИдентификатор()));
        Результат = ДанныеКорректировки(Объект);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПринятыйРяд(Установка)
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 10001 П.Ссылка КАК Ссылка, П.ДатаПолучения КАК ДатаПолучения,
        |П.ДатаИзмерения КАК ИсходнаяДата, П.Значение КАК ИсходноеЗначение,
        |ЕСТЬNULL(К.ДатаИзмерения, П.ДатаИзмерения) КАК ДатаИзмерения,
        |ЕСТЬNULL(К.Значение, П.Значение) КАК Значение, П.Коэффициент КАК Коэффициент
        |ИЗ Документ.ИзмерениеПрибора КАК П
        |ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДействующиеКорректировкиПоказаний КАК К ПО К.Показание = П.Ссылка
        |ГДЕ П.УстановкаПрибора = &Установка И НЕ П.ПометкаУдаления
        |И (П.Состояние = &Принято ИЛИ К.Решение ЕСТЬ НЕ NULL)");
    Запрос.УстановитьПараметр("Установка", Установка.Ссылка);
    Запрос.УстановитьПараметр("Принято", "Accepted");
    Ряд = Запрос.Выполнить().Выгрузить();
    Если Ряд.Количество() > 10000 Тогда ВызватьИсключение "кабинет_счетчик_проверка_лимит"; КонецЕсли;
    Ряд.Сортировать("ДатаИзмерения, Ссылка");
    Ряд.Колонки.Добавить("Расход");
    Ряд.Колонки.Добавить("ПредыдущаяДата");
    Ряд.Колонки.Добавить("ПредыдущееЗначение");
    Предыдущее = Установка.НачальноеПоказание;
    ПредыдущаяДата = Установка.ДатаДопуска;
    Для Каждого СтрокаРяда Из Ряд Цикл
        Если СтрокаРяда.ДатаИзмерения <= ПредыдущаяДата Или СтрокаРяда.Значение < Предыдущее Тогда
            ВызватьИсключение "кабинет_счетчик_проверка_последовательность_конфликт";
        КонецЕсли;
        СтрокаРяда.Расход = (СтрокаРяда.Значение - Предыдущее) * СтрокаРяда.Коэффициент;
        СтрокаРяда.ПредыдущаяДата = ПредыдущаяДата;
        СтрокаРяда.ПредыдущееЗначение = Предыдущее;
        Предыдущее = СтрокаРяда.Значение;
        ПредыдущаяДата = СтрокаРяда.ДатаИзмерения;
    КонецЦикла;
    Возврат Ряд;
КонецФункции

Функция РассмотретьПоказание(УчетнаяЗапись, ПоказаниеИдентификатор, Тело, Команда) Экспорт
    ПроверитьПоляТелаЗапроса(Тело, "decision,reason,value,measuredAt,correctionId");
    Решение = ТекстовоеПоле(Тело, "decision", 16);
    Если Решение <> "Approve" И Решение <> "Reject" Тогда ВызватьИсключение "кабинет_счетчик_некорректно_поле"; КонецЕсли;
    Причина = ТекстовоеПоле(Тело, "reason", 2000);
    Значение = ПолеЧисловогоЗначения(Тело, "value", 3, 0, 999999999999.999);
    Дата = ПолеДатыUTC(Тело, "measuredAt");
    Заявка = Справочники.ЗаявкиКорректировкиПоказаний.ПустаяСсылка();
    ИдентификаторЗаявки = "";
    Если Тело.Свойство("correctionId", ИдентификаторЗаявки) И ИдентификаторЗаявки <> "" Тогда
        Заявка = Справочники.ЗаявкиКорректировкиПоказаний.ПолучитьСсылку(РазобратьИдентификатор(ИдентификаторЗаявки));
    КонецЕсли;
    Ссылка = Документы.ИзмерениеПрибора.ПолучитьСсылку(РазобратьИдентификатор(ПоказаниеИдентификатор));
    Предварительно = ПредставлениеПоказания(Ссылка);
    Контекст = НачатьОперациюСУстановкой(УчетнаяЗапись, Строка(Предварительно.УстановкаПрибора.УникальныйИдентификатор()), "Read");
    Попытка
        ПолитикаДоступа.ПроверитьДоступКОбласти(УчетнаяЗапись, Строка(Контекст.Лицевой.РабочееПространство.УникальныйИдентификатор()), Строка(Контекст.Лицевой.Область.УникальныйИдентификатор()), "BillingSpecialist");
        ЗаблокироватьУказательТекущейВерсии(Контекст.Установка.Ссылка);
        Показание = Ссылка.ПолучитьОбъект();
        ПроверитьПринадлежностьПоказания(Показание, Контекст);
        Намерение = КаноническоеПредставление(Новый Структура("readingId,decision,reason,value,measuredAt,correctionId",
            ПоказаниеИдентификатор, Решение, Причина, Значение, XMLСтрока(Дата), ИдентификаторЗаявки));
        Привязка = ОткрытьПривязкуЗапроса(УчетнаяЗапись, Команда, "reading.review", Намерение);
        Если Привязка.Выбран() Тогда
            Сохраненное = Справочники.РешенияПроверкиПоказаний.ПолучитьСсылку(РазобратьИдентификатор(Привязка.ИдентификаторРезультата)).ПолучитьОбъект();
            Если Сохраненное = Неопределено Тогда ВызватьИсключение "кабинет_счетчик_привязка_конфликт"; КонецЕсли;
            Если Сохраненное.Показание <> Ссылка Тогда ВызватьИсключение "кабинет_счетчик_привязка_конфликт"; КонецЕсли;
            Результат = ДанныеРешения(Сохраненное);
        Иначе
            Если Показание.Состояние <> "LateReview" И Не ЗначениеЗаполнено(Заявка) Тогда ВызватьИсключение "кабинет_счетчик_проверка_запрос_требуется"; КонецЕсли;
            Если ЗначениеЗаполнено(Заявка) Тогда
                ОбъектЗаявки = Заявка.ПолучитьОбъект();
                Если ОбъектЗаявки = Неопределено Тогда ВызватьИсключение "кабинет_счетчик_не_найдено"; КонецЕсли;
                Если ОбъектЗаявки.ПометкаУдаления Или ОбъектЗаявки.Состояние <> "Pending" Или ОбъектЗаявки.ЦелевоеПоказание <> Ссылка
                    Или ОбъектЗаявки.УстановкаПрибора <> Контекст.Установка.Ссылка Тогда ВызватьИсключение "кабинет_счетчик_проверка_состояние_конфликт"; КонецЕсли;
                Если Значение <> ОбъектЗаявки.ПредлагаемоеЗначение Или Дата <> ОбъектЗаявки.ПредлагаемаяДатаИзмерения Тогда
                    ВызватьИсключение "кабинет_счетчик_проверка_запрос_конфликт";
                КонецЕсли;
            Иначе
                Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.РешенияПроверкиПоказаний ГДЕ Показание = &Показание");
                Запрос.УстановитьПараметр("Показание", Ссылка);
                Если Не Запрос.Выполнить().Пустой() Тогда ВызватьИсключение "кабинет_счетчик_проверка_состояние_конфликт"; КонецЕсли;
                Если Значение <> Показание.Значение Или Дата <> Показание.ДатаИзмерения Тогда ВызватьИсключение "кабинет_счетчик_проверка_запрос_конфликт"; КонецЕсли;
            КонецЕсли;
            Если Дата <= Контекст.Установка.ДатаДопуска Или Дата > ТекущаяУниверсальнаяДата() + 300 Тогда ВызватьИсключение "кабинет_счетчик_некорректно_даты"; КонецЕсли;
            ПроверитьЗначениеПоПаспорту(Значение, Контекст.Паспорт);
            Объект = Справочники.РешенияПроверкиПоказаний.СоздатьЭлемент();
            Объект.SetNewObjectRef(Справочники.РешенияПроверкиПоказаний.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
            ЗаполнитьСлужебныеОтметки(Объект, УчетнаяЗапись, Контекст.Лицевой.РабочееПространство, Контекст.Лицевой.Область);
            Объект.Наименование = "Reading review";
            Объект.УстановкаПрибора = Контекст.Установка.Ссылка;
            Объект.Показание = Ссылка; Объект.Заявка = Заявка;
            Объект.Решение = Решение; Объект.Причина = Причина;
            Объект.Значение = Значение; Объект.ДатаИзмерения = Дата;
            Объект.Записать();
            Если Решение = "Approve" Тогда
                Проекция = РегистрыСведений.ДействующиеКорректировкиПоказаний.СоздатьМенеджерЗаписи();
                Проекция.Показание = Ссылка; Проекция.Прочитать(); Проекция.Показание = Ссылка;
                Проекция.Решение = Объект.Ссылка; Проекция.Значение = Значение; Проекция.ДатаИзмерения = Дата;
                Проекция.Записать();
                Указатель = ПрочитатьУказательТекущейВерсии(Контекст.Установка);
                Указатель.Записать();
            КонецЕсли;
            Если ЗначениеЗаполнено(Заявка) Тогда
                ОбъектЗаявки.Состояние = ?(Решение = "Approve", "Approved", "Rejected");
                ОбъектЗаявки.Ревизия = ОбъектЗаявки.Ревизия + 1;
                ОбъектЗаявки.ДатаОбновления = ТекущаяУниверсальнаяДата();
                ОбъектЗаявки.Записать();
            КонецЕсли;
            ПривязатьКомандуЗапроса(Привязка, Объект.Ссылка);
            ПолитикаДоступа.ЗаписатьСобытиеАудита(УчетнаяЗапись, Контекст.Лицевой.РабочееПространство, "meter.reading.review", Строка(Объект.Ссылка.УникальныйИдентификатор()));
            СервисУведомлений.СоздатьСобытие(Показание.КемСоздано, "result", "meter.review." + Строка(Объект.Ссылка.УникальныйИдентификатор()), ПоказаниеИдентификатор, Решение, Контекст.Лицевой.РабочееПространство);
            Результат = ДанныеРешения(Объект);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СписокПроверокПоказаний(УчетнаяЗапись, УстановкаИдентификатор, Вид = "requests", Лимит = "", Курсор = "") Экспорт
    Контекст = НачатьОперациюСУстановкой(УчетнаяЗапись, УстановкаИдентификатор, "Read");
    Попытка
        Если Вид = "requests" Тогда
            Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 100 * ИЗ Справочник.ЗаявкиКорректировкиПоказаний ГДЕ УстановкаПрибора = &Установка И НЕ ПометкаУдаления УПОРЯДОЧИТЬ ПО Ссылка");
            Пустая = Справочники.ЗаявкиКорректировкиПоказаний.ПустаяСсылка();
        ИначеЕсли Вид = "decisions" Тогда
            Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 100 * ИЗ Справочник.РешенияПроверкиПоказаний ГДЕ УстановкаПрибора = &Установка И НЕ ПометкаУдаления УПОРЯДОЧИТЬ ПО Ссылка");
            Пустая = Справочники.РешенияПроверкиПоказаний.ПустаяСсылка();
        Иначе
            ВызватьИсключение "кабинет_счетчик_некорректно_поле";
        КонецЕсли;
        Запрос.УстановитьПараметр("Установка", Контекст.Установка.Ссылка);
        Страница = РеестрАбонентов.ПодготовитьСтраницу(Запрос, Лимит, Курсор, Новый Структура("actor,installation,kind",
            Строка(УчетнаяЗапись.УникальныйИдентификатор()), УстановкаИдентификатор, Вид), Пустая);
        Выборка = Запрос.Выполнить().Выбрать();
        Строки = Новый Массив;
        Пока Выборка.Следующий() Цикл
            Если Выборка.РабочееПространство <> Контекст.Лицевой.РабочееПространство Или Выборка.Область <> Контекст.Лицевой.Область Тогда ВызватьИсключение "кабинет_счетчик_привязка_конфликт"; КонецЕсли;
            Если Вид = "requests" Тогда Строки.Добавить(ДанныеКорректировки(Выборка)); Иначе Строки.Добавить(ДанныеРешения(Выборка)); КонецЕсли;
        КонецЦикла;
        Результат = РеестрАбонентов.ЗавершитьСтраницу(Строки, Страница);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ДанныеРешения(Объект)
    Результат = ОбщиеДанныеОбъекта(Объект);
    Результат.Вставить("readingId", Строка(Объект.Показание.УникальныйИдентификатор()));
    Результат.Вставить("correctionId", НеобязательныйИдентификатор(Объект.Заявка));
    Результат.Вставить("decision", Объект.Решение);
    Результат.Вставить("reason", Объект.Причина);
    Результат.Вставить("value", Объект.Значение);
    Результат.Вставить("measuredAt", ДатаDTOUTC(Объект.ДатаИзмерения));
    Возврат Результат;
КонецФункции

Функция ПолучитьПринятыйРяд(УчетнаяЗапись, УстановкаИдентификатор, Лимит = "", Курсор = "") Экспорт
    Контекст = НачатьОперациюСУстановкой(УчетнаяЗапись, УстановкаИдентификатор, "Read");
    Попытка
        Ряд = ПринятыйРяд(Контекст.Установка);
        Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 100 Ссылка ИЗ Документ.ИзмерениеПрибора ГДЕ УстановкаПрибора = &Установка УПОРЯДОЧИТЬ ПО Ссылка");
        Запрос.УстановитьПараметр("Установка", Контекст.Установка.Ссылка);
        Страница = РеестрАбонентов.ПодготовитьСтраницу(Запрос, Лимит, Курсор, Новый Структура("actor,installation,kind",
            Строка(УчетнаяЗапись.УникальныйИдентификатор()), УстановкаИдентификатор, "accepted-series"), Документы.ИзмерениеПрибора.ПустаяСсылка());
        Ссылки = Ряд.ВыгрузитьКолонку("Ссылка");
        Запрос.Текст = СтрЗаменить(Запрос.Текст, "ГДЕ УстановкаПрибора = &Установка", "ГДЕ УстановкаПрибора = &Установка И Ссылка В (&ПринятыеСсылки)");
        Запрос.УстановитьПараметр("ПринятыеСсылки", Ссылки);
        Выборка = Запрос.Выполнить().Выбрать();
        Строки = Новый Массив;
        Пока Выборка.Следующий() Цикл
            СтрокаРяда = Ряд.Найти(Выборка.Ссылка, "Ссылка");
            Строки.Добавить(Новый Структура("id,measuredAt,receivedAt,value,originalMeasuredAt,originalValue,previousMeasuredAt,previousValue,consumption,coefficient",
                Строка(СтрокаРяда.Ссылка.УникальныйИдентификатор()), ДатаDTOUTC(СтрокаРяда.ДатаИзмерения), ДатаDTOUTC(СтрокаРяда.ДатаПолучения),
                СтрокаРяда.Значение, ДатаDTOUTC(СтрокаРяда.ИсходнаяДата), СтрокаРяда.ИсходноеЗначение, ДатаDTOUTC(СтрокаРяда.ПредыдущаяДата),
                СтрокаРяда.ПредыдущееЗначение, СтрокаРяда.Расход, СтрокаРяда.Коэффициент));
        КонецЦикла;
        Результат = РеестрАбонентов.ЗавершитьСтраницу(Строки, Страница);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ЗагрузитьФотоПоказания(УчетнаяЗапись, ПоказаниеИдентификатор, Тело, Команда) Экспорт
    Ссылка = Документы.ИзмерениеПрибора.ПолучитьСсылку(РазобратьИдентификатор(ПоказаниеИдентификатор));
    Предварительно = ПредставлениеПоказания(Ссылка);
    Контекст = НачатьОперациюСУстановкой(УчетнаяЗапись, Строка(Предварительно.УстановкаПрибора.УникальныйИдентификатор()), "SubmitReading");
    Попытка
        ЗаблокироватьОбъектПоСсылке("Документ.ИзмерениеПрибора", Ссылка);
        Показание = Ссылка.ПолучитьОбъект();
        ПроверитьПринадлежностьПоказания(Показание, Контекст);
        Вход = СервисФайлов.ПроверитьБайтыФотографии(Тело);
        Намерение = КаноническоеПредставление(Новый Структура("readingId,filename,mime,hash",
            ПоказаниеИдентификатор, Вход.ИмяФайла, Вход.ТипMIME, Вход.Содержимое.ХешSHA256));
        Привязка = ОткрытьПривязкуЗапроса(УчетнаяЗапись, Команда, "reading.photo", Намерение);
        Если Привязка.Выбран() Тогда
            Фото = Справочники.ФотографииПоказаний.ПолучитьСсылку(РазобратьИдентификатор(Привязка.ИдентификаторРезультата)).ПолучитьОбъект();
            Если Фото = Неопределено Тогда ВызватьИсключение "кабинет_счетчик_привязка_конфликт"; КонецЕсли;
            Если Фото.Показание <> Ссылка Или Фото.УстановкаПрибора <> Контекст.Установка.Ссылка Тогда ВызватьИсключение "кабинет_счетчик_привязка_конфликт"; КонецЕсли;
        Иначе
            Проверка = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ФотографииПоказаний ГДЕ Показание = &Показание");
            Проверка.УстановитьПараметр("Показание", Ссылка);
            Если Не Проверка.Выполнить().Пустой() Тогда ВызватьИсключение "кабинет_счетчик_фото_существует"; КонецЕсли;
            Область = Новый Структура("РабочееПространство,Область", Контекст.Лицевой.РабочееПространство, Контекст.Лицевой.Область);
            СервисФайлов.ПроверитьОбщуюКвотуВложений(Область, Вход.Содержимое.КоличествоБайт);
            Фото = Справочники.ФотографииПоказаний.СоздатьЭлемент();
            Фото.SetNewObjectRef(Справочники.ФотографииПоказаний.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
            ЗаполнитьСлужебныеОтметки(Фото, УчетнаяЗапись, Область.РабочееПространство, Область.Область);
            Фото.Наименование = "Reading photo";
            Фото.Показание = Ссылка;
            Фото.УстановкаПрибора = Контекст.Установка.Ссылка;
            Фото.ИмяФайла = Вход.ИмяФайла;
            Фото.ТипMIME = Вход.ТипMIME;
            Фото.КоличествоБайт = Вход.Содержимое.КоличествоБайт;
            Фото.ХешSHA256 = Вход.Содержимое.ХешSHA256;
            Фото.ДвоичныеДанные = Новый ХранилищеЗначения(Вход.Содержимое.Данные);
            Фото.Записать();
            ПривязатьКомандуЗапроса(Привязка, Фото.Ссылка);
            ПолитикаДоступа.ЗаписатьСобытиеАудита(УчетнаяЗапись, Область.РабочееПространство, "meter.photo.create", Строка(Фото.Ссылка.УникальныйИдентификатор()));
        КонецЕсли;
        Результат = МетаданныеФото(Фото);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПолучитьФотоПоказания(УчетнаяЗапись, ПоказаниеИдентификатор, Скачать = Ложь) Экспорт
    Ссылка = Документы.ИзмерениеПрибора.ПолучитьСсылку(РазобратьИдентификатор(ПоказаниеИдентификатор));
    Предварительно = ПредставлениеПоказания(Ссылка);
    Контекст = НачатьОперациюСУстановкой(УчетнаяЗапись, Строка(Предварительно.УстановкаПрибора.УникальныйИдентификатор()), "Read");
    Попытка
        ПроверитьПринадлежностьПоказания(Ссылка.ПолучитьОбъект(), Контекст);
        Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2 Ссылка ИЗ Справочник.ФотографииПоказаний ГДЕ Показание = &Показание И НЕ ПометкаУдаления");
        Запрос.УстановитьПараметр("Показание", Ссылка);
        Выборка = Запрос.Выполнить().Выбрать();
        Если Не Выборка.Следующий() Тогда ВызватьИсключение "кабинет_счетчик_не_найдено"; КонецЕсли;
        Фото = Выборка.Ссылка.ПолучитьОбъект();
        Если Выборка.Следующий() Тогда ВызватьИсключение "кабинет_счетчик_привязка_конфликт"; КонецЕсли;
        Если Фото.РабочееПространство <> Контекст.Лицевой.РабочееПространство Или Фото.Область <> Контекст.Лицевой.Область
            Или Фото.УстановкаПрибора <> Контекст.Установка.Ссылка Тогда ВызватьИсключение "кабинет_счетчик_привязка_конфликт"; КонецЕсли;
        Результат = МетаданныеФото(Фото);
        Если Скачать Тогда
            Байты = Фото.ДвоичныеДанные.Получить();
            Если ТипЗнч(Байты) <> Тип("ДвоичныеДанные") Тогда ВызватьИсключение "кабинет_счетчик_привязка_конфликт"; КонецЕсли;
            Если Байты.Размер() <> Фото.КоличествоБайт Тогда ВызватьИсключение "кабинет_счетчик_привязка_конфликт"; КонецЕсли;
            Хеш = Новый ХешированиеДанных(ХешФункция.SHA256); Хеш.Добавить(Байты);
            Если СтрЗаменить(СтрЗаменить(Base64Строка(Хеш.ХешСумма), Символ(13), ""), Символ(10), "") <> Фото.ХешSHA256 Тогда
                ВызватьИсключение "кабинет_счетчик_привязка_конфликт";
            КонецЕсли;
            Результат.Вставить("binary", Байты);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Процедура ПроверитьПринадлежностьПоказания(Показание, Контекст)
    Если Показание = Неопределено Тогда ВызватьИсключение "кабинет_счетчик_не_найдено"; КонецЕсли;
    Если Показание.ПометкаУдаления Или Показание.УстановкаПрибора <> Контекст.Установка.Ссылка
        Или Показание.РабочееПространство <> Контекст.Лицевой.РабочееПространство Или Показание.Область <> Контекст.Лицевой.Область
        Или Показание.ЛицевойСчет <> Контекст.Лицевой.Ссылка Тогда ВызватьИсключение "кабинет_счетчик_не_найдено"; КонецЕсли;
КонецПроцедуры

Функция МетаданныеФото(Фото)
    Возврат Новый Структура("id,readingId,filename,mime,size,sha256,createdAt",
        Строка(Фото.Ссылка.УникальныйИдентификатор()), Строка(Фото.Показание.УникальныйИдентификатор()),
        Фото.ИмяФайла, Фото.ТипMIME, Фото.КоличествоБайт, Фото.ХешSHA256, ДатаDTOUTC(Фото.ДатаСоздания));
КонецФункции

Функция НачатьОперациюСотрудника(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор)
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьОтсутствиеТранзакции();
    СсылкаРабочейОбласти = Справочники.РабочиеПространства.ПолучитьСсылку(РазобратьИдентификатор(РабочаяОбластьИдентификатор));
    СсылкаОбласти = Справочники.Области.ПолучитьСсылку(РазобратьИдентификатор(ОбластьИдентификатор));
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьОбъектПоСсылке("Справочник.УчетныеЗаписи", СсылкаУчетнойЗаписи);
        ЗаблокироватьОбъектПоСсылке("Справочник.РабочиеПространства", СсылкаРабочейОбласти);
        ЗаблокироватьОбъектПоСсылке("Справочник.Области", СсылкаОбласти);
        ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
        ПолитикаДоступа.ПроверитьДоступКОбласти(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, "BillingSpecialist");
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Новый Структура("РабочееПространство,Область", СсылкаРабочейОбласти, СсылкаОбласти);
КонецФункции

Функция НачатьОперациюСЛицевымСчетом(СсылкаУчетнойЗаписи, ЛицевойУчетнаяЗаписьИдентификатор, Полномочие)
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьОтсутствиеТранзакции();
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        Лицевой = ДоступКЛицевымСчетам.ПроверитьЛицевойСчет(СсылкаУчетнойЗаписи, ЛицевойУчетнаяЗаписьИдентификатор, Полномочие);
        ЗаблокироватьОбъектПоСсылке("Справочник.ЛицевыеСчета", Лицевой.Ссылка);
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Лицевой;
КонецФункции

Функция НачатьОперациюСУстановкой(СсылкаУчетнойЗаписи, Идентификатор, Полномочие)
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    УстановкаСсылка = Справочники.УстановкиПриборов.ПолучитьСсылку(РазобратьИдентификатор(Идентификатор));
    ПредварительныйСнимок = ПредставлениеУстановкиПрибора(УстановкаСсылка);
    Лицевой = НачатьОперациюСЛицевымСчетом(СсылкаУчетнойЗаписи, Строка(ПредварительныйСнимок.ЛицевойСчет.УникальныйИдентификатор()), Полномочие);
    Попытка
        ЗаблокироватьОбъектПоСсылке("Справочник.ПаспортаПриборов", ПредварительныйСнимок.Паспорт);
        ЗаблокироватьКлючУстановки(ПредварительныйСнимок.Паспорт);
        ЗаблокироватьОбъектПоСсылке("Справочник.УстановкиПриборов", УстановкаСсылка);
        Объект = УстановкаСсылка.ПолучитьОбъект();
        Если Объект = Неопределено Тогда
            ВызватьИсключение "кабинет_счетчик_не_найдено";
        КонецЕсли;
        Если Объект.ПометкаУдаления Или Объект.ЛицевойСчет <> Лицевой.Ссылка
            Или Объект.РабочееПространство <> Лицевой.РабочееПространство Или Объект.Область <> Лицевой.Область
            Или Объект.ТочкаОбслуживания <> Лицевой.ТочкаОбслуживания Или Объект.Паспорт <> ПредварительныйСнимок.Паспорт
            Или (Объект.Состояние <> "Active" И Объект.Состояние <> "Closed") Тогда
            ВызватьИсключение "кабинет_счетчик_не_найдено";
        КонецЕсли;
        Паспорт = ОбъектПаспортаПрибора(Объект.Паспорт, Лицевой.РабочееПространство, Лицевой.Область);
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Новый Структура("Лицевой,Установка,Паспорт", Лицевой, Объект, Паспорт);
КонецФункции

Функция ПредставлениеУстановкиПрибора(ИдентификаторСсылки)
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 ЛицевойСчет, Паспорт ИЗ Справочник.УстановкиПриборов ГДЕ Ссылка = &ИдентификаторСсылки И НЕ ПометкаУдаления");
    Запрос.УстановитьПараметр("ИдентификаторСсылки", ИдентификаторСсылки);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Тогда
        ВызватьИсключение "кабинет_счетчик_не_найдено";
    КонецЕсли;
    Возврат Новый Структура("ЛицевойСчет,Паспорт", Выборка.ЛицевойСчет, Выборка.Паспорт);
КонецФункции

Функция ПредставлениеПоказания(ИдентификаторСсылки)
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 УстановкаПрибора ИЗ Документ.ИзмерениеПрибора ГДЕ Ссылка = &ИдентификаторСсылки И НЕ ПометкаУдаления");
    Запрос.УстановитьПараметр("ИдентификаторСсылки", ИдентификаторСсылки);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Тогда
        ВызватьИсключение "кабинет_счетчик_не_найдено";
    КонецЕсли;
    Возврат Новый Структура("УстановкаПрибора", Выборка.УстановкаПрибора);
КонецФункции

Функция ОбъектПаспортаПрибора(ИдентификаторСсылки, СсылкаРабочейОбласти, СсылкаОбласти)
    Объект = ИдентификаторСсылки.ПолучитьОбъект();
    Если Объект = Неопределено Тогда
        ВызватьИсключение "кабинет_счетчик_не_найдено";
    КонецЕсли;
    Если Объект.ПометкаУдаления Или Объект.РабочееПространство <> СсылкаРабочейОбласти Или Объект.Область <> СсылкаОбласти Тогда
        ВызватьИсключение "кабинет_счетчик_не_найдено";
    КонецЕсли;
    Возврат Объект;
КонецФункции

Процедура ПроверитьДействующийПаспорт(Паспорт, ТекущееВремя)
    Если Паспорт.Состояние <> "Active" Тогда
        ВызватьИсключение "кабинет_счетчик_неактивно";
    КонецЕсли;
    Если Паспорт.СрокПоверки <= ТекущееВремя Тогда
        ВызватьИсключение "кабинет_счетчик_поверка_истекло";
    КонецЕсли;
    Если Паспорт.ЕдиницаИзмерения <> "m3" Или Паспорт.РазрядностьШкалы <> Цел(Паспорт.РазрядностьШкалы)
        Или Паспорт.РазрядностьШкалы < 1 Или Паспорт.РазрядностьШкалы > 12
        Или Паспорт.Коэффициент <= 0 Или Паспорт.Коэффициент > 1000000
        Или Паспорт.Коэффициент <> Окр(Паспорт.Коэффициент, 3) Тогда
        ВызватьИсключение "кабинет_счетчик_привязка_конфликт";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьДействующуюУстановку(КонтекстДоступа, ТекущееВремя)
    Объект = КонтекстДоступа.Установка;
    Если Объект.Состояние <> "Active" Или Объект.ДатаУстановки > Объект.ДатаДопуска Или Объект.ДатаДопуска > ТекущееВремя + 300 Тогда
        ВызватьИсключение "кабинет_счетчик_неактивно";
    КонецЕсли;
    Привязка = РегистрыСведений.ДействующиеУстановкиПриборов.СоздатьМенеджерЗаписи();
    Привязка.Паспорт = Объект.Паспорт;
    Привязка.Прочитать();
    Если Не Привязка.Выбран() Тогда
        ВызватьИсключение "кабинет_счетчик_привязка_конфликт";
    КонецЕсли;
    Если Привязка.УстановкаПрибора <> Объект.Ссылка Тогда
        ВызватьИсключение "кабинет_счетчик_привязка_конфликт";
    КонецЕсли;
    ПроверитьДействующийПаспорт(КонтекстДоступа.Паспорт, ТекущееВремя);
КонецПроцедуры

Процедура ПроверитьЗначениеПоПаспорту(Значение, Паспорт)
    Если Паспорт.РазрядностьШкалы <> Цел(Паспорт.РазрядностьШкалы)
        Или Паспорт.РазрядностьШкалы < 1 Или Паспорт.РазрядностьШкалы > 12 Тогда
        ВызватьИсключение "кабинет_счетчик_привязка_конфликт";
    КонецЕсли;
    Предел = 1;
    Для Позиция = 1 По Паспорт.РазрядностьШкалы Цикл
        Предел = Предел * 10;
    КонецЦикла;
    Если Значение < 0 Или Значение >= Предел Или Значение <> Окр(Значение, 3) Тогда
        ВызватьИсключение "кабинет_счетчик_некорректно_значение";
    КонецЕсли;
КонецПроцедуры

Функция ПрочитатьУказательТекущейВерсии(Установка)
    Ряд = ПринятыйРяд(Установка);
    ТекущаяВерсия = РегистрыСведений.ПоследниеПринятыеПоказания.СоздатьМенеджерЗаписи();
    ТекущаяВерсия.УстановкаПрибора = Установка.Ссылка;
    ТекущаяВерсия.Прочитать();
    ТекущаяВерсия.УстановкаПрибора = Установка.Ссылка;
    ТекущаяВерсия.Показание = Документы.ИзмерениеПрибора.ПустаяСсылка();
    ТекущаяВерсия.ДатаИзмерения = Установка.ДатаДопуска;
    ТекущаяВерсия.Значение = Установка.НачальноеПоказание;
    ТекущаяВерсия.КоличествоПринятых = Ряд.Количество();
    Если Ряд.Количество() > 0 Тогда
        Последний = Ряд[Ряд.Количество() - 1];
        ТекущаяВерсия.Показание = Последний.Ссылка;
        ТекущаяВерсия.ДатаИзмерения = Последний.ДатаИзмерения;
        ТекущаяВерсия.Значение = Последний.Значение;
    КонецЕсли;
    Возврат ТекущаяВерсия;
КонецФункции

Функция ДатаИзмерения(Установка, ДатаИзмерения)
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 2 Ссылка ИЗ Документ.ИзмерениеПрибора
        |ГДЕ УстановкаПрибора = &Установка И ДатаИзмерения = &ДатаИзмерения");
    Запрос.УстановитьПараметр("Установка", Установка.Ссылка);
    Запрос.УстановитьПараметр("ДатаИзмерения", ДатаИзмерения);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Тогда
        Возврат Неопределено;
    КонецЕсли;
    ИдентификаторСсылки = Выборка.Ссылка;
    Если Выборка.Следующий() Тогда
        ВызватьИсключение "кабинет_счетчик_привязка_конфликт";
    КонецЕсли;
    Объект = ИдентификаторСсылки.ПолучитьОбъект();
    Если Объект = Неопределено Тогда
        ВызватьИсключение "кабинет_счетчик_привязка_конфликт";
    КонецЕсли;
    Если Объект.ПометкаУдаления Или (Объект.Состояние <> "Accepted" И Объект.Состояние <> "LateReview")
        Или Объект.УстановкаПрибора <> Установка.Ссылка Или Объект.ЛицевойСчет <> Установка.ЛицевойСчет
        Или Объект.РабочееПространство <> Установка.РабочееПространство Или Объект.Область <> Установка.Область
        Или Объект.ТочкаОбслуживания <> Установка.ТочкаОбслуживания Тогда
        ВызватьИсключение "кабинет_счетчик_привязка_конфликт";
    КонецЕсли;
    Возврат Объект;
КонецФункции

Функция ПроверитьСвободныйЗаводскойНомер(СсылкаРабочейОбласти, Производитель, Модель, Серийный)
    Привязка = РегистрыСведений.ПривязкиСерийныхНомеровПриборов.СоздатьМенеджерЗаписи();
    Привязка.РабочееПространство = СсылкаРабочейОбласти;
    Привязка.НормализованныйПроизводитель = Производитель;
    Привязка.НормализованнаяМодель = Модель;
    Привязка.НормализованныйСерийныйНомер = Серийный;
    Привязка.Прочитать();
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ПаспортаПриборов ГДЕ РабочееПространство = &РабочееПространство
        |И НормализованныйПроизводитель = &Производитель И НормализованнаяМодель = &Модель И НормализованныйСерийныйНомер = &Серийный");
    Запрос.УстановитьПараметр("РабочееПространство", СсылкаРабочейОбласти);
    Запрос.УстановитьПараметр("Производитель", Производитель);
    Запрос.УстановитьПараметр("Модель", Модель);
    Запрос.УстановитьПараметр("Серийный", Серийный);
    Если Привязка.Выбран() Или Не Запрос.Выполнить().Пустой() Тогда
        ВызватьИсключение "кабинет_счетчик_серийный_конфликт";
    КонецЕсли;
    Привязка.РабочееПространство = СсылкаРабочейОбласти;
    Привязка.НормализованныйПроизводитель = Производитель;
    Привязка.НормализованнаяМодель = Модель;
    Привязка.НормализованныйСерийныйНомер = Серийный;
    Возврат Привязка;
КонецФункции

Функция ПроверитьОтсутствиеАктивнойУстановки(ПаспортСсылка)
    Привязка = РегистрыСведений.ДействующиеУстановкиПриборов.СоздатьМенеджерЗаписи();
    Привязка.Паспорт = ПаспортСсылка;
    Привязка.Прочитать();
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.УстановкиПриборов ГДЕ Паспорт = &Паспорт И Состояние = &Действующий");
    Запрос.УстановитьПараметр("Паспорт", ПаспортСсылка);
    Запрос.УстановитьПараметр("Действующий", "Active");
    Если Привязка.Выбран() Или Не Запрос.Выполнить().Пустой() Тогда
        ВызватьИсключение "кабинет_счетчик_установка_конфликт";
    КонецЕсли;
    Привязка.Паспорт = ПаспортСсылка;
    Возврат Привязка;
КонецФункции

Функция ОткрытьПривязкуЗапроса(СсылкаУчетнойЗаписи, ИдентификаторЗапроса, Операция, Намерение)
    ЗапросКлиентаКлюч = Строка(РазобратьИдентификатор(ИдентификаторЗапроса));
    Блокировка = Новый БлокировкаДанных;
    Запись = Блокировка.Добавить("РегистрСведений.ПривязкиКомандУчетаПоказаний");
    Запись.УстановитьЗначение("УчетнаяЗапись", СсылкаУчетнойЗаписи);
    Запись.УстановитьЗначение("ИдентификаторЗапроса", ЗапросКлиентаКлюч);
    Запись.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
    Привязка = РегистрыСведений.ПривязкиКомандУчетаПоказаний.СоздатьМенеджерЗаписи();
    Привязка.УчетнаяЗапись = СсылкаУчетнойЗаписи;
    Привязка.ИдентификаторЗапроса = ЗапросКлиентаКлюч;
    Привязка.Прочитать();
    Если Привязка.Выбран() Тогда
        Если Привязка.Операция <> Операция Или Привязка.Намерение <> Намерение Тогда
            ВызватьИсключение "кабинет_счетчик_запрос_конфликт";
        КонецЕсли;
    Иначе
        Привязка.УчетнаяЗапись = СсылкаУчетнойЗаписи;
        Привязка.ИдентификаторЗапроса = ЗапросКлиентаКлюч;
        Привязка.Операция = Операция;
        Привязка.Намерение = Намерение;
    КонецЕсли;
    Возврат Привязка;
КонецФункции

Процедура ПривязатьКомандуЗапроса(Привязка, ИдентификаторСсылки)
    Привязка.ИдентификаторРезультата = Строка(ИдентификаторСсылки.УникальныйИдентификатор());
    Привязка.Записать();
КонецПроцедуры

Функция ДанныеСохраненногоПовтора(Привязка, СсылкаРабочейОбласти, СсылкаОбласти, СвязанныйОбъектСсылка = Неопределено)
    Разобранный = РазобратьИдентификатор(Привязка.ИдентификаторРезультата);
    Если Привязка.Операция = "passport.create" Тогда
        Объект = Справочники.ПаспортаПриборов.ПолучитьСсылку(Разобранный).ПолучитьОбъект();
    ИначеЕсли Привязка.Операция = "installation.create" Тогда
        Объект = Справочники.УстановкиПриборов.ПолучитьСсылку(Разобранный).ПолучитьОбъект();
    ИначеЕсли Привязка.Операция = "reading.submit" Тогда
        Объект = Документы.ИзмерениеПрибора.ПолучитьСсылку(Разобранный).ПолучитьОбъект();
    ИначеЕсли Привязка.Операция = "correction.request" Тогда
        Объект = Справочники.ЗаявкиКорректировкиПоказаний.ПолучитьСсылку(Разобранный).ПолучитьОбъект();
    Иначе
        ВызватьИсключение "кабинет_счетчик_привязка_конфликт";
    КонецЕсли;
    Если Объект = Неопределено Тогда
        ВызватьИсключение "кабинет_счетчик_привязка_конфликт";
    КонецЕсли;
    Если Объект.ПометкаУдаления Или Объект.РабочееПространство <> СсылкаРабочейОбласти Или Объект.Область <> СсылкаОбласти Тогда
        ВызватьИсключение "кабинет_счетчик_привязка_конфликт";
    КонецЕсли;
    Если Привязка.Операция = "passport.create" Тогда
        Возврат ДанныеПаспортаПрибора(Объект);
    ИначеЕсли Привязка.Операция = "installation.create" Тогда
        Если Объект.ЛицевойСчет <> СвязанныйОбъектСсылка Тогда
            ВызватьИсключение "кабинет_счетчик_привязка_конфликт";
        КонецЕсли;
        Возврат ДанныеУстановкиПрибора(Объект);
    ИначеЕсли Привязка.Операция = "reading.submit" Тогда
        Если Объект.УстановкаПрибора <> СвязанныйОбъектСсылка Тогда
            ВызватьИсключение "кабинет_счетчик_привязка_конфликт";
        КонецЕсли;
        Возврат ДанныеПоказания(Объект);
    КонецЕсли;
    Если Объект.ЦелевоеПоказание <> СвязанныйОбъектСсылка Тогда
        ВызватьИсключение "кабинет_счетчик_привязка_конфликт";
    КонецЕсли;
    Возврат ДанныеКорректировки(Объект);
КонецФункции

Процедура ЗаполнитьСлужебныеОтметки(Объект, СсылкаУчетнойЗаписи, СсылкаРабочейОбласти, СсылкаОбласти)
    Объект.РабочееПространство = СсылкаРабочейОбласти;
    Объект.Область = СсылкаОбласти;
    Объект.КемСоздано = СсылкаУчетнойЗаписи;
    Объект.ДатаСоздания = ТекущаяУниверсальнаяДата();
    Объект.ДатаОбновления = Объект.ДатаСоздания;
    Объект.Ревизия = 1;
КонецПроцедуры

Процедура ЗаблокироватьОбъектПоСсылке(ПространствоИмен, ИдентификаторСсылки)
