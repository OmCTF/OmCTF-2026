    Результат.Вставить("unit", СтрокаВыборки.ЕдиницаИзмерения);
    Результат.Вставить("digits", СтрокаВыборки.РазрядностьШкалы);
    Результат.Вставить("coefficient", СтрокаВыборки.Коэффициент);
    Результат.Вставить("verificationUntil", ДатаDTOUTC(СтрокаВыборки.СрокПоверки));
