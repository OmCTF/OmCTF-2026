КонецПроцедуры

Процедура ПроверитьОтсутствиеТранзакции()
    Если ТранзакцияАктивна() Тогда
        ВызватьИсключение "кабинет_счетчик_вложенная_транзакция";
    КонецЕсли;
КонецПроцедуры

Процедура ОтменитьСобственнуюТранзакцию()
    Если ТранзакцияАктивна() Тогда
        ОтменитьТранзакцию();
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи)
    Текущий = ПолитикаДоступа.ПроверитьУчетнуюЗапись();
    Если ТипЗнч(СсылкаУчетнойЗаписи) <> Тип("СправочникСсылка.УчетныеЗаписи") Тогда
        ВызватьИсключение "кабинет_участник_несовпадение";
    КонецЕсли;
    Если Текущий.Ссылка <> СсылкаУчетнойЗаписи Тогда
        ВызватьИсключение "кабинет_участник_несовпадение";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьПоляТелаЗапроса(ТелоЗапроса, Поля)
    Если ТипЗнч(ТелоЗапроса) <> Тип("Структура") Тогда
        ВызватьИсключение "кабинет_счетчик_некорректно_тело";
    КонецЕсли;
    Разрешенные = СтрРазделить(Поля, ",");
    Для Каждого Запись Из ТелоЗапроса Цикл
        Если Разрешенные.Найти(Запись.Ключ) = Неопределено Тогда
            ВызватьИсключение "кабинет_счетчик_некорректно_поле";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ТекстовоеПоле(ТелоЗапроса, Имя, Максимум)
    Значение = Неопределено;
    Если Не ТелоЗапроса.Свойство(Имя, Значение) Тогда
        ВызватьИсключение "кабинет_счетчик_некорректно_поле";
    КонецЕсли;
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_счетчик_некорректно_поле";
    КонецЕсли;
    Если СтрДлина(Значение) > Максимум Тогда
        ВызватьИсключение "кабинет_счетчик_некорректно_поле";
    КонецЕсли;
    Для Позиция = 1 По СтрДлина(Значение) Цикл
        Код = КодСимвола(Значение, Позиция);
        Если Код < 32 Или (Код >= 127 И Код <= 159) Или (Код >= 8203 И Код <= 8207)
            Или (Код >= 8234 И Код <= 8238) Или (Код >= 8288 И Код <= 8297)
            Или Код = 65279 Или (Код >= 55296 И Код <= 57343) Тогда
            ВызватьИсключение "кабинет_счетчик_некорректно_поле";
        КонецЕсли;
    КонецЦикла;
    Значение = СокрЛП(Значение);
    Если ПустаяСтрока(Значение) Тогда
        ВызватьИсключение "кабинет_счетчик_некорректно_поле";
    КонецЕсли;
    Возврат Значение;
КонецФункции

Функция ПолеЗаводскогоНомера(ТелоЗапроса)
    Значение = ВРег(ТекстовоеПоле(ТелоЗапроса, "serialNumber", 64));
    Разрешенные = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-/_";
    ЕстьЦифраИлиБуква = Ложь;
    Для Позиция = 1 По СтрДлина(Значение) Цикл
        Символ = Сред(Значение, Позиция, 1);
        Если СтрНайти(Разрешенные, Символ) = 0 Тогда
            ВызватьИсключение "кабинет_счетчик_некорректно_поле";
        КонецЕсли;
        Если СтрНайти("ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789", Символ) > 0 Тогда
            ЕстьЦифраИлиБуква = Истина;
        КонецЕсли;
    КонецЦикла;
    Если Не ЕстьЦифраИлиБуква Тогда
        ВызватьИсключение "кабинет_счетчик_некорректно_поле";
    КонецЕсли;
    Возврат Значение;
КонецФункции

Функция ПолеЧисловогоЗначения(ТелоЗапроса, Имя, Точность, Минимум, Максимум)
    Значение = Неопределено;
    Если Не ТелоЗапроса.Свойство(Имя, Значение) Тогда
        ВызватьИсключение "кабинет_счетчик_некорректно_значение";
    КонецЕсли;
    Если ТипЗнч(Значение) <> Тип("Число") Тогда
        ВызватьИсключение "кабинет_счетчик_некорректно_значение";
    КонецЕсли;
    Если Значение < Минимум Или Значение > Максимум Или Значение <> Окр(Значение, Точность) Тогда
        ВызватьИсключение "кабинет_счетчик_некорректно_значение";
    КонецЕсли;
    Возврат Значение;
КонецФункции

Функция ПолеДатыUTC(ТелоЗапроса, Имя)
    Значение = ТекстовоеПоле(ТелоЗапроса, Имя, 20);
    Если СтрДлина(Значение) <> 20 Или Сред(Значение, 5, 1) <> "-" Или Сред(Значение, 8, 1) <> "-"
        Или Сред(Значение, 11, 1) <> "T" Или Сред(Значение, 14, 1) <> ":"
        Или Сред(Значение, 17, 1) <> ":" Или Прав(Значение, 1) <> "Z" Тогда
        ВызватьИсключение "кабинет_счетчик_некорректно_даты";
    КонецЕсли;
    Цифры = Лев(Значение, 4) + Сред(Значение, 6, 2) + Сред(Значение, 9, 2)
        + Сред(Значение, 12, 2) + Сред(Значение, 15, 2) + Сред(Значение, 18, 2);
    Для Позиция = 1 По СтрДлина(Цифры) Цикл
        Если СтрНайти("0123456789", Сред(Цифры, Позиция, 1)) = 0 Тогда
            ВызватьИсключение "кабинет_счетчик_некорректно_даты";
        КонецЕсли;
    КонецЦикла;
    Попытка
        Разобранный = XMLЗначение(Тип("Дата"), Лев(Значение, 19));
    Исключение
        ВызватьИсключение "кабинет_счетчик_некорректно_даты";
    КонецПопытки;
    Если Разобранный = Дата(1, 1, 1) Или XMLСтрока(Разобранный) <> Лев(Значение, 19) Тогда
        ВызватьИсключение "кабинет_счетчик_некорректно_даты";
    КонецЕсли;
    Возврат Разобранный;
КонецФункции

Функция РазобратьИдентификатор(Идентификатор)
    Если ТипЗнч(Идентификатор) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецЕсли;
    Если СтрДлина(Идентификатор) <> 36 Тогда
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецЕсли;
    Попытка
        Разобранный = Новый УникальныйИдентификатор(Идентификатор);
    Исключение
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецПопытки;
    Если Строка(Разобранный) = "00000000-0000-0000-0000-000000000000" Тогда
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецЕсли;
    Возврат Разобранный;
КонецФункции

Функция КаноническоеПредставление(Намерение)
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Намерение);
    Результат = Запись.Закрыть();
    Если СтрДлина(Результат) > 4096 Тогда
        ВызватьИсключение "кабинет_счетчик_некорректно_тело";
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция НеобязательныйИдентификатор(ИдентификаторСсылки)
    Если Не ЗначениеЗаполнено(ИдентификаторСсылки) Тогда
        Возврат "";
    КонецЕсли;
    Возврат Строка(ИдентификаторСсылки.УникальныйИдентификатор());
КонецФункции

Функция ДатаDTOUTC(Значение)
    Возврат XMLСтрока(Значение) + "Z";
КонецФункции

Функция ОбщиеДанныеОбъекта(СтрокаВыборки)
    Возврат Новый Структура("id,workspaceId,areaId,createdBy,createdAt,updatedAt,revision",
        Строка(СтрокаВыборки.Ссылка.УникальныйИдентификатор()), Строка(СтрокаВыборки.РабочееПространство.УникальныйИдентификатор()), Строка(СтрокаВыборки.Область.УникальныйИдентификатор()),
        Строка(СтрокаВыборки.КемСоздано.УникальныйИдентификатор()), ДатаDTOUTC(СтрокаВыборки.ДатаСоздания), ДатаDTOUTC(СтрокаВыборки.ДатаОбновления), СтрокаВыборки.Ревизия);
КонецФункции

Функция ДанныеПаспортаПрибора(СтрокаВыборки)
    Результат = ОбщиеДанныеОбъекта(СтрокаВыборки);
