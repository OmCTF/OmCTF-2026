Функция ДанныеКорректировки(СтрокаВыборки)
    Результат = ОбщиеДанныеОбъекта(СтрокаВыборки);
    Результат.Вставить("meterInstallationId", Строка(СтрокаВыборки.УстановкаПрибора.УникальныйИдентификатор()));
    Результат.Вставить("personalAccountId", Строка(СтрокаВыборки.ЛицевойСчет.УникальныйИдентификатор()));
    Результат.Вставить("readingId", Строка(СтрокаВыборки.ЦелевоеПоказание.УникальныйИдентификатор()));
    Результат.Вставить("proposedValue", СтрокаВыборки.ПредлагаемоеЗначение);
    Результат.Вставить("proposedMeasuredAt", ДатаDTOUTC(СтрокаВыборки.ПредлагаемаяДатаИзмерения));
    Результат.Вставить("reason", СтрокаВыборки.Причина);
    Результат.Вставить("state", СтрокаВыборки.Состояние);
    Возврат Результат;
КонецФункции

Функция СоздатьУведомленияОСрокеПоверки(Предел = 25) Экспорт
    Если Не РольДоступна("Администратор") Тогда ВызватьИсключение "кабинет_операции_запрещено"; КонецЕсли;
    Если ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_операции_транзакция_активно"; КонецЕсли;
    Если ТипЗнч(Предел) <> Тип("Число") Тогда ВызватьИсключение "кабинет_некорректно_лимит"; КонецЕсли;
    Если Предел <> Цел(Предел) Или Предел < 1 Или Предел > 25 Тогда ВызватьИсключение "кабинет_некорректно_лимит"; КонецЕсли;
    Кандидаты = ЗапросПолучателейПоверки(Предел).Выполнить().Выгрузить(); Создано = 0;
    Для Каждого Кандидат Из Кандидаты Цикл
        НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
        Попытка
            ЗаблокироватьПолучателяПоверки(Кандидат);
            Свежие = ЗапросПолучателейПоверки(1, Кандидат).Выполнить().Выгрузить();
            Если Свежие.Количество() = 1 Тогда
                Свежий = Свежие[0]; Совпадает = Истина;
                Для Каждого Поле Из СтрРазделить("Получатель,Установка,Паспорт,ЛицевойСчет,РабочееПространство,Область,Связь,Основание,СрокПоверки,Договор,Объект,Точка,Абонент", ",") Цикл
                    Если Свежий[Поле] <> Кандидат[Поле] Тогда Совпадает = Ложь; Прервать; КонецЕсли;
                КонецЦикла;
                Если Совпадает Тогда
                    ИД = Строка(Свежий.Установка.УникальныйИдентификатор());
                    Ключ = "meter.verification." + ИД + "." + XMLСтрока(Свежий.СрокПоверки);
                    Уведомление = СервисУведомлений.СоздатьСобытие(Свежий.Получатель, "verification", Ключ,
                        ИД, "VerificationDue", Свежий.РабочееПространство, Свежий.Установка);
                    Если ЗначениеЗаполнено(Уведомление) Тогда Создано = Создано + 1; КонецЕсли;
                КонецЕсли;
            КонецЕсли;
            ЗафиксироватьТранзакцию();
        Исключение
            ОтменитьТранзакцию(); ВызватьИсключение;
        КонецПопытки;
    КонецЦикла;
    Возврат Создано;
КонецФункции

Функция ЗапросПолучателейПоверки(Предел, Точный = Неопределено)
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ " + Формат(Предел, "ЧГ=0") + "
        |Доступ.УчетнаяЗапись КАК Получатель, Установка.Ссылка КАК Установка,
        |Установка.Паспорт КАК Паспорт, Установка.ЛицевойСчет КАК ЛицевойСчет,
        |Установка.РабочееПространство КАК РабочееПространство, Установка.Область КАК Область,
        |Доступ.Связь КАК Связь, Доступ.Связь.ЗапросПолномочия КАК Основание,
        |Установка.Паспорт.СрокПоверки КАК СрокПоверки,
        |Установка.ЛицевойСчет.Договор КАК Договор, Установка.ЛицевойСчет.ОбъектНедвижимости КАК Объект,
        |Установка.ТочкаОбслуживания КАК Точка, Установка.ЛицевойСчет.Договор.Абонент КАК Абонент
        |ИЗ РегистрСведений.ДействующиеУстановкиПриборов КАК Текущая
        |ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.УстановкиПриборов КАК Установка
        |ПО Текущая.УстановкаПрибора = Установка.Ссылка И Текущая.Паспорт = Установка.Паспорт
        |ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПривязкиДоступаКЛицевымСчетам КАК Доступ
        |ПО Доступ.ЛицевойСчет = Установка.ЛицевойСчет
        |ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УведомленияКабинета КАК Готовое
        |ПО Готовое.Получатель = Доступ.УчетнаяЗапись И Готовое.Тема = &Тема
        |И Готовое.УстановкаПрибора = Установка.Ссылка
        |И Готовое.СтатусОбъекта = &Статус И Готовое.ДатаСоздания >= Установка.Паспорт.СрокПоверки
        |ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ Получатель, КОЛИЧЕСТВО(*) КАК Количество
        |ИЗ Справочник.УведомленияКабинета СГРУППИРОВАТЬ ПО Получатель) КАК ОбщаяКвота
        |ПО ОбщаяКвота.Получатель = Доступ.УчетнаяЗапись
        |ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ Получатель, РабочееПространство, КОЛИЧЕСТВО(*) КАК Количество
        |ИЗ Справочник.УведомленияКабинета СГРУППИРОВАТЬ ПО Получатель, РабочееПространство) КАК КвотаОбласти
        |ПО КвотаОбласти.Получатель = Доступ.УчетнаяЗапись И КвотаОбласти.РабочееПространство = Установка.РабочееПространство
        |ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЭксплуатации КАК Настройка
        |ПО Настройка.РабочееПространство = Установка.РабочееПространство И Настройка.Ключ = &КлючКвоты
        |ГДЕ Готовое.Ссылка ЕСТЬ NULL
        |И ЕСТЬNULL(ОбщаяКвота.Количество, 0) < 10000
        |И ЕСТЬNULL(КвотаОбласти.Количество, 0) < ЕСТЬNULL(Настройка.ЧисловоеЗначение, 5000)
        |И НЕ Установка.ПометкаУдаления И Установка.Состояние = &Активный
        |И Установка.ДатаУстановки <= Установка.ДатаДопуска И Установка.ДатаДопуска <= &Сейчас
        |И НЕ Установка.Паспорт.ПометкаУдаления И Установка.Паспорт.Состояние = &Активный
        |И Установка.Паспорт.РабочееПространство = Установка.РабочееПространство И Установка.Паспорт.Область = Установка.Область
        |И Установка.Паспорт.СрокПоверки > &ПустаяДата И Установка.Паспорт.СрокПоверки <= &Сейчас
        |И НЕ Доступ.УчетнаяЗапись.ПометкаУдаления И Доступ.УчетнаяЗапись.Состояние = &Активный
        |И НЕ Доступ.Связь.ПометкаУдаления И Доступ.Связь.Состояние = &Активный
        |И Доступ.Связь.УчетнаяЗапись = Доступ.УчетнаяЗапись И Доступ.Связь.ЛицевойСчет = Установка.ЛицевойСчет
        |И Доступ.Связь.РабочееПространство = Установка.РабочееПространство И Доступ.Связь.Область = Установка.Область
        |И (Доступ.Связь.СрокИстечения = &ПустаяДата ИЛИ Доступ.Связь.СрокИстечения > &Сейчас)
        |И НЕ Доступ.Связь.ЗапросПолномочия.ПометкаУдаления И Доступ.Связь.ЗапросПолномочия.Состояние = &Одобрено
        |И Доступ.Связь.ЗапросПолномочия.УчетнаяЗапись = Доступ.УчетнаяЗапись
        |И Доступ.Связь.ЗапросПолномочия.ЛицевойСчет = Установка.ЛицевойСчет
        |И Доступ.Связь.ЗапросПолномочия.РабочееПространство = Установка.РабочееПространство
        |И Доступ.Связь.ЗапросПолномочия.Область = Установка.Область
        |И НЕ Установка.РабочееПространство.ПометкаУдаления И Установка.РабочееПространство.Состояние = &Активный
        |И НЕ Установка.Область.ПометкаУдаления И Установка.Область.Состояние = &Активный
        |И Установка.Область.РабочееПространство = Установка.РабочееПространство
        |И НЕ Установка.ЛицевойСчет.ПометкаУдаления И Установка.ЛицевойСчет.Состояние = &Активный
        |И Установка.ЛицевойСчет.РабочееПространство = Установка.РабочееПространство И Установка.ЛицевойСчет.Область = Установка.Область
        |И НЕ Установка.ЛицевойСчет.Договор.ПометкаУдаления И Установка.ЛицевойСчет.Договор.Состояние = &Активный
        |И Установка.ЛицевойСчет.Договор.РабочееПространство = Установка.РабочееПространство И Установка.ЛицевойСчет.Договор.Область = Установка.Область
        |И НЕ Установка.ЛицевойСчет.ОбъектНедвижимости.ПометкаУдаления И Установка.ЛицевойСчет.ОбъектНедвижимости.Состояние = &Активный
        |И Установка.ЛицевойСчет.ОбъектНедвижимости.РабочееПространство = Установка.РабочееПространство
        |И Установка.ЛицевойСчет.ОбъектНедвижимости.Область = Установка.Область
        |И НЕ Установка.ТочкаОбслуживания.ПометкаУдаления И Установка.ТочкаОбслуживания.Состояние = &Активный
        |И Установка.ТочкаОбслуживания = Установка.ЛицевойСчет.ТочкаОбслуживания
        |И Установка.ТочкаОбслуживания.РабочееПространство = Установка.РабочееПространство И Установка.ТочкаОбслуживания.Область = Установка.Область
        |И Установка.ТочкаОбслуживания.ОбъектНедвижимости = Установка.ЛицевойСчет.ОбъектНедвижимости
        |И Установка.ТочкаОбслуживания.ВидУслуги = Установка.ЛицевойСчет.Договор.ВидУслуги
        |И Установка.ЛицевойСчет.Договор.ОбъектНедвижимости = Установка.ЛицевойСчет.ОбъектНедвижимости
        |И Установка.ЛицевойСчет.Договор.ТочкаОбслуживания = Установка.ТочкаОбслуживания
        |И НЕ Установка.ЛицевойСчет.Договор.Абонент.ПометкаУдаления И Установка.ЛицевойСчет.Договор.Абонент.Состояние = &Активный
        |И Установка.ЛицевойСчет.Договор.Абонент.РабочееПространство = Установка.РабочееПространство
        |И Установка.ЛицевойСчет.Договор.Абонент.Область = Установка.Область
        |И Установка.ЛицевойСчет.ОбъектНедвижимости.АбонентВладелец = Установка.ЛицевойСчет.Договор.Абонент");
    Если Точный <> Неопределено Тогда
        Запрос.Текст = Запрос.Текст + " И Установка.Ссылка = &Установка И Доступ.УчетнаяЗапись = &Получатель";
        Запрос.УстановитьПараметр("Установка", Точный.Установка); Запрос.УстановитьПараметр("Получатель", Точный.Получатель);
    КонецЕсли;
    Запрос.Текст = Запрос.Текст + " УПОРЯДОЧИТЬ ПО СрокПоверки, Установка, Получатель";
    Запрос.УстановитьПараметр("Сейчас", ТекущаяУниверсальнаяДата()); Запрос.УстановитьПараметр("ПустаяДата", Дата(1,1,1));
    Запрос.УстановитьПараметр("Активный", "Active"); Запрос.УстановитьПараметр("Одобрено", "Approved");
    Запрос.УстановитьПараметр("Тема", "verification"); Запрос.УстановитьПараметр("Статус", "VerificationDue");
    Запрос.УстановитьПараметр("КлючКвоты", "notificationQuota"); Возврат Запрос;
КонецФункции

Процедура ЗаблокироватьПолучателяПоверки(Кандидат)
    ЗаблокироватьОбъектПоСсылке("Справочник.УчетныеЗаписи", Кандидат.Получатель);
    ЗаблокироватьОбъектПоСсылке("Справочник.РабочиеПространства", Кандидат.РабочееПространство);
    ЗаблокироватьОбъектПоСсылке("Справочник.Области", Кандидат.Область);
    Блокировка = Новый БлокировкаДанных; Ключ = Блокировка.Добавить("РегистрСведений.ПривязкиДоступаКЛицевымСчетам");
    Ключ.УстановитьЗначение("УчетнаяЗапись", Кандидат.Получатель); Ключ.УстановитьЗначение("ЛицевойСчет", Кандидат.ЛицевойСчет);
    Ключ.Режим = РежимБлокировкиДанных.Исключительный; Блокировка.Заблокировать();
    ЗаблокироватьОбъектПоСсылке("Справочник.СвязиДоступаКЛицевымСчетам", Кандидат.Связь);
    ЗаблокироватьОбъектПоСсылке("Справочник.ЗаявкиДоступаКСчетам", Кандидат.Основание);
    ЗаблокироватьОбъектПоСсылке("Справочник.ЛицевыеСчета", Кандидат.ЛицевойСчет);
    ЗаблокироватьОбъектПоСсылке("Справочник.ПаспортаПриборов", Кандидат.Паспорт);
    ЗаблокироватьКлючУстановки(Кандидат.Паспорт);
    ЗаблокироватьОбъектПоСсылке("Справочник.УстановкиПриборов", Кандидат.Установка);
    Блокировка = Новый БлокировкаДанных; Ключ = Блокировка.Добавить("РегистрСведений.ПривязкиУведомлений");
    Ключ.УстановитьЗначение("Получатель", Кандидат.Получатель); Ключ.Режим = РежимБлокировкиДанных.Исключительный; Блокировка.Заблокировать();
КонецПроцедуры
