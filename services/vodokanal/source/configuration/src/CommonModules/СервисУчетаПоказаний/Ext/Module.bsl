КонецФункции

Функция ДанныеПоказания(СтрокаВыборки)
    Результат = ОбщиеДанныеОбъекта(СтрокаВыборки);
    Результат.Вставить("meterInstallationId", Строка(СтрокаВыборки.УстановкаПрибора.УникальныйИдентификатор()));
    Результат.Вставить("personalAccountId", Строка(СтрокаВыборки.ЛицевойСчет.УникальныйИдентификатор()));
    Результат.Вставить("servicePointId", Строка(СтрокаВыборки.ТочкаОбслуживания.УникальныйИдентификатор()));
    Результат.Вставить("measuredAt", ДатаDTOUTC(СтрокаВыборки.ДатаИзмерения));
    Результат.Вставить("receivedAt", ДатаDTOUTC(СтрокаВыборки.ДатаПолучения));
    Результат.Вставить("value", СтрокаВыборки.Значение);
    Результат.Вставить("channel", СтрокаВыборки.Канал);
    Результат.Вставить("state", СтрокаВыборки.Состояние);
    Результат.Вставить("reviewReason", СтрокаВыборки.ОснованиеПроверки);
    Результат.Вставить("previousReadingId", НеобязательныйИдентификатор(СтрокаВыборки.ПредыдущееПоказание));
    Результат.Вставить("previousMeasuredAt", ДатаDTOUTC(СтрокаВыборки.ДатаПредыдущегоИзмерения));
    Результат.Вставить("previousValue", СтрокаВыборки.ПредыдущееЗначение);
    Результат.Вставить("consumption", СтрокаВыборки.Расход);
    Результат.Вставить("coefficient", СтрокаВыборки.Коэффициент);
