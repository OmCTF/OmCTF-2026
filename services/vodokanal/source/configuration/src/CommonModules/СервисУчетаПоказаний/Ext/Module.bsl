    Результат.Вставить("passportId", Строка(СтрокаВыборки.Паспорт.УникальныйИдентификатор()));
    Результат.Вставить("personalAccountId", Строка(СтрокаВыборки.ЛицевойСчет.УникальныйИдентификатор()));
    Результат.Вставить("servicePointId", Строка(СтрокаВыборки.ТочкаОбслуживания.УникальныйИдентификатор()));
    Результат.Вставить("installedAt", ДатаDTOUTC(СтрокаВыборки.ДатаУстановки));
    Результат.Вставить("admittedAt", ДатаDTOUTC(СтрокаВыборки.ДатаДопуска));
    Результат.Вставить("initialValue", СтрокаВыборки.НачальноеПоказание);
    Результат.Вставить("state", СтрокаВыборки.Состояние);
