Функция СтрокаCSV(Значения)
    Результат = "";
    Разделитель = "";
    Для Каждого Значение Из Значения Цикл
        Результат = Результат + Разделитель + ЯчейкаCSV(Значение);
        Разделитель = ";";
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция ЯчейкаCSV(Значение)
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_реестр_экспорт_формат";
    КонецЕсли;
    Литерал = Ложь;
    Если СтрДлина(Значение) > 0 Тогда
        Первый = КодСимвола(Значение, 1);
        Литерал = Первый <= 32 Или (Первый >= 127 И Первый <= 159)
            Или Первый = 34 Или Первый = 39 Или СимволФорматированияCSV(Первый)
            Или СтрНайти("=+-@", Лев(Значение, 1)) > 0
            Или Первый = 65309 Или Первый = 65291 Или Первый = 65293 Или Первый = 65312;
    КонецЕсли;
    Очистить = "";
    Для Позиция = 1 По СтрДлина(Значение) Цикл
        Код = КодСимвола(Значение, Позиция);
        Если Код = 9 Тогда
            Очистить = Очистить + "\t";
        ИначеЕсли Код = 13 Тогда
            Очистить = Очистить + "\r";
        ИначеЕсли Код = 10 Или Код = 8232 Или Код = 8233 Тогда
            Очистить = Очистить + "\n";
        ИначеЕсли Код < 32 Или (Код >= 127 И Код <= 159) Или СимволФорматированияCSV(Код) Тогда
            Очистить = Очистить + " ";
        Иначе
            Очистить = Очистить + Сред(Значение, Позиция, 1);
        КонецЕсли;
    КонецЦикла;
    Если Литерал Тогда
        Очистить = "text: " + Очистить;
    КонецЕсли;
    Кавычка = Символ(34);
    Возврат Кавычка + СтрЗаменить(Очистить, Кавычка, Кавычка + Кавычка) + Кавычка;
КонецФункции

Функция ПодготовитьСтраницу(Запрос, Лимит, Курсор, Контекст, ПустаяСсылка) Экспорт
    Если Лимит = Неопределено Тогда Возврат Неопределено; КонецЕсли;
    Если ТипЗнч(Лимит) = Тип("Строка") Тогда
        Если Лимит = "" Тогда Лимит = "25"; КонецЕсли;
        Если СтрДлина(Лимит) > 3 Тогда ВызватьИсключение "кабинет_реестр_некорректно_страница"; КонецЕсли;
        Для Номер = 1 По СтрДлина(Лимит) Цикл
            Если СтрНайти("0123456789", Сред(Лимит, Номер, 1)) = 0 Тогда ВызватьИсключение "кабинет_реестр_некорректно_страница"; КонецЕсли;
        КонецЦикла;
        Лимит = Число(Лимит);
    КонецЕсли;
    Если ТипЗнч(Лимит) <> Тип("Число") Тогда ВызватьИсключение "кабинет_реестр_некорректно_страница"; КонецЕсли;
    Если Лимит < 1 Или Лимит > 100 Или Цел(Лимит) <> Лимит Тогда ВызватьИсключение "кабинет_реестр_некорректно_страница"; КонецЕсли;
    Если ТипЗнч(Курсор) <> Тип("Строка") Тогда ВызватьИсключение "кабинет_реестр_некорректно_страница"; КонецЕсли;
    Если СтрДлина(Курсор) > 100 Тогда ВызватьИсключение "кабинет_реестр_некорректно_страница"; КонецЕсли;
    JSON = Новый ЗаписьJSON;
    JSON.УстановитьСтроку();
    ЗаписатьJSON(JSON, Контекст);
    Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
    Хеш.Добавить(JSON.Закрыть());
    Отпечаток = СтрЗаменить(СтрЗаменить(Base64Строка(Хеш.ХешСумма), Символ(13), ""), Символ(10), "");
    После = ПустаяСсылка;
    Если Курсор <> "" Тогда
        Части = СтрРазделить(Курсор, "|", Истина);
        Если Части.Количество() <> 3 Тогда ВызватьИсключение "кабинет_реестр_некорректно_страница"; КонецЕсли;
        Если Части[0] <> "p1" Или Части[1] <> Отпечаток Тогда ВызватьИсключение "кабинет_реестр_некорректно_страница"; КонецЕсли;
        После = XMLЗначение(ТипЗнч(ПустаяСсылка), Строка(РазобратьИдентификатор(Части[2])));
    КонецЕсли;
    ПозицияПорядка = СтрНайти(Запрос.Текст, "УПОРЯДОЧИТЬ ПО");
    Если ПозицияПорядка = 0 Тогда ВызватьИсключение "кабинет_реестр_некорректно_страница"; КонецЕсли;
    Текст = Лев(Запрос.Текст, ПозицияПорядка - 1);
    Текст = СтрЗаменить(Текст, "ПЕРВЫЕ 1000 ", "ПЕРВЫЕ " + Формат(Лимит + 1, "ЧГ=0") + " ");
    Текст = СтрЗаменить(Текст, "ПЕРВЫЕ 100 ", "ПЕРВЫЕ " + Формат(Лимит + 1, "ЧГ=0") + " ");
    Запрос.Текст = Текст + " И (&БезКурсора ИЛИ Ссылка > &ПослеКурсора) УПОРЯДОЧИТЬ ПО Ссылка";
    Запрос.УстановитьПараметр("БезКурсора", Курсор = "");
    Запрос.УстановитьПараметр("ПослеКурсора", После);
    Возврат Новый Структура("limit,fingerprint", Лимит, Отпечаток);
КонецФункции

Функция ЗавершитьСтраницу(Строки, Страница) Экспорт
    Если Страница = Неопределено Тогда Возврат Строки; КонецЕсли;
    ЕстьЕще = Строки.Количество() > Страница.limit;
    Если ЕстьЕще Тогда Строки.Удалить(Строки.Количество() - 1); КонецЕсли;
    Следующий = "";
    Если ЕстьЕще Тогда Следующий = "p1|" + Страница.fingerprint + "|" + Строки[Строки.Количество() - 1].id; КонецЕсли;
    Возврат Новый Структура("items,limit,hasMore,nextCursor", Строки, Страница.limit, ЕстьЕще, Следующий);
КонецФункции

Процедура ПроверитьДоступКВыгрузке(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор) Экспорт
    НачатьТранзакциюВОбласти(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор);
    ЗафиксироватьТранзакцию();
КонецПроцедуры

Функция СимволФорматированияCSV(Код)
    Возврат Код = 160 Или Код = 5760 Или (Код >= 8192 И Код <= 8207)
        Или (Код >= 8232 И Код <= 8239) Или Код = 8287
        Или (Код >= 8288 И Код <= 8297) Или Код = 12288 Или Код = 65279;
КонецФункции
