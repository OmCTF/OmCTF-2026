Функция ВыгрузитьРеестр(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, Ресурс, Состояние = "", Поиск = "", ВложенныйДопуск = Неопределено) Экспорт
    ПроверитьДоступКВыгрузке(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор);
    ОбластиЭкспорта = ОграниченияТяжелыхЗаданий.ОднаОбласть(Справочники.РабочиеПространства.ПолучитьСсылку(РазобратьИдентификатор(РабочаяОбластьИдентификатор)), Справочники.Области.ПолучитьСсылку(РазобратьИдентификатор(ОбластьИдентификатор)));
    СобственныйДопуск = ВложенныйДопуск = Неопределено;
    ДопускТяжелогоЗадания = ОграниченияТяжелыхЗаданий.Начать(СсылкаУчетнойЗаписи, "subscriberRegistry", ОбластиЭкспорта, ВложенныйДопуск);
    Попытка
        Результат = ВыгрузитьРеестрБезЛимита(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, Ресурс, Состояние, Поиск);
    Исключение
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
        Если СобственныйДопуск Тогда ОграниченияТяжелыхЗаданий.Завершить(СсылкаУчетнойЗаписи, ДопускТяжелогоЗадания); КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
    Если СобственныйДопуск Тогда ОграниченияТяжелыхЗаданий.Завершить(СсылкаУчетнойЗаписи, ДопускТяжелогоЗадания); КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ВыгрузитьРеестрБезЛимита(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, Ресурс, Состояние = "", Поиск = "")
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    Если ТипЗнч(Ресурс) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_реестр_некорректно_ресурс";
    КонецЕсли;
    Выборка = СтрокиВыгрузки(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, Ресурс, Состояние, Поиск);
    Если Ресурс = "subscribers" Тогда
        Колонки = СтрРазделить("id,name,partyType,phone,email,state", ",");
    ИначеЕсли Ресурс = "properties" Тогда
        Колонки = СтрРазделить("id,ownerSubscriberId,name,address,propertyType,state", ",");
    ИначеЕсли Ресурс = "service-points" Тогда
        Колонки = СтрРазделить("id,propertyId,name,serviceKind,state", ",");
    ИначеЕсли Ресурс = "contracts" Тогда
        Колонки = СтрРазделить("id,subscriberId,propertyId,servicePointId,numberNormalized,serviceKind,validFrom,validTo,state", ",");
    ИначеЕсли Ресурс = "personal-accounts" Тогда
        Колонки = СтрРазделить("id,contractId,propertyId,servicePointId,numberNormalized,state", ",");
    Иначе
        ВызватьИсключение "кабинет_реестр_некорректно_ресурс";
    КонецЕсли;
    НовыйСтрока = Символ(13) + Символ(10);
    ТекстCSV = ЯчейкаCSV("TRAINING DATA - DEMONSTRATION ONLY - NOT AN OFFICIAL WATER UTILITY DOCUMENT") + НовыйСтрока;
    ТекстCSV = ТекстCSV + СтрокаCSV(Колонки) + НовыйСтрока;
    Для Каждого СтрокаВыборки Из Выборка Цикл
        Значения = Новый Массив;
        Для Каждого Колонка Из Колонки Цикл
            Значение = "";
            Если Не СтрокаВыборки.Свойство(Колонка, Значение) Тогда
                ВызватьИсключение "кабинет_реестр_экспорт_формат";
            КонецЕсли;
            Значения.Добавить(Значение);
        КонецЦикла;
        ТекстCSV = ТекстCSV + СтрокаCSV(Значения) + НовыйСтрока;
    КонецЦикла;
    Возврат Новый Структура("csv,filename", ТекстCSV, "vodokanal-training-" + Ресурс + ".csv");
КонецФункции

Функция СтрокиВыгрузки(УчетнаяЗапись, РабочаяОбласть, Область, Ресурс, Состояние, Поиск)
    Строки = Новый Массив;
    Курсор = "";
    Пока Истина Цикл
        Если Ресурс = "subscribers" Тогда
            Страница = ПолучитьСписокАбонентов(УчетнаяЗапись, РабочаяОбласть, Область, Состояние, Поиск, 100, Курсор);
        ИначеЕсли Ресурс = "properties" Тогда
            Страница = СписокОбъектовАбонентов(УчетнаяЗапись, РабочаяОбласть, Область, Состояние, Поиск, 100, Курсор);
        ИначеЕсли Ресурс = "service-points" Тогда
            Страница = СписокТочекОбслуживания(УчетнаяЗапись, РабочаяОбласть, Область, Состояние, Поиск, 100, Курсор);
        ИначеЕсли Ресурс = "contracts" Тогда
            Страница = СписокДоговоров(УчетнаяЗапись, РабочаяОбласть, Область, Состояние, Поиск, 100, Курсор);
        ИначеЕсли Ресурс = "personal-accounts" Тогда
            Страница = СписокЛицевыхСчетов(УчетнаяЗапись, РабочаяОбласть, Область, Состояние, Поиск, 100, Курсор);
        Иначе
            ВызватьИсключение "кабинет_реестр_некорректно_ресурс";
        КонецЕсли;
        Для Каждого Элемент Из Страница.items Цикл Строки.Добавить(Элемент); КонецЦикла;
        Если Не Страница.hasMore Тогда Прервать; КонецЕсли;
        Если Строки.Количество() >= 10000 Тогда ВызватьИсключение "кабинет_реестр_экспорт_лимит"; КонецЕсли;
        Курсор = Страница.nextCursor;
    КонецЦикла;
    Возврат Строки;
КонецФункции

Функция СоздатьАбонента(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса = Неопределено) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, "workspaceId,areaId,name,partyType,phone,email,state");
    Имя = ТекстовоеПоле(ТелоЗапроса, "name", 150);
    ТипАбонента = ПолеИзПеречня(ТелоЗапроса, "partyType", "Person,Organization,Entrepreneur");
    Телефон = КонтактПечатнымиСимволами(ТелоЗапроса, "phone", 32);
    ЭлектроннаяПочта = НРег(КонтактПечатнымиСимволами(ТелоЗапроса, "email", 128));
    Состояние = СостояниеИзТелаЗапроса(ТелоЗапроса);
    КонтекстДоступа = НачатьТранзакциюВОбласти(СсылкаУчетнойЗаписи, ТекстовоеПоле(ТелоЗапроса, "workspaceId", 36), ТекстовоеПоле(ТелоЗапроса, "areaId", 36));
    Попытка
        КомандаСоздания = ОткрытьСоздание(КонтекстДоступа, ИдентификаторЗапроса, "subscribers", ТелоЗапроса);
        Если КомандаСоздания <> Неопределено И КомандаСоздания.Выбран() Тогда
            Результат = ЖизненныйЦиклАбонентов.ПрочитатьРезультатСоздания(КомандаСоздания, КонтекстДоступа, "subscribers");
            ЗафиксироватьТранзакцию(); Возврат Результат;
        КонецЕсли;
        Объект = Справочники.Абоненты.СоздатьЭлемент();
        Объект.SetNewObjectRef(Справочники.Абоненты.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
        ИнициализироватьЭлемент(Объект, КонтекстДоступа, Имя, Состояние);
        Объект.ТипАбонента = ТипАбонента;
        Объект.Телефон = Телефон;
        Объект.ЭлектроннаяПочта = ЭлектроннаяПочта;
        Объект.Записать();
        ПолитикаДоступа.ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, КонтекстДоступа.РабочееПространство, "registry.subscriber.create", Строка(Объект.Ссылка.УникальныйИдентификатор()));
        Результат = ДанныеАбонента(Объект);
        ЗакончитьСоздание(КомандаСоздания, Результат);
        ЗафиксироватьТранзакцию();
    Исключение
        Если ТранзакцияАктивна() Тогда
            ОтменитьТранзакцию();
        КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СоздатьОбъектАбонента(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса = Неопределено) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, "workspaceId,areaId,name,ownerSubscriberId,address,propertyType,state");
    Имя = ТекстовоеПоле(ТелоЗапроса, "name", 150);
    СсылкаНаАбонента = Справочники.Абоненты.ПолучитьСсылку(РазобратьИдентификатор(ТекстовоеПоле(ТелоЗапроса, "ownerSubscriberId", 36)));
    Адрес = ТекстовоеПоле(ТелоЗапроса, "address", 250);
    ТипОбъектаНедвижимости = ПолеИзПеречня(ТелоЗапроса, "propertyType", "Residential,Commercial,Industrial,Other");
    Состояние = СостояниеИзТелаЗапроса(ТелоЗапроса);
    КонтекстДоступа = НачатьТранзакциюВОбласти(СсылкаУчетнойЗаписи, ТекстовоеПоле(ТелоЗапроса, "workspaceId", 36), ТекстовоеПоле(ТелоЗапроса, "areaId", 36));
    Попытка
        КомандаСоздания = ОткрытьСоздание(КонтекстДоступа, ИдентификаторЗапроса, "properties", ТелоЗапроса);
        Если КомандаСоздания <> Неопределено И КомандаСоздания.Выбран() Тогда
            Результат = ЖизненныйЦиклАбонентов.ПрочитатьРезультатСоздания(КомандаСоздания, КонтекстДоступа, "properties");
            ЗафиксироватьТранзакцию(); Возврат Результат;
        КонецЕсли;
        ПроверитьАбонента(СсылкаНаАбонента, КонтекстДоступа, Состояние = "Closed");
        Объект = Справочники.ОбъектыНедвижимости.СоздатьЭлемент();
        Объект.SetNewObjectRef(Справочники.ОбъектыНедвижимости.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
        ИнициализироватьЭлемент(Объект, КонтекстДоступа, Имя, Состояние);
        Объект.АбонентВладелец = СсылкаНаАбонента;
        Объект.Адрес = Адрес;
        Объект.ТипОбъектаНедвижимости = ТипОбъектаНедвижимости;
        ЖизненныйЦиклАбонентов.ЗаписатьНовыйОбъектСИсторией(КонтекстДоступа, "properties", Объект);
        ПолитикаДоступа.ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, КонтекстДоступа.РабочееПространство, "registry.property.create", Строка(Объект.Ссылка.УникальныйИдентификатор()));
        Результат = ДанныеОбъектаАбонента(Объект);
        ЗакончитьСоздание(КомандаСоздания, Результат);
        ЗафиксироватьТранзакцию();
    Исключение
        Если ТранзакцияАктивна() Тогда
            ОтменитьТранзакцию();
        КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СоздатьТочкуОбслуживания(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса = Неопределено) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, "workspaceId,areaId,name,propertyId,serviceKind,state");
    Имя = ТекстовоеПоле(ТелоЗапроса, "name", 150);
    СвойствоСсылка = Справочники.ОбъектыНедвижимости.ПолучитьСсылку(РазобратьИдентификатор(ТекстовоеПоле(ТелоЗапроса, "propertyId", 36)));
    ВидУслуги = ПолеИзПеречня(ТелоЗапроса, "serviceKind", "WaterSupply,Wastewater");
    Состояние = СостояниеИзТелаЗапроса(ТелоЗапроса);
    КонтекстДоступа = НачатьТранзакциюВОбласти(СсылкаУчетнойЗаписи, ТекстовоеПоле(ТелоЗапроса, "workspaceId", 36), ТекстовоеПоле(ТелоЗапроса, "areaId", 36));
    Попытка
        КомандаСоздания = ОткрытьСоздание(КонтекстДоступа, ИдентификаторЗапроса, "service-points", ТелоЗапроса);
        Если КомандаСоздания <> Неопределено И КомандаСоздания.Выбран() Тогда
            Результат = ЖизненныйЦиклАбонентов.ПрочитатьРезультатСоздания(КомандаСоздания, КонтекстДоступа, "service-points");
            ЗафиксироватьТранзакцию(); Возврат Результат;
        КонецЕсли;
        СвойствоСтрокаВыборки = ПроверитьОбъектАбонента(СвойствоСсылка, КонтекстДоступа, Состояние = "Closed");
        ПроверитьАбонента(СвойствоСтрокаВыборки.АбонентВладелец, КонтекстДоступа, Состояние = "Closed");
        Объект = Справочники.ТочкиОбслуживания.СоздатьЭлемент();
        Объект.SetNewObjectRef(Справочники.ТочкиОбслуживания.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
        ИнициализироватьЭлемент(Объект, КонтекстДоступа, Имя, Состояние);
        Объект.ОбъектНедвижимости = СвойствоСсылка;
        Объект.ВидУслуги = ВидУслуги;
        ЖизненныйЦиклАбонентов.ЗаписатьНовыйОбъектСИсторией(КонтекстДоступа, "service-points", Объект);
        ПолитикаДоступа.ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, КонтекстДоступа.РабочееПространство, "registry.service-point.create", Строка(Объект.Ссылка.УникальныйИдентификатор()));
        Результат = ДанныеТочкиОбслуживания(Объект);
        ЗакончитьСоздание(КомандаСоздания, Результат);
        ЗафиксироватьТранзакцию();
    Исключение
        Если ТранзакцияАктивна() Тогда
            ОтменитьТранзакцию();
        КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СоздатьДоговор(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса = Неопределено) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, "workspaceId,areaId,name,subscriberId,propertyId,servicePointId,number,serviceKind,validFrom,validTo,state");
    Имя = ТекстовоеПоле(ТелоЗапроса, "name", 150);
    СсылкаНаАбонента = Справочники.Абоненты.ПолучитьСсылку(РазобратьИдентификатор(ТекстовоеПоле(ТелоЗапроса, "subscriberId", 36)));
    СвойствоСсылка = Справочники.ОбъектыНедвижимости.ПолучитьСсылку(РазобратьИдентификатор(ТекстовоеПоле(ТелоЗапроса, "propertyId", 36)));
    ТочкаСсылка = Справочники.ТочкиОбслуживания.ПолучитьСсылку(РазобратьИдентификатор(ТекстовоеПоле(ТелоЗапроса, "servicePointId", 36)));
    НормализованныйНомер = ЧисловоеПолеТела(ТелоЗапроса, "number", 64);
    ВидУслуги = ПолеИзПеречня(ТелоЗапроса, "serviceKind", "WaterSupply,Wastewater");
    НачалоДействия = ПолеДатыUTC(ТелоЗапроса, "validFrom");
    ОкончаниеДействия = ПолеДатыUTC(ТелоЗапроса, "validTo", Ложь);
    Если ОкончаниеДействия <> Дата(1, 1, 1) И ОкончаниеДействия <= НачалоДействия Тогда
        ВызватьИсключение "кабинет_реестр_некорректно_даты";
    КонецЕсли;
    Состояние = СостояниеИзТелаЗапроса(ТелоЗапроса);
    КонтекстДоступа = НачатьТранзакциюВОбласти(СсылкаУчетнойЗаписи, ТекстовоеПоле(ТелоЗапроса, "workspaceId", 36), ТекстовоеПоле(ТелоЗапроса, "areaId", 36));
    Попытка
        КомандаСоздания = ОткрытьСоздание(КонтекстДоступа, ИдентификаторЗапроса, "contracts", ТелоЗапроса);
        Если КомандаСоздания <> Неопределено И КомандаСоздания.Выбран() Тогда
            Результат = ЖизненныйЦиклАбонентов.ПрочитатьРезультатСоздания(КомандаСоздания, КонтекстДоступа, "contracts");
            ЗафиксироватьТранзакцию(); Возврат Результат;
        КонецЕсли;
        ПроверитьАбонента(СсылкаНаАбонента, КонтекстДоступа, Состояние = "Closed");
        СвойствоСтрокаВыборки = ПроверитьОбъектАбонента(СвойствоСсылка, КонтекстДоступа, Состояние = "Closed");
        ТочкаСтрокаВыборки = ПроверитьТочкуОбслуживания(ТочкаСсылка, КонтекстДоступа, Состояние = "Closed");
        Если СвойствоСтрокаВыборки.АбонентВладелец <> СсылкаНаАбонента Или ТочкаСтрокаВыборки.ОбъектНедвижимости <> СвойствоСсылка
            Или ТочкаСтрокаВыборки.ВидУслуги <> ВидУслуги Тогда
            ВызватьИсключение "кабинет_реестр_связь_конфликт";
        КонецЕсли;
        Объект = Справочники.Договоры.СоздатьЭлемент();
        Объект.SetNewObjectRef(Справочники.Договоры.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
        ИнициализироватьЭлемент(Объект, КонтекстДоступа, Имя, Состояние);
        Объект.Абонент = СсылкаНаАбонента;
        Объект.ОбъектНедвижимости = СвойствоСсылка;
        Объект.ТочкаОбслуживания = ТочкаСсылка;
        Объект.НормализованныйНомер = НормализованныйНомер;
        Объект.ВидУслуги = ВидУслуги;
        Объект.НачалоДействия = НачалоДействия;
        Объект.ОкончаниеДействия = ОкончаниеДействия;
        ЖизненныйЦиклАбонентов.ЗаписатьНовыйОбъектСИсторией(КонтекстДоступа, "contracts", Объект);
        ПолитикаДоступа.ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, КонтекстДоступа.РабочееПространство, "registry.contract.create", Строка(Объект.Ссылка.УникальныйИдентификатор()));
        Результат = ДанныеДоговора(Объект);
        ЗакончитьСоздание(КомандаСоздания, Результат);
        ЗафиксироватьТранзакцию();
    Исключение
        Если ТранзакцияАктивна() Тогда
            ОтменитьТранзакцию();
        КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СоздатьЛицевойСчет(СсылкаУчетнойЗаписи, ТелоЗапроса, ИдентификаторЗапроса = Неопределено) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, "workspaceId,areaId,name,contractId,propertyId,servicePointId,number,state");
    Имя = ТекстовоеПоле(ТелоЗапроса, "name", 150);
    ДоговорСсылка = Справочники.Договоры.ПолучитьСсылку(РазобратьИдентификатор(ТекстовоеПоле(ТелоЗапроса, "contractId", 36)));
    СвойствоСсылка = Справочники.ОбъектыНедвижимости.ПолучитьСсылку(РазобратьИдентификатор(ТекстовоеПоле(ТелоЗапроса, "propertyId", 36)));
    ТочкаСсылка = Справочники.ТочкиОбслуживания.ПолучитьСсылку(РазобратьИдентификатор(ТекстовоеПоле(ТелоЗапроса, "servicePointId", 36)));
    НормализованныйНомер = ЧисловоеПолеТела(ТелоЗапроса, "number", 32);
    Состояние = СостояниеИзТелаЗапроса(ТелоЗапроса);
    КонтекстДоступа = НачатьТранзакциюВОбласти(СсылкаУчетнойЗаписи, ТекстовоеПоле(ТелоЗапроса, "workspaceId", 36), ТекстовоеПоле(ТелоЗапроса, "areaId", 36));
    Попытка
        КомандаСоздания = ОткрытьСоздание(КонтекстДоступа, ИдентификаторЗапроса, "personal-accounts", ТелоЗапроса);
        Если КомандаСоздания <> Неопределено И КомандаСоздания.Выбран() Тогда
            Результат = ЖизненныйЦиклАбонентов.ПрочитатьРезультатСоздания(КомандаСоздания, КонтекстДоступа, "personal-accounts");
            ЗафиксироватьТранзакцию(); Возврат Результат;
        КонецЕсли;
        ДоговорСтрокаВыборки = ПроверитьДоговор(ДоговорСсылка, КонтекстДоступа, Состояние = "Closed");
        ПроверитьАбонента(ДоговорСтрокаВыборки.Абонент, КонтекстДоступа, Состояние = "Closed");
        СвойствоСтрокаВыборки = ПроверитьОбъектАбонента(СвойствоСсылка, КонтекстДоступа, Состояние = "Closed");
        ТочкаСтрокаВыборки = ПроверитьТочкуОбслуживания(ТочкаСсылка, КонтекстДоступа, Состояние = "Closed");
        Если ДоговорСтрокаВыборки.ОбъектНедвижимости <> СвойствоСсылка Или ДоговорСтрокаВыборки.ТочкаОбслуживания <> ТочкаСсылка
            Или СвойствоСтрокаВыборки.АбонентВладелец <> ДоговорСтрокаВыборки.Абонент
            Или ТочкаСтрокаВыборки.ОбъектНедвижимости <> СвойствоСсылка Или ТочкаСтрокаВыборки.ВидУслуги <> ДоговорСтрокаВыборки.ВидУслуги Тогда
            ВызватьИсключение "кабинет_реестр_связь_конфликт";
        КонецЕсли;
        ЗаблокироватьНомерЛицевогоСчета(КонтекстДоступа.РабочееПространство, НормализованныйНомер);
        Привязка = ПроверитьСвободныйНомерЛицевогоСчета(КонтекстДоступа.РабочееПространство, НормализованныйНомер);
        Объект = Справочники.ЛицевыеСчета.СоздатьЭлемент();
        Объект.SetNewObjectRef(Справочники.ЛицевыеСчета.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
        ИнициализироватьЭлемент(Объект, КонтекстДоступа, Имя, Состояние);
        Объект.Договор = ДоговорСсылка;
        Объект.ОбъектНедвижимости = СвойствоСсылка;
        Объект.ТочкаОбслуживания = ТочкаСсылка;
        Объект.НормализованныйНомер = НормализованныйНомер;
        Объект.Записать();
        Привязка.РабочееПространство = КонтекстДоступа.РабочееПространство;
        Привязка.НормализованныйНомер = НормализованныйНомер;
        Привязка.ЛицевойСчет = Объект.Ссылка;
        Привязка.Записать();
        ПолитикаДоступа.ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, КонтекстДоступа.РабочееПространство, "registry.personal-account.create", Строка(Объект.Ссылка.УникальныйИдентификатор()));
        Результат = ДанныеЛицевогоСчета(Объект);
        ЗакончитьСоздание(КомандаСоздания, Результат);
        ЗафиксироватьТранзакцию();
    Исключение
        Если ТранзакцияАктивна() Тогда
            ОтменитьТранзакцию();
        КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ОткрытьСоздание(Контекст, Ключ, Ресурс, Тело)
    Если Ключ = Неопределено Тогда Возврат Неопределено; КонецЕсли;
    Возврат ЖизненныйЦиклАбонентов.ОткрытьКомандуСоздания(Контекст, Ключ, Ресурс, Тело);
КонецФункции

Процедура ЗакончитьСоздание(Команда, Результат)
    Если Команда <> Неопределено Тогда ЖизненныйЦиклАбонентов.СохранитьРезультатСоздания(Команда, Результат); КонецЕсли;
КонецПроцедуры

Функция ПрочитатьАбонентов(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, ИдентификаторСсылки, Состояние, Поиск, Лимит = Неопределено, Курсор = "")
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 100 Ссылка, РабочееПространство, Область, Наименование, ТипАбонента, Телефон, ЭлектроннаяПочта,
        |Состояние, КемСоздано, ДатаСоздания, ДатаОбновления, Ревизия
        |ИЗ Справочник.Абоненты
        |ГДЕ РабочееПространство = &РабочееПространство И Область = &Область И НЕ ПометкаУдаления
        |И (Состояние = &Действующий ИЛИ Состояние = &Закрытый) И (&ЛюбойСостояние ИЛИ Состояние = &Состояние)
        |И (&ЛюбойИдентификатор ИЛИ Ссылка = &ИдентификаторСсылки) И (&ЛюбойПоиск ИЛИ Наименование = &Поиск)
        |УПОРЯДОЧИТЬ ПО ДатаСоздания, Ссылка");
    Возврат ВыполнитьЗапросВОбласти(Запрос, СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, ИдентификаторСсылки, Состояние, Поиск, "Subscriber", Лимит, Курсор);
КонецФункции

Функция ПрочитатьОбъектыАбонентов(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, ИдентификаторСсылки, Состояние, Поиск, Лимит = Неопределено, Курсор = "")
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 100 Ссылка, РабочееПространство, Область, Наименование, АбонентВладелец, Адрес, ТипОбъектаНедвижимости,
        |Состояние, КемСоздано, ДатаСоздания, ДатаОбновления, Ревизия
        |ИЗ Справочник.ОбъектыНедвижимости
        |ГДЕ РабочееПространство = &РабочееПространство И Область = &Область И НЕ ПометкаУдаления
        |И АбонентВладелец.РабочееПространство = &РабочееПространство И АбонентВладелец.Область = &Область
        |И НЕ АбонентВладелец.ПометкаУдаления
        |И (Состояние = &Действующий ИЛИ Состояние = &Закрытый) И (&ЛюбойСостояние ИЛИ Состояние = &Состояние)
        |И (&ЛюбойИдентификатор ИЛИ Ссылка = &ИдентификаторСсылки) И (&ЛюбойПоиск ИЛИ Наименование = &Поиск ИЛИ Адрес = &Поиск)
        |УПОРЯДОЧИТЬ ПО ДатаСоздания, Ссылка");
    Возврат ВыполнитьЗапросВОбласти(Запрос, СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, ИдентификаторСсылки, Состояние, Поиск, "Property", Лимит, Курсор);
КонецФункции

Функция ПрочитатьТочкиОбслуживания(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, ИдентификаторСсылки, Состояние, Поиск, Лимит = Неопределено, Курсор = "")
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 100 Ссылка, РабочееПространство, Область, Наименование, ОбъектНедвижимости, ВидУслуги,
        |Состояние, КемСоздано, ДатаСоздания, ДатаОбновления, Ревизия
        |ИЗ Справочник.ТочкиОбслуживания
        |ГДЕ РабочееПространство = &РабочееПространство И Область = &Область И НЕ ПометкаУдаления
        |И ОбъектНедвижимости.РабочееПространство = &РабочееПространство И ОбъектНедвижимости.Область = &Область И НЕ ОбъектНедвижимости.ПометкаУдаления
        |И ОбъектНедвижимости.АбонентВладелец.РабочееПространство = &РабочееПространство И ОбъектНедвижимости.АбонентВладелец.Область = &Область
        |И НЕ ОбъектНедвижимости.АбонентВладелец.ПометкаУдаления
        |И (Состояние = &Действующий ИЛИ Состояние = &Закрытый) И (&ЛюбойСостояние ИЛИ Состояние = &Состояние)
        |И (&ЛюбойИдентификатор ИЛИ Ссылка = &ИдентификаторСсылки) И (&ЛюбойПоиск ИЛИ Наименование = &Поиск)
        |УПОРЯДОЧИТЬ ПО ДатаСоздания, Ссылка");
    Возврат ВыполнитьЗапросВОбласти(Запрос, СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, ИдентификаторСсылки, Состояние, Поиск, "ServicePoint", Лимит, Курсор);
КонецФункции

Функция ПрочитатьДоговоры(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, ИдентификаторСсылки, Состояние, Поиск, Лимит = Неопределено, Курсор = "")
    Если ТипЗнч(Поиск) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_реестр_некорректно_поле";
    КонецЕсли;
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 100 Ссылка, РабочееПространство, Область, Наименование, Абонент, ОбъектНедвижимости, ТочкаОбслуживания,
        |НормализованныйНомер, ВидУслуги, НачалоДействия, ОкончаниеДействия, Состояние, КемСоздано, ДатаСоздания, ДатаОбновления, Ревизия
        |ИЗ Справочник.Договоры
        |ГДЕ РабочееПространство = &РабочееПространство И Область = &Область И НЕ ПометкаУдаления
        |И Абонент.РабочееПространство = &РабочееПространство И Абонент.Область = &Область И НЕ Абонент.ПометкаУдаления
        |И ОбъектНедвижимости.РабочееПространство = &РабочееПространство И ОбъектНедвижимости.Область = &Область И НЕ ОбъектНедвижимости.ПометкаУдаления
        |И ТочкаОбслуживания.РабочееПространство = &РабочееПространство И ТочкаОбслуживания.Область = &Область И НЕ ТочкаОбслуживания.ПометкаУдаления
        |И ОбъектНедвижимости.АбонентВладелец = Абонент И ТочкаОбслуживания.ОбъектНедвижимости = ОбъектНедвижимости
        |И ТочкаОбслуживания.ВидУслуги = ВидУслуги
        |И (Состояние = &Действующий ИЛИ Состояние = &Закрытый) И (&ЛюбойСостояние ИЛИ Состояние = &Состояние)
        |И (&ЛюбойИдентификатор ИЛИ Ссылка = &ИдентификаторСсылки) И (&ЛюбойПоиск ИЛИ НормализованныйНомер = &Поиск)
        |УПОРЯДОЧИТЬ ПО ДатаСоздания, Ссылка");
    Если Не ПустаяСтрока(Поиск) Тогда
        Поиск = НормализоватьНомер(Поиск, 64);
    КонецЕсли;
    Возврат ВыполнитьЗапросВОбласти(Запрос, СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, ИдентификаторСсылки, Состояние, Поиск, "Contract", Лимит, Курсор);
КонецФункции

Функция ПрочитатьЛицевыеСчета(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, ИдентификаторСсылки, Состояние, Поиск, Лимит = Неопределено, Курсор = "")
    Если ТипЗнч(Поиск) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_реестр_некорректно_поле";
    КонецЕсли;
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 100 Ссылка, РабочееПространство, Область, Наименование, Договор, ОбъектНедвижимости, ТочкаОбслуживания,
        |НормализованныйНомер, Состояние, КемСоздано, ДатаСоздания, ДатаОбновления, Ревизия
        |ИЗ Справочник.ЛицевыеСчета
        |ГДЕ РабочееПространство = &РабочееПространство И Область = &Область И НЕ ПометкаУдаления
        |И Договор.РабочееПространство = &РабочееПространство И Договор.Область = &Область И НЕ Договор.ПометкаУдаления
        |И ОбъектНедвижимости.РабочееПространство = &РабочееПространство И ОбъектНедвижимости.Область = &Область И НЕ ОбъектНедвижимости.ПометкаУдаления
        |И ТочкаОбслуживания.РабочееПространство = &РабочееПространство И ТочкаОбслуживания.Область = &Область И НЕ ТочкаОбслуживания.ПометкаУдаления
        |И Договор.Абонент.РабочееПространство = &РабочееПространство И Договор.Абонент.Область = &Область
        |И НЕ Договор.Абонент.ПометкаУдаления И ОбъектНедвижимости.АбонентВладелец = Договор.Абонент
        |И Договор.ОбъектНедвижимости = ОбъектНедвижимости И Договор.ТочкаОбслуживания = ТочкаОбслуживания
        |И ТочкаОбслуживания.ОбъектНедвижимости = ОбъектНедвижимости И ТочкаОбслуживания.ВидУслуги = Договор.ВидУслуги
        |И (Состояние = &Действующий ИЛИ Состояние = &Закрытый) И (&ЛюбойСостояние ИЛИ Состояние = &Состояние)
        |И (&ЛюбойИдентификатор ИЛИ Ссылка = &ИдентификаторСсылки) И (&ЛюбойПоиск ИЛИ НормализованныйНомер = &Поиск)
        |УПОРЯДОЧИТЬ ПО ДатаСоздания, Ссылка");
    Если Не ПустаяСтрока(Поиск) Тогда
        Поиск = НормализоватьНомер(Поиск, 32);
    КонецЕсли;
    Возврат ВыполнитьЗапросВОбласти(Запрос, СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, ИдентификаторСсылки, Состояние, Поиск, "PersonalAccount", Лимит, Курсор);
КонецФункции

Функция ВыполнитьЗапросВОбласти(Запрос, СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, ИдентификаторСсылки, Состояние, Поиск, Вид, Лимит = Неопределено, Курсор = "")
    ПроверитьФильтрСостояния(Состояние);
    Поиск = ПроверенныйТекст(Поиск, 250, Ложь);
    КонтекстДоступа = НачатьТранзакциюВОбласти(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор);
    Попытка
        УстановитьПараметрыОбласти(Запрос, КонтекстДоступа);
        Запрос.УстановитьПараметр("ЛюбойСостояние", ПустаяСтрока(Состояние));
        Запрос.УстановитьПараметр("Состояние", Состояние);
        Запрос.УстановитьПараметр("ЛюбойИдентификатор", Не ЗначениеЗаполнено(ИдентификаторСсылки));
        Запрос.УстановитьПараметр("ИдентификаторСсылки", ИдентификаторСсылки);
        Запрос.УстановитьПараметр("ЛюбойПоиск", ПустаяСтрока(Поиск));
        Запрос.УстановитьПараметр("Поиск", Поиск);
        Страница = ПодготовитьСтраницу(Запрос, Лимит, Курсор, Новый Структура("actor,workspace,area,kind,state,search",
            Строка(СсылкаУчетнойЗаписи.УникальныйИдентификатор()), РабочаяОбластьИдентификатор, ОбластьИдентификатор, Вид, Состояние, Поиск), ИдентификаторСсылки);
        Выборка = Запрос.Выполнить().Выбрать();
        Результат = Новый Массив;
        Пока Выборка.Следующий() Цикл
            Если Вид = "Subscriber" Тогда
                Результат.Добавить(ДанныеАбонента(Выборка));
            ИначеЕсли Вид = "Property" Тогда
                Результат.Добавить(ДанныеОбъектаАбонента(Выборка));
            ИначеЕсли Вид = "ServicePoint" Тогда
                Результат.Добавить(ДанныеТочкиОбслуживания(Выборка));
            ИначеЕсли Вид = "Contract" Тогда
                Результат.Добавить(ДанныеДоговора(Выборка));
            ИначеЕсли Вид = "PersonalAccount" Тогда
                Результат.Добавить(ДанныеЛицевогоСчета(Выборка));
            Иначе
                ВызватьИсключение "кабинет_реестр_некорректно_вид";
            КонецЕсли;
        КонецЦикла;
        Результат = ЗавершитьСтраницу(Результат, Страница);
        ЗафиксироватьТранзакцию();
    Исключение
        Если ТранзакцияАктивна() Тогда
            ОтменитьТранзакцию();
        КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПроверитьАбонента(ИдентификаторСсылки, КонтекстДоступа, РазрешитьЗакрытый)
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Абоненты
        |ГДЕ Ссылка = &ИдентификаторСсылки И РабочееПространство = &РабочееПространство И Область = &Область И НЕ ПометкаУдаления
        |И (Состояние = &Действующий ИЛИ (&РазрешитьЗакрытый И Состояние = &Закрытый))");
    СтрокаВыборки = ВыборкаСвязанныхОбъектов(Запрос, ИдентификаторСсылки, КонтекстДоступа, РазрешитьЗакрытый);
    Возврат Новый Структура("Ссылка", СтрокаВыборки.Ссылка);
КонецФункции

Функция ПроверитьОбъектАбонента(ИдентификаторСсылки, КонтекстДоступа, РазрешитьЗакрытый)
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка, АбонентВладелец ИЗ Справочник.ОбъектыНедвижимости
        |ГДЕ Ссылка = &ИдентификаторСсылки И РабочееПространство = &РабочееПространство И Область = &Область И НЕ ПометкаУдаления
        |И (Состояние = &Действующий ИЛИ (&РазрешитьЗакрытый И Состояние = &Закрытый))");
    СтрокаВыборки = ВыборкаСвязанныхОбъектов(Запрос, ИдентификаторСсылки, КонтекстДоступа, РазрешитьЗакрытый);
    Возврат Новый Структура("Ссылка,АбонентВладелец", СтрокаВыборки.Ссылка, СтрокаВыборки.АбонентВладелец);
КонецФункции

Функция ПроверитьТочкуОбслуживания(ИдентификаторСсылки, КонтекстДоступа, РазрешитьЗакрытый)
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка, ОбъектНедвижимости, ВидУслуги ИЗ Справочник.ТочкиОбслуживания
        |ГДЕ Ссылка = &ИдентификаторСсылки И РабочееПространство = &РабочееПространство И Область = &Область И НЕ ПометкаУдаления
        |И (Состояние = &Действующий ИЛИ (&РазрешитьЗакрытый И Состояние = &Закрытый))");
    СтрокаВыборки = ВыборкаСвязанныхОбъектов(Запрос, ИдентификаторСсылки, КонтекстДоступа, РазрешитьЗакрытый);
    Возврат Новый Структура("Ссылка,ОбъектНедвижимости,ВидУслуги", СтрокаВыборки.Ссылка, СтрокаВыборки.ОбъектНедвижимости, СтрокаВыборки.ВидУслуги);
КонецФункции

Функция ПроверитьДоговор(ИдентификаторСсылки, КонтекстДоступа, РазрешитьЗакрытый)
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка, Абонент, ОбъектНедвижимости, ТочкаОбслуживания, ВидУслуги ИЗ Справочник.Договоры
        |ГДЕ Ссылка = &ИдентификаторСсылки И РабочееПространство = &РабочееПространство И Область = &Область И НЕ ПометкаУдаления
        |И (Состояние = &Действующий ИЛИ (&РазрешитьЗакрытый И Состояние = &Закрытый))");
    СтрокаВыборки = ВыборкаСвязанныхОбъектов(Запрос, ИдентификаторСсылки, КонтекстДоступа, РазрешитьЗакрытый);
    Возврат Новый Структура("Ссылка,Абонент,ОбъектНедвижимости,ТочкаОбслуживания,ВидУслуги",
        СтрокаВыборки.Ссылка, СтрокаВыборки.Абонент, СтрокаВыборки.ОбъектНедвижимости, СтрокаВыборки.ТочкаОбслуживания, СтрокаВыборки.ВидУслуги);
КонецФункции

Функция ВыборкаСвязанныхОбъектов(Запрос, ИдентификаторСсылки, КонтекстДоступа, РазрешитьЗакрытый)
    УстановитьПараметрыОбласти(Запрос, КонтекстДоступа);
    Запрос.УстановитьПараметр("ИдентификаторСсылки", ИдентификаторСсылки);
    Запрос.УстановитьПараметр("РазрешитьЗакрытый", РазрешитьЗакрытый);
    ВыборкаДанных = Запрос.Выполнить().Выбрать();
    Если Не ВыборкаДанных.Следующий() Тогда
        ВызватьИсключение "кабинет_реестр_не_найдено";
    КонецЕсли;
    Возврат ВыборкаДанных;
КонецФункции

Функция ПроверитьСвободныйНомерЛицевогоСчета(СсылкаРабочейОбласти, НормализованныйНомер)
    Привязка = РегистрыСведений.ПривязкиНомеровЛицевыхСчетов.СоздатьМенеджерЗаписи();
    Привязка.РабочееПространство = СсылкаРабочейОбласти;
    Привязка.НормализованныйНомер = НормализованныйНомер;
    Привязка.Прочитать();
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 2 Ссылка ИЗ Справочник.ЛицевыеСчета
        |ГДЕ РабочееПространство = &РабочееПространство И НормализованныйНомер = &НормализованныйНомер");
    Запрос.УстановитьПараметр("РабочееПространство", СсылкаРабочейОбласти);
    Запрос.УстановитьПараметр("НормализованныйНомер", НормализованныйНомер);
    ВыборкаДанных = Запрос.Выполнить().Выбрать();
    Если ВыборкаДанных.Следующий() Тогда
        СуществующийСсылка = ВыборкаДанных.Ссылка;
        Если Не Привязка.Выбран() Тогда
            ВызватьИсключение "кабинет_реестр_номер_привязка_конфликт";
        КонецЕсли;
        Если Привязка.ЛицевойСчет <> СуществующийСсылка Или ВыборкаДанных.Следующий() Тогда
            ВызватьИсключение "кабинет_реестр_номер_привязка_конфликт";
        КонецЕсли;
        ВызватьИсключение "кабинет_личный_учетная_запись_номер_конфликт";
    КонецЕсли;
    Если Привязка.Выбран() Тогда
        ВызватьИсключение "кабинет_реестр_номер_привязка_конфликт";
    КонецЕсли;
    Возврат Привязка;
КонецФункции

Функция НачатьТранзакциюВОбласти(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор)
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    Если ТранзакцияАктивна() Тогда
        ВызватьИсключение "кабинет_реестр_вложенная_транзакция";
    КонецЕсли;
    СсылкаРабочейОбласти = Справочники.РабочиеПространства.ПолучитьСсылку(РазобратьИдентификатор(РабочаяОбластьИдентификатор));
    СсылкаОбласти = Справочники.Области.ПолучитьСсылку(РазобратьИдентификатор(ОбластьИдентификатор));
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьОбъектПоСсылке("Справочник.УчетныеЗаписи", СсылкаУчетнойЗаписи);
        ЗаблокироватьОбъектПоСсылке("Справочник.РабочиеПространства", СсылкаРабочейОбласти);
        ЗаблокироватьОбъектПоСсылке("Справочник.Области", СсылкаОбласти);
        ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
        ПроверенныйОбласть = ПолитикаДоступа.ПроверитьДоступКОбласти(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, "BillingSpecialist");
        Если ПроверенныйОбласть <> СсылкаОбласти Тогда
            ВызватьИсключение "кабинет_область_запрещено";
        КонецЕсли;
    Исключение
        Если ТранзакцияАктивна() Тогда
            ОтменитьТранзакцию();
        КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
    Возврат Новый Структура("УчетнаяЗапись,РабочееПространство,Область", СсылкаУчетнойЗаписи, СсылкаРабочейОбласти, СсылкаОбласти);
КонецФункции

Процедура ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи)
    Текущий = ПолитикаДоступа.ПроверитьУчетнуюЗапись();
    Если ТипЗнч(СсылкаУчетнойЗаписи) <> Тип("СправочникСсылка.УчетныеЗаписи") Тогда
        ВызватьИсключение "кабинет_участник_несовпадение";
    КонецЕсли;
    Если Текущий.Ссылка <> СсылкаУчетнойЗаписи Тогда
        ВызватьИсключение "кабинет_участник_несовпадение";
    КонецЕсли;
КонецПроцедуры

Процедура ИнициализироватьЭлемент(Объект, КонтекстДоступа, Имя, Состояние)
    Объект.Наименование = Имя;
    Объект.РабочееПространство = КонтекстДоступа.РабочееПространство;
    Объект.Область = КонтекстДоступа.Область;
    Объект.Состояние = Состояние;
    Объект.КемСоздано = КонтекстДоступа.УчетнаяЗапись;
    Объект.ДатаСоздания = ТекущаяУниверсальнаяДата();
    Объект.ДатаОбновления = Объект.ДатаСоздания;
    Объект.Ревизия = 1;
КонецПроцедуры

Процедура УстановитьПараметрыОбласти(Запрос, КонтекстДоступа)
    Запрос.УстановитьПараметр("РабочееПространство", КонтекстДоступа.РабочееПространство);
    Запрос.УстановитьПараметр("Область", КонтекстДоступа.Область);
    Запрос.УстановитьПараметр("Действующий", "Active");
    Запрос.УстановитьПараметр("Закрытый", "Closed");
КонецПроцедуры

Процедура ПроверитьПоляТелаЗапроса(ТелоЗапроса, РазрешенныеПоля)
    Если ТипЗнч(ТелоЗапроса) <> Тип("Структура") Тогда
        ВызватьИсключение "кабинет_реестр_некорректно_тело";
    КонецЕсли;
    Разрешенные = СтрРазделить(РазрешенныеПоля, ",");
    Для Каждого Запись Из ТелоЗапроса Цикл
        Если Разрешенные.Найти(Запись.Ключ) = Неопределено Тогда
            ВызватьИсключение "кабинет_реестр_некорректно_поле";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ТекстовоеПоле(ТелоЗапроса, Имя, МаксДлина, Требуемый = Истина)
    Значение = "";
    Если Не ТелоЗапроса.Свойство(Имя, Значение) Тогда
        Если Требуемый Тогда
            ВызватьИсключение "кабинет_реестр_некорректно_поле";
        КонецЕсли;
        Возврат "";
    КонецЕсли;
    Возврат ПроверенныйТекст(Значение, МаксДлина, Требуемый);
КонецФункции

Функция ПроверенныйТекст(Значение, МаксДлина, Требуемый)
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_реестр_некорректно_поле";
    КонецЕсли;
    Если СтрДлина(Значение) > МаксДлина Тогда
        ВызватьИсключение "кабинет_реестр_некорректно_поле";
    КонецЕсли;
    Для Позиция = 1 По СтрДлина(Значение) Цикл
        Код = КодСимвола(Значение, Позиция);
        Если Код < 32 Или (Код >= 127 И Код <= 159)
            Или (Код >= 8203 И Код <= 8207) Или (Код >= 8234 И Код <= 8238)
            Или (Код >= 8288 И Код <= 8297) Или Код = 65279
            Или (Код >= 55296 И Код <= 57343) Тогда
            ВызватьИсключение "кабинет_реестр_некорректно_поле";
        КонецЕсли;
    КонецЦикла;
    Значение = СокрЛП(Значение);
    Если Требуемый И ПустаяСтрока(Значение) Тогда
        ВызватьИсключение "кабинет_реестр_некорректно_поле";
    КонецЕсли;
    Возврат Значение;
КонецФункции

Функция КонтактПечатнымиСимволами(ТелоЗапроса, Имя, МаксДлина)
    Значение = ТекстовоеПоле(ТелоЗапроса, Имя, МаксДлина, Ложь);
    Для Позиция = 1 По СтрДлина(Значение) Цикл
        Если КодСимвола(Значение, Позиция) > 126 Тогда
            ВызватьИсключение "кабинет_реестр_некорректно_поле";
        КонецЕсли;
    КонецЦикла;
    Возврат Значение;
КонецФункции

Функция ПолеИзПеречня(ТелоЗапроса, Имя, Варианты)
    Значение = ТекстовоеПоле(ТелоЗапроса, Имя, 32);
    Разрешенные = СтрРазделить(Варианты, ",");
    Если Разрешенные.Найти(Значение) = Неопределено Тогда
        ВызватьИсключение "кабинет_реестр_некорректно_поле";
    КонецЕсли;
    Возврат Значение;
КонецФункции

Функция СостояниеИзТелаЗапроса(ТелоЗапроса)
    Значение = ТекстовоеПоле(ТелоЗапроса, "state", 16, Ложь);
    Если ПустаяСтрока(Значение) Тогда
        Возврат "Active";
    КонецЕсли;
    ПроверитьФильтрСостояния(Значение);
    Возврат Значение;
КонецФункции

Процедура ПроверитьФильтрСостояния(Состояние)
    Если ТипЗнч(Состояние) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_реестр_некорректно_состояние";
    КонецЕсли;
    Если Состояние <> "" И Состояние <> "Active" И Состояние <> "Closed" Тогда
        ВызватьИсключение "кабинет_реестр_некорректно_состояние";
    КонецЕсли;
КонецПроцедуры

Функция ЧисловоеПолеТела(ТелоЗапроса, Имя, МаксДлина)
    Значение = "";
    Если Не ТелоЗапроса.Свойство(Имя, Значение) Тогда
        ВызватьИсключение "кабинет_реестр_некорректно_номер";
    КонецЕсли;
    Возврат НормализоватьНомер(Значение, МаксДлина);
КонецФункции

Функция НормализоватьНомер(Значение, МаксДлина)
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_реестр_некорректно_номер";
    КонецЕсли;
    Если СтрДлина(Значение) = 0 Или СтрДлина(Значение) > МаксДлина Тогда
        ВызватьИсключение "кабинет_реестр_некорректно_номер";
    КонецЕсли;
    Для Позиция = 1 По СтрДлина(Значение) Цикл
        Если КодСимвола(Значение, Позиция) > 126 Тогда
            ВызватьИсключение "кабинет_реестр_некорректно_номер";
        КонецЕсли;
    КонецЦикла;
    Значение = ВРег(ПроверенныйТекст(Значение, МаксДлина, Истина));
    Разрешенные = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-/_";
    ЕстьБуквенныйЧисловой = Ложь;
    Для Позиция = 1 По СтрДлина(Значение) Цикл
        Символ = Сред(Значение, Позиция, 1);
        Если СтрНайти(Разрешенные, Символ) = 0 Тогда
            ВызватьИсключение "кабинет_реестр_некорректно_номер";
        КонецЕсли;
        Если СтрНайти("ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789", Символ) > 0 Тогда
            ЕстьБуквенныйЧисловой = Истина;
        КонецЕсли;
    КонецЦикла;
    Если Не ЕстьБуквенныйЧисловой Тогда
        ВызватьИсключение "кабинет_реестр_некорректно_номер";
    КонецЕсли;
    Возврат Значение;
КонецФункции

Функция ПолеДатыUTC(ТелоЗапроса, Имя, Требуемый = Истина)
    Значение = ТекстовоеПоле(ТелоЗапроса, Имя, 20, Требуемый);
    Если Значение = "" И Не Требуемый Тогда
        Возврат Дата(1, 1, 1);
    КонецЕсли;
    Если СтрДлина(Значение) <> 20 Или Сред(Значение, 5, 1) <> "-" Или Сред(Значение, 8, 1) <> "-"
        Или Сред(Значение, 11, 1) <> "T" Или Сред(Значение, 14, 1) <> ":"
        Или Сред(Значение, 17, 1) <> ":" Или Прав(Значение, 1) <> "Z" Тогда
        ВызватьИсключение "кабинет_реестр_некорректно_даты";
    КонецЕсли;
    Цифры = Лев(Значение, 4) + Сред(Значение, 6, 2) + Сред(Значение, 9, 2)
        + Сред(Значение, 12, 2) + Сред(Значение, 15, 2) + Сред(Значение, 18, 2);
    Для Позиция = 1 По СтрДлина(Цифры) Цикл
        Если СтрНайти("0123456789", Сред(Цифры, Позиция, 1)) = 0 Тогда
            ВызватьИсключение "кабинет_реестр_некорректно_даты";
        КонецЕсли;
    КонецЦикла;
    Попытка
        Разобранный = XMLЗначение(Тип("Дата"), Лев(Значение, 19));
    Исключение
        ВызватьИсключение "кабинет_реестр_некорректно_даты";
    КонецПопытки;
    Если Разобранный = Дата(1, 1, 1) Тогда
        ВызватьИсключение "кабинет_реестр_некорректно_даты";
    КонецЕсли;
    Возврат Разобранный;
КонецФункции

Функция РазобратьИдентификатор(Идентификатор)
    Если ТипЗнч(Идентификатор) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецЕсли;
    Если СтрДлина(Идентификатор) <> 36 Тогда
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецЕсли;
    Попытка
        Разобранный = Новый УникальныйИдентификатор(Идентификатор);
    Исключение
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецПопытки;
    Если Строка(Разобранный) = "00000000-0000-0000-0000-000000000000" Тогда
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецЕсли;
    Возврат Разобранный;
КонецФункции

Процедура ЗаблокироватьОбъектПоСсылке(ПространствоИмен, ИдентификаторСсылки)
