Функция ВыполнитьКомандуЗапуска(Команда) Экспорт
    Если Не РольДоступна("Администратор") Тогда ВызватьИсключение "кабинет_операции_запрещено"; КонецЕсли;
    Если ТипЗнч(Команда) <> Тип("Строка") Тогда ВызватьИсключение "кабинет_операции_некорректно_действие"; КонецЕсли;
    Если Команда = "VodokanalQuotaMigration" Тогда Возврат ВыполнитьМиграциюКвот(); КонецЕсли;
    ФайлРезультата = Новый Файл("/run/vodokanal-maintenance/result.json");
    Если ФайлРезультата.Существует() Тогда ВызватьИсключение "кабинет_операции_квитанция_существует"; КонецЕсли;
    Если Команда = "VodokanalMaintenanceEnable" Тогда
        Данные = СервисЭксплуатации.НастроитьРегламентноеОбслуживание(Истина);
    ИначеЕсли Команда = "VodokanalMaintenanceDisable" Тогда
        Данные = СервисЭксплуатации.НастроитьРегламентноеОбслуживание(Ложь);
    ИначеЕсли Команда = "VodokanalMaintenanceOnce" Тогда
        Ключ = "maintenance:" + Формат(ТекущаяУниверсальнаяДата(), "ДФ=yyyyMMddHHmm");
        Идентификатор = СервисЭксплуатации.ВыполнитьОбслуживание(Ключ);
        Данные = Новый Структура("id,key,jobs", Идентификатор, Ключ, СервисЭксплуатации.ПолучитьЗаданияОператора(25));
    ИначеЕсли Команда = "VodokanalMaintenanceStatus" Тогда
        Данные = Новый Структура("jobs", СервисЭксплуатации.ПолучитьЗаданияОператора(25));
    Иначе ВызватьИсключение "кабинет_операции_некорректно_действие";
    КонецЕсли;
    Результат = Новый Структура("schema,command,configurationVersion,completedAt,data", "vodokanal.maintenance.v1",
        Команда, Метаданные.Версия, XMLСтрока(ТекущаяУниверсальнаяДата()), Данные);
    Запись = Новый ЗаписьJSON; Запись.УстановитьСтроку(); ЗаписатьJSON(Запись, Результат);
    Текст = Запись.Закрыть(); Байты = ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь);
    Поток = Новый ФайловыйПоток("/run/vodokanal-maintenance/result.json", РежимОткрытияФайла.СоздатьНовый, ДоступКФайлу.Запись);
    Попытка Байты.Записать(Поток); Поток.Закрыть(); Исключение Поток.Закрыть(); ВызватьИсключение; КонецПопытки;
    Возврат "operations_completed";
КонецФункции

Функция ВыполнитьМиграциюКвот()
    ПроверитьАдминистратораМиграцииКвот();
    Если ТранзакцияАктивна() Или МонопольныйРежим() Тогда ВызватьИсключение "кабинет_квота_миграция_контекст_конфликт"; КонецЕсли;
    Вход = ПрочитатьНамерениеМиграцииКвот();
    Для Каждого Имя Из СтрРазделить("attempt.json,result.json", ",") Цикл
        ФайлПроверки = Новый Файл("/run/vodokanal-quota-migration/" + Имя);
        Если ФайлПроверки.Существует() Тогда ВызватьИсключение "кабинет_квота_миграция_квитанция_существует"; КонецЕсли;
    КонецЦикла;
    ПопыткаМиграции = Новый Структура("schema,requestId,action,configurationVersion,policy,implementation,controllerBindingSha256,startedAt",
        "vodokanal.quota-migration-attempt.v1", Вход.requestId, Вход.action, Метаданные.Версия,
        Вход.expectedPolicy, Вход.implementation, Вход.controllerBindingSha256, XMLСтрока(ТекущаяУниверсальнаяДата()));
    ЗаписатьКвитанциюМиграцииКвот("attempt.json", ПопыткаМиграции);
    СобственныйМонопольный = Ложь;
    Попытка
        УстановитьМонопольныйРежим(Истина);
        СобственныйМонопольный = Истина;
        Если Не МонопольныйРежим() Тогда ВызватьИсключение "кабинет_операции_монопольный_режим_требуется"; КонецЕсли;
        ПроверитьАдминистратораМиграцииКвот();
        Если Вход.action = "Bootstrap" Тогда
            НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
            Данные = ОграниченияОбъектовОбластей.ИнициализироватьВсеКвотыАдминистратора(Вход.expectedVersion, Вход.expectedPolicy);
            ЗафиксироватьТранзакцию();
        ИначеЕсли Вход.action = "ScopesBatch" Тогда
            ОграниченияОбъектовОбластей.ПроверитьГотовностьКвот();
            Данные = СервисДокументов.ВосстановитьОбластиЭкспортов(100, "");
        Иначе
            Данные = Новый Структура;
        КонецЕсли;
        Готовность = ГотовностьМиграцииКвот();
        УстановитьМонопольныйРежим(Ложь);
        СобственныйМонопольный = Ложь;
        Результат = Новый Структура("schema,requestId,action,configurationVersion,policy,implementation,controllerBindingSha256,completedAt,readiness,data",
            "vodokanal.quota-migration-result.v1", Вход.requestId, Вход.action, Метаданные.Версия,
            Вход.expectedPolicy, Вход.implementation, Вход.controllerBindingSha256,
            XMLСтрока(ТекущаяУниверсальнаяДата()), Готовность, Данные);
        ЗаписатьКвитанциюМиграцииКвот("result.json", Результат);
    Исключение
        Попытка
            Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
        Исключение
            Если СобственныйМонопольный Тогда УстановитьМонопольныйРежим(Ложь); КонецЕсли;
            ВызватьИсключение;
        КонецПопытки;
        Если СобственныйМонопольный Тогда УстановитьМонопольныйРежим(Ложь); КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
    Возврат "quota_migration_completed";
КонецФункции

Процедура ПроверитьАдминистратораМиграцииКвот()
    Если ПривилегированныйРежим() Или Не РольДоступна("Администратор") Тогда ВызватьИсключение "кабинет_операции_запрещено"; КонецЕсли;
    Текущий = ПользователиИнформационнойБазы.ТекущийПользователь();
    Если Текущий = Неопределено Тогда ВызватьИсключение "кабинет_операции_запрещено"; КонецЕсли;
    Сохраненный = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Текущий.УникальныйИдентификатор);
    Если Сохраненный = Неопределено Тогда ВызватьИсключение "кабинет_операции_запрещено"; КонецЕсли;
    Найден = Ложь;
    Для Каждого Роль Из Сохраненный.Роли Цикл
        Если Роль = Метаданные.Роли.Администратор Тогда Найден = Истина; КонецЕсли;
    КонецЦикла;
    Если Не Найден Тогда ВызватьИсключение "кабинет_операции_запрещено"; КонецЕсли;
КонецПроцедуры

Функция ПрочитатьНамерениеМиграцииКвот()
    ФайлВвода = Новый Файл("/run/vodokanal-quota-migration/intent.json");
    Если Не ФайлВвода.Существует() Тогда ВызватьИсключение "кабинет_квота_миграция_некорректно_намерение"; КонецЕсли;
    Если ФайлВвода.Размер() < 2 Или ФайлВвода.Размер() > 4096 Тогда ВызватьИсключение "кабинет_квота_миграция_некорректно_намерение"; КонецЕсли;
    Чтение = Новый ЧтениеJSON;
    Попытка
        Чтение.ОткрытьФайл("/run/vodokanal-quota-migration/intent.json"); Вход = ПрочитатьJSON(Чтение); Чтение.Закрыть();
    Исключение
        Попытка Чтение.Закрыть(); Исключение КонецПопытки;
        ВызватьИсключение "кабинет_квота_миграция_некорректно_намерение";
    КонецПопытки;
    Если ТипЗнч(Вход) <> Тип("Структура") Тогда ВызватьИсключение "кабинет_квота_миграция_некорректно_намерение"; КонецЕсли;
    Ключи = СтрРазделить("schema,requestId,action,expectedVersion,expectedPolicy,implementation,controllerBindingSha256", ",");
    Если Вход.Количество() <> Ключи.Количество() Тогда ВызватьИсключение "кабинет_квота_миграция_некорректно_намерение"; КонецЕсли;
    Для Каждого Ключ Из Ключи Цикл
        ЗначениеПоля = Неопределено;
        Если Не Вход.Свойство(Ключ, ЗначениеПоля) Тогда ВызватьИсключение "кабинет_квота_миграция_некорректно_намерение"; КонецЕсли;
        Если ТипЗнч(ЗначениеПоля) <> Тип("Строка") Тогда ВызватьИсключение "кабинет_квота_миграция_некорректно_намерение"; КонецЕсли;
    КонецЦикла;
    Если Вход.schema <> "vodokanal.quota-migration-intent.v1"
        Или Вход.expectedVersion <> "1.0" Или Метаданные.Версия <> Вход.expectedVersion
        Или Вход.expectedPolicy <> "root-objects-v1"
        Или ОграниченияОбъектовОбластей.ПолитикаКорневыхОбъектов() <> Вход.expectedPolicy
        Или Вход.implementation <> "adm08-production-migration-v1" Тогда ВызватьИсключение "кабинет_квота_миграция_некорректно_намерение"; КонецЕсли;
    Если Вход.action <> "Bootstrap" И Вход.action <> "ScopesBatch" И Вход.action <> "Status" Тогда ВызватьИсключение "кабинет_квота_миграция_некорректно_намерение"; КонецЕсли;
    Попытка ИдНамерения = Новый УникальныйИдентификатор(Вход.requestId); Исключение ВызватьИсключение "кабинет_квота_миграция_некорректно_намерение"; КонецПопытки;
    Если НРег(Строка(ИдНамерения)) <> Вход.requestId Или Вход.requestId = "00000000-0000-0000-0000-000000000000" Тогда ВызватьИсключение "кабинет_квота_миграция_некорректно_намерение"; КонецЕсли;
    Если СтрДлина(Вход.controllerBindingSha256) <> 64 Тогда ВызватьИсключение "кабинет_квота_миграция_некорректно_намерение"; КонецЕсли;
    Для Номер = 1 По 64 Цикл
        Если СтрНайти("0123456789abcdef", Сред(Вход.controllerBindingSha256, Номер, 1)) = 0 Тогда ВызватьИсключение "кабинет_квота_миграция_некорректно_намерение"; КонецЕсли;
    КонецЦикла;
    Возврат Вход;
КонецФункции

Функция ГотовностьМиграцииКвот()
    ОбъектыГотовы = Истина; ЭкспортыГотовы = Истина;
    Попытка ОграниченияОбъектовОбластей.ПроверитьГотовностьКвот();
    Исключение
        Если СтрНайти(ОписаниеОшибки(), "кабинет_объект_квота_миграция_требуется") = 0 Тогда ВызватьИсключение; КонецЕсли;
        ОбъектыГотовы = Ложь;
    КонецПопытки;
    Попытка СервисДокументов.ПроверитьГотовностьОбластейЭкспортов();
    Исключение
        Если СтрНайти(ОписаниеОшибки(), "кабинет_документ_граница_миграция_требуется") = 0 Тогда ВызватьИсключение; КонецЕсли;
        ЭкспортыГотовы = Ложь;
    КонецПопытки;
    Возврат Новый Структура("objects,exports,complete", ОбъектыГотовы, ЭкспортыГотовы, ОбъектыГотовы И ЭкспортыГотовы);
КонецФункции

Процедура ЗаписатьКвитанциюМиграцииКвот(Имя, Данные)
    Если Имя <> "attempt.json" И Имя <> "result.json" Тогда ВызватьИсключение "кабинет_квота_миграция_некорректно_намерение"; КонецЕсли;
    Запись = Новый ЗаписьJSON; Запись.УстановитьСтроку(); ЗаписатьJSON(Запись, Данные);
    Байты = ПолучитьДвоичныеДанныеИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8, Ложь);
    Если Байты.Размер() > 65536 Тогда ВызватьИсключение "кабинет_квота_миграция_квитанция_слишком_большое"; КонецЕсли;
    Поток = Новый ФайловыйПоток("/run/vodokanal-quota-migration/" + Имя, РежимОткрытияФайла.СоздатьНовый, ДоступКФайлу.Запись);
    Попытка Байты.Записать(Поток); Поток.Закрыть(); Исключение Поток.Закрыть(); ВызватьИсключение; КонецПопытки;
КонецПроцедуры
