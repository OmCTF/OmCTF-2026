Функция ОбработатьЗапрос(Действие, Запрос) Экспорт
    Корреляция = Строка(СервисДокументов.НовыйUUIDv4());
    Попытка
        ПроверитьСубъекта();
        Если Запрос.HTTPМетод <> "GET" Тогда
            Возврат ОтветОшибки(405, "метод_не_разрешено", "Метод запроса не поддерживается.", Корреляция);
        КонецЕсли;
        Для Каждого Заголовок Из Запрос.Заголовки Цикл
            Имя = НРег(Заголовок.Ключ);
            Если Имя = "cookie" Или Имя = "authorization" Или Имя = "transfer-encoding"
                Или (Имя = "content-length" И СокрЛП(Заголовок.Значение) <> "0") Тогда
                ВызватьИсключение "публичный_кабинет_некорректно_ввод";
            КонецЕсли;
        КонецЦикла;
        Тело = Запрос.ПолучитьТелоКакДвоичныеДанные();
        Если Тело <> Неопределено Тогда
            Если Тело.Размер() <> 0 Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
        КонецЕсли;
        Если Действие = "summary" Тогда
            ПроверитьПараметры(Запрос, ""); Данные = СервисПубличногоПортала.Сводка();
        ИначеЕсли Действие = "services" Или Действие = "content" Или Действие = "faq" Тогда
            ПроверитьПараметры(Запрос, "kind,q,from,to,limit,cursor,applicant");
            Вид = Параметр(Запрос, "kind", 16);
            Если Действие = "services" Тогда Вид = "service";
            ИначеЕсли Действие = "faq" Тогда Вид = "faq"; КонецЕсли;
            Данные = СервисПубличногоПортала.ПубличныйСписок(Вид, Параметр(Запрос, "q", 100),
                Параметр(Запрос, "from", 20), Параметр(Запрос, "to", 20),
                Параметр(Запрос, "limit", 3), Параметр(Запрос, "cursor", 36),
                Параметр(Запрос, "applicant", 16), Действие = "services");
        Иначе ВызватьИсключение "публичный_кабинет_не_найдено";
        КонецЕсли;
        Возврат Ответ(200, Данные, Корреляция);
    Исключение
        Ошибка = ОписаниеОшибки(); Код = "публичный_кабинет_недоступно"; Статус = 503;
        Сообщение = "Публичный портал временно недоступен. Повторите запрос позже.";
        Если СтрНайти(Ошибка, "публичный_кабинет_учетная_запись_запрещено") > 0 Тогда
            Код = "forbidden"; Статус = 403; Сообщение = "Доступ запрещён.";
        ИначеЕсли СтрНайти(Ошибка, "публичный_кабинет_некорректно_ввод") > 0 Тогда
            Код = "публичный_кабинет_некорректно_ввод"; Статус = 400; Сообщение = "Некорректные параметры запроса.";
        ИначеЕсли СтрНайти(Ошибка, "публичный_кабинет_не_найдено") > 0 Тогда
            Код = "публичный_кабинет_не_найдено"; Статус = 404; Сообщение = "Запрошенный раздел не найден.";
        КонецЕсли;
        Возврат ОтветОшибки(Статус, Код, Сообщение, Корреляция);
    КонецПопытки;
КонецФункции

Процедура ПроверитьСубъекта() Экспорт
    Если ПривилегированныйРежим() Тогда ВызватьИсключение "публичный_кабинет_учетная_запись_запрещено"; КонецЕсли;
    Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
    Если Пользователь = Неопределено Тогда ВызватьИсключение "публичный_кабинет_учетная_запись_запрещено"; КонецЕсли;
    Количество = 0;
    Для Каждого Роль Из Пользователь.Роли Цикл Количество = Количество + 1; КонецЦикла;
    Если Пользователь.Имя <> "vodokanal_portal_reader" Или Количество <> 1 Или Не РольДоступна("ПубличноеЧтениеПортала") Тогда
        ВызватьИсключение "публичный_кабинет_учетная_запись_запрещено";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьПараметры(Запрос, Имена)
    Допустимые = СтрРазделить(Имена, ",", Ложь);
    Для Каждого Пара Из Запрос.ПараметрыЗапроса Цикл
        Если Допустимые.Найти(Пара.Ключ) = Неопределено Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция Параметр(Запрос, Имя, Максимум)
    Значение = Запрос.ПараметрыЗапроса.Получить(Имя);
    Если Значение = Неопределено Тогда Возврат ""; КонецЕсли;
    Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) > Максимум Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
    Возврат Значение;
КонецФункции

Функция ОтветОшибки(Статус, Код, Сообщение, Корреляция)
    Ошибка = Новый Структура("code,message", Код, Сообщение);
    Возврат Ответ(Статус, Новый Структура("error,requestId", Ошибка, Корреляция), Корреляция);
КонецФункции

Функция Ответ(Статус, Данные, Корреляция)
    Запись = Новый ЗаписьJSON; Запись.УстановитьСтроку(); ЗаписатьJSON(Запись, Данные);
    Результат = Новый HTTPСервисОтвет(Статус);
    Результат.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Результат.Заголовки.Вставить("Cache-Control", "no-store");
    Результат.Заголовки.Вставить("X-Content-Type-Options", "nosniff");
    Результат.Заголовки.Вставить("X-API-Contract", "1.0");
    Результат.Заголовки.Вставить("X-Request-ID", Корреляция);
    Результат.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8); Возврат Результат;
КонецФункции
