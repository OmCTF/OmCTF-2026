
Функция ПолучитьСписокПриглашений(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор = "", Лимит = Неопределено, Курсор = "") Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    Если ТипЗнч(РабочаяОбластьИдентификатор) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецЕсли;
    Входящий = ПустаяСтрока(РабочаяОбластьИдентификатор);
    СсылкаРабочейОбласти = Справочники.РабочиеПространства.ПустаяСсылка();
    Если Не Входящий Тогда
        СсылкаРабочейОбласти = Справочники.РабочиеПространства.ПолучитьСсылку(РазобратьИдентификатор(РабочаяОбластьИдентификатор));
        ПроверитьПолномочияВладельца(СсылкаУчетнойЗаписи, СсылкаРабочейОбласти, ТекущаяУниверсальнаяДата());
    КонецЕсли;
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 200 Ссылка, РабочееПространство, УчетнаяЗаписьПригласившего, УчетнаяЗаписьПолучателя,
        |Роль, ОхватОбластей, Область, Состояние, ДатаСоздания, СрокИстечения, Ревизия,
        |Участие, ПринятаяРевизия, ДатаРешения
        |ИЗ Справочник.ПриглашенияВПространства
        |ГДЕ НЕ ПометкаУдаления
        |И ((&Входящий И УчетнаяЗаписьПолучателя = &УчетнаяЗапись)
        |ИЛИ (НЕ &Входящий И РабочееПространство = &РабочееПространство И УчетнаяЗаписьПригласившего = &УчетнаяЗапись))
        |УПОРЯДОЧИТЬ ПО ДатаСоздания УБЫВ, Ссылка");
    Контекст = ?(Входящий, "incoming", Строка(СсылкаРабочейОбласти.УникальныйИдентификатор()) + "/outgoing");
    Страница = ПолитикаДоступа.ПараметрыСтраницыIAM(СсылкаУчетнойЗаписи, Лимит, Курсор, "invitations", Контекст);
    ПолитикаДоступа.НастроитьЗапросСтраницыIAM(Запрос, Страница, "ВЫБРАТЬ ПЕРВЫЕ 200", "Ссылка");
    Запрос.УстановитьПараметр("Входящий", Входящий);
    Запрос.УстановитьПараметр("УчетнаяЗапись", СсылкаУчетнойЗаписи);
    Запрос.УстановитьПараметр("РабочееПространство", СсылкаРабочейОбласти);
    ВыборкаДанных = Запрос.Выполнить().Выбрать();
    Результат = Новый Массив;
    ТекущееВремя = ТекущаяУниверсальнаяДата();
    Пока ВыборкаДанных.Следующий() Цикл
        Результат.Добавить(ДанныеПриглашения(ВыборкаДанных, ТекущееВремя));
    КонецЦикла;
    Возврат ПолитикаДоступа.РезультатСтраницыIAM(Результат, Страница);
КонецФункции

Функция СоздатьПриглашение(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ПолучательУчетнаяЗаписьИдентификатор, Роль,
    ОхватОбластей = "All", ОбластьИдентификатор = "", СрокДействияВСекундах = 86400, ИдентификаторЗапроса = "") Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьРоль(Роль);
    ПроверитьОбластьДействия(ОхватОбластей, ОбластьИдентификатор);
    ПроверитьСрокДействия(СрокДействияВСекундах);
    ИдентификаторЗапроса = Строка(РазобратьИдентификатор(ИдентификаторЗапроса));
    СсылкаРабочейОбласти = Справочники.РабочиеПространства.ПолучитьСсылку(РазобратьИдентификатор(РабочаяОбластьИдентификатор));
    ПолучательСсылка = Справочники.УчетныеЗаписи.ПолучитьСсылку(РазобратьИдентификатор(ПолучательУчетнаяЗаписьИдентификатор));
    СсылкаОбласти = ОбластьДействияУчастия(ОхватОбластей, ОбластьИдентификатор);
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьУчетныеЗаписи(СсылкаУчетнойЗаписи, ПолучательСсылка);
        ЗаблокироватьОбъектПоСсылке("Справочник.РабочиеПространства", СсылкаРабочейОбласти);
        ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
        ТекущееВремя = ТекущаяУниверсальнаяДата();
        ПроверитьПолномочияВладельца(СсылкаУчетнойЗаписи, СсылкаРабочейОбласти, ТекущееВремя);
        ПроверитьАктивностьЦелевойУчетнойЗаписи(ПолучательСсылка);
        ПроверитьКонтекстОбласти(СсылкаРабочейОбласти, ОхватОбластей, СсылкаОбласти);
        ЗаблокироватьКлючПриглашения(СсылкаУчетнойЗаписи, ИдентификаторЗапроса);
        Привязка = РегистрыСведений.ПривязкиПриглашений.СоздатьМенеджерЗаписи();
        Привязка.УчетнаяЗаписьПригласившего = СсылкаУчетнойЗаписи;
        Привязка.ИдентификаторЗапроса = ИдентификаторЗапроса;
        Привязка.Прочитать();
        Если Привязка.Выбран() Тогда
            Приглашение = Привязка.Приглашение.ПолучитьОбъект();
            Если Приглашение = Неопределено Тогда
                ВызватьИсключение "кабинет_приглашение_привязка_конфликт";
            КонецЕсли;
            Если Приглашение.ПометкаУдаления Или Приглашение.УчетнаяЗаписьПригласившего <> СсылкаУчетнойЗаписи
                Или Приглашение.ИдентификаторЗапроса <> ИдентификаторЗапроса Или Приглашение.РабочееПространство <> СсылкаРабочейОбласти
                Или Приглашение.УчетнаяЗаписьПолучателя <> ПолучательСсылка Или Приглашение.Роль <> Роль
                Или Приглашение.ОхватОбластей <> ОхватОбластей Или Приглашение.Область <> СсылкаОбласти
                Или Приглашение.СрокДействияВСекундах <> СрокДействияВСекундах Тогда
                ВызватьИсключение "кабинет_приглашение_запрос_конфликт";
            КонецЕсли;
            ЗавершитьПросроченныеПриглашения(Приглашение, СсылкаУчетнойЗаписи, ТекущееВремя);
        Иначе
            Приглашение = Справочники.ПриглашенияВПространства.СоздатьЭлемент();
            Приглашение.SetNewObjectRef(Справочники.ПриглашенияВПространства.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
            Приглашение.Наименование = Роль;
            Приглашение.РабочееПространство = СсылкаРабочейОбласти;
            Приглашение.УчетнаяЗаписьПригласившего = СсылкаУчетнойЗаписи;
            Приглашение.УчетнаяЗаписьПолучателя = ПолучательСсылка;
            Приглашение.Роль = Роль;
            Приглашение.ОхватОбластей = ОхватОбластей;
            Приглашение.Область = СсылкаОбласти;
            Приглашение.Состояние = "Pending";
            Приглашение.ДатаСоздания = ТекущееВремя;
            Приглашение.СрокИстечения = ТекущееВремя + СрокДействияВСекундах;
            Приглашение.СрокДействияВСекундах = СрокДействияВСекундах;
            Приглашение.ИдентификаторЗапроса = ИдентификаторЗапроса;
            Приглашение.Ревизия = 1;
            Приглашение.РевизияДоИзмененияСостояния = 0;
            Приглашение.Записать();
            Привязка.УчетнаяЗаписьПригласившего = СсылкаУчетнойЗаписи;
            Привязка.ИдентификаторЗапроса = ИдентификаторЗапроса;
            Привязка.Приглашение = Приглашение.Ссылка;
            Привязка.Записать();
            ПолитикаДоступа.ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, СсылкаРабочейОбласти, "invitation.create", Строка(Приглашение.Ссылка.УникальныйИдентификатор()));
        КонецЕсли;
        Результат = ДанныеПриглашения(Приглашение, ТекущееВремя);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПринятьПриглашение(СсылкаУчетнойЗаписи, ПриглашениеИдентификатор, ОжидаемаяРевизия) Экспорт
    Возврат ИзменитьПриглашение(СсылкаУчетнойЗаписи, ПриглашениеИдентификатор, ОжидаемаяРевизия, "accept");
КонецФункции

Функция ОтклонитьПриглашение(СсылкаУчетнойЗаписи, ПриглашениеИдентификатор, ОжидаемаяРевизия) Экспорт
    Возврат ИзменитьПриглашение(СсылкаУчетнойЗаписи, ПриглашениеИдентификатор, ОжидаемаяРевизия, "decline");
КонецФункции

Функция ОтозватьПриглашение(СсылкаУчетнойЗаписи, ПриглашениеИдентификатор, ОжидаемаяРевизия) Экспорт
    Возврат ИзменитьПриглашение(СсылкаУчетнойЗаписи, ПриглашениеИдентификатор, ОжидаемаяРевизия, "revoke");
КонецФункции

Функция ОтключитьУчастие(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ЧленствоИдентификатор, ОжидаемаяРевизия) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьНомерРевизии(ОжидаемаяРевизия);
    СсылкаРабочейОбласти = Справочники.РабочиеПространства.ПолучитьСсылку(РазобратьИдентификатор(РабочаяОбластьИдентификатор));
    ЧленствоСсылка = Справочники.Участия.ПолучитьСсылку(РазобратьИдентификатор(ЧленствоИдентификатор));
    ПредварительныйСнимок = ЧленствоСсылка.ПолучитьОбъект();
    Если ПредварительныйСнимок = Неопределено Тогда
        ВызватьИсключение "кабинет_участие_не_найдено";
    КонецЕсли;
    Если ПредварительныйСнимок.ПометкаУдаления Или ПредварительныйСнимок.РабочееПространство <> СсылкаРабочейОбласти Тогда
        ВызватьИсключение "кабинет_участие_не_найдено";
    КонецЕсли;
    АдресатСсылка = ПредварительныйСнимок.УчетнаяЗапись;
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьУчетныеЗаписи(СсылкаУчетнойЗаписи, АдресатСсылка);
        ЗаблокироватьОбъектПоСсылке("Справочник.РабочиеПространства", СсылкаРабочейОбласти);
        ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
        ПроверитьПолномочияВладельца(СсылкаУчетнойЗаписи, СсылкаРабочейОбласти, ТекущаяУниверсальнаяДата());
        Участие = ЧленствоСсылка.ПолучитьОбъект();
        Если Участие = Неопределено Тогда
            ВызватьИсключение "кабинет_участие_не_найдено";
        КонецЕсли;
        Если Участие.ПометкаУдаления Или Участие.УчетнаяЗапись <> АдресатСсылка
            Или Участие.РабочееПространство <> СсылкаРабочейОбласти Тогда
            ВызватьИсключение "кабинет_участие_не_найдено";
        КонецЕсли;
        ПроверитьРоль(Участие.Роль);
        ЗаблокироватьКлючУчастия(СсылкаРабочейОбласти, АдресатСсылка, Участие.Роль, Участие.Область);
        Привязка = ПрочитатьПривязкуУчастия(СсылкаРабочейОбласти, АдресатСсылка, Участие.Роль, Участие.Область);
        Если Не Привязка.Выбран() Тогда
            ВызватьИсключение "кабинет_участие_привязка_конфликт";
        КонецЕсли;
        Если Привязка.Участие <> ЧленствоСсылка Тогда
            ВызватьИсключение "кабинет_участие_привязка_конфликт";
        КонецЕсли;
        Если Участие.Состояние = "Inactive" И Участие.КемОтключено = СсылкаУчетнойЗаписи
            И Участие.РевизияДоОтключения = ОжидаемаяРевизия
            И Участие.Ревизия = ОжидаемаяРевизия + 1 Тогда
            Результат = ДанныеУчастия(Участие);
        Иначе
            Если Участие.Ревизия <> ОжидаемаяРевизия Тогда
                ВызватьИсключение "кабинет_редакция_конфликт";
            КонецЕсли;
            Если Участие.Состояние <> "Active" Тогда
                ВызватьИсключение "кабинет_участие_состояние_конфликт";
            КонецЕсли;
            ПроверитьВозможностьУвеличения(Участие.Ревизия);
            Участие.Состояние = "Inactive";
            Участие.КемОтключено = СсылкаУчетнойЗаписи;
            Участие.РевизияДоОтключения = ОжидаемаяРевизия;
            Участие.Ревизия = Участие.Ревизия + 1;
            Участие.Записать();
            ПолитикаДоступа.ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, СсылкаРабочейОбласти, "membership.deactivate", Строка(ЧленствоСсылка.УникальныйИдентификатор()));
            Результат = ДанныеУчастия(Участие);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ИзменитьПриглашение(СсылкаУчетнойЗаписи, ПриглашениеИдентификатор, ОжидаемаяРевизия, Действие)
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьНомерРевизии(ОжидаемаяРевизия);
    ПриглашениеСсылка = Справочники.ПриглашенияВПространства.ПолучитьСсылку(РазобратьИдентификатор(ПриглашениеИдентификатор));
    ПредварительныйСнимок = ПриглашениеСсылка.ПолучитьОбъект();
    Если ПредварительныйСнимок = Неопределено Тогда
        ВызватьИсключение "кабинет_приглашение_не_найдено";
    КонецЕсли;
    ПроверитьУчастникаПриглашения(ПредварительныйСнимок, СсылкаУчетнойЗаписи, Действие);
    ПриглашающийСсылка = ПредварительныйСнимок.УчетнаяЗаписьПригласившего;
    ПолучательСсылка = ПредварительныйСнимок.УчетнаяЗаписьПолучателя;
    СсылкаРабочейОбласти = ПредварительныйСнимок.РабочееПространство;
    Сбой = "";
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьУчетныеЗаписи(ПриглашающийСсылка, ПолучательСсылка);
        ЗаблокироватьОбъектПоСсылке("Справочник.РабочиеПространства", СсылкаРабочейОбласти);
        ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
        ЗаблокироватьОбъектПоСсылке("Справочник.ПриглашенияВПространства", ПриглашениеСсылка);
        Приглашение = ПриглашениеСсылка.ПолучитьОбъект();
        Если Приглашение = Неопределено Тогда
            ВызватьИсключение "кабинет_приглашение_не_найдено";
        КонецЕсли;
        ПроверитьУчастникаПриглашения(Приглашение, СсылкаУчетнойЗаписи, Действие);
        Если Приглашение.УчетнаяЗаписьПригласившего <> ПриглашающийСсылка Или Приглашение.УчетнаяЗаписьПолучателя <> ПолучательСсылка
            Или Приглашение.РабочееПространство <> СсылкаРабочейОбласти Тогда
            ВызватьИсключение "кабинет_приглашение_привязка_конфликт";
        КонецЕсли;
        ТекущееВремя = ТекущаяУниверсальнаяДата();
        ПроверитьРоль(Приглашение.Роль);
        Если Действие = "accept" Или Действие = "revoke" Тогда
            ПроверитьПолномочияВладельца(ПриглашающийСсылка, СсылкаРабочейОбласти, ТекущееВремя);
        КонецЕсли;
        Если Действие = "accept" Тогда
            ПроверитьКонтекстОбласти(СсылкаРабочейОбласти, Приглашение.ОхватОбластей, Приглашение.Область);
        КонецЕсли;
        ТребуемыйСостояние = "Accepted";
        Если Действие = "decline" Тогда
            ТребуемыйСостояние = "Declined";
        ИначеЕсли Действие = "revoke" Тогда
            ТребуемыйСостояние = "Revoked";
        КонецЕсли;
        Если Приглашение.Состояние = ТребуемыйСостояние И Приглашение.РевизияДоИзмененияСостояния = ОжидаемаяРевизия Тогда
            Результат = ДанныеПриглашения(Приглашение, ТекущееВремя);
        Иначе
            Если Приглашение.Ревизия <> ОжидаемаяРевизия Тогда
                ВызватьИсключение "кабинет_редакция_конфликт";
            КонецЕсли;
            ЗавершитьПросроченныеПриглашения(Приглашение, СсылкаУчетнойЗаписи, ТекущееВремя);
            Если Приглашение.Состояние = "Expired" Тогда
                Сбой = "кабинет_приглашение_истекло";
            ИначеЕсли Приглашение.Состояние <> "Pending"
                И Не (Действие = "revoke" И Приглашение.Состояние = "Accepted") Тогда
                ВызватьИсключение "кабинет_приглашение_состояние_конфликт";
            Иначе
                ПроверитьВозможностьУвеличения(Приглашение.Ревизия);
                Если Действие = "accept" Тогда
                    ПредоставитьУчастиеПоПриглашению(Приглашение);
                ИначеЕсли Действие = "revoke" И Приглашение.Состояние = "Accepted" Тогда
                    ОтозватьДоступПоПриглашению(Приглашение);
                КонецЕсли;
                Приглашение.РевизияДоИзмененияСостояния = Приглашение.Ревизия;
                Приглашение.Состояние = ТребуемыйСостояние;
                Приглашение.ДатаРешения = ТекущееВремя;
                Приглашение.Ревизия = Приглашение.Ревизия + 1;
                Приглашение.Записать();
                ПолитикаДоступа.ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, СсылкаРабочейОбласти, "invitation." + Действие, Строка(ПриглашениеСсылка.УникальныйИдентификатор()));
            КонецЕсли;
            Результат = ДанныеПриглашения(Приглашение, ТекущееВремя);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Если Не ПустаяСтрока(Сбой) Тогда
        ВызватьИсключение Сбой;
    КонецЕсли;
    Возврат Результат;
КонецФункции

Процедура ПредоставитьУчастиеПоПриглашению(Приглашение)
    СсылкаРабочейОбласти = Приглашение.РабочееПространство;
    СсылкаУчетнойЗаписи = Приглашение.УчетнаяЗаписьПолучателя;
    ЗаблокироватьКлючУчастия(СсылкаРабочейОбласти, СсылкаУчетнойЗаписи, Приглашение.Роль, Приглашение.Область);
    Привязка = ПрочитатьПривязкуУчастия(СсылкаРабочейОбласти, СсылкаУчетнойЗаписи, Приглашение.Роль, Приглашение.Область);
    Если Привязка.Выбран() Тогда
        Участие = Привязка.Участие.ПолучитьОбъект();
        ПроверитьПривязанноеУчастие(Участие, СсылкаРабочейОбласти, СсылкаУчетнойЗаписи, Приглашение.Роль, Приглашение.Область);
        Если Участие.Состояние = "Active" Тогда
            ВызватьИсключение "кабинет_участие_активно_конфликт";
        КонецЕсли;
        Если Участие.Состояние <> "Inactive" Тогда
            ВызватьИсключение "кабинет_участие_состояние_конфликт";
        КонецЕсли;
        ПроверитьВозможностьУвеличения(Участие.Ревизия);
    Иначе
        Участие = Справочники.Участия.СоздатьЭлемент();
        Участие.SetNewObjectRef(Справочники.Участия.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
        Участие.Наименование = Приглашение.Роль;
        Участие.РабочееПространство = СсылкаРабочейОбласти;
        Участие.УчетнаяЗапись = СсылкаУчетнойЗаписи;
        Участие.Роль = Приглашение.Роль;
        Участие.Область = Приглашение.Область;
        Участие.Ревизия = 0;
    КонецЕсли;
    Участие.ОхватОбластей = Приглашение.ОхватОбластей;
    Участие.Состояние = "Active";
    Участие.СрокИстечения = Приглашение.СрокИстечения;
    Участие.ИсточникПолномочия = Приглашение.Ссылка;
    Участие.КемОтключено = Справочники.УчетныеЗаписи.ПустаяСсылка();
    Участие.РевизияДоОтключения = 0;
    Участие.Ревизия = Участие.Ревизия + 1;
    Участие.Записать();
    Привязка.РабочееПространство = СсылкаРабочейОбласти;
    Привязка.УчетнаяЗапись = СсылкаУчетнойЗаписи;
    Привязка.Роль = Приглашение.Роль;
    Привязка.Область = Приглашение.Область;
    Привязка.Участие = Участие.Ссылка;
    Привязка.Записать();
    Приглашение.Участие = Участие.Ссылка;
    Приглашение.ПринятаяРевизия = Участие.Ревизия;
    ПолитикаДоступа.ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, СсылкаРабочейОбласти, "membership.invitation.accept", Строка(Участие.Ссылка.УникальныйИдентификатор()));
КонецПроцедуры

Процедура ОтозватьДоступПоПриглашению(Приглашение)
    ЗаблокироватьКлючУчастия(Приглашение.РабочееПространство, Приглашение.УчетнаяЗаписьПолучателя, Приглашение.Роль, Приглашение.Область);
    Привязка = ПрочитатьПривязкуУчастия(Приглашение.РабочееПространство, Приглашение.УчетнаяЗаписьПолучателя, Приглашение.Роль, Приглашение.Область);
    Если Не Привязка.Выбран() Тогда
        ВызватьИсключение "кабинет_участие_привязка_конфликт";
    КонецЕсли;
    Если Привязка.Участие <> Приглашение.Участие Тогда
        ВызватьИсключение "кабинет_участие_привязка_конфликт";
    КонецЕсли;
    Участие = Привязка.Участие.ПолучитьОбъект();
    ПроверитьПривязанноеУчастие(Участие, Приглашение.РабочееПространство, Приглашение.УчетнаяЗаписьПолучателя, Приглашение.Роль, Приглашение.Область);
    Если Участие.ИсточникПолномочия = Приглашение.Ссылка
        И Участие.Ревизия = Приглашение.ПринятаяРевизия И Участие.Состояние = "Active" Тогда
        ПроверитьВозможностьУвеличения(Участие.Ревизия);
        Участие.Состояние = "Inactive";
        Участие.Ревизия = Участие.Ревизия + 1;
        Участие.КемОтключено = Справочники.УчетныеЗаписи.ПустаяСсылка();
        Участие.РевизияДоОтключения = 0;
        Участие.Записать();
        ПолитикаДоступа.ЗаписатьСобытиеАудита(Приглашение.УчетнаяЗаписьПригласившего, Приглашение.РабочееПространство,
            "membership.invitation.revoke", Строка(Участие.Ссылка.УникальныйИдентификатор()));
    КонецЕсли;
КонецПроцедуры

Процедура ЗавершитьПросроченныеПриглашения(Приглашение, ДействующееЛицоСсылка, ТекущееВремя)
    Если Приглашение.Состояние = "Pending" И Приглашение.СрокИстечения <= ТекущееВремя Тогда
        ПроверитьВозможностьУвеличения(Приглашение.Ревизия);
        Приглашение.РевизияДоИзмененияСостояния = Приглашение.Ревизия;
        Приглашение.Состояние = "Expired";
        Приглашение.ДатаРешения = ТекущееВремя;
        Приглашение.Ревизия = Приглашение.Ревизия + 1;
        Приглашение.Записать();
        ПолитикаДоступа.ЗаписатьСобытиеАудита(ДействующееЛицоСсылка, Приглашение.РабочееПространство, "invitation.expire", Строка(Приглашение.Ссылка.УникальныйИдентификатор()));
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьУчастникаПриглашения(Приглашение, СсылкаУчетнойЗаписи, Действие)
    Если Приглашение.ПометкаУдаления Тогда
        ВызватьИсключение "кабинет_приглашение_не_найдено";
    КонецЕсли;
    Если Действие = "accept" Или Действие = "decline" Тогда
        Если Приглашение.УчетнаяЗаписьПолучателя <> СсылкаУчетнойЗаписи Тогда
            ВызватьИсключение "кабинет_приглашение_не_найдено";
        КонецЕсли;
    ИначеЕсли Действие = "revoke" Тогда
        Если Приглашение.УчетнаяЗаписьПригласившего <> СсылкаУчетнойЗаписи Тогда
            ВызватьИсключение "кабинет_приглашение_не_найдено";
        КонецЕсли;
    Иначе
        ВызватьИсключение "кабинет_некорректно_действие";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи)
    Текущий = ПолитикаДоступа.ПроверитьУчетнуюЗапись();
    Если ТипЗнч(СсылкаУчетнойЗаписи) <> Тип("СправочникСсылка.УчетныеЗаписи") Тогда
        ВызватьИсключение "кабинет_участник_несовпадение";
    КонецЕсли;
    Если Текущий.Ссылка <> СсылкаУчетнойЗаписи Тогда
        ВызватьИсключение "кабинет_участник_несовпадение";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьПолномочияВладельца(СсылкаУчетнойЗаписи, СсылкаРабочейОбласти, ТекущееВремя)
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 1 ЧленствоСтрокаВыборки.Ссылка КАК Ссылка
        |ИЗ Справочник.Участия КАК ЧленствоСтрокаВыборки
        |ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РабочиеПространства КАК РабочаяОбластьСтрокаВыборки ПО ЧленствоСтрокаВыборки.РабочееПространство = РабочаяОбластьСтрокаВыборки.Ссылка
        |ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.УчетныеЗаписи КАК УчетнаяЗаписьСтрокаВыборки ПО ЧленствоСтрокаВыборки.УчетнаяЗапись = УчетнаяЗаписьСтрокаВыборки.Ссылка
        |ГДЕ ЧленствоСтрокаВыборки.РабочееПространство = &РабочееПространство И ЧленствоСтрокаВыборки.УчетнаяЗапись = &УчетнаяЗапись
        |И РабочаяОбластьСтрокаВыборки.УчетнаяЗаписьВладельца = &УчетнаяЗапись И РабочаяОбластьСтрокаВыборки.Состояние = &Действующий
        |И НЕ РабочаяОбластьСтрокаВыборки.ПометкаУдаления И УчетнаяЗаписьСтрокаВыборки.Состояние = &Действующий
        |И НЕ УчетнаяЗаписьСтрокаВыборки.ПометкаУдаления И ЧленствоСтрокаВыборки.Роль = &ВладелецРоль
        |И ЧленствоСтрокаВыборки.Состояние = &Действующий И НЕ ЧленствоСтрокаВыборки.ПометкаУдаления
        |И ЧленствоСтрокаВыборки.ОхватОбластей = &ВсеКонтекстДоступа И ЧленствоСтрокаВыборки.Область = &ПустойОбласть
        |И (ЧленствоСтрокаВыборки.СрокИстечения = &НетИстечениеСрока ИЛИ ЧленствоСтрокаВыборки.СрокИстечения > &ТекущееВремя)");
    Запрос.УстановитьПараметр("РабочееПространство", СсылкаРабочейОбласти);
    Запрос.УстановитьПараметр("УчетнаяЗапись", СсылкаУчетнойЗаписи);
    Запрос.УстановитьПараметр("Действующий", "Active");
    Запрос.УстановитьПараметр("ВладелецРоль", "WorkspaceOwner");
    Запрос.УстановитьПараметр("ВсеКонтекстДоступа", "All");
    Запрос.УстановитьПараметр("ПустойОбласть", Справочники.Области.ПустаяСсылка());
    Запрос.УстановитьПараметр("НетИстечениеСрока", Дата(1, 1, 1));
    Запрос.УстановитьПараметр("ТекущееВремя", ТекущееВремя);
    Если Запрос.Выполнить().Пустой() Тогда
        ВызватьИсключение "кабинет_пространство_запрещено";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьАктивностьЦелевойУчетнойЗаписи(СсылкаУчетнойЗаписи)
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.УчетныеЗаписи ГДЕ Ссылка = &УчетнаяЗапись И Состояние = &Действующий И НЕ ПометкаУдаления");
    Запрос.УстановитьПараметр("УчетнаяЗапись", СсылкаУчетнойЗаписи);
    Запрос.УстановитьПараметр("Действующий", "Active");
    Если Запрос.Выполнить().Пустой() Тогда
        ВызватьИсключение "кабинет_цель_учетная_запись_не_найдено";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьКонтекстОбласти(СсылкаРабочейОбласти, ОхватОбластей, СсылкаОбласти)
    Если ОхватОбластей = "All" И Не ЗначениеЗаполнено(СсылкаОбласти) Тогда
        Возврат;
    КонецЕсли;
    Если ОхватОбластей <> "Area" Или Не ЗначениеЗаполнено(СсылкаОбласти) Тогда
        ВызватьИсключение "кабинет_некорректно_область_граница";
    КонецЕсли;
    ЗаблокироватьОбъектПоСсылке("Справочник.Области", СсылкаОбласти);
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Области
        |ГДЕ Ссылка = &Область И РабочееПространство = &РабочееПространство И Состояние = &Действующий И НЕ ПометкаУдаления");
    Запрос.УстановитьПараметр("Область", СсылкаОбласти);
    Запрос.УстановитьПараметр("РабочееПространство", СсылкаРабочейОбласти);
    Запрос.УстановитьПараметр("Действующий", "Active");
    Если Запрос.Выполнить().Пустой() Тогда
        ВызватьИсключение "кабинет_область_не_найдено";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьРоль(Роль)
    Если ТипЗнч(Роль) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_некорректно_роль";
    КонецЕсли;
    Роли = Новый Массив;
    Роли.Добавить("Dispatcher");
    Роли.Добавить("LabTechnician");
    Роли.Добавить("LabApprover");
    Роли.Добавить("WaterOperator");
    Роли.Добавить("Storekeeper");
    Роли.Добавить("BillingSpecialist");
    Роли.Добавить("ConnectionEngineer");
    Роли.Добавить("SupportOperator");
    Роли.Добавить("CrewLeader");
    Роли.Добавить("CrewMember");
    Роли.Добавить("Resident");
    Если Роли.Найти(Роль) = Неопределено Тогда
        ВызватьИсключение "кабинет_некорректно_роль";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьОбластьДействия(ОхватОбластей, ОбластьИдентификатор)
    Если ТипЗнч(ОхватОбластей) <> Тип("Строка") Или ТипЗнч(ОбластьИдентификатор) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_некорректно_область_граница";
    КонецЕсли;
    Если ОхватОбластей <> "All" И ОхватОбластей <> "Area" Тогда
        ВызватьИсключение "кабинет_некорректно_область_граница";
    КонецЕсли;
    Если ОхватОбластей = "All" И Не ПустаяСтрока(ОбластьИдентификатор) Тогда
        ВызватьИсключение "кабинет_некорректно_область_граница";
    КонецЕсли;
    Если ОхватОбластей = "Area" И ПустаяСтрока(ОбластьИдентификатор) Тогда
        ВызватьИсключение "кабинет_некорректно_область_граница";
    КонецЕсли;
КонецПроцедуры

Функция ОбластьДействияУчастия(ОхватОбластей, ОбластьИдентификатор)
    Если ОхватОбластей = "All" Тогда
        Возврат Справочники.Области.ПустаяСсылка();
    КонецЕсли;
    Возврат Справочники.Области.ПолучитьСсылку(РазобратьИдентификатор(ОбластьИдентификатор));
КонецФункции

Процедура ПроверитьСрокДействия(СрокДействияВСекундах)
    Если ТипЗнч(СрокДействияВСекундах) <> Тип("Число") Тогда
        ВызватьИсключение "кабинет_некорректно_приглашение_срок";
    КонецЕсли;
    Если СрокДействияВСекундах < 300 Или СрокДействияВСекундах > 604800 Или Окр(СрокДействияВСекундах, 0) <> СрокДействияВСекундах Тогда
        ВызватьИсключение "кабинет_некорректно_приглашение_срок";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьНомерРевизии(Ревизия)
    Если ТипЗнч(Ревизия) <> Тип("Число") Тогда
        ВызватьИсключение "кабинет_некорректно_редакция";
    КонецЕсли;
    Если Ревизия < 0 Или Ревизия >= 999999999999999 Или Окр(Ревизия, 0) <> Ревизия Тогда
        ВызватьИсключение "кабинет_некорректно_редакция";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьВозможностьУвеличения(Ревизия)
    Если Ревизия < 0 Или Ревизия >= 999999999999998 Или Окр(Ревизия, 0) <> Ревизия Тогда
        ВызватьИсключение "кабинет_редакция_конфликт";
    КонецЕсли;
КонецПроцедуры

Функция РазобратьИдентификатор(Идентификатор)
    Если ТипЗнч(Идентификатор) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецЕсли;
    Если СтрДлина(Идентификатор) <> 36 Тогда
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецЕсли;
    Попытка
        Разобранный = Новый УникальныйИдентификатор(Идентификатор);
    Исключение
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецПопытки;
    Если Строка(Разобранный) = "00000000-0000-0000-0000-000000000000" Тогда
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецЕсли;
    Возврат Разобранный;
КонецФункции

Процедура ПроверитьПривязанноеУчастие(Участие, СсылкаРабочейОбласти, СсылкаУчетнойЗаписи, Роль, СсылкаОбласти)
    Если Участие = Неопределено Тогда
        ВызватьИсключение "кабинет_участие_привязка_конфликт";
    КонецЕсли;
    Если Участие.ПометкаУдаления Или Участие.РабочееПространство <> СсылкаРабочейОбласти
        Или Участие.УчетнаяЗапись <> СсылкаУчетнойЗаписи Или Участие.Роль <> Роль Или Участие.Область <> СсылкаОбласти Тогда
        ВызватьИсключение "кабинет_участие_привязка_конфликт";
    КонецЕсли;
КонецПроцедуры

Функция ПрочитатьПривязкуУчастия(СсылкаРабочейОбласти, СсылкаУчетнойЗаписи, Роль, СсылкаОбласти)
    Привязка = РегистрыСведений.ПривязкиУчастий.СоздатьМенеджерЗаписи();
    Привязка.РабочееПространство = СсылкаРабочейОбласти;
    Привязка.УчетнаяЗапись = СсылкаУчетнойЗаписи;
    Привязка.Роль = Роль;
    Привязка.Область = СсылкаОбласти;
    Привязка.Прочитать();
    Возврат Привязка;
КонецФункции

