Процедура ЗаблокироватьУчетныеЗаписи(СсылкаУчетнойЗаписи, ДругойУчетнаяЗапись)
    Если ТипЗнч(СсылкаУчетнойЗаписи) <> Тип("СправочникСсылка.УчетныеЗаписи")
        Или ТипЗнч(ДругойУчетнаяЗапись) <> Тип("СправочникСсылка.УчетныеЗаписи") Тогда
        ВызватьИсключение "кабинет_участник_несовпадение";
    КонецЕсли;
    Первый = СсылкаУчетнойЗаписи;
    Второй = ДругойУчетнаяЗапись;
    Если Строка(ДругойУчетнаяЗапись.УникальныйИдентификатор()) < Строка(СсылкаУчетнойЗаписи.УникальныйИдентификатор()) Тогда
        Первый = ДругойУчетнаяЗапись;
        Второй = СсылкаУчетнойЗаписи;
    КонецЕсли;
    Блокировка = Новый БлокировкаДанных;
    Запись = Блокировка.Добавить("Справочник.УчетныеЗаписи");
    Запись.УстановитьЗначение("Ссылка", Первый);
    Запись.Режим = РежимБлокировкиДанных.Исключительный;
    Если Первый <> Второй Тогда
        Запись = Блокировка.Добавить("Справочник.УчетныеЗаписи");
        Запись.УстановитьЗначение("Ссылка", Второй);
        Запись.Режим = РежимБлокировкиДанных.Исключительный;
    КонецЕсли;
    Блокировка.Заблокировать();
КонецПроцедуры

Функция ДанныеПриглашения(Приглашение, ТекущееВремя)
    Результат = Новый Структура;
    Результат.Вставить("id", Строка(Приглашение.Ссылка.УникальныйИдентификатор()));
    Результат.Вставить("workspaceId", Строка(Приглашение.РабочееПространство.УникальныйИдентификатор()));
    Результат.Вставить("inviterAccountId", Строка(Приглашение.УчетнаяЗаписьПригласившего.УникальныйИдентификатор()));
    Результат.Вставить("recipientAccountId", Строка(Приглашение.УчетнаяЗаписьПолучателя.УникальныйИдентификатор()));
    Результат.Вставить("role", Приглашение.Роль);
    Результат.Вставить("areaScope", Приглашение.ОхватОбластей);
    Результат.Вставить("areaId", НеобязательныйИдентификатор(Приглашение.Область));
    Состояние = Приглашение.Состояние;
    Если Состояние = "Pending" И Приглашение.СрокИстечения <= ТекущееВремя Тогда
        Состояние = "Expired";
    КонецЕсли;
    Результат.Вставить("state", Состояние);
    Результат.Вставить("revision", Приглашение.Ревизия);
    Результат.Вставить("createdAt", XMLСтрока(Приглашение.ДатаСоздания) + "Z");
    Результат.Вставить("expiresAt", XMLСтрока(Приглашение.СрокИстечения) + "Z");
    Результат.Вставить("decidedAt", XMLСтрока(Приглашение.ДатаРешения) + "Z");
    Результат.Вставить("membershipId", НеобязательныйИдентификатор(Приглашение.Участие));
    Результат.Вставить("acceptedRevision", Приглашение.ПринятаяРевизия);
    Возврат Результат;
КонецФункции

Функция ДанныеУчастия(Участие)
    Результат = Новый Структура;
    Результат.Вставить("id", Строка(Участие.Ссылка.УникальныйИдентификатор()));
    Результат.Вставить("workspaceId", Строка(Участие.РабочееПространство.УникальныйИдентификатор()));
    Результат.Вставить("accountId", Строка(Участие.УчетнаяЗапись.УникальныйИдентификатор()));
    Результат.Вставить("role", Участие.Роль);
    Результат.Вставить("areaScope", Участие.ОхватОбластей);
    Результат.Вставить("areaId", НеобязательныйИдентификатор(Участие.Область));
    Результат.Вставить("state", Участие.Состояние);
    Результат.Вставить("expiresAt", XMLСтрока(Участие.СрокИстечения) + "Z");
    Результат.Вставить("revision", Участие.Ревизия);
    Возврат Результат;
КонецФункции

Функция НеобязательныйИдентификатор(Ссылка)
    Если Не ЗначениеЗаполнено(Ссылка) Тогда
        Возврат "";
    КонецЕсли;
    Возврат Строка(Ссылка.УникальныйИдентификатор());
КонецФункции
