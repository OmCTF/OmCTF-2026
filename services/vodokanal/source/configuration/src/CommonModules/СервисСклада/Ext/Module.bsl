Функция ЗаявкиВКонтексте(Контекст, НарядСсылка, Параметры = Неопределено)
    П = ПараметрыСтраницы("requests", Параметры, Контекст, ИДс(НарядСсылка));
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ " + Формат(П.limit + 1, "ЧГ=0") + " Ссылка ИЗ Справочник.ЗаявкиМатериалов ГДЕ РабочееПространство = &РабочееПространство И Область = &Область И НЕ ПометкаУдаления И (&Все ИЛИ Наряд = &Наряд) И Ссылка > &После УПОРЯДОЧИТЬ ПО Ссылка");
    Запрос.УстановитьПараметр("После", П.after);
    ПараметрыОбласти(Запрос, Контекст); Запрос.УстановитьПараметр("Все", Не ЗначениеЗаполнено(НарядСсылка)); Запрос.УстановитьПараметр("Наряд", НарядСсылка);
    Выборка = Запрос.Выполнить().Выбрать(); Данные = Новый Массив; Еще = Ложь;
    Пока Выборка.Следующий() Цикл
        Если Данные.Количество() = П.limit Тогда Еще = Истина; Прервать; КонецЕсли;
        Объект = ОбъектЗаявки(Выборка.Ссылка, Контекст);
        Материал = ПроверитьМатериал(Объект.Материал, Контекст, Объект.Запрошено); ПроверитьЯчейку(Объект.Склад, Объект.Ячейка, Контекст);
        Данные.Добавить(ДанныеЗаявки(Объект));
