
Функция СоздатьДвижениеМатериалов(УчетнаяЗапись, ТелоЗапроса, Ключ) Экспорт
    Возврат СоздатьДвижениеВРежиме(УчетнаяЗапись, ТелоЗапроса, Ключ, "Inventory");
КонецФункции

Функция СписатьМатериалыНаряда(УчетнаяЗапись, Тело, Ключ) Экспорт
    ПроверитьПоля(Тело, "workspaceId,areaId,materialRequestId,expectedRevision,quantity,basis,occurredAt", "reason");
    Намерение = Новый Структура;
    Для Каждого Поле Из Тело Цикл Намерение.Вставить(Поле.Ключ, Поле.Значение); КонецЦикла;
    Намерение.Вставить("operation", "Consume");
    Возврат СоздатьДвижениеВРежиме(УчетнаяЗапись, Намерение, Ключ, "Work");
КонецФункции

Функция ИсправитьСписаниеНаряда(УчетнаяЗапись, Тело, Ключ) Экспорт
    ПроверитьПоля(Тело, "workspaceId,areaId,originalMovementId,expectedRevision,basis,reason,occurredAt");
    Намерение = Новый Структура;
    Для Каждого Поле Из Тело Цикл Намерение.Вставить(Поле.Ключ, Поле.Значение); КонецЦикла;
    Намерение.Вставить("operation", "Reversal");
    Возврат СоздатьДвижениеВРежиме(УчетнаяЗапись, Намерение, Ключ, "Work");
КонецФункции

Функция СоздатьДвижениеВРежиме(УчетнаяЗапись, ТелоЗапроса, Ключ, Режим)
    Тело = НормализоватьДвижение(ТелоЗапроса, Режим = "Work");
    Цель = "";
    Если Тело.Свойство("materialRequestId") Тогда Цель = Тело.materialRequestId; КонецЕсли;
    Если Тело.Свойство("originalMovementId") Тогда Цель = Тело.originalMovementId; КонецЕсли;
    Контекст = НачатьКоманду(УчетнаяЗапись, Тело, Ключ, "movement." + Тело.operation, Цель, Режим);
    Попытка
        Если Контекст.Команда.Выбран() Тогда
            Результат = Повтор(Контекст.Команда);
        Иначе
            Документ = Документы.ДвижениеМатериалов.СоздатьДокумент();
            Документ.SetNewObjectRef(Документы.ДвижениеМатериалов.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
            Документ.РабочееПространство = Контекст.РабочееПространство; Документ.Область = Контекст.Область;
            Документ.Операция = Тело.operation; Документ.Основание = Тело.basis; Документ.Причина = Тело.reason;
            Документ.ФактическаяДата = ДатаПоля(Тело, "occurredAt"); Документ.ИдентификаторЗапроса = ИД(Ключ);
            Если Тело.operation = "Receipt" Или Тело.operation = "Transfer" Тогда
                Документ.Материал = СсылкаКаталога("Материалы", Тело.materialId);
                Документ.Склад = СсылкаКаталога("СкладыМатериалов", Тело.warehouseId);
                Документ.Ячейка = СсылкаКаталога("ЯчейкиМатериалов", Тело.cellId);
                Документ.Количество = Тело.quantity;
                Если Тело.operation = "Transfer" Тогда
                    Документ.СкладПолучатель = СсылкаКаталога("СкладыМатериалов", Тело.targetWarehouseId);
                    Документ.ЯчейкаПолучатель = СсылкаКаталога("ЯчейкиМатериалов", Тело.targetCellId);
                КонецЕсли;
            ИначеЕсли Тело.operation = "Reversal" Тогда
                Документ.ИсходноеДвижение = СсылкаДвижения(Тело.originalMovementId);
                Исходный = ОбъектДвижения(Документ.ИсходноеДвижение, Контекст);
                Если Исходный.Операция = "Reversal" Тогда ВызватьИсключение "кабинет_склад_сторно_конфликт"; КонецЕсли;
                Документ.Материал = Исходный.Материал; Документ.Склад = Исходный.Склад; Документ.Ячейка = Исходный.Ячейка;
                Документ.СкладПолучатель = Исходный.СкладПолучатель; Документ.ЯчейкаПолучатель = Исходный.ЯчейкаПолучатель;
                Документ.Заявка = Исходный.Заявка; Документ.Наряд = Исходный.Наряд; Документ.Количество = Исходный.Количество;
                Если ЗначениеЗаполнено(Документ.Заявка) Тогда
                    Документ.ОжидаемаяРевизия = ЦелоеПоля(Тело, "expectedRevision", 1, 999999999999998);
                ИначеЕсли Тело.Свойство("expectedRevision") Тогда
                    ВызватьИсключение "кабинет_склад_некорректно_поле";
                КонецЕсли;
            Иначе
                Документ.Заявка = СсылкаКаталога("ЗаявкиМатериалов", Тело.materialRequestId);
                Заявка = ОбъектЗаявки(Документ.Заявка, Контекст);
                Документ.Наряд = Заявка.Наряд; Документ.Материал = Заявка.Материал; Документ.Склад = Заявка.Склад; Документ.Ячейка = Заявка.Ячейка;
                Документ.ОжидаемаяРевизия = Тело.expectedRevision;
                Если Тело.operation = "Reserve" Тогда Документ.Количество = Заявка.Запрошено; Иначе Документ.Количество = Тело.quantity; КонецЕсли;
            КонецЕсли;
            Материал = ПроверитьМатериал(Документ.Материал, Контекст, Документ.Количество);
            Документ.Единица = Материал.Единица;
            Документ.Записать(РежимЗаписиДокумента.Проведение);
            Команда = ОткрытьКоманду(УчетнаяЗапись, ИД(Ключ), "movement." + Тело.operation, Цель, СериализоватьДанные(Канонический(Тело), 16000), Контекст);
            Если Не Команда.Выбран() Или Команда.ИдентификаторСущности <> ИДс(Документ.Ссылка) Тогда ВызватьИсключение "кабинет_склад_привязка_конфликт"; КонецЕсли;
            Результат = Повтор(Команда);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        Откат(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция НормализоватьДвижение(Тело, РазрешеноСписание = Ложь)
    Если ТипЗнч(Тело) <> Тип("Структура") Или Не Тело.Свойство("operation") Тогда ВызватьИсключение "кабинет_склад_некорректно_поле"; КонецЕсли;
    Операция = ТекстПоля(Тело, "operation", 20);
    Операции = "Receipt,Transfer,Reserve,Issue,Return,Release,Reversal";
    Если РазрешеноСписание Тогда Операции = Операции + ",Consume"; КонецЕсли;
    Если СтрРазделить(Операции, ",").Найти(Операция) = Неопределено Тогда ВызватьИсключение "кабинет_склад_некорректно_операция"; КонецЕсли;
    Поля = "workspaceId,areaId,operation,basis,occurredAt"; Необязательные = "reason";
    Если Операция = "Receipt" Или Операция = "Transfer" Тогда
        Поля = Поля + ",materialId,warehouseId,cellId,quantity";
        Если Операция = "Transfer" Тогда Поля = Поля + ",targetWarehouseId,targetCellId"; КонецЕсли;
    ИначеЕсли Операция = "Reversal" Тогда
        Поля = Поля + ",originalMovementId,reason"; Необязательные = "expectedRevision";
    Иначе
        Поля = Поля + ",materialRequestId,expectedRevision";
        Если Операция <> "Reserve" Тогда Поля = Поля + ",quantity"; КонецЕсли;
    КонецЕсли;
    ПроверитьПоля(Тело, Поля, Необязательные);
    ДатаОперации = ДатаПоля(Тело, "occurredAt");
    Причина = НеобязательныйТекст(Тело, "reason", 500);
    Если Операция = "Reversal" И Причина = "" Тогда ВызватьИсключение "кабинет_склад_некорректно_поле"; КонецЕсли;
    Результат = Новый Структура("workspaceId,areaId,operation,basis,reason,occurredAt", ИД(Тело.workspaceId), ИД(Тело.areaId), Операция,
        ТекстПоля(Тело, "basis", 2000, Истина), Причина, XMLСтрока(ДатаОперации) + "Z");
    Для Каждого Имя Из СтрРазделить("materialId,warehouseId,cellId,targetWarehouseId,targetCellId,materialRequestId,originalMovementId", ",") Цикл
        Значение = Неопределено;
        Если Тело.Свойство(Имя, Значение) Тогда Результат.Вставить(Имя, ИД(Значение)); КонецЕсли;
    КонецЦикла;
    Если Тело.Свойство("quantity") Тогда Результат.Вставить("quantity", КоличествоПоля(Тело, "quantity")); КонецЕсли;
    Если Тело.Свойство("expectedRevision") Тогда Результат.Вставить("expectedRevision", ЦелоеПоля(Тело, "expectedRevision", 1, 999999999999998)); КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ОпределитьПредыдущееДвижение(Документ) Экспорт
    Если Не ТранзакцияАктивна() Или ТипЗнч(Документ) <> Тип("ДокументОбъект.ДвижениеМатериалов") Тогда ВызватьИсключение "кабинет_склад_проведение_контекст_требуется"; КонецЕсли;
    ПроверитьАктера(Документ.КемСоздано);
    Контекст = Новый Структура("УчетнаяЗапись,РабочееПространство,Область", Документ.КемСоздано, Документ.РабочееПространство, Документ.Область);
    АвторизоватьПроведение(Документ, Контекст);
    Если ЗначениеЗаполнено(Документ.Заявка) Тогда
        Заявка = ОбъектЗаявки(Документ.Заявка, Контекст);
        Если Документ.Наряд <> Заявка.Наряд Или Документ.Материал <> Заявка.Материал
            Или Документ.Склад <> Заявка.Склад Или Документ.Ячейка <> Заявка.Ячейка Тогда ВызватьИсключение "кабинет_склад_привязка_конфликт"; КонецЕсли;
        Если Документ.ОжидаемаяРевизия <> Заявка.Ревизия Тогда ВызватьИсключение "кабинет_склад_редакция_конфликт"; КонецЕсли;
        Если Документ.Операция = "Reversal" Тогда
            Исходный = ОбъектДвижения(Документ.ИсходноеДвижение, Контекст);
            Если Исходный.Операция = "Reversal" Или Исходный.Заявка <> Заявка.Ссылка
                Или Заявка.ПоследнееДвижение <> Исходный.Ссылка Тогда ВызватьИсключение "кабинет_склад_сторно_конфликт"; КонецЕсли;
            Возврат Исходный.ПредыдущееДвижение;
        КонецЕсли;
        Если СтрРазделить("Reserve,Issue,Return,Release,Consume", ",").Найти(Документ.Операция) = Неопределено Тогда ВызватьИсключение "кабинет_склад_некорректно_движение"; КонецЕсли;
        Возврат Заявка.ПоследнееДвижение;
    КонецЕсли;
    Если ЗначениеЗаполнено(Документ.Наряд) Или Документ.ОжидаемаяРевизия <> 0
        Или СтрРазделить("Receipt,Transfer,Reversal", ",").Найти(Документ.Операция) = Неопределено Тогда ВызватьИсключение "кабинет_склад_некорректно_движение"; КонецЕсли;
    Возврат Документы.ДвижениеМатериалов.ПустаяСсылка();
КонецФункции

Процедура ПровестиДвижениеМатериалов(Документ) Экспорт
    Если Не ТранзакцияАктивна() Или ТипЗнч(Документ) <> Тип("ДокументОбъект.ДвижениеМатериалов") Тогда ВызватьИсключение "кабинет_склад_проведение_контекст_требуется"; КонецЕсли;
    Если Не Документ.СкладскоеПроведениеАктивно() Тогда ВызватьИсключение "кабинет_склад_проведение_контекст_требуется"; КонецЕсли;
    ПроверитьАктера(Документ.КемСоздано);
    Контекст = Новый Структура("УчетнаяЗапись,РабочееПространство,Область", Документ.КемСоздано, Документ.РабочееПространство, Документ.Область);
    АвторизоватьПроведение(Документ, Контекст);
    Если Документ.Ревизия <> 1 Или Документ.Дата <> Документ.ДатаСоздания Или Документ.Дата <> Документ.ДатаОбновления
        Или Документ.Дата > ТекущаяУниверсальнаяДата() Или Документ.Дата = Дата(1, 1, 1)
        Или Не ЗначениеЗаполнено(Документ.Ссылка) Тогда
        ВызватьИсключение "кабинет_склад_некорректно_движение";
    КонецЕсли;
    Тело = ТелоИзДокумента(Документ);
    Если ЗначениеЗаполнено(Документ.Наряд) Тогда НарядДляБлокировки = ОбъектНаряда(Документ.Наряд, Контекст); КонецЕсли;
    Цель = ""; Если Тело.Свойство("materialRequestId") Тогда Цель = Тело.materialRequestId; КонецЕсли;
    Если Тело.Свойство("originalMovementId") Тогда Цель = Тело.originalMovementId; КонецЕсли;
    Команда = ОткрытьКоманду(Контекст.УчетнаяЗапись, ИД(Документ.ИдентификаторЗапроса), "movement." + Документ.Операция, Цель, СериализоватьДанные(Канонический(Тело), 16000), Контекст);
    Если Команда.Выбран() Тогда ВызватьИсключение "кабинет_склад_запрос_конфликт"; КонецЕсли;
    ПроверитьКоличество(Документ.Количество); ПроверитьДату(Документ.ФактическаяДата);
    Исходный = Неопределено; ОбратнаяПривязка = Неопределено; Знак = 1; Операция = Документ.Операция;
    Если Операция = "Reversal" Тогда
        Исходный = ОбъектДвижения(Документ.ИсходноеДвижение, Контекст);
        Если Исходный.Операция = "Reversal" Тогда ВызватьИсключение "кабинет_склад_сторно_конфликт"; КонецЕсли;
        Если Документ.Материал <> Исходный.Материал Или Документ.Единица <> Исходный.Единица
            Или Документ.Склад <> Исходный.Склад Или Документ.Ячейка <> Исходный.Ячейка
            Или Документ.СкладПолучатель <> Исходный.СкладПолучатель Или Документ.ЯчейкаПолучатель <> Исходный.ЯчейкаПолучатель
            Или Документ.Количество <> Исходный.Количество Или Документ.Заявка <> Исходный.Заявка Или Документ.Наряд <> Исходный.Наряд Тогда
            ВызватьИсключение "кабинет_склад_привязка_конфликт";
        КонецЕсли;
        Операция = Исходный.Операция; Знак = -1;
    ИначеЕсли ЗначениеЗаполнено(Документ.ИсходноеДвижение) Тогда
        ВызватьИсключение "кабинет_склад_некорректно_движение";
    КонецЕсли;
    Заявка = Неопределено;
    Если СтрРазделить("Reserve,Issue,Return,Release,Consume", ",").Найти(Операция) <> Неопределено Тогда
        Если Не ЗначениеЗаполнено(Документ.Заявка) Тогда ВызватьИсключение "кабинет_склад_некорректно_движение"; КонецЕсли;
        Заявка = ОбъектЗаявки(Документ.Заявка, Контекст);
        Если Документ.Материал <> Заявка.Материал Или Документ.Наряд <> Заявка.Наряд Или Документ.Склад <> Заявка.Склад Или Документ.Ячейка <> Заявка.Ячейка Тогда ВызватьИсключение "кабинет_склад_привязка_конфликт"; КонецЕсли;
        Если Документ.ОжидаемаяРевизия <> Заявка.Ревизия Тогда ВызватьИсключение "кабинет_склад_редакция_конфликт"; КонецЕсли;
        Если Знак = 1 Тогда
            Наряд = ОбъектНаряда(Заявка.Наряд, Контекст); ПроверитьСостояниеНаряда(Наряд, Операция);
            Если Документ.ПредыдущееДвижение <> Заявка.ПоследнееДвижение Тогда ВызватьИсключение "кабинет_склад_привязка_конфликт"; КонецЕсли;
        Иначе
            Если Заявка.ПоследнееДвижение <> Исходный.Ссылка Тогда ВызватьИсключение "кабинет_склад_сторно_конфликт"; КонецЕсли;
            Если Документ.ПредыдущееДвижение <> Исходный.ПредыдущееДвижение Тогда ВызватьИсключение "кабинет_склад_привязка_конфликт"; КонецЕсли;
        КонецЕсли;
    ИначеЕсли ЗначениеЗаполнено(Документ.Заявка) Или ЗначениеЗаполнено(Документ.Наряд) Или Документ.ОжидаемаяРевизия <> 0 Тогда
        ВызватьИсключение "кабинет_склад_некорректно_движение";
    КонецЕсли;
    Если Заявка = Неопределено И ЗначениеЗаполнено(Документ.ПредыдущееДвижение) Тогда ВызватьИсключение "кабинет_склад_некорректно_движение"; КонецЕсли;
    Если Операция <> "Transfer" И (ЗначениеЗаполнено(Документ.СкладПолучатель) Или ЗначениеЗаполнено(Документ.ЯчейкаПолучатель)) Тогда ВызватьИсключение "кабинет_склад_некорректно_движение"; КонецЕсли;
    Материал = ПроверитьМатериал(Документ.Материал, Контекст, Документ.Количество);
    Если Документ.Единица <> Материал.Единица Тогда ВызватьИсключение "кабинет_склад_привязка_конфликт"; КонецЕсли;
    ПроверитьЯчейку(Документ.Склад, Документ.Ячейка, Контекст);
    Если Операция = "Transfer" Тогда
        ПроверитьЯчейку(Документ.СкладПолучатель, Документ.ЯчейкаПолучатель, Контекст);
        Если Документ.Ячейка = Документ.ЯчейкаПолучатель Тогда ВызватьИсключение "кабинет_склад_некорректно_движение"; КонецЕсли;
    КонецЕсли;
    ЗаблокироватьОстатки(Документ, Операция);
    Если Исходный <> Неопределено Тогда
        ОбратнаяПривязка = ОткрытьОбратнуюПривязку(Исходный.Ссылка);
        Если ОбратнаяПривязка.Выбран() Тогда ВызватьИсключение "кабинет_склад_сторно_конфликт"; КонецЕсли;
    КонецЕсли;
    Если Заявка <> Неопределено Тогда
        Если ОстатокРезерваЗаявки(Заявка, Контекст) <> Заявка.Зарезервировано - Заявка.Выдано - Заявка.Освобождено Тогда ВызватьИсключение "кабинет_склад_остаток_конфликт"; КонецЕсли;
        ПередЗаявкой = ДанныеЗаявки(Заявка);
        ИзменитьСчетчики(Заявка, Операция, Документ.Количество, Знак);
    КонецЕсли;
    Эффекты = ЭффектыОперации(Операция, Документ.Количество, Знак);
    До = ПрочитатьОстатки(Контекст, Документ.Склад, Документ.Ячейка, Документ.Материал);
    ПроверитьОстаток(До.onHand, До.reserved);
    ПроверитьОстаток(До.onHand + Эффекты.Остаток, До.reserved + Эффекты.Резерв, Истина);
    Если Операция = "Transfer" Тогда
        ДоПолучателя = ПрочитатьОстатки(Контекст, Документ.СкладПолучатель, Документ.ЯчейкаПолучатель, Документ.Материал);
        ПроверитьОстаток(ДоПолучателя.onHand, ДоПолучателя.reserved);
        ПроверитьОстаток(ДоПолучателя.onHand + Эффекты.Получатель, ДоПолучателя.reserved, Истина);
    КонецЕсли;
    РасходКвоты(Контекст, "Movement", 10000);
    ЗаписатьОстатки(Документ, Эффекты);
    После = ПрочитатьОстатки(Контекст, Документ.Склад, Документ.Ячейка, Документ.Материал);
    Если После.onHand <> До.onHand + Эффекты.Остаток Или После.reserved <> До.reserved + Эффекты.Резерв Тогда ВызватьИсключение "кабинет_склад_остаток_конфликт"; КонецЕсли;
    Если Операция = "Transfer" Тогда
        ПослеПолучателя = ПрочитатьОстатки(Контекст, Документ.СкладПолучатель, Документ.ЯчейкаПолучатель, Документ.Материал);
        Если ПослеПолучателя.onHand <> ДоПолучателя.onHand + Эффекты.Получатель Или ПослеПолучателя.reserved <> ДоПолучателя.reserved Тогда ВызватьИсключение "кабинет_склад_остаток_конфликт"; КонецЕсли;
    КонецЕсли;
    Если Заявка <> Неопределено Тогда
        Если ОстатокРезерваЗаявки(Заявка, Контекст) <> Заявка.Зарезервировано - Заявка.Выдано - Заявка.Освобождено Тогда ВызватьИсключение "кабинет_склад_остаток_конфликт"; КонецЕсли;
        Если Знак = 1 Тогда Заявка.ПоследнееДвижение = Документ.Ссылка; Иначе Заявка.ПоследнееДвижение = Исходный.ПредыдущееДвижение; КонецЕсли;
        Заявка.Ревизия = Заявка.Ревизия + 1; Заявка.ДатаОбновления = Документ.Дата; Заявка.Состояние = СостояниеЗаявки(Заявка); Заявка.Записать();
        СохранитьИсторию("Request", Заявка.Ссылка, Заявка.Ревизия, Команда, ПередЗаявкой, ДанныеЗаявки(Заявка), Документ.Причина, Контекст);
    КонецЕсли;
    Если ОбратнаяПривязка <> Неопределено Тогда
        ОбратнаяПривязка.ИсходноеДвижение = Исходный.Ссылка; ОбратнаяПривязка.ОбратноеДвижение = Документ.Ссылка; ОбратнаяПривязка.Записать();
    КонецЕсли;
    СохранитьРезультат(Команда, "Movement", Документ.Ссылка, 1, Новый Структура, ДанныеДвижения(Документ), Документ.Причина, Контекст);
КонецПроцедуры

Функция ТелоИзДокумента(Документ)
    Тело = Новый Структура("workspaceId,areaId,operation,basis,reason,occurredAt", ИДс(Документ.РабочееПространство), ИДс(Документ.Область),
        Документ.Операция, Документ.Основание, Документ.Причина, XMLСтрока(Документ.ФактическаяДата) + "Z");
    Если Документ.Операция = "Receipt" Или Документ.Операция = "Transfer" Тогда
        Тело.Вставить("materialId", ИДс(Документ.Материал)); Тело.Вставить("warehouseId", ИДс(Документ.Склад)); Тело.Вставить("cellId", ИДс(Документ.Ячейка)); Тело.Вставить("quantity", Документ.Количество);
        Если Документ.Операция = "Transfer" Тогда Тело.Вставить("targetWarehouseId", ИДс(Документ.СкладПолучатель)); Тело.Вставить("targetCellId", ИДс(Документ.ЯчейкаПолучатель)); КонецЕсли;
    ИначеЕсли Документ.Операция = "Reversal" Тогда
        Тело.Вставить("originalMovementId", ИДс(Документ.ИсходноеДвижение));
        Если ЗначениеЗаполнено(Документ.Заявка) Тогда Тело.Вставить("expectedRevision", Документ.ОжидаемаяРевизия); КонецЕсли;
    Иначе
        Тело.Вставить("materialRequestId", ИДс(Документ.Заявка)); Тело.Вставить("expectedRevision", Документ.ОжидаемаяРевизия);
        Если Документ.Операция <> "Reserve" Тогда Тело.Вставить("quantity", Документ.Количество); КонецЕсли;
    КонецЕсли;
    Результат = НормализоватьДвижение(Тело, Истина);
    Если Документ.Основание <> Результат.basis Или Документ.Причина <> Результат.reason Тогда ВызватьИсключение "кабинет_склад_некорректно_поле"; КонецЕсли;
    Возврат Результат;
КонецФункции

Процедура ИзменитьСчетчики(Заявка, Операция, Количество, Знак)
    Если Операция = "Reserve" Тогда
        Если Количество <> Заявка.Запрошено Или (Знак = 1 И Заявка.Зарезервировано <> 0) Тогда ВызватьИсключение "кабинет_склад_состояние_конфликт"; КонецЕсли;
        Заявка.Зарезервировано = Заявка.Зарезервировано + Знак * Количество;
    ИначеЕсли Операция = "Issue" Тогда
        Заявка.Выдано = Заявка.Выдано + Знак * Количество;
    ИначеЕсли Операция = "Return" Тогда
        Заявка.Возвращено = Заявка.Возвращено + Знак * Количество;
    ИначеЕсли Операция = "Release" Тогда
        Заявка.Освобождено = Заявка.Освобождено + Знак * Количество;
    ИначеЕсли Операция = "Consume" Тогда
        Заявка.Списано = Заявка.Списано + Знак * Количество;
    Иначе
        ВызватьИсключение "кабинет_склад_некорректно_операция";
    КонецЕсли;
    ПроверитьСчетчики(Заявка, Истина);
КонецПроцедуры

Функция ЭффектыОперации(Операция, Количество, Знак)
    Эффект = Новый Структура("Остаток,Резерв,Получатель", 0, 0, 0);
    Если Операция = "Receipt" Или Операция = "Return" Тогда Эффект.Остаток = Количество;
    ИначеЕсли Операция = "Transfer" Тогда Эффект.Остаток = -Количество; Эффект.Получатель = Количество;
    ИначеЕсли Операция = "Reserve" Тогда Эффект.Резерв = Количество;
    ИначеЕсли Операция = "Issue" Тогда Эффект.Остаток = -Количество; Эффект.Резерв = -Количество;
    ИначеЕсли Операция = "Release" Тогда Эффект.Резерв = -Количество;
    ИначеЕсли Операция = "Consume" Тогда Эффект.Остаток = 0;
    Иначе ВызватьИсключение "кабинет_склад_некорректно_операция";
    КонецЕсли;
    Эффект.Остаток = Эффект.Остаток * Знак; Эффект.Резерв = Эффект.Резерв * Знак; Эффект.Получатель = Эффект.Получатель * Знак;
    Возврат Эффект;
КонецФункции

Функция ОбъектДвижения(Ссылка, Контекст)
    Предварительный = Ссылка.ПолучитьОбъект(); ПроверитьОбластьОбъекта(Предварительный, Контекст);
    Если ЗначениеЗаполнено(Предварительный.Наряд) Тогда Наряд = ОбъектНаряда(Предварительный.Наряд, Контекст); КонецЕсли;
    БлокироватьСсылку("Документ.ДвижениеМатериалов", Ссылка);
    Объект = Ссылка.ПолучитьОбъект(); ПроверитьОбластьОбъекта(Объект, Контекст);
    Если Не Объект.Проведен Или Объект.Ревизия <> 1 Или Объект.Наряд <> Предварительный.Наряд
        Или СтрРазделить("Receipt,Transfer,Reserve,Issue,Return,Release,Consume,Reversal", ",").Найти(Объект.Операция) = Неопределено Тогда
        ВызватьИсключение "кабинет_склад_привязка_конфликт";
    КонецЕсли;
    ПроверитьКоличество(Объект.Количество);
    Материал = ПроверитьМатериал(Объект.Материал, Контекст, Объект.Количество);
    Если Материал.Единица <> Объект.Единица Тогда ВызватьИсключение "кабинет_склад_привязка_конфликт"; КонецЕсли;
    ПроверитьЯчейку(Объект.Склад, Объект.Ячейка, Контекст);
    Если ЗначениеЗаполнено(Объект.СкладПолучатель) Или ЗначениеЗаполнено(Объект.ЯчейкаПолучатель) Тогда
        ПроверитьЯчейку(Объект.СкладПолучатель, Объект.ЯчейкаПолучатель, Контекст);
        Если Объект.Ячейка = Объект.ЯчейкаПолучатель Тогда ВызватьИсключение "кабинет_склад_привязка_конфликт"; КонецЕсли;
    КонецЕсли;
    Если ЗначениеЗаполнено(Объект.Заявка) Тогда
        Заявка = Объект.Заявка.ПолучитьОбъект(); ПроверитьОбластьОбъекта(Заявка, Контекст);
        Если Заявка.Наряд <> Объект.Наряд Или Заявка.Материал <> Объект.Материал Или Заявка.Склад <> Объект.Склад Или Заявка.Ячейка <> Объект.Ячейка Тогда
            ВызватьИсключение "кабинет_склад_привязка_конфликт";
        КонецЕсли;
    ИначеЕсли ЗначениеЗаполнено(Объект.Наряд) Тогда
        ВызватьИсключение "кабинет_склад_привязка_конфликт";
    КонецЕсли;
    Возврат Объект;
КонецФункции

Функция ДанныеДвижения(Объект, ТекущееОбратное = Ложь)
    Данные = Новый Структура("id,number,state,revision,workspaceId,areaId,operation", ИДс(Объект.Ссылка), Объект.Номер,
        "Posted", Объект.Ревизия, ИДс(Объект.РабочееПространство), ИДс(Объект.Область), Объект.Операция);
    Данные.Вставить("materialId", ИДс(Объект.Материал)); Данные.Вставить("materialName", Объект.Материал.Наименование);
    Данные.Вставить("unitId", ИДс(Объект.Единица)); Данные.Вставить("unitName", Объект.Единица.Наименование);
    Данные.Вставить("warehouseId", ИДс(Объект.Склад)); Данные.Вставить("cellId", ИДс(Объект.Ячейка));
    Данные.Вставить("targetWarehouseId", ИДс(Объект.СкладПолучатель)); Данные.Вставить("targetCellId", ИДс(Объект.ЯчейкаПолучатель));
    Данные.Вставить("materialRequestId", ИДс(Объект.Заявка)); Данные.Вставить("workOrderId", ИДс(Объект.Наряд));
    Данные.Вставить("quantity", Объект.Количество); Данные.Вставить("basis", Объект.Основание); Данные.Вставить("reason", Объект.Причина);
    Данные.Вставить("occurredAt", XMLСтрока(Объект.ФактическаяДата) + "Z"); Данные.Вставить("postedAt", XMLСтрока(Объект.Дата) + "Z");
    Данные.Вставить("authorAccountId", ИДс(Объект.КемСоздано)); Данные.Вставить("originalMovementId", ИДс(Объект.ИсходноеДвижение));
    Данные.Вставить("previousMovementId", ИДс(Объект.ПредыдущееДвижение));
    Если ТекущееОбратное Тогда
        Привязка = ОткрытьОбратнуюПривязку(Объект.Ссылка); ОбратныйИД = "";
        Если Привязка.Выбран() Тогда
            Обратный = Привязка.ОбратноеДвижение.ПолучитьОбъект();
            Если Обратный = Неопределено Тогда ВызватьИсключение "кабинет_склад_привязка_конфликт"; КонецЕсли;
            Если Обратный.ПометкаУдаления Или Не Обратный.Проведен Или Обратный.Операция <> "Reversal"
                Или Обратный.ИсходноеДвижение <> Объект.Ссылка Или Обратный.РабочееПространство <> Объект.РабочееПространство
                Или Обратный.Область <> Объект.Область Тогда ВызватьИсключение "кабинет_склад_привязка_конфликт"; КонецЕсли;
            ОбратныйИД = ИДс(Обратный.Ссылка);
        КонецЕсли;
        Данные.Вставить("reversalMovementId", ОбратныйИД);
    КонецЕсли;
    Возврат Данные;
КонецФункции

Функция ОткрытьОбратнуюПривязку(Ссылка)
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("РегистрСведений.ОбратныеДвиженияМатериалов");
    Элемент.УстановитьЗначение("ИсходноеДвижение", Ссылка); Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
    Запись = РегистрыСведений.ОбратныеДвиженияМатериалов.СоздатьМенеджерЗаписи();
    Запись.ИсходноеДвижение = Ссылка; Запись.Прочитать();
    Возврат Запись;
КонецФункции

Процедура ЗаблокироватьОстатки(Документ, Операция)
    Ячейки = Новый ТаблицаЗначений; Ячейки.Колонки.Добавить("Ключ"); Ячейки.Колонки.Добавить("Склад"); Ячейки.Колонки.Добавить("Ячейка");
    СтрокаЯчейки = Ячейки.Добавить(); СтрокаЯчейки.Ключ = ИДс(Документ.Склад) + ИДс(Документ.Ячейка);
    СтрокаЯчейки.Склад = Документ.Склад; СтрокаЯчейки.Ячейка = Документ.Ячейка;
    Если Операция = "Transfer" Тогда
        СтрокаЯчейки = Ячейки.Добавить(); СтрокаЯчейки.Ключ = ИДс(Документ.СкладПолучатель) + ИДс(Документ.ЯчейкаПолучатель);
        СтрокаЯчейки.Склад = Документ.СкладПолучатель; СтрокаЯчейки.Ячейка = Документ.ЯчейкаПолучатель;
    КонецЕсли;
    Ячейки.Сортировать("Ключ"); Блокировка = Новый БлокировкаДанных;
    Для Каждого СтрокаЯчейки Из Ячейки Цикл
        Для Каждого Имя Из СтрРазделить("ЗапасыМатериалов,РезервыМатериалов", ",") Цикл
            Элемент = Блокировка.Добавить("РегистрНакопления." + Имя);
            Элемент.УстановитьЗначение("РабочееПространство", Документ.РабочееПространство); Элемент.УстановитьЗначение("Область", Документ.Область);
            Элемент.УстановитьЗначение("Склад", СтрокаЯчейки.Склад); Элемент.УстановитьЗначение("Ячейка", СтрокаЯчейки.Ячейка);
            Элемент.УстановитьЗначение("Материал", Документ.Материал); Элемент.Режим = РежимБлокировкиДанных.Исключительный;
        КонецЦикла;
    КонецЦикла;
    Блокировка.Заблокировать();
КонецПроцедуры

Функция ПрочитатьОстатки(Контекст, Склад, Ячейка, Материал)
    Остаток = Новый Структура("onHand,reserved", 0, 0);
    Для Каждого Имя Из СтрРазделить("ЗапасыМатериалов,РезервыМатериалов", ",") Цикл
        Запрос = Новый Запрос("ВЫБРАТЬ ЕСТЬNULL(СУММА(КоличествоОстаток), 0) КАК Количество ИЗ РегистрНакопления." + Имя
            + ".Остатки(, РабочееПространство = &РабочееПространство И Область = &Область И Склад = &Склад И Ячейка = &Ячейка И Материал = &Материал)");
        ПараметрыОбласти(Запрос, Контекст); Запрос.УстановитьПараметр("Склад", Склад);
        Запрос.УстановитьПараметр("Ячейка", Ячейка); Запрос.УстановитьПараметр("Материал", Материал);
        Выборка = Запрос.Выполнить().Выбрать();
        Если Не Выборка.Следующий() Тогда ВызватьИсключение "кабинет_склад_остаток_конфликт"; КонецЕсли;
        Если Имя = "ЗапасыМатериалов" Тогда Остаток.onHand = Выборка.Количество; Иначе Остаток.reserved = Выборка.Количество; КонецЕсли;
    КонецЦикла;
    Возврат Остаток;
КонецФункции

Функция ОстатокРезерваЗаявки(Заявка, Контекст)
    Запрос = Новый Запрос("ВЫБРАТЬ РабочееПространство, Область, Склад, Ячейка, Материал, Наряд, КоличествоОстаток КАК Количество
        |ИЗ РегистрНакопления.РезервыМатериалов.Остатки(, Заявка = &Заявка)");
    Запрос.УстановитьПараметр("Заявка", Заявка.Ссылка); Выборка = Запрос.Выполнить().Выбрать(); Сумма = 0;
    Пока Выборка.Следующий() Цикл
        Если Выборка.РабочееПространство <> Контекст.РабочееПространство Или Выборка.Область <> Контекст.Область
            Или Выборка.Склад <> Заявка.Склад Или Выборка.Ячейка <> Заявка.Ячейка Или Выборка.Материал <> Заявка.Материал
            Или Выборка.Наряд <> Заявка.Наряд Или Выборка.Количество < 0 Тогда ВызватьИсключение "кабинет_склад_остаток_конфликт"; КонецЕсли;
        Сумма = Сумма + Выборка.Количество;
    КонецЦикла;
    Если Сумма > Заявка.Запрошено Или Сумма <> Окр(Сумма, 3) Тогда ВызватьИсключение "кабинет_склад_остаток_конфликт"; КонецЕсли;
    Возврат Сумма;
КонецФункции

Процедура ПроверитьОстаток(Запас, Резерв, Планируемый = Ложь)
    Если Запас < 0 Или Резерв < 0 Или Резерв > Запас Или Запас > 999999999999.999 Или Резерв > 999999999999.999
        Или Запас <> Окр(Запас, 3) Или Резерв <> Окр(Резерв, 3) Тогда
        Если Планируемый Тогда ВызватьИсключение "кабинет_склад_остатки_конфликт"; КонецЕсли;
        ВызватьИсключение "кабинет_склад_остаток_конфликт";
    КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьОстатки(Документ, Эффекты)
    Если Не ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_склад_проведение_контекст_требуется"; КонецЕсли;
    Если Эффекты.Остаток <> 0 Или Эффекты.Получатель <> 0 Тогда
        Набор = РегистрыНакопления.ЗапасыМатериалов.СоздатьНаборЗаписей(); Набор.Отбор.Регистратор.Установить(Документ.Ссылка);
        Если Эффекты.Остаток <> 0 Тогда ДобавитьОстаток(Набор, Документ, Документ.Склад, Документ.Ячейка, Эффекты.Остаток, Ложь); КонецЕсли;
        Если Эффекты.Получатель <> 0 Тогда ДобавитьОстаток(Набор, Документ, Документ.СкладПолучатель, Документ.ЯчейкаПолучатель, Эффекты.Получатель, Ложь); КонецЕсли;
        Набор.Записать(Истина);
    КонецЕсли;
    Если Эффекты.Резерв <> 0 Тогда
        Набор = РегистрыНакопления.РезервыМатериалов.СоздатьНаборЗаписей(); Набор.Отбор.Регистратор.Установить(Документ.Ссылка);
        ДобавитьОстаток(Набор, Документ, Документ.Склад, Документ.Ячейка, Эффекты.Резерв, Истина); Набор.Записать(Истина);
    КонецЕсли;
КонецПроцедуры

Процедура ДобавитьОстаток(Набор, Документ, Склад, Ячейка, Эффект, Резерв)
    Запись = Набор.Добавить(); Запись.Регистратор = Документ.Ссылка; Запись.Период = Документ.Дата;
    Запись.ВидДвижения = ВидДвиженияНакопления.Приход; Запись.Количество = Эффект;
    Если Эффект < 0 Тогда Запись.ВидДвижения = ВидДвиженияНакопления.Расход; Запись.Количество = -Эффект; КонецЕсли;
    Запись.РабочееПространство = Документ.РабочееПространство; Запись.Область = Документ.Область;
    Запись.Склад = Склад; Запись.Ячейка = Ячейка; Запись.Материал = Документ.Материал;
    Если Резерв Тогда Запись.Заявка = Документ.Заявка; Запись.Наряд = Документ.Наряд; КонецЕсли;
КонецПроцедуры

