Функция МатериальныеНаряды(УчетнаяЗапись, ПространствоИД, ОбластьИД, Параметры = Неопределено) Экспорт
    Контекст = НачатьОбласть(УчетнаяЗапись, ПространствоИД, ОбластьИД, Истина);
    Попытка
        Права = СервисНарядов.ПроверитьПолномочияМатериалов(УчетнаяЗапись, Контекст.РабочееПространство, Контекст.Область);
        П = ПараметрыСтраницы("workOrders", Параметры, Контекст);
        Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ " + Формат(П.limit + 1, "ЧГ=0") + " Н.Ссылка КАК Ссылка
            |ИЗ Справочник.Наряды КАК Н
            |ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РабочиеБригады КАК Б ПО Н.Бригада = Б.Ссылка
            |ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УчастникиРабочихБригад КАК У ПО У.Бригада = Б.Ссылка И У.УчетнаяЗапись = &УчетнаяЗапись
            |ГДЕ Н.РабочееПространство = &РабочееПространство И Н.Область = &Область И НЕ Н.ПометкаУдаления И Н.Ссылка > &После
            |И (&Диспетчер ИЛИ (Н.УчетнаяЗаписьРуководителя = &УчетнаяЗапись
            |И Б.УчетнаяЗаписьРуководителя = &УчетнаяЗапись И Б.Состояние = &Действующий И НЕ Б.ПометкаУдаления
            |И Б.РабочееПространство = &РабочееПространство И Б.Область = &Область
            |И У.Состояние = &Действующий И НЕ У.ПометкаУдаления
            |И У.РабочееПространство = &РабочееПространство И У.Область = &Область)) УПОРЯДОЧИТЬ ПО Н.Ссылка");
        ПараметрыОбласти(Запрос, Контекст); Запрос.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись); Запрос.УстановитьПараметр("После", П.after);
        Запрос.УстановитьПараметр("Диспетчер", Права.Диспетчер); Запрос.УстановитьПараметр("Действующий", "Active");
        Выборка = Запрос.Выполнить().Выбрать(); Данные = Новый Массив; Еще = Ложь;
        Пока Выборка.Следующий() Цикл
            Если Данные.Количество() = П.limit Тогда Еще = Истина; Прервать; КонецЕсли;
            Права = СервисНарядов.ПроверитьПолномочияМатериалов(УчетнаяЗапись, Контекст.РабочееПространство, Контекст.Область, Выборка.Ссылка);
            Данные.Добавить(МинимальныйНаряд(Права.Объект));
        КонецЦикла;
        Результат = Страница(Данные, Еще, П); ЗафиксироватьТранзакцию();
    Исключение
        Откат(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция МатериалыНаряда(УчетнаяЗапись, ПространствоИД, ОбластьИД, НарядИД) Экспорт
    Контекст = НачатьОбласть(УчетнаяЗапись, ПространствоИД, ОбластьИД, Истина);
    Попытка
        НарядСсылка = СсылкаКаталога("Наряды", НарядИД);
        Права = СервисНарядов.ПроверитьПолномочияМатериалов(УчетнаяЗапись, Контекст.РабочееПространство, Контекст.Область, НарядСсылка);
        Наряд = Права.Объект;
        Возможности = Новый Структура("canRequest,canConsume,canCorrectConsumption",
            СтрРазделить("Assigned,Accepted,InProgress,Paused,Rework", ",").Найти(Наряд.Состояние) <> Неопределено,
            Права.Руководитель И (Наряд.Состояние = "InProgress" Или Наряд.Состояние = "Rework"),
            Права.Диспетчер Или Права.Руководитель);
        Результат = Новый Структура("workOrder,setup,requests,documents,capabilities,snapshotAt", МинимальныйНаряд(Наряд),
            НастройкиВКонтексте(Контекст), ЗаявкиВКонтексте(Контекст, НарядСсылка), ДвиженияВКонтексте(Контекст, НарядСсылка),
            Возможности, XMLСтрока(ТекущаяУниверсальнаяДата()) + "Z");
        ЗафиксироватьТранзакцию();
    Исключение
        Откат(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция МинимальныйНаряд(Наряд)
    Возврат Новый Структура("id,name,state,workspaceId,areaId", ИДс(Наряд.Ссылка), Наряд.Наименование,
        Наряд.Состояние, ИДс(Наряд.РабочееПространство), ИДс(Наряд.Область));
КонецФункции

Функция СтраницаМатериаловНаряда(УчетнаяЗапись, ПространствоИД, ОбластьИД, НарядИД, Вид, Параметры = Неопределено) Экспорт
    Если Вид <> "requests" И Вид <> "documents" Тогда ВызватьИсключение "кабинет_склад_некорректно_поле"; КонецЕсли;
    Контекст = НачатьОбласть(УчетнаяЗапись, ПространствоИД, ОбластьИД, Истина);
    Попытка
        НарядСсылка = СсылкаКаталога("Наряды", НарядИД);
        СервисНарядов.ПроверитьПолномочияМатериалов(УчетнаяЗапись, Контекст.РабочееПространство, Контекст.Область, НарядСсылка);
        Если Вид = "requests" Тогда Результат = ЗаявкиВКонтексте(Контекст, НарядСсылка, Параметры);
        Иначе Результат = ДвиженияВКонтексте(Контекст, НарядСсылка, Параметры); КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение Откат(); ВызватьИсключение; КонецПопытки;
    Возврат Результат;
КонецФункции

Процедура ПроверитьЗавершениеМатериалов(УчетнаяЗапись, НарядСсылка, ТребоватьНулевойРасход = Ложь) Экспорт
    ПроверитьАктера(УчетнаяЗапись);
    Если Не ТранзакцияАктивна() Или ТипЗнч(НарядСсылка) <> Тип("СправочникСсылка.Наряды") Тогда
        ВызватьИсключение "кабинет_склад_проведение_контекст_требуется";
    КонецЕсли;
    Наряд = НарядСсылка.ПолучитьОбъект();
    Если Наряд = Неопределено Тогда ВызватьИсключение "кабинет_наряд_не_найдено"; КонецЕсли;
    Контекст = Новый Структура("УчетнаяЗапись,РабочееПространство,Область", УчетнаяЗапись, Наряд.РабочееПространство, Наряд.Область);
    Права = СервисНарядов.ПроверитьПолномочияМатериалов(УчетнаяЗапись, Контекст.РабочееПространство, Контекст.Область, НарядСсылка);
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1001 Ссылка ИЗ Справочник.ЗаявкиМатериалов ГДЕ Наряд = &Наряд УПОРЯДОЧИТЬ ПО Ссылка");
    Запрос.УстановитьПараметр("Наряд", НарядСсылка); Выборка = Запрос.Выполнить().Выбрать(); Количество = 0;
    Пока Выборка.Следующий() Цикл
        Количество = Количество + 1;
        Если Количество > 1000 Тогда ВызватьИсключение "кабинет_склад_привязка_конфликт"; КонецЕсли;
        Заявка = ОбъектЗаявки(Выборка.Ссылка, Контекст);
        ОстатокРезерва = Заявка.Зарезервировано - Заявка.Выдано - Заявка.Освобождено;
        Если ОстатокРезерваЗаявки(Заявка, Контекст) <> ОстатокРезерва Тогда ВызватьИсключение "кабинет_склад_остаток_конфликт"; КонецЕсли;
        Если ОстатокРезерва <> 0 Или Заявка.Выдано - Заявка.Возвращено - Заявка.Списано <> 0
            Или (ТребоватьНулевойРасход И Заявка.Списано <> 0) Тогда
            ВызватьИсключение "кабинет_наряд_материалы_незавершено";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ПолучитьДвижениеМатериалов(УчетнаяЗапись, ДвижениеИД) Экспорт
    ПроверитьАктера(УчетнаяЗапись);
    Ссылка = СсылкаДвижения(ДвижениеИД); Снимок = Ссылка.ПолучитьОбъект();
    Если Снимок = Неопределено Тогда ВызватьИсключение "кабинет_склад_не_найдено"; КонецЕсли;
    Контекст = НачатьОбласть(УчетнаяЗапись, ИДс(Снимок.РабочееПространство), ИДс(Снимок.Область));
    Попытка
        Объект = ОбъектДвижения(Ссылка, Контекст);
        Результат = ДанныеДвижения(Объект, Истина); ЗафиксироватьТранзакцию();
    Исключение
        Откат(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ОстаткиСклада(УчетнаяЗапись, ПространствоИД, ОбластьИД, СкладИД = "", Параметры = Неопределено) Экспорт
    Контекст = НачатьОбласть(УчетнаяЗапись, ПространствоИД, ОбластьИД);
    Попытка
        СкладСсылка = Справочники.СкладыМатериалов.ПустаяСсылка();
        Если СкладИД <> "" Тогда СкладСсылка = СсылкаКаталога("СкладыМатериалов", СкладИД); Склад = АктивныйОбъект(СкладСсылка, Контекст); КонецЕсли;
        П = ПараметрыСтраницы("stock", Параметры, Контекст, СкладИД);
        Запрос = Новый Запрос(
            "ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ " + Формат(П.limit + 1, "ЧГ=0") + " Данные.Склад, Данные.Ячейка, Данные.Материал
            |ИЗ (ВЫБРАТЬ Склад, Ячейка, Материал ИЗ РегистрНакопления.ЗапасыМатериалов.Остатки(,
            |РабочееПространство = &РабочееПространство И Область = &Область И (&Все ИЛИ Склад = &Склад))
            |ОБЪЕДИНИТЬ ВСЕ
            |ВЫБРАТЬ Склад, Ячейка, Материал ИЗ РегистрНакопления.РезервыМатериалов.Остатки(,
            |РабочееПространство = &РабочееПространство И Область = &Область И (&Все ИЛИ Склад = &Склад))) КАК Данные
            |ГДЕ Данные.Склад > &ПослеСклад ИЛИ (Данные.Склад = &ПослеСклад И Данные.Ячейка > &ПослеЯчейка)
            |ИЛИ (Данные.Склад = &ПослеСклад И Данные.Ячейка = &ПослеЯчейка И Данные.Материал > &ПослеМатериал)
            |УПОРЯДОЧИТЬ ПО Склад, Ячейка, Материал");
        Запрос.УстановитьПараметр("ПослеСклад", П.warehouse); Запрос.УстановитьПараметр("ПослеЯчейка", П.cell); Запрос.УстановитьПараметр("ПослеМатериал", П.material);
        ПараметрыОбласти(Запрос, Контекст); Запрос.УстановитьПараметр("Все", СкладИД = ""); Запрос.УстановитьПараметр("Склад", СкладСсылка);
        Выборка = Запрос.Выполнить().Выбрать(); Данные = Новый Массив; Еще = Ложь;
        Пока Выборка.Следующий() Цикл
            Если Данные.Количество() = П.limit Тогда Еще = Истина; Прервать; КонецЕсли;
            Материал = ПроверитьМатериал(Выборка.Материал, Контекст); ПроверитьЯчейку(Выборка.Склад, Выборка.Ячейка, Контекст);
            Остаток = ПрочитатьОстатки(Контекст, Выборка.Склад, Выборка.Ячейка, Выборка.Материал);
            ПроверитьОстаток(Остаток.onHand, Остаток.reserved);
            СтрокаДанных = Новый Структура("workspaceId,areaId,materialId,materialName,unitId,unitName,warehouseId,warehouseName,cellId,cellName,onHand,reserved,available",
                ИДс(Контекст.РабочееПространство), ИДс(Контекст.Область), ИДс(Материал.Ссылка), Материал.Наименование,
                ИДс(Материал.Единица), Материал.Единица.Наименование, ИДс(Выборка.Склад), Выборка.Склад.Наименование,
                ИДс(Выборка.Ячейка), Выборка.Ячейка.Наименование, Остаток.onHand, Остаток.reserved, Остаток.onHand - Остаток.reserved);
            Данные.Добавить(СтрокаДанных);
        КонецЦикла;
        Результат = Страница(Данные, Еще, П); ЗафиксироватьТранзакцию();
    Исключение
        Откат(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция Страница(Данные, Еще, П = Неопределено)
    Если П = Неопределено Тогда Возврат Новый Структура("items,limit,hasMore,snapshotAt", Данные, 100, Еще, XMLСтрока(ТекущаяУниверсальнаяДата()) + "Z"); КонецЕсли;
    Следующий = "";
    Если Еще И Данные.Количество() > 0 Тогда
        Последний = Данные[Данные.Количество() - 1];
        Если П.kind = "stock" Тогда Позиция = Последний.warehouseId + "|" + Последний.cellId + "|" + Последний.materialId;
        Иначе Позиция = Последний.id; КонецЕсли;
        Следующий = П.prefix + "|" + Позиция;
    КонецЕсли;
    Возврат Новый Структура("items,limit,hasMore,nextCursor,snapshotAt", Данные, П.limit, Еще, Следующий, XMLСтрока(ТекущаяУниверсальнаяДата()) + "Z");
КонецФункции

Функция ПараметрыСтраницы(Вид, Параметры, Контекст, Фильтр = "")
    Если Параметры = Неопределено Тогда Параметры = Новый Структура; КонецЕсли;
    ПроверитьПоля(Параметры, "", "limit,cursor"); Лимит = "25"; Курсор = "";
    Если Не Параметры.Свойство("limit", Лимит) Тогда Лимит = "25"; КонецЕсли;
    Если Не Параметры.Свойство("cursor", Курсор) Тогда Курсор = ""; КонецЕсли;
    Если Лимит = "" Тогда Лимит = "25"; КонецЕсли;
    Если ТипЗнч(Лимит) <> Тип("Строка") Или СтрДлина(Лимит) > 3 Или ТипЗнч(Курсор) <> Тип("Строка") Или СтрДлина(Курсор) > 400 Тогда ВызватьИсключение "кабинет_склад_некорректно_поле"; КонецЕсли;
    Для Н = 1 По СтрДлина(Лимит) Цикл Если СтрНайти("0123456789", Сред(Лимит, Н, 1)) = 0 Тогда ВызватьИсключение "кабинет_склад_некорректно_поле"; КонецЕсли; КонецЦикла;
    Размер = Число(Лимит); Если Размер < 1 Или Размер > 100 Тогда ВызватьИсключение "кабинет_склад_некорректно_поле"; КонецЕсли;
    Префикс = "i1|" + Вид + "|" + ИДс(Контекст.УчетнаяЗапись) + "|" + ИДс(Контекст.РабочееПространство) + "|" + ИДс(Контекст.Область) + "|" + Фильтр;
    Р = Новый Структура("limit,kind,prefix", Размер, Вид, Префикс);
    Если Вид = "stock" Тогда
        Р.Вставить("warehouse", Справочники.СкладыМатериалов.ПустаяСсылка()); Р.Вставить("cell", Справочники.ЯчейкиМатериалов.ПустаяСсылка()); Р.Вставить("material", Справочники.Материалы.ПустаяСсылка());
    Иначе
        Если Вид = "documents" Тогда Менеджер = Документы.ДвижениеМатериалов;
        ИначеЕсли Вид = "requests" Тогда Менеджер = Справочники.ЗаявкиМатериалов;
        ИначеЕсли Вид = "orders" Или Вид = "workOrders" Тогда Менеджер = Справочники.Наряды;
        Иначе ВызватьИсключение "кабинет_склад_некорректно_поле"; КонецЕсли;
        Р.Вставить("after", Менеджер.ПустаяСсылка());
    КонецЕсли;
    Если Курсор <> "" Тогда
        Части = СтрРазделить(Курсор, "|", Истина);
        Если Части.Количество() <> ?(Вид = "stock", 9, 7) Или Лев(Курсор, СтрДлина(Префикс) + 1) <> Префикс + "|" Тогда ВызватьИсключение "кабинет_склад_некорректно_поле"; КонецЕсли;
        Если Вид = "stock" Тогда
            Р.warehouse = СсылкаКаталога("СкладыМатериалов", Части[6]); Р.cell = СсылкаКаталога("ЯчейкиМатериалов", Части[7]); Р.material = СсылкаКаталога("Материалы", Части[8]);
        Иначе Р.after = Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(ИД(Части[6]))); КонецЕсли;
    КонецЕсли;
    Возврат Р;
КонецФункции

Функция ОбработатьСтраницуМатериаловHTTP(Действие, УчетнаяЗапись, Запрос, Корреляция) Экспорт
    Для Каждого Поле Из Запрос.ПараметрыЗапроса Цикл
        Если СтрРазделить("workspaceId,areaId,limit,cursor", ",").Найти(Поле.Ключ) = Неопределено Тогда ВызватьИсключение "кабинет_склад_некорректно_поле"; КонецЕсли;
    КонецЦикла;
    Пространство = APIКабинета.ТекстПараметраЗапроса(Запрос, "workspaceId", 36); Область = APIКабинета.ТекстПараметраЗапроса(Запрос, "areaId", 36);
    Параметры = Новый Структура("limit,cursor", APIКабинета.ТекстПараметраЗапроса(Запрос, "limit", 3), APIКабинета.ТекстПараметраЗапроса(Запрос, "cursor", 400));
    Если Действие = "workMaterialsRequestsPage" Тогда Вид = "requests";
    ИначеЕсли Действие = "workMaterialsDocumentsPage" Тогда Вид = "documents";
    Иначе ВызватьИсключение "кабинет_склад_некорректно_поле"; КонецЕсли;
    Результат = СтраницаМатериаловНаряда(УчетнаяЗапись, Пространство, Область, Запрос.ПараметрыURL.Получить("id"), Вид, Параметры);
    Возврат APIКабинета.СформироватьОтветHTTP(200, Результат, Корреляция);
КонецФункции

Процедура ПараметрыОбласти(Запрос, Контекст)
    Запрос.УстановитьПараметр("РабочееПространство", Контекст.РабочееПространство);
    Запрос.УстановитьПараметр("Область", Контекст.Область);
КонецПроцедуры

Функция СоздатьНастройкуСклада(УчетнаяЗапись, Тело, Ключ, Вид) Экспорт
    ИмяКаталога = КаталогНастройки(Вид);
    Поля = "workspaceId,areaId,name";
    Если Вид = "Unit" Тогда Поля = Поля + ",precision"; КонецЕсли;
    Если Вид = "Material" Тогда Поля = Поля + ",unitId"; КонецЕсли;
    Если Вид = "Cell" Тогда Поля = Поля + ",warehouseId"; КонецЕсли;
    ПроверитьПоля(Тело, Поля);
    Имя = ТекстПоля(Тело, "name", 150);
    Точность = 0; Родитель = Неопределено;
    Если Вид = "Unit" Тогда Точность = ЦелоеПоля(Тело, "precision", 0, 3); КонецЕсли;
    Если Вид = "Material" Тогда Родитель = СсылкаКаталога("ЕдиницыМатериалов", Тело.unitId); КонецЕсли;
    Если Вид = "Cell" Тогда Родитель = СсылкаКаталога("СкладыМатериалов", Тело.warehouseId); КонецЕсли;
    Контекст = НачатьКоманду(УчетнаяЗапись, Тело, Ключ, "setup." + Вид, "");
    Попытка
        Если Контекст.Команда.Выбран() Тогда
            Результат = Повтор(Контекст.Команда);
        Иначе
            Если Родитель <> Неопределено Тогда ОбъектРодителя = АктивныйОбъект(Родитель, Контекст); КонецЕсли;
            РасходКвоты(Контекст, "setup." + Вид, 100);
            Объект = Справочники[ИмяКаталога].СоздатьЭлемент();
            Объект.SetNewObjectRef(Справочники[ИмяКаталога].ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
            ЗаполнитьОбщее(Объект, УчетнаяЗапись, Контекст, "Active");
            Объект.Наименование = Имя;
            Если Вид = "Unit" Тогда Объект.Точность = Точность; КонецЕсли;
            Если Вид = "Material" Тогда Объект.Единица = Родитель; КонецЕсли;
            Если Вид = "Cell" Тогда Объект.Склад = Родитель; КонецЕсли;
            Объект.Записать();
            Результат = ДанныеНастройки(Объект, Вид);
            СохранитьРезультат(Контекст.Команда, Вид, Объект.Ссылка, 1, Новый Структура, Результат, "", Контекст);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        Откат(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СоздатьЗаявкуМатериалов(УчетнаяЗапись, Тело, Ключ) Экспорт
    Возврат СоздатьЗаявкуВРежиме(УчетнаяЗапись, Тело, Ключ, "Inventory");
КонецФункции

Функция СоздатьЗаявкуНаряда(УчетнаяЗапись, Тело, Ключ) Экспорт
    Возврат СоздатьЗаявкуВРежиме(УчетнаяЗапись, Тело, Ключ, "Work");
КонецФункции

Функция СоздатьЗаявкуВРежиме(УчетнаяЗапись, Тело, Ключ, Режим)
    ПроверитьПоля(Тело, "workspaceId,areaId,workOrderId,materialId,warehouseId,cellId,requestedQuantity,basis", "reason");
    Количество = КоличествоПоля(Тело, "requestedQuantity");
    Основание = ТекстПоля(Тело, "basis", 2000, Истина);
    Причина = НеобязательныйТекст(Тело, "reason", 500);
    НарядСсылка = СсылкаКаталога("Наряды", Тело.workOrderId);
    МатериалСсылка = СсылкаКаталога("Материалы", Тело.materialId);
    СкладСсылка = СсылкаКаталога("СкладыМатериалов", Тело.warehouseId);
    ЯчейкаСсылка = СсылкаКаталога("ЯчейкиМатериалов", Тело.cellId);
    Операция = "request.create";
    Если Режим = "Work" Тогда Операция = "work.request.create"; КонецЕсли;
    Контекст = НачатьКоманду(УчетнаяЗапись, Тело, Ключ, Операция, Тело.workOrderId, Режим);
    Попытка
        Если Контекст.Команда.Выбран() Тогда
            Результат = Повтор(Контекст.Команда);
        Иначе
            Наряд = ОбъектНаряда(НарядСсылка, Контекст);
            ПроверитьСостояниеНаряда(Наряд, "Request");
            Материал = ПроверитьМатериал(МатериалСсылка, Контекст, Количество);
            ПроверитьЯчейку(СкладСсылка, ЯчейкаСсылка, Контекст);
            РасходКвоты(Контекст, "Request", 1000);
            Объект = Справочники.ЗаявкиМатериалов.СоздатьЭлемент();
            Объект.SetNewObjectRef(Справочники.ЗаявкиМатериалов.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
            ЗаполнитьОбщее(Объект, УчетнаяЗапись, Контекст, "Requested");
            Объект.Наименование = "Заявка материала";
            Объект.Наряд = НарядСсылка; Объект.Материал = МатериалСсылка;
            Объект.Склад = СкладСсылка; Объект.Ячейка = ЯчейкаСсылка;
            Объект.Запрошено = Количество; Объект.Основание = Основание; Объект.Причина = Причина;
            Объект.Зарезервировано = 0; Объект.Выдано = 0; Объект.Возвращено = 0; Объект.Освобождено = 0;
            Объект.Списано = 0;
            Объект.ПоследнееДвижение = Документы.ДвижениеМатериалов.ПустаяСсылка();
            Объект.Записать();
            Результат = ДанныеЗаявки(Объект);
            СохранитьРезультат(Контекст.Команда, "Request", Объект.Ссылка, 1, Новый Структура, Результат, Причина, Контекст);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        Откат(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция НачатьКоманду(УчетнаяЗапись, Тело, Ключ, Операция, Цель, Режим = "Inventory")
    ПроверитьАктера(УчетнаяЗапись);
    Ключ = ИД(Ключ);
    РабочееПространство = ИД(Тело.workspaceId); Область = ИД(Тело.areaId);
    Если Цель <> "" Тогда Цель = ИД(Цель); КонецЕсли;
    Намерение = СериализоватьДанные(Канонический(Тело), 16000);
    Если ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_склад_вложенная_транзакция"; КонецЕсли;
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        БлокироватьСсылку("Справочник.УчетныеЗаписи", УчетнаяЗапись); ПроверитьАктера(УчетнаяЗапись);
        Маршрут = РегистрыСведений.ПривязкиКомандСклада.СоздатьМенеджерЗаписи();
        Маршрут.УчетнаяЗапись = УчетнаяЗапись; Маршрут.ИдентификаторЗапроса = Ключ; Маршрут.Прочитать();
        Если Маршрут.Выбран() Тогда
            Контекст = Новый Структура("УчетнаяЗапись,РабочееПространство,Область", УчетнаяЗапись, Маршрут.РабочееПространство, Маршрут.Область);
            ЗаблокироватьКонтекст(Контекст);
            ИсходноеТело = ИзJSON(Маршрут.НамерениеJSON);
            Если ТипЗнч(ИсходноеТело) <> Тип("Структура") Тогда ВызватьИсключение "кабинет_склад_привязка_конфликт"; КонецЕсли;
            Полномочие = ПроверитьПолномочиеКоманды(Контекст, Маршрут.Операция, Маршрут.ИдентификаторЦели, ИсходноеТело);
        Иначе
            Контекст = Новый Структура("УчетнаяЗапись,РабочееПространство,Область", УчетнаяЗапись,
                СсылкаКаталога("РабочиеПространства", РабочееПространство), СсылкаКаталога("Области", Область));
            ЗаблокироватьКонтекст(Контекст);
            Полномочие = ПроверитьПолномочиеКоманды(Контекст, Операция, Цель, Тело);
        КонецЕсли;
        Если Режим = "Inventory" Тогда
            ПроверитьКладовщика(Контекст);
            Если Полномочие.РабочаяОперация Тогда ВызватьИсключение "кабинет_склад_некорректно_операция"; КонецЕсли;
        ИначеЕсли Режим = "Work" Тогда
            Если Не Полномочие.РабочаяОперация Тогда ВызватьИсключение "кабинет_склад_некорректно_операция"; КонецЕсли;
        Иначе
            ВызватьИсключение "кабинет_склад_привязка_конфликт";
        КонецЕсли;
        Если ИДс(Контекст.РабочееПространство) <> РабочееПространство Или ИДс(Контекст.Область) <> Область Тогда
            ВызватьИсключение "кабинет_склад_запрос_конфликт";
        КонецЕсли;
        Команда = ОткрытьКоманду(УчетнаяЗапись, Ключ, Операция, Цель, Намерение, Контекст);
        Контекст.Вставить("Команда", Команда);
    Исключение
        Откат(); ВызватьИсключение;
    КонецПопытки;
    Возврат Контекст;
КонецФункции

Функция ПроверитьПолномочиеКоманды(Контекст, Операция, Цель, Тело)
    НарядСсылка = Справочники.Наряды.ПустаяСсылка();
    РабочаяОперация = Ложь; Полномочие = "Read";
    Если Операция = "request.create" Или Операция = "work.request.create" Тогда
        Если Не Тело.Свойство("workOrderId") Или ИД(Тело.workOrderId) <> Цель Тогда ВызватьИсключение "кабинет_склад_привязка_конфликт"; КонецЕсли;
        НарядСсылка = СсылкаКаталога("Наряды", Цель);
        РабочаяОперация = Операция = "work.request.create"; Полномочие = "Request";
    ИначеЕсли Лев(Операция, 9) = "movement." Тогда
        Если Не Тело.Свойство("operation") Или Операция <> "movement." + Тело.operation Тогда ВызватьИсключение "кабинет_склад_привязка_конфликт"; КонецЕсли;
        ЭффективнаяОперация = Тело.operation;
        Если ЭффективнаяОперация = "Reversal" Тогда
            Если Не Тело.Свойство("originalMovementId") Или ИД(Тело.originalMovementId) <> Цель Тогда ВызватьИсключение "кабинет_склад_привязка_конфликт"; КонецЕсли;
            Снимок = СсылкаДвижения(Цель).ПолучитьОбъект(); ПроверитьОбластьОбъекта(Снимок, Контекст);
            Если Не Снимок.Проведен Или Снимок.Операция = "Reversal" Тогда ВызватьИсключение "кабинет_склад_сторно_конфликт"; КонецЕсли;
            ЭффективнаяОперация = Снимок.Операция; НарядСсылка = Снимок.Наряд;
            Полномочие = "Correct";
        ИначеЕсли СтрРазделить("Reserve,Issue,Return,Release,Consume", ",").Найти(ЭффективнаяОперация) <> Неопределено Тогда
            Если Не Тело.Свойство("materialRequestId") Или ИД(Тело.materialRequestId) <> Цель Тогда ВызватьИсключение "кабинет_склад_привязка_конфликт"; КонецЕсли;
            Снимок = СсылкаКаталога("ЗаявкиМатериалов", Цель).ПолучитьОбъект(); ПроверитьОбластьОбъекта(Снимок, Контекст);
            НарядСсылка = Снимок.Наряд; Полномочие = "Consume";
        ИначеЕсли ЭффективнаяОперация <> "Receipt" И ЭффективнаяОперация <> "Transfer" Тогда
            ВызватьИсключение "кабинет_склад_некорректно_операция";
        КонецЕсли;
        РабочаяОперация = ЭффективнаяОперация = "Consume";
    ИначеЕсли СтрРазделить("setup.Unit,setup.Material,setup.Warehouse,setup.Cell", ",").Найти(Операция) = Неопределено Тогда
        ВызватьИсключение "кабинет_склад_привязка_конфликт";
    КонецЕсли;
    Если РабочаяОперация Тогда
        Если Не ЗначениеЗаполнено(НарядСсылка) Тогда ВызватьИсключение "кабинет_склад_привязка_конфликт"; КонецЕсли;
        Разрешение = СервисНарядов.ПроверитьПолномочияМатериалов(Контекст.УчетнаяЗапись, Контекст.РабочееПространство, Контекст.Область, НарядСсылка, Полномочие);
    Иначе
        ПроверитьКладовщика(Контекст);
        Если ЗначениеЗаполнено(НарядСсылка) Тогда Наряд = ОбъектНаряда(НарядСсылка, Контекст); КонецЕсли;
    КонецЕсли;
    Возврат Новый Структура("РабочаяОперация,Наряд", РабочаяОперация, НарядСсылка);
КонецФункции

Процедура АвторизоватьПроведение(Документ, Контекст)
    ЗаблокироватьКонтекст(Контекст);
    Тело = ТелоИзДокумента(Документ);
    Цель = "";
    Если Тело.Свойство("materialRequestId") Тогда Цель = Тело.materialRequestId; КонецЕсли;
    Если Тело.Свойство("originalMovementId") Тогда Цель = Тело.originalMovementId; КонецЕсли;
    Полномочие = ПроверитьПолномочиеКоманды(Контекст, "movement." + Документ.Операция, Цель, Тело);
    Если Документ.Наряд <> Полномочие.Наряд Тогда ВызватьИсключение "кабинет_склад_привязка_конфликт"; КонецЕсли;
КонецПроцедуры

Функция НачатьОбласть(УчетнаяЗапись, ПространствоИД, ОбластьИД, РабочийКонтекст = Ложь)
    ПроверитьАктера(УчетнаяЗапись);
    Если ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_склад_вложенная_транзакция"; КонецЕсли;
    Контекст = Новый Структура("УчетнаяЗапись,РабочееПространство,Область", УчетнаяЗапись,
        СсылкаКаталога("РабочиеПространства", ПространствоИД), СсылкаКаталога("Области", ОбластьИД));
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        Если РабочийКонтекст Тогда
            ЗаблокироватьКонтекст(Контекст);
            Разрешение = СервисНарядов.ПроверитьПолномочияМатериалов(УчетнаяЗапись, Контекст.РабочееПространство, Контекст.Область);
        Иначе
            ЗаблокироватьОбласть(Контекст);
        КонецЕсли;
    Исключение
        Откат(); ВызватьИсключение;
    КонецПопытки;
    Возврат Контекст;
КонецФункции

Процедура ПроверитьАктера(УчетнаяЗапись)
    Если ПривилегированныйРежим() Тогда ВызватьИсключение "кабинет_склад_привилегированный_запрещено"; КонецЕсли;
    Текущий = ПолитикаДоступа.ПроверитьУчетнуюЗапись();
    Если ТипЗнч(УчетнаяЗапись) <> Тип("СправочникСсылка.УчетныеЗаписи") Или Текущий.Ссылка <> УчетнаяЗапись Тогда
        ВызватьИсключение "кабинет_участник_несовпадение";
    КонецЕсли;
КонецПроцедуры

Процедура ЗаблокироватьОбласть(Контекст)
    ЗаблокироватьКонтекст(Контекст);
    ПроверитьКладовщика(Контекст);
КонецПроцедуры

Процедура ПроверитьКладовщика(Контекст)
    ПолитикаДоступа.ПроверитьДоступКОбласти(Контекст.УчетнаяЗапись, ИДс(Контекст.РабочееПространство), ИДс(Контекст.Область), "Storekeeper");
КонецПроцедуры

Процедура ЗаблокироватьКонтекст(Контекст)
    ПроверитьАктера(Контекст.УчетнаяЗапись);
    БлокироватьСсылку("Справочник.УчетныеЗаписи", Контекст.УчетнаяЗапись);
    БлокироватьСсылку("Справочник.РабочиеПространства", Контекст.РабочееПространство);
    БлокироватьСсылку("Справочник.Области", Контекст.Область);
    ПроверитьАктера(Контекст.УчетнаяЗапись);
    ПолитикаДоступа.ПроверитьДоступКОбласти(Контекст.УчетнаяЗапись, ИДс(Контекст.РабочееПространство), ИДс(Контекст.Область));
КонецПроцедуры

Процедура БлокироватьСсылку(Таблица, Ссылка)
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить(Таблица);
    Элемент.УстановитьЗначение("Ссылка", Ссылка);
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
КонецПроцедуры

Функция ОткрытьКоманду(УчетнаяЗапись, Ключ, Операция, Цель, Намерение, Контекст)
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("РегистрСведений.ПривязкиКомандСклада");
    Элемент.УстановитьЗначение("УчетнаяЗапись", УчетнаяЗапись);
    Элемент.УстановитьЗначение("ИдентификаторЗапроса", Ключ);
    Элемент.Режим = РежимБлокировкиДанных.Исключительный; Блокировка.Заблокировать();
    Команда = РегистрыСведений.ПривязкиКомандСклада.СоздатьМенеджерЗаписи();
    Команда.УчетнаяЗапись = УчетнаяЗапись; Команда.ИдентификаторЗапроса = Ключ; Команда.Прочитать();
    Если Команда.Выбран() Тогда
        Если Команда.Операция <> Операция Или Команда.ИдентификаторЦели <> Цель Или Команда.НамерениеJSON <> Намерение
            Или Команда.РабочееПространство <> Контекст.РабочееПространство Или Команда.Область <> Контекст.Область Тогда
            ВызватьИсключение "кабинет_склад_запрос_конфликт";
        КонецЕсли;
    Иначе
        Команда.УчетнаяЗапись = УчетнаяЗапись; Команда.ИдентификаторЗапроса = Ключ;
        Команда.Операция = Операция; Команда.ИдентификаторЦели = Цель; Команда.НамерениеJSON = Намерение;
        Команда.РабочееПространство = Контекст.РабочееПространство; Команда.Область = Контекст.Область;
    КонецЕсли;
    Возврат Команда;
КонецФункции

Функция Повтор(Команда)
    История = РегистрыСведений.ИсторияСклада.СоздатьМенеджерЗаписи();
    История.Вид = Команда.ВидСущности; История.ИдентификаторСущности = Команда.ИдентификаторСущности;
    История.Ревизия = Команда.РевизияРезультата; История.Прочитать();
    Если Не История.Выбран() Тогда ВызватьИсключение "кабинет_склад_привязка_конфликт"; КонецЕсли;
    Если История.ПослеJSON <> Команда.РезультатJSON Или История.РабочееПространство <> Команда.РабочееПространство
        Или История.Область <> Команда.Область Или История.ДействующееЛицо <> Команда.УчетнаяЗапись
        Или История.ИдентификаторЗапроса <> Команда.ИдентификаторЗапроса Или История.Операция <> Команда.Операция Тогда
        ВызватьИсключение "кабинет_склад_привязка_конфликт";
    КонецЕсли;
    Результат = ИзJSON(Команда.РезультатJSON);
    Если ТипЗнч(Результат) <> Тип("Структура") Тогда ВызватьИсключение "кабинет_склад_привязка_конфликт"; КонецЕсли;
    Если Результат.id <> Команда.ИдентификаторСущности Или Результат.revision <> Команда.РевизияРезультата
        Или Результат.workspaceId <> ИДс(Команда.РабочееПространство) Или Результат.areaId <> ИДс(Команда.Область) Тогда
        ВызватьИсключение "кабинет_склад_привязка_конфликт";
    КонецЕсли;
    Возврат Результат;
КонецФункции

Процедура СохранитьРезультат(Команда, Вид, Ссылка, Ревизия, Перед, После, Причина, Контекст)
    СохранитьИсторию(Вид, Ссылка, Ревизия, Команда, Перед, После, Причина, Контекст);
    Команда.ВидСущности = Вид; Команда.ИдентификаторСущности = ИДс(Ссылка); Команда.РевизияРезультата = Ревизия;
    Команда.РезультатJSON = СериализоватьДанные(После, 24000); Команда.Записать();
    ПолитикаДоступа.ЗаписатьСобытиеАудита(Контекст.УчетнаяЗапись, Контекст.РабочееПространство,
        "inventory." + Команда.Операция, ИДс(Ссылка));
КонецПроцедуры

Процедура СохранитьИсторию(Вид, Ссылка, Ревизия, Команда, Перед, После, Причина, Контекст)
    Запись = РегистрыСведений.ИсторияСклада.СоздатьМенеджерЗаписи();
    Запись.Вид = Вид; Запись.ИдентификаторСущности = ИДс(Ссылка); Запись.Ревизия = Ревизия; Запись.Прочитать();
    Если Запись.Выбран() Тогда ВызватьИсключение "кабинет_склад_привязка_конфликт"; КонецЕсли;
    Запись.Вид = Вид; Запись.ИдентификаторСущности = ИДс(Ссылка); Запись.Ревизия = Ревизия;
    Запись.РабочееПространство = Контекст.РабочееПространство; Запись.Область = Контекст.Область;
    Запись.Операция = Команда.Операция; Запись.Причина = Причина;
    Запись.ДоJSON = СериализоватьДанные(Перед, 24000); Запись.ПослеJSON = СериализоватьДанные(После, 24000);
    Запись.ДействующееЛицо = Контекст.УчетнаяЗапись; Запись.ИдентификаторЗапроса = Команда.ИдентификаторЗапроса;
    Запись.Момент = ТекущаяУниверсальнаяДата(); Запись.Записать();
КонецПроцедуры

Процедура РасходКвоты(Контекст, Вид, Предел)
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("РегистрСведений.КвотыСклада");
    Элемент.УстановитьЗначение("РабочееПространство", Контекст.РабочееПространство);
    Элемент.УстановитьЗначение("Область", Контекст.Область); Элемент.УстановитьЗначение("Вид", Вид);
    Элемент.Режим = РежимБлокировкиДанных.Исключительный; Блокировка.Заблокировать();
    Запись = РегистрыСведений.КвотыСклада.СоздатьМенеджерЗаписи();
    Запись.РабочееПространство = Контекст.РабочееПространство; Запись.Область = Контекст.Область; Запись.Вид = Вид; Запись.Прочитать();
    Количество = 0; Если Запись.Выбран() Тогда Количество = Запись.Использовано; КонецЕсли;
    Если Количество < 0 Или Количество <> Цел(Количество) Или Количество >= Предел Тогда ВызватьИсключение "кабинет_склад_квота_превышено"; КонецЕсли;
    Запись.РабочееПространство = Контекст.РабочееПространство; Запись.Область = Контекст.Область; Запись.Вид = Вид;
    Запись.Использовано = Количество + 1; Запись.Записать();
КонецПроцедуры

Функция АктивныйОбъект(Ссылка, Контекст)
    БлокироватьСсылку("Справочник." + Ссылка.Метаданные().Имя, Ссылка);
    Объект = Ссылка.ПолучитьОбъект(); ПроверитьОбластьОбъекта(Объект, Контекст);
    Если Объект.Состояние <> "Active" Тогда ВызватьИсключение "кабинет_склад_не_найдено"; КонецЕсли;
    Возврат Объект;
КонецФункции

Процедура ПроверитьОбластьОбъекта(Объект, Контекст)
    Если Объект = Неопределено Тогда ВызватьИсключение "кабинет_склад_не_найдено"; КонецЕсли;
    Если Объект.ПометкаУдаления Или Объект.РабочееПространство <> Контекст.РабочееПространство Или Объект.Область <> Контекст.Область Тогда
        ВызватьИсключение "кабинет_склад_не_найдено";
    КонецЕсли;
    Если Не ЗначениеЗаполнено(Объект.КемСоздано) Или Объект.ДатаСоздания = Дата(1, 1, 1)
        Или Объект.Ревизия < 1 Или Объект.Ревизия <> Цел(Объект.Ревизия) Тогда ВызватьИсключение "кабинет_склад_привязка_конфликт"; КонецЕсли;
КонецПроцедуры

Функция ОбъектНаряда(Ссылка, Контекст)
    БлокироватьСсылку("Справочник.Наряды", Ссылка);
    Объект = Ссылка.ПолучитьОбъект(); ПроверитьОбластьОбъекта(Объект, Контекст);
    Если СтрРазделить("Draft,Assigned,Accepted,InProgress,Paused,Reported,Verified,Closed,Cancelled,Submitted,Rework,Completed", ",").Найти(Объект.Состояние) = Неопределено Тогда
        ВызватьИсключение "кабинет_склад_привязка_конфликт";
    КонецЕсли;
    Возврат Объект;
КонецФункции

Процедура ПроверитьСостояниеНаряда(Наряд, Операция)
    Если Операция = "Request" Или Операция = "Reserve" Тогда
        Если СтрРазделить("Assigned,Accepted,InProgress,Paused,Rework", ",").Найти(Наряд.Состояние) = Неопределено Тогда ВызватьИсключение "кабинет_склад_состояние_конфликт"; КонецЕсли;
    ИначеЕсли Операция = "Issue" Или Операция = "Consume" Тогда
        Если Наряд.Состояние <> "InProgress" И Наряд.Состояние <> "Rework" Тогда ВызватьИсключение "кабинет_склад_состояние_конфликт"; КонецЕсли;
    КонецЕсли;
КонецПроцедуры

Функция ПроверитьМатериал(Ссылка, Контекст, Количество = 0)
    Материал = АктивныйОбъект(Ссылка, Контекст);
    Единица = АктивныйОбъект(Материал.Единица, Контекст);
    Если Единица.Точность < 0 Или Единица.Точность > 3 Или Единица.Точность <> Цел(Единица.Точность) Тогда ВызватьИсключение "кабинет_склад_привязка_конфликт"; КонецЕсли;
    Если Количество <> Окр(Количество, Единица.Точность) Тогда ВызватьИсключение "кабинет_склад_некорректно_количество"; КонецЕсли;
    Возврат Материал;
КонецФункции

Процедура ПроверитьЯчейку(СкладСсылка, ЯчейкаСсылка, Контекст)
    Склад = АктивныйОбъект(СкладСсылка, Контекст); Ячейка = АктивныйОбъект(ЯчейкаСсылка, Контекст);
    Если Ячейка.Склад <> Склад.Ссылка Тогда ВызватьИсключение "кабинет_склад_не_найдено"; КонецЕсли;
КонецПроцедуры

Функция ОбъектЗаявки(Ссылка, Контекст)
    Предварительная = Ссылка.ПолучитьОбъект(); ПроверитьОбластьОбъекта(Предварительная, Контекст);
    Наряд = ОбъектНаряда(Предварительная.Наряд, Контекст);
    БлокироватьСсылку("Справочник.ЗаявкиМатериалов", Ссылка);
    Объект = Ссылка.ПолучитьОбъект(); ПроверитьОбластьОбъекта(Объект, Контекст);
    Если Объект.Наряд <> Наряд.Ссылка Тогда ВызватьИсключение "кабинет_склад_привязка_конфликт"; КонецЕсли;
    ПроверитьСчетчики(Объект);
    Если Объект.Состояние <> СостояниеЗаявки(Объект) Тогда ВызватьИсключение "кабинет_склад_привязка_конфликт"; КонецЕсли;
    Если ЗначениеЗаполнено(Объект.ПоследнееДвижение) Тогда
        Голова = Объект.ПоследнееДвижение.ПолучитьОбъект(); ПроверитьОбластьОбъекта(Голова, Контекст);
        Если Не Голова.Проведен Или СтрРазделить("Reserve,Issue,Return,Release,Consume", ",").Найти(Голова.Операция) = Неопределено
            Или Голова.Заявка <> Объект.Ссылка Или Голова.Наряд <> Объект.Наряд Или Голова.Материал <> Объект.Материал
            Или Голова.Склад <> Объект.Склад Или Голова.Ячейка <> Объект.Ячейка Тогда ВызватьИсключение "кабинет_склад_привязка_конфликт"; КонецЕсли;
        Привязка = ОткрытьОбратнуюПривязку(Голова.Ссылка);
        Если Привязка.Выбран() Тогда ВызватьИсключение "кабинет_склад_привязка_конфликт"; КонецЕсли;
    ИначеЕсли Объект.Зарезервировано <> 0 Или Объект.Выдано <> 0 Или Объект.Возвращено <> 0 Или Объект.Освобождено <> 0 Или Объект.Списано <> 0 Тогда
        ВызватьИсключение "кабинет_склад_привязка_конфликт";
    КонецЕсли;
    Возврат Объект;
КонецФункции

Процедура ПроверитьСчетчики(Заявка, Планируемый = Ложь)
    ПроверитьКоличество(Заявка.Запрошено);
    Если Заявка.Зарезервировано < 0 Или Заявка.Зарезервировано > Заявка.Запрошено
        Или (Заявка.Зарезервировано <> 0 И Заявка.Зарезервировано <> Заявка.Запрошено)
        Или Заявка.Выдано < 0 Или Заявка.Освобождено < 0 Или Заявка.Возвращено < 0 Или Заявка.Списано < 0
        Или Заявка.Выдано + Заявка.Освобождено > Заявка.Зарезервировано Или Заявка.Возвращено + Заявка.Списано > Заявка.Выдано Тогда
        Если Планируемый Тогда ВызватьИсключение "кабинет_склад_количество_конфликт"; КонецЕсли;
        ВызватьИсключение "кабинет_склад_остаток_конфликт";
    КонецЕсли;
    Если Заявка.Зарезервировано <> Окр(Заявка.Зарезервировано, 3) Или Заявка.Выдано <> Окр(Заявка.Выдано, 3)
        Или Заявка.Возвращено <> Окр(Заявка.Возвращено, 3) Или Заявка.Освобождено <> Окр(Заявка.Освобождено, 3)
        Или Заявка.Списано <> Окр(Заявка.Списано, 3) Тогда
        ВызватьИсключение "кабинет_склад_остаток_конфликт";
    КонецЕсли;
КонецПроцедуры

Функция СостояниеЗаявки(Заявка)
    Если Заявка.Зарезервировано = 0 Тогда Возврат "Requested"; КонецЕсли;
    Если Заявка.Зарезервировано - Заявка.Выдано - Заявка.Освобождено > 0 Тогда Возврат "Open"; КонецЕсли;
    Возврат "Closed";
КонецФункции

Процедура ЗаполнитьОбщее(Объект, УчетнаяЗапись, Контекст, Состояние)
    Объект.РабочееПространство = Контекст.РабочееПространство; Объект.Область = Контекст.Область;
    Объект.КемСоздано = УчетнаяЗапись; Объект.ДатаСоздания = ТекущаяУниверсальнаяДата();
    Объект.ДатаОбновления = Объект.ДатаСоздания; Объект.Ревизия = 1; Объект.Состояние = Состояние;
КонецПроцедуры

Функция ДанныеНастройки(Объект, Вид)
    Данные = Новый Структура("id,name,workspaceId,areaId,state,revision", ИДс(Объект.Ссылка), Объект.Наименование,
        ИДс(Объект.РабочееПространство), ИДс(Объект.Область), Объект.Состояние, Объект.Ревизия);
    Если Вид = "Unit" Тогда Данные.Вставить("precision", Объект.Точность); КонецЕсли;
    Если Вид = "Material" Тогда Данные.Вставить("unitId", ИДс(Объект.Единица)); Данные.Вставить("unitName", Объект.Единица.Наименование); КонецЕсли;
    Если Вид = "Cell" Тогда Данные.Вставить("warehouseId", ИДс(Объект.Склад)); КонецЕсли;
    Возврат Данные;
КонецФункции

Функция ДанныеЗаявки(Объект)
    Данные = Новый Структура("id,workspaceId,areaId,workOrderId,workOrderName,state", ИДс(Объект.Ссылка),
        ИДс(Объект.РабочееПространство), ИДс(Объект.Область), ИДс(Объект.Наряд), Объект.Наряд.Наименование, СостояниеЗаявки(Объект));
    Данные.Вставить("materialId", ИДс(Объект.Материал)); Данные.Вставить("materialName", Объект.Материал.Наименование);
    Данные.Вставить("unitId", ИДс(Объект.Материал.Единица)); Данные.Вставить("unitName", Объект.Материал.Единица.Наименование);
    Данные.Вставить("warehouseId", ИДс(Объект.Склад)); Данные.Вставить("warehouseName", Объект.Склад.Наименование);
    Данные.Вставить("cellId", ИДс(Объект.Ячейка)); Данные.Вставить("cellName", Объект.Ячейка.Наименование);
    Данные.Вставить("requestedQuantity", Объект.Запрошено); Данные.Вставить("reservedTotal", Объект.Зарезервировано);
    Данные.Вставить("issuedTotal", Объект.Выдано); Данные.Вставить("returnedTotal", Объект.Возвращено); Данные.Вставить("releasedTotal", Объект.Освобождено);
    Данные.Вставить("reservedRemaining", Объект.Зарезервировано - Объект.Выдано - Объект.Освобождено);
    Данные.Вставить("outstandingQuantity", Объект.Выдано - Объект.Возвращено);
    Данные.Вставить("consumedTotal", Объект.Списано);
    Данные.Вставить("returnableQuantity", Объект.Выдано - Объект.Возвращено - Объект.Списано);
    Данные.Вставить("revision", Объект.Ревизия); Данные.Вставить("lastMovementId", ИДс(Объект.ПоследнееДвижение));
    Возврат Данные;
КонецФункции

Функция КаталогНастройки(Вид)
    Если Вид = "Unit" Тогда Возврат "ЕдиницыМатериалов"; КонецЕсли;
    Если Вид = "Material" Тогда Возврат "Материалы"; КонецЕсли;
    Если Вид = "Warehouse" Тогда Возврат "СкладыМатериалов"; КонецЕсли;
    Если Вид = "Cell" Тогда Возврат "ЯчейкиМатериалов"; КонецЕсли;
    ВызватьИсключение "кабинет_склад_некорректно_вид";
КонецФункции

Функция ИД(Значение)
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда ВызватьИсключение "кабинет_некорректно_идентификатор"; КонецЕсли;
    Если СтрДлина(Значение) <> 36 Тогда ВызватьИсключение "кабинет_некорректно_идентификатор"; КонецЕсли;
    Попытка
        Разобранный = Новый УникальныйИдентификатор(Значение);
    Исключение
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецПопытки;
    Если НРег(Значение) <> Строка(Разобранный) Или Строка(Разобранный) = "00000000-0000-0000-0000-000000000000" Тогда ВызватьИсключение "кабинет_некорректно_идентификатор"; КонецЕсли;
    Возврат Строка(Разобранный);
КонецФункции

Функция ИДс(Ссылка)
    Если Не ЗначениеЗаполнено(Ссылка) Тогда Возврат ""; КонецЕсли;
    Возврат Строка(Ссылка.УникальныйИдентификатор());
КонецФункции

Функция СсылкаКаталога(Имя, Значение)
    Возврат Справочники[Имя].ПолучитьСсылку(Новый УникальныйИдентификатор(ИД(Значение)));
КонецФункции

Функция СсылкаДвижения(Значение)
    Возврат Документы.ДвижениеМатериалов.ПолучитьСсылку(Новый УникальныйИдентификатор(ИД(Значение)));
КонецФункции

Процедура ПроверитьПоля(Тело, Обязательные, Необязательные = "")
    Если ТипЗнч(Тело) <> Тип("Структура") Тогда ВызватьИсключение "кабинет_склад_некорректно_поле"; КонецЕсли;
    Разрешенные = СтрРазделить(Обязательные + "," + Необязательные, ",");
    Для Каждого Пара Из Тело Цикл
        Если Разрешенные.Найти(Пара.Ключ) = Неопределено Тогда ВызватьИсключение "кабинет_склад_некорректно_поле"; КонецЕсли;
    КонецЦикла;
    Для Каждого Имя Из СтрРазделить(Обязательные, ",") Цикл
        Если Имя <> "" И Не Тело.Свойство(Имя) Тогда ВызватьИсключение "кабинет_склад_некорректно_поле"; КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ТекстПоля(Тело, Имя, Максимум, Многострочный = Ложь)
    Значение = Неопределено;
    Если Не Тело.Свойство(Имя, Значение) Тогда ВызватьИсключение "кабинет_склад_некорректно_поле"; КонецЕсли;
    Возврат Текст(Значение, Максимум, Многострочный);
КонецФункции

Функция Текст(Значение, Максимум, Многострочный = Ложь, Пустой = Ложь)
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда ВызватьИсключение "кабинет_склад_некорректно_поле"; КонецЕсли;
    Значение = СокрЛП(СтрЗаменить(СтрЗаменить(Значение, Символ(13) + Символ(10), Символ(10)), Символ(13), Символ(10)));
    Если СтрДлина(Значение) > Максимум Или (Не Пустой И Значение = "") Тогда ВызватьИсключение "кабинет_склад_некорректно_поле"; КонецЕсли;
    Для Индекс = 1 По СтрДлина(Значение) Цикл
        Код = КодСимвола(Значение, Индекс);
        Если Код < 32 И Не (Многострочный И (Код = 10 Или Код = 9)) Тогда ВызватьИсключение "кабинет_склад_некорректно_поле"; КонецЕсли;
    КонецЦикла;
    Возврат Значение;
КонецФункции

Функция НеобязательныйТекст(Тело, Имя, Максимум)
    Значение = "";
    Если Тело.Свойство(Имя, Значение) Тогда Возврат Текст(Значение, Максимум, Истина, Истина); КонецЕсли;
    Возврат "";
КонецФункции

Функция ЦелоеПоля(Тело, Имя, Минимум, Максимум)
    Значение = Неопределено;
    Если Не Тело.Свойство(Имя, Значение) Тогда ВызватьИсключение "кабинет_склад_некорректно_редакция"; КонецЕсли;
    Если ТипЗнч(Значение) <> Тип("Число") Тогда ВызватьИсключение "кабинет_склад_некорректно_редакция"; КонецЕсли;
    Если Значение < Минимум Или Значение > Максимум Или Значение <> Цел(Значение) Тогда ВызватьИсключение "кабинет_склад_некорректно_редакция"; КонецЕсли;
    Возврат Значение;
КонецФункции

Функция КоличествоПоля(Тело, Имя)
    Значение = Неопределено;
    Если Не Тело.Свойство(Имя, Значение) Тогда ВызватьИсключение "кабинет_склад_некорректно_количество"; КонецЕсли;
    ПроверитьКоличество(Значение); Возврат Значение;
КонецФункции

Процедура ПроверитьКоличество(Значение)
    Если ТипЗнч(Значение) <> Тип("Число") Тогда ВызватьИсключение "кабинет_склад_некорректно_количество"; КонецЕсли;
    Если Значение <= 0 Или Значение > 999999999.999 Или Значение <> Окр(Значение, 3) Тогда ВызватьИсключение "кабинет_склад_некорректно_количество"; КонецЕсли;
КонецПроцедуры

Функция ДатаПоля(Тело, Имя)
    Значение = ТекстПоля(Тело, Имя, 20);
    Если СтрДлина(Значение) <> 20 Или Сред(Значение, 5, 1) <> "-" Или Сред(Значение, 8, 1) <> "-"
        Или Сред(Значение, 11, 1) <> "T" Или Сред(Значение, 14, 1) <> ":" Или Сред(Значение, 17, 1) <> ":" Или Прав(Значение, 1) <> "Z" Тогда
        ВызватьИсключение "кабинет_склад_некорректно_даты";
    КонецЕсли;
    Цифры = Лев(Значение, 4) + Сред(Значение, 6, 2) + Сред(Значение, 9, 2) + Сред(Значение, 12, 2) + Сред(Значение, 15, 2) + Сред(Значение, 18, 2);
    Для Индекс = 1 По СтрДлина(Цифры) Цикл
        Если СтрНайти("0123456789", Сред(Цифры, Индекс, 1)) = 0 Тогда ВызватьИсключение "кабинет_склад_некорректно_даты"; КонецЕсли;
    КонецЦикла;
    Попытка
        ДатаЗначение = XMLЗначение(Тип("Дата"), Лев(Значение, 19));
    Исключение
        ВызватьИсключение "кабинет_склад_некорректно_даты";
    КонецПопытки;
    Если XMLСтрока(ДатаЗначение) <> Лев(Значение, 19) Тогда ВызватьИсключение "кабинет_склад_некорректно_даты"; КонецЕсли;
    ПроверитьДату(ДатаЗначение); Возврат ДатаЗначение;
КонецФункции

Процедура ПроверитьДату(Значение)
    Если Значение = Дата(1, 1, 1) Или Значение > ТекущаяУниверсальнаяДата() + 300 Тогда ВызватьИсключение "кабинет_склад_некорректно_даты"; КонецЕсли;
КонецПроцедуры

Функция Канонический(Значение, Глубина = 0)
    Если Глубина > 4 Тогда ВызватьИсключение "кабинет_склад_некорректно_поле"; КонецЕсли;
    Если ТипЗнч(Значение) = Тип("Структура") Тогда
        Таблица = Новый ТаблицаЗначений; Таблица.Колонки.Добавить("Имя"); Таблица.Колонки.Добавить("Значение");
        Для Каждого Пара Из Значение Цикл СтрокаТаблицы = Таблица.Добавить(); СтрокаТаблицы.Имя = Пара.Ключ; СтрокаТаблицы.Значение = Пара.Значение; КонецЦикла;
        Таблица.Сортировать("Имя"); Результат = Новый Структура;
        Для Каждого СтрокаТаблицы Из Таблица Цикл Результат.Вставить(СтрокаТаблицы.Имя, Канонический(СтрокаТаблицы.Значение, Глубина + 1)); КонецЦикла;
        Возврат Результат;
    КонецЕсли;
    Если ТипЗнч(Значение) = Тип("Строка") Или ТипЗнч(Значение) = Тип("Число") Или ТипЗнч(Значение) = Тип("Булево") Тогда Возврат Значение; КонецЕсли;
    ВызватьИсключение "кабинет_склад_некорректно_поле";
КонецФункции

Функция СериализоватьДанные(Данные, Максимум)
    Запись = Новый ЗаписьJSON; Запись.УстановитьСтроку(); ЗаписатьJSON(Запись, Данные); Результат = Запись.Закрыть();
    Если СтрДлина(Результат) > Максимум Тогда ВызватьИсключение "кабинет_склад_некорректно_поле"; КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ИзJSON(Значение)
    Если СтрДлина(Значение) > 24000 Тогда ВызватьИсключение "кабинет_склад_привязка_конфликт"; КонецЕсли;
    Чтение = Новый ЧтениеJSON; Чтение.УстановитьСтроку(Значение);
    Попытка
        Результат = ПрочитатьJSON(Чтение); Чтение.Закрыть();
    Исключение
        Чтение.Закрыть(); ВызватьИсключение "кабинет_склад_привязка_конфликт";
    КонецПопытки;
    Возврат Результат;
КонецФункции

Процедура Откат()
    Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
КонецПроцедуры
