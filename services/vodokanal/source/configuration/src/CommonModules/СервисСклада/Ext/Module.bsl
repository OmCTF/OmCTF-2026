    Запрос.УстановитьПараметр("После", П.after);
    ПараметрыОбласти(Запрос, Контекст); Запрос.УстановитьПараметр("Все", Не ЗначениеЗаполнено(НарядСсылка)); Запрос.УстановитьПараметр("Наряд", НарядСсылка);
    Выборка = Запрос.Выполнить().Выбрать(); Данные = Новый Массив; Еще = Ложь;
    Пока Выборка.Следующий() Цикл
