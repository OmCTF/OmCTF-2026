Функция НастройкиВКонтексте(Контекст, Авторство = Ложь)
    Единицы = СписокНастроек(Контекст, "Unit", Авторство); Материалы = СписокНастроек(Контекст, "Material", Авторство);
    Склады = СписокНастроек(Контекст, "Warehouse", Авторство); Ячейки = СписокНастроек(Контекст, "Cell", Авторство);
    Возврат Новый Структура("units,materials,warehouses,cells,limit,hasMore,snapshotAt",
        Единицы.items, Материалы.items, Склады.items, Ячейки.items, 100,
        Единицы.hasMore Или Материалы.hasMore Или Склады.hasMore Или Ячейки.hasMore, XMLСтрока(ТекущаяУниверсальнаяДата()) + "Z");
КонецФункции

Функция СписокНастроек(Контекст, Вид, Авторство = Ложь)
    ИмяКаталога = КаталогНастройки(Вид);
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 101 Ссылка ИЗ Справочник." + ИмяКаталога
        + " ГДЕ РабочееПространство = &РабочееПространство И Область = &Область И НЕ ПометкаУдаления И Состояние = &Состояние УПОРЯДОЧИТЬ ПО Ссылка");
    ПараметрыОбласти(Запрос, Контекст); Запрос.УстановитьПараметр("Состояние", "Active");
    Выборка = Запрос.Выполнить().Выбрать(); Данные = Новый Массив; Еще = Ложь;
    Пока Выборка.Следующий() Цикл
        Если Данные.Количество() = 100 Тогда Еще = Истина; Прервать; КонецЕсли;
        Объект = АктивныйОбъект(Выборка.Ссылка, Контекст);
        Если Вид = "Material" Тогда Единица = АктивныйОбъект(Объект.Единица, Контекст); КонецЕсли;
        Если Вид = "Cell" Тогда Склад = АктивныйОбъект(Объект.Склад, Контекст); КонецЕсли;
        СтрокаДанных = ДанныеНастройки(Объект, Вид);
        Если Авторство Тогда СтрокаДанных.Вставить("createdBy", ИДс(Объект.КемСоздано)); КонецЕсли;
        Данные.Добавить(СтрокаДанных);
    КонецЦикла;
    Возврат Страница(Данные, Еще);
КонецФункции

