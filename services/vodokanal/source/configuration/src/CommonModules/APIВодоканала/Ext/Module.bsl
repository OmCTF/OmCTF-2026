Функция ОбработатьЗапросHTTP(Действие, Запрос) Экспорт
    Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
    Если Пользователь = Неопределено Тогда
        Возврат СформироватьОтветHTTP(503, Новый Структура("error", "запуск_требуется"));
    КонецЕсли;
    Если ПустаяСтрока(Пользователь.Имя) Тогда
        Возврат СформироватьОтветHTTP(503, Новый Структура("error", "запуск_требуется"));
    КонецЕсли;
    Если Не (РольДоступна("Администратор") Или РольДоступна("Диспетчер")) Тогда
        Возврат СформироватьОтветHTTP(403, Новый Структура("error", "forbidden"));
    КонецЕсли;

    Данные = Новый Структура;
    Данные.Вставить("error", "устаревший_апи_выведено");
    Данные.Вставить("retiredSince", "2026-10-25");
    Данные.Вставить("replacement", "/vodokanal/hs/api/v1");
    Данные.Вставить("migration", "Use the v1 portal login and scoped resource contracts; do not replay a v0 body or native staff credentials as a v1 command.");
    Ответ = СформироватьОтветHTTP(410, Данные);
    Ответ.Заголовки.Вставить("Sunset", "Sun, 25 Oct 2026 00:00:00 GMT");
    Ответ.Заголовки.Вставить("Link", "</vodokanal/hs/api/v1>; rel=""successor-version""");
    Возврат Ответ;
КонецФункции

Функция СформироватьОтветHTTP(СтатусКод, Данные)
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Данные);
    Результат = Новый HTTPСервисОтвет(СтатусКод);
    Результат.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Результат.Заголовки.Вставить("Cache-Control", "no-store");
    Результат.Заголовки.Вставить("X-Content-Type-Options", "nosniff");
    Результат.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8);
    Возврат Результат;
КонецФункции
