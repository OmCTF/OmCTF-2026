Функция ОбработатьЗапросHTTP(Действие, Запрос) Экспорт
    ИдентификаторКорреляции = Строка(СервисДокументов.НовыйUUIDv4());
    Попытка
        ПроверитьСубъекта();
        Если Запрос.HTTPМетод <> "GET" Тогда ВызватьИсключение "публичный_лаборатория_метод_не_разрешено"; КонецЕсли;
        ПроверитьОтсутствиеТела(Запрос);
        Если Действие = "reference" Тогда
            ПроверитьПараметры(Запрос, "");
            Данные = Справочники();
        ИначеЕсли Действие = "protocols" Или Действие = "summary" Тогда
            ПроверитьПараметры(Запрос, ?(Действие = "protocols", "lakeCode,indicatorCode,from,to,afterId,limit", "lakeCode,indicatorCode,from,to"));
            Период = ПубличныйПериод(Параметр(Запрос, "lakeCode", 32), Параметр(Запрос, "from", 20), Параметр(Запрос, "to", 20), Действие = "summary");
            Показатель = Параметр(Запрос, "indicatorCode", 32);
            Если Показатель <> "" Тогда ОписаниеПоказателя(Показатель); КонецЕсли;
            Если Действие = "protocols" Тогда
                Данные = СписокПротоколов(Период, Показатель, Параметр(Запрос, "afterId", 36), ЛимитСтраницы(Параметр(Запрос, "limit", 3)));
            Иначе
                Данные = Сводка(Период, Показатель);
            КонецЕсли;
        ИначеЕсли Действие = "protocol" Или Действие = "csv" Или Действие = "pdf" Тогда
            ПроверитьПараметры(Запрос, "version");
            Ид = Запрос.ПараметрыURL.Получить("id");
            Данные = Протокол(Ид, Версия(Параметр(Запрос, "version", 2)));
            Если Действие = "csv" Тогда
                Возврат ОтветCSV(Данные, ИдентификаторКорреляции);
            ИначеЕсли Действие = "pdf" Тогда
                Возврат ОтветPDF(Данные, ИдентификаторКорреляции);
            КонецЕсли;
        Иначе
            ВызватьИсключение "кабинет_лаборатория_не_найдено";
        КонецЕсли;
        Возврат ОтветJSON(200, Данные, ИдентификаторКорреляции);
    Исключение
        Возврат ОтветПриСбое(ОписаниеОшибки(), ИдентификаторКорреляции);
    КонецПопытки;
КонецФункции

Процедура ПроверитьСубъекта()
    Если ПривилегированныйРежим() Тогда ВызватьИсключение "публичный_лаборатория_учетная_запись_запрещено"; КонецЕсли;
    Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
    Если Пользователь = Неопределено Тогда ВызватьИсключение "публичный_лаборатория_учетная_запись_запрещено"; КонецЕсли;
    КоличествоРолей = 0;
    Для Каждого Роль Из Пользователь.Роли Цикл
        КоличествоРолей = КоличествоРолей + 1;
    КонецЦикла;
    Если Пользователь.Имя <> "vodokanal_public_reader" Или КоличествоРолей <> 1 Или Не РольДоступна("ПубличноеЧтениеЛаборатории") Тогда
        ВызватьИсключение "публичный_лаборатория_учетная_запись_запрещено";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьОтсутствиеТела(Запрос)
    Для Каждого Заголовок Из Запрос.Заголовки Цикл
        Имя = НРег(Заголовок.Ключ);
        Если Имя = "transfer-encoding" Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_тело"; КонецЕсли;
        Если Имя = "content-length" И СокрЛП(Заголовок.Значение) <> "0" Тогда
            ВызватьИсключение "кабинет_лаборатория_некорректно_тело";
        КонецЕсли;
    КонецЦикла;
    Тело = Запрос.ПолучитьТелоКакДвоичныеДанные();
    Если Тело <> Неопределено Тогда
        Если Тело.Размер() <> 0 Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_тело"; КонецЕсли;
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьПараметры(Запрос, РазрешенныеПоля)
    Разрешенные = СтрРазделить(РазрешенныеПоля, ",");
    Для Каждого Пара Из Запрос.ПараметрыЗапроса Цикл
        Если Разрешенные.Найти(Пара.Ключ) = Неопределено Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_поле"; КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция Параметр(Запрос, Имя, Максимум)
    Значение = Запрос.ПараметрыЗапроса.Получить(Имя);
    Если Значение = Неопределено Тогда Возврат ""; КонецЕсли;
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_поле"; КонецЕсли;
    Если СтрДлина(Значение) > Максимум Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_поле"; КонецЕсли;
    Возврат Значение;
КонецФункции

Функция Идентификатор(Значение)
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_идентификатор"; КонецЕсли;
    Если СтрДлина(Значение) <> 36 Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_идентификатор"; КонецЕсли;
    Для Позиция = 1 По 36 Цикл
        Знак = НРег(Сред(Значение, Позиция, 1));
        Если Позиция = 9 Или Позиция = 14 Или Позиция = 19 Или Позиция = 24 Тогда
            Если Знак <> "-" Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_идентификатор"; КонецЕсли;
        ИначеЕсли СтрНайти("0123456789abcdef", Знак) = 0 Тогда
            ВызватьИсключение "кабинет_лаборатория_некорректно_идентификатор";
        КонецЕсли;
    КонецЦикла;
    Попытка
        Возврат Новый УникальныйИдентификатор(Значение);
    Исключение
        ВызватьИсключение "кабинет_лаборатория_некорректно_идентификатор";
    КонецПопытки;
КонецФункции

Функция СтрокаСсылки(Ссылка)
    Если Не ЗначениеЗаполнено(Ссылка) Тогда Возврат ""; КонецЕсли;
    Возврат Строка(Ссылка.УникальныйИдентификатор());
КонецФункции

Функция Версия(Текст)
    Если Текст = "" Тогда Возврат 0; КонецЕсли;
    Если СтрДлина(Текст) > 1 И Лев(Текст, 1) = "0" Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_версия"; КонецЕсли;
    Для Позиция = 1 По СтрДлина(Текст) Цикл
        Если СтрНайти("0123456789", Сред(Текст, Позиция, 1)) = 0 Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_версия"; КонецЕсли;
    КонецЦикла;
    ЧислоВерсии = Число(Текст);
    Если ЧислоВерсии > 20 Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_версия"; КонецЕсли;
    Возврат ЧислоВерсии;
КонецФункции

Функция ДатаИзСтроки(Значение)
    Если СтрДлина(Значение) <> 20 Или Сред(Значение, 11, 1) <> "T" Или Прав(Значение, 1) <> "Z" Тогда
        ВызватьИсключение "кабинет_лаборатория_некорректно_дата";
    КонецЕсли;
    Для Позиция = 1 По 19 Цикл
        Знак = Сред(Значение, Позиция, 1);
        Если Позиция = 5 Или Позиция = 8 Тогда
            Если Знак <> "-" Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_дата"; КонецЕсли;
        ИначеЕсли Позиция = 14 Или Позиция = 17 Тогда
            Если Знак <> ":" Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_дата"; КонецЕсли;
        ИначеЕсли Позиция <> 11 И СтрНайти("0123456789", Знак) = 0 Тогда
            ВызватьИсключение "кабинет_лаборатория_некорректно_дата";
        КонецЕсли;
    КонецЦикла;
    Попытка
        Результат = XMLЗначение(Тип("Дата"), Лев(Значение, 19));
    Исключение
        ВызватьИсключение "кабинет_лаборатория_некорректно_дата";
    КонецПопытки;
    Если Результат = Дата(1, 1, 1) Или XMLСтрока(Результат) <> Лев(Значение, 19) Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_дата"; КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ПубличныйПериод(КодОзера, От, До, ЭтоСводка)
    Если КодОзера <> "" Тогда
        НазваниеОзера(КодОзера);
        Если КодОзера = "potaennoe" Тогда ВызватьИсключение "кабинет_лаборатория_не_найдено"; КонецЕсли;
    КонецЕсли;
    Если ЭтоСводка И (От = "" Или До = "") Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_период"; КонецЕсли;
    Начало = ?(От = "", Дата(2000, 1, 1), ДатаИзСтроки(От));
    Конец = ?(До = "", ТекущаяУниверсальнаяДата() + 1, ДатаИзСтроки(До));
    Если Начало < Дата(2000, 1, 1) Или Начало >= Конец Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_период"; КонецЕсли;
    Если ЭтоСводка И Конец - Начало > 366 * 86400 Тогда ВызватьИсключение "кабинет_лаборатория_сводка_лимит"; КонецЕсли;
    Возврат Новый Структура("КодОзера,Начало,Конец", КодОзера, Начало, Конец);
КонецФункции

Функция УчебнаяМаркировка()
    Возврат "УЧЕБНЫЕ ДАННЫЕ: не реальные анализы, нормативы или медицинские рекомендации";
КонецФункции

Функция НазваниеОзера(Код)
    Если Код = "danilovo" Тогда Возврат "Данилово";
    ИначеЕсли Код = "lenyovo" Тогда Возврат "Ленёво";
    ИначеЕсли Код = "shchuchye" Тогда Возврат "Щучье";
    ИначеЕсли Код = "shaitan" Тогда Возврат "Шайтан";
    ИначеЕсли Код = "potaennoe" Тогда Возврат "Потаённое";
    КонецЕсли;
    ВызватьИсключение "кабинет_лаборатория_некорректно_справочник";
КонецФункции

Функция ОписаниеПоказателя(Код)
    Если Код = "ph" Тогда
        Возврат Новый Структура("code,kind,unit,method,min,max", Код, "decimal", "pH", "demo-ph-v1", "0", "14");
    ИначеЕсли Код = "turbidity" Тогда
        Возврат Новый Структура("code,kind,unit,method,min,max", Код, "decimal", "NTU", "demo-ntu-v1", "0", "10000");
    ИначеЕсли Код = "temperature" Тогда
        Возврат Новый Структура("code,kind,unit,method,min,max", Код, "decimal", "C", "demo-temp-v1", "-20", "100");
    ИначеЕсли Код = "appearance" Тогда
        Возврат Новый Структура("code,kind,unit,method,allowed", Код, "qualitative", "code", "demo-visual-v1", СтрРазделить("clear,turbid", ","));
    КонецЕсли;
    ВызватьИсключение "кабинет_лаборатория_некорректно_показатель";
КонецФункции

Функция Справочники()
    Озера = Новый Массив;
    Для Каждого Код Из СтрРазделить("danilovo,lenyovo,shchuchye,shaitan,potaennoe", ",") Цикл
        Озера.Добавить(Новый Структура("code,name,public", Код, НазваниеОзера(Код), Код <> "potaennoe"));
    КонецЦикла;
    Панели = Новый Массив;
    Панели.Добавить(Новый Структура("code,estimatedCost,indicatorCodes", "basic", 1000, СтрРазделить("ph,turbidity,appearance", ",")));
    Панели.Добавить(Новый Структура("code,estimatedCost,indicatorCodes", "extended", 1500, СтрРазделить("ph,turbidity,appearance,temperature", ",")));
    Показатели = Новый Массив;
    Для Каждого Код Из СтрРазделить("ph,turbidity,appearance,temperature", ",") Цикл
        Показатели.Добавить(ОписаниеПоказателя(Код));
    КонецЦикла;
    Возврат Новый Структура("dictionaryVersion,source,warning,lakes,waterTypes,places,collectionMethods,panels,indicators",
        "lab-demo-2026-01", "SPEC-6.8/demo-v1", УчебнаяМаркировка(), Озера, СтрРазделить("lake,tap,well", ","),
        СтрРазделить("shore,center,intake", ","), СтрРазделить("customer,courier", ","), Панели, Показатели);
КонецФункции

Функция ТекстЗапросаПротоколов(Предел)
    Возврат "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ " + Формат(Предел, "ЧГ=0") + "
        |ТабПроба.Ссылка КАК Проба, ТабПроба.КодОзера КАК КодОзера, ТабПроба.ВремяОтбора КАК ВремяОтбора,
        |ТабПроба.Панель КАК Панель, ТабРедакция.Ссылка КАК Редакция, ТабРедакция.Версия КАК Версия,
        |ТабРедакция.ПредыдущийУтвержденный КАК ПредыдущийУтвержденный,
        |ТабРедакция.ДатаУтверждения КАК ДатаУтверждения, ТабРедакция.Состояние КАК Состояние,
        |ТабРедакция.ВерсияСправочника КАК ВерсияСправочника
        |ИЗ Справочник.РедакцииЛабораторныхПротоколов КАК ТабРедакция
        |ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПробыЛаборатории КАК ТабПроба ПО ТабРедакция.Проба = ТабПроба.Ссылка
        |ГДЕ ТабПроба.КодОзера В (&Озера) И НЕ ТабПроба.ПометкаУдаления И НЕ ТабРедакция.ПометкаУдаления
        |И ТабРедакция.Состояние = &Утверждено И ТабРедакция.ВерсияСправочника = &Справочник
        |И ТабРедакция.РабочееПространство = ТабПроба.РабочееПространство И ТабРедакция.Область = ТабПроба.Область
        |И НЕ ТабПроба.РабочееПространство.ПометкаУдаления И ТабПроба.РабочееПространство.Состояние = &Активно
        |И НЕ ТабПроба.Область.ПометкаУдаления И ТабПроба.Область.Состояние = &Активно
        |И ТабПроба.Область.РабочееПространство = ТабПроба.РабочееПространство И НЕ ТабПроба.Заказ.ПометкаУдаления
        |И ТабПроба.Заказ.РабочееПространство = ТабПроба.РабочееПространство И ТабПроба.Заказ.Область = ТабПроба.Область";
КонецФункции

Процедура ПараметрыПубличногоЗапроса(Запрос)
    Запрос.УстановитьПараметр("Озера", СтрРазделить("danilovo,lenyovo,shchuchye,shaitan", ","));
    Запрос.УстановитьПараметр("Утверждено", "Approved");
    Запрос.УстановитьПараметр("Активно", "Active");
    Запрос.УстановитьПараметр("Справочник", "lab-demo-2026-01");
КонецПроцедуры

Функция ЛимитСтраницы(Значение)
    Если Значение = "" Тогда Возврат 25; КонецЕсли;
    Если СтрДлина(Значение) > 3 Или Лев(Значение, 1) = "0" Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_лимит"; КонецЕсли;
    Для Позиция = 1 По СтрДлина(Значение) Цикл
        Если СтрНайти("0123456789", Сред(Значение, Позиция, 1)) = 0 Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_лимит"; КонецЕсли;
    КонецЦикла;
    Лимит = Число(Значение);
    Если Лимит < 1 Или Лимит > 100 Тогда ВызватьИсключение "кабинет_лаборатория_некорректно_лимит"; КонецЕсли;
    Возврат Лимит;
КонецФункции

Функция ВыбратьПротоколы(Период, Показатель, ПослеИд, ЭтоСводка, Лимит = 25)
    После = Справочники.ПробыЛаборатории.ПустаяСсылка();
    Если ПослеИд <> "" Тогда После = Справочники.ПробыЛаборатории.ПолучитьСсылку(Идентификатор(ПослеИд)); КонецЕсли;
    Текст = ТекстЗапросаПротоколов(?(ЭтоСводка, 1001, Лимит + 1)) + "
        |И ТабРедакция.Ссылка = ТабПроба.УтвержденныйПротокол
        |И (&ЛюбоеОзеро ИЛИ ТабПроба.КодОзера = &КодОзера)
        |И ТабПроба.ВремяОтбора >= &Начало И ТабПроба.ВремяОтбора < &Конец И ТабПроба.Ссылка > &После";
    Если Показатель <> "" Тогда
        Текст = Текст + "
            |И ТабРедакция.Ссылка В (ВЫБРАТЬ Измерения.Редакция
            |ИЗ РегистрСведений.ИзмеренияРедакцийПротоколов КАК Измерения
            |ГДЕ Измерения.КодПоказателя = &Показатель)";
    КонецЕсли;
    Запрос = Новый Запрос(Текст + " УПОРЯДОЧИТЬ ПО ТабПроба.Ссылка");
    ПараметрыПубличногоЗапроса(Запрос);
    Запрос.УстановитьПараметр("ЛюбоеОзеро", Период.КодОзера = "");
    Запрос.УстановитьПараметр("КодОзера", Период.КодОзера);
    Запрос.УстановитьПараметр("Начало", Период.Начало);
    Запрос.УстановитьПараметр("Конец", Период.Конец);
    Запрос.УстановитьПараметр("После", После);
    Если Показатель <> "" Тогда Запрос.УстановитьПараметр("Показатель", Показатель); КонецЕсли;
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция Протокол(Ид, НомерВерсии)
    СсылкаПробы = Справочники.ПробыЛаборатории.ПолучитьСсылку(Идентификатор(Ид));
    УсловиеВерсии = ?(НомерВерсии = 0, "ТабРедакция.Ссылка = ТабПроба.УтвержденныйПротокол", "ТабРедакция.Версия = &Версия");
    Запрос = Новый Запрос(ТекстЗапросаПротоколов(2) + " И ТабПроба.Ссылка = &Проба И " + УсловиеВерсии + " УПОРЯДОЧИТЬ ПО ТабРедакция.Ссылка");
    ПараметрыПубличногоЗапроса(Запрос);
    Запрос.УстановитьПараметр("Проба", СсылкаПробы);
    Если НомерВерсии <> 0 Тогда Запрос.УстановитьПараметр("Версия", НомерВерсии); КонецЕсли;
    Строки = Запрос.Выполнить().Выгрузить();
    Если Строки.Количество() = 0 Тогда ВызватьИсключение "кабинет_лаборатория_не_найдено"; КонецЕсли;
    Если Строки.Количество() <> 1 Тогда ВызватьИсключение "публичный_лаборатория_данные_недоступно"; КонецЕсли;
    Измерения = ИзмеренияРедакций(Строки);
    Возврат ДанныеПротокола(Строки[0], Измерения.Получить(Строки[0].Редакция));
КонецФункции

Функция ИзмеренияРедакций(Строки)
    Результат = Новый Соответствие;
    Редакции = Новый Массив;
    Для Каждого СтрокаДанных Из Строки Цикл
        Если Результат.Получить(СтрокаДанных.Редакция) <> Неопределено Тогда ВызватьИсключение "публичный_лаборатория_данные_недоступно"; КонецЕсли;
        Результат.Вставить(СтрокаДанных.Редакция, Новый Массив);
        Редакции.Добавить(СтрокаДанных.Редакция);
    КонецЦикла;
    Если Редакции.Количество() = 0 Тогда Возврат Результат; КонецЕсли;
    Если Редакции.Количество() > 1000 Тогда ВызватьИсключение "публичный_лаборатория_данные_недоступно"; КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 8001 Редакция, КодПоказателя, ЗначениеТекстом, ВидЗначения, Единица, Метод
        |ИЗ РегистрСведений.ИзмеренияРедакцийПротоколов ГДЕ Редакция В (&Редакции)
        |УПОРЯДОЧИТЬ ПО Редакция, КодПоказателя");
    Запрос.УстановитьПараметр("Редакции", Редакции);
    Выборка = Запрос.Выполнить().Выбрать();
    Количество = 0;
    Пока Выборка.Следующий() Цикл
        Количество = Количество + 1;
        Значения = Результат.Получить(Выборка.Редакция);
        Если Количество > 8000 Или Значения = Неопределено Тогда ВызватьИсключение "публичный_лаборатория_данные_недоступно"; КонецЕсли;
        Если Значения.Количество() >= 8 Тогда ВызватьИсключение "публичный_лаборатория_данные_недоступно"; КонецЕсли;
        Значения.Добавить(Новый Структура("indicatorCode,value,kind,unit,method", Выборка.КодПоказателя, Выборка.ЗначениеТекстом, Выборка.ВидЗначения, Выборка.Единица, Выборка.Метод));
    КонецЦикла;
    Для Каждого СтрокаДанных Из Строки Цикл
        ПроверитьИзмерения(Результат.Получить(СтрокаДанных.Редакция), СтрокаДанных.Панель);
    КонецЦикла;
    Возврат Результат;
КонецФункции

Процедура ПроверитьИзмерения(Значения, Панель)
    Если Панель <> "basic" И Панель <> "extended" Тогда ВызватьИсключение "публичный_лаборатория_данные_недоступно"; КонецЕсли;
    Ожидаемые = СтрРазделить(?(Панель = "basic", "ph,turbidity,appearance", "ph,turbidity,appearance,temperature"), ",");
    Если Значения.Количество() <> Ожидаемые.Количество() Тогда ВызватьИсключение "публичный_лаборатория_данные_недоступно"; КонецЕсли;
    Проверенные = Новый Соответствие;
    Для Каждого Значение Из Значения Цикл
        Если Ожидаемые.Найти(Значение.indicatorCode) = Неопределено Или Проверенные.Получить(Значение.indicatorCode) <> Неопределено Тогда
            ВызватьИсключение "публичный_лаборатория_данные_недоступно";
        КонецЕсли;
        Описание = ОписаниеПоказателя(Значение.indicatorCode);
        Если Значение.kind <> Описание.kind Или Значение.unit <> Описание.unit Или Значение.method <> Описание.method Тогда
            ВызватьИсключение "публичный_лаборатория_данные_недоступно";
        КонецЕсли;
        Если Описание.kind = "decimal" Тогда
            ЧисловоеЗначение = ТочноеЧисло(Значение.value);
            Если ЧисловоеЗначение < ТочноеЧисло(Описание.min) Или ЧисловоеЗначение > ТочноеЧисло(Описание.max) Тогда ВызватьИсключение "публичный_лаборатория_данные_недоступно"; КонецЕсли;
        ИначеЕсли Описание.allowed.Найти(Значение.value) = Неопределено Тогда
            ВызватьИсключение "публичный_лаборатория_данные_недоступно";
        КонецЕсли;
        Проверенные.Вставить(Значение.indicatorCode, Истина);
    КонецЦикла;
КонецПроцедуры

Функция ТочноеЧисло(Значение)
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда ВызватьИсключение "публичный_лаборатория_данные_недоступно"; КонецЕсли;
    Цифры = Значение;
    Если Лев(Цифры, 1) = "-" Тогда Цифры = Сред(Цифры, 2); КонецЕсли;
    Части = СтрРазделить(Цифры, ".", Истина);
    Если Части.Количество() < 1 Или Части.Количество() > 2 Тогда ВызватьИсключение "публичный_лаборатория_данные_недоступно"; КонецЕсли;
    Если СтрДлина(Части[0]) < 1 Или СтрДлина(Части[0]) > 9 Тогда ВызватьИсключение "публичный_лаборатория_данные_недоступно"; КонецЕсли;
    Если СтрДлина(Части[0]) > 1 И Лев(Части[0], 1) = "0" Тогда ВызватьИсключение "публичный_лаборатория_данные_недоступно"; КонецЕсли;
    Если Части.Количество() = 2 Тогда
        Если СтрДлина(Части[1]) < 1 Или СтрДлина(Части[1]) > 6 Тогда ВызватьИсключение "публичный_лаборатория_данные_недоступно"; КонецЕсли;
    КонецЕсли;
    Для Позиция = 1 По СтрДлина(Цифры) Цикл
        Если СтрНайти("0123456789.", Сред(Цифры, Позиция, 1)) = 0 Тогда ВызватьИсключение "публичный_лаборатория_данные_недоступно"; КонецЕсли;
    КонецЦикла;
    Попытка
        Результат = XMLЗначение(Тип("Число"), Значение);
    Исключение
        ВызватьИсключение "публичный_лаборатория_данные_недоступно";
    КонецПопытки;
    Если Результат = 0 И Лев(Значение, 1) = "-" Тогда ВызватьИсключение "публичный_лаборатория_данные_недоступно"; КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ДанныеПротокола(СтрокаДанных, Измерения)
    Если СтрокаДанных.Версия < 1 Или СтрокаДанных.Версия > 20 Или Окр(СтрокаДанных.Версия, 0) <> СтрокаДанных.Версия
        Или СтрокаДанных.ДатаУтверждения = Дата(1, 1, 1) Тогда ВызватьИсключение "публичный_лаборатория_данные_недоступно"; КонецЕсли;
    Возврат Новый Структура("sampleId,protocolId,version,previousApprovedProtocolId,lakeCode,lakeName,collectedAt,approvedAt,state,dictionaryVersion,source,warning,values",
        СтрокаСсылки(СтрокаДанных.Проба), СтрокаСсылки(СтрокаДанных.Редакция), СтрокаДанных.Версия, СтрокаСсылки(СтрокаДанных.ПредыдущийУтвержденный),
        СтрокаДанных.КодОзера, НазваниеОзера(СтрокаДанных.КодОзера), XMLСтрока(СтрокаДанных.ВремяОтбора) + "Z", XMLСтрока(СтрокаДанных.ДатаУтверждения) + "Z",
        СтрокаДанных.Состояние, СтрокаДанных.ВерсияСправочника, "SPEC-6.8/demo-v1", УчебнаяМаркировка(), Измерения);
КонецФункции

Функция СписокПротоколов(Период, Показатель, ПослеИд, Лимит)
    Строки = ВыбратьПротоколы(Период, Показатель, ПослеИд, Ложь, Лимит);
    ЕстьЕще = Строки.Количество() > Лимит;
    Если ЕстьЕще Тогда Строки.Удалить(Лимит); КонецЕсли;
    Измерения = ИзмеренияРедакций(Строки);
    Элементы = Новый Массив; Последний = "";
    Для Каждого СтрокаДанных Из Строки Цикл
        Элементы.Добавить(ДанныеПротокола(СтрокаДанных, Измерения.Получить(СтрокаДанных.Редакция)));
        Последний = СтрокаСсылки(СтрокаДанных.Проба);
    КонецЦикла;
    Возврат Новый Структура("items,hasMore,nextCursor,limit,warning,source", Элементы, ЕстьЕще, ?(ЕстьЕще, Последний, ""), Лимит, УчебнаяМаркировка(), "SPEC-6.8/demo-v1");
КонецФункции

Функция Сводка(Период, Показатель)
    Строки = ВыбратьПротоколы(Период, Показатель, "", Истина);
    Если Строки.Количество() > 1000 Тогда ВызватьИсключение "кабинет_лаборатория_сводка_лимит"; КонецЕсли;
    Измерения = ИзмеренияРедакций(Строки);
    Статистика = Новый Соответствие;
    Для Каждого СтрокаДанных Из Строки Цикл
        Протокол = ДанныеПротокола(СтрокаДанных, Измерения.Получить(СтрокаДанных.Редакция));
        Для Каждого Измерение Из Протокол.values Цикл
            Если Показатель <> "" И Измерение.indicatorCode <> Показатель Тогда Продолжить; КонецЕсли;
            Итог = Статистика.Получить(Измерение.indicatorCode);
            Если Итог = Неопределено Тогда
                Итог = Новый Структура("Вид,Единица,Метод,Количество,Сумма,Минимум,Максимум,Прозрачных,Мутных", Измерение.kind, Измерение.unit, Измерение.method, 0, 0, 0, 0, 0, 0);
                Статистика.Вставить(Измерение.indicatorCode, Итог);
            КонецЕсли;
            Если Измерение.kind = "decimal" Тогда
                Значение = ТочноеЧисло(Измерение.value);
                Если Итог.Количество = 0 Тогда
                    Итог.Минимум = Значение; Итог.Максимум = Значение;
                Иначе
                    Итог.Минимум = Мин(Итог.Минимум, Значение); Итог.Максимум = Макс(Итог.Максимум, Значение);
                КонецЕсли;
                Итог.Сумма = Итог.Сумма + Значение;
            ИначеЕсли Измерение.value = "clear" Тогда
                Итог.Прозрачных = Итог.Прозрачных + 1;
            Иначе
                Итог.Мутных = Итог.Мутных + 1;
            КонецЕсли;
            Итог.Количество = Итог.Количество + 1;
        КонецЦикла;
    КонецЦикла;
    Показатели = Новый Массив;
    Для Каждого Код Из СтрРазделить("ph,turbidity,appearance,temperature", ",") Цикл
        Итог = Статистика.Получить(Код);
        Если Итог = Неопределено Тогда Продолжить; КонецЕсли;
        Данные = Новый Структура("indicatorCode,kind,unit,method,count", Код, Итог.Вид, Итог.Единица, Итог.Метод, Итог.Количество);
        Если Итог.Вид = "decimal" Тогда
            Данные.Вставить("sum", XMLСтрока(Итог.Сумма)); Данные.Вставить("min", XMLСтрока(Итог.Минимум)); Данные.Вставить("max", XMLСтрока(Итог.Максимум));
        Иначе
            Данные.Вставить("counts", Новый Структура("clear,turbid", Итог.Прозрачных, Итог.Мутных));
        КонецЕсли;
        Показатели.Добавить(Данные);
    КонецЦикла;
    Возврат Новый Структура("lakeCode,from,to,timeBasis,sampleCount,indicators,source,dictionaryVersion,status,generatedAt,warning",
        Период.КодОзера, XMLСтрока(Период.Начало) + "Z", XMLСтрока(Период.Конец) + "Z", "collectedAt", Строки.Количество(), Показатели,
        "SPEC-6.8/demo-v1", "lab-demo-2026-01", "Approved", XMLСтрока(ТекущаяУниверсальнаяДата()) + "Z", УчебнаяМаркировка());
КонецФункции

Функция Ответ(Статус, ТипСодержимого, ИдентификаторКорреляции)
    Результат = Новый HTTPСервисОтвет(Статус);
    Результат.Заголовки.Вставить("Content-Type", ТипСодержимого);
    Результат.Заголовки.Вставить("Cache-Control", "no-store");
    Результат.Заголовки.Вставить("X-Content-Type-Options", "nosniff");
    Результат.Заголовки.Вставить("X-Request-ID", ИдентификаторКорреляции);
    Результат.Заголовки.Вставить("X-API-Contract", "1.0");
    Если Статус = 405 Тогда Результат.Заголовки.Вставить("Allow", "GET"); КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ОтветJSON(Статус, Данные, ИдентификаторКорреляции)
    Запись = Новый ЗаписьJSON; Запись.УстановитьСтроку(); ЗаписатьJSON(Запись, Данные);
    Двоичные = ПолучитьДвоичныеДанныеИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8, Ложь);
    Если Двоичные.Размер() > 1048576 Тогда ВызватьИсключение "публичный_лаборатория_ответ_лимит"; КонецЕсли;
    Результат = Ответ(Статус, "application/json; charset=utf-8", ИдентификаторКорреляции);
    Результат.УстановитьТелоИзДвоичныхДанных(Двоичные);
    Возврат Результат;
КонецФункции

Функция ОтветПриСбое(Описание, ИдентификаторКорреляции)
    Группы = Новый Соответствие;
    Группы.Вставить(400, "кабинет_лаборатория_некорректно_тело,кабинет_лаборатория_некорректно_поле,кабинет_лаборатория_некорректно_идентификатор,кабинет_лаборатория_некорректно_версия,кабинет_лаборатория_некорректно_дата,кабинет_лаборатория_некорректно_период,кабинет_лаборатория_некорректно_справочник,кабинет_лаборатория_некорректно_показатель,кабинет_лаборатория_некорректно_лимит");
    Группы.Вставить(403, "публичный_лаборатория_учетная_запись_запрещено");
    Группы.Вставить(404, "кабинет_лаборатория_не_найдено");
    Группы.Вставить(405, "публичный_лаборатория_метод_не_разрешено");
    Группы.Вставить(409, "кабинет_лаборатория_сводка_лимит,публичный_лаборатория_ответ_лимит");
    Для Каждого Группа Из Группы Цикл
        Для Каждого Код Из СтрРазделить(Группа.Значение, ",") Цикл
            Если СтрНайти(Описание, Код) > 0 Тогда
                Ошибка = Новый Структура("code,message", Код, "Запрос к публичной лаборатории не выполнен.");
                Возврат ОтветJSON(Группа.Ключ, Новый Структура("error,requestId", Ошибка, ИдентификаторКорреляции), ИдентификаторКорреляции);
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Ошибка = Новый Структура("code,message", "публичный_лаборатория_недоступно", "Публичная лаборатория временно недоступна.");
    Возврат ОтветJSON(503, Новый Структура("error,requestId", Ошибка, ИдентификаторКорреляции), ИдентификаторКорреляции);
КонецФункции

Функция ЯчейкаCSV(Значение)
    Представление = Строка(Значение); Проверка = Представление;
    Пока СтрДлина(Проверка) > 0 Цикл
        Код = КодСимвола(Проверка, 1);
        Если Код <= 32 Или Код = 160 Тогда Проверка = Сред(Проверка, 2); Иначе Прервать; КонецЕсли;
    КонецЦикла;
    Если СтрДлина(Проверка) > 0 Тогда
        Если СтрНайти("=+-@", Лев(Проверка, 1)) > 0 Тогда Представление = "'" + Представление; КонецЕсли;
    КонецЕсли;
    Возврат """" + СтрЗаменить(Представление, """", """""") + """";
КонецФункции

Функция СтрокаCSV(Ячейки)
    Текст = "";
    Для Каждого Ячейка Из Ячейки Цикл
        Если Текст <> "" Тогда Текст = Текст + ";"; КонецЕсли;
        Текст = Текст + ЯчейкаCSV(Ячейка);
    КонецЦикла;
    Возврат Текст + Символ(13) + Символ(10);
КонецФункции

Функция ОтветCSV(Протокол, ИдентификаторКорреляции)
    Текст = ЯчейкаCSV(УчебнаяМаркировка()) + Символ(13) + Символ(10);
    Текст = Текст + СтрокаCSV(СтрРазделить("sampleId;version;lake;collectedAt;approvedAt;source;dictionaryVersion", ";"));
    Ячейки = Новый Массив; Ячейки.Добавить(Протокол.sampleId); Ячейки.Добавить(Протокол.version); Ячейки.Добавить(Протокол.lakeName);
    Ячейки.Добавить(Протокол.collectedAt); Ячейки.Добавить(Протокол.approvedAt); Ячейки.Добавить(Протокол.source); Ячейки.Добавить(Протокол.dictionaryVersion);
    Текст = Текст + СтрокаCSV(Ячейки) + СтрокаCSV(СтрРазделить("indicatorCode;value;unit;method", ";"));
    Для Каждого Измерение Из Протокол.values Цикл
        Ячейки = Новый Массив; Ячейки.Добавить(Измерение.indicatorCode); Ячейки.Добавить(Измерение.value); Ячейки.Добавить(Измерение.unit); Ячейки.Добавить(Измерение.method);
        Текст = Текст + СтрокаCSV(Ячейки);
    КонецЦикла;
    Двоичные = ПолучитьДвоичныеДанныеИзСтроки(Символ(65279) + Текст, КодировкаТекста.UTF8, Ложь);
    Если Двоичные.Размер() > 1048576 Тогда ВызватьИсключение "публичный_лаборатория_ответ_лимит"; КонецЕсли;
    Результат = Ответ(200, "text/csv; charset=utf-8", ИдентификаторКорреляции);
    Результат.Заголовки.Вставить("Content-Disposition", "attachment; filename=""" + ИмяФайла(Протокол, "csv") + """");
    Результат.УстановитьТелоИзДвоичныхДанных(Двоичные);
    Возврат Результат;
КонецФункции

Функция ИмяФайла(Протокол, Расширение)
    Возврат "training-lab-" + Протокол.sampleId + "-v" + Строка(Протокол.version) + "." + Расширение;
КонецФункции

Функция ОтветPDF(Протокол, ИдентификаторКорреляции)
    Таблица = Новый ТабличныйДокумент; Таблица.АвтоМасштаб = Истина;
    Таблица.Вывод = ИспользованиеВывода.Разрешить;
    Таблица.Область(1, 1, 16, 1).ШиринаКолонки = 100;
    Таблица.Область(1, 1, 16, 1).Шрифт = Новый Шрифт("DejaVu Sans", 10);
    Таблица.Область(1, 1).Текст = УчебнаяМаркировка();
    Таблица.Область(2, 1).Текст = "Протокол " + Протокол.sampleId + ", редакция " + Строка(Протокол.version);
    Таблица.Область(3, 1).Текст = Протокол.lakeName + "; отбор: " + Протокол.collectedAt;
    Таблица.Область(4, 1).Текст = "Утверждено: " + Протокол.approvedAt;
    Таблица.Область(5, 1).Текст = Протокол.source + "; " + Протокол.dictionaryVersion;
    НомерСтроки = 7;
    Для Каждого Измерение Из Протокол.values Цикл
        Таблица.Область(НомерСтроки, 1).Текст = Измерение.indicatorCode + ": " + Измерение.value + " " + Измерение.unit + "; " + Измерение.method;
        НомерСтроки = НомерСтроки + 1;
    КонецЦикла;
    Путь = ПолучитьИмяВременногоФайла("pdf");
    Попытка
        Таблица.Записать(Путь, ТипФайлаТабличногоДокумента.PDF);
        Двоичные = Новый ДвоичныеДанные(Путь);
        Если Двоичные.Размер() < 500 Или Двоичные.Размер() > 1048576 Тогда ВызватьИсключение "публичный_лаборатория_данные_недоступно"; КонецЕсли;
        УдалитьФайлы(Путь);
    Исключение
        Попытка УдалитьФайлы(Путь); Исключение КонецПопытки;
        ВызватьИсключение;
    КонецПопытки;
    Результат = Ответ(200, "application/pdf", ИдентификаторКорреляции);
    Результат.Заголовки.Вставить("Content-Disposition", "attachment; filename=""" + ИмяФайла(Протокол, "pdf") + """");
    Результат.УстановитьТелоИзДвоичныхДанных(Двоичные);
    Возврат Результат;
КонецФункции
