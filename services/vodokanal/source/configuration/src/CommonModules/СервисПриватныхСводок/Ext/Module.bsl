Функция ОбработатьЗапросКабинета(Действие, УчетнаяЗапись, Запрос, Корреляция) Экспорт
    Если Действие = "privateSummaryCreate" Тогда
        Тело = APIКабинета.РазобратьТелоЗапроса(Запрос, 12000);
        Данные = СоздатьСводку(УчетнаяЗапись, Тело);
        Возврат APIКабинета.СформироватьОтветHTTP(201, Данные, Корреляция);
    КонецЕсли;
    Если Действие = "privateSummaryGet" Тогда
        Данные = ПолучитьСводку(УчетнаяЗапись, Запрос.ПараметрыURL.Получить("id"));
        Возврат APIКабинета.СформироватьОтветHTTP(200, Данные, Корреляция);
    КонецЕсли;
    Если Действие = "privateSummaryPreview" Тогда
        Вид = APIКабинета.ТекстПараметраЗапроса(Запрос, "view", 8);
        Данные = ПросмотрСводки(УчетнаяЗапись, Запрос.ПараметрыURL.Получить("id"), Вид);
        Возврат APIКабинета.СформироватьОтветHTTP(200, Данные, Корреляция);
    КонецЕсли;
    Если Действие = "privateSummaryCapsule" Тогда
        Данные = КапсулаСводки(Запрос.ПараметрыURL.Получить("id"));
        Возврат APIКабинета.СформироватьОтветHTTP(200, Данные, Корреляция);
    КонецЕсли;
    Если Действие = "privateSummaryLookup" Тогда
        Заголовок = APIКабинета.ТекстПараметраЗапроса(Запрос, "title", 150);
        Если Заголовок = "" Тогда ВызватьИсключение "кабинет_сводка_некорректно_поле"; КонецЕсли;
        Данные = НайтиСводкуПоЗаголовку(УчетнаяЗапись, Заголовок);
        Возврат APIКабинета.СформироватьОтветHTTP(200, Данные, Корреляция);
    КонецЕсли;
    ВызватьИсключение "кабинет_сводка_не_найдено";
КонецФункции

Функция КапсулаСводки(Идентификатор)
    Ссылка = СсылкаСводки(Идентификатор);
    Объект = Ссылка.ПолучитьОбъект();
    Если Объект = Неопределено Или Объект.ПометкаУдаления
        Или (Объект.Состояние <> "Draft" И Объект.Состояние <> "Sealed") Тогда
        ВызватьИсключение "кабинет_сводка_не_найдено";
    КонецЕсли;
    ЧтениеКлюча = Новый ЧтениеТекста("/home/usr1cv8/.vdk-seal-key", КодировкаТекста.UTF8);
    Попытка
        КлючBase64 = ЧтениеКлюча.ПрочитатьСтроку();
        ЧтениеКлюча.Закрыть();
    Исключение
        ЧтениеКлюча.Закрыть();
        ВызватьИсключение "кабинет_сводка_печать_недоступно";
    КонецПопытки;
    Если ТипЗнч(КлючBase64) <> Тип("Строка") Или СтрДлина(КлючBase64) <> 44 Тогда
        ВызватьИсключение "кабинет_сводка_печать_недоступно";
    КонецЕсли;
    Если Не ПодключитьВнешнююКомпоненту("/opt/vodokanal-native/libVdkScopedSealAddIn.so", "VdkSeal2", ТипВнешнейКомпоненты.Native) Тогда
        ВызватьИсключение "кабинет_сводка_печать_недоступно";
    КонецЕсли;
    Шифратор = Новый("AddIn.VdkSeal2.VdkSeal2");
    Капсула = Шифратор.SealScopedText(КлючBase64, Объект.КлючПакета,
        Строка(Объект.УчетнаяЗаписьВладельца.УникальныйИдентификатор()),
        Строка(Объект.Ссылка.УникальныйИдентификатор()), Объект.Содержимое);
    Части = СтрРазделить(Капсула, ":", Ложь);
    Если Части.Количество() <> 2 Тогда ВызватьИсключение "кабинет_сводка_печать_недоступно"; КонецЕсли;
    Возврат Новый Структура("id,batchId,algorithm,nonce,ciphertext", Идентификатор, Объект.КлючПакета,
        "AES-256-GCM", Части[0], Части[1]);
КонецФункции

Функция ПросмотрСводки(УчетнаяЗапись, Идентификатор, Вид)
    Если Вид <> "public" И Вид <> "full" Тогда ВызватьИсключение "кабинет_сводка_некорректно_поле"; КонецЕсли;
    Ссылка = СсылкаСводки(Идентификатор);
    Объект = Ссылка.ПолучитьОбъект();
    Если Объект = Неопределено Или Объект.ПометкаУдаления
        Или (Объект.Состояние <> "Draft" И Объект.Состояние <> "Live") Тогда
        ВызватьИсключение "кабинет_сводка_не_найдено";
    КонецЕсли;
    Если Вид = "full" И Объект.УчетнаяЗаписьВладельца <> УчетнаяЗапись Тогда ВызватьИсключение "кабинет_сводка_не_найдено"; КонецЕсли;

    Пакет = СервисДокументов.ПодготовитьПакетСводки(Объект);
    Содержимое = СервисДокументов.ПолнаяПроекцияПакета(Пакет, Вид);
    Возврат Новый Структура("id,title,batchId,view,content,length", Идентификатор, Объект.Наименование,
        Объект.КлючПакета, Вид, Содержимое, Пакет.Длина);
КонецФункции

Функция СоздатьСводку(УчетнаяЗапись, Тело)
    Если ТипЗнч(Тело) <> Тип("Структура") Тогда ВызватьИсключение "кабинет_сводка_некорректно_поле"; КонецЕсли;
    Для Каждого Поле Из Тело Цикл
        Если Поле.Ключ <> "title" И Поле.Ключ <> "content" И Поле.Ключ <> "batchId" И Поле.Ключ <> "state" Тогда
            ВызватьИсключение "кабинет_сводка_некорректно_поле";
        КонецЕсли;
    КонецЦикла;
    Заголовок = ТекстовоеПоле(Тело, "title", 150, Истина);
    Содержимое = ТекстовоеПоле(Тело, "content", 4096, Истина, Ложь);
    КлючПакета = ТекстовоеПоле(Тело, "batchId", 64, Ложь);
    Если КлючПакета = "" Тогда КлючПакета = Строка(СервисДокументов.НовыйUUIDv4()); КонецЕсли;
    Состояние = ТекстовоеПоле(Тело, "state", 16, Ложь);
    Если Состояние = "" Тогда Состояние = "Draft"; КонецЕсли;
    Если СтрРазделить("Draft,Live,Sealed", ",").Найти(Состояние) = Неопределено Тогда ВызватьИсключение "кабинет_сводка_некорректно_поле"; КонецЕсли;
    Объект = Справочники.ПриватныеСводки.СоздатьЭлемент();
    Объект.SetNewObjectRef(Справочники.ПриватныеСводки.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
    Объект.Наименование = Заголовок;
    Объект.УчетнаяЗаписьВладельца = УчетнаяЗапись;
    Объект.Содержимое = Содержимое;
    Объект.КлючПакета = КлючПакета;
    Объект.Состояние = Состояние;
    Объект.Записать();
    Возврат ПредставлениеСводки(Объект.Ссылка);
КонецФункции

Функция ПолучитьСводку(УчетнаяЗапись, Идентификатор)
    Ссылка = СсылкаСводки(Идентификатор);
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ПриватныеСводки ГДЕ Ссылка = &Ссылка И УчетнаяЗаписьВладельца = &Владелец");
    Запрос.УстановитьПараметр("Ссылка", Ссылка);
    Запрос.УстановитьПараметр("Владелец", УчетнаяЗапись);
    Если Запрос.Выполнить().Пустой() Тогда
        ВызватьИсключение "кабинет_сводка_не_найдено";
    КонецЕсли;
    Возврат ПредставлениеСводки(Ссылка);
КонецФункции

Функция НайтиСводкуПоЗаголовку(УчетнаяЗапись, Заголовок)
    Поиск = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ПриватныеСводки
        |ГДЕ УчетнаяЗаписьВладельца = &Владелец И Наименование = &Заголовок И НЕ ПометкаУдаления");
    Поиск.УстановитьПараметр("Владелец", УчетнаяЗапись);
    Поиск.УстановитьПараметр("Заголовок", Заголовок);
    Найдено = Поиск.Выполнить().Выбрать();
    Если Не Найдено.Следующий() Или Найдено.Ссылка.Состояние <> "Draft" Тогда
        ВызватьИсключение "кабинет_сводка_не_найдено";
    КонецЕсли;
    Ссылка = СервисДокументов.СсылкаСводкиДляИндекса(Найдено.Ссылка);
    Если Ссылка.Пустая() Или Ссылка.Состояние <> "Draft" Тогда ВызватьИсключение "кабинет_сводка_не_найдено"; КонецЕсли;
    Возврат ПредставлениеСводки(Ссылка);
КонецФункции

Функция СсылкаСводки(Идентификатор)
    Если ТипЗнч(Идентификатор) <> Тип("Строка") Или СтрДлина(Идентификатор) <> 36 Тогда
        ВызватьИсключение "кабинет_сводка_не_найдено";
    КонецЕсли;
    Попытка
        Ссылка = Справочники.ПриватныеСводки.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
    Исключение
        ВызватьИсключение "кабинет_сводка_не_найдено";
    КонецПопытки;
    Возврат Ссылка;
КонецФункции

Функция ТекстовоеПоле(Тело, Имя, Предел, Обязательно, ОбрезатьПробелы = Истина)
    Значение = Неопределено;
    Если Не Тело.Свойство(Имя, Значение) Тогда
        Если Обязательно Тогда ВызватьИсключение "кабинет_сводка_некорректно_поле"; КонецЕсли;
        Возврат "";
    КонецЕсли;
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда ВызватьИсключение "кабинет_сводка_некорректно_поле"; КонецЕсли;
    Если ОбрезатьПробелы Тогда Значение = СокрЛП(Значение); КонецЕсли;
    Если СтрДлина(Значение) > Предел Или (Обязательно И Значение = "") Тогда
        ВызватьИсключение "кабинет_сводка_некорректно_поле";
    КонецЕсли;
    Возврат Значение;
КонецФункции

Функция ПредставлениеСводки(Ссылка)
    Возврат Новый Структура("id,title,content,batchId,state", Строка(Ссылка.УникальныйИдентификатор()),
        Ссылка.Наименование, Ссылка.Содержимое, Ссылка.КлючПакета, Ссылка.Состояние);
КонецФункции
