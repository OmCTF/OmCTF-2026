Функция ОбработатьЗапросКабинета(Действие, УчетнаяЗапись, Запрос, Корреляция) Экспорт
    СтатусОтвета = 200;
    Если Действие = "publicPortalEntries" Тогда
        Данные = СписокРедактора(УчетнаяЗапись, APIКабинета.ТекстПараметраЗапроса(Запрос, "workspaceId", 36),
            APIКабинета.ТекстПараметраЗапроса(Запрос, "limit", 3), APIКабинета.ТекстПараметраЗапроса(Запрос, "cursor", 36));
    ИначеЕсли Действие = "publicPortalSave" Тогда
        Тело = APIКабинета.РазобратьТелоЗапроса(Запрос); ПроверитьКлючЗаголовка(Запрос, Тело);
        Данные = Сохранить(УчетнаяЗапись, Тело, Корреляция);
        Если Тело.id = "" Тогда СтатусОтвета = 201; КонецЕсли;
    ИначеЕсли Действие = "publicPortalPublish" Или Действие = "publicPortalArchive" Тогда
        Тело = APIКабинета.РазобратьТелоЗапроса(Запрос); ПроверитьКлючЗаголовка(Запрос, Тело);
        Данные = ИзменитьСостояние(УчетнаяЗапись, Запрос.ПараметрыURL.Получить("id"),
            Тело, Действие = "publicPortalPublish", Корреляция);
    Иначе ВызватьИсключение "публичный_кабинет_не_найдено";
    КонецЕсли;
    Возврат APIКабинета.СформироватьОтветHTTP(СтатусОтвета, Данные, Корреляция);
КонецФункции

Функция Сводка() Экспорт
    ПубличныйПортал.ПроверитьСубъекта();
    Возврат Новый Структура("title,warning,contactLabel,contactPath,generatedAt,source",
        "Водоснабжение учебного города", "Учебный стенд. Адреса, услуги и измерения демонстрационные. Это не официальный сайт водоканала.",
        "Учебная служба: обращения в личном кабинете", "/?service=request&applicant=resident",
        ДатаСтрокой(ТекущаяУниверсальнаяДата()), "SPEC-6.1/public-portal-v1");
КонецФункции

Функция ПубличныйСписок(Вид, Поиск, От, До, Размер, Курсор, Заявитель, ТолькоДействующие = Ложь) Экспорт
    ПубличныйПортал.ПроверитьСубъекта();
    ПроверитьВид(Вид, Истина);
    Если Заявитель <> "" И Заявитель <> "resident" И Заявитель <> "organization" Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
    Лимит = ЛимитСтраницы(Размер);
    Начало = ?(От = "", Дата(2000, 1, 1), ДатаИзСтроки(От));
    Конец = ?(До = "", Дата(3999, 12, 31), ДатаИзСтроки(До));
    Если Начало >= Конец Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит + 1, "ЧГ=0") + "
        |Ссылка, КлючПубликации, Вид, Версия, Состояние, Заголовок, Текст, ДанныеJSON,
        |ДействуетС, ДействуетПо, ДатаПубликации, ДатаИзменения
        |ИЗ Справочник.ПубликацииПортала
        |ГДЕ НЕ ПометкаУдаления И Состояние В (&Опубликована, &Архив)
        |И РабочееПространство.Состояние = &Активная И НЕ РабочееПространство.ПометкаУдаления
        |И ДатаПубликации >= &Начало И ДатаПубликации < &Конец И ДатаПубликации <= &Сейчас
        |И (&Вид = """" ИЛИ Вид = &Вид) И Ссылка > &После
        |И (Заголовок ПОДОБНО &Поиск ИЛИ Текст ПОДОБНО &Поиск)
        |И (НЕ &Действующие ИЛИ (Состояние = &Опубликована И ДействуетС <= &Сейчас И (ДействуетПо = &ПустаяДата ИЛИ ДействуетПо > &Сейчас)))
        |И (&Заявитель = """" ИЛИ (&Заявитель = ""resident"" И ДляЖителя) ИЛИ (&Заявитель = ""organization"" И ДляОрганизации))
        |УПОРЯДОЧИТЬ ПО Ссылка");
    Запрос.УстановитьПараметр("Опубликована", "Published"); Запрос.УстановитьПараметр("Архив", "Archived");
    Запрос.УстановитьПараметр("Активная", "Active"); Запрос.УстановитьПараметр("Вид", Вид);
    Запрос.УстановитьПараметр("Начало", Начало); Запрос.УстановитьПараметр("Конец", Конец);
    Запрос.УстановитьПараметр("Сейчас", ТекущаяУниверсальнаяДата()); Запрос.УстановитьПараметр("ПустаяДата", Дата(1, 1, 1));
    Запрос.УстановитьПараметр("Действующие", ТолькоДействующие); Запрос.УстановитьПараметр("Заявитель", Заявитель);
    Запрос.УстановитьПараметр("Поиск", "%" + ШаблонПоиска(Поиск) + "%");
    Запрос.УстановитьПараметр("После", Ссылка(Курсор, Истина));
    Возврат Страница(Запрос, Лимит, Ложь);
КонецФункции

Функция СписокРедактора(УчетнаяЗапись, Пространство, Размер, Курсор) Экспорт
    Область = ПолитикаДоступа.ПроверитьДоступКРабочемуПространству(УчетнаяЗапись, Пространство, "WorkspaceOwner");
    Лимит = ЛимитСтраницы(Размер);
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит + 1, "ЧГ=0") + "
        |Ссылка, КлючПубликации, Вид, Версия, Ревизия, Состояние, Заголовок, Текст, ДанныеJSON,
        |ДействуетС, ДействуетПо, ДатаПубликации, ДатаИзменения, РабочееПространство, Автор, Редактор, ПредыдущаяВерсия
        |ИЗ Справочник.ПубликацииПортала ГДЕ РабочееПространство = &Пространство И НЕ ПометкаУдаления И Ссылка > &После УПОРЯДОЧИТЬ ПО Ссылка");
    Запрос.УстановитьПараметр("Пространство", Область); Запрос.УстановитьПараметр("После", Ссылка(Курсор, Истина));
    Возврат Страница(Запрос, Лимит, Истина);
КонецФункции

Функция Страница(Запрос, Лимит, Служебная)
    Выборка = Запрос.Выполнить().Выбрать(); Элементы = Новый Массив; Еще = Ложь; После = "";
    Пока Выборка.Следующий() Цикл
        Если Элементы.Количество() = Лимит Тогда Еще = Истина; Прервать; КонецЕсли;
        Элемент = ПубликацияDTO(Выборка, Служебная); Элементы.Добавить(Элемент); После = Элемент.id;
    КонецЦикла;
    Возврат Новый Структура("items,limit,hasMore,nextCursor,snapshotAt", Элементы, Лимит, Еще,
        ?(Еще, После, ""), ДатаСтрокой(ТекущаяУниверсальнаяДата()));
КонецФункции

Функция ПубликацияDTO(Запись, Служебная = Ложь)
    Результат = Новый Структура("id,key,kind,version,state,title,body,details,validFrom,validTo,publishedAt,updatedAt",
        Строка(Запись.Ссылка.УникальныйИдентификатор()), Запись.КлючПубликации, Запись.Вид, Запись.Версия,
        Запись.Состояние, Запись.Заголовок, Запись.Текст, ДанныеИзJSON(Запись.ДанныеJSON),
        ДатаСтрокой(Запись.ДействуетС), ДатаСтрокой(Запись.ДействуетПо), ДатаСтрокой(Запись.ДатаПубликации), ДатаСтрокой(Запись.ДатаИзменения));
    Если Служебная Тогда
        Результат.Вставить("workspaceId", Строка(Запись.РабочееПространство.УникальныйИдентификатор()));
        Результат.Вставить("revision", Запись.Ревизия);
        Результат.Вставить("authorId", Строка(Запись.Автор.УникальныйИдентификатор()));
        Результат.Вставить("editorId", Строка(Запись.Редактор.УникальныйИдентификатор()));
        Результат.Вставить("previousId", ?(ЗначениеЗаполнено(Запись.ПредыдущаяВерсия), Строка(Запись.ПредыдущаяВерсия.УникальныйИдентификатор()), ""));
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция Сохранить(УчетнаяЗапись, Тело, Корреляция) Экспорт
    ПроверитьПоля(Тело, "workspaceId,id,expectedRevision,kind,key,title,body,details,validFrom,validTo,commandId");
    Пространство = СтроковоеПоле(Тело, "workspaceId", 36); Ид = СтроковоеПоле(Тело, "id", 36, Истина);
    Ключ = СтроковоеПоле(Тело, "key", 64); ПроверитьКлюч(Ключ);
    Вид = СтроковоеПоле(Тело, "kind", 16); ПроверитьВид(Вид);
    Заголовок = СтроковоеПоле(Тело, "title", 200); Текст = СтроковоеПоле(Тело, "body", 8000);
    Начало = ДатаИзСтроки(СтроковоеПоле(Тело, "validFrom", 20));
    До = СтроковоеПоле(Тело, "validTo", 20, Истина); Конец = ?(До = "", Дата(1, 1, 1), ДатаИзСтроки(До));
    Если ЗначениеЗаполнено(Конец) И Конец <= Начало Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
    Детали = ПроверитьДетали(Вид, Тело.details); Команда = Строка(UUID(СтроковоеПоле(Тело, "commandId", 36)));
    ПроверитьРевизию(Тело.expectedRevision, Ид = "");
    Если Ид <> "" Тогда Ид = Строка(UUID(Ид)); КонецЕсли;
    Намерение = ОграниченныйJSON(Тело); Операция = ?(Ид = "", "create", "save");
    Если ТранзакцияАктивна() Тогда ВызватьИсключение "публичный_кабинет_транзакция_конфликт"; КонецЕсли;
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        Область = НачатьРедактирование(УчетнаяЗапись, Пространство);
        Если Ид <> "" Тогда Объект = СвойОбъект(Ид, Область); КонецЕсли;
        Результат = ПовторКоманды(УчетнаяЗапись, Область, Команда, Операция, Ид, Намерение);
        Если Результат <> Неопределено Тогда ЗафиксироватьТранзакцию(); Возврат Результат; КонецЕсли;
        ПроверитьКвотуКоманд(Область);
        Если Ид = "" Тогда
            Повтор = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ПубликацииПортала ГДЕ РабочееПространство = &Область И Автор = &Автор И КлючКоманды = &Команда");
            Повтор.УстановитьПараметр("Область", Область); Повтор.УстановитьПараметр("Автор", УчетнаяЗапись); Повтор.УстановитьПараметр("Команда", Команда);
            Строки = Повтор.Выполнить().Выбрать();
            Если Строки.Следующий() Тогда
                ВызватьИсключение "публичный_кабинет_команда_конфликт";
            КонецЕсли;
            Если Тело.expectedRevision <> 0 Тогда ВызватьИсключение "публичный_кабинет_редакция_конфликт"; КонецЕсли;
            Квота = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Справочник.ПубликацииПортала ГДЕ РабочееПространство = &Область");
            Квота.УстановитьПараметр("Область", Область); Счетчик = Квота.Выполнить().Выбрать(); Счетчик.Следующий();
            Если Счетчик.Количество >= 2000 Тогда ВызватьИсключение "публичный_кабинет_квота"; КонецЕсли;
            Последняя = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка, Версия, Состояние ИЗ Справочник.ПубликацииПортала ГДЕ РабочееПространство = &Область И КлючПубликации = &Ключ И Вид = &Вид И НЕ ПометкаУдаления УПОРЯДОЧИТЬ ПО Версия УБЫВ");
            Последняя.УстановитьПараметр("Область", Область); Последняя.УстановитьПараметр("Ключ", Ключ); Последняя.УстановитьПараметр("Вид", Вид);
            Версии = Последняя.Выполнить().Выбрать(); Версия = 1; Предыдущая = Справочники.ПубликацииПортала.ПустаяСсылка();
            Если Версии.Следующий() Тогда
                Если Версии.Состояние = "Draft" Тогда ВызватьИсключение "публичный_кабинет_черновик_существует"; КонецЕсли;
                Версия = Версии.Версия + 1; Предыдущая = Версии.Ссылка;
            КонецЕсли;
            Если Версия > 999999 Тогда ВызватьИсключение "публичный_кабинет_версия_лимит"; КонецЕсли;
            Объект = Справочники.ПубликацииПортала.СоздатьЭлемент();
            Объект.SetNewObjectRef(Справочники.ПубликацииПортала.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
            Объект.РабочееПространство = Область; Объект.Автор = УчетнаяЗапись; Объект.Версия = Версия;
            Объект.КлючПубликации = Ключ; Объект.Вид = Вид; Объект.Состояние = "Draft"; Объект.Ревизия = 0;
            Объект.ДатаСоздания = ТекущаяУниверсальнаяДата(); Объект.ПредыдущаяВерсия = Предыдущая;
            Объект.КлючКоманды = Команда; Объект.КомандаJSON = Намерение;
        Иначе
            Если Объект.Ревизия <> Тело.expectedRevision Тогда ВызватьИсключение "публичный_кабинет_редакция_конфликт"; КонецЕсли;
            Если Объект.Состояние <> "Draft" Тогда ВызватьИсключение "публичный_кабинет_нельзя_изменять"; КонецЕсли;
            Если Объект.КлючПубликации <> Ключ Или Объект.Вид <> Вид Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
        КонецЕсли;
        Объект.Наименование = Лев(Заголовок, 100); Объект.Заголовок = Заголовок; Объект.Текст = Текст;
        Объект.ДанныеJSON = СтрокаJSON(Детали); Объект.ДействуетС = Начало; Объект.ДействуетПо = Конец;
        Объект.ДляЖителя = Ложь; Объект.ДляОрганизации = Ложь;
        Если Вид = "service" Тогда
            Объект.ДляЖителя = Детали.applicants.Найти("resident") <> Неопределено;
            Объект.ДляОрганизации = Детали.applicants.Найти("organization") <> Неопределено;
        КонецЕсли;
        Объект.Редактор = УчетнаяЗапись; Объект.ДатаИзменения = ТекущаяУниверсальнаяДата(); Объект.Ревизия = Объект.Ревизия + 1;
        Объект.Записать(); Аудит(УчетнаяЗапись, Объект, "public.editor.save", Корреляция);
        Результат = ПубликацияDTO(Объект, Истина);
        ЗаписатьКоманду(УчетнаяЗапись, Область, Команда, Операция, Ид, Намерение, Объект.Ссылка, Результат);
        ЗафиксироватьТранзакцию(); Возврат Результат;
    Исключение
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли; ВызватьИсключение;
    КонецПопытки;
КонецФункции

Функция ИзменитьСостояние(УчетнаяЗапись, Ид, Тело, Публиковать, Корреляция) Экспорт
    ПроверитьПоля(Тело, "workspaceId,expectedRevision,commandId");
    Команда = Строка(UUID(СтроковоеПоле(Тело, "commandId", 36))); Ид = Строка(UUID(Ид));
    ПроверитьРевизию(Тело.expectedRevision); Намерение = ОграниченныйJSON(Тело);
    Операция = ?(Публиковать, "publish", "archive");
    Если ТранзакцияАктивна() Тогда ВызватьИсключение "публичный_кабинет_транзакция_конфликт"; КонецЕсли;
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        Область = НачатьРедактирование(УчетнаяЗапись, СтроковоеПоле(Тело, "workspaceId", 36));
        Объект = СвойОбъект(Ид, Область);
        Результат = ПовторКоманды(УчетнаяЗапись, Область, Команда, Операция, Ид, Намерение);
        Если Результат <> Неопределено Тогда ЗафиксироватьТранзакцию(); Возврат Результат; КонецЕсли;
        Если Объект.Ревизия <> Тело.expectedRevision Тогда ВызватьИсключение "публичный_кабинет_редакция_конфликт"; КонецЕсли;
        ПроверитьКвотуКоманд(Область);
        Если Публиковать Тогда
            Если Объект.Состояние <> "Draft" Тогда ВызватьИсключение "публичный_кабинет_нельзя_изменять"; КонецЕсли;
            Если Объект.ДействуетС > ТекущаяУниверсальнаяДата() Тогда
                ВызватьИсключение "публичный_кабинет_некорректно_ввод";
            КонецЕсли;
            ПроверитьДетали(Объект.Вид, ДанныеИзJSON(Объект.ДанныеJSON));
            Если ЗначениеЗаполнено(Объект.ПредыдущаяВерсия) Тогда
                Предыдущая = Объект.ПредыдущаяВерсия.ПолучитьОбъект();
                Если Предыдущая.РабочееПространство <> Область Или Предыдущая.КлючПубликации <> Объект.КлючПубликации Тогда ВызватьИсключение "публичный_кабинет_не_найдено"; КонецЕсли;
                Если Предыдущая.Состояние = "Published" Тогда
                    Предыдущая.Состояние = "Archived"; Предыдущая.Редактор = УчетнаяЗапись;
                    Предыдущая.Ревизия = Предыдущая.Ревизия + 1; Предыдущая.ДатаИзменения = ТекущаяУниверсальнаяДата(); Предыдущая.Записать();
                    Аудит(УчетнаяЗапись, Предыдущая, "public.editor.supersede", Корреляция);
                КонецЕсли;
            КонецЕсли;
            Объект.Состояние = "Published"; Объект.ДатаПубликации = ТекущаяУниверсальнаяДата();
        Иначе
            Если Объект.Состояние <> "Published" Тогда ВызватьИсключение "публичный_кабинет_нельзя_изменять"; КонецЕсли;
            Объект.Состояние = "Archived";
        КонецЕсли;
        Объект.Редактор = УчетнаяЗапись; Объект.ДатаИзменения = ТекущаяУниверсальнаяДата(); Объект.Ревизия = Объект.Ревизия + 1; Объект.Записать();
        Аудит(УчетнаяЗапись, Объект, ?(Публиковать, "public.editor.publish", "public.editor.archive"), Корреляция);
        Результат = ПубликацияDTO(Объект, Истина);
        ЗаписатьКоманду(УчетнаяЗапись, Область, Команда, Операция, Ид, Намерение, Объект.Ссылка, Результат);
        ЗафиксироватьТранзакцию(); Возврат Результат;
    Исключение
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли; ВызватьИсключение;
    КонецПопытки;
КонецФункции

Функция НачатьРедактирование(УчетнаяЗапись, Пространство)
    БлокировкаАктора = Новый БлокировкаДанных; ЭлементАктора = БлокировкаАктора.Добавить("Справочник.УчетныеЗаписи");
    ЭлементАктора.Режим = РежимБлокировкиДанных.Исключительный; ЭлементАктора.УстановитьЗначение("Ссылка", УчетнаяЗапись); БлокировкаАктора.Заблокировать();
    Область = ПолитикаДоступа.ПроверитьДоступКРабочемуПространству(УчетнаяЗапись, Пространство, "WorkspaceOwner");
    Блокировка = Новый БлокировкаДанных; Элемент = Блокировка.Добавить("Справочник.РабочиеПространства");
    Элемент.Режим = РежимБлокировкиДанных.Исключительный; Элемент.УстановитьЗначение("Ссылка", Область); Блокировка.Заблокировать();
    Возврат ПолитикаДоступа.ПроверитьДоступКРабочемуПространству(УчетнаяЗапись, Пространство, "WorkspaceOwner");
КонецФункции

Функция СвойОбъект(Ид, Область)
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ПубликацииПортала ГДЕ Ссылка = &Ссылка И РабочееПространство = &Область И НЕ ПометкаУдаления");
    Запрос.УстановитьПараметр("Ссылка", Ссылка(Ид)); Запрос.УстановитьПараметр("Область", Область); Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Тогда ВызватьИсключение "публичный_кабинет_не_найдено"; КонецЕсли;
    Возврат Выборка.Ссылка.ПолучитьОбъект();
КонецФункции

Функция ПовторКоманды(УчетнаяЗапись, Область, Команда, Операция, Ид, Намерение)
    Запись = РегистрыСведений.КомандыПубликацийПортала.СоздатьМенеджерЗаписи();
    Запись.УчетнаяЗапись = УчетнаяЗапись; Запись.ИдентификаторЗапроса = Команда; Запись.Прочитать();
    Если Не Запись.Выбран() Тогда Возврат Неопределено; КонецЕсли;
    Если Запись.РабочееПространство <> Область Или Запись.Операция <> Операция
        Или Запись.ЦельЗапроса <> Ид Или Запись.НамерениеJSON <> Намерение Тогда
        ВызватьИсключение "публичный_кабинет_команда_конфликт";
    КонецЕсли;
    ТекущийОбъект = СвойОбъект(Строка(Запись.Публикация.УникальныйИдентификатор()), Область);
    Возврат ДанныеИзJSON(Запись.РезультатJSON);
КонецФункции

Процедура ЗаписатьКоманду(УчетнаяЗапись, Область, Команда, Операция, Ид, Намерение, Публикация, Результат)
    Если Не ТранзакцияАктивна() Тогда ВызватьИсключение "публичный_кабинет_транзакция_конфликт"; КонецЕсли;
    Запись = РегистрыСведений.КомандыПубликацийПортала.СоздатьМенеджерЗаписи();
    Запись.УчетнаяЗапись = УчетнаяЗапись; Запись.ИдентификаторЗапроса = Команда; Запись.Прочитать();
    Если Запись.Выбран() Тогда ВызватьИсключение "публичный_кабинет_команда_конфликт"; КонецЕсли;
    Запись.УчетнаяЗапись = УчетнаяЗапись; Запись.ИдентификаторЗапроса = Команда;
    Запись.РабочееПространство = Область; Запись.Публикация = Публикация; Запись.Операция = Операция;
    Запись.ЦельЗапроса = Ид; Запись.НамерениеJSON = Намерение; Запись.РезультатJSON = ОграниченныйJSON(Результат);
    Запись.Момент = ТекущаяУниверсальнаяДата(); Запись.Записать();
КонецПроцедуры

Процедура ПроверитьКвотуКоманд(Область)
    Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ РегистрСведений.КомандыПубликацийПортала ГДЕ РабочееПространство = &Область");
    Запрос.УстановитьПараметр("Область", Область); Выборка = Запрос.Выполнить().Выбрать(); Выборка.Следующий();
    Если Выборка.Количество >= 10000 Тогда ВызватьИсключение "публичный_кабинет_квота"; КонецЕсли;
КонецПроцедуры

Функция ОграниченныйJSON(Значение)
    Результат = СтрокаJSON(Значение);
    Если СтрДлина(Результат) > 20000 Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
    Возврат Результат;
КонецФункции

Процедура ПроверитьРевизию(Ревизия, Создание = Ложь)
    Если ТипЗнч(Ревизия) <> Тип("Число") Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
    Если Ревизия < ?(Создание, 0, 1) Или Ревизия > 9999999998 Или Цел(Ревизия) <> Ревизия Тогда
        ВызватьИсключение "публичный_кабинет_некорректно_ввод";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьКлючЗаголовка(Запрос, Тело)
    Если ТипЗнч(Тело) <> Тип("Структура") Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
    Команда = СтроковоеПоле(Тело, "commandId", 36); UUID(Команда);
    Если APIКабинета.ЗаголовокЗапроса(Запрос, "Idempotency-Key") <> Команда Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
КонецПроцедуры

Процедура Аудит(УчетнаяЗапись, Объект, Действие, Корреляция)
    ПолитикаДоступа.ЗаписатьСобытиеАудита(УчетнаяЗапись, Объект.РабочееПространство, Действие, Строка(Объект.Ссылка.УникальныйИдентификатор()), "success", Корреляция);
КонецПроцедуры

Функция ПроверитьДетали(Вид, Значение)
    Если Вид = "service" Тогда
        ПроверитьПоля(Значение, "applicants,documents,price,priceUnit,execution,flow,category");
        Если ТипЗнч(Значение.applicants) <> Тип("Массив") Или Значение.applicants.Количество() < 1 Или Значение.applicants.Количество() > 2 Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
        Для Каждого Категория Из Значение.applicants Цикл
            Если Категория <> "resident" И Категория <> "organization" Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
        КонецЦикла;
        Если Значение.applicants.Количество() = 2 И Значение.applicants[0] = Значение.applicants[1] Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
        Если ТипЗнч(Значение.documents) <> Тип("Массив") Или Значение.documents.Количество() > 12 Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
        Для Каждого Документ Из Значение.documents Цикл ПроверитьТекст(Документ, 250); КонецЦикла;
        Сумма(СтроковоеПоле(Значение, "price", 16)); СтроковоеПоле(Значение, "priceUnit", 60);
        Если Значение.execution <> "portal" И Значение.execution <> "local" Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
        Если СтрРазделить("lab,meter,request,water,hazard", ",").Найти(Значение.flow) = Неопределено Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
        Если СтрРазделить("water,meter,lab,report", ",").Найти(Значение.category) = Неопределено Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
    ИначеЕсли Вид = "tariff" Тогда
        ПроверитьПоля(Значение, "amount,unit"); Сумма(СтроковоеПоле(Значение, "amount", 16)); СтроковоеПоле(Значение, "unit", 60);
    Иначе ПроверитьПоля(Значение, ""); КонецЕсли;
    Возврат Значение;
КонецФункции

Процедура Сумма(Значение)
    Если Значение = "" Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
    Части = СтрРазделить(Значение, ".", Истина);
    Если Части.Количество() > 2 Или СтрДлина(Части[0]) > 8 Или Части[0] = "" Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
    Если СтрДлина(Части[0]) > 1 И Лев(Части[0], 1) = "0" Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
    Если Части.Количество() = 2 Тогда
        Если СтрДлина(Части[1]) > 2 Или Части[1] = "" Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
    КонецЕсли;
    Для Каждого Часть Из Части Цикл
        Для Н = 1 По СтрДлина(Часть) Цикл
            Если СтрНайти("0123456789", Сред(Часть, Н, 1)) = 0 Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
        КонецЦикла;
    КонецЦикла;
КонецПроцедуры

Процедура ПроверитьВид(Вид, ПустойДопустим = Ложь)
    Если ПустойДопустим И Вид = "" Тогда Возврат; КонецЕсли;
    Если СтрРазделить("announcement,tariff,rules,faq,service", ",").Найти(Вид) = Неопределено Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
КонецПроцедуры

Процедура ПроверитьКлюч(Ключ)
    Для Н = 1 По СтрДлина(Ключ) Цикл
        Если СтрНайти("abcdefghijklmnopqrstuvwxyz0123456789-_", Сред(Ключ, Н, 1)) = 0 Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура ПроверитьПоля(Тело, Допустимые)
    Если ТипЗнч(Тело) <> Тип("Структура") Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
    Имена = СтрРазделить(Допустимые, ",", Ложь);
    Если Тело.Количество() <> Имена.Количество() Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
    Для Каждого Пара Из Тело Цикл Если Имена.Найти(Пара.Ключ) = Неопределено Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли; КонецЦикла;
КонецПроцедуры

Функция СтроковоеПоле(Тело, Имя, Максимум, Пустое = Ложь)
    Значение = Неопределено;
    Если Не Тело.Свойство(Имя, Значение) Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
    ПроверитьТекст(Значение, Максимум, Пустое); Возврат Значение;
КонецФункции

Процедура ПроверитьТекст(Значение, Максимум, Пустое = Ложь)
    Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) > Максимум Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
    Если Не Пустое И ПустаяСтрока(Значение) Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
    Если СтрНайти(Значение, Символ(0)) > 0 Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
КонецПроцедуры

Функция ШаблонПоиска(Поиск)
    ПроверитьТекст(Поиск, 100, Истина);
    Возврат СтрЗаменить(СтрЗаменить(СтрЗаменить(Поиск, "[", "[[]"), "%", "[%]"), "_", "[_]");
КонецФункции

Функция ЛимитСтраницы(Значение)
    Если Значение = "" Тогда Возврат 25; КонецЕсли;
    Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) > 3 Или Лев(Значение, 1) = "0" Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
    Для Н = 1 По СтрДлина(Значение) Цикл Если СтрНайти("0123456789", Сред(Значение, Н, 1)) = 0 Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли; КонецЦикла;
    ЧислоЛимита = Число(Значение); Если ЧислоЛимита < 1 Или ЧислоЛимита > 100 Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли; Возврат ЧислоЛимита;
КонецФункции

Функция UUID(Ид)
    Если ТипЗнч(Ид) <> Тип("Строка") Или СтрДлина(Ид) <> 36 Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
    Попытка Результат = Новый УникальныйИдентификатор(Ид); Исключение ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецПопытки;
    Если НРег(Строка(Результат)) <> НРег(Ид) Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли; Возврат Результат;
КонецФункции

Функция Ссылка(Ид, Пустая = Ложь)
    Если Пустая И Ид = "" Тогда Возврат Справочники.ПубликацииПортала.ПустаяСсылка(); КонецЕсли;
    Возврат Справочники.ПубликацииПортала.ПолучитьСсылку(UUID(Ид));
КонецФункции

Функция ДатаИзСтроки(Значение)
    Если СтрДлина(Значение) <> 20 Или Прав(Значение, 1) <> "Z" Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли;
    Попытка Момент = XMLЗначение(Тип("Дата"), Лев(Значение, 19)); Исключение ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецПопытки;
    Если XMLСтрока(Момент) + "Z" <> Значение Или Момент < Дата(2000, 1, 1) Тогда ВызватьИсключение "публичный_кабинет_некорректно_ввод"; КонецЕсли; Возврат Момент;
КонецФункции

Функция ДатаСтрокой(Значение)
    Возврат ?(ЗначениеЗаполнено(Значение), XMLСтрока(Значение) + "Z", "");
КонецФункции

Функция СтрокаJSON(Значение)
    Запись = Новый ЗаписьJSON; Запись.УстановитьСтроку(); ЗаписатьJSON(Запись, Значение); Возврат Запись.Закрыть();
КонецФункции

Функция ДанныеИзJSON(Значение)
    Чтение = Новый ЧтениеJSON; Чтение.УстановитьСтроку(Значение); Возврат ПрочитатьJSON(Чтение);
КонецФункции
