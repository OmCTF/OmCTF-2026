Функция Создать(Актор, Данные, Корреляция = "") Экспорт
    ПроверитьАктор(Актор); ПроверитьСхему(Данные, "workspaceId,recipientId,expiresIn,requestId");
    Пространство = Справочники.РабочиеПространства.ПолучитьСсылку(Ид(Данные.workspaceId));
    Получатель = Справочники.УчетныеЗаписи.ПолучитьСсылку(Ид(Данные.recipientId));
    ЗапросИд = Строка(Ид(Данные.requestId));
    Если Получатель = Актор Тогда ВызватьИсключение "владение_некорректно_ввод"; КонецЕсли;
    Если ТипЗнч(Данные.expiresIn) <> Тип("Число") Тогда ВызватьИсключение "владение_некорректно_ввод"; КонецЕсли;
    Если Данные.expiresIn < 300 Или Данные.expiresIn > 86400 Или Окр(Данные.expiresIn, 0) <> Данные.expiresIn Тогда ВызватьИсключение "владение_некорректно_ввод"; КонецЕсли;
    НачатьИзменение(Актор, Получатель, Пространство);
    Попытка
        ПроверитьАктор(Актор); ПроверитьАктивного(Получатель);
        ПолитикаДоступа.ПроверитьДоступКРабочемуПространству(Актор, Данные.workspaceId, "WorkspaceOwner");
        Привязка = РегистрыСведений.ПривязкиПередачВладения.СоздатьМенеджерЗаписи();
        Привязка.Отправитель = Актор; Привязка.ИдентификаторЗапроса = ЗапросИд; Привязка.Прочитать();
        Если Привязка.Выбран() Тогда
            Объект = Привязка.Передача.ПолучитьОбъект();
            Если Объект = Неопределено Тогда ВызватьИсключение "владение_привязка_конфликт"; КонецЕсли;
            Если Объект.ПометкаУдаления Или Объект.РабочееПространство <> Пространство Или Объект.Получатель <> Получатель
                Или Объект.Отправитель <> Актор Или Объект.ИдентификаторЗапроса <> ЗапросИд Или Объект.СрокДействия <> Данные.expiresIn Тогда
                ВызватьИсключение "владение_запрос_конфликт";
            КонецЕсли;
        Иначе
            Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ПередачиВладенияПространством
                |ГДЕ РабочееПространство = &Пространство И Состояние = &Pending И Истекает > &Сейчас И НЕ ПометкаУдаления");
            Запрос.УстановитьПараметр("Пространство", Пространство); Запрос.УстановитьПараметр("Pending", "Pending"); Запрос.УстановитьПараметр("Сейчас", ТекущаяУниверсальнаяДата());
            Если Не Запрос.Выполнить().Пустой() Тогда ВызватьИсключение "владение_ожидание_конфликт"; КонецЕсли;
            Объект = Справочники.ПередачиВладенияПространством.СоздатьЭлемент();
            Объект.SetNewObjectRef(Справочники.ПередачиВладенияПространством.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4())); Объект.Наименование = "Передача управления";
            Объект.РабочееПространство = Пространство; Объект.Отправитель = Актор; Объект.Получатель = Получатель;
            Объект.НазваниеОбласти = Пространство.Наименование;
            Объект.Состояние = "Pending"; Объект.Ревизия = 1; Объект.Создано = ТекущаяУниверсальнаяДата();
            Объект.Истекает = Объект.Создано + Данные.expiresIn; Объект.СрокДействия = Данные.expiresIn;
            Объект.ИдентификаторЗапроса = ЗапросИд; Объект.Записать();
            Привязка.Отправитель = Актор; Привязка.ИдентификаторЗапроса = ЗапросИд; Привязка.Передача = Объект.Ссылка; Привязка.Записать();
            ПолитикаДоступа.ЗаписатьСобытиеАудита(Актор, Пространство, "workspace.owner.offer", Строка(Объект.Ссылка.УникальныйИдентификатор()), "success", Корреляция);
        КонецЕсли;
        Результат = ДТО(Объект); ЗафиксироватьТранзакцию();
    Исключение Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли; ВызватьИсключение; КонецПопытки;
    Возврат Результат;
КонецФункции

Функция Решить(Актор, Идентификатор, Действие, Данные, Корреляция = "") Экспорт
    ПроверитьАктор(Актор); ПроверитьСхему(Данные, "expectedVersion");
    Если СтрРазделить("accept,decline,revoke", ",").Найти(Действие) = Неопределено Тогда ВызватьИсключение "владение_некорректно_ввод"; КонецЕсли;
    Если ТипЗнч(Данные.expectedVersion) <> Тип("Число") Тогда ВызватьИсключение "владение_некорректно_ввод"; КонецЕсли;
    Если Данные.expectedVersion < 1 Или Окр(Данные.expectedVersion, 0) <> Данные.expectedVersion Тогда ВызватьИсключение "владение_некорректно_ввод"; КонецЕсли;
    Ссылка = Справочники.ПередачиВладенияПространством.ПолучитьСсылку(Ид(Идентификатор)); Объект = Ссылка.ПолучитьОбъект();
    ПроверитьУчастника(Актор, Объект, Действие);
    Отправитель = Объект.Отправитель; Получатель = Объект.Получатель; Пространство = Объект.РабочееПространство;
    НачатьИзменение(Отправитель, Получатель, Пространство); Сбой = "";
    Попытка
        ПроверитьАктор(Актор); Объект = Ссылка.ПолучитьОбъект(); ПроверитьУчастника(Актор, Объект, Действие);
        Если Объект.Отправитель <> Отправитель Или Объект.Получатель <> Получатель Или Объект.РабочееПространство <> Пространство Тогда ВызватьИсключение "владение_привязка_конфликт"; КонецЕсли;
        Состояние = "Accepted"; Если Действие = "decline" Тогда Состояние = "Declined"; ИначеЕсли Действие = "revoke" Тогда Состояние = "Revoked"; КонецЕсли;
        Если Объект.Состояние = Состояние И Объект.ПредыдущаяРевизия = Данные.expectedVersion Тогда
        Иначе
            Если Объект.Ревизия <> Данные.expectedVersion Тогда ВызватьИсключение "владение_версия_конфликт"; КонецЕсли;
            Если Объект.Состояние <> "Pending" Тогда ВызватьИсключение "владение_состояние_конфликт"; КонецЕсли;
            Если Объект.Истекает <= ТекущаяУниверсальнаяДата() Тогда
                Состояние = "Expired"; Сбой = "владение_истекло";
            ИначеЕсли Действие = "accept" Тогда
                ПроверитьАктивного(Отправитель); ПроверитьАктивного(Получатель);
                ПередатьАтомарно(Объект);
            КонецЕсли;
            Объект.ПредыдущаяРевизия = Объект.Ревизия; Объект.Ревизия = Объект.Ревизия + 1;
            Объект.Состояние = Состояние; Объект.РешениеПринято = ТекущаяУниверсальнаяДата(); Объект.Записать();
            АудитДействие = Действие; Если Состояние = "Expired" Тогда АудитДействие = "expire"; КонецЕсли;
            ПолитикаДоступа.ЗаписатьСобытиеАудита(Актор, Пространство, "workspace.owner." + АудитДействие,
                Строка(Ссылка.УникальныйИдентификатор()), "success", Корреляция);
        КонецЕсли;
        Результат = ДТО(Объект); ЗафиксироватьТранзакцию();
    Исключение Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли; ВызватьИсключение; КонецПопытки;
    Если Сбой <> "" Тогда ВызватьИсключение Сбой; КонецЕсли;
    Возврат Результат;
КонецФункции

Функция Список(Актор, Лимит = 25, Курсор = "") Экспорт
    ПроверитьАктор(Актор);
    Если ТипЗнч(Лимит) <> Тип("Число") Тогда ВызватьИсключение "владение_некорректно_ввод"; КонецЕсли;
    Если Лимит < 1 Или Лимит > 100 Или Окр(Лимит, 0) <> Лимит Тогда ВызватьИсключение "владение_некорректно_ввод"; КонецЕсли;
    После = Справочники.ПередачиВладенияПространством.ПустаяСсылка();
    Если Курсор <> "" Тогда После = Справочники.ПередачиВладенияПространством.ПолучитьСсылку(Ид(Курсор)); КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит + 1, "ЧГ=0;ЧДЦ=0") + " Ссылка, РабочееПространство, НазваниеОбласти, Отправитель, Получатель, Состояние, Ревизия, Создано, Истекает, РешениеПринято
        |ИЗ Справочник.ПередачиВладенияПространством ГДЕ (Отправитель = &Актор ИЛИ Получатель = &Актор) И НЕ ПометкаУдаления И Ссылка > &После
        |УПОРЯДОЧИТЬ ПО Ссылка");
    Запрос.УстановитьПараметр("Актор", Актор); Запрос.УстановитьПараметр("После", После);
    Выборка = Запрос.Выполнить().Выбрать(); Элементы = Новый Массив; ЕстьЕще = Ложь;
    Пока Выборка.Следующий() Цикл
        Если Элементы.Количество() = Лимит Тогда ЕстьЕще = Истина; Прервать; КонецЕсли;
        Элементы.Добавить(ДТО(Выборка));
    КонецЦикла;
    Следующий = ""; Если ЕстьЕще Тогда Следующий = Элементы[Элементы.Количество() - 1].id; КонецЕсли;
    Возврат Новый Структура("items,limit,hasMore,nextCursor", Элементы, Лимит, ЕстьЕще, Следующий);
КонецФункции

Процедура ПередатьАтомарно(Передача)
    Пространство = Передача.РабочееПространство.ПолучитьОбъект();
    Если Пространство = Неопределено Тогда ВызватьИсключение "владение_не_найдено"; КонецЕсли;
    Если Пространство.ПометкаУдаления Или Пространство.Состояние <> "Active" Или Пространство.УчетнаяЗаписьВладельца <> Передача.Отправитель Тогда
        ВызватьИсключение "владение_состояние_конфликт";
    КонецЕсли;
    СтараяПривязка = ПривязкаРоли(Передача.РабочееПространство, Передача.Отправитель, "WorkspaceOwner");
    Если Не СтараяПривязка.Выбран() Тогда ВызватьИсключение "владение_привязка_конфликт"; КонецЕсли;
    СтароеУчастие = СтараяПривязка.Участие.ПолучитьОбъект();
    ПроверитьУчастие(СтароеУчастие, Передача.РабочееПространство, Передача.Отправитель, "WorkspaceOwner");
    Если СтароеУчастие.Состояние <> "Active" Или (СтароеУчастие.СрокИстечения <> Дата(1, 1, 1) И СтароеУчастие.СрокИстечения <= ТекущаяУниверсальнаяДата()) Тогда ВызватьИсключение "владение_состояние_конфликт"; КонецЕсли;
    Если СтароеУчастие.Ревизия >= 999999999999998 Тогда ВызватьИсключение "владение_состояние_конфликт"; КонецЕсли;
    АктивироватьФиксированнуюРоль(Передача.РабочееПространство, Передача.Получатель, "WorkspaceOwner");
    АктивироватьФиксированнуюРоль(Передача.РабочееПространство, Передача.Получатель, "Resident");
    СтароеУчастие.Состояние = "Inactive"; СтароеУчастие.Ревизия = СтароеУчастие.Ревизия + 1;
    СтароеУчастие.КемОтключено = Передача.Получатель; СтароеУчастие.РевизияДоОтключения = 0; СтароеУчастие.Записать();
    Пространство.УчетнаяЗаписьВладельца = Передача.Получатель;
    Если Пространство.Профиль = "AD" Тогда Пространство.Профиль = "Shared"; КонецЕсли;
    Пространство.Записать();
КонецПроцедуры

Процедура АктивироватьФиксированнуюРоль(Пространство, УчетнаяЗапись, Роль)
    Если Роль <> "WorkspaceOwner" И Роль <> "Resident" Тогда ВызватьИсключение "владение_некорректно_ввод"; КонецЕсли;
    Привязка = ПривязкаРоли(Пространство, УчетнаяЗапись, Роль);
    Если Привязка.Выбран() Тогда
        Участие = Привязка.Участие.ПолучитьОбъект(); ПроверитьУчастие(Участие, Пространство, УчетнаяЗапись, Роль);
        Если Роль = "Resident" И Участие.Состояние = "Active" И (Участие.СрокИстечения = Дата(1, 1, 1) Или Участие.СрокИстечения > ТекущаяУниверсальнаяДата()) Тогда Возврат; КонецЕсли;
        Если Роль = "WorkspaceOwner" И Участие.Состояние = "Active" Тогда ВызватьИсключение "владение_привязка_конфликт"; КонецЕсли;
    Иначе
        Участие = Справочники.Участия.СоздатьЭлемент();
        Участие.SetNewObjectRef(Справочники.Участия.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4())); Участие.Наименование = Роль;
        Участие.РабочееПространство = Пространство; Участие.УчетнаяЗапись = УчетнаяЗапись; Участие.Роль = Роль;
        Участие.Область = Справочники.Области.ПустаяСсылка(); Участие.Ревизия = 0;
    КонецЕсли;
    Если Участие.Ревизия >= 999999999999998 Тогда ВызватьИсключение "владение_состояние_конфликт"; КонецЕсли;
    Участие.ОхватОбластей = "All"; Участие.Состояние = "Active"; Участие.СрокИстечения = Дата(1, 1, 1);
    Участие.ИсточникПолномочия = Справочники.ПриглашенияВПространства.ПустаяСсылка();
    Участие.КемОтключено = Справочники.УчетныеЗаписи.ПустаяСсылка(); Участие.РевизияДоОтключения = 0;
    Участие.Ревизия = Участие.Ревизия + 1; Участие.Записать();
    Привязка.РабочееПространство = Пространство; Привязка.УчетнаяЗапись = УчетнаяЗапись; Привязка.Роль = Роль;
    Привязка.Область = Справочники.Области.ПустаяСсылка(); Привязка.Участие = Участие.Ссылка; Привязка.Записать();
КонецПроцедуры

Функция ПривязкаРоли(Пространство, УчетнаяЗапись, Роль)
    Блокировка = Новый БлокировкаДанных; Элемент = Блокировка.Добавить("РегистрСведений.ПривязкиУчастий");
    Элемент.УстановитьЗначение("РабочееПространство", Пространство); Элемент.УстановитьЗначение("УчетнаяЗапись", УчетнаяЗапись);
    Элемент.УстановитьЗначение("Роль", Роль); Элемент.УстановитьЗначение("Область", Справочники.Области.ПустаяСсылка());
    Элемент.Режим = РежимБлокировкиДанных.Исключительный; Блокировка.Заблокировать();
    Запись = РегистрыСведений.ПривязкиУчастий.СоздатьМенеджерЗаписи(); Запись.РабочееПространство = Пространство;
    Запись.УчетнаяЗапись = УчетнаяЗапись; Запись.Роль = Роль; Запись.Область = Справочники.Области.ПустаяСсылка(); Запись.Прочитать(); Возврат Запись;
КонецФункции

Процедура ПроверитьУчастие(Участие, Пространство, УчетнаяЗапись, Роль)
    Если Участие = Неопределено Тогда ВызватьИсключение "владение_привязка_конфликт"; КонецЕсли;
    Если Участие.ПометкаУдаления Или Участие.РабочееПространство <> Пространство Или Участие.УчетнаяЗапись <> УчетнаяЗапись
        Или Участие.Роль <> Роль Или Участие.ОхватОбластей <> "All" Или ЗначениеЗаполнено(Участие.Область) Тогда ВызватьИсключение "владение_привязка_конфликт"; КонецЕсли;
КонецПроцедуры

Процедура НачатьИзменение(Первый, Второй, Пространство)
    Если ТранзакцияАктивна() Тогда ВызватьИсключение "владение_транзакция_активно"; КонецЕсли;
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
    УчетныеЗаписи = Новый ТаблицаЗначений; УчетныеЗаписи.Колонки.Добавить("Ссылка"); УчетныеЗаписи.Колонки.Добавить("Ключ");
    Строка1 = УчетныеЗаписи.Добавить(); Строка1.Ссылка = Первый; Строка1.Ключ = Строка(Первый.УникальныйИдентификатор());
    Если Первый <> Второй Тогда Строка2 = УчетныеЗаписи.Добавить(); Строка2.Ссылка = Второй; Строка2.Ключ = Строка(Второй.УникальныйИдентификатор()); КонецЕсли;
    УчетныеЗаписи.Сортировать("Ключ");
    Для Каждого СтрокаДанных Из УчетныеЗаписи Цикл ЗаблокироватьСсылку("Справочник.УчетныеЗаписи", СтрокаДанных.Ссылка); КонецЦикла;
    ЗаблокироватьСсылку("Справочник.РабочиеПространства", Пространство);
    Исключение
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли; ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

Процедура ЗаблокироватьСсылку(Таблица, Ссылка)
    Блокировка = Новый БлокировкаДанных; Элемент = Блокировка.Добавить(Таблица);
    Элемент.УстановитьЗначение("Ссылка", Ссылка); Элемент.Режим = РежимБлокировкиДанных.Исключительный; Блокировка.Заблокировать();
КонецПроцедуры

Процедура ПроверитьУчастника(Актор, Объект, Действие)
    Если Объект = Неопределено Тогда ВызватьИсключение "владение_не_найдено"; КонецЕсли;
    Если Объект.ПометкаУдаления Тогда ВызватьИсключение "владение_не_найдено"; КонецЕсли;
    Если (Действие = "revoke" И Объект.Отправитель <> Актор) Или (Действие <> "revoke" И Объект.Получатель <> Актор) Тогда ВызватьИсключение "владение_не_найдено"; КонецЕсли;
КонецПроцедуры

Процедура ПроверитьАктор(Актор)
    Текущий = ПолитикаДоступа.ПроверитьУчетнуюЗапись(); Если Текущий.Ссылка <> Актор Тогда ВызватьИсключение "кабинет_участник_несовпадение"; КонецЕсли;
КонецПроцедуры

Процедура ПроверитьАктивного(УчетнаяЗапись)
    Объект = УчетнаяЗапись.ПолучитьОбъект(); Если Объект = Неопределено Тогда ВызватьИсключение "владение_не_найдено"; КонецЕсли;
    Если Объект.ПометкаУдаления Или Объект.Состояние <> "Active" Тогда ВызватьИсключение "владение_не_найдено"; КонецЕсли;
КонецПроцедуры

Функция Ид(Значение)
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда ВызватьИсключение "владение_некорректно_ввод"; КонецЕсли;
    Если СтрДлина(Значение) <> 36 Тогда ВызватьИсключение "владение_некорректно_ввод"; КонецЕсли;
    Попытка Результат = Новый УникальныйИдентификатор(Значение); Исключение ВызватьИсключение "владение_некорректно_ввод"; КонецПопытки;
    Если НРег(Значение) <> НРег(Строка(Результат)) Или Значение = "00000000-0000-0000-0000-000000000000" Тогда ВызватьИсключение "владение_некорректно_ввод"; КонецЕсли;
    Возврат Результат;
КонецФункции

Процедура ПроверитьСхему(Данные, Поля)
    Если ТипЗнч(Данные) <> Тип("Структура") Тогда ВызватьИсключение "владение_некорректно_ввод"; КонецЕсли;
    Список = СтрРазделить(Поля, ","); Если Данные.Количество() <> Список.Количество() Тогда ВызватьИсключение "владение_некорректно_ввод"; КонецЕсли;
    Для Каждого Поле Из Список Цикл Если Не Данные.Свойство(Поле) Тогда ВызватьИсключение "владение_некорректно_ввод"; КонецЕсли; КонецЦикла;
КонецПроцедуры

Функция ДТО(Объект)
    Состояние = Объект.Состояние;
    Если Состояние = "Pending" И Объект.Истекает <= ТекущаяУниверсальнаяДата() Тогда Состояние = "Expired"; КонецЕсли;
    Возврат Новый Структура("id,version,state,workspaceId,workspaceName,senderId,recipientId,createdAt,expiresAt,resolvedAt", Строка(Объект.Ссылка.УникальныйИдентификатор()),
        Объект.Ревизия, Состояние, Строка(Объект.РабочееПространство.УникальныйИдентификатор()), Объект.НазваниеОбласти,
        Строка(Объект.Отправитель.УникальныйИдентификатор()), Строка(Объект.Получатель.УникальныйИдентификатор()),
        ВремяJSON(Объект.Создано), ВремяJSON(Объект.Истекает), ВремяJSON(Объект.РешениеПринято));
КонецФункции

Функция ВремяJSON(Момент)
    Если Момент = Дата(1, 1, 1) Тогда Возврат Неопределено; КонецЕсли;
    Возврат XMLСтрока(Момент) + "Z";
КонецФункции
