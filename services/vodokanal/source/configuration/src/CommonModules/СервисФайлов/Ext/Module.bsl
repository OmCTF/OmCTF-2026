
Функция ПроверитьБайтыВложения(ТелоЗапроса) Экспорт
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, "filename,mime,contentBase64");
    Вход = ПрочитатьВходныеПоля(ТелоЗапроса);
    Возврат Новый Структура("ИмяФайла,ТипMIME,Содержимое", Вход.ИмяФайла, Вход.ТипMIME, ДекодироватьСодержимое(Вход));
КонецФункции

Функция ПроверитьБайтыФотографии(ТелоЗапроса) Экспорт
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, "filename,mime,contentBase64");
    Вход = ПрочитатьВходныеПоля(ТелоЗапроса);
    Если Вход.ТипMIME <> "image/jpeg" И Вход.ТипMIME <> "image/png" Тогда
        ВызватьИсключение "кабинет_файл_некорректно_тип";
    КонецЕсли;
    Содержимое = ДекодироватьСодержимое(Вход);
    Возврат Новый Структура("ИмяФайла,ТипMIME,Содержимое", Вход.ИмяФайла, Вход.ТипMIME, Содержимое);
КонецФункции

Процедура ПроверитьОбщуюКвотуВложений(КонтекстДоступа, КоличествоБайт) Экспорт
    Если Не ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_файл_привязка_конфликт"; КонецЕсли;
    Если ТипЗнч(КоличествоБайт) <> Тип("Число") Или КоличествоБайт < 1 Или КоличествоБайт > 5242880 Тогда
        ВызватьИсключение "кабинет_файл_некорректно_размер";
    КонецЕсли;
    ЗаблокироватьОбъектПоСсылке("Справочник.Области", КонтекстДоступа.Область);
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ЕСТЬNULL(СУММА(Байты.КоличествоБайт), 0) КАК КоличествоБайт
        |ИЗ (ВЫБРАТЬ КоличествоБайт ИЗ Справочник.ВерсииФайловОбращений
        |ГДЕ РабочееПространство = &РабочееПространство И Область = &Область
        |ОБЪЕДИНИТЬ ВСЕ
        |ВЫБРАТЬ КоличествоБайт ИЗ Справочник.ФотографииНарядов
        |ГДЕ РабочееПространство = &РабочееПространство И Область = &Область
        |ОБЪЕДИНИТЬ ВСЕ
        |ВЫБРАТЬ КоличествоБайт ИЗ Справочник.ВерсииДокументовКабинета
        |ГДЕ РабочееПространство = &РабочееПространство И Область = &Область
        |ОБЪЕДИНИТЬ ВСЕ
        |ВЫБРАТЬ КоличествоБайт ИЗ Справочник.ФотографииПоказаний
        |ГДЕ РабочееПространство = &РабочееПространство И Область = &Область
        |ОБЪЕДИНИТЬ ВСЕ
        |ВЫБРАТЬ ФотоБайт КАК КоличествоБайт ИЗ РегистрСведений.КвитанцииГостевыхОбращений
        |ГДЕ Обращение.РабочееПространство = &РабочееПространство И Обращение.Область = &Область) КАК Байты");
    Запрос.УстановитьПараметр("РабочееПространство", КонтекстДоступа.РабочееПространство);
    Запрос.УстановитьПараметр("Область", КонтекстДоступа.Область);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Или Выборка.КоличествоБайт < 0 Тогда ВызватьИсключение "кабинет_файл_привязка_конфликт"; КонецЕсли;
    Если Выборка.КоличествоБайт + КоличествоБайт > 209715200 Тогда ВызватьИсключение "кабинет_файл_квота_превышено"; КонецЕсли;
КонецПроцедуры

Функция ЗагрузитьВложениеОбращения(СсылкаУчетнойЗаписи, РодительЗапросКлиентаИдентификатор, ТелоЗапроса, КомандаИдентификатор, СотрудникРежим = Ложь) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    КомандаИдентификатор = Строка(РазобратьИдентификатор(КомандаИдентификатор));
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, "visibility,filename,mime,contentBase64");
    Видимость = ЗначениеИзПеречня(ТелоЗапроса, "visibility", "Public,Internal");
    ВходныеДанные = ПрочитатьВходныеПоля(ТелоЗапроса);
    КонтекстДоступа = НачатьОперациюСРодителем(СсылкаУчетнойЗаписи, РодительЗапросКлиентаИдентификатор, СотрудникРежим, Истина, Видимость);
    Попытка
        Содержимое = ДекодироватьСодержимое(ВходныеДанные);
        Намерение = СформироватьОписаниеНамерения("file.upload", КонтекстДоступа, Справочники.ФайлыОбращений.ПустаяСсылка(), Видимость, ВходныеДанные, Содержимое, 0, "Initial attachment", СотрудникРежим);
        Команда = ОткрытьПривязкуКоманды(СсылкаУчетнойЗаписи, КомандаИдентификатор, "file.upload", КонтекстДоступа, Намерение);
        Если Команда.Выбран() Тогда
            Результат = ПовторитьСохраненныйРезультат(Команда, КонтекстДоступа, СотрудникРежим);
        Иначе
            Квоты = ПрочитатьКвоты(КонтекстДоступа);
            ПроверитьКвоту(Квоты, Содержимое.КоличествоБайт, Истина);
            ПроверитьОбщуюКвотуВложений(КонтекстДоступа, Содержимое.КоличествоБайт);
            Объект = Справочники.ФайлыОбращений.СоздатьЭлемент();
            Объект.SetNewObjectRef(Справочники.ФайлыОбращений.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
            Объект.Наименование = "Immutable incoming request attachment";
            Объект.РабочееПространство = КонтекстДоступа.РабочееПространство;
            Объект.Область = КонтекстДоступа.Область;
            Объект.РодительскоеОбращение = КонтекстДоступа.Запрос;
            Объект.Видимость = Видимость;
            Объект.ПервоначальныйЗагрузивший = СсылкаУчетнойЗаписи;
            Объект.ВидАвтора = "Requester";
            Если СотрудникРежим Тогда
                Объект.ВидАвтора = "Dispatcher";
            КонецЕсли;
            Объект.Состояние = "Active";
            Объект.КемСоздано = СсылкаУчетнойЗаписи;
            Объект.ДатаСоздания = ТекущаяУниверсальнаяДата();
            Объект.Ревизия = 1;
            Объект.Записать();
            ЗаблокироватьОбъектПоСсылке("Справочник.ФайлыОбращений", Объект.Ссылка);
            ТекущаяВерсия = СоздатьУказательТекущейВерсии(Объект.Ссылка, КонтекстДоступа);
            ВерсияФайла = ЗаписатьВерсиюФайла(Объект, КонтекстДоступа, ВходныеДанные, Содержимое, 1, Справочники.ВерсииФайловОбращений.ПустаяСсылка(), "Initial attachment", СсылкаУчетнойЗаписи);
            ЗаписатьУказательТекущейВерсии(ТекущаяВерсия, Объект, ВерсияФайла);
            ПрогретьТекстовыйПредпросмотр(КонтекстДоступа, Объект, ВерсияФайла, Содержимое.Данные);
            УчестьРасходКвоты(Квоты, Содержимое.КоличествоБайт, Истина);
            Результат = МетаданныеФайла(Объект, ВерсияФайла, СотрудникРежим);
            СохранитьПривязкуКоманды(Команда, Объект, ВерсияФайла, Результат);
            ПолитикаДоступа.ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, КонтекстДоступа.РабочееПространство, "files.upload", Строка(Объект.Ссылка.УникальныйИдентификатор()));
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ЗаменитьВложениеОбращения(СсылкаУчетнойЗаписи, ФайлИдентификатор, ТелоЗапроса, КомандаИдентификатор, СотрудникРежим = Ложь) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    КомандаИдентификатор = Строка(РазобратьИдентификатор(КомандаИдентификатор));
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, "expectedVersion,filename,mime,contentBase64,reason");
    Версия = ПолеВерсии(ТелоЗапроса, "expectedVersion");
    Причина = ТекстовоеПоле(ТелоЗапроса, "reason", 250);
    ВходныеДанные = ПрочитатьВходныеПоля(ТелоЗапроса);
    КонтекстДоступа = НачатьОперациюСФайлом(СсылкаУчетнойЗаписи, ФайлИдентификатор, СотрудникРежим, Истина);
    Попытка
        Объект = КонтекстДоступа.Файл;
        Если Объект.ПервоначальныйЗагрузивший <> СсылкаУчетнойЗаписи Тогда
            ВызватьИсключение "кабинет_файл_загрузивший_требуется";
        КонецЕсли;
        Содержимое = ДекодироватьСодержимое(ВходныеДанные);
        Намерение = СформироватьОписаниеНамерения("file.replace", КонтекстДоступа, Объект.Ссылка, Объект.Видимость, ВходныеДанные, Содержимое, Версия, Причина, СотрудникРежим);
        Команда = ОткрытьПривязкуКоманды(СсылкаУчетнойЗаписи, КомандаИдентификатор, "file.replace", КонтекстДоступа, Намерение);
        Если Команда.Выбран() Тогда
            Результат = ПовторитьСохраненныйРезультат(Команда, КонтекстДоступа, СотрудникРежим);
        Иначе
            Если КонтекстДоступа.ТекущаяВерсия.Версия <> Версия Тогда
                ВызватьИсключение "кабинет_файл_редакция_конфликт";
            КонецЕсли;
            Если Версия >= 100 Тогда
                ВызватьИсключение "кабинет_файл_квота_превышено";
            КонецЕсли;
            ПроверитьКвоту(КонтекстДоступа.Квоты, Содержимое.КоличествоБайт, Ложь);
            ПроверитьОбщуюКвотуВложений(КонтекстДоступа, Содержимое.КоличествоБайт);
            Предыдущая = ОбъектВерсииФайла(КонтекстДоступа.ТекущаяВерсия.ВерсияФайла, Объект, КонтекстДоступа);
            Если Предыдущая.Версия <> КонтекстДоступа.ТекущаяВерсия.Версия Тогда
                ВызватьИсключение "кабинет_файл_привязка_конфликт";
            КонецЕсли;
            ВерсияФайла = ЗаписатьВерсиюФайла(Объект, КонтекстДоступа, ВходныеДанные, Содержимое, Версия + 1, Предыдущая.Ссылка, Причина, СсылкаУчетнойЗаписи);
            ЗаписатьУказательТекущейВерсии(КонтекстДоступа.ТекущаяВерсия, Объект, ВерсияФайла);
            ПрогретьТекстовыйПредпросмотр(КонтекстДоступа, Объект, ВерсияФайла, Содержимое.Данные);
            УчестьРасходКвоты(КонтекстДоступа.Квоты, Содержимое.КоличествоБайт, Ложь);
            Результат = МетаданныеФайла(Объект, ВерсияФайла, СотрудникРежим);
            СохранитьПривязкуКоманды(Команда, Объект, ВерсияФайла, Результат);
            ПолитикаДоступа.ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, КонтекстДоступа.РабочееПространство, "files.replace", Строка(Объект.Ссылка.УникальныйИдентификатор()));
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СписокВложенийОбращения(СсылкаУчетнойЗаписи, РодительЗапросКлиентаИдентификатор, СотрудникРежим = Ложь) Экспорт
    КонтекстДоступа = НачатьОперациюСРодителем(СсылкаУчетнойЗаписи, РодительЗапросКлиентаИдентификатор, СотрудникРежим, Ложь, "Public");
    Попытка
        Запрос = Новый Запрос(
            "ВЫБРАТЬ ПЕРВЫЕ 101 Ссылка ИЗ Справочник.ФайлыОбращений ГДЕ РодительскоеОбращение = &РодительскоеОбращение
            |И РабочееПространство = &РабочееПространство И Область = &Область И НЕ ПометкаУдаления
            |И (&Сотрудник ИЛИ Видимость = &Общедоступный) УПОРЯДОЧИТЬ ПО ДатаСоздания, Ссылка");
        УстановитьКонтекстОбласти(Запрос, КонтекстДоступа);
        Запрос.УстановитьПараметр("Сотрудник", СотрудникРежим);
        Запрос.УстановитьПараметр("Общедоступный", "Public");
        Выборка = Запрос.Выполнить().Выбрать();
        Результат = Новый Массив;
        Пока Выборка.Следующий() Цикл
            Если Результат.Количество() >= 100 Тогда
                ВызватьИсключение "кабинет_файл_привязка_конфликт";
            КонецЕсли;
            Объект = ПолучитьЗаблокированныйФайл(Выборка.Ссылка, КонтекстДоступа);
            ТекущаяВерсия = ПрочитатьУказательТекущейВерсии(Объект, КонтекстДоступа);
            ВерсияФайла = ОбъектВерсииФайла(ТекущаяВерсия.ВерсияФайла, Объект, КонтекстДоступа);
            Если ВерсияФайла.Версия <> ТекущаяВерсия.Версия Тогда
                ВызватьИсключение "кабинет_файл_привязка_конфликт";
            КонецЕсли;
            Результат.Добавить(МетаданныеФайла(Объект, ВерсияФайла, СотрудникРежим));
        КонецЦикла;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПолучитьВложениеОбращения(СсылкаУчетнойЗаписи, ФайлИдентификатор, СотрудникРежим = Ложь) Экспорт
    КонтекстДоступа = НачатьОперациюСФайлом(СсылкаУчетнойЗаписи, ФайлИдентификатор, СотрудникРежим, Ложь);
    Попытка
        Объект = КонтекстДоступа.Файл;
        Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 101 Ссылка ИЗ Справочник.ВерсииФайловОбращений ГДЕ Файл = &Файл УПОРЯДОЧИТЬ ПО Версия, Ссылка");
        Запрос.УстановитьПараметр("Файл", Объект.Ссылка);
        Выборка = Запрос.Выполнить().Выбрать();
        Версии = Новый Массив;
        ПредыдущаяСсылка = Справочники.ВерсииФайловОбращений.ПустаяСсылка();
        Новейший = Неопределено;
        Пока Выборка.Следующий() Цикл
            Если Версии.Количество() >= 100 Тогда
                ВызватьИсключение "кабинет_файл_привязка_конфликт";
            КонецЕсли;
            ВерсияФайла = ОбъектВерсииФайла(Выборка.Ссылка, Объект, КонтекстДоступа);
            Если ВерсияФайла.Версия <> Версии.Количество() + 1 Или ВерсияФайла.ПредыдущаяВерсия <> ПредыдущаяСсылка Тогда
                ВызватьИсключение "кабинет_файл_привязка_конфликт";
            КонецЕсли;
            ПредыдущаяСсылка = ВерсияФайла.Ссылка;
            Новейший = МетаданныеФайла(Объект, ВерсияФайла, СотрудникРежим);
            Версии.Добавить(Новейший);
        КонецЦикла;
        Если Версии.Количество() <> КонтекстДоступа.ТекущаяВерсия.Версия Или ПредыдущаяСсылка <> КонтекстДоступа.ТекущаяВерсия.ВерсияФайла Тогда
            ВызватьИсключение "кабинет_файл_привязка_конфликт";
        КонецЕсли;
        Результат = Новый Структура("file,versions", Новейший, Версии);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СкачатьВложениеОбращения(СсылкаУчетнойЗаписи, ФайлИдентификатор, Версия = 0, СотрудникРежим = Ложь) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    Если ТипЗнч(Версия) <> Тип("Число") Тогда
        ВызватьИсключение "кабинет_файл_некорректно_поле";
    КонецЕсли;
    Если Версия < 0 Или Версия > 100 Или Версия <> Цел(Версия) Тогда
        ВызватьИсключение "кабинет_файл_некорректно_поле";
    КонецЕсли;
    КонтекстДоступа = НачатьОперациюСФайлом(СсылкаУчетнойЗаписи, ФайлИдентификатор, СотрудникРежим, Ложь);
    Попытка
        Если Версия = 0 Тогда
            Версия = КонтекстДоступа.ТекущаяВерсия.Версия;
        КонецЕсли;
        Если Версия > КонтекстДоступа.ТекущаяВерсия.Версия Тогда
            ВызватьИсключение "кабинет_файл_не_найдено";
        КонецЕсли;
        Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2 Ссылка ИЗ Справочник.ВерсииФайловОбращений ГДЕ Файл = &Файл И Версия = &Версия");
        Запрос.УстановитьПараметр("Файл", КонтекстДоступа.Файл.Ссылка);
        Запрос.УстановитьПараметр("Версия", Версия);
        Выборка = Запрос.Выполнить().Выбрать();
        Если Не Выборка.Следующий() Тогда
            ВызватьИсключение "кабинет_файл_не_найдено";
        КонецЕсли;
        ВерсияФайла = ОбъектВерсииФайла(Выборка.Ссылка, КонтекстДоступа.Файл, КонтекстДоступа);
        Если Выборка.Следующий() Тогда
            ВызватьИсключение "кабинет_файл_привязка_конфликт";
        КонецЕсли;
        Если Версия = КонтекстДоступа.ТекущаяВерсия.Версия И ВерсияФайла.Ссылка <> КонтекстДоступа.ТекущаяВерсия.ВерсияФайла Тогда
            ВызватьИсключение "кабинет_файл_привязка_конфликт";
        КонецЕсли;
        Попытка
            Данные = ВерсияФайла.ДвоичныеДанные.Получить();
        Исключение
            ВызватьИсключение "кабинет_файл_целостность_конфликт";
        КонецПопытки;
        Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
            ВызватьИсключение "кабинет_файл_целостность_конфликт";
        КонецЕсли;
        Если Данные.Размер() <> ВерсияФайла.КоличествоБайт Или ВычислитьХешСодержимого(Данные) <> ВерсияФайла.ХешSHA256 Тогда
            ВызватьИсключение "кабинет_файл_целостность_конфликт";
        КонецЕсли;
        Результат = Новый Структура("binary,mime,filename", Данные, ВерсияФайла.ТипMIME, ВерсияФайла.ИмяФайла);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПредпросмотрВложенияОбращения(СсылкаУчетнойЗаписи, ФайлИдентификатор, Представление, ИсточникИдентификатор) Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    Если Представление = "" Тогда Представление = "download"; КонецЕсли;
    Если НРег(Представление) <> "download" Тогда
        ВызватьИсключение "кабинет_файл_некорректно_поле";
    КонецЕсли;
    ПредварительныйСнимок = ПредставлениеФайла(РазобратьИдентификатор(ФайлИдентификатор));
    СвойРодитель = ПредварительныйСнимок.РодительскоеОбращение.Заявитель = СсылкаУчетнойЗаписи;
    Если СвойРодитель Тогда
        КонтекстДоступа = НачатьОперациюСРодителем(СсылкаУчетнойЗаписи,
            Строка(ПредварительныйСнимок.РодительскоеОбращение.УникальныйИдентификатор()), Ложь, Ложь);
    Иначе
        КонтекстДоступа = НачатьПубличныйПредпросмотр(СсылкаУчетнойЗаписи, ПредварительныйСнимок);
    КонецЕсли;
    Попытка
        Объект = ПолучитьЗаблокированныйФайл(ПредварительныйСнимок.Ссылка, КонтекстДоступа);
        Если Объект.Видимость <> ПредварительныйСнимок.Видимость
            Или Объект.ПервоначальныйЗагрузивший <> ПредварительныйСнимок.ПервоначальныйЗагрузивший Тогда
            ВызватьИсключение "кабинет_файл_привязка_конфликт";
        КонецЕсли;
        Если Не СвойРодитель И Объект.Видимость <> "Public" Тогда
            ВызватьИсключение "кабинет_файл_не_найдено";
        КонецЕсли;
        ТекущаяВерсия = ПрочитатьУказательТекущейВерсии(Объект, КонтекстДоступа);
        ВерсияФайла = ОбъектВерсииФайла(ТекущаяВерсия.ВерсияФайла, Объект, КонтекстДоступа);
        Если ВерсияФайла.Версия <> ТекущаяВерсия.Версия Тогда
            ВызватьИсключение "кабинет_файл_привязка_конфликт";
        КонецЕсли;
        Если Не ПодключитьВнешнююКомпоненту("/opt/vodokanal-native/libVdkPreviewAddIn.so", "VdkPreview", ТипВнешнейКомпоненты.Native) Тогда
            ВызватьИсключение "кабинет_файл_предпросмотр_недоступно";
        КонецЕсли;
        Просмотр = Новый("AddIn.VdkPreview.VdkPreview");
        ОбластьДоступа = Строка(КонтекстДоступа.РабочееПространство.УникальныйИдентификатор()) + "/"
            + Строка(КонтекстДоступа.Область.УникальныйИдентификатор());
        Если Не Просмотр.MayPreview(ОбластьДоступа, ОбластьДоступа,
            Строка(СсылкаУчетнойЗаписи.УникальныйИдентификатор()),
            Строка(Объект.ПервоначальныйЗагрузивший.УникальныйИдентификатор()),
            Объект.Видимость, 2, Представление + ";" + СокрЛП(Строка(ВерсияФайла.КоличествоБайт))
            + ";" + ВерсияФайла.ТипMIME) Тогда
            ВызватьИсключение "кабинет_файл_не_найдено";
        КонецЕсли;
        Данные = ВерсияФайла.ДвоичныеДанные.Получить();
        Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Или Данные.Размер() <> ВерсияФайла.КоличествоБайт
            Или ВычислитьХешСодержимого(Данные) <> ВерсияФайла.ХешSHA256 Тогда
            ВызватьИсключение "кабинет_файл_целостность_конфликт";
        КонецЕсли;
        Если Не ПодключитьВнешнююКомпоненту("/opt/vodokanal-native/libVdkProbeAddIn.so", "VdkFileProbe", ТипВнешнейКомпоненты.Native) Тогда
            ВызватьИсключение "кабинет_файл_предпросмотр_недоступно";
        КонецЕсли;
        ПроверкаФайла = Новый("AddIn.VdkFileProbe.VdkFileProbe");
        Если ПроверкаФайла.Probe(Данные, ВерсияФайла.ТипMIME) <> ВерсияФайла.ХешSHA256 Тогда
            ВызватьИсключение "кабинет_файл_целостность_конфликт";
        КонецЕсли;
        Если Объект.Видимость = "Public" И ВерсияФайла.ТипMIME = "text/plain" Тогда
            Данные = Просмотр.ProjectText(ОбластьДоступа, ВерсияФайла.ИмяФайла, Данные);
        КонецЕсли;
        Результат = Новый Структура("binary,mime,filename", Данные, ВерсияФайла.ТипMIME, ВерсияФайла.ИмяФайла);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Процедура ПрогретьТекстовыйПредпросмотр(КонтекстДоступа, Объект, ВерсияФайла, Данные)
    Если Не ПодключитьВнешнююКомпоненту("/opt/vodokanal-native/libVdkPreviewAddIn.so", "VdkPreview", ТипВнешнейКомпоненты.Native) Тогда
        ВызватьИсключение "кабинет_файл_предпросмотр_недоступно";
    КонецЕсли;
    Просмотр = Новый("AddIn.VdkPreview.VdkPreview");
    ОбластьДоступа = Строка(КонтекстДоступа.РабочееПространство.УникальныйИдентификатор()) + "/"
        + Строка(КонтекстДоступа.Область.УникальныйИдентификатор());
    Если Не Просмотр.PrimeText(ОбластьДоступа, Строка(Объект.Ссылка.УникальныйИдентификатор()),
        Объект.Видимость, ВерсияФайла.ТипMIME, Данные) Тогда
        ВызватьИсключение "кабинет_файл_предпросмотр_недоступно";
    КонецЕсли;
КонецПроцедуры

Функция НачатьОперациюСРодителем(СсылкаУчетнойЗаписи, РодительЗапросКлиентаИдентификатор, СотрудникРежим, Записать, Видимость = "Public")
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    Если ТипЗнч(СотрудникРежим) <> Тип("Булево") Тогда
        ВызватьИсключение "кабинет_файл_некорректно_поле";
    КонецЕсли;
    ПроверитьОтсутствиеТранзакции();
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        КонтекстДоступа = СервисДиспетчерской.ПроверитьДоступКВложениюОбращения(СсылкаУчетнойЗаписи, РодительЗапросКлиентаИдентификатор, СотрудникРежим, Записать, Видимость);
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат КонтекстДоступа;
КонецФункции

Функция НачатьПубличныйПредпросмотр(СсылкаУчетнойЗаписи, ПредварительныйСнимок)
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьОтсутствиеТранзакции();
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        СсылкаОбращения = ПредварительныйСнимок.РодительскоеОбращение;
        СсылкаРабочегоПространства = СсылкаОбращения.РабочееПространство;
        СсылкаОбласти = СсылкаОбращения.Область;
        Если Не ЗначениеЗаполнено(СсылкаРабочегоПространства) Или Не ЗначениеЗаполнено(СсылкаОбласти) Тогда
            ВызватьИсключение "кабинет_файл_не_найдено";
        КонецЕсли;
        ЗаблокироватьОбъектПоСсылке("Справочник.УчетныеЗаписи", СсылкаУчетнойЗаписи);
        ЗаблокироватьОбъектПоСсылке("Справочник.РабочиеПространства", СсылкаРабочегоПространства);
        ЗаблокироватьОбъектПоСсылке("Справочник.Области", СсылкаОбласти);
        ЗаблокироватьОбъектПоСсылке("Справочник.ОбращенияДиспетчерской", СсылкаОбращения);
        Обращение = СсылкаОбращения.ПолучитьОбъект();
        Если Обращение = Неопределено Или Обращение.ПометкаУдаления
            Или Обращение.Источник <> "Portal" Или Не ЗначениеЗаполнено(Обращение.Приемная)
            Или Обращение.РабочееПространство <> СсылкаРабочегоПространства
            Или Обращение.Область <> СсылкаОбласти Тогда
            ВызватьИсключение "кабинет_файл_не_найдено";
        КонецЕсли;
        ЗаблокироватьОбъектПоСсылке("Справочник.ПубличныеПриемные", Обращение.Приемная);
        Приемная = Обращение.Приемная.ПолучитьОбъект();
        Если Приемная = Неопределено Или Приемная.ПометкаУдаления Или Не Приемная.Опубликована
            Или Приемная.РабочееПространство <> Обращение.РабочееПространство
            Или Приемная.ОбластьПоУмолчанию <> Обращение.Область Тогда
            ВызватьИсключение "кабинет_файл_не_найдено";
        КонецЕсли;
        КонтекстДоступа = Новый Структура("РабочееПространство,Область,Запрос",
            Обращение.РабочееПространство, Обращение.Область, СсылкаОбращения);
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат КонтекстДоступа;
КонецФункции

Функция НачатьОперациюСФайлом(СсылкаУчетнойЗаписи, ФайлИдентификатор, СотрудникРежим, Записать)
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПредварительныйСнимок = ПредставлениеФайла(РазобратьИдентификатор(ФайлИдентификатор));
    КонтекстДоступа = НачатьОперациюСРодителем(СсылкаУчетнойЗаписи, Строка(ПредварительныйСнимок.РодительскоеОбращение.УникальныйИдентификатор()), СотрудникРежим, Записать, ПредварительныйСнимок.Видимость);
    Попытка
        Если Записать Тогда
            КонтекстДоступа.Вставить("Квоты", ПрочитатьКвоты(КонтекстДоступа));
        КонецЕсли;
        Объект = ПолучитьЗаблокированныйФайл(ПредварительныйСнимок.Ссылка, КонтекстДоступа);
        Если Объект.Видимость <> ПредварительныйСнимок.Видимость Или Объект.ПервоначальныйЗагрузивший <> ПредварительныйСнимок.ПервоначальныйЗагрузивший Тогда
            ВызватьИсключение "кабинет_файл_привязка_конфликт";
        КонецЕсли;
        КонтекстДоступа.Вставить("Файл", Объект);
        КонтекстДоступа.Вставить("ТекущаяВерсия", ПрочитатьУказательТекущейВерсии(Объект, КонтекстДоступа));
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат КонтекстДоступа;
КонецФункции

Функция ПредставлениеФайла(Разобранный)
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка, РодительскоеОбращение, Видимость, ПервоначальныйЗагрузивший ИЗ Справочник.ФайлыОбращений ГДЕ Ссылка = &Файл И НЕ ПометкаУдаления");
    Запрос.УстановитьПараметр("Файл", Справочники.ФайлыОбращений.ПолучитьСсылку(Разобранный));
    Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Тогда
        ВызватьИсключение "кабинет_файл_не_найдено";
    КонецЕсли;
    Если Не ЗначениеЗаполнено(Выборка.РодительскоеОбращение) Или (Выборка.Видимость <> "Public" И Выборка.Видимость <> "Internal") Тогда
        ВызватьИсключение "кабинет_файл_привязка_конфликт";
    КонецЕсли;
    Возврат Новый Структура("Ссылка,РодительскоеОбращение,Видимость,ПервоначальныйЗагрузивший", Выборка.Ссылка, Выборка.РодительскоеОбращение, Выборка.Видимость, Выборка.ПервоначальныйЗагрузивший);
КонецФункции

Функция ПолучитьЗаблокированныйФайл(ФайлСсылка, КонтекстДоступа)
    ЗаблокироватьОбъектПоСсылке("Справочник.ФайлыОбращений", ФайлСсылка);
    Объект = ФайлСсылка.ПолучитьОбъект();
    Если Объект = Неопределено Тогда
        ВызватьИсключение "кабинет_файл_не_найдено";
    КонецЕсли;
    Если Объект.ПометкаУдаления Или Объект.РабочееПространство <> КонтекстДоступа.РабочееПространство Или Объект.Область <> КонтекстДоступа.Область Или Объект.РодительскоеОбращение <> КонтекстДоступа.Запрос Тогда
        ВызватьИсключение "кабинет_файл_не_найдено";
    КонецЕсли;
    Если Объект.Состояние <> "Active" Или Объект.Ревизия <> 1 Или Не ЗначениеЗаполнено(Объект.ПервоначальныйЗагрузивший)
        Или Объект.КемСоздано <> Объект.ПервоначальныйЗагрузивший Или Объект.ДатаСоздания = Дата(1, 1, 1)
        Или (Объект.Видимость <> "Public" И Объект.Видимость <> "Internal")
        Или (Объект.ВидАвтора <> "Requester" И Объект.ВидАвтора <> "Dispatcher") Тогда
        ВызватьИсключение "кабинет_файл_привязка_конфликт";
    КонецЕсли;
    Возврат Объект;
КонецФункции

Функция ПрочитатьУказательТекущейВерсии(Объект, КонтекстДоступа)
    ТекущаяВерсия = РегистрыСведений.ТекущиеВерсииФайловОбращений.СоздатьМенеджерЗаписи();
    ЗаблокироватьУказательТекущейВерсии(Объект.Ссылка);
    ТекущаяВерсия.Файл = Объект.Ссылка;
    ТекущаяВерсия.Прочитать();
    Если Не ТекущаяВерсия.Выбран() Тогда
        ВызватьИсключение "кабинет_файл_привязка_конфликт";
    КонецЕсли;
    Если ТекущаяВерсия.РабочееПространство <> КонтекстДоступа.РабочееПространство Или ТекущаяВерсия.Область <> КонтекстДоступа.Область Или ТекущаяВерсия.РодительскоеОбращение <> КонтекстДоступа.Запрос
        Или ТекущаяВерсия.Версия < 1 Или ТекущаяВерсия.Версия > 100 Или ТекущаяВерсия.Версия <> Цел(ТекущаяВерсия.Версия)
        Или Не ЗначениеЗаполнено(ТекущаяВерсия.ВерсияФайла) Или ТекущаяВерсия.ДатаОбновления = Дата(1, 1, 1) Тогда
        ВызватьИсключение "кабинет_файл_привязка_конфликт";
    КонецЕсли;
    Возврат ТекущаяВерсия;
КонецФункции

Функция СоздатьУказательТекущейВерсии(ФайлСсылка, КонтекстДоступа)
    ЗаблокироватьУказательТекущейВерсии(ФайлСсылка);
    ТекущаяВерсия = РегистрыСведений.ТекущиеВерсииФайловОбращений.СоздатьМенеджерЗаписи();
    ТекущаяВерсия.Файл = ФайлСсылка;
    ТекущаяВерсия.Прочитать();
    Если ТекущаяВерсия.Выбран() Тогда
        ВызватьИсключение "кабинет_файл_привязка_конфликт";
    КонецЕсли;
    ТекущаяВерсия.Файл = ФайлСсылка;
    ТекущаяВерсия.РабочееПространство = КонтекстДоступа.РабочееПространство;
    ТекущаяВерсия.Область = КонтекстДоступа.Область;
    ТекущаяВерсия.РодительскоеОбращение = КонтекстДоступа.Запрос;
    Возврат ТекущаяВерсия;
КонецФункции

Процедура ЗаблокироватьУказательТекущейВерсии(ФайлСсылка)
    Блокировка = Новый БлокировкаДанных;
    БлокировкаЗапись = Блокировка.Добавить("РегистрСведений.ТекущиеВерсииФайловОбращений");
    БлокировкаЗапись.УстановитьЗначение("Файл", ФайлСсылка);
    БлокировкаЗапись.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
КонецПроцедуры

Процедура ЗаписатьУказательТекущейВерсии(ТекущаяВерсия, Объект, ВерсияФайла)
    ТекущаяВерсия.Файл = Объект.Ссылка;
    ТекущаяВерсия.РабочееПространство = Объект.РабочееПространство;
    ТекущаяВерсия.Область = Объект.Область;
    ТекущаяВерсия.РодительскоеОбращение = Объект.РодительскоеОбращение;
    ТекущаяВерсия.Версия = ВерсияФайла.Версия;
    ТекущаяВерсия.ВерсияФайла = ВерсияФайла.Ссылка;
    ТекущаяВерсия.ДатаОбновления = ВерсияФайла.ДатаСоздания;
    ТекущаяВерсия.Записать();
КонецПроцедуры

Функция ЗаписатьВерсиюФайла(Объект, КонтекстДоступа, ВходныеДанные, Содержимое, Версия, ПредыдущаяСсылка, Причина, СсылкаУчетнойЗаписи)
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ВерсииФайловОбращений ГДЕ Файл = &Файл И Версия = &Версия");
    Запрос.УстановитьПараметр("Файл", Объект.Ссылка);
    Запрос.УстановитьПараметр("Версия", Версия);
    Если Не Запрос.Выполнить().Пустой() Тогда
        ВызватьИсключение "кабинет_файл_привязка_конфликт";
    КонецЕсли;
    ВерсияФайла = Справочники.ВерсииФайловОбращений.СоздатьЭлемент();
    ВерсияФайла.SetNewObjectRef(Справочники.ВерсииФайловОбращений.ПолучитьСсылку(СервисДокументов.НовыйUUIDv4()));
    ВерсияФайла.Наименование = "Immutable binary attachment revision";
    ВерсияФайла.Файл = Объект.Ссылка;
    ВерсияФайла.РабочееПространство = КонтекстДоступа.РабочееПространство;
    ВерсияФайла.Область = КонтекстДоступа.Область;
    ВерсияФайла.РодительскоеОбращение = КонтекстДоступа.Запрос;
    ВерсияФайла.Версия = Версия;
    ВерсияФайла.ПредыдущаяВерсия = ПредыдущаяСсылка;
    ВерсияФайла.ИмяФайла = ВходныеДанные.ИмяФайла;
    ВерсияФайла.ТипMIME = ВходныеДанные.ТипMIME;
    ВерсияФайла.КоличествоБайт = Содержимое.КоличествоБайт;
    ВерсияФайла.ХешSHA256 = Содержимое.ХешSHA256;
    ВерсияФайла.ДвоичныеДанные = Новый ХранилищеЗначения(Содержимое.Данные);
    ВерсияФайла.Причина = Причина;
    ВерсияФайла.Состояние = "Active";
    ВерсияФайла.КемСоздано = СсылкаУчетнойЗаписи;
    ВерсияФайла.ДатаСоздания = ТекущаяУниверсальнаяДата();
    ВерсияФайла.Ревизия = 1;
    ВерсияФайла.Записать();
    Возврат ВерсияФайла;
КонецФункции

Функция ОбъектВерсииФайла(ИдентификаторСсылки, Объект, КонтекстДоступа)
    ВерсияФайла = ИдентификаторСсылки.ПолучитьОбъект();
    Если ВерсияФайла = Неопределено Тогда
        ВызватьИсключение "кабинет_файл_привязка_конфликт";
    КонецЕсли;
    Если ВерсияФайла.ПометкаУдаления Или ВерсияФайла.Файл <> Объект.Ссылка Или ВерсияФайла.РабочееПространство <> КонтекстДоступа.РабочееПространство
        Или ВерсияФайла.Область <> КонтекстДоступа.Область Или ВерсияФайла.РодительскоеОбращение <> КонтекстДоступа.Запрос
        Или ВерсияФайла.КемСоздано <> Объект.ПервоначальныйЗагрузивший Или ВерсияФайла.ДатаСоздания = Дата(1, 1, 1)
        Или ВерсияФайла.Состояние <> "Active" Или ВерсияФайла.Ревизия <> 1
        Или ВерсияФайла.Версия < 1 Или ВерсияФайла.Версия > 100 Или ВерсияФайла.Версия <> Цел(ВерсияФайла.Версия)
        Или ВерсияФайла.КоличествоБайт < 1 Или ВерсияФайла.КоличествоБайт > 5242880 Или ВерсияФайла.КоличествоБайт <> Цел(ВерсияФайла.КоличествоБайт)
        Или СтрДлина(ВерсияФайла.ХешSHA256) <> 44 Тогда
        ВызватьИсключение "кабинет_файл_привязка_конфликт";
    КонецЕсли;
    ОжидаемыйMIME = ТипСодержимогоПоИмениФайла(ВерсияФайла.ИмяФайла);
    Если ОжидаемыйMIME <> ВерсияФайла.ТипMIME Или ПустаяСтрока(ВерсияФайла.Причина) Или СтрДлина(ВерсияФайла.Причина) > 250 Тогда
        ВызватьИсключение "кабинет_файл_привязка_конфликт";
    КонецЕсли;
    Если ВерсияФайла.Версия = 1 И ЗначениеЗаполнено(ВерсияФайла.ПредыдущаяВерсия) Тогда
        ВызватьИсключение "кабинет_файл_привязка_конфликт";
    КонецЕсли;
    Если ВерсияФайла.Версия > 1 И Не ЗначениеЗаполнено(ВерсияФайла.ПредыдущаяВерсия) Тогда
        ВызватьИсключение "кабинет_файл_привязка_конфликт";
    КонецЕсли;
    Возврат ВерсияФайла;
КонецФункции

Функция ПрочитатьКвоты(КонтекстДоступа)
    КвотаРабочегоПространства = ПрочитатьКвоту(КонтекстДоступа.РабочееПространство, Справочники.ОбращенияДиспетчерской.ПустаяСсылка());
    ЗапросКлиентаКвота = ПрочитатьКвоту(КонтекстДоступа.РабочееПространство, КонтекстДоступа.Запрос);
    Возврат Новый Структура("РабочееПространство,Запрос", КвотаРабочегоПространства, ЗапросКлиентаКвота);
КонецФункции

Функция ПрочитатьКвоту(СсылкаРабочейОбласти, РодительскоеОбращение)
    Блокировка = Новый БлокировкаДанных;
    БлокировкаЗапись = Блокировка.Добавить("РегистрСведений.КвотыФайловОбращений");
    БлокировкаЗапись.УстановитьЗначение("РабочееПространство", СсылкаРабочейОбласти);
    БлокировкаЗапись.УстановитьЗначение("РодительскоеОбращение", РодительскоеОбращение);
    БлокировкаЗапись.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
    СчетчикКвоты = РегистрыСведений.КвотыФайловОбращений.СоздатьМенеджерЗаписи();
    СчетчикКвоты.РабочееПространство = СсылкаРабочейОбласти;
    СчетчикКвоты.РодительскоеОбращение = РодительскоеОбращение;
    СчетчикКвоты.Прочитать();
    Если Не СчетчикКвоты.Выбран() Тогда
        Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ФайлыОбращений ГДЕ РабочееПространство = &РабочееПространство И (&Совокупный ИЛИ РодительскоеОбращение = &РодительскоеОбращение)");
        Запрос.УстановитьПараметр("РабочееПространство", СсылкаРабочейОбласти);
        Запрос.УстановитьПараметр("Совокупный", Не ЗначениеЗаполнено(РодительскоеОбращение));
        Запрос.УстановитьПараметр("РодительскоеОбращение", РодительскоеОбращение);
        Если Не Запрос.Выполнить().Пустой() Тогда
            ВызватьИсключение "кабинет_файл_привязка_конфликт";
        КонецЕсли;
        СчетчикКвоты.РабочееПространство = СсылкаРабочейОбласти;
        СчетчикКвоты.РодительскоеОбращение = РодительскоеОбращение;
        СчетчикКвоты.СохраненныеБайты = 0;
        СчетчикКвоты.КоличествоФайлов = 0;
        СчетчикКвоты.КоличествоВерсий = 0;
    Иначе
        Если СчетчикКвоты.КоличествоФайлов < 1 Или СчетчикКвоты.КоличествоВерсий < СчетчикКвоты.КоличествоФайлов Или СчетчикКвоты.СохраненныеБайты < СчетчикКвоты.КоличествоВерсий Тогда
            ВызватьИсключение "кабинет_файл_привязка_конфликт";
        КонецЕсли;
    КонецЕсли;
    Если СчетчикКвоты.СохраненныеБайты < 0 Или СчетчикКвоты.СохраненныеБайты > 209715200 Или СчетчикКвоты.СохраненныеБайты <> Цел(СчетчикКвоты.СохраненныеБайты)
        Или СчетчикКвоты.КоличествоФайлов < 0 Или СчетчикКвоты.КоличествоФайлов > 1000 Или СчетчикКвоты.КоличествоФайлов <> Цел(СчетчикКвоты.КоличествоФайлов)
        Или СчетчикКвоты.КоличествоВерсий < 0 Или СчетчикКвоты.КоличествоВерсий > 100000 Или СчетчикКвоты.КоличествоВерсий <> Цел(СчетчикКвоты.КоличествоВерсий) Тогда
        ВызватьИсключение "кабинет_файл_привязка_конфликт";
    КонецЕсли;
    Возврат СчетчикКвоты;
КонецФункции

Процедура ПроверитьКвоту(Квоты, КоличествоБайт, НовыйФайл)
    Если Квоты.РабочееПространство.СохраненныеБайты + КоличествоБайт > 209715200 Или Квоты.Запрос.СохраненныеБайты + КоличествоБайт > 20971520
        Или Квоты.РабочееПространство.КоличествоВерсий >= 100000 Или Квоты.Запрос.КоличествоВерсий >= 10000 Тогда
        ВызватьИсключение "кабинет_файл_квота_превышено";
    КонецЕсли;
    Если НовыйФайл И (Квоты.РабочееПространство.КоличествоФайлов >= 1000 Или Квоты.Запрос.КоличествоФайлов >= 100) Тогда
        ВызватьИсключение "кабинет_файл_квота_превышено";
    КонецЕсли;
КонецПроцедуры

Процедура УчестьРасходКвоты(Квоты, КоличествоБайт, НовыйФайл)
    Для Каждого Запись Из Квоты Цикл
        СчетчикКвоты = Запись.Значение;
        СчетчикКвоты.СохраненныеБайты = СчетчикКвоты.СохраненныеБайты + КоличествоБайт;
        СчетчикКвоты.КоличествоВерсий = СчетчикКвоты.КоличествоВерсий + 1;
        Если НовыйФайл Тогда
            СчетчикКвоты.КоличествоФайлов = СчетчикКвоты.КоличествоФайлов + 1;
        КонецЕсли;
        СчетчикКвоты.Записать();
    КонецЦикла;
КонецПроцедуры

Функция ОткрытьПривязкуКоманды(СсылкаУчетнойЗаписи, КомандаИдентификатор, Операция, КонтекстДоступа, Намерение)
    ЗапросКлиентаКлюч = Строка(РазобратьИдентификатор(КомандаИдентификатор));
    Блокировка = Новый БлокировкаДанных;
    БлокировкаЗапись = Блокировка.Добавить("РегистрСведений.КомандыФайловОбращений");
    БлокировкаЗапись.УстановитьЗначение("УчетнаяЗапись", СсылкаУчетнойЗаписи);
    БлокировкаЗапись.УстановитьЗначение("ИдентификаторЗапроса", ЗапросКлиентаКлюч);
    БлокировкаЗапись.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
    Команда = РегистрыСведений.КомандыФайловОбращений.СоздатьМенеджерЗаписи();
    Команда.УчетнаяЗапись = СсылкаУчетнойЗаписи;
    Команда.ИдентификаторЗапроса = ЗапросКлиентаКлюч;
    Команда.Прочитать();
    Если Команда.Выбран() Тогда
        Если Команда.Операция <> Операция Или Команда.НамерениеJSON <> Намерение Или Команда.РабочееПространство <> КонтекстДоступа.РабочееПространство
            Или Команда.Область <> КонтекстДоступа.Область Или Команда.РодительскоеОбращение <> КонтекстДоступа.Запрос Тогда
            ВызватьИсключение "кабинет_файл_запрос_конфликт";
        КонецЕсли;
    Иначе
        Команда.УчетнаяЗапись = СсылкаУчетнойЗаписи;
        Команда.ИдентификаторЗапроса = ЗапросКлиентаКлюч;
        Команда.Операция = Операция;
        Команда.НамерениеJSON = Намерение;
        Команда.РабочееПространство = КонтекстДоступа.РабочееПространство;
        Команда.Область = КонтекстДоступа.Область;
        Команда.РодительскоеОбращение = КонтекстДоступа.Запрос;
    КонецЕсли;
    Возврат Команда;
КонецФункции

Процедура СохранитьПривязкуКоманды(Команда, Объект, ВерсияФайла, Результат)
    Команда.Файл = Объект.Ссылка;
    Команда.ВерсияФайла = ВерсияФайла.Ссылка;
    Команда.РезультатJSON = КодироватьЗначение(Результат, 16000);
    Команда.Записать();
КонецПроцедуры

Функция ПовторитьСохраненныйРезультат(Команда, КонтекстДоступа, СотрудникРежим)
    Если Не ЗначениеЗаполнено(Команда.Файл) Или Не ЗначениеЗаполнено(Команда.ВерсияФайла) Тогда
        ВызватьИсключение "кабинет_файл_привязка_конфликт";
    КонецЕсли;
    ТекущийФайл = Неопределено;
    Если КонтекстДоступа.Свойство("Файл", ТекущийФайл) Тогда
        Если Команда.Файл <> ТекущийФайл.Ссылка Тогда
            ВызватьИсключение "кабинет_файл_привязка_конфликт";
        КонецЕсли;
    КонецЕсли;
    Объект = ПолучитьЗаблокированныйФайл(Команда.Файл, КонтекстДоступа);
    ВерсияФайла = ОбъектВерсииФайла(Команда.ВерсияФайла, Объект, КонтекстДоступа);
    Результат = МетаданныеФайла(Объект, ВерсияФайла, СотрудникРежим);
    Если КодироватьЗначение(Результат, 16000) <> Команда.РезультатJSON Тогда
        ВызватьИсключение "кабинет_файл_привязка_конфликт";
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция СформироватьОписаниеНамерения(Операция, КонтекстДоступа, ФайлСсылка, Видимость, ВходныеДанные, Содержимое, Версия, Причина, СотрудникРежим)
    Возврат КодироватьЗначение(Новый Структура("operation,parentRequestId,fileId,visibility,filename,mime,byteCount,sha256,expectedVersion,reason,staffMode",
        Операция, Строка(КонтекстДоступа.Запрос.УникальныйИдентификатор()), НеобязательныйИдентификатор(ФайлСсылка), Видимость, ВходныеДанные.ИмяФайла, ВходныеДанные.ТипMIME,
        Содержимое.КоличествоБайт, Содержимое.ХешSHA256, Версия, Причина, СотрудникРежим), 16000);
КонецФункции

Функция МетаданныеФайла(Объект, ВерсияФайла, СотрудникРежим)
    Если Не СотрудникРежим И Объект.Видимость <> "Public" Тогда
        ВызватьИсключение "кабинет_файл_не_найдено";
    КонецЕсли;
    Результат = Новый Структура("id,parentRequestId,visibility,authorLabel,revisionId,version,previousRevisionId,filename,mime,byteCount,sha256,createdAt,reason",
        Строка(Объект.Ссылка.УникальныйИдентификатор()), Строка(Объект.РодительскоеОбращение.УникальныйИдентификатор()), Объект.Видимость, Объект.ВидАвтора,
        Строка(ВерсияФайла.Ссылка.УникальныйИдентификатор()), ВерсияФайла.Версия, НеобязательныйИдентификатор(ВерсияФайла.ПредыдущаяВерсия), ВерсияФайла.ИмяФайла,
        ВерсияФайла.ТипMIME, ВерсияФайла.КоличествоБайт, ВерсияФайла.ХешSHA256, XMLСтрока(ВерсияФайла.ДатаСоздания) + "Z", ВерсияФайла.Причина);
    Если СотрудникРежим Тогда
        Результат.Вставить("workspaceId", Строка(Объект.РабочееПространство.УникальныйИдентификатор()));
        Результат.Вставить("areaId", Строка(Объект.Область.УникальныйИдентификатор()));
        Результат.Вставить("uploaderAccountId", Строка(Объект.ПервоначальныйЗагрузивший.УникальныйИдентификатор()));
        Результат.Вставить("createdBy", Строка(ВерсияФайла.КемСоздано.УникальныйИдентификатор()));
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ПрочитатьВходныеПоля(ТелоЗапроса)
    ИмяФайла = ТекстовоеПоле(ТелоЗапроса, "filename", 120);
    ТипMIME = ТекстовоеПоле(ТелоЗапроса, "mime", 64);
    Если ТипСодержимогоПоИмениФайла(ИмяФайла) <> ТипMIME Тогда
        ВызватьИсключение "кабинет_файл_некорректно_тип";
    КонецЕсли;
    Кодированный = Неопределено;
    Если Не ТелоЗапроса.Свойство("contentBase64", Кодированный) Тогда
        ВызватьИсключение "кабинет_файл_некорректно_база64";
    КонецЕсли;
    Если ТипЗнч(Кодированный) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_файл_некорректно_база64";
    КонецЕсли;
    Длина = СтрДлина(Кодированный);
    Если Длина > 6990508 Тогда
        ВызватьИсключение "кабинет_файл_некорректно_размер";
    КонецЕсли;
    Если Длина < 4 Или Цел(Длина / 4) * 4 <> Длина Тогда
        ВызватьИсключение "кабинет_файл_некорректно_база64";
    КонецЕсли;
    Если СтрНайти(Кодированный, Символ(13)) > 0 Или СтрНайти(Кодированный, Символ(10)) > 0 Или СтрНайти(Кодированный, Символ(9)) > 0 Или СтрНайти(Кодированный, " ") > 0 Тогда
        ВызватьИсключение "кабинет_файл_некорректно_база64";
    КонецЕсли;
    Возврат Новый Структура("ИмяФайла,ТипMIME,Кодированный", ИмяФайла, ТипMIME, Кодированный);
КонецФункции

Функция ДекодироватьСодержимое(ВходныеДанные)
    Попытка
        Данные = Base64Значение(ВходныеДанные.Кодированный);
    Исключение
        ВызватьИсключение "кабинет_файл_некорректно_база64";
    КонецПопытки;
    Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
        ВызватьИсключение "кабинет_файл_некорректно_база64";
    КонецЕсли;
    КоличествоБайт = Данные.Размер();
    КаноническоеПредставление = НативноеПредставлениеBase64(Данные);
    Если КаноническоеПредставление <> ВходныеДанные.Кодированный Тогда
        ВызватьИсключение "кабинет_файл_некорректно_база64";
    КонецЕсли;
    Если КоличествоБайт < 1 Или КоличествоБайт > 5242880 Тогда
        ВызватьИсключение "кабинет_файл_некорректно_размер";
    КонецЕсли;
    ПроверитьФорматФайла(ВходныеДанные.ТипMIME, КаноническоеПредставление, Данные, КоличествоБайт);
    Возврат Новый Структура("Данные,КоличествоБайт,ХешSHA256", Данные, КоличествоБайт, ВычислитьХешСодержимого(Данные));
КонецФункции

Функция НативноеПредставлениеBase64(Данные)
    Возврат СтрЗаменить(СтрЗаменить(Base64Строка(Данные), Символ(13), ""), Символ(10), "");
КонецФункции

Функция ВычислитьХешСодержимого(Данные)
    Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
    Хеширование.Добавить(Данные);
    Возврат НативноеПредставлениеBase64(Хеширование.ХешСумма);
КонецФункции

Процедура ПроверитьФорматФайла(ТипMIME, Кодированный, Данные, КоличествоБайт)
    Если ТипMIME = "application/pdf" Тогда
        ПроверитьСигнатуруФайла(Кодированный, КоличествоБайт, СтрРазделить("37,80,68,70,45", ","));
    ИначеЕсли ТипMIME = "image/png" Тогда
        ПроверитьСигнатуруФайла(Кодированный, КоличествоБайт, СтрРазделить("137,80,78,71,13,10,26,10", ","));
    ИначеЕсли ТипMIME = "image/jpeg" Тогда
        ПроверитьСигнатуруФайла(Кодированный, КоличествоБайт, СтрРазделить("255,216,255", ","));
    ИначеЕсли ТипMIME = "text/plain" Или ТипMIME = "text/csv" Тогда
        ПроверитьКодировкуЮникод(Данные, Кодированный);
    Иначе
        ВызватьИсключение "кабинет_файл_некорректно_тип";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьСигнатуруФайла(Кодированный, КоличествоБайт, Сигнатура)
    Если КоличествоБайт < Сигнатура.Количество() Тогда
        ВызватьИсключение "кабинет_файл_некорректно_тип";
    КонецЕсли;
    Для Позиция = 1 По Сигнатура.Количество() Цикл
        Если БайтИзBase64(Кодированный, Позиция) <> Число(Сигнатура[Позиция - 1]) Тогда
            ВызватьИсключение "кабинет_файл_некорректно_тип";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция БайтИзBase64(Кодированный, Позиция)
    Группа = Цел((Позиция - 1) / 3);
    Часть = Позиция - 1 - Группа * 3;
    Смещение = Группа * 4 + 1;
    Алфавит = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    Первый = СтрНайти(Алфавит, Сред(Кодированный, Смещение, 1)) - 1;
    Второй = СтрНайти(Алфавит, Сред(Кодированный, Смещение + 1, 1)) - 1;
    Если Часть = 0 Тогда
        Возврат Первый * 4 + Цел(Второй / 16);
    КонецЕсли;
    Третий = СтрНайти(Алфавит, Сред(Кодированный, Смещение + 2, 1)) - 1;
    Если Часть = 1 Тогда
        Возврат (Второй - Цел(Второй / 16) * 16) * 16 + Цел(Третий / 4);
    КонецЕсли;
    Четвертый = СтрНайти(Алфавит, Сред(Кодированный, Смещение + 3, 1)) - 1;
    Возврат (Третий - Цел(Третий / 4) * 4) * 64 + Четвертый;
КонецФункции

Процедура ПроверитьКодировкуЮникод(Данные, Кодированный)
    Попытка
        Текст = ПолучитьСтрокуИзДвоичныхДанных(Данные, КодировкаТекста.UTF8);
        ОбратноеПреобразование = НативноеПредставлениеBase64(ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь));
        Если ОбратноеПреобразование <> Кодированный Тогда
            ОбратноеПреобразование = НативноеПредставлениеBase64(ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Истина));
        КонецЕсли;
    Исключение
        ВызватьИсключение "кабинет_файл_некорректно_тип";
    КонецПопытки;
    Если ОбратноеПреобразование <> Кодированный Тогда
        ВызватьИсключение "кабинет_файл_некорректно_тип";
    КонецЕсли;
    Для Код = 0 По 31 Цикл
        Если Код <> 9 И Код <> 10 И Код <> 13 Тогда
            Если СтрНайти(Текст, Символ(Код)) > 0 Тогда
                ВызватьИсключение "кабинет_файл_некорректно_тип";
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Для Код = 127 По 159 Цикл
        Если СтрНайти(Текст, Символ(Код)) > 0 Тогда
            ВызватьИсключение "кабинет_файл_некорректно_тип";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ТипСодержимогоПоИмениФайла(ИмяФайла)
    Если ТипЗнч(ИмяФайла) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_файл_некорректно_имя_файла";
    КонецЕсли;
    Длина = СтрДлина(ИмяФайла);
    Если Длина < 1 Или Длина > 120 Или ИмяФайла <> СокрЛП(ИмяФайла) Или Прав(ИмяФайла, 1) = "." Или СтрНайти(ИмяФайла, "..") > 0 Тогда
        ВызватьИсключение "кабинет_файл_некорректно_имя_файла";
    КонецЕсли;
    Буквы = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
    Разрешенные = Буквы + " _.-";
    Если СтрНайти(Буквы, Лев(ИмяФайла, 1)) = 0 Тогда
        ВызватьИсключение "кабинет_файл_некорректно_имя_файла";
    КонецЕсли;
    Для Позиция = 1 По Длина Цикл
        Если СтрНайти(Разрешенные, Сред(ИмяФайла, Позиция, 1)) = 0 Тогда
            ВызватьИсключение "кабинет_файл_некорректно_имя_файла";
        КонецЕсли;
    КонецЦикла;
    ПервыйТочка = СтрНайти(ИмяФайла, ".");
    Если ПервыйТочка = 0 Тогда
        ВызватьИсключение "кабинет_файл_некорректно_имя_файла";
    КонецЕсли;
    Основа = ВРег(Лев(ИмяФайла, ПервыйТочка - 1));
    Если СтрРазделить("CON,PRN,AUX,NUL,COM1,COM2,COM3,COM4,COM5,COM6,COM7,COM8,COM9,LPT1,LPT2,LPT3,LPT4,LPT5,LPT6,LPT7,LPT8,LPT9", ",").Найти(Основа) <> Неопределено Тогда
        ВызватьИсключение "кабинет_файл_некорректно_имя_файла";
    КонецЕсли;
    Позиция = Длина;
    Пока Позиция > 0 Цикл
        Если Сред(ИмяФайла, Позиция, 1) = "." Тогда
            Прервать;
        КонецЕсли;
        Позиция = Позиция - 1;
    КонецЦикла;
    Расширение = НРег(Сред(ИмяФайла, Позиция + 1));
    Если Расширение = "pdf" Тогда
        Возврат "application/pdf";
    ИначеЕсли Расширение = "png" Тогда
        Возврат "image/png";
    ИначеЕсли Расширение = "jpg" Или Расширение = "jpeg" Тогда
        Возврат "image/jpeg";
    ИначеЕсли Расширение = "txt" Тогда
        Возврат "text/plain";
    ИначеЕсли Расширение = "csv" Тогда
        Возврат "text/csv";
    КонецЕсли;
    ВызватьИсключение "кабинет_файл_некорректно_тип";
КонецФункции

Процедура ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи)
    Текущий = ПолитикаДоступа.ПроверитьУчетнуюЗапись();
    Если ТипЗнч(СсылкаУчетнойЗаписи) <> Тип("СправочникСсылка.УчетныеЗаписи") Тогда
        ВызватьИсключение "кабинет_участник_несовпадение";
    КонецЕсли;
    Если Текущий.Ссылка <> СсылкаУчетнойЗаписи Тогда
        ВызватьИсключение "кабинет_участник_несовпадение";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьОтсутствиеТранзакции()
    Если ТранзакцияАктивна() Тогда
        ВызватьИсключение "кабинет_файл_вложенная_транзакция";
    КонецЕсли;
КонецПроцедуры

Процедура ОтменитьСобственнуюТранзакцию()
    Если ТранзакцияАктивна() Тогда
        ОтменитьТранзакцию();
    КонецЕсли;
КонецПроцедуры

Процедура ЗаблокироватьОбъектПоСсылке(ПространствоИмен, ИдентификаторСсылки)
    Блокировка = Новый БлокировкаДанных;
    БлокировкаЗапись = Блокировка.Добавить(ПространствоИмен);
    БлокировкаЗапись.УстановитьЗначение("Ссылка", ИдентификаторСсылки);
    БлокировкаЗапись.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
КонецПроцедуры

Процедура УстановитьКонтекстОбласти(Запрос, КонтекстДоступа)
    Запрос.УстановитьПараметр("РабочееПространство", КонтекстДоступа.РабочееПространство);
    Запрос.УстановитьПараметр("Область", КонтекстДоступа.Область);
    Запрос.УстановитьПараметр("РодительскоеОбращение", КонтекстДоступа.Запрос);
КонецПроцедуры

Процедура ПроверитьПоляТелаЗапроса(ТелоЗапроса, Поля)
    Если ТипЗнч(ТелоЗапроса) <> Тип("Структура") Тогда
        ВызватьИсключение "кабинет_файл_некорректно_тело";
    КонецЕсли;
    Разрешенные = СтрРазделить(Поля, ",");
    Для Каждого Запись Из ТелоЗапроса Цикл
        Если Разрешенные.Найти(Запись.Ключ) = Неопределено Тогда
            ВызватьИсключение "кабинет_файл_некорректно_поле";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ТекстовоеПоле(ТелоЗапроса, Имя, Максимум)
    Значение = Неопределено;
    Если Не ТелоЗапроса.Свойство(Имя, Значение) Тогда
        ВызватьИсключение "кабинет_файл_некорректно_поле";
    КонецЕсли;
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_файл_некорректно_поле";
    КонецЕсли;
    Если СтрДлина(Значение) < 1 Или СтрДлина(Значение) > Максимум Или Значение <> СокрЛП(Значение) Тогда
        ВызватьИсключение "кабинет_файл_некорректно_поле";
    КонецЕсли;
    Для Позиция = 1 По СтрДлина(Значение) Цикл
        Код = КодСимвола(Значение, Позиция);
        Если Код < 32 Или (Код >= 127 И Код <= 159) Или (Код >= 8203 И Код <= 8207)
            Или (Код >= 8234 И Код <= 8238) Или (Код >= 8288 И Код <= 8297) Или Код = 65279
            Или (Код >= 55296 И Код <= 57343) Тогда
            ВызватьИсключение "кабинет_файл_некорректно_поле";
        КонецЕсли;
    КонецЦикла;
    Возврат Значение;
КонецФункции

Функция ЗначениеИзПеречня(ТелоЗапроса, Имя, Варианты)
    Значение = ТекстовоеПоле(ТелоЗапроса, Имя, 32);
    Если СтрРазделить(Варианты, ",").Найти(Значение) = Неопределено Тогда
        ВызватьИсключение "кабинет_файл_некорректно_поле";
    КонецЕсли;
    Возврат Значение;
КонецФункции

Функция ПолеВерсии(ТелоЗапроса, Имя)
    Значение = Неопределено;
    Если Не ТелоЗапроса.Свойство(Имя, Значение) Тогда
        ВызватьИсключение "кабинет_файл_некорректно_поле";
    КонецЕсли;
    Если ТипЗнч(Значение) <> Тип("Число") Тогда
        ВызватьИсключение "кабинет_файл_некорректно_поле";
    КонецЕсли;
    Если Значение < 1 Или Значение > 100 Или Значение <> Цел(Значение) Тогда
        ВызватьИсключение "кабинет_файл_некорректно_поле";
    КонецЕсли;
    Возврат Значение;
КонецФункции

Функция РазобратьИдентификатор(Идентификатор)
    Если ТипЗнч(Идентификатор) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецЕсли;
    Если СтрДлина(Идентификатор) <> 36 Тогда
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецЕсли;
    Попытка
        Разобранный = Новый УникальныйИдентификатор(Идентификатор);
    Исключение
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецПопытки;
    Если Строка(Разобранный) = "00000000-0000-0000-0000-000000000000" Тогда
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецЕсли;
    Возврат Разобранный;
КонецФункции

Функция НеобязательныйИдентификатор(ИдентификаторСсылки)
    Если Не ЗначениеЗаполнено(ИдентификаторСсылки) Тогда
        Возврат "";
    КонецЕсли;
    Возврат Строка(ИдентификаторСсылки.УникальныйИдентификатор());
КонецФункции

Функция КодироватьЗначение(Значение, Максимум)
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Значение);
    Результат = Запись.Закрыть();
    Если СтрДлина(Результат) > Максимум Тогда
        ВызватьИсключение "кабинет_файл_некорректно_поле";
    КонецЕсли;
    Возврат Результат;
КонецФункции
