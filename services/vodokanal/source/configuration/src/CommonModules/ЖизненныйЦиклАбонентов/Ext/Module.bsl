
Функция ОткрытьКомандуСоздания(Контекст, Ключ, Ресурс, Тело) Экспорт
    Если Не ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_жизненный_цикл_привязка_конфликт"; КонецЕсли;
    ПроверитьТекущегоУчастника(Контекст.УчетнаяЗапись);
    Ключ = Строка(РазобратьИдентификатор(Ключ));
    Если Ресурс = "workspaces" Тогда
        Если ЗначениеЗаполнено(Контекст.Область) Или ПолитикаДоступа.ПроверитьДоступКРабочемуПространству(Контекст.УчетнаяЗапись,
            Строка(Контекст.РабочееПространство.УникальныйИдентификатор()), "WorkspaceOwner") <> Контекст.РабочееПространство Тогда
            ВызватьИсключение "кабинет_пространство_запрещено";
        КонецЕсли;
    Иначе
        Если Ресурс <> "service-points" Тогда ПроверитьРесурс(Ресурс); КонецЕсли;
        Если ПолитикаДоступа.ПроверитьДоступКОбласти(Контекст.УчетнаяЗапись, Строка(Контекст.РабочееПространство.УникальныйИдентификатор()),
            Строка(Контекст.Область.УникальныйИдентификатор()), "BillingSpecialist") <> Контекст.Область Тогда ВызватьИсключение "кабинет_область_запрещено"; КонецЕсли;
    КонецЕсли;
    Если ТипЗнч(Тело) <> Тип("Структура") Или Тело.Количество() > 16 Тогда ВызватьИсключение "кабинет_жизненный_цикл_некорректно_поле"; КонецЕсли;
    Поля = Новый ТаблицаЗначений; Поля.Колонки.Добавить("Имя"); Поля.Колонки.Добавить("Значение");
    Для Каждого Поле Из Тело Цикл
        Если ТипЗнч(Поле.Значение) <> Тип("Строка") Или СтрДлина(Поле.Значение) > 250 Тогда ВызватьИсключение "кабинет_жизненный_цикл_некорректно_поле"; КонецЕсли;
        СтрокаПоля = Поля.Добавить(); СтрокаПоля.Имя = Поле.Ключ; СтрокаПоля.Значение = Поле.Значение;
    КонецЦикла;
    Поля.Сортировать("Имя"); Каноническое = Новый Структура;
    Для Каждого Поле Из Поля Цикл Каноническое.Вставить(Поле.Имя, Поле.Значение); КонецЦикла;
    Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
    Хеш.Добавить(ПолучитьДвоичныеДанныеИзСтроки(КодироватьJSON(Каноническое, 8192), КодировкаТекста.UTF8, Ложь));
    Намерение = КодироватьJSON(Новый Структура("schema,bodySha256", 1, Base64Строка(Хеш.ХешСумма)), 256);
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("РегистрСведений.ПривязкиКомандЖизненногоЦиклаРеестра");
    Элемент.УстановитьЗначение("УчетнаяЗапись", Контекст.УчетнаяЗапись); Элемент.УстановитьЗначение("ИдентификаторЗапроса", Ключ);
    Элемент.Режим = РежимБлокировкиДанных.Исключительный; Блокировка.Заблокировать();
    Команда = РегистрыСведений.ПривязкиКомандЖизненногоЦиклаРеестра.СоздатьМенеджерЗаписи();
    Команда.УчетнаяЗапись = Контекст.УчетнаяЗапись; Команда.ИдентификаторЗапроса = Ключ; Команда.Прочитать();
    Если Команда.Выбран() Тогда
        Если Команда.РабочееПространство <> Контекст.РабочееПространство Или Команда.Область <> Контекст.Область
            Или Команда.Вид <> Ресурс Или Команда.Операция <> "create." + Ресурс Или Команда.НамерениеJSON <> Намерение Тогда
            ВызватьИсключение "кабинет_жизненный_цикл_запрос_конфликт";
        КонецЕсли;
    Иначе
        Команда.УчетнаяЗапись = Контекст.УчетнаяЗапись; Команда.ИдентификаторЗапроса = Ключ;
        Команда.РабочееПространство = Контекст.РабочееПространство; Команда.Область = Контекст.Область;
        Команда.Вид = Ресурс; Команда.Операция = "create." + Ресурс; Команда.НамерениеJSON = Намерение;
    КонецЕсли;
    Возврат Команда;
КонецФункции

Функция ПрочитатьРезультатСоздания(Команда, Контекст, Ресурс) Экспорт
    Если Не ТранзакцияАктивна() Или Не Команда.Выбран() Тогда ВызватьИсключение "кабинет_жизненный_цикл_привязка_конфликт"; КонецЕсли;
    Ид = Строка(РазобратьИдентификатор(Команда.ИдентификаторСущности));
    Если Ресурс = "workspaces" Тогда
        Результат = Новый Структура("id", Строка(Контекст.РабочееПространство.УникальныйИдентификатор()));
        Если Ид <> Результат.id Или Команда.РезультатJSON <> КодироватьJSON(Результат, 128) Тогда ВызватьИсключение "кабинет_жизненный_цикл_привязка_конфликт"; КонецЕсли;
    Иначе
        Объект = ОбъектРеестра(Ресурс, Ид, Контекст); ПроверитьСвязиОбъектов(Ресурс, Объект, Контекст);
        Результат = ПрочитатьСнимокОбъекта(Команда.РезультатJSON, Ресурс, Контекст, Ид);
        Если Результат.revision <> 1 Или Результат.createdBy <> Строка(Контекст.УчетнаяЗапись.УникальныйИдентификатор()) Тогда ВызватьИсключение "кабинет_жизненный_цикл_привязка_конфликт"; КонецЕсли;
    КонецЕсли;
    Возврат Результат;
КонецФункции

Процедура СохранитьРезультатСоздания(Команда, Результат) Экспорт
    Если Не ТранзакцияАктивна() Или Команда.Выбран() Тогда ВызватьИсключение "кабинет_жизненный_цикл_привязка_конфликт"; КонецЕсли;
    Команда.ИдентификаторСущности = Строка(РазобратьИдентификатор(Результат.id));
    Команда.РезультатJSON = КодироватьJSON(Результат, 8192); Команда.Записать();
КонецПроцедуры

Функция ИзменитьКонтактыАбонента(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    Возврат ИзменитьОбъектРеестра(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса, "subscribers", "subscriber.contacts");
КонецФункции

Функция ИзменитьРеквизитыОбъектаНедвижимости(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    Возврат ИзменитьОбъектРеестра(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса, "properties", "property.details");
КонецФункции

Функция ЗакрытьЛицевойСчет(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    Возврат ИзменитьОбъектРеестра(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса, "personal-accounts", "personal-account.close");
КонецФункции

Функция ПрекратитьДоговор(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса) Экспорт
    Возврат ИзменитьОбъектРеестра(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса, "contracts", "contract.terminate");
КонецФункции

Функция СписокЗаписейИстории(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, Ресурс, Идентификатор, Лимит = Неопределено, Курсор = "") Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьРесурс(Ресурс);
    ИдентификаторСущности = Строка(РазобратьИдентификатор(Идентификатор));
    Размер = 100;
    ДоРевизии = 1000000000000000;
    Префикс = "h1|" + Строка(СсылкаУчетнойЗаписи.УникальныйИдентификатор()) + "|" + Ресурс + "|" + ИдентификаторСущности + "|";
    Если Лимит <> Неопределено Тогда
        Если Лимит = "" Тогда Лимит = "25"; КонецЕсли;
        Размер = ЧислоСтраницы(Строка(Лимит), 100);
        Если ТипЗнч(Курсор) <> Тип("Строка") Тогда ВызватьИсключение "кабинет_реестр_некорректно_страница"; КонецЕсли;
        Если Курсор <> "" Тогда
            Если Лев(Курсор, СтрДлина(Префикс)) <> Префикс Тогда ВызватьИсключение "кабинет_реестр_некорректно_страница"; КонецЕсли;
            ДоРевизии = ЧислоСтраницы(Сред(Курсор, СтрДлина(Префикс) + 1), 999999999999999);
        КонецЕсли;
    КонецЕсли;
    КонтекстДоступа = НачатьОперациюСотрудника(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор);
    Попытка
        Объект = ОбъектРеестра(Ресурс, ИдентификаторСущности, КонтекстДоступа);
        ПроверитьСвязиОбъектов(Ресурс, Объект, КонтекстДоступа);
        Запрос = Новый Запрос(
            "ВЫБРАТЬ ПЕРВЫЕ 100 Вид, ИдентификаторСущности, Ревизия, Операция, ДействующееЛицо, ДатаИзменения,
            |Причина, СнимокДоJSON, СнимокПослеJSON ИЗ РегистрСведений.ИсторияИзмененийРеестра
            |ГДЕ РабочееПространство = &РабочееПространство И Область = &Область И Вид = &Вид И ИдентификаторСущности = &ИдентификаторСущности И Ревизия >= 2
            |УПОРЯДОЧИТЬ ПО Ревизия УБЫВ");
        Запрос.УстановитьПараметр("РабочееПространство", КонтекстДоступа.РабочееПространство);
        Запрос.УстановитьПараметр("Область", КонтекстДоступа.Область);
        Запрос.УстановитьПараметр("Вид", Ресурс);
        Запрос.УстановитьПараметр("ИдентификаторСущности", ИдентификаторСущности);
        Если Лимит <> Неопределено Тогда
            Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 100 ", "ПЕРВЫЕ " + Формат(Размер + 1, "ЧГ=0") + " ");
            Запрос.Текст = СтрЗаменить(Запрос.Текст, "УПОРЯДОЧИТЬ ПО", "И Ревизия < &ДоРевизии УПОРЯДОЧИТЬ ПО");
            Запрос.УстановитьПараметр("ДоРевизии", ДоРевизии);
        КонецЕсли;
        Выборка = Запрос.Выполнить().Выбрать();
        Результат = Новый Массив;
        Пока Выборка.Следующий() Цикл
            Перед = ПрочитатьСнимокОбъекта(Выборка.СнимокДоJSON, Ресурс, КонтекстДоступа, ИдентификаторСущности);
            После = ПрочитатьСнимокОбъекта(Выборка.СнимокПослеJSON, Ресурс, КонтекстДоступа, ИдентификаторСущности);
            Если Перед.revision + 1 <> Выборка.Ревизия Или После.revision <> Выборка.Ревизия Тогда
                ВызватьИсключение "кабинет_жизненный_цикл_привязка_конфликт";
            КонецЕсли;
            Результат.Добавить(Новый Структура("resource,entityId,revision,operation,actorAccountId,changedAt,reason,before,after",
                Ресурс, ИдентификаторСущности, Выборка.Ревизия, Выборка.Операция, Строка(Выборка.ДействующееЛицо.УникальныйИдентификатор()),
                ДатаDTOUTC(Выборка.ДатаИзменения), Выборка.Причина, Перед, После));
        КонецЦикла;
        Если Лимит <> Неопределено Тогда
            Еще = Результат.Количество() > Размер;
            Если Еще Тогда Результат.Удалить(Результат.Количество() - 1); КонецЕсли;
            Следующий = "";
            Если Еще Тогда Следующий = Префикс + Формат(Результат[Результат.Количество() - 1].revision, "ЧГ=0"); КонецЕсли;
            Результат = Новый Структура("items,limit,hasMore,nextCursor", Результат, Размер, Еще, Следующий);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Процедура ЗаписатьНовыйОбъектСИсторией(КонтекстДоступа, Ресурс, Объект) Экспорт
    Если Не ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_жизненный_цикл_привязка_конфликт"; КонецЕсли;
    ПроверитьТекущегоУчастника(КонтекстДоступа.УчетнаяЗапись);
    Если Ресурс = "properties" Тогда
        ОжидаемыйТип = Тип("СправочникОбъект.ОбъектыНедвижимости"); Операция = "property.create";
    ИначеЕсли Ресурс = "service-points" Тогда
        ОжидаемыйТип = Тип("СправочникОбъект.ТочкиОбслуживания"); Операция = "service-point.create";
    ИначеЕсли Ресурс = "contracts" Тогда
        ОжидаемыйТип = Тип("СправочникОбъект.Договоры"); Операция = "contract.create";
    Иначе
        ВызватьИсключение "кабинет_жизненный_цикл_некорректно_ресурс";
    КонецЕсли;
    Если ТипЗнч(Объект) <> ОжидаемыйТип Тогда ВызватьИсключение "кабинет_жизненный_цикл_некорректно_ресурс"; КонецЕсли;
    Если Не Объект.ЭтоНовый() Или Объект.ПометкаУдаления Или Объект.Ревизия <> 1
        Или Объект.РабочееПространство <> КонтекстДоступа.РабочееПространство Или Объект.Область <> КонтекстДоступа.Область
        Или Объект.КемСоздано <> КонтекстДоступа.УчетнаяЗапись Или (Объект.Состояние <> "Active" И Объект.Состояние <> "Closed") Тогда
        ВызватьИсключение "кабинет_жизненный_цикл_привязка_конфликт";
    КонецЕсли;
    ЗаблокироватьОбъектПоСсылке("Справочник.УчетныеЗаписи", КонтекстДоступа.УчетнаяЗапись);
    ЗаблокироватьОбъектПоСсылке("Справочник.РабочиеПространства", КонтекстДоступа.РабочееПространство);
    ЗаблокироватьОбъектПоСсылке("Справочник.Области", КонтекстДоступа.Область);
    Если ПолитикаДоступа.ПроверитьДоступКОбласти(КонтекстДоступа.УчетнаяЗапись,
        Строка(КонтекстДоступа.РабочееПространство.УникальныйИдентификатор()), Строка(КонтекстДоступа.Область.УникальныйИдентификатор()), "BillingSpecialist") <> КонтекстДоступа.Область Тогда
        ВызватьИсключение "кабинет_область_запрещено";
    КонецЕсли;
    Объект.ДатаСоздания = ТекущаяУниверсальнаяДата(); Объект.ДатаОбновления = Объект.ДатаСоздания;
    Объект.Записать();
    ПроверитьСвязиОбъектов(Ресурс, Объект, КонтекстДоступа);
    Идентификатор = Строка(Объект.Ссылка.УникальныйИдентификатор());
    Снимок = КодироватьJSON(ДанныеОбъектаРеестра(Ресурс, Объект), 8192);
    ДобавитьЗаписьИстории(КонтекстДоступа, Ресурс, Идентификатор, 1, Операция, "Создание записи", "null", Снимок, Идентификатор, Объект.ДатаСоздания);
    ДобавитьСобытиеОбслуживания(КонтекстДоступа, Ресурс, Объект, Операция, "Создание записи", "null", Снимок, Идентификатор);
КонецПроцедуры

Процедура ДобавитьСобытиеОбслуживания(КонтекстДоступа, Ресурс, Объект, Операция, Причина, СнимокДоJSON, СнимокПослеJSON, КлючКоманды)
    Если Не ТранзакцияАктивна() Тогда ВызватьИсключение "кабинет_жизненный_цикл_привязка_конфликт"; КонецЕсли;
    Если РесурсСобытияОбслуживания(Операция) <> Ресурс Тогда ВызватьИсключение "кабинет_жизненный_цикл_привязка_конфликт"; КонецЕсли;
    Если Ресурс = "properties" Тогда СсылкаОбъекта = Объект.Ссылка; Иначе СсылкаОбъекта = Объект.ОбъектНедвижимости; КонецЕсли;
    ИдентификаторОбъекта = Строка(СсылкаОбъекта.УникальныйИдентификатор());
    СвязанныйОбъект = ОбъектРеестра("properties", ИдентификаторОбъекта, КонтекстДоступа);
    ПроверитьСвязиОбъектов("properties", СвязанныйОбъект, КонтекстДоступа);
    Запрос = ЗапросСобытийОбслуживания(КонтекстДоступа, ИдентификаторОбъекта,
        "ВЫБРАТЬ ПЕРВЫЕ 1 Ревизия", "УПОРЯДОЧИТЬ ПО Ревизия УБЫВ");
    Выборка = Запрос.Выполнить().Выбрать();
    Номер = 1;
    Если Выборка.Следующий() Тогда Номер = Выборка.Ревизия + 1; КонецЕсли;
    Если Номер < 1 Или Номер >= 999999999999998 Или Номер <> Цел(Номер)
        Или (Операция = "property.create" И Номер <> 1) Тогда ВызватьИсключение "кабинет_жизненный_цикл_привязка_конфликт"; КонецЕсли;
    ДобавитьЗаписьИстории(КонтекстДоступа, "property-service", ИдентификаторОбъекта, Номер, Операция, Причина,
        СнимокДоJSON, СнимокПослеJSON, КлючКоманды, Объект.ДатаОбновления);
КонецПроцедуры

Функция ЗапросСобытийОбслуживания(КонтекстДоступа, ИдентификаторОбъекта, Выбор, Окончание)
    Запрос = Новый Запрос(Выбор + " ИЗ РегистрСведений.ИсторияИзмененийРеестра
        |ГДЕ РабочееПространство = &РабочееПространство И Область = &Область
        |И Вид = &Вид И ИдентификаторСущности = &ИдентификаторОбъекта " + Окончание);
    Запрос.УстановитьПараметр("РабочееПространство", КонтекстДоступа.РабочееПространство);
    Запрос.УстановитьПараметр("Область", КонтекстДоступа.Область);
    Запрос.УстановитьПараметр("Вид", "property-service");
    Запрос.УстановитьПараметр("ИдентификаторОбъекта", ИдентификаторОбъекта);
    Возврат Запрос;
КонецФункции

Функция ИсторияОбслуживанияОбъекта(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, Идентификатор, Лимит = "25", Курсор = "") Экспорт
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ИдентификаторОбъекта = Строка(РазобратьИдентификатор(Идентификатор));
    РабочаяОбластьИдентификатор = Строка(РазобратьИдентификатор(РабочаяОбластьИдентификатор));
    ОбластьИдентификатор = Строка(РазобратьИдентификатор(ОбластьИдентификатор));
    Если Лимит = "" Тогда Лимит = "25"; КонецЕсли;
    Размер = ЧислоСтраницы(Строка(Лимит), 100);
    Префикс = "hs1|" + Строка(СсылкаУчетнойЗаписи.УникальныйИдентификатор()) + "|" + РабочаяОбластьИдентификатор + "|"
        + ОбластьИдентификатор + "|" + ИдентификаторОбъекта + "|service|";
    ДоНомера = 1000000000000000;
    Если ТипЗнч(Курсор) <> Тип("Строка") Или СтрДлина(Курсор) > 256 Тогда ВызватьИсключение "кабинет_реестр_некорректно_страница"; КонецЕсли;
    Если Курсор <> "" Тогда
        Если Лев(Курсор, СтрДлина(Префикс)) <> Префикс Тогда ВызватьИсключение "кабинет_реестр_некорректно_страница"; КонецЕсли;
        Суффикс = Сред(Курсор, СтрДлина(Префикс) + 1);
        ДоНомера = ЧислоСтраницы(Суффикс, 999999999999999);
        Если Суффикс <> Формат(ДоНомера, "ЧГ=0") Тогда ВызватьИсключение "кабинет_реестр_некорректно_страница"; КонецЕсли;
    КонецЕсли;
    Контекст = НачатьОперациюСотрудника(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор);
    Попытка
        Объект = ОбъектРеестра("properties", ИдентификаторОбъекта, Контекст);
        ПроверитьСвязиОбъектов("properties", Объект, Контекст);
        Поля = "Ревизия, Операция, ДействующееЛицо, ДатаИзменения, Причина, СнимокДоJSON, СнимокПослеJSON";
        Первый = ЗапросСобытийОбслуживания(Контекст, ИдентификаторОбъекта, "ВЫБРАТЬ ПЕРВЫЕ 1 " + Поля, "УПОРЯДОЧИТЬ ПО Ревизия").Выполнить().Выбрать();
        Покрытие = Новый Структура("initialOwnerRecorded,legacyBoundary,capturedFrom,policy", Ложь, Истина, "", "recorded-events-only");
        Если Первый.Следующий() Тогда
            Начальное = СобытиеОбслуживанияDTO(Первый, Контекст, ИдентификаторОбъекта);
            Если Начальное.sequence <> 1 Тогда ВызватьИсключение "кабинет_жизненный_цикл_привязка_конфликт"; КонецЕсли;
            Покрытие.initialOwnerRecorded = Начальное.operation = "property.create";
            Покрытие.legacyBoundary = Не Покрытие.initialOwnerRecorded;
            Покрытие.capturedFrom = Начальное.changedAt;
        КонецЕсли;
        Запрос = ЗапросСобытийОбслуживания(Контекст, ИдентификаторОбъекта,
            "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Размер + 1, "ЧГ=0") + " " + Поля,
            "И Ревизия < &ДоНомера УПОРЯДОЧИТЬ ПО Ревизия УБЫВ");
        Запрос.УстановитьПараметр("ДоНомера", ДоНомера);
        Выборка = Запрос.Выполнить().Выбрать(); Элементы = Новый Массив;
        Пока Выборка.Следующий() Цикл Элементы.Добавить(СобытиеОбслуживанияDTO(Выборка, Контекст, ИдентификаторОбъекта)); КонецЦикла;
        Еще = Элементы.Количество() > Размер;
        Если Еще Тогда Элементы.Удалить(Элементы.Количество() - 1); КонецЕсли;
        Следующий = "";
        Если Еще Тогда Следующий = Префикс + Формат(Элементы[Элементы.Количество() - 1].sequence, "ЧГ=0"); КонецЕсли;
        Результат = Новый Структура("view,propertyId,coverage,items,limit,hasMore,nextCursor", "service", ИдентификаторОбъекта, Покрытие, Элементы, Размер, Еще, Следующий);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция РесурсСобытияОбслуживания(Операция)
    Если Операция = "property.create" Или Операция = "property.details" Тогда Возврат "properties"; КонецЕсли;
    Если Операция = "service-point.create" Тогда Возврат "service-points"; КонецЕсли;
    Если Операция = "contract.create" Или Операция = "contract.terminate" Тогда Возврат "contracts"; КонецЕсли;
    ВызватьИсключение "кабинет_жизненный_цикл_привязка_конфликт";
КонецФункции

Функция СнимокОбслуживания(Текст, Ресурс, Контекст, ИдентификаторОбъекта)
    Чтение = Новый ЧтениеJSON;
    Попытка
        Если ТипЗнч(Текст) <> Тип("Строка") Или СтрДлина(Текст) > 8192 Тогда ВызватьИсключение "кабинет_жизненный_цикл_привязка_конфликт"; КонецЕсли;
        Чтение.УстановитьСтроку(Текст); Сырой = ПрочитатьJSON(Чтение); Чтение.Закрыть();
        Если ТипЗнч(Сырой) <> Тип("Структура") Тогда ВызватьИсключение "кабинет_жизненный_цикл_привязка_конфликт"; КонецЕсли;
        Идентификатор = Строка(РазобратьИдентификатор(Сырой.id));
        Снимок = ПрочитатьСнимокОбъекта(Текст, Ресурс, Контекст, Идентификатор);
        Если Ресурс = "properties" Тогда
            Если Снимок.id <> ИдентификаторОбъекта Тогда ВызватьИсключение "кабинет_жизненный_цикл_привязка_конфликт"; КонецЕсли;
            РазобратьИдентификатор(Снимок.ownerSubscriberId);
        Иначе
            Если Снимок.propertyId <> ИдентификаторОбъекта Или (Снимок.serviceKind <> "WaterSupply" И Снимок.serviceKind <> "Wastewater") Тогда
                ВызватьИсключение "кабинет_жизненный_цикл_привязка_конфликт";
            КонецЕсли;
            Если Ресурс = "contracts" Тогда РазобратьИдентификатор(Снимок.subscriberId); РазобратьИдентификатор(Снимок.servicePointId); КонецЕсли;
        КонецЕсли;
    Исключение
        Чтение.Закрыть(); ВызватьИсключение "кабинет_жизненный_цикл_привязка_конфликт";
    КонецПопытки;
    Возврат Снимок;
КонецФункции

Функция СобытиеОбслуживанияDTO(СтрокаИстории, Контекст, ИдентификаторОбъекта)
    Ресурс = РесурсСобытияОбслуживания(СтрокаИстории.Операция);
    После = СнимокОбслуживания(СтрокаИстории.СнимокПослеJSON, Ресурс, Контекст, ИдентификаторОбъекта);
    Создание = СтрокаИстории.Операция = "property.create" Или СтрокаИстории.Операция = "service-point.create" Или СтрокаИстории.Операция = "contract.create";
    Автор = Строка(СтрокаИстории.ДействующееЛицо.УникальныйИдентификатор()); РазобратьИдентификатор(Автор);
    Момент = ДатаDTOUTC(СтрокаИстории.ДатаИзменения); Перед = Неопределено;
    Если СтрокаИстории.Ревизия < 1 Или СтрокаИстории.Ревизия <> Цел(СтрокаИстории.Ревизия) Или После.updatedAt <> Момент Тогда
        ВызватьИсключение "кабинет_жизненный_цикл_привязка_конфликт";
    КонецЕсли;
    Если Создание Тогда
        Если СтрокаИстории.СнимокДоJSON <> "null" Или После.revision <> 1 Или После.createdBy <> Автор Или После.createdAt <> Момент Тогда
            ВызватьИсключение "кабинет_жизненный_цикл_привязка_конфликт";
        КонецЕсли;
    Иначе
        Перед = СнимокОбслуживания(СтрокаИстории.СнимокДоJSON, Ресурс, Контекст, ИдентификаторОбъекта);
        Если Перед.id <> После.id Или Перед.revision + 1 <> После.revision Тогда ВызватьИсключение "кабинет_жизненный_цикл_привязка_конфликт"; КонецЕсли;
    КонецЕсли;
    Возврат Новый Структура("sequence,resource,entityId,sourceRevision,operation,actorAccountId,changedAt,reason,before,after",
        СтрокаИстории.Ревизия, Ресурс, После.id, После.revision, СтрокаИстории.Операция, Автор, Момент, СтрокаИстории.Причина, Перед, После);
КонецФункции

Функция ЧислоСтраницы(Текст, Максимум)
    Если СтрДлина(Текст) < 1 Или СтрДлина(Текст) > 15 Тогда ВызватьИсключение "кабинет_реестр_некорректно_страница"; КонецЕсли;
    Для Номер = 1 По СтрДлина(Текст) Цикл
        Если СтрНайти("0123456789", Сред(Текст, Номер, 1)) = 0 Тогда ВызватьИсключение "кабинет_реестр_некорректно_страница"; КонецЕсли;
    КонецЦикла;
    Число = Число(Текст);
    Если Число < 1 Или Число > Максимум Тогда ВызватьИсключение "кабинет_реестр_некорректно_страница"; КонецЕсли;
    Возврат Число;
КонецФункции

Функция ИзменитьОбъектРеестра(СсылкаУчетнойЗаписи, Идентификатор, ТелоЗапроса, ИдентификаторЗапроса, Ресурс, Операция)
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    ПроверитьРесурс(Ресурс);
    Разрешенные = "workspaceId,areaId,expectedRevision,reason";
    Если Операция = "subscriber.contacts" И Ресурс = "subscribers" Тогда
        Разрешенные = Разрешенные + ",name,phone,email";
    ИначеЕсли Операция = "property.details" И Ресурс = "properties" Тогда
        Разрешенные = Разрешенные + ",name,address,propertyType";
    ИначеЕсли Не ((Операция = "personal-account.close" И Ресурс = "personal-accounts")
        Или (Операция = "contract.terminate" И Ресурс = "contracts")) Тогда
        ВызватьИсключение "кабинет_жизненный_цикл_некорректно_ресурс";
    КонецЕсли;
    ПроверитьПоляТелаЗапроса(ТелоЗапроса, Разрешенные);
    ИдентификаторСущности = Строка(РазобратьИдентификатор(Идентификатор));
    ЗапросКлиентаКлюч = Строка(РазобратьИдентификатор(ИдентификаторЗапроса));
    РабочаяОбластьИдентификатор = Строка(РазобратьИдентификатор(ТекстовоеПоле(ТелоЗапроса, "workspaceId", 36)));
    ОбластьИдентификатор = Строка(РазобратьИдентификатор(ТекстовоеПоле(ТелоЗапроса, "areaId", 36)));
    ОжидаемаяРевизия = ПолеРевизии(ТелоЗапроса);
    Причина = ТекстовоеПоле(ТелоЗапроса, "reason", 250);
    Изменения = Новый Структура;
    Если Операция = "subscriber.contacts" Тогда
        Изменения.Вставить("name", ТекстовоеПоле(ТелоЗапроса, "name", 150));
        Изменения.Вставить("phone", ПолеКонтактныхДанных(ТелоЗапроса, "phone", 32));
        Изменения.Вставить("email", НРег(ПолеКонтактныхДанных(ТелоЗапроса, "email", 128)));
    ИначеЕсли Операция = "property.details" Тогда
        Изменения.Вставить("name", ТекстовоеПоле(ТелоЗапроса, "name", 150));
        Изменения.Вставить("address", ТекстовоеПоле(ТелоЗапроса, "address", 250));
        ТипОбъектаНедвижимости = ТекстовоеПоле(ТелоЗапроса, "propertyType", 32);
        Если ТипОбъектаНедвижимости <> "Residential" И ТипОбъектаНедвижимости <> "Commercial"
            И ТипОбъектаНедвижимости <> "Industrial" И ТипОбъектаНедвижимости <> "Other" Тогда
            ВызватьИсключение "кабинет_жизненный_цикл_некорректно_поле";
        КонецЕсли;
        Изменения.Вставить("propertyType", ТипОбъектаНедвижимости);
    КонецЕсли;
    НамерениеJSON = КодироватьJSON(Новый Структура("resource,entityId,workspaceId,areaId,expectedRevision,reason,changes",
        Ресурс, ИдентификаторСущности, РабочаяОбластьИдентификатор, ОбластьИдентификатор, ОжидаемаяРевизия, Причина, Изменения), 4096);
    КонтекстДоступа = НачатьОперациюСотрудника(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор);
    Попытка
        Объект = ОбъектРеестра(Ресурс, ИдентификаторСущности, КонтекстДоступа);
        ПроверитьСвязиОбъектов(Ресурс, Объект, КонтекстДоступа);
        Запрос = ОткрытьПривязкуЗапроса(СсылкаУчетнойЗаписи, ЗапросКлиентаКлюч, КонтекстДоступа, Ресурс, ИдентификаторСущности, Операция, НамерениеJSON);
        Если Запрос.Выбран() Тогда
            Результат = ПрочитатьСнимокОбъекта(Запрос.РезультатJSON, Ресурс, КонтекстДоступа, ИдентификаторСущности);
            Если Результат.revision <> ОжидаемаяРевизия + 1 Тогда
                ВызватьИсключение "кабинет_жизненный_цикл_привязка_конфликт";
            КонецЕсли;
            ПроверитьИсториюПовтора(Запрос, Результат.revision, КонтекстДоступа, Ресурс, ИдентификаторСущности, СсылкаУчетнойЗаписи, ЗапросКлиентаКлюч, Операция);
            ЗафиксироватьТранзакцию();
            Возврат Результат;
        КонецЕсли;
        Если Объект.Ревизия <> ОжидаемаяРевизия Тогда
            ВызватьИсключение "кабинет_жизненный_цикл_редакция_конфликт";
        КонецЕсли;
        Если Объект.Состояние <> "Active" Тогда
            ВызватьИсключение "кабинет_жизненный_цикл_состояние_конфликт";
        КонецЕсли;
        Если Объект.Ревизия < 1 Или Объект.Ревизия >= 999999999999998 Или Объект.Ревизия <> Цел(Объект.Ревизия) Тогда
            ВызватьИсключение "кабинет_жизненный_цикл_редакция_конфликт";
        КонецЕсли;
        Если Операция = "contract.terminate" Тогда
            ПроверитьОтсутствиеАктивныхЛицевыхСчетов(Объект.Ссылка);
        КонецЕсли;
        СнимокДоJSON = КодироватьJSON(ДанныеОбъектаРеестра(Ресурс, Объект), 8192);
        Если Операция = "subscriber.contacts" Тогда
            Объект.Наименование = Изменения.name;
            Объект.Телефон = Изменения.phone;
            Объект.ЭлектроннаяПочта = Изменения.email;
        ИначеЕсли Операция = "property.details" Тогда
            Объект.Наименование = Изменения.name;
            Объект.Адрес = Изменения.address;
            Объект.ТипОбъектаНедвижимости = Изменения.propertyType;
        Иначе
            Объект.Состояние = "Closed";
        КонецЕсли;
        Объект.Ревизия = Объект.Ревизия + 1;
        Объект.ДатаОбновления = ТекущаяУниверсальнаяДата();
        Объект.Записать();
        Результат = ДанныеОбъектаРеестра(Ресурс, Объект);
        СнимокПослеJSON = КодироватьJSON(Результат, 8192);
        ДобавитьЗаписьИстории(КонтекстДоступа, Ресурс, ИдентификаторСущности, Объект.Ревизия, Операция, Причина, СнимокДоJSON, СнимокПослеJSON, ЗапросКлиентаКлюч, Объект.ДатаОбновления);
        Если Ресурс = "properties" Или Ресурс = "contracts" Тогда
            ДобавитьСобытиеОбслуживания(КонтекстДоступа, Ресурс, Объект, Операция, Причина, СнимокДоJSON, СнимокПослеJSON, ЗапросКлиентаКлюч);
        КонецЕсли;
        Запрос.РезультатJSON = СнимокПослеJSON;
        Запрос.Записать();
        ПолитикаДоступа.ЗаписатьСобытиеАудита(СсылкаУчетнойЗаписи, КонтекстДоступа.РабочееПространство, "registry.lifecycle." + Операция, ИдентификаторСущности);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция НачатьОперациюСотрудника(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор)
    ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
    Если ТранзакцияАктивна() Тогда
        ВызватьИсключение "кабинет_жизненный_цикл_вложенная_транзакция";
    КонецЕсли;
    СсылкаРабочейОбласти = Справочники.РабочиеПространства.ПолучитьСсылку(РазобратьИдентификатор(РабочаяОбластьИдентификатор));
    СсылкаОбласти = Справочники.Области.ПолучитьСсылку(РазобратьИдентификатор(ОбластьИдентификатор));
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        ЗаблокироватьОбъектПоСсылке("Справочник.УчетныеЗаписи", СсылкаУчетнойЗаписи);
        ЗаблокироватьОбъектПоСсылке("Справочник.РабочиеПространства", СсылкаРабочейОбласти);
        ЗаблокироватьОбъектПоСсылке("Справочник.Области", СсылкаОбласти);
        ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи);
        ПроверенныйОбласть = ПолитикаДоступа.ПроверитьДоступКОбласти(СсылкаУчетнойЗаписи, РабочаяОбластьИдентификатор, ОбластьИдентификатор, "BillingSpecialist");
        Если ПроверенныйОбласть <> СсылкаОбласти Тогда
            ВызватьИсключение "кабинет_область_запрещено";
        КонецЕсли;
    Исключение
        ОтменитьСобственнуюТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Новый Структура("УчетнаяЗапись,РабочееПространство,Область", СсылкаУчетнойЗаписи, СсылкаРабочейОбласти, СсылкаОбласти);
КонецФункции

Функция ОбъектРеестра(Ресурс, ИдентификаторСущности, КонтекстДоступа)
    Разобранный = РазобратьИдентификатор(ИдентификаторСущности);
    Если Ресурс = "subscribers" Тогда
        ИдентификаторСсылки = Справочники.Абоненты.ПолучитьСсылку(Разобранный);
        ЗаблокироватьОбъектПоСсылке("Справочник.Абоненты", ИдентификаторСсылки);
    ИначеЕсли Ресурс = "properties" Тогда
        ИдентификаторСсылки = Справочники.ОбъектыНедвижимости.ПолучитьСсылку(Разобранный);
        ЗаблокироватьОбъектПоСсылке("Справочник.ОбъектыНедвижимости", ИдентификаторСсылки);
    ИначеЕсли Ресурс = "service-points" Тогда
        ИдентификаторСсылки = Справочники.ТочкиОбслуживания.ПолучитьСсылку(Разобранный);
        ЗаблокироватьОбъектПоСсылке("Справочник.ТочкиОбслуживания", ИдентификаторСсылки);
    ИначеЕсли Ресурс = "contracts" Тогда
        ИдентификаторСсылки = Справочники.Договоры.ПолучитьСсылку(Разобранный);
        ЗаблокироватьОбъектПоСсылке("Справочник.Договоры", ИдентификаторСсылки);
    ИначеЕсли Ресурс = "personal-accounts" Тогда
        ИдентификаторСсылки = Справочники.ЛицевыеСчета.ПолучитьСсылку(Разобранный);
        ЗаблокироватьОбъектПоСсылке("Справочник.ЛицевыеСчета", ИдентификаторСсылки);
    Иначе
        ВызватьИсключение "кабинет_жизненный_цикл_некорректно_ресурс";
    КонецЕсли;
    Объект = ИдентификаторСсылки.ПолучитьОбъект();
    Если Объект = Неопределено Тогда
        ВызватьИсключение "кабинет_жизненный_цикл_не_найдено";
    КонецЕсли;
    Если Объект.ПометкаУдаления Или Объект.РабочееПространство <> КонтекстДоступа.РабочееПространство Или Объект.Область <> КонтекстДоступа.Область Тогда
        ВызватьИсключение "кабинет_жизненный_цикл_не_найдено";
    КонецЕсли;
    Если Не ЗначениеЗаполнено(Объект.КемСоздано) Или Объект.ДатаСоздания = Дата(1, 1, 1)
        Или Объект.Ревизия < 1 Или Объект.Ревизия <> Цел(Объект.Ревизия)
        Или (Объект.Состояние <> "Active" И Объект.Состояние <> "Closed") Тогда
        ВызватьИсключение "кабинет_жизненный_цикл_не_найдено";
    КонецЕсли;
    Возврат Объект;
КонецФункции

Процедура ПроверитьСвязиОбъектов(Ресурс, Объект, КонтекстДоступа)
    Если Ресурс = "subscribers" Тогда
        Возврат;
    ИначеЕсли Ресурс = "properties" Тогда
        Запрос = Новый Запрос(
            "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ОбъектыНедвижимости ГДЕ Ссылка = &ИдентификаторСсылки
            |И АбонентВладелец.РабочееПространство = &РабочееПространство И АбонентВладелец.Область = &Область
            |И НЕ АбонентВладелец.ПометкаУдаления
            |И (АбонентВладелец.Состояние = &Действующий ИЛИ АбонентВладелец.Состояние = &Закрытый)");
    ИначеЕсли Ресурс = "service-points" Тогда
        Запрос = Новый Запрос(
            "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ТочкиОбслуживания ГДЕ Ссылка = &ИдентификаторСсылки
            |И ОбъектНедвижимости.РабочееПространство = &РабочееПространство И ОбъектНедвижимости.Область = &Область
            |И НЕ ОбъектНедвижимости.ПометкаУдаления И НЕ ОбъектНедвижимости.АбонентВладелец.ПометкаУдаления
            |И ОбъектНедвижимости.АбонентВладелец.РабочееПространство = &РабочееПространство
            |И ОбъектНедвижимости.АбонентВладелец.Область = &Область
            |И (ОбъектНедвижимости.Состояние = &Действующий ИЛИ ОбъектНедвижимости.Состояние = &Закрытый)
            |И (ОбъектНедвижимости.АбонентВладелец.Состояние = &Действующий ИЛИ ОбъектНедвижимости.АбонентВладелец.Состояние = &Закрытый)");
    ИначеЕсли Ресурс = "contracts" Тогда
        Запрос = Новый Запрос(
            "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Договоры ГДЕ Ссылка = &ИдентификаторСсылки
            |И Абонент.РабочееПространство = &РабочееПространство И Абонент.Область = &Область И НЕ Абонент.ПометкаУдаления
            |И ОбъектНедвижимости.РабочееПространство = &РабочееПространство И ОбъектНедвижимости.Область = &Область И НЕ ОбъектНедвижимости.ПометкаУдаления
            |И ТочкаОбслуживания.РабочееПространство = &РабочееПространство И ТочкаОбслуживания.Область = &Область И НЕ ТочкаОбслуживания.ПометкаУдаления
            |И ОбъектНедвижимости.АбонентВладелец = Абонент И ТочкаОбслуживания.ОбъектНедвижимости = ОбъектНедвижимости
            |И ТочкаОбслуживания.ВидУслуги = ВидУслуги
            |И (Абонент.Состояние = &Действующий ИЛИ Абонент.Состояние = &Закрытый)
            |И (ОбъектНедвижимости.Состояние = &Действующий ИЛИ ОбъектНедвижимости.Состояние = &Закрытый)
            |И (ТочкаОбслуживания.Состояние = &Действующий ИЛИ ТочкаОбслуживания.Состояние = &Закрытый)");
    ИначеЕсли Ресурс = "personal-accounts" Тогда
        Запрос = Новый Запрос(
            "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ЛицевыеСчета ГДЕ Ссылка = &ИдентификаторСсылки
            |И Договор.РабочееПространство = &РабочееПространство И Договор.Область = &Область И НЕ Договор.ПометкаУдаления
            |И ОбъектНедвижимости.РабочееПространство = &РабочееПространство И ОбъектНедвижимости.Область = &Область И НЕ ОбъектНедвижимости.ПометкаУдаления
            |И ТочкаОбслуживания.РабочееПространство = &РабочееПространство И ТочкаОбслуживания.Область = &Область И НЕ ТочкаОбслуживания.ПометкаУдаления
            |И Договор.Абонент.РабочееПространство = &РабочееПространство И Договор.Абонент.Область = &Область
            |И НЕ Договор.Абонент.ПометкаУдаления И ОбъектНедвижимости.АбонентВладелец = Договор.Абонент
            |И Договор.ОбъектНедвижимости = ОбъектНедвижимости И Договор.ТочкаОбслуживания = ТочкаОбслуживания
            |И ТочкаОбслуживания.ОбъектНедвижимости = ОбъектНедвижимости И ТочкаОбслуживания.ВидУслуги = Договор.ВидУслуги
            |И (Договор.Состояние = &Действующий ИЛИ Договор.Состояние = &Закрытый)
            |И (ОбъектНедвижимости.Состояние = &Действующий ИЛИ ОбъектНедвижимости.Состояние = &Закрытый)
            |И (ТочкаОбслуживания.Состояние = &Действующий ИЛИ ТочкаОбслуживания.Состояние = &Закрытый)
            |И (Договор.Абонент.Состояние = &Действующий ИЛИ Договор.Абонент.Состояние = &Закрытый)");
    Иначе
        ВызватьИсключение "кабинет_жизненный_цикл_некорректно_ресурс";
    КонецЕсли;
    Запрос.УстановитьПараметр("ИдентификаторСсылки", Объект.Ссылка);
    Запрос.УстановитьПараметр("РабочееПространство", КонтекстДоступа.РабочееПространство);
    Запрос.УстановитьПараметр("Область", КонтекстДоступа.Область);
    Запрос.УстановитьПараметр("Действующий", "Active");
    Запрос.УстановитьПараметр("Закрытый", "Closed");
    Если Запрос.Выполнить().Пустой() Тогда
        ВызватьИсключение "кабинет_жизненный_цикл_не_найдено";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьОтсутствиеАктивныхЛицевыхСчетов(ДоговорСсылка)
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ЛицевыеСчета ГДЕ Договор = &Договор И Состояние = &Действующий");
    Запрос.УстановитьПараметр("Договор", ДоговорСсылка);
    Запрос.УстановитьПараметр("Действующий", "Active");
    Если Не Запрос.Выполнить().Пустой() Тогда
        ВызватьИсключение "кабинет_жизненный_цикл_активно_личный_учетные_записи";
    КонецЕсли;
КонецПроцедуры

Функция ОткрытьПривязкуЗапроса(СсылкаУчетнойЗаписи, ЗапросКлиентаКлюч, КонтекстДоступа, Ресурс, ИдентификаторСущности, Операция, НамерениеJSON)
    Блокировка = Новый БлокировкаДанных;
    Запись = Блокировка.Добавить("РегистрСведений.ПривязкиКомандЖизненногоЦиклаРеестра");
    Запись.УстановитьЗначение("УчетнаяЗапись", СсылкаУчетнойЗаписи);
    Запись.УстановитьЗначение("ИдентификаторЗапроса", ЗапросКлиентаКлюч);
    Запись.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
    Привязка = РегистрыСведений.ПривязкиКомандЖизненногоЦиклаРеестра.СоздатьМенеджерЗаписи();
    Привязка.УчетнаяЗапись = СсылкаУчетнойЗаписи;
    Привязка.ИдентификаторЗапроса = ЗапросКлиентаКлюч;
    Привязка.Прочитать();
    Если Привязка.Выбран() Тогда
        Если Привязка.РабочееПространство <> КонтекстДоступа.РабочееПространство Или Привязка.Область <> КонтекстДоступа.Область Или Привязка.Вид <> Ресурс
            Или Привязка.ИдентификаторСущности <> ИдентификаторСущности Или Привязка.Операция <> Операция Или Привязка.НамерениеJSON <> НамерениеJSON Тогда
            ВызватьИсключение "кабинет_жизненный_цикл_запрос_конфликт";
        КонецЕсли;
    Иначе
        Привязка.УчетнаяЗапись = СсылкаУчетнойЗаписи;
        Привязка.ИдентификаторЗапроса = ЗапросКлиентаКлюч;
        Привязка.РабочееПространство = КонтекстДоступа.РабочееПространство;
        Привязка.Область = КонтекстДоступа.Область;
        Привязка.Вид = Ресурс;
        Привязка.ИдентификаторСущности = ИдентификаторСущности;
        Привязка.Операция = Операция;
        Привязка.НамерениеJSON = НамерениеJSON;
    КонецЕсли;
    Возврат Привязка;
КонецФункции

Процедура ДобавитьЗаписьИстории(КонтекстДоступа, Ресурс, ИдентификаторСущности, Ревизия, Операция, Причина, СнимокДоJSON, СнимокПослеJSON, ЗапросКлиентаКлюч, ДатаИзменения)
    Блокировка = Новый БлокировкаДанных;
    Запись = Блокировка.Добавить("РегистрСведений.ИсторияИзмененийРеестра");
    Запись.УстановитьЗначение("Вид", Ресурс);
    Запись.УстановитьЗначение("ИдентификаторСущности", ИдентификаторСущности);
    Запись.УстановитьЗначение("Ревизия", Ревизия);
    Запись.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
    История = РегистрыСведений.ИсторияИзмененийРеестра.СоздатьМенеджерЗаписи();
    История.Вид = Ресурс;
    История.ИдентификаторСущности = ИдентификаторСущности;
    История.Ревизия = Ревизия;
    История.Прочитать();
    Если История.Выбран() Тогда
        ВызватьИсключение "кабинет_жизненный_цикл_привязка_конфликт";
    КонецЕсли;
    История.Вид = Ресурс;
    История.ИдентификаторСущности = ИдентификаторСущности;
    История.Ревизия = Ревизия;
    История.РабочееПространство = КонтекстДоступа.РабочееПространство;
    История.Область = КонтекстДоступа.Область;
    История.ДействующееЛицо = КонтекстДоступа.УчетнаяЗапись;
    История.ДатаИзменения = ДатаИзменения;
    История.Операция = Операция;
    История.Причина = Причина;
    История.СнимокДоJSON = СнимокДоJSON;
    История.СнимокПослеJSON = СнимокПослеJSON;
    История.ИдентификаторЗапроса = ЗапросКлиентаКлюч;
    История.Записать();
КонецПроцедуры

Процедура ПроверитьИсториюПовтора(Запрос, Ревизия, КонтекстДоступа, Ресурс, ИдентификаторСущности, СсылкаУчетнойЗаписи, ЗапросКлиентаКлюч, Операция)
    История = РегистрыСведений.ИсторияИзмененийРеестра.СоздатьМенеджерЗаписи();
    История.Вид = Ресурс;
    История.ИдентификаторСущности = ИдентификаторСущности;
    История.Ревизия = Ревизия;
    История.Прочитать();
    Если Не История.Выбран() Тогда
        ВызватьИсключение "кабинет_жизненный_цикл_привязка_конфликт";
    КонецЕсли;
    Если История.РабочееПространство <> КонтекстДоступа.РабочееПространство Или История.Область <> КонтекстДоступа.Область Или История.ДействующееЛицо <> СсылкаУчетнойЗаписи
        Или История.ИдентификаторЗапроса <> ЗапросКлиентаКлюч Или История.Операция <> Операция Или История.СнимокПослеJSON <> Запрос.РезультатJSON Тогда
        ВызватьИсключение "кабинет_жизненный_цикл_привязка_конфликт";
    КонецЕсли;
КонецПроцедуры

Функция ДатаDTOUTC(Значение)
    Возврат XMLСтрока(Значение) + "Z";
КонецФункции

Функция ДанныеОбъектаРеестра(Ресурс, Объект)
    Результат = Новый Структура("id,workspaceId,areaId,name,state,createdBy,createdAt,updatedAt,revision",
        Строка(Объект.Ссылка.УникальныйИдентификатор()), Строка(Объект.РабочееПространство.УникальныйИдентификатор()), Строка(Объект.Область.УникальныйИдентификатор()), Объект.Наименование,
        Объект.Состояние, Строка(Объект.КемСоздано.УникальныйИдентификатор()), ДатаDTOUTC(Объект.ДатаСоздания), ДатаDTOUTC(Объект.ДатаОбновления), Объект.Ревизия);
    Если Ресурс = "subscribers" Тогда
        Результат.Вставить("partyType", Объект.ТипАбонента);
        Результат.Вставить("phone", Объект.Телефон);
        Результат.Вставить("email", Объект.ЭлектроннаяПочта);
    ИначеЕсли Ресурс = "properties" Тогда
        Результат.Вставить("ownerSubscriberId", Строка(Объект.АбонентВладелец.УникальныйИдентификатор()));
        Результат.Вставить("address", Объект.Адрес);
        Результат.Вставить("propertyType", Объект.ТипОбъектаНедвижимости);
    ИначеЕсли Ресурс = "service-points" Тогда
        Результат.Вставить("propertyId", Строка(Объект.ОбъектНедвижимости.УникальныйИдентификатор()));
        Результат.Вставить("serviceKind", Объект.ВидУслуги);
    ИначеЕсли Ресурс = "contracts" Тогда
        Результат.Вставить("subscriberId", Строка(Объект.Абонент.УникальныйИдентификатор()));
        Результат.Вставить("propertyId", Строка(Объект.ОбъектНедвижимости.УникальныйИдентификатор()));
        Результат.Вставить("servicePointId", Строка(Объект.ТочкаОбслуживания.УникальныйИдентификатор()));
        Результат.Вставить("numberNormalized", Объект.НормализованныйНомер);
        Результат.Вставить("serviceKind", Объект.ВидУслуги);
        Результат.Вставить("validFrom", ДатаDTOUTC(Объект.НачалоДействия));
        Результат.Вставить("validTo", ДатаDTOUTC(Объект.ОкончаниеДействия));
    ИначеЕсли Ресурс = "personal-accounts" Тогда
        Результат.Вставить("contractId", Строка(Объект.Договор.УникальныйИдентификатор()));
        Результат.Вставить("propertyId", Строка(Объект.ОбъектНедвижимости.УникальныйИдентификатор()));
        Результат.Вставить("servicePointId", Строка(Объект.ТочкаОбслуживания.УникальныйИдентификатор()));
        Результат.Вставить("numberNormalized", Объект.НормализованныйНомер);
    Иначе
        ВызватьИсключение "кабинет_жизненный_цикл_некорректно_ресурс";
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ПрочитатьСнимокОбъекта(Текст, Ресурс, КонтекстДоступа, ИдентификаторСущности)
    Чтение = Новый ЧтениеJSON;
    Попытка
        Если ТипЗнч(Текст) <> Тип("Строка") Или СтрДлина(Текст) > 8192 Тогда
            ВызватьИсключение "кабинет_жизненный_цикл_привязка_конфликт";
        КонецЕсли;
        Чтение.УстановитьСтроку(Текст);
        Данные = ПрочитатьJSON(Чтение);
        Чтение.Закрыть();
        Поля = "id,workspaceId,areaId,name,state,createdBy,createdAt,updatedAt,revision";
        Если Ресурс = "subscribers" Тогда
            Поля = Поля + ",partyType,phone,email";
        ИначеЕсли Ресурс = "properties" Тогда
            Поля = Поля + ",ownerSubscriberId,address,propertyType";
        ИначеЕсли Ресурс = "service-points" Тогда
            Поля = Поля + ",propertyId,serviceKind";
        ИначеЕсли Ресурс = "contracts" Тогда
            Поля = Поля + ",subscriberId,propertyId,servicePointId,numberNormalized,serviceKind,validFrom,validTo";
        ИначеЕсли Ресурс = "personal-accounts" Тогда
            Поля = Поля + ",contractId,propertyId,servicePointId,numberNormalized";
        Иначе
            ВызватьИсключение "кабинет_жизненный_цикл_привязка_конфликт";
        КонецЕсли;
        ПроверитьПоляТелаЗапроса(Данные, Поля);
        Если Данные.Количество() <> СтрРазделить(Поля, ",").Количество() Тогда
            ВызватьИсключение "кабинет_жизненный_цикл_привязка_конфликт";
        КонецЕсли;
        Для Каждого Поле Из Данные Цикл
            Если Поле.Ключ = "revision" Тогда
                Если ТипЗнч(Поле.Значение) <> Тип("Число") Тогда
                    ВызватьИсключение "кабинет_жизненный_цикл_привязка_конфликт";
                КонецЕсли;
            ИначеЕсли ТипЗнч(Поле.Значение) <> Тип("Строка") Или СтрДлина(Поле.Значение) > 250 Тогда
                ВызватьИсключение "кабинет_жизненный_цикл_привязка_конфликт";
            КонецЕсли;
        КонецЦикла;
        Если Данные.id <> ИдентификаторСущности Или Данные.workspaceId <> Строка(КонтекстДоступа.РабочееПространство.УникальныйИдентификатор())
            Или Данные.areaId <> Строка(КонтекстДоступа.Область.УникальныйИдентификатор()) Или Данные.revision < 1 Или Данные.revision <> Цел(Данные.revision)
            Или (Данные.state <> "Active" И Данные.state <> "Closed") Тогда
            ВызватьИсключение "кабинет_жизненный_цикл_привязка_конфликт";
        КонецЕсли;
    Исключение
        Чтение.Закрыть();
        ВызватьИсключение "кабинет_жизненный_цикл_привязка_конфликт";
    КонецПопытки;
    Возврат Данные;
КонецФункции

Функция КодироватьJSON(Данные, МаксДлина)
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Данные);
    Текст = Запись.Закрыть();
    Если СтрДлина(Текст) > МаксДлина Тогда
        ВызватьИсключение "кабинет_жизненный_цикл_некорректно_поле";
    КонецЕсли;
    Возврат Текст;
КонецФункции

Процедура ПроверитьТекущегоУчастника(СсылкаУчетнойЗаписи)
    Текущий = ПолитикаДоступа.ПроверитьУчетнуюЗапись();
    Если ТипЗнч(СсылкаУчетнойЗаписи) <> Тип("СправочникСсылка.УчетныеЗаписи") Тогда
        ВызватьИсключение "кабинет_участник_несовпадение";
    КонецЕсли;
    Если Текущий.Ссылка <> СсылкаУчетнойЗаписи Тогда
        ВызватьИсключение "кабинет_участник_несовпадение";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьРесурс(Ресурс)
    Если ТипЗнч(Ресурс) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_жизненный_цикл_некорректно_ресурс";
    КонецЕсли;
    Если Ресурс <> "subscribers" И Ресурс <> "properties" И Ресурс <> "contracts" И Ресурс <> "personal-accounts" Тогда
        ВызватьИсключение "кабинет_жизненный_цикл_некорректно_ресурс";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьПоляТелаЗапроса(ТелоЗапроса, Поля)
    Если ТипЗнч(ТелоЗапроса) <> Тип("Структура") Тогда
        ВызватьИсключение "кабинет_жизненный_цикл_некорректно_тело";
    КонецЕсли;
    Разрешенные = СтрРазделить(Поля, ",");
    Если ТелоЗапроса.Количество() <> Разрешенные.Количество() Тогда
        ВызватьИсключение "кабинет_жизненный_цикл_некорректно_поле";
    КонецЕсли;
    Для Каждого Запись Из ТелоЗапроса Цикл
        Если Разрешенные.Найти(Запись.Ключ) = Неопределено Тогда
            ВызватьИсключение "кабинет_жизненный_цикл_некорректно_поле";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ТекстовоеПоле(ТелоЗапроса, Имя, МаксДлина, РазрешитьПустой = Ложь)
    Значение = Неопределено;
    Если Не ТелоЗапроса.Свойство(Имя, Значение) Тогда
        ВызватьИсключение "кабинет_жизненный_цикл_некорректно_поле";
    КонецЕсли;
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_жизненный_цикл_некорректно_поле";
    КонецЕсли;
    Если СтрДлина(Значение) > МаксДлина Тогда
        ВызватьИсключение "кабинет_жизненный_цикл_некорректно_поле";
    КонецЕсли;
    Для Позиция = 1 По СтрДлина(Значение) Цикл
        Код = КодСимвола(Значение, Позиция);
        Если Код < 32 Или (Код >= 127 И Код <= 159)
            Или (Код >= 8203 И Код <= 8207) Или (Код >= 8234 И Код <= 8238)
            Или (Код >= 8288 И Код <= 8297) Или Код = 65279
            Или (Код >= 55296 И Код <= 57343) Тогда
            ВызватьИсключение "кабинет_жизненный_цикл_некорректно_поле";
        КонецЕсли;
    КонецЦикла;
    Значение = СокрЛП(Значение);
    Если Не РазрешитьПустой И ПустаяСтрока(Значение) Тогда
        ВызватьИсключение "кабинет_жизненный_цикл_некорректно_поле";
    КонецЕсли;
    Возврат Значение;
КонецФункции

Функция ПолеКонтактныхДанных(ТелоЗапроса, Имя, МаксДлина)
    Значение = ТекстовоеПоле(ТелоЗапроса, Имя, МаксДлина, Истина);
    Для Позиция = 1 По СтрДлина(Значение) Цикл
        Если КодСимвола(Значение, Позиция) > 126 Тогда
            ВызватьИсключение "кабинет_жизненный_цикл_некорректно_поле";
        КонецЕсли;
    КонецЦикла;
    Возврат Значение;
КонецФункции

Функция ПолеРевизии(ТелоЗапроса)
    Значение = Неопределено;
    Если Не ТелоЗапроса.Свойство("expectedRevision", Значение) Тогда
        ВызватьИсключение "кабинет_жизненный_цикл_некорректно_поле";
    КонецЕсли;
    Если ТипЗнч(Значение) <> Тип("Число") Тогда
        ВызватьИсключение "кабинет_жизненный_цикл_некорректно_поле";
    КонецЕсли;
    Если Значение < 1 Или Значение >= 999999999999998 Или Значение <> Цел(Значение) Тогда
        ВызватьИсключение "кабинет_жизненный_цикл_некорректно_поле";
    КонецЕсли;
    Возврат Значение;
КонецФункции

Функция РазобратьИдентификатор(Идентификатор)
    Если ТипЗнч(Идентификатор) <> Тип("Строка") Тогда
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецЕсли;
    Если СтрДлина(Идентификатор) <> 36 Тогда
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецЕсли;
    Попытка
        Разобранный = Новый УникальныйИдентификатор(Идентификатор);
    Исключение
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецПопытки;
    Если Строка(Разобранный) = "00000000-0000-0000-0000-000000000000" Тогда
        ВызватьИсключение "кабинет_некорректно_идентификатор";
    КонецЕсли;
    Возврат Разобранный;
КонецФункции

Процедура ЗаблокироватьОбъектПоСсылке(ПространствоИмен, ИдентификаторСсылки)
    Блокировка = Новый БлокировкаДанных;
    Запись = Блокировка.Добавить(ПространствоИмен);
    Запись.УстановитьЗначение("Ссылка", ИдентификаторСсылки);
    Запись.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
КонецПроцедуры

Процедура ОтменитьСобственнуюТранзакцию()
    Если ТранзакцияАктивна() Тогда
        ОтменитьТранзакцию();
    КонецЕсли;
КонецПроцедуры
