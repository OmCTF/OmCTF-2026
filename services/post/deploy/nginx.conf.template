worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 256; }
http {
    resolver 127.0.0.11 valid=5s ipv6=off;
    limit_req_zone $binary_remote_addr zone=api_ip:10m rate=100r/s;
    limit_conn_zone $binary_remote_addr zone=upload_ip:1m;
    limit_conn_zone $server_addr zone=upload_total:1m;
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    map $request_id $svyaz_request_id {
        "~^(........)(....)(....)(....)(............)$" "$1-$2-$3-$4-$5";
    }
    upstream api_backend {
        zone api_backend 64k;
        server ${WEB_API_UPSTREAM} resolve;
        keepalive 64;
    }
    log_format structured escape=json '{"service":"web","request_id":"$svyaz_request_id","method":"$request_method","status":$status}';
    access_log /dev/stdout structured;
    server {
        listen 8080${WEB_LISTEN_TLS};
        include /etc/nginx/tls/*.conf;
        root /usr/share/nginx/html;
        resolver 127.0.0.11 valid=5s ipv6=off;
        set $realtime_upstream ${WEB_REALTIME_UPSTREAM};
        set $voice_upstream ${WEB_VOICE_UPSTREAM};
        limit_req_status 429;
        client_max_body_size ${WEB_MAX_BODY_BYTES};
        client_header_timeout 5s;
        client_body_timeout 5s;
        send_timeout 5s;
        add_header X-Request-ID $svyaz_request_id always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'" always;
        location = /api/v1/ws {
            proxy_pass http://$realtime_upstream;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header X-Request-ID $svyaz_request_id;
            proxy_hide_header X-Request-ID;
            proxy_connect_timeout 2s;
            proxy_read_timeout 65s;
        }
        location = /api/v1/chat/ws {
            proxy_pass http://$realtime_upstream;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header X-Request-ID $svyaz_request_id;
            proxy_hide_header X-Request-ID;
            proxy_connect_timeout 2s;
            proxy_read_timeout 65s;
        }
        location = /api/v1/voice/session {
            proxy_pass http://$voice_upstream;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header X-Request-ID $svyaz_request_id;
            proxy_hide_header X-Request-ID;
            proxy_connect_timeout 2s;
            proxy_read_timeout 65s;
        }
        location = /api/v1/voice/ws {
            proxy_pass http://$voice_upstream;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header X-Request-ID $svyaz_request_id;
            proxy_hide_header X-Request-ID;
            proxy_connect_timeout 2s;
            proxy_read_timeout 65s;
        }
        location = /api/v1/voice/presence {
            proxy_pass http://$voice_upstream;
            proxy_set_header X-Request-ID $svyaz_request_id;
            proxy_hide_header X-Request-ID;
            proxy_connect_timeout 2s;
            proxy_read_timeout 4s;
        }
        location ^~ /api/v1/voice/playbacks/ {
            proxy_pass http://$voice_upstream;
            proxy_set_header X-Request-ID $svyaz_request_id;
            proxy_hide_header X-Request-ID;
            proxy_connect_timeout 2s;
            proxy_read_timeout 10s;
        }
        location ~ ^/api/v1/(uploads|attachments)(/|$) {
            limit_req zone=api_ip burst=200 nodelay;
            limit_conn upload_ip 4;
            limit_conn upload_total 16;
            proxy_hide_header X-Content-Type-Options;
            client_max_body_size 8m;
            client_body_timeout 20s;
            proxy_request_buffering on;
            proxy_buffering off;
            proxy_http_version 1.1;
            proxy_pass http://api_backend;
            proxy_set_header Connection "";
            proxy_set_header X-Request-ID $svyaz_request_id;
            proxy_set_header X-Svyaz-Client-IP $remote_addr;
            proxy_set_header Host $host;
            proxy_hide_header X-Request-ID;
            proxy_connect_timeout 2s;
            proxy_read_timeout 26s;
            proxy_send_timeout 20s;
            error_page 413 =413 /media-too-large;
            error_page 502 504 =503 /gateway-error;
        }
        location = /media-too-large {
            internal;
            default_type application/json;
            return 413 '{"code":"invalid_file_size","message":"File exceeds 8 MiB","request_id":"$svyaz_request_id"}';
        }
        location ~ ^/api/v1/channels/[0-9a-f-]+/sounds$ {
            limit_req zone=api_ip burst=200 nodelay;
            client_max_body_size 3m;
            client_body_timeout 15s;
            proxy_http_version 1.1;
            proxy_pass http://api_backend;
            proxy_set_header Connection "";
            proxy_set_header X-Request-ID $svyaz_request_id;
            proxy_set_header X-Svyaz-Client-IP $remote_addr;
            proxy_set_header Host $host;
            proxy_hide_header X-Request-ID;
            proxy_connect_timeout 2s;
            proxy_read_timeout 12s;
            error_page 502 504 =503 /gateway-error;
        }
        location ~ ^/(api/|health/) {
            limit_req zone=api_ip burst=200 nodelay;
            proxy_http_version 1.1;
            proxy_pass http://api_backend;
            proxy_set_header Connection "";
            proxy_set_header X-Request-ID $svyaz_request_id;
            proxy_set_header X-Svyaz-Client-IP $remote_addr;
            proxy_set_header Host $host;
            proxy_hide_header X-Request-ID;
            proxy_connect_timeout 2s;
            proxy_read_timeout 6s;
            error_page 502 504 =503 /gateway-error;
        }
        location = /gateway-error {
            internal;
            default_type application/json;
            return 503 '{"code":"gateway_unavailable","message":"API is unavailable","request_id":"$svyaz_request_id"}';
        }
        location / { try_files $uri $uri/ /index.html; }
    }
}
