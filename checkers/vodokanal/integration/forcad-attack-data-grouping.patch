+
+def flatten_vodokanal_hints(data):
+    if not isinstance(data, dict) or not isinstance(data.get('vodokanal'), dict):
+        return data
+    flat_teams = {}
+    for ip, hints in data['vodokanal'].items():
+        identifiers = []
+        if isinstance(hints, list):
+            for raw in hints:
+                try:
+                    hint = json.loads(raw) if isinstance(raw, str) else raw
+                except (TypeError, ValueError):
+                    continue
+                if not isinstance(hint, dict):
+                    continue
+                kind, identifier = hint.get('type'), hint.get('id')
+                if kind in ('summary', 'attachment') and isinstance(identifier, str) and uuid_pattern.fullmatch(identifier):
+                    identifiers.append(identifier)
+        flat_teams[ip] = identifiers
+    data['vodokanal'] = flat_teams
+    return data
 
 
